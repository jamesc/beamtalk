#!/usr/bin/env escript
%% Copyright 2026 James Casey
%% SPDX-License-Identifier: Apache-2.0

%% Regenerate crates/beamtalk-core/tests/fixtures/otp_curated_exports.txt
%% (BT-4371): every export of each Erlang module named on the command line,
%% as reported by `Module:module_info(exports)` on the running OTP release.
%%
%% The fixture pins the real arity set of every function in the curated FFI
%% export table (`beamtalk_core::ffi_exports::CURATED_MODULES`); the
%% `ffi_exports` completeness test fails if a listed function is missing an
%% arity. Run it on the OTP release pinned in `.tool-versions`:
%%
%%   escript scripts/gen-otp-curated-exports.escript lists maps ... \
%%     > crates/beamtalk-core/tests/fixtures/otp_curated_exports.txt
%%
%% (the failing test prints the exact command with the current module list).
%%
%% Output: a header line with the OTP release, then one `module function
%% arity` line per export (excluding module_info/0,1), sorted.

main(Modules) ->
    Lines = lists:sort(
        [
            io_lib:format("~s ~s ~b~n", [M, F, A])
         || M <- Modules,
            {F, A} <- (list_to_atom(M)):module_info(exports),
            F =/= module_info
        ]
    ),
    io:format("# OTP ~s exports for the curated FFI modules; generated by "
              "scripts/gen-otp-curated-exports.escript~n",
              [erlang:system_info(otp_release)]),
    io:put_chars(Lines).
