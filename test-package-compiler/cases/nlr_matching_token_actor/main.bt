// BT-3130 (ADR 0111 Phase A3): threading-mode matrix — non-local return
// (NLR) through a block, "matching-token" shape (the block containing `^`
// is invoked directly by the same method that owns the `^` token — no
// relay through a foreign frame), Actor context. Confirmed via
// `BEAMTALK_CODEGEN_DIAGNOSTICS=1` to emit
// "Non-local return: compiled via throw/catch". Peers:
// `nlr_matching_token_value_type`, `nlr_matching_token_class_method`.

Actor subclass: NlrActor
  state: n = 0

  // `^` inside a block passed directly to `do:` in the same method.
  findFirstOver: threshold in: coll =>
    coll do: [:each | each > threshold ifTrue: [^each]]
    0
