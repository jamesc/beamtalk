// BT-4116: the fold accumulator shape. A `do:` (or `keysAndValuesDo:`) that
// threads exactly one outer local folds that local as a bare value; two or
// more locals fold an N-tuple; `collect:` keeps its `{AccList, ...}` tuple.
// Covers Object, Value, actor and class-method contexts and a cell closure.

Object subclass: BareObj
  oneLocal: coll =>
    sum := 0
    coll do: [:each | sum := sum + each]
    sum

  twoLocals: coll =>
    sum := 0
    count := 0
    coll do: [:each | sum := sum + each. count := count + 1]
    sum + count

  keyed: dict =>
    total := 0
    dict keysAndValuesDo: [:k :v | total := total + v]
    total

  collecting: coll =>
    n := 0
    coll collect: [:each | n := n + 1. each * 2]
