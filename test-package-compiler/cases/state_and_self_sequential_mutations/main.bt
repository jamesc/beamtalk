// BT-3130 (ADR 0111 Phase A3): threading-mode matrix — actor/instance state
// version threading (`State`, `State1`, `State2`, … — `StateThreading` in
// `state_codegen.rs`). One of the ADR's three independently-implemented
// monotonic-version-counter services (the second, class vars, is covered by
// `class_var_sequential_mutations`; the third, value-type field threading
// via `next_self_var()`/`Self`, `Self1`, … is NOT reachable through valid
// user syntax — see the README's "Excluded cells" section: `Value subclass:`
// field assignment is a compile error by design (immutability), and
// `Object subclass:` cannot declare instance data at all, so no legitimate
// `.bt` source can exercise `ValueTypeContext.self_version` field mutation).
//
// Multiple *sequential* mutations in one method (State1 -> State2) pin the
// counter discipline this service must preserve exactly under the ADR 0111
// `VersionedVar` unification.

Actor subclass: SeqStateCtr
  state: n = 0
  state: label = "start"

  // Two sequential field mutations: State1 -> State2.
  incrementTwice =>
    self.n := self.n + 1
    self.n := self.n + 1
    self.n

  // Three sequential mutations, interleaving two different fields.
  resetAndBump =>
    self.n := 0
    self.label := "reset"
    self.n := self.n + 1
    self.n
