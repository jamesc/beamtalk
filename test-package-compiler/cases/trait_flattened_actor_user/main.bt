// BT-3625 (ADR 0127 §3/§10): an Actor class's `uses:` provision must reach
// compiled Core Erlang output through the existing gen_server generator
// unchanged, including a provision that self-sends another of the class's
// own (non-provided) methods across the actor state boundary — and its BEAM
// line annotations must point into the protocol file (`greetable.bt`).

Actor subclass: Greeter
  uses: Greetable
  state: greetingCount = 0

  greeting -> String => "hi"

  bump => self.greetingCount := self.greetingCount + 1
