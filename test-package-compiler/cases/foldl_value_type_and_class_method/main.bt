// BT-3130 (ADR 0111 Phase A3): threading-mode matrix — the ValueType and
// ClassMethod cells. Since BT-4116 a foldl list-op that threads only outer
// locals takes the TupleAcc convention in these contexts too: a `do:` over a
// single local folds a bare accumulator (no tuple, no map), `inject:into:`
// threads its own accumulator. Confirm with `BEAMTALK_CODEGEN_DIAGNOSTICS=1`.
// Field writes, self-sends, and the other guards in `select_tuple_acc` still
// fall back to the map-shaped `StateAcc`. This file pins the byte-level shape
// for both contexts so a future change cannot silently alter it.

Object subclass: FoldValueCtr

  // ValueType: `do:` with a captured local mutation.
  sumDo: coll =>
    sum := 0
    coll do: [:each | sum := sum + each]
    sum

  // ValueType: `inject:into:` foldl shape.
  totalInject: coll =>
    coll inject: 0 into: [:acc :each | acc + each]

Actor subclass: FoldClassMethodCtr
  classState: total = 0

  // ClassMethod: `do:` with a captured local mutation (class var untouched).
  class sumDo: coll =>
    sum := 0
    coll do: [:each | sum := sum + each]
    sum

  // ClassMethod: `inject:into:` foldl shape.
  class totalInject: coll =>
    coll inject: 0 into: [:acc :each | acc + each]
