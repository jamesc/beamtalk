// Test Tuple class compilation as a value type (not gen_server).
// Tuple is a sealed Object subclass backed by Erlang tuples.
// new/0 should return {} (empty tuple).

sealed Object subclass: Tuple

  // Size and access
  size => @primitive "size"

  at: index => @primitive "at:"

  // Pattern matching for Erlang result types
  isOk => @primitive "isOk"

  isError => @primitive "isError"

  // Unwrapping: plain Beamtalk, as in stdlib/src/tuple.bt (no primitive)
  unwrap =>
    self isOk
      ifTrue: [self at: 2]
      ifFalse: [
        self isError ifTrue: [
          self error: "Called unwrap on error tuple: {self at: 2}"
        ] ifFalse: [self error: "unwrap requires an ok or error result tuple"]
      ]

  unwrapOr: default =>
    self isOk ifTrue: [self at: 2] ifFalse: [default]

  unwrapOrElse: block =>
    self isOk ifTrue: [self at: 2] ifFalse: [block value]

  // Conversion
  asString => @primitive "asString"
