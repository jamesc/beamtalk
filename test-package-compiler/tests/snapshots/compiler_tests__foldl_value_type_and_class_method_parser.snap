                        span: Span {
                            start: 679,
                            end: 685,
                        },
                        kind: Line,
                        preceding_blank_line: false,
                    },
                    Comment {
                        content: "Field writes, self-sends, and the other guards in `select_tuple_acc` still",
                        span: Span {
                            start: 679,
                            end: 685,
                        },
                        kind: Line,
                        preceding_blank_line: false,
                    },
                    Comment {
                        content: "fall back to the map-shaped `StateAcc`. This file pins the byte-level shape",
                        span: Span {
                            start: 679,
                            end: 685,
                        },
                        kind: Line,
                        preceding_blank_line: false,
                    },
