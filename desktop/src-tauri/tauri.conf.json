{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beamtalk",
  "version": "0.1.0",
  "identifier": "dev.beamtalk.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "picker",
        "title": "Beamtalk",
        "url": "index.html",
        "width": 480,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../dist-liveview": "dist-liveview"
    },
    "linux": {
      "deb": {
        "depends": ["libssl3t64"]
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  }
}
