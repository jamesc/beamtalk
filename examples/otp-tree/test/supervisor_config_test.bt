// Supervisor configuration tests.
//
// Configuration (`strategy`, `maxRestarts`, `restartWindow`, `childSpecs`) is
// instance-side (ADR 0135): it is read from the running supervisor, so these
// tests start AppSupervisor. See the REPL walkthrough in README.md for the
// rest of the lifecycle.

TestCase subclass: SupervisorConfigTest

  // `supervise` starts the one registered AppSupervisor.
  class serial -> Boolean => true

  tearDown =>
    sup := AppSupervisor current
    sup isNil ifFalse: [[sup stop] on: Error do: [:e | nil]]

  testAppSupervisorConfiguration =>
    sup := AppSupervisor supervise unwrap
    self assert: sup strategy equals: #oneForOne
    self assert: sup maxRestarts equals: 10
    self assert: sup restartWindow equals: 60
    self assert: sup count equals: 2

  testAppSupervisorIsSupervisor =>
    self assert: AppSupervisor isSupervisor equals: true

  testWorkerPoolIsSupervisor =>
    self assert: WorkerPool isSupervisor equals: true

  testEventLoggerSupervisionPolicy =>
    self assert: EventLogger supervisionPolicy equals: #permanent

  testTaskWorkerSupervisionPolicy =>
    self assert: TaskWorker supervisionPolicy equals: #transient
