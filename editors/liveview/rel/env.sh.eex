#!/bin/sh
# Copyright 2026 James Casey
# SPDX-License-Identifier: Apache-2.0
#
# BT-5127: a `mix release` boots distributed by default, which would open the
# Erlang distribution listener on every interface before any code runs. The
# front starts distribution lazily when it attaches to a workspace
# (`BtAttach.Workspace.ensure_distributed/0`), pinned to loopback unless the
# operator exported a non-loopback ERL_EPMD_ADDRESS. Default to no boot-time
# distribution; an explicit RELEASE_DISTRIBUTION still wins.
if [ -z "${RELEASE_DISTRIBUTION:-}" ]; then
  export RELEASE_DISTRIBUTION=none
fi
