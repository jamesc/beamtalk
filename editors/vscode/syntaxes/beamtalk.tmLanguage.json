{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Beamtalk",
  "scopeName": "source.beamtalk",
  "fileTypes": ["bt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#symbols" },
    { "include": "#characters" },
    { "include": "#pragmas" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#class-definition" },
    { "include": "#method-definition" },
    { "include": "#constants" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "A ```beamtalk (or ```btscript) fence inside `///` doc comments: the `///` prefixes and fence lines stay comments, and the code between them is highlighted as Beamtalk. Ends at the closing ``` line, or at the first line that is not a `///` line so an unclosed fence cannot leak into the code below.",
          "begin": "^\\s*///\\s*```(?:beamtalk|btscript)\\s*$",
          "beginCaptures": { "0": { "name": "comment.line.documentation.beamtalk" } },
          "end": "^\\s*///\\s*```\\s*$|^(?!\\s*///)",
          "endCaptures": { "0": { "name": "comment.line.documentation.beamtalk" } },
          "contentName": "meta.embedded.block.beamtalk",
          "patterns": [
            { "name": "comment.line.documentation.beamtalk", "match": "^\\s*///" },
            { "include": "$self" }
          ]
        },
        {
          "comment": "BT-3237/BT-3261: `// === Name ===` section-divider banner (BT-2601's category-recognition rule, source_analysis::method_category::parse_divider_name) — matched ahead of the plain line-comment pattern below so it renders visually distinct (bold heading name, dimmed border) instead of as an ordinary comment. Kept in sync with parse_divider_name by a shared fixture both a Rust test and a JS/Oniguruma test consume — see crates/beamtalk-core/tests/section_divider_grammar_conformance.rs and editors/vscode/src/__tests__/sectionDividerGrammar.test.ts; extend that fixture, not just this regex, on any future change. `(?<!/)` / `(?!/)` around the slashes excludes `///` doc comments (and any longer run) — without both, a lookahead alone still lets the regex match starting at the 2nd/3rd slash of a `///` line, since the character immediately after that inner `//` is a space, not another `/`. The opening border `((?>={3,}))` is an atomic group so its captured run-length can never backtrack shorter once matched (mirrors parse_divider_name's independent `take_while` counts from each end). `\\s*+` before the name is possessive (optional, but once matched can't give characters back) so whitespace can never leak into the name capture — without that, a whitespace-only 'name' like `// ===  ===` would wrongly match (parse_divider_name trims it to empty and rejects). The closing border `(\\1)` is a backreference to the opening run (not an independent capture), separated from the name by `(?:\\s+|(?<!=))` — real whitespace, or (when the name sits directly against the border, e.g. `// ===Name===`) a zero-width assertion that the name's last character isn't itself `=` — so a length mismatch like `// === Name ====`, which parse_divider_name rejects, still fails to match here even with the border-name gap now optional; a naive `\\s+` → `\\s*` substitution alone reopens exactly that hole by letting the border's extra `=` characters get silently absorbed into the name capture instead. `(?!=)` after the backreference is a second, defense-in-depth guard against the same kind of run-length ambiguity on the closing side.",
          "name": "comment.line.double-slash.section-divider.beamtalk",
          "match": "(?<!/)//(?!/)\\s*((?>={3,}))\\s*+(.+?)(?:\\s+|(?<!=))(\\1)(?!=)\\s*$",
          "captures": {
            "1": { "name": "punctuation.section.divider.beamtalk" },
            "2": { "name": "entity.name.section.beamtalk markup.heading.beamtalk" },
            "3": { "name": "punctuation.section.divider.beamtalk" }
          }
        },
        {
          "name": "comment.line.double-slash.beamtalk",
          "match": "//.*$"
        },
        {
          "name": "comment.block.beamtalk",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.beamtalk",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.beamtalk",
              "match": "\\\\[nrtf0\\\\\"{}]"
            },
            {
              "name": "meta.interpolation.beamtalk",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.beamtalk" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.beamtalk" }
              },
              "patterns": [
                { "include": "#brace-group" },
                { "include": "source.beamtalk" }
              ]
            }
          ]
        }
      ]
    },
    "brace-group": {
      "comment": "ADR 0136: a balanced `{...}` (tuple literal or map body) inside a string interpolation, so `\"x { {a, b} }\"` ends the interpolation at its own `}`, not the tuple's.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#brace-group" },
        { "include": "source.beamtalk" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.radix.beamtalk",
          "match": "\\b\\d+r[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.beamtalk",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.beamtalk",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.quoted.beamtalk",
          "match": "#'[^']*'"
        },
        {
          "name": "constant.other.symbol.beamtalk",
          "match": "#[a-zA-Z_][a-zA-Z0-9_:]*"
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "constant.character.beamtalk",
          "match": "\\$\\\\?."
        }
      ]
    },
    "pragmas": {
      "patterns": [
        {
          "name": "keyword.other.pragma.beamtalk",
          "match": "@(primitive|intrinsic)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "variable.language.self.beamtalk",
          "match": "\\bself\\b"
        },
        {
          "name": "variable.language.super.beamtalk",
          "match": "\\bsuper\\b"
        },
        {
          "name": "constant.language.nil.beamtalk",
          "match": "\\bnil\\b"
        },
        {
          "name": "constant.language.boolean.beamtalk",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "Type alias: `[internal] type Name = ...` (or `type Name(T) = ...`). Listed before the modifier rule so it wins the tie at line start.",
          "match": "^\\s*(?:(internal)\\s+)?(type)\\s+([A-Z][a-zA-Z0-9_]*)(?=\\s*[(=])",
          "captures": {
            "1": { "name": "keyword.other.modifier.beamtalk" },
            "2": { "name": "keyword.other.type.beamtalk" },
            "3": { "name": "entity.name.type.beamtalk" }
          }
        },
        {
          "comment": "Declaration modifiers at line start: class headers (`abstract sealed typed internal`) and method definitions (`class internal sealed`). These are contextual keywords, so they are only matched as a leading run on the line, and not when the line is an assignment to a variable of the same name (`class := ...`). A unary method name directly after the run is scoped as a function name, as `class name =>` already was.",
          "match": "^\\s*((?:(?:abstract|sealed|typed|internal|class)\\s+)+)(?!:=)(?:([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*(?:->|=>)))?",
          "captures": {
            "1": {
              "patterns": [
                { "name": "keyword.other.modifier.beamtalk", "match": "\\b(?:abstract|sealed|typed|internal)\\b" },
                { "name": "storage.modifier.class.beamtalk", "match": "\\bclass\\b" }
              ]
            },
            "2": { "name": "entity.name.function.beamtalk" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.type-annotation.beamtalk",
          "match": "::"
        },
        {
          "name": "keyword.operator.assignment.beamtalk",
          "match": ":="
        },
        {
          "name": "keyword.operator.spread.beamtalk",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.return.beamtalk",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.arrow.beamtalk",
          "match": "=>"
        },
        {
          "comment": "ADR 0145: the pipeline operator `|>`, one token (only when `|` and `>` are adjacent, like the lexer's `PipeGt`). Listed ahead of the comparison operators so its `>` is not taken as one.",
          "name": "keyword.operator.pipeline.beamtalk",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.beamtalk",
          "match": "=:=|=/=|==|/=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.beamtalk",
          "match": "\\*\\*|\\+\\+|[+\\-*/%]"
        },
        {
          "name": "punctuation.separator.cascade.beamtalk",
          "match": ";"
        }
      ]
    },
    "class-definition": {
      "patterns": [
        {
          "match": "\\b(Object|Actor)\\s+(subclass:)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.other.inherited-class.beamtalk" },
            "2": { "name": "keyword.other.subclass.beamtalk" },
            "3": { "name": "entity.name.type.class.beamtalk" }
          }
        },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s+(subclass:)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.other.inherited-class.beamtalk" },
            "2": { "name": "keyword.other.subclass.beamtalk" },
            "3": { "name": "entity.name.type.class.beamtalk" }
          }
        },
        {
          "match": "\\b(Protocol)\\s+(define:)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.other.inherited-class.beamtalk" },
            "2": { "name": "keyword.other.define.beamtalk" },
            "3": { "name": "entity.name.type.class.beamtalk" }
          }
        },
        {
          "comment": "Backing Erlang module: a class header's `... subclass: Foo native: beamtalk_foo`, or a type stub's `declare native: lists`. Anchored to end of line so an ordinary `native:` keyword send mid-expression is unaffected.",
          "match": "\\b(?:(declare)\\s+)?(native:)\\s+([a-z][a-zA-Z0-9_]*)\\s*$",
          "captures": {
            "1": { "name": "keyword.other.declare.beamtalk" },
            "2": { "name": "keyword.other.native.beamtalk" },
            "3": { "name": "entity.name.namespace.beamtalk" }
          }
        },
        {
          "comment": "Slot declarations, optionally `late` (ADR 0124). `late` is a contextual keyword only directly before these.",
          "match": "\\b(?:(late)\\s+)?(state:|field:|classState:)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(::)\\s*([A-Z][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.other.modifier.beamtalk" },
            "2": { "name": "keyword.other.declaration.beamtalk" },
            "3": { "name": "variable.other.field.beamtalk" },
            "4": { "name": "keyword.operator.type-annotation.beamtalk" },
            "5": { "name": "entity.name.type.class.beamtalk" }
          }
        }
      ]
    },
    "method-definition": {
      "patterns": [
        {
          "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(=>)",
          "captures": {
            "1": { "name": "storage.modifier.class.beamtalk" },
            "2": { "name": "entity.name.function.beamtalk" },
            "3": { "name": "keyword.operator.arrow.beamtalk" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "entity.name.type.class.beamtalk",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.keyword-message.beamtalk",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*:"
        },
        {
          "name": "variable.other.beamtalk",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
