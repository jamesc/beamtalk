{
  "compilerOptions": {
    // node16 resolution reads package "exports" (vscode-languageclient/node);
    // the default "node10" cannot, so `tsc` failed. Output stays CommonJS
    // because package.json has no "type": "module" (BT-5033).
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2020",
    "outDir": "out",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
