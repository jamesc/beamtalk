# Rust
# Build artifacts
/target/
/crates/*/target/
**/target/
**/*.rs.bk
*.pdb

# Distribution
/dist/
/dist-liveview/
*.vsix

# Cargo
Cargo.lock
.cargo/

# ...except desktop/src-tauri's: it's a shipped binary application (its own
# Cargo workspace, excluded from the root one — see root Cargo.toml), and
# unlike the main workspace's libraries, an application's Cargo.lock should
# be committed so the desktop-release.yml packaging lane (BT-2987) builds a
# reproducible, versioned artifact rather than re-resolving the full Tauri
# dependency graph fresh on every CI run.
!/desktop/src-tauri/Cargo.lock

# IDEs and editors
*.swp
*.swo
*~
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/mcp.json
.idea/
*.iml
.project
.classpath
.settings/

# Profiling and coverage
*.profraw
*.profdata
*.gcda
*.gcno
*.gcov
lcov.info
/coverage/
/tarpaulin-report.html
*.dSYM/

# MacOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# Linux
*~
.directory
.Trash-*

# Erlang/OTP
# Build artifacts
*.beam
*.ez
*.core
_build/
ebin/
deps/
!crates/**/deps/
doc/
!crates/**/doc/
logs/

# Rebar3
.rebar3/
rebar.lock
rebar3.crashdump
# rebar3 checkout deps (local development overrides, not committed)
runtime/_checkouts/
# flock lock file guarding concurrent `rebar3 compile` (BT-2471)
runtime/.rebar3-compile.lock

# Erlang crash dumps
erl_crash.dump
erlang_ls.config

# Coverage and profiling
cover/
.eunit/
.ct_run/
*.coverdata

# PLT files (Dialyzer)
*.plt
.dialyzer_plt
.local_dialyzer_plt

# Release artifacts (rebar3/relx output). The LiveView app's rel/ is SOURCE —
# mix release overlays (bin/server) — not an artifact, so re-include it.
rel/
!editors/liveview/rel/
_rel/

# Development
.erlang.cookie

# Environment and secrets
.env
.env.local
*.pem
*.key

# Git worktrees (created by worktree-up.ps1 or Claude Code)
.worktrees/
.claude/worktrees/
.claude/shared-target/

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# Lint stamp files (track fingerprints for pre-push hook)
.lint-erlang-stamp
.lint-js-stamp
.lint-beamtalk-stamp
.lint-elixir-stamp

# Session and temporary files
*.tmp
*.log
*.swp
*.swo

# Claude review gate — written by CI, never committed
.claude-verdict
.claude-summary.md
.claude-review-*.diff

# Build outputs
/build/
/lib/build/
# Compiled test fixtures (regenerated by compile_fixtures.escript)
/tests/repl-protocol/fixtures/build/
/runtime/apps/beamtalk_runtime/test_fixtures/build/
/docs/api/
*.backup
*.crashdump
_bt_stdlib_*.txt
_bt_stdlib_subdir/
_site/
.claude/skills-repo
.claude/commands/
# Session-start hook is copied from skills-repo at runtime
.claude/hooks/session-start.sh
# Generated rebar3 wrapper (created by worktree-init.sh hex-bridge setup)
.claude/bin/
# Generated hex-bridge rebar config (created by worktree-init.sh)
runtime/hex_bridge_rebar.config
.claude/scheduled_tasks.lock
# Transient EUnit artifacts written into runtime/ cwd by ops-export/trace tests
runtime/beamtalk_test_ops_export_*.json
runtime/traces-*.json
# Compiled test-fixture .beam/.core/.json outputs (generated by just build / just test)
runtime/apps/beamtalk_runtime/test_fixtures/build/
tests/repl-protocol/fixtures/build/
# Python bytecode cache (scripts/*.py are run directly, never packaged)
__pycache__/
*.pyc

# insta pending-snapshot artifacts — review with `cargo insta review`, never commit
*.snap.new
