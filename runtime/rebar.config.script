%% rebar.config.script — dynamic config overlay for Beamtalk runtime.
%%
%% BT-1672: Auto-discover bt@* stdlib modules and exclude them from cover and
%% dialyzer. Core Erlang-compiled BEAM files have no Erlang abstract code, so
%% cover cannot instrument them and dialyzer cannot analyse them. This replaces
%% the previous hand-maintained exclusion lists that broke whenever a new stdlib
%% class was added.

%% Scan the stdlib ebin directory for bt@* BEAM files.
%%
%% Two sources, always unioned (not "checked-in dir, else _build fallback"):
%% `apps/beamtalk_stdlib/ebin` holds the real, `just build-stdlib`-generated
%% production classes; `_build/*/lib/beamtalk_stdlib/ebin` also picks up
%% EUnit-only `bt@*` fixtures that compile_fixtures.escript copies there for
%% suites needing a genuinely Beamtalk-compiled module rather than a
%% hand-written `.erl` test double (BT-3251) — those have the same "no
%% abstract code" problem this exclusion exists for, but never land in the
%% checked-in production ebin dir, so the old either/or logic silently
%% skipped the `_build` scan whenever production classes already existed
%% (the common case) and left them unexcluded.
StdlibEbin = "apps/beamtalk_stdlib/ebin",
BtModules =
    lists:usort(
        [list_to_atom(filename:basename(F, ".beam"))
         || F <-
             filelib:wildcard(filename:join(StdlibEbin, "bt@*.beam")) ++
                 filelib:wildcard("_build/*/lib/beamtalk_stdlib/ebin/bt@*.beam")]
    ),

%% Helper: deep-merge a key into a proplist, preserving other keys.
SetKey = fun(Key, Value, Proplist) ->
    [{Key, Value} | lists:keydelete(Key, 1, Proplist)]
end,

%% Merge cover_excl_mods into CONFIG, preserving any manual excludes.
Config1 = case BtModules of
    [] -> CONFIG;  % No modules found yet (pre-build); leave config as-is
    _  ->
        ExistingCover = proplists:get_value(cover_excl_mods, CONFIG, []),
        MergedCover = lists:usort(ExistingCover ++ BtModules),
        SetKey(cover_excl_mods, MergedCover, CONFIG)
end,

%% Merge dialyzer exclude_mods into CONFIG, preserving any manual excludes.
Config2 = case BtModules of
    [] -> Config1;
    _  ->
        OldDialyzer = proplists:get_value(dialyzer, Config1, []),
        ExistingExclude = proplists:get_value(exclude_mods, OldDialyzer, []),
        MergedExclude = lists:usort(ExistingExclude ++ BtModules),
        NewDialyzer = SetKey(exclude_mods, MergedExclude, OldDialyzer),
        SetKey(dialyzer, NewDialyzer, Config1)
end,

%% BT-3896: generate the EUnit test set (`eunit_tests`) for a bare
%% `rebar3 eunit` — what `just test-runtime`, `just coverage-runtime` and CI
%% run. rebar3 only consults `eunit_tests` when no test arguments are given
%% on the command line, so `rebar3 eunit --module=...` / `--dir=...` keep
%% working as before.
%%
%% Why not `--app=...`: EUnit's `{application, App}` spec runs each source
%% module listed in the `.app` plus its `Module_tests` companion, so a test
%% module in `test/` without a `src/` counterpart in that app compiled fine
%% but was silently never run. This list is `{application, App}` for every
%% EUnit app plus `{module, M}` for every test-dir module the app specs do not
%% reach, so a new standalone suite runs without anyone registering it.
%%
%% The ONE place a test-dir module may be left out is `EunitExcluded`, each
%% with its reason. A stale entry (the module is gone, or is now reached as a
%% companion) fails the config load rather than lingering.
EunitApps = [beamtalk_runtime, beamtalk_workspace, beamtalk_compiler],
EunitExcluded = [
    %% {Module, "why it cannot run in the default EUnit pass"}
    {beamtalk_opaque_type_tests,
        "red, BT-3919: a dynamic `==` send to a Pid/Port/Reference raises "
        "does_not_understand and respondsTo: #== answers false (also for Integer), so "
        "pid_equality_inherited and {pid,port,reference}_responds_to fail"}
],
RuntimeRoot = filename:dirname(filename:absname(SCRIPT)),
ErlFilesIn = fun(SubDir) ->
    [F
     || App <- EunitApps,
        F <- filelib:wildcard(
            filename:join([RuntimeRoot, "apps", atom_to_list(App), SubDir, "**", "*.erl"])
        )]
end,
ModOf = fun(F) -> filename:basename(F, ".erl") end,
SrcMods = lists:usort([ModOf(F) || F <- ErlFilesIn("src")]),
%% A test-dir module is a suite when it defines a zero-arity `*_test` or
%% `*_test_` function — EUnit's own discovery rule — whatever the module is
%% called. Fixtures and helpers define none and are left out.
DefinesTests = fun(F) ->
    {ok, Src} = file:read_file(F),
    match =:=
        re:run(Src, "^[a-z][A-Za-z0-9_@]*_test_?\\(\\)\\s*->", [multiline, {capture, none}])
end,
TestDirSuites = lists:usort([ModOf(F) || F <- ErlFilesIn("test"), DefinesTests(F)]),
%% `{application, A}` / `{module, M}` both also run `M_tests` when it exists.
IsCompanionOf = fun(T, Mods) -> lists:any(fun(M) -> T =:= M ++ "_tests" end, Mods) end,
NotViaApps = [T || T <- TestDirSuites, not IsCompanionOf(T, SrcMods)],
Standalone = [T || T <- NotViaApps, not IsCompanionOf(T, NotViaApps)],
ExcludedNames = [atom_to_list(M) || {M, Reason} <- EunitExcluded, is_list(Reason), Reason =/= ""],
%% This script is evaluated by every rebar3 command (compile, dialyzer, ...),
%% so these errors say exactly which list to fix.
length(ExcludedNames) =:= length(EunitExcluded) orelse
    erlang:error(
        {"runtime/rebar.config.script: every EunitExcluded entry needs a non-empty reason",
            EunitExcluded}
    ),
case ExcludedNames -- Standalone of
    [] ->
        ok;
    Stale ->
        erlang:error(
            {"runtime/rebar.config.script: EunitExcluded names modules that are no longer "
             "standalone test suites (deleted, or now run as a src module's companion); "
             "remove them from EunitExcluded", Stale}
        )
end,
EunitTests =
    [{application, App} || App <- EunitApps] ++
        [{module, list_to_atom(M)} || M <- Standalone, not lists:member(M, ExcludedNames)],
Config3 = SetKey(eunit_tests, EunitTests, Config2),

Config3.
