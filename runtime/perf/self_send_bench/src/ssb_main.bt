// BT-3666: driver. Prints `PERF: <name> <ns/op>` lines to stderr.

Object subclass: SsbMain

  class run =>
    n := 200000
    self
      report: "actor_self_send_open"
      ns: (self timeActor: SsbOpenActor spawn n: n)
      n: n
    self
      report: "actor_self_send_sealed"
      ns: (self timeActor: SsbSealedActor spawn n: n)
      n: n
    self
      report: "actor_self_send_inherited_override"
      ns: (self timeActor: SsbInhActorSub spawn n: n)
      n: n
    self
      report: "class_self_send_open"
      ns: (self timeClass: SsbOpenClass n: n)
      n: n
    self
      report: "class_self_send_open_in_arm"
      ns: (self timeClass: SsbArmClass n: n)
      n: n
    self
      report: "class_self_send_sealed"
      ns: (self timeClass: SsbSealedClass n: n)
      n: n
    self
      report: "class_self_send_inherited_override"
      ns: (self timeClass: SsbInhSub n: n)
      n: n
    self
      report: "class_self_send_inherited_plain"
      ns: (self timeClass: SsbInhPlainSub n: n)
      n: n
    self
      report: "class_var_10r_3w_loop"
      ns: (self timeClass: SsbClassVarClass n: n)
      n: n
    self
      report: "class_var_10r_3w_loop_threaded"
      ns: (self timeClass: SsbClassVarThreadedLoopClass n: n)
      n: n
    self
      report: "instance_on_do_loop"
      ns: (self timeOnDo: SsbOnDoObject new n: n)
      n: n
    // A raise costs about 1000x a send: time fewer iterations so the whole
    // run stays inside the `beamtalk run` call timeout.
    rn := 2000
    self
      report: "class_on_do_raise_loop"
      ns: (self timeClass: SsbOnDoRaiseClass n: rn)
      n: rn
    self
      report: "instance_on_do_raise_loop"
      ns: (self timeOnDo: SsbOnDoRaiseObject new n: rn)
      n: rn
    self counters
    nil

  // BT-3925: Actor counter with an untyped vs a `:: Integer` `state:` field.
  // `beamtalk run SsbMain counters` runs just these cases.
  class counters =>
    n := 2000000
    self
      report: "actor_counter_loop_untyped"
      ns: (self timeActor: SsbUntypedCounterActor spawn n: n)
      n: n
    self
      report: "actor_counter_loop_typed"
      ns: (self timeActor: SsbTypedCounterActor spawn n: n)
      n: n
    sn := 200000
    self
      report: "actor_counter_send_untyped"
      ns: (self timeSends: SsbUntypedCounterActor spawn n: sn)
      n: sn
    self
      report: "actor_counter_send_typed"
      ns: (self timeSends: SsbTypedCounterActor spawn n: sn)
      n: sn
    nil

  // BT-4007 (ADR 0137 Phase 0 gates): `beamtalk run SsbMain adr0137`.
  // field_loop_call: gate 1, one gen_server:call per op, a method with ten
  // field reads and three writes, intrinsics only.
  // sends_call: gate 2, one call per op, ten in-process sends that each
  // update a field (ns per op / 10 = ns per bracketed send).
  // *_self_*: gate 3, a self-send per op (loop inside one call).
  class adr0137 =>
    n := 200000
    self
      report: "field_loop_call"
      ns: (self timeCalls: SsbFieldProbeActor spawn selector: #body n: n)
      n: n
    self
      report: "sends_call"
      ns: (self timeCalls: SsbFieldProbeActor spawn selector: #sends n: n)
      n: n
    self
      report: "adr0137_open_self_top"
      ns: (self timeTop: SsbOpenSelfProbeActor spawn n: n)
      n: n
    self
      report: "adr0137_open_self_arm"
      ns: (self timeArm: SsbOpenSelfProbeActor spawn n: n)
      n: n
    self
      report: "adr0137_sealed_self_top"
      ns: (self timeTop: SsbSealedSelfProbeActor spawn n: n)
      n: n
    self
      report: "adr0137_sealed_self_arm"
      ns: (self timeArm: SsbSealedSelfProbeActor spawn n: n)
      n: n
    nil

  class timeCalls: a selector: sel n: n =>
    1000 timesRepeat: [a perform: sel]
    start := DateTime monotonicNow
    n timesRepeat: [a perform: sel]
    DateTime monotonicNow - start

  class timeTop: a n: n =>
    a top: 1000
    start := DateTime monotonicNow
    a top: n
    DateTime monotonicNow - start

  class timeArm: a n: n =>
    a arm: 1000
    start := DateTime monotonicNow
    a arm: n
    DateTime monotonicNow - start

  class timeSends: a n: n =>
    1000 timesRepeat: [a increment]
    start := DateTime monotonicNow
    n timesRepeat: [a increment]
    DateTime monotonicNow - start

  class timeOnDo: o n: n =>
    o run: 1000
    start := DateTime monotonicNow
    o run: n
    DateTime monotonicNow - start

  class timeActor: a n: n =>
    a loop: 1000
    start := DateTime monotonicNow
    a loop: n
    DateTime monotonicNow - start

  class timeClass: c n: n =>
    c loop: 1000
    start := DateTime monotonicNow
    c loop: n
    DateTime monotonicNow - start

  class report: name ns: total n: n =>
    Console errorLine: "PERF: " ++ name ++ " " ++ (total / n) printString ++ "ns/op"
