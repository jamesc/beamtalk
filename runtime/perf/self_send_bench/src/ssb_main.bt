// BT-3666: driver. Prints `PERF: <name> <ns/op>` lines to stderr.

Object subclass: SsbMain

  class run =>
    n := 200000
    self
      report: "actor_self_send_open"
      ns: (self timeActor: SsbOpenActor spawn n: n)
      n: n
    self
      report: "actor_self_send_sealed"
      ns: (self timeActor: SsbSealedActor spawn n: n)
      n: n
    self
      report: "actor_self_send_inherited_override"
      ns: (self timeActor: SsbInhActorSub spawn n: n)
      n: n
    self
      report: "class_self_send_open"
      ns: (self timeClass: SsbOpenClass n: n)
      n: n
    self
      report: "class_self_send_open_in_arm"
      ns: (self timeClass: SsbArmClass n: n)
      n: n
    self
      report: "class_self_send_sealed"
      ns: (self timeClass: SsbSealedClass n: n)
      n: n
    self
      report: "class_self_send_inherited_override"
      ns: (self timeClass: SsbInhSub n: n)
      n: n
    self
      report: "class_self_send_inherited_plain"
      ns: (self timeClass: SsbInhPlainSub n: n)
      n: n
    self
      report: "class_var_10r_3w_loop"
      ns: (self timeClass: SsbClassVarClass n: n)
      n: n
    self
      report: "instance_on_do_loop"
      ns: (self timeOnDo: SsbOnDoObject new n: n)
      n: n
    // A raise costs about 1000x a send: time fewer iterations so the whole
    // run stays inside the `beamtalk run` call timeout.
    rn := 2000
    self
      report: "class_on_do_raise_loop"
      ns: (self timeClass: SsbOnDoRaiseClass n: rn)
      n: rn
    self
      report: "instance_on_do_raise_loop"
      ns: (self timeOnDo: SsbOnDoRaiseObject new n: rn)
      n: rn
    nil

  class timeOnDo: o n: n =>
    o run: 1000
    start := DateTime monotonicNow
    o run: n
    DateTime monotonicNow - start

  class timeActor: a n: n =>
    a loop: 1000
    start := DateTime monotonicNow
    a loop: n
    DateTime monotonicNow - start

  class timeClass: c n: n =>
    c loop: 1000
    start := DateTime monotonicNow
    c loop: n
    DateTime monotonicNow - start

  class report: name ns: total n: n =>
    Console errorLine: "PERF: " ++ name ++ " " ++ (total / n) printString ++ "ns/op"
