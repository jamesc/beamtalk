// lattice (silent, `Tier::Unknown`) and the runtime `pack/1` walk
// (`passthrough`, allowed through as an opaque unversioned term) — see the
// corpus entry's own `why` and `beamtalk_shape_migration.erl`'s
// `field_tier/1` doc.

Object subclass: ShapePlainObject
  label -> String => "plain"
