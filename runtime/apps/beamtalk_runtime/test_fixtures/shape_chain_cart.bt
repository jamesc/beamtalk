// BT-3536 (ADR 0123 Phase 2) regression fixture: beamtalk_shape_migration_tests
// exercises a genuine v1 -> v2 -> v3 chain (two real class-side hooks, invoked
// via local_call/3) through migrate/3. `shapeVersion:`/`migrateFromVN:` are
// not real language keywords yet (Phase 3) — `migrateFromV1:`/`migrateFromV2:`
// below are ordinary class-side method selectors, same as BT-3535's
// shape_hook_cart.bt spike fixture. The tests meck this module's
// `__beamtalk_meta/0` to add the `'shape_version'`/`'shape_migrations'` keys
// Phase 3 will eventually emit for real.
//
// Hooks read/write `old` via the Erlang FFI gateway (`maps:get/2`,
// `maps:put/3`) for the same reason shape_hook_cart.bt does — a `Dictionary`
// send on a non-literal value falls through to runtime dispatch, which is
// `undef` for an `@primitive`-only class like `Dictionary` (BT-3541).

Actor subclass: ShapeChainCart
  state: itemCount :: Integer = 0
  state: total :: Integer = 0
  state: tag :: String = "none"

  class migrateFromV1: old :: Dictionary -> Dictionary =>
    Erlang maps
      put: #total
      value: ((Erlang maps get: #itemCount from: old) * 10)
      in: old

  class migrateFromV2: old :: Dictionary -> Dictionary =>
    Erlang maps
      put: #tag
      value: "migrated"
      in: old

  addItem => self.itemCount := self.itemCount + 1

  getItemCount => ^self.itemCount

  getTotal => ^self.total

  getTag => ^self.tag
