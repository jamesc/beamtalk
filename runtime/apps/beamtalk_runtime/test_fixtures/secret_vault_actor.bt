// SecretVaultActor - BT-4567: an actor declaring a secret state slot and
// secret selectors, so beamtalk_actor_redaction_tests can check the compiled
// format_status/1 against sys:get_status and a real crash report.

Actor subclass: SecretVaultActor
  state: verifier = "vault-s3cret"
  state: count = 7

  class secretState -> List(Symbol) => #(#verifier)

  class secretSelectors -> List(Symbol) => #(#unlock:, #explode:)

  unlock: code => code * 2

  count => self.count

  explode: password =>
    self error: "deliberate cast error"
