{
  "_comment": "BT-4485: the types whose values cross beamtalk_erlang_proxy unchanged, so an inline FFI call may skip the proxy. Rust: native_type_registry ffi_result_passes_unchanged / ffi_arg_passes_unchanged must accept exactly the listed types and reject the not_proven ones. Erlang: beamtalk_erlang_proxy_tests checks every sample (an Erlang expression) passes through unchanged, and every arg sample passes one of arg_runtime_guards (the erlang BIFs a direct call checks each argument with at run time; any other value falls back to the proxy). A '#name' type is a Symbol singleton.",
  "result_passthrough": [
    {"type": "Integer", "samples": ["0", "-7", "123456789012345678901234567890"]},
    {"type": "Float", "samples": ["1.5", "-0.0"]},
    {"type": "Number", "samples": ["3", "2.5"]},
    {"type": "Boolean", "samples": ["true", "false"]},
    {"type": "True", "samples": ["true"]},
    {"type": "False", "samples": ["false"]},
    {"type": "UndefinedObject", "samples": ["nil"]},
    {"type": "Nil", "samples": ["nil"]},
    {"type": "Pid", "samples": ["self()"]},
    {"type": "Dictionary", "samples": ["#{}", "#{a => [1, 2], ok => {ok, 1}}"]},
    {"type": "Block", "samples": ["fun() -> ok end"]},
    {"type": "#undefined", "samples": ["undefined"]},
    {"type": "#infinity", "samples": ["infinity"]}
  ],
  "result_not_proven": ["Symbol", "#ok", "#error", "String", "Binary", "List", "Tuple", "Result", "Object", "Dynamic"],
  "arg_passthrough": [
    {"type": "Integer", "samples": ["0", "-7"]},
    {"type": "Float", "samples": ["1.5"]},
    {"type": "Number", "samples": ["3"]},
    {"type": "Boolean", "samples": ["true", "false"]},
    {"type": "True", "samples": ["true"]},
    {"type": "False", "samples": ["false"]},
    {"type": "UndefinedObject", "samples": ["nil"]},
    {"type": "Nil", "samples": ["nil"]},
    {"type": "Pid", "samples": ["self()"]},
    {"type": "Symbol", "samples": ["foo", "ok", "error"]},
    {"type": "#ok", "samples": ["ok"]}
  ],
  "arg_runtime_guards": ["is_number", "is_atom", "is_pid"],
  "arg_not_proven": ["String", "Binary", "List", "Tuple", "Dictionary", "Block", "Result", "Object", "Dynamic"]
