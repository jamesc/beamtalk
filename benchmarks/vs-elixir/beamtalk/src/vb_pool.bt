// BT-4502: pools of VbCounter for rows 15a/15b (DynamicSupervisor
// startChild + terminateChild), paired with Elixir's DynamicSupervisor.
DynamicSupervisor(VbCounter) subclass: VbPool

  childClass => VbCounter

// As VbPool, with a maxChildren cap (never reached: each start is followed by
// a terminate), so the capped start path runs.
DynamicSupervisor(VbCounter) subclass: VbCappedPool

  childClass => VbCounter

  maxChildren -> Integer => 8
