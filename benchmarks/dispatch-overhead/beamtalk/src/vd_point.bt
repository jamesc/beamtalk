// Sealed Value: sends to it can be resolved statically.
sealed Value subclass: VdPoint
  field: x :: Integer = 0
  field: y :: Integer = 0

  // Self sends: `twice` calls `self x`, `self sum` calls two getters.
  twice -> Integer => self x + self x
  sum -> Integer => self x + self y
  viaHelper -> Integer => self helper
  helper -> Integer => self.x
