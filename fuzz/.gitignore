target
artifacts
coverage

# Allow initial seed corpus, but ignore fuzzer-generated corpus.
#
# compile_pipeline has no committed seeds here: it's seeded live from
# stdlib/test/ and tests/repl-protocol/cases/ (passed as extra `cargo fuzz
# run` corpus dirs) instead of a copied snapshot, so corpus/compile_pipeline/
# only ever holds fuzzer-discovered growth -- fully ignored, same as any
# other fuzzer-grown corpus dir.
corpus/*
!corpus/parse_arbitrary/
corpus/parse_arbitrary/*
!corpus/parse_arbitrary/*.bt
