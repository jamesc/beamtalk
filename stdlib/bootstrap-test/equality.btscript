// Test structural equality semantics (BT-188)
//
// Beamtalk uses Erlang's `==` operator, which provides:
// - Value equality with type coercion for primitives
// - Structural equality for value types (compares map contents)
// - Identity comparison for actors (compares pids)

// ═══════════════════════════════════════════════════════════════════════════
// Primitive Type Equality with Coercion
// ═══════════════════════════════════════════════════════════════════════════

// Numeric coercion: integer and float with same value are equal
1.0 == 1
// => true

// Numeric inequality: different values
1.0 /= 2
// => true
1 /= 2
// => true

// String equality
"hello" == "hello"
// => true
"hello" /= "world"
// => true

// Boolean equality
true == true
// => true
false == false
// => true
true /= false
// => true

// ═══════════════════════════════════════════════════════════════════════════
// Strict Equality (no type coercion) — ADR 0002
// ═══════════════════════════════════════════════════════════════════════════

// Use `=:=` for strict equality without coercion
1.0 =:= 1.0
// => true
1 =:= 1
// => true

// Strict vs loose equality — BT-1562: int and float are distinct types
1.0 =:= 1
// => false

// Loose equality coerces, so int/float with same numeric value are equal
1.0 == 1
// => true

// Strict inequality operator: =/=
1.0 =/= 1
// => true
1.0 =/= 1.0
// => false

// Loose inequality: values that are loosely equal return false for /=
3 /= 3
// => false
3 /= 4
// => true

// ═══════════════════════════════════════════════════════════════════════════
// Overridable Equality: `equals:` — BT-2997
// ═══════════════════════════════════════════════════════════════════════════

// `=:=`, `=/=`, `==` and `/=` lower straight to Erlang BIFs and never
// dispatch, so a class cannot override them (the compiler rejects the
// attempt). `Object equals:` is the overridable counterpart; it defaults to
// `=:=`, so on classes that do not override it the two agree exactly.
42 equals: 42
// => true
42 equals: 43
// => false

// Strict by default: no numeric coercion, same as `=:=`
42 equals: 42.0
// => false

// Reaches Object's default through primitive dispatch, for every receiver kind
"ab" equals: "ab"
// => true
#foo equals: #foo
// => true
#(1, 2) equals: #(1, 2)
// => true
true equals: true
// => true
nil equals: nil
// => true

// ═══════════════════════════════════════════════════════════════════════════
// Value Type Equality (Map Contents) - NOT YET IMPLEMENTED
// ═══════════════════════════════════════════════════════════════════════════

// TODO: Map literals (#{key => value}) not yet implemented
// When implemented, test:
// - Two maps with same keys/values are equal
// - Maps with different values are not equal

// ═══════════════════════════════════════════════════════════════════════════
// Actor Identity (Process PIDs)
// ═══════════════════════════════════════════════════════════════════════════

// @load test/fixtures/counter.bt

// Actors are compared by pid - different spawns are not equal
c1 := Counter spawn
// => Actor(Counter, _)
c2 := Counter spawn
// => Actor(Counter, _)

// Different actor instances are not equal (different pids)
c1 /= c2
// => true

// Same reference is equal to itself
c1 == c1
// => true

// ═══════════════════════════════════════════════════════════════════════════
// Edge Cases
// ═══════════════════════════════════════════════════════════════════════════

// Empty maps are equal - NOT YET IMPLEMENTED
// TODO: Map literals not yet supported
// #{} == #{}
// // => true

// Zero values with coercion
0.0 == 0
// => true
0 == 0.0
// => true

// Negative values
-1.0 == -1
// => true
-5 /= -6
// => true
