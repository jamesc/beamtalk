// BT-3949: see stdlib/test/fixtures/bt3949literal_arm_{class,value,actor}.bt.

TestCase subclass: Bt3949LiteralArmTest
  field: n = 0

  // A TestCase method is a value-type method: a fold whose block writes a field
  // threads `Self`, so it is a carrier construct here too (BT-3949 review).
  vtFieldFoldMap: flag =>
    data := flag
      ifTrue: [
        #{"xs" => (#(1, 2)
            collect: [:s |
              self.n := self.n + s
              s
            ])}
      ]
      ifFalse: [#{"xs" => #()}]
    #[data at: "xs", self.n]

  vtFieldFoldArray: flag =>
    data := flag
      ifTrue: [
        #[0, (#(1, 2)
          collect: [:s |
            self.n := self.n + s
            s
          ])]
      ]
      ifFalse: [#[0, #()]]
    #[data at: 2, self.n]

  vtFieldFoldKeyword: flag =>
    data := flag
      ifTrue: [
        #{}
          at: "xs"
          put: (#(1, 2)
            collect: [:s |
              self.n := self.n + s
              s
            ])
      ]
      ifFalse: [#{"xs" => #()}]
    #[data at: "xs", self.n]

  testIssueRepro =>
    r := Bt3949LiteralArmActor spawn inBranchMapLiteral
    self assert: r equals: #(10, 20)
    self assert: r class equals: List

  testMapIf =>
    rs := #[(Bt3949LiteralArmClass mapIf: true), ((Bt3949LiteralArmValue new) mapIf: true), ((Bt3949LiteralArmActor spawn) mapIf: true)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testArrayIf =>
    rs := #[(Bt3949LiteralArmClass arrayIf: true), ((Bt3949LiteralArmValue new) arrayIf: true), ((Bt3949LiteralArmActor spawn) arrayIf: true)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testKeywordIf =>
    rs := #[(Bt3949LiteralArmClass keywordIf: true), ((Bt3949LiteralArmValue new) keywordIf: true), ((Bt3949LiteralArmActor spawn) keywordIf: true)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testMapIfFalse =>
    rs := #[(Bt3949LiteralArmClass mapIfFalse: false), ((Bt3949LiteralArmValue new) mapIfFalse: false), ((Bt3949LiteralArmActor spawn) mapIfFalse: false)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testMapMatch =>
    rs := #[(Bt3949LiteralArmClass mapMatch: 1), ((Bt3949LiteralArmValue new) mapMatch: 1), ((Bt3949LiteralArmActor spawn) mapMatch: 1)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testArrayMatch =>
    rs := #[(Bt3949LiteralArmClass arrayMatch: 1), ((Bt3949LiteralArmValue new) arrayMatch: 1), ((Bt3949LiteralArmActor spawn) arrayMatch: 1)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testKeywordMatch =>
    rs := #[(Bt3949LiteralArmClass keywordMatch: 1), ((Bt3949LiteralArmValue new) keywordMatch: 1), ((Bt3949LiteralArmActor spawn) keywordMatch: 1)]
    self assert: rs equals: #[#(10, 20), #(10, 20), #(10, 20)]
    self assert: (rs collect: [:r | r class]) equals: #[List, List, List]

  testFieldFoldIf =>
    a := Bt3949LiteralArmActor spawn
    self assert: (a fieldFoldIf: true) equals: #[#(1, 2), 3]
    self assert: a hits equals: 3

  testFieldFoldMatch =>
    a := Bt3949LiteralArmActor spawn
    self assert: (a fieldFoldMatch: 1) equals: #[#(1, 2), 3]
    self assert: a hits equals: 3

  testValueTypeFieldWritingFoldInMapLiteral =>
    self assert: (self vtFieldFoldMap: true) equals: #[#(1, 2), 3]

  testValueTypeFieldWritingFoldInArrayLiteral =>
    self assert: (self vtFieldFoldArray: true) equals: #[#(1, 2), 3]

  testValueTypeFieldWritingFoldInKeywordArgument =>
    self assert: (self vtFieldFoldKeyword: true) equals: #[#(1, 2), 3]
