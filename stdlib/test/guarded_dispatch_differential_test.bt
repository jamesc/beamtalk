// BT-4292: the differential send fixture of epic BT-4291 (guarded static
// dispatch). The governing rule is the ADR 0025 amendment (2026-10-29): a
// static type may choose a direct-call target, but a run-time guard must
// prove it reaches exactly what dynamic dispatch reaches, and a guard miss
// falls back to the dynamic send. This fixture pins "exactly what dynamic
// dispatch reaches" for every send shape the epic's children convert, before
// they convert it, and must stay green as BT-4293 (open tagged-map classes,
// now converted: see testOpenValueTypedSendsCompileToTheDirectShape), BT-4294
// (built-in receivers, now converted: see
// testBuiltinTypedSendsCompileToTheDirectShape) and BT-4295 (class
// references) turn them into guarded direct calls.
//
// It generalises BT-4150's sealed_direct_dispatch_differential_test.bt (same
// machinery: fixtures/dispatch_differential_case.bt) from one sealed class to
// rows, one statement each:
//
// - A send row, `self send: #label typed: [:r :: T | r sel] dynamic: [:r |
//   r sel] on: receiver`. The typed block annotates its parameter, so the
//   send inside compiles with that static receiver type; the dynamic block
//   is its untyped twin. Both run on `receiver` and the outcomes (value, or
//   full error shape) must agree.
// - An arm row, `self armOutcome: #sel args: #(...) on: receiver in: module`:
//   the class module's `dispatch/3` — exactly the tag-matched arm a guarded
//   call emits — against `beamtalk_message_dispatch:send/3`.
//
// The built-in rows follow the routing fixture
// (runtime/apps/beamtalk_runtime/test/fixtures/tagged_map_routing_conformance.json):
// every guarded row gets a hit row, plus the misses its guard must reject (the
// reserved tagged tuples typed as `Tuple`, at their own size and at others,
// `true`/`false`/`nil` typed as `Symbol`, a `'__class_mod__'` map typed as
// `Dictionary`, and lying annotations). The runtime half
// of that fixture checks `Module:dispatch/3` against `send/3` per built-in row
// directly (beamtalk_tagged_map_routing_conformance_tests).
//
// To add a case, add a row to the test method for its receiver kind, or a new
// test method for a new kind. Workspace-only mutations (a live patch that
// recompiles the class, `removeSelector:` of a class-body method) are in
// tests/repl-protocol/cases/guarded_dispatch_differential.btscript.
// Class-side sends (epic BT-4297, ADR 0142) have their own rows in
// class_dispatch_differential_test.bt (BT-4298).
//
// Fixtures: fixtures/guarded_diff_base.bt, fixtures/guarded_diff_point.bt,
// fixtures/guarded_diff_point_sub.bt, fixtures/guarded_diff_impostor.bt,
// fixtures/guarded_diff_proxy.bt, fixtures/type_pattern_actor_fixture.bt,
// fixtures/counter.bt.

// BT-4412: receivers declared through a type alias take the same guarded
// direct call as the aliased type (`testAliasTypedReceivers`).
type GuardedDiffPair = Tuple(Integer, Integer)
type GuardedDiffOptions = Dictionary(Symbol, Integer)
type GuardedDiffPointAlias = GuardedDiffPoint

DispatchDifferentialCase subclass: GuardedDispatchDifferentialTest

  // === Receivers ===
  point -> GuardedDiffPoint => GuardedDiffPoint new: #{#x => 3, #y => 4}

  pointSub -> GuardedDiffPointSub =>
    GuardedDiffPointSub new: #{#x => 3, #y => 4}

  impostor -> GuardedDiffImpostor => GuardedDiffImpostor new: #{#x => 5}

  // The fixture's compiled module (unqualified `bt@<stem>` under
  // `beamtalk test`, BT-4152).
  pointModule -> Symbol => #'bt@guarded_diff_point'

  // A map whose `'__class_mod__'` key names a compiled actor module:
  // `beamtalk_tagged_map:class_of/1` reads its class from that module, so it
  // is not a `Dictionary`.
  classModMap => #{#__class_mod__ => #'bt@type_pattern_actor_fixture', #k => 1}

  // A `{beamtalk_supervisor, Class, Module, Pid}` handle.
  supervisorHandle =>
    Erlang erlang list_to_tuple: #(#beamtalk_supervisor, #Supervisor, #'bt@stdlib@supervisor', Pid current)

  // A tuple built from `elements`, so a reserved head can be paired with a
  // size the runtime does not reserve it at.
  tupleOf: elements => Erlang erlang list_to_tuple: elements

  // The BEAM import table of this test module: a guarded direct call is the
  // only shape that names a module's `dispatch/3` statically.
  importedCalls =>
    path := Erlang code which: #'bt@guarded_dispatch_differential_test'
    // The FFI coerces charlist arguments to Strings, which `beam_lib`
    // rejects, so the filename travels as an atom. The reply is
    // `Result ok: {Module, [{imports, Imports}]}`.
    reply := Erlang erlang
      apply: #beam_lib
      module: #chunks
      args: #(Erlang erlang binary_to_atom: path, #(#imports))
    (reply value at: 2) first at: 2

  // A pid that has exited: a future-protocol send to it only posts a
  // message, so it answers the same however often it is sent.
  deadPid =>
    pid := [nil] fork
    50 timesRepeat: [pid isAlive ifTrue: [Timer sleep: 10]]
    pid

  // === Typed sends that DNU, in methods so `@expect` can mark them ===
  typedUnknown: r :: GuardedDiffPoint =>
    @expect dnu
    r noSuchSelector

  typedUnknownKeyword: r :: GuardedDiffPoint =>
    @expect dnu
    r noSuch: 1 selector: 2

  // BT-4390: `Pid` special selectors (the future protocol `send_pid/3`
  // answers through `beamtalk_future`) and a run-time `String` extension;
  // neither is declared on the class, so the checker would flag the send.
  typedPidWhenResolved: r :: Pid =>
    @expect dnu
    r whenResolved: [:v | v]

  typedPidWhenRejected: r :: Pid =>
    @expect dnu
    r whenRejected: [:e | e]

  typedStringExtension: r :: String =>
    @expect dnu
    r bt4390Extended

  // === Open Value class: plain and keyword sends, inheritance, errors ===
  testOpenValueSends =>
    p := self point
    self
      send: #unary
      typed: [:r :: GuardedDiffPoint | r sum]
      dynamic: [:r | r sum]
      on: p
    self
      send: #keyword
      typed: [:r :: GuardedDiffPoint | r add: 10]
      dynamic: [:r | r add: 10]
      on: p
    self
      send: #multiKeyword
      typed: [:r :: GuardedDiffPoint | r add: 1 and: 2]
      dynamic: [:r | r add: 1 and: 2]
      on: p
    self
      send: #ownOverride
      typed: [:r :: GuardedDiffPoint | r describe]
      dynamic: [:r | r describe]
      on: p
    self
      send: #inherited
      typed: [:r :: GuardedDiffPoint | r baseOnly]
      dynamic: [:r | r baseOnly]
      on: p
    self
      send: #objectProtocol
      typed: [:r :: GuardedDiffPoint | r printString]
      dynamic: [:r | r printString]
      on: p
    self
      send: #generatedSetter
      typed: [:r :: GuardedDiffPoint | r withY: 40]
      dynamic: [:r | r withY: 40]
      on: p
    self
      send: #dnuUnary
      typed: [:r | self typedUnknown: r]
      dynamic: [:r | r noSuchSelector]
      on: p
    self
      send: #dnuKeyword
      typed: [:r | self typedUnknownKeyword: r]
      dynamic: [:r | r noSuch: 1 selector: 2]
      on: p
    self
      send: #errorInMethod
      typed: [:r :: GuardedDiffPoint | r boom]
      dynamic: [:r | r boom]
      on: p

  // BT-4293: the open-Value typed rows above really take the guarded direct
  // call. Only that shape names the fixture module's `dispatch/3` statically,
  // so its entry in this module's BEAM import table proves it is emitted; if
  // it stopped being emitted every open-Value row would silently compare
  // dynamic with dynamic.
  testOpenValueTypedSendsCompileToTheDirectShape =>
    self assert: (self importedCalls includes: {self pointModule, #dispatch, 3})

  // BT-4294, BT-4390, BT-4510: the built-in typed rows with a route in the
  // routing fixture really take the representation-guarded direct call
  // (String and Pid for their ordinary selectors, Binary through both its
  // bare-binary and String halves).
  testBuiltinTypedSendsCompileToTheDirectShape =>
    imports := self importedCalls
    #(#'bt@stdlib@integer', #'bt@stdlib@float', #'bt@stdlib@string', #'bt@stdlib@binary', #'bt@stdlib@symbol', #'bt@stdlib@true', #'bt@stdlib@false', #'bt@stdlib@undefined_object', #'bt@stdlib@block', #'bt@stdlib@tuple', #'bt@stdlib@list', #'bt@stdlib@dictionary', #'bt@stdlib@pid', #'bt@stdlib@reference', #'bt@stdlib@port') do: [:m |
      self assert: (imports includes: {m, #dispatch, 3})
    ]

  // `perform:` and its family, including `perform:withArguments:timeout:`,
  // which `send/3` rewrites before it classifies the receiver.
  testPerformFamily =>
    p := self point
    self
      send: #perform
      typed: [:r :: GuardedDiffPoint | r perform: #sum]
      dynamic: [:r | r perform: #sum]
      on: p
    self
      send: #performUnknown
      typed: [:r :: GuardedDiffPoint | r perform: #noSuchSelector]
      dynamic: [:r | r perform: #noSuchSelector]
      on: p
    self
      send: #performWithArguments
      typed: [:r :: GuardedDiffPoint |
        r perform: #add:and: withArguments: #(1, 2)
      ]
      dynamic: [:r | r perform: #add:and: withArguments: #(1, 2)]
      on: p
    self
      send: #performWithArgumentsTimeout
      typed: [:r :: GuardedDiffPoint |
        r
          perform: #add:and:
          withArguments: #(1, 2)
          timeout: 1000
      ]
      dynamic: [:r |
        r
          perform: #add:and:
          withArguments: #(1, 2)
          timeout: 1000
      ]
      on: p

  // Extension-registry selectors (ADR 0066), resolved inside `dispatch/3`.
  testExtensions =>
    p := self point
    self
      send: #extension
      typed: [:r :: GuardedDiffPoint | r diffExtended]
      dynamic: [:r | r diffExtended]
      on: p
    self
      send: #extensionOverridesInherited
      typed: [:r :: GuardedDiffPoint | r shadowedByExtension]
      dynamic: [:r | r shadowedByExtension]
      on: p

  // `doesNotUnderstand:args:` answers every unknown selector.
  testDoesNotUnderstandArgs =>
    px := GuardedDiffProxy new
    self
      send: #proxiedKeyword
      typed: [:r :: GuardedDiffProxy | r anything: 1 else: 2]
      dynamic: [:r | r anything: 1 else: 2]
      on: px
    self
      send: #proxiedPerform
      typed: [:r :: GuardedDiffProxy | r perform: #anything]
      dynamic: [:r | r perform: #anything]
      on: px

  // A subclass instance and lying annotations: the guard must miss and the
  // dynamic answer win, `doesNotUnderstand:` included.
  testGuardMisses =>
    sub := self pointSub
    imp := self impostor
    self
      send: #subclassOverride
      typed: [:r :: GuardedDiffPoint | r sum]
      dynamic: [:r | r sum]
      on: sub
    self
      send: #subclassInherits
      typed: [:r :: GuardedDiffPoint | r describe]
      dynamic: [:r | r describe]
      on: sub
    self
      send: #subclassKeyword
      typed: [:r :: GuardedDiffPoint | r add: 10]
      dynamic: [:r | r add: 10]
      on: sub
    self
      send: #lyingOtherValue
      typed: [:r :: GuardedDiffPoint | r sum]
      dynamic: [:r | r sum]
      on: imp
    self
      send: #lyingOtherValueDnu
      typed: [:r :: GuardedDiffPoint | r add: 10]
      dynamic: [:r | r add: 10]
      on: imp
    self
      send: #lyingInteger
      typed: [:r :: GuardedDiffPoint | r sum]
      dynamic: [:r | r sum]
      on: 42
    self
      send: #lyingNil
      typed: [:r :: GuardedDiffPoint | r add: 1 and: 2]
      dynamic: [:r | r add: 1 and: 2]
      on: nil
    self
      send: #lyingDictionary
      typed: [:r :: GuardedDiffPoint | r baseOnly]
      dynamic: [:r | r baseOnly]
      on: #{#x => 1}

  // BT-4412: an alias-typed receiver hits and misses its guard exactly like
  // the aliased type.
  // BT-4486: protocol-typed receivers (fixtures/guarded_diff_summable.bt). `GuardedDiffPoint`, its subclass and
  // `GuardedDiffImpostor` all answer `sum`, so each is a guarded arm; a
  // tagged value that answers nothing, a primitive and a missing selector
  // take the dynamic send and must agree with it.
  testProtocolTypedReceivers =>
    self
      send: #protoPoint
      typed: [:r :: GuardedDiffSummable | r sum]
      dynamic: [:r | r sum]
      on: self point
    self
      send: #protoPointSub
      typed: [:r :: GuardedDiffSummable | r sum]
      dynamic: [:r | r sum]
      on: self pointSub
    self
      send: #protoImpostor
      typed: [:r :: GuardedDiffSummable | r sum]
      dynamic: [:r | r sum]
      on: self impostor
    self
      send: #protoNonConformingTagged
      typed: [:r :: GuardedDiffSummable | r sum]
      dynamic: [:r | r sum]
      on: GuardedDiffBase new
    self
      send: #protoPrimitive
      typed: [:r :: GuardedDiffSummable | r sum]
      dynamic: [:r | r sum]
      on: 42

  testAliasTypedReceivers =>
    self
      send: #aliasTuple
      typed: [:r :: GuardedDiffPair | r at: 1]
      dynamic: [:r | r at: 1]
      on: (Tuple withAll: #(7, 8))
    self
      send: #aliasDictionary
      typed: [:r :: GuardedDiffOptions | r at: #k put: 1]
      dynamic: [:r | r at: #k put: 1]
      on: #{#a => 1}
    self
      send: #aliasValue
      typed: [:r :: GuardedDiffPointAlias | r baseOnly]
      dynamic: [:r | r baseOnly]
      on: self point
    self
      send: #aliasValueMiss
      typed: [:r :: GuardedDiffPointAlias | r baseOnly]
      dynamic: [:r | r baseOnly]
      on: #{#x => 1}

  // One hit per guarded row of the routing fixture.
  testBuiltinReceivers =>
    self
      send: #integer
      typed: [:r :: Integer | r printString]
      dynamic: [:r | r printString]
      on: 42
    self
      send: #float
      typed: [:r :: Float | r printString]
      dynamic: [:r | r printString]
      on: 1.5
    self
      send: #string
      typed: [:r :: String | r size]
      dynamic: [:r | r size]
      on: "abc"
    self
      send: #stringKeyword
      typed: [:r :: String | r includesSubstring: "b"]
      dynamic: [:r | r includesSubstring: "b"]
      on: "abc"
    self
      send: #stringSpecialSelector
      typed: [:r :: String | r asHex]
      dynamic: [:r | r asHex]
      on: "abc"
    self
      send: #stringSpecialKeyword
      typed: [:r :: String | r byteAt: 1]
      dynamic: [:r | r byteAt: 1]
      on: "abc"
    self
      send: #binary
      typed: [:r :: Binary | r size]
      dynamic: [:r | r size]
      on: (Erlang erlang list_to_binary: #(1, 2))
    self
      send: #symbol
      typed: [:r :: Symbol | r asString]
      dynamic: [:r | r asString]
      on: #abc
    self
      send: #true
      typed: [:r :: True | r printString]
      dynamic: [:r | r printString]
      on: true
    self
      send: #false
      typed: [:r :: False | r printString]
      dynamic: [:r | r printString]
      on: false
    self
      send: #nil
      typed: [:r :: UndefinedObject | r printString]
      dynamic: [:r | r printString]
      on: nil
    self
      send: #block
      typed: [:r :: Block | r arity]
      dynamic: [:r | r arity]
      on: [:a | a]
    self
      send: #tuple
      typed: [:r :: Tuple | r at: 1]
      dynamic: [:r | r at: 1]
      on: (Tuple withAll: #(7, 8))
    self
      send: #list
      typed: [:r :: List | r includes: 2]
      dynamic: [:r | r includes: 2]
      on: #(1, 2)
    self
      send: #dictionary
      typed: [:r :: Dictionary | r at: #k put: 1]
      dynamic: [:r | r at: #k put: 1]
      on: #{#a => 1}
    self
      send: #pid
      typed: [:r :: Pid | r isAlive]
      dynamic: [:r | r isAlive]
      on: Pid current
    self
      send: #pidPrintString
      typed: [:r :: Pid | r printString]
      dynamic: [:r | r printString]
      on: Pid current
    self
      send: #pidSpecialSelector
      typed: [:r | self typedPidWhenResolved: r]
      dynamic: [:r | r whenResolved: [:v | v]]
      on: self deadPid
    self
      send: #pidSpecialRejected
      typed: [:r | self typedPidWhenRejected: r]
      dynamic: [:r | r whenRejected: [:e | e]]
      on: self deadPid
    self
      send: #reference
      typed: [:r :: Reference | r printString]
      dynamic: [:r | r printString]
      on: Erlang erlang make_ref
    // Open a port here rather than borrowing an ambient one: a node is not
    // guaranteed to have any (the Windows runner has none). A UDP socket is
    // a port on every OS and needs no external executable.
    port := (Erlang gen_udp open: 0) value
    self
      send: #port
      typed: [:r :: Port | r printString]
      dynamic: [:r | r printString]
      on: port
    Erlang gen_udp close: port

  // Values each built-in guard must reject.
  testBuiltinGuardMisses =>
    self
      send: #stringTypedTuple
      typed: [:r :: Tuple | r size]
      dynamic: [:r | r size]
      on: "abc"
    self
      send: #supervisorTypedTuple
      typed: [:r :: Tuple | r size]
      dynamic: [:r | r size]
      on: self supervisorHandle
    self
      send: #objectHeadTripleTypedTuple
      typed: [:r :: Tuple | r size]
      dynamic: [:r | r size]
      on: (self tupleOf: #(#beamtalk_object, 1, 2))
    self
      send: #stringHeadTripleTypedTuple
      typed: [:r :: Tuple | r size]
      dynamic: [:r | r size]
      on: (self tupleOf: #(#beamtalk_string, 1, 2))
    self
      send: #supervisorHeadPairTypedTuple
      typed: [:r :: Tuple | r size]
      dynamic: [:r | r size]
      on: (self tupleOf: #(#beamtalk_supervisor, 1))
    self
      send: #emptyTuple
      typed: [:r :: Tuple | r size]
      dynamic: [:r | r size]
      on: (self tupleOf: #())
    self
      send: #symbolTypedTrue
      typed: [:r :: True | r printString]
      dynamic: [:r | r printString]
      on: #true2
    self
      send: #listTypedNilKeyword
      typed: [:r :: List | r from: 1 to: 2]
      dynamic: [:r | r from: 1 to: 2]
      on: nil
    self
      send: #floatTypedInteger
      typed: [:r :: Float | r printString]
      dynamic: [:r | r printString]
      on: 3
    self
      send: #blockTypedTuple
      typed: [:r :: Block | r arity]
      dynamic: [:r | r arity]
      on: (self tupleOf: #(1, 2))
    self
      send: #dictionaryTypedListDnu
      typed: [:r :: Dictionary | r keys]
      dynamic: [:r | r keys]
      on: #(1, 2)
    self
      send: #trueTypedSymbol
      typed: [:r :: Symbol | r asString]
      dynamic: [:r | r asString]
      on: true
    self
      send: #falseTypedSymbol
      typed: [:r :: Symbol | r asString]
      dynamic: [:r | r asString]
      on: false
    self
      send: #nilTypedSymbol
      typed: [:r :: Symbol | r asString]
      dynamic: [:r | r asString]
      on: nil
    self
      send: #classModMapTypedDictionary
      typed: [:r :: Dictionary | r size]
      dynamic: [:r | r size]
      on: self classModMap
    self
      send: #taggedValueTypedDictionary
      typed: [:r :: Dictionary | r size]
      dynamic: [:r | r size]
      on: self point
    self
      send: #integerTypedList
      typed: [:r :: List | r includes: 2]
      dynamic: [:r | r includes: 2]
      on: 42
    self
      send: #stringTypedBinary
      typed: [:r :: Binary | r size]
      dynamic: [:r | r size]
      on: "abc"
    // BT-4510: a `Binary`-typed String takes the String route, so a
    // selector the two classes answer differently (`String>>asString` is
    // the String, `Binary>>asString` a Result) still agrees with dynamic
    // dispatch, as does a String special selector (dynamic send).
    self
      send: #stringTypedBinaryOverridden
      typed: [:r :: Binary | r asString]
      dynamic: [:r | r asString]
      on: "abc"
    self
      send: #binaryTypedBinaryOverridden
      typed: [:r :: Binary | r asString]
      dynamic: [:r | r asString]
      on: (Erlang erlang list_to_binary: #(104, 105))
    self
      send: #stringTypedBinarySpecial
      typed: [:r :: Binary | r toBytes]
      dynamic: [:r | r toBytes]
      on: "abc"
    // BT-4510: `value` to a typed non-Block receiver is a typed send, not
    // block evaluation; a block lying as a Result misses the guard and is
    // still evaluated by the dynamic send.
    self
      send: #resultValue
      typed: [:r :: Result(Integer, Error) | r value]
      dynamic: [:r | r value]
      on: (Result ok: 3)
    self
      send: #blockTypedResultValue
      typed: [:r :: Result(Integer, Error) | r value]
      dynamic: [:r | r value]
      on: [7]
    // BT-4510: an interpolation segment's `displayString` takes the same
    // typed route as a written send.
    self
      send: #interpolatedStringTypedBinary
      typed: [:r :: Binary | "<{r}>"]
      dynamic: [:r | "<{r}>"]
      on: "abc"
    self
      send: #interpolatedInteger
      typed: [:r :: Integer | "<{r}>"]
      dynamic: [:r | "<{r}>"]
      on: 42
    self
      send: #interpolatedResult
      typed: [:r :: Result(Integer, Error) | "<{r}>"]
      dynamic: [:r | "<{r}>"]
      on: (Result ok: 3)
    self
      send: #binaryTypedString
      typed: [:r :: String | r size]
      dynamic: [:r | r size]
      on: (Erlang erlang list_to_binary: #(1, 2))
    self
      send: #symbolTypedString
      typed: [:r :: String | r size]
      dynamic: [:r | r size]
      on: #abc
    self
      send: #integerTypedPid
      typed: [:r :: Pid | r isAlive]
      dynamic: [:r | r isAlive]
      on: 42

  // An actor reference (a reserved `beamtalk_object` tuple) typed as a
  // Tuple, as the open Value class, and as a Pid (BT-4390).
  testActorReceiverMisses =>
    c := Counter spawn
    [
      self
        send: #actorTypedTuple
        typed: [:r :: Tuple | r size]
        dynamic: [:r | r size]
        on: c
      self
        send: #actorTypedValue
        typed: [:r :: GuardedDiffPoint | r sum]
        dynamic: [:r | r sum]
        on: c
      self
        send: #actorTypedPid
        typed: [:r :: Pid | r isAlive]
        dynamic: [:r | r isAlive]
        on: c
    ] ensure: [c stop]

  // The arms of GuardedDiffPoint's `dispatch/3` a guarded call would run,
  // including the selectors an earlier send handler claims at a source send.
  testPointDispatchArms =>
    p := self point
    m := self pointModule
    self
      armOutcome: #sum
      args: #()
      on: p
      in: m
    self
      armOutcome: #add:and:
      args: #(1, 2)
      on: p
      in: m
    self
      armOutcome: #baseOnly
      args: #()
      on: p
      in: m
    self
      armOutcome: #class
      args: #()
      on: p
      in: m
    self
      armOutcome: #fieldAt:
      args: #(#y)
      on: p
      in: m
    self
      armOutcome: #fieldAt:put:
      args: #(#y, 99)
      on: p
      in: m
    self
      armOutcome: #perform:
      args: #(#sum)
      on: p
      in: m
    self
      armOutcome: #perform:
      args: #(#noSuchSelector)
      on: p
      in: m
    self
      armOutcome: #perform:withArguments:
      args: #(#add:and:, #(1, 2))
      on: p
      in: m
    self
      armOutcome: #respondsTo:
      args: #(#sum)
      on: p
      in: m
    self
      armOutcome: #noSuchSelector
      args: #()
      on: p
      in: m
    self
      armOutcome: #doesNotUnderstand:args:
      args: #(#noSuchSelector, #())
      on: p
      in: m
    self
      armOutcome: #diffExtended
      args: #()
      on: p
      in: m
    self
      armOutcome: #shadowedByExtension
      args: #()
      on: p
      in: m

  // `removeSelector:` of an extension re-exposes the inherited method, and
  // an extension registered at run time (the in-memory half of a live patch)
  // is reached at once: both act inside the class module's `dispatch/3`, so
  // a guarded direct call sees them exactly as the dynamic send does.
  // (A workspace live patch that recompiles the class body is in the REPL
  // fixture named in the header.)
  testRuntimeExtensionAndRemoveSelector =>
    p := self point
    self checkShadowed: #beforePatch on: p
    self assert: p shadowedThenRemoved equals: #fromBase
    Erlang beamtalk_extensions
      register: #GuardedDiffPoint
      selector: #shadowedThenRemoved
      fun: [:args :receiver | #fromPatch]
      owner: #bt4292
    [
      self checkShadowed: #afterPatch on: p
      self assert: p shadowedThenRemoved equals: #fromPatch
      GuardedDiffPoint removeSelector: #shadowedThenRemoved
      self checkShadowed: #afterRemoveSelector on: p
      self assert: p shadowedThenRemoved equals: #fromBase
    ] ensure: [
      GuardedDiffPoint removeSelector: #shadowedThenRemoved ifAbsent: [nil]
    ]

  // BT-4390: a `String` extension registered at run time is reached by a
  // typed `String` send, which now direct-calls `bt@stdlib@string`: that
  // module's `dispatch/3` consults the extension registry itself, and the
  // runtime's `beamtalk_extensions:has('String', _)` check only steers the
  // shared byte-level (special) selectors, which stay dynamic.
  testRuntimeStringExtension =>
    Erlang beamtalk_extensions
      register: #String
      selector: #bt4390Extended
      fun: [:args :receiver | receiver size * 10]
      owner: #bt4390
    [
      self
        send: #stringExtension
        typed: [:r | self typedStringExtension: r]
        dynamic: [:r | r bt4390Extended]
        on: "abcd"
      self assert: (self typedStringExtension: "abcd") equals: 40
    ] ensure: [
      Erlang beamtalk_extensions unregister: #String selector: #bt4390Extended
    ]

  checkShadowed: label :: Symbol on: p =>
    self
      send: label
      typed: [:r :: GuardedDiffPoint | r shadowedThenRemoved]
      dynamic: [:r | r shadowedThenRemoved]
      on: p

// Extension-registry selectors (ADR 0066), resolved inside `dispatch/3`: one
// adding a selector, one overriding a selector GuardedDiffBase defines.
GuardedDiffPoint >> diffExtended -> Integer => self sum * 10
GuardedDiffPoint >> shadowedByExtension -> Symbol => #fromExtension
