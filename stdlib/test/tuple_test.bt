// BT-417: Tests the Tuple primitive — creation, display, size, unwrap/unwrapOr:/
// unwrapOrElse: on ok/error/other tuples, and that unsupported constructors raise

TestCase subclass: TupleTest

  testCreation =>
    // Tuple new returns an empty tuple
    self assert: (Tuple new) class equals: Tuple
    // Tuple new: accepts a List (convenience alias for withAll:)
    self assert: (Tuple new: #(1, 2)) size equals: 2

  testDisplay =>
    // Tuple printString shows tuple format
    self assert: (Tuple new) printString size equals: 2

  testSize =>
    // Empty tuple has size 0
    self assert: (Tuple new) size equals: 0

  testUnwrapOkTuple =>
    // {ok, 42} unwrap returns 42
    okTuple := Tuple withAll: #(#ok, 42)
    self assert: okTuple unwrap equals: 42
    // {ok, "hello"} unwrap returns the value
    okStr := Tuple withAll: #(#ok, "hello")
    self assert: okStr unwrap equals: "hello"

  testUnwrapErrorTupleRaises =>
    // {error, 'oops'} unwrap raises user_error with reason in message
    errTuple := Tuple withAll: #(#error, #oops)
    self should: [errTuple unwrap] raise: #user_error

  testUnwrapOtherTupleRaises =>
    // {other, 'x'} unwrap raises user_error with "unwrap requires..." message
    otherTuple := Erlang erlang list_to_tuple: #(#other, #x)
    self should: [otherTuple unwrap] raise: #user_error

  testUnwrapOrOkReturnsValue =>
    // {ok, 99} unwrapOr: 0 returns 99
    okTuple := Tuple withAll: #(#ok, 99)
    self assert: (okTuple unwrapOr: 0) equals: 99

  testUnwrapOrErrorReturnsDefault =>
    // {error, 'fail'} unwrapOr: 0 returns 0
    errTuple := Tuple withAll: #(#error, #fail)
    self assert: (errTuple unwrapOr: 0) equals: 0
    // {other, 'x'} unwrapOr: 99 returns 99
    otherTuple := Erlang erlang list_to_tuple: #(#other, #x)
    self assert: (otherTuple unwrapOr: 99) equals: 99

  testUnwrapOrElseOkReturnsValue =>
    // {ok, 7} unwrapOrElse: [0] returns 7
    okTuple := Tuple withAll: #(#ok, 7)
    self assert: (okTuple unwrapOrElse: [0]) equals: 7

  testUnwrapOrElseErrorEvaluatesBlock =>
    // {error, _} unwrapOrElse: [...] evaluates block
    errTuple := Tuple withAll: #(#error, #fail)
    self assert: (errTuple unwrapOrElse: [42]) equals: 42
    // {other, _} unwrapOrElse: [...] evaluates block
    otherTuple := Erlang erlang list_to_tuple: #(#other, #x)
    self assert: (otherTuple unwrapOrElse: [99]) equals: 99

  // === BT-3969 / ADR 0136: tuple literal expressions ===
  testTupleLiteralConstruction =>
    t := {#active, false}
    self assert: t class equals: Tuple
    self assert: t size equals: 2
    self assert: (t at: 1) equals: #active
    self assert: (t at: 2) equals: false

  testTupleLiteralEqualsWithAll =>
    self assert: ({#ok, 1} =:= (Tuple withAll: #(#ok, 1))) equals: true
    self assert: ({1, "two", 3} =:= (Tuple withAll: #(1, "two", 3))) equals: true

  testTupleLiteralEmptyAndSingle =>
    self assert: {} size equals: 0
    self assert: ({} =:= Tuple new) equals: true
    self assert: {#ok} size equals: 1
    self assert: ({#ok} at: 1) equals: #ok

  testTupleLiteralNested =>
    t := {#outer, {#inner, 1}}
    self assert: ((t at: 2) at: 2) equals: 1
    self assert: (t at: 2) class equals: Tuple

  testTupleLiteralKeywordElement =>
    d := #{#backlog => 1024}
    pair := {#backlog, d at: #backlog}
    self assert: pair size equals: 2
    self assert: (pair at: 2) equals: 1024

  testTupleLiteralStatementStart =>
    a := 1
    b := 2
    {a, b} size
    self assert: {a, b} size equals: 2

  testTupleLiteralSwap =>
    a := 1
    b := 2
    {a, b} := {b, a}
    self assert: a equals: 2
    self assert: b equals: 1

  testTupleLiteralDestructure =>
    {k, v} := {#key, 42}
    self assert: k equals: #key
    self assert: v equals: 42

  testTupleLiteralMatch =>
    result := {#ok, 7} match: [
      {#ok, v} -> v * 2;
      _ -> 0
    ]
    self assert: result equals: 14

  testTupleLiteralInMatchArmBody =>
    result := 3 match: [n -> {#got, n}]
    self assert: result equals: (Tuple withAll: #(#got, 3))

  testTupleLiteralInList =>
    opts := #({#active, false}, {#reuseaddr, true}, {#backlog, 1024})
    self assert: opts size equals: 3
    self assert: ((opts at: 1) at: 1) equals: #active

  testTupleLiteralAsMapKey =>
    m := #{{1, 2} => #pair}
    self assert: (m at: {1, 2}) equals: #pair

  testTupleLiteralFfiRoundTrip =>
    self assert: (Erlang erlang tuple_to_list: {1, 2}) equals: #(1, 2)

  testTupleLiteralIsNotResult =>
    // {#ok, x} is a plain Tuple, not a Result
    self assert: {#ok, 1} class equals: Tuple

  testTupleLiteralBlockElement =>
    n := 10
    t := {#cb, [:x | x + n]}
    self assert: ((t at: 2) value: 5) equals: 15

  testTupleLiteralInterpolation =>
    a := 1
    b := 2
    self assert: "got { {a, b} }" equals: "got " ++ {a, b} printString
