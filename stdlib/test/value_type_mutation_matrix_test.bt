// BT-2346: Backfill the mutation coverage matrix across
//   {construct × context × position × write-mode}.
//
// This is the *absolute* oracle that complements the metamorphic (relative)
// oracle in BT-2345: every cell here asserts a hand-written ground-truth final
// threaded value, so it catches a construct broken *uniformly across all
// contexts* — the case the cross-context-equality relations of BT-2345 cannot
// see. The two oracles are only jointly complete because they share one
// fragment corpus:
//
//   stdlib/test/fixtures/mutation_corpus_value.bt          (Value subclass context)
//   stdlib/test/fixtures/mutation_corpus_actor.bt          (Actor context)
//   stdlib/test/fixtures/mutation_corpus_class_method.bt   (class-method context, BT-2360)
//
// plus the TestCase-context fragments defined as `frag*` helpers in this file.
// BT-2345, when it lands, consumes the same fragment names for its equality
// relations rather than maintaining a parallel list.
//
// The existing mutation_matrix_test.bt (BT-1480) exercises Actor *state-field*
// threading densely; this file fills the previously thin axis — outer-LOCAL
// threading in the Value subclass, Actor, and TestCase contexts — to the same
// density, so the asymmetry that let BT-2342 hide cannot recur.
//
// BT-2342 (value-type foldl list-ops / conditionals / local-assignment) has
// landed, so those value-type cells now run their ground-truth asserts. The
// remaining `skip`ped cells track still-open gaps: BT-2355 (Actor-context
// outer-local threading) and BT-2359 (value-type count:/detect: predicates and
// parenthesized assignment-RHS threading). Loop regression cells come from BT-2308.
//
// BT-2360 adds the class-method context (`*ClassMethod` cells, fragments in
// mutation_corpus_class_method.bt). Class-method block threading was hardened by
// BT-2349/BT-2350/BT-2358 (all landed), so these cells run their ground-truth
// asserts un-gated.

TestCase subclass: ValueTypeMutationMatrixTest
  // BT-3483: backing field for the TestCase-context axis-4 fragments below
  // (`fragStateFieldToDoNonLastReadWrite` / `fragStateFieldIfTrueNonLastReadWrite:`).
  // A fresh test instance per test method means this never bleeds across
  // assertions, same as `MutationCorpusValue`'s own `total` field.
  field: total = 0

  // Each fixture exposes the SAME fragment method names; these helpers build a
  // fresh instance per cell so state cannot bleed between assertions.
  valueCorpus => MutationCorpusValue new

  actorCorpus => MutationCorpusActor spawn

  // Pending switch for BT-2342 value-type gaps. BT-2342 has landed, so the
  // affected value-type cells now run their ground-truth asserts. Kept as a
  // switch for documentation/bisection.
  bt2342Pending => false

  // Pending switch for BT-2355 Actor-context outer-local threading gaps. BT-2355
  // has landed, so the affected Actor cells now run their ground-truth asserts.
  // Kept as a switch for documentation/bisection.
  bt2355Pending => false

  // Pending switch for BT-2359 value-type outer-local threading gaps that
  // BT-2342 did NOT cover: count:/detect: foldl predicates, and a threading
  // construct (loop/conditional) used as a parenthesized assignment RHS that
  // threads a *sibling* outer local. BT-2359 has landed, so the affected
  // value-type cells now run their ground-truth asserts. Kept as a switch for
  // documentation/bisection.
  bt2359Pending => false

  // Pending switch for BT-2371: in class-method context, a conditional
  // (ifTrue:ifFalse:) used as a *parenthesized assignment RHS* still drops the
  // sibling outer-local mutation (returns 0 instead of 5). BT-2359 fixed this in
  // value_type_codegen.rs, but class methods route through a separate
  // class-method block-threading path (BT-2349/BT-2350/BT-2358) that covered the
  // loop paren-assign-RHS shape and count:/detect: predicates but NOT the
  // conditional paren-assign-RHS shape. Fixed by BT-2371 (class-method-context
  // analogue of BT-2359, applied in gen_server/methods.rs).
  bt2360ClassMethodCondAssignRhsPending => false

  // Pending switch for BT-3178: fixed — conditionals.rs's branch-arm
  // lowering now Binds a DispatchingSelfSend's returned NewState as a real
  // Bind (mirroring the SelfFieldAtPut/ControlFlowWithMutations tuple-unpack
  // pattern) instead of discarding it in the C12 catch-all. Kept as a
  // switch for documentation/bisection.
  bt3178ActorSelfSendInConditionalPending => false

  // Pending switch for BT-3484: a genuine `Value subclass:` can never write
  // `self.field :=` — it's a hard, unconditional compile error (ADR 0042;
  // `check_value_slot_assignment` fires for every value-type instance method
  // regardless of position), so `mutation_corpus_value.bt` cannot carry a
  // `stateFieldToDoNonLastReadWrite`/`stateFieldIfTrueNonLastReadWrite:`
  // analogue the way `mutation_corpus_actor.bt` does. The ONLY route by which
  // `self.field := value` compiles under `CodeGenContext::ValueType` today is
  // the BT-1533 TestCase exemption (TestCase is itself a Value subclass, but
  // exempted from the immutability check) — hence the axis-4 `frag*` methods
  // below, living directly on this TestCase, rather than in the fixture file.
  // Exercising that path end-to-end (BT-3483's whole point) found BT-3484:
  // the loop shape silently dropped the field mutation (compiled, but
  // returned the ORIGINAL unmodified `self`), and the conditional shape
  // (`ifTrue:`) failed to compile at all (`unbound variable 'SelfN'` from
  // erlc). BT-3484 has landed — a value-type `Self` mutation now threads
  // through a loop's own recursive tail call (an extra trailing `letrec` fun
  // parameter + result-tuple slot, mirroring BT-3168's `ClassVars`
  // threading) and through a conditional's branch-merge tuple (mirroring
  // BT-3159's `ClassVars` slot) — so both cells run their ground-truth
  // asserts. Kept as a switch for documentation/bisection.
  //
  // BT-3486 closed the same gap in the third construct family
  // (`on:do:`/`ensure:`), where it was SILENT rather than a compile error:
  // the construct's `{Result, StateAcc}` result tuple now grows a trailing
  // `Self` slot whenever either inlined block writes a field, and the
  // method-body sequencer rebinds the method's live `Self` from it. Its
  // cells (`testStateFieldEnsure*` / `testStateFieldOnDo*` below) never
  // needed a pending switch — they are added already passing.
  //
  // BT-3488 closed the remaining gap that BT-3484's threading did NOT cover,
  // and closed it by REJECTION rather than by support: a `self.field :=` write
  // that is not a bare top-level statement of the loop body — nested inside an
  // `ifTrue:`/`ensure:` branch, or anywhere in a `Foldl*` (`do:`/`collect:`)
  // body — is now a clean compile error carrying the same "Cannot assign to
  // field ... inside this block" text the identical class-var shape already
  // produced, instead of an erlc `unbound variable 'State'` crash or a
  // silently dropped mutation. That is why no axis-4 fragment below nests its
  // write inside a conditional: such a fragment would no longer compile, so
  // the shape is pinned at the Rust level instead (see
  // `crates/beamtalk-codegen/src/core_erlang/tests/control_flow.rs`,
  // `test_value_type_field_write_in_conditional_nested_in_loop_is_compile_error`
  // and its neighbours) where a compile error can actually be asserted.
  bt3484ValueTypeFieldWriteThreadingPending => false

  // ── TestCase-context fragments (the test class is itself a value-type) ──────
  // `frag` prefix keeps BUnit from treating them as test methods.
  fragToDoNonLastWriteOnly =>
    last := 0
    1 to: 5 do: [:i | last := i]
    last

  fragToDoNonLastReadWrite =>
    sum := 0
    1 to: 5 do: [:i | sum := sum + i]
    sum

  fragToByDoNonLastReadWrite =>
    sum := 0
    1
      to: 10
      by: 2
      do: [:i | sum := sum + i]
    sum

  fragTimesRepeatNonLastReadWrite =>
    count := 0
    5 timesRepeat: [count := count + 1]
    count

  fragWhileTrueNonLastReadWrite =>
    n := 0
    [n < 5] whileTrue: [n := n + 1]
    n

  fragWhileFalseNonLastReadWrite =>
    n := 0
    [n >= 5] whileFalse: [n := n + 1]
    n

  fragRangeDoNonLastReadWrite =>
    sum := 0
    (1 to: 5) do: [:i | sum := sum + i]
    sum

  fragIfTrueNonLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]
    sum

  fragIfTrueIfFalseNonLastReadWrite: flag =>
    x := 1
    flag ifTrue: [x := x + 1] ifFalse: [x := x + 100]
    x

  // BT-3176 axis 1 / axis 3 shared fragments (outer-local only, so they run
  // identically in every context — see mutation_corpus_value.bt for both).
  fragNestedToDoNonLastReadWrite =>
    sum := 0
    1 to: 3 do: [:i | 1 to: 3 do: [:j | sum := sum + j]]
    sum

  // BT-3176 axis 4 (BT-3483/BT-3484): the TestCase-context analogues of
  // mutation_corpus_actor.bt's stateFieldToDoNonLastReadWrite /
  // stateFieldIfTrueNonLastReadWrite: — mutating this TestCase's own `total`
  // field (via the BT-1533 value-type exemption) instead of an outer local.
  // Both are byte-for-byte the same fragment bodies as the Actor originals,
  // so the absolute oracle compares like with like across contexts.
  //
  // Before BT-3484 only the loop fragment could live here at all: the
  // conditional shape didn't merely compute a wrong value, it failed erlc
  // outright with `unbound variable 'SelfN'`, which would have broken
  // compilation of this whole file. BT-3484 fixed both, so the conditional
  // fragment now lives here alongside the loop one.
  fragStateFieldToDoNonLastReadWrite =>
    seen := 0
    1
      to: 5
      do: [:i |
        self.total := self.total + i
        seen := seen + 1
      ]
    self.total

  fragStateFieldIfTrueNonLastReadWrite: flag =>
    seen := 0
    flag
      ifTrue: [
        self.total := self.total + 7
        seen := seen + 1
      ]
    self.total

  // BT-3484 close-out: bringing axis 4 up to the same construct density as
  // axes 1-3, rather than stopping at the two shapes BT-3484's own repro
  // named. BT-3484 fixed the mechanism generically for every LETREC-shaped
  // loop (to:do:/to:by:do:/timesRepeat:/whileTrue:/whileFalse:) and both
  // conditional forms — confirmed by hand for each of the four below
  // (Core-Erlang-inspected: each threads a trailing `Self` letrec parameter
  // or branch-merge slot exactly like fragStateFieldToDoNonLastReadWrite /
  // fragStateFieldIfTrueNonLastReadWrite: above), so these are un-gated from
  // the start rather than landing behind a pending switch.
  //
  // FOLDL-shaped list-ops (do:/collect:/select:/reject:/inject:into:/
  // detect:ifNone:/count:, and a Range's own do:) are a DIFFERENT construct
  // family BT-3484 explicitly left out of scope (their accumulator has no
  // matching Self slot — pre-existing BT-3169 tech debt shared with
  // ClassVars) and are NOT represented here at all: `self.total :=` inside
  // one of their blocks fails erlc outright (`unbound variable 'State'`),
  // which would break compilation of this whole file if checked in as a
  // fixture — tracked in BT-3487 instead, same reasoning that kept the
  // ifTrue: conditional fragment out until BT-3484 fixed it for real.
  fragStateFieldToByDoNonLastReadWrite =>
    seen := 0
    1
      to: 10
      by: 2
      do: [:i |
        self.total := self.total + i
        seen := seen + 1
      ]
    self.total

  fragStateFieldTimesRepeatNonLastReadWrite =>
    seen := 0
    5
      timesRepeat: [
        self.total := self.total + 1
        seen := seen + 1
      ]
    self.total

  fragStateFieldWhileTrueNonLastReadWrite =>
    n := 0
    [n < 5]
      whileTrue: [
        self.total := self.total + 1
        n := n + 1
      ]
    self.total

  fragStateFieldWhileFalseNonLastReadWrite =>
    n := 0
    [n >= 5]
      whileFalse: [
        self.total := self.total + 1
        n := n + 1
      ]
    self.total

  fragStateFieldIfTrueIfFalseNonLastReadWrite: flag =>
    x := 1
    flag
      ifTrue: [
        self.total := self.total + 1
        x := x + 1
      ]
      ifFalse: [self.total := self.total + 100]
    self.total

  // BT-3486 axis-4, third construct family: `on:do:`/`ensure:`. Byte-for-byte
  // the same bodies as mutation_corpus_actor.bt's `stateFieldEnsure*` /
  // `stateFieldOnDo*` fragments, so the absolute oracle compares like with
  // like across contexts. Before BT-3486 every one of these COMPILED CLEANLY
  // and returned the field's original value (0) — the silent-data-loss half
  // of the ADR 0120 gap list, and the reason these could not simply be added
  // alongside BT-3484's loop/conditional cells.
  fragStateFieldEnsureTryNonLastReadWrite =>
    seen := 0
    [
      self.total := self.total + 1
      seen := seen + 1
    ] ensure: [nil]
    self.total

  fragStateFieldEnsureCleanupNonLastReadWrite =>
    seen := 0
    [
      seen := seen + 1
      nil
    ]
      ensure: [
        self.total := self.total + 7
        nil
      ]
    self.total

  fragStateFieldEnsureBothNonLastReadWrite =>
    seen := 0
    [
      self.total := self.total + 1
      seen := seen + 1
    ]
      ensure: [
        self.total := self.total + 10
        nil
      ]
    self.total

  fragStateFieldOnDoTryNonLastReadWrite =>
    seen := 0
    [
      self.total := self.total + 3
      seen := seen + 1
    ] on: Error do: [:e | nil]
    self.total

  fragStateFieldOnDoHandlerNonLastReadWrite =>
    seen := 0
    [
      self.total := self.total + 1
      seen := seen + 1
      Error signal: "boom"
    ]
      on: Error
      do: [:e |
        self.total := self.total + 5
        nil
      ]
    self.total

  // BT-3486's own repro, verbatim: the field write is the construct's ONLY
  // mutation, so the BT-3177 outer-local predicate says "nothing to thread"
  // and — before this fix — the whole construct was sequenced away as a bare
  // `let _seqN = … in`, discarding the mutation. TestCase-only: the Actor
  // corpus's fragments all carry a co-occurring outer-local read+write (see
  // its `selfSendIfTrueNonLastReadWrite` comment on why), so there is no
  // like-for-like Actor cell for this one shape.
  fragStateFieldEnsureWriteOnlyNonLast =>
    [
      self.total := self.total + 1
      nil
    ] ensure: [nil]
    self.total

  // Two such constructs back to back: the second must chain from the first's
  // threaded `Self`, not from the method's original one.
  fragStateFieldEnsureChainedNonLast =>
    [
      self.total := self.total + 1
      nil
    ] ensure: [nil]
    [
      self.total := self.total + 2
      nil
    ] ensure: [nil]
    self.total

  // BT-3492: the `on:do:`/`ensure:` construct itself is the method's LAST
  // statement — the shape `classify_vt_body_expr`'s `ExceptionConstructWithThreading`
  // arm never reached (`emit_threaded_last`/`lower_threaded_last` had no
  // `on:do:`/`ensure:` case), so the construct's raw `{Result, StateAcc, Self}`
  // tuple leaked as the METHOD's own return value instead of the unwrapped
  // logical result. Reading `self.total` as the try body's OWN last statement
  // (rather than as a trailing statement after the construct, like the
  // NonLast cells above) makes the mutated field observable through the
  // method's return value despite Self not persisting across calls.
  fragStateFieldEnsureLastPosition =>
    [
      self.total := self.total + 1
      self.total
    ] ensure: [nil]

  // BT-3492: the construct as an assignment RHS — before this fix `r` was
  // bound to the raw `{Result, StateAcc, Self}` tuple and the method's live
  // `Self` was never rebound from it, so the trailing `self.total` read the
  // PRE-try snapshot (0) instead of the mutated value.
  fragStateFieldEnsureAssignRhs =>
    _r := [
      self.total := self.total + 1
      nil
    ] ensure: [nil]
    self.total

  // BT-3492: nested inside another construct's inlined body —
  // `block_writes_vt_self_field` is deliberately top-level-body-only (the
  // same reason `loop_body_threads_value_self` is), so a field write buried
  // inside an INNER `ensure:`'s block is invisible to the OUTER `ensure:`'s
  // own threading decision and was silently dropped before this fix. Unlike
  // the two shapes above, this is now a clean compile-time rejection (the
  // same `FieldAssignmentInUnsupportedBlock` diagnostic BT-3488 gives the
  // identical loop-nesting shape) rather than something made to work — so,
  // like BT-3487/BT-3488's Foldl*/nested-conditional shapes, there is no live
  // fixture for it here: a fragment that compile-errors would break
  // compilation of this whole file. Pinned at the Rust level instead — see
  // `crates/beamtalk-codegen/src/core_erlang/tests/control_flow.rs`,
  // `test_value_type_field_write_in_ensure_nested_in_ensure_is_compile_error`.
  // The sibling shape — an `ensure:` nested inside a `whileTrue:` LOOP body —
  // was already rejected before this issue, by the existing loop-nesting walk
  // (`reject_unthreadable_value_self_field_write`, which descends into every
  // nested block including an inlined `ensure:`'s); this issue only closes
  // the exception-in-exception gap that walk does not reach.

  // ════════════════════════════════════════════════════════════════════════
  //  to:do:  (construct) — BT-2308 regression cells
  // ════════════════════════════════════════════════════════════════════════

  // to:do: × non-last × write-only
  testToDoNonLastWriteOnlyValue =>
    self assert: self valueCorpus toDoNonLastWriteOnly equals: 5

  testToDoNonLastWriteOnlyActor =>
    self assert: self actorCorpus toDoNonLastWriteOnly equals: 5

  testToDoNonLastWriteOnlyTestCase =>
    self assert: self fragToDoNonLastWriteOnly equals: 5

  testToDoNonLastWriteOnlyClassMethod =>
    self assert: MutationCorpusClassMethod toDoNonLastWriteOnly equals: 5

  // to:do: × non-last × read+write
  testToDoNonLastReadWriteValue =>
    self assert: self valueCorpus toDoNonLastReadWrite equals: 15

  testToDoNonLastReadWriteActor =>
    self assert: self actorCorpus toDoNonLastReadWrite equals: 15

  testToDoNonLastReadWriteTestCase =>
    self assert: self fragToDoNonLastReadWrite equals: 15

  testToDoNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod toDoNonLastReadWrite equals: 15

  // to:do: × local-assignment RHS × read+write
  testToDoAssignRhsReadWriteValue =>
    self bt2359Pending
      ifTrue: [
        ^self skip: "BT-2359: loop as a parenthesized assignment RHS drops sibling-local threading in value-type context"
      ]
    self assert: self valueCorpus toDoAssignRhsReadWrite equals: 15

  testToDoAssignRhsReadWriteActor =>
    self bt2355Pending
      ifTrue: [
        ^self skip: "BT-2355: loop local-assignment drops threading in Actor method body"
      ]
    self assert: self actorCorpus toDoAssignRhsReadWrite equals: 15

  testToDoAssignRhsReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod toDoAssignRhsReadWrite equals: 15

  // ════════════════════════════════════════════════════════════════════════
  //  to:by:do:  — BT-2308 regression cells
  // ════════════════════════════════════════════════════════════════════════
  testToByDoNonLastWriteOnlyValue =>
    self assert: self valueCorpus toByDoNonLastWriteOnly equals: 9

  testToByDoNonLastWriteOnlyActor =>
    self assert: self actorCorpus toByDoNonLastWriteOnly equals: 9

  testToByDoNonLastWriteOnlyClassMethod =>
    self assert: MutationCorpusClassMethod toByDoNonLastWriteOnly equals: 9

  testToByDoNonLastReadWriteValue =>
    self assert: self valueCorpus toByDoNonLastReadWrite equals: 25

  testToByDoNonLastReadWriteActor =>
    self assert: self actorCorpus toByDoNonLastReadWrite equals: 25

  testToByDoNonLastReadWriteTestCase =>
    self assert: self fragToByDoNonLastReadWrite equals: 25

  testToByDoNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod toByDoNonLastReadWrite equals: 25

  // ════════════════════════════════════════════════════════════════════════
  //  timesRepeat:  — BT-2308 regression cells
  // ════════════════════════════════════════════════════════════════════════
  testTimesRepeatNonLastWriteOnlyValue =>
    self assert: self valueCorpus timesRepeatNonLastWriteOnly equals: 7

  testTimesRepeatNonLastWriteOnlyActor =>
    self assert: self actorCorpus timesRepeatNonLastWriteOnly equals: 7

  testTimesRepeatNonLastWriteOnlyClassMethod =>
    self assert: MutationCorpusClassMethod timesRepeatNonLastWriteOnly equals: 7

  testTimesRepeatNonLastReadWriteValue =>
    self assert: self valueCorpus timesRepeatNonLastReadWrite equals: 5

  testTimesRepeatNonLastReadWriteActor =>
    self assert: self actorCorpus timesRepeatNonLastReadWrite equals: 5

  testTimesRepeatNonLastReadWriteTestCase =>
    self assert: self fragTimesRepeatNonLastReadWrite equals: 5

  testTimesRepeatNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod timesRepeatNonLastReadWrite equals: 5

  // ════════════════════════════════════════════════════════════════════════
  //  whileTrue: / whileFalse:
  // ════════════════════════════════════════════════════════════════════════
  testWhileTrueNonLastReadWriteValue =>
    self assert: self valueCorpus whileTrueNonLastReadWrite equals: 5

  testWhileTrueNonLastReadWriteActor =>
    self assert: self actorCorpus whileTrueNonLastReadWrite equals: 5

  testWhileTrueNonLastReadWriteTestCase =>
    self assert: self fragWhileTrueNonLastReadWrite equals: 5

  testWhileTrueNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod whileTrueNonLastReadWrite equals: 5

  testWhileFalseNonLastReadWriteValue =>
    self assert: self valueCorpus whileFalseNonLastReadWrite equals: 5

  testWhileFalseNonLastReadWriteActor =>
    self assert: self actorCorpus whileFalseNonLastReadWrite equals: 5

  testWhileFalseNonLastReadWriteTestCase =>
    self assert: self fragWhileFalseNonLastReadWrite equals: 5

  testWhileFalseNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod whileFalseNonLastReadWrite equals: 5

  // ════════════════════════════════════════════════════════════════════════
  //  (1 to: n) do:
  // ════════════════════════════════════════════════════════════════════════
  testRangeDoNonLastReadWriteValue =>
    self assert: self valueCorpus rangeDoNonLastReadWrite equals: 15

  testRangeDoNonLastReadWriteActor =>
    self assert: self actorCorpus rangeDoNonLastReadWrite equals: 15

  testRangeDoNonLastReadWriteTestCase =>
    self assert: self fragRangeDoNonLastReadWrite equals: 15

  testRangeDoNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod rangeDoNonLastReadWrite equals: 15

  // ════════════════════════════════════════════════════════════════════════
  //  collect:  — BT-2342 (failure mode A): value-type leaks value+state tuple
  // ════════════════════════════════════════════════════════════════════════
  testCollectNonLastReadWriteValue =>
    self bt2342Pending ifTrue: [
      ^self skip: "BT-2342: collect: leaks value+state tuple in value-type context"
    ]
    self assert: self valueCorpus collectNonLastReadWrite equals: 3

  testCollectNonLastReadWriteActor =>
    self assert: self actorCorpus collectNonLastReadWrite equals: 3

  testCollectNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod collectNonLastReadWrite equals: 3

  testCollectAssignRhsReadWriteValue =>
    self bt2342Pending
      ifTrue: [
        ^self skip: "BT-2342: collect: local-assignment leaks tuple in value-type context"
      ]
    self assert: self valueCorpus collectAssignRhsReadWrite equals: 3

  testCollectAssignRhsReadWriteActor =>
    self assert: self actorCorpus collectAssignRhsReadWrite equals: 3

  testCollectAssignRhsReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod collectAssignRhsReadWrite equals: 3

  // ════════════════════════════════════════════════════════════════════════
  //  select: / reject:  — BT-2342 (failure mode A)
  // ════════════════════════════════════════════════════════════════════════
  testSelectNonLastReadWriteValue =>
    self bt2342Pending ifTrue: [
      ^self skip: "BT-2342: select: leaks value+state tuple in value-type context"
    ]
    self assert: self valueCorpus selectNonLastReadWrite equals: 4

  testSelectNonLastReadWriteActor =>
    self assert: self actorCorpus selectNonLastReadWrite equals: 4

  testSelectNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod selectNonLastReadWrite equals: 4

  testRejectNonLastReadWriteValue =>
    self bt2342Pending ifTrue: [
      ^self skip: "BT-2342: reject: leaks value+state tuple in value-type context"
    ]
    self assert: self valueCorpus rejectNonLastReadWrite equals: 4

  testRejectNonLastReadWriteActor =>
    self assert: self actorCorpus rejectNonLastReadWrite equals: 4

  testRejectNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod rejectNonLastReadWrite equals: 4

  // ════════════════════════════════════════════════════════════════════════
  //  inject:into:  — BT-2342 (failure mode A)
  // ════════════════════════════════════════════════════════════════════════
  testInjectNonLastReadWriteValue =>
    self bt2342Pending
      ifTrue: [
        ^self skip: "BT-2342: inject:into: leaks value+state tuple in value-type context"
      ]
    self assert: self valueCorpus injectNonLastReadWrite equals: 6

  testInjectNonLastReadWriteActor =>
    self assert: self actorCorpus injectNonLastReadWrite equals: 6

  testInjectNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod injectNonLastReadWrite equals: 6

  testInjectAssignRhsReadWriteValue =>
    self bt2342Pending
      ifTrue: [
        ^self skip: "BT-2342: inject:into: local-assignment leaks tuple in value-type context"
      ]
    self assert: self valueCorpus injectAssignRhsReadWrite equals: 6

  testInjectAssignRhsReadWriteActor =>
    self assert: self actorCorpus injectAssignRhsReadWrite equals: 6

  testInjectAssignRhsReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod injectAssignRhsReadWrite equals: 6

  // BT-2378: the assignment target is itself mutated inside the inject:into: RHS.
  // The target must bind to the construct's logical result (the fold, 100+1+2+3 = 106),
  // not the threaded accumulator (__local__total = 6). The Actor assign-RHS path
  // rebound the target from threaded state before the fix (returning 6 here).
  testInjectAssignRhsTargetMutatedValue =>
    self assert: self valueCorpus injectAssignRhsTargetMutated equals: 106

  testInjectAssignRhsTargetMutatedActor =>
    self assert: self actorCorpus injectAssignRhsTargetMutated equals: 106

  testInjectAssignRhsTargetMutatedClassMethod =>
    self assert: MutationCorpusClassMethod injectAssignRhsTargetMutated equals: 106

  // ════════════════════════════════════════════════════════════════════════
  //  detect: / count:  — BT-2342 (failure mode A, foldl predicate)
  // ════════════════════════════════════════════════════════════════════════
  testDetectNonLastReadWriteValue =>
    self bt2359Pending
      ifTrue: [
        ^self skip: "BT-2359: detect: predicate does not thread outer local in value-type context"
      ]
    self assert: self valueCorpus detectNonLastReadWrite equals: 3

  testDetectNonLastReadWriteActor =>
    self bt2355Pending ifTrue: [
      ^self skip: "BT-2355: detect: does not thread outer local in Actor context"
    ]
    self assert: self actorCorpus detectNonLastReadWrite equals: 3

  testDetectNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod detectNonLastReadWrite equals: 3

  testCountNonLastReadWriteValue =>
    self bt2359Pending
      ifTrue: [
        ^self skip: "BT-2359: count: predicate does not thread outer local in value-type context"
      ]
    self assert: self valueCorpus countNonLastReadWrite equals: 3

  testCountNonLastReadWriteActor =>
    self bt2355Pending ifTrue: [
      ^self skip: "BT-2355: count: does not thread outer local in Actor context"
    ]
    self assert: self actorCorpus countNonLastReadWrite equals: 3

  testCountNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod countNonLastReadWrite equals: 3

  // ════════════════════════════════════════════════════════════════════════
  //  ifTrue:  (conditionals)
  // ════════════════════════════════════════════════════════════════════════

  // write-only conditional threads in non-last position
  testIfTrueNonLastWriteOnlyValue =>
    self assert: (self valueCorpus ifTrueNonLastWriteOnly: true) equals: 9

  testIfTrueNonLastWriteOnlyActor =>
    self bt2355Pending
      ifTrue: [
        ^self skip: "BT-2355: write-only conditional does not thread outer local in Actor context"
      ]
    self assert: (self actorCorpus ifTrueNonLastWriteOnly: true) equals: 9

  testIfTrueNonLastWriteOnlyClassMethod =>
    self assert: (MutationCorpusClassMethod ifTrueNonLastWriteOnly: true) equals: 9

  // read+write conditional, non-last
  testIfTrueNonLastReadWriteValue =>
    self assert: (self valueCorpus ifTrueNonLastReadWrite: true) equals: 7

  testIfTrueNonLastReadWriteActor =>
    self bt2355Pending
      ifTrue: [
        ^self skip: "BT-2355: read+write conditional only threads on first Actor invocation"
      ]
    self assert: (self actorCorpus ifTrueNonLastReadWrite: true) equals: 7

  testIfTrueNonLastReadWriteTestCase =>
    self assert: (self fragIfTrueNonLastReadWrite: true) equals: 7

  testIfTrueNonLastReadWriteClassMethod =>
    self assert: (MutationCorpusClassMethod ifTrueNonLastReadWrite: true) equals: 7

  // BT-2342 (failure mode B): read+write conditional as last expression
  testIfTrueLastReadWriteValue =>
    self bt2342Pending
      ifTrue: [
        ^self skip: "BT-2342: read+write ifTrue: as last expr crashes (arity-0 dispatch)"
      ]
    self assert: (self valueCorpus ifTrueLastReadWrite: true) equals: 7

  testIfTrueLastReadWriteActor =>
    self assert: (self actorCorpus ifTrueLastReadWrite: true) equals: 7

  testIfTrueLastReadWriteClassMethod =>
    self assert: (MutationCorpusClassMethod ifTrueLastReadWrite: true) equals: 7

  // ════════════════════════════════════════════════════════════════════════
  //  ifTrue:ifFalse:
  // ════════════════════════════════════════════════════════════════════════
  testIfTrueIfFalseNonLastReadWriteValue =>
    self assert: (self valueCorpus ifTrueIfFalseNonLastReadWrite: true) equals: 2

  testIfTrueIfFalseNonLastReadWriteActor =>
    self bt2355Pending
      ifTrue: [
        ^self skip: "BT-2355: ifTrue:ifFalse: does not thread outer local in Actor context"
      ]
    self assert: (self actorCorpus ifTrueIfFalseNonLastReadWrite: true) equals: 2

  testIfTrueIfFalseNonLastReadWriteTestCase =>
    self assert: (self fragIfTrueIfFalseNonLastReadWrite: true) equals: 2

  testIfTrueIfFalseNonLastReadWriteClassMethod =>
    self assert: (MutationCorpusClassMethod ifTrueIfFalseNonLastReadWrite: true) equals: 2

  testIfTrueIfFalseAssignRhsReadWriteValue =>
    self bt2359Pending
      ifTrue: [
        ^self skip: "BT-2359: conditional as a parenthesized assignment RHS drops sibling-local threading in value-type context"
      ]
    self assert: (self valueCorpus ifTrueIfFalseAssignRhsReadWrite: true) equals: 5

  testIfTrueIfFalseAssignRhsReadWriteActor =>
    self bt2355Pending
      ifTrue: [
        ^self skip: "BT-2355: conditional local-assignment drops threading in Actor method body"
      ]
    self assert: (self actorCorpus ifTrueIfFalseAssignRhsReadWrite: true) equals: 5

  testIfTrueIfFalseAssignRhsReadWriteClassMethod =>
    self bt2360ClassMethodCondAssignRhsPending
      ifTrue: [
        ^self skip: "BT-2371: conditional as a parenthesized assignment RHS drops sibling-local threading in class-method context"
      ]
    self assert: (MutationCorpusClassMethod ifTrueIfFalseAssignRhsReadWrite: true) equals: 5

  // ════════════════════════════════════════════════════════════════════════
  //  BT-3176 axis 1 — nested loop-in-loop, outer local
  // ════════════════════════════════════════════════════════════════════════
  testNestedToDoNonLastReadWriteValue =>
    self assert: self valueCorpus nestedToDoNonLastReadWrite equals: 18

  testNestedToDoNonLastReadWriteActor =>
    self assert: self actorCorpus nestedToDoNonLastReadWrite equals: 18

  testNestedToDoNonLastReadWriteTestCase =>
    self assert: self fragNestedToDoNonLastReadWrite equals: 18

  testNestedToDoNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod nestedToDoNonLastReadWrite equals: 18

  // ════════════════════════════════════════════════════════════════════════
  //  BT-3176 axis 1b — nested loop, class var / state field mutated only in
  //  the OUTER loop's top-level body (the compiling counterpart of BT-3172's
  //  rejected inner-mutates shape — see
  //  crates/beamtalk-core/src/codegen/core_erlang/tests/gen_server.rs for the
  //  ClassVarMutationLostAcrossNestedLoop compile-error regression tests).
  // ════════════════════════════════════════════════════════════════════════
  testNestedWhileTrueOuterOnlyStateReadWriteActor =>
    self assert: self actorCorpus nestedWhileTrueOuterOnlyStateReadWrite equals: 3

  testNestedWhileTrueOuterOnlyClassVarReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod nestedWhileTrueOuterOnlyClassVarReadWrite equals: 3

  // ════════════════════════════════════════════════════════════════════════
  //  BT-3176 axis 2 — self-send as the mutation mechanism (not a direct
  //  `self.field :=`), inside a loop or conditional body. See BT-3150/BT-3159.
  // ════════════════════════════════════════════════════════════════════════
  testSelfSendWhileTrueNonLastReadWriteActor =>
    self assert: self actorCorpus selfSendWhileTrueNonLastReadWrite equals: 5

  testSelfSendWhileTrueNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod selfSendWhileTrueNonLastReadWrite equals: 5

  testSelfSendIfTrueNonLastReadWriteTrueActor =>
    self bt3178ActorSelfSendInConditionalPending
      ifTrue: [
        ^self skip: "BT-3178: self-send state mutation inside ifTrue: (not a loop) doesn't thread back in Actor context"
      ]
    self assert: (self actorCorpus selfSendIfTrueNonLastReadWrite: true) equals: 1

  testSelfSendIfTrueNonLastReadWriteFalseActor =>
    self assert: (self actorCorpus selfSendIfTrueNonLastReadWrite: false) equals: 0

  testSelfSendIfTrueNonLastReadWriteTrueClassMethod =>
    self assert: (MutationCorpusClassMethod selfSendIfTrueNonLastReadWrite: true) equals: 1

  testSelfSendIfTrueNonLastReadWriteFalseClassMethod =>
    self assert: (MutationCorpusClassMethod selfSendIfTrueNonLastReadWrite: false) equals: 0

  // ════════════════════════════════════════════════════════════════════════
  //  BT-3176 axis 3 — on:do:/ensure: combined with a self-send or a nested
  //  conditional in the try body's LAST statement. See BT-3160/BT-3161.
  //  The class-method self-send analogue and the value-type/class-method
  //  nested-conditional analogue were fixed by BT-3177 — see
  //  mutation_corpus_value.bt/mutation_corpus_class_method.bt.
  // ════════════════════════════════════════════════════════════════════════
  testOnDoSelfSendLastReadWriteActor =>
    self assert: self actorCorpus onDoSelfSendLastReadWrite equals: 1

  testOnDoSelfSendLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod onDoSelfSendLastReadWrite equals: 1

  testEnsureNestedConditionalLastReadWriteTrueActor =>
    self assert: (self actorCorpus ensureNestedConditionalLastReadWrite: true) equals: 11

  testEnsureNestedConditionalLastReadWriteFalseActor =>
    self assert: (self actorCorpus ensureNestedConditionalLastReadWrite: false) equals: 1

  testEnsureNestedConditionalLastReadWriteTrueValue =>
    self assert: (self valueCorpus ensureNestedConditionalLastReadWrite: true) equals: 11

  testEnsureNestedConditionalLastReadWriteFalseValue =>
    self assert: (self valueCorpus ensureNestedConditionalLastReadWrite: false) equals: 1

  testEnsureNestedConditionalLastReadWriteTrueClassMethod =>
    self assert: (MutationCorpusClassMethod ensureNestedConditionalLastReadWrite: true) equals: 11

  testEnsureNestedConditionalLastReadWriteFalseClassMethod =>
    self assert: (MutationCorpusClassMethod ensureNestedConditionalLastReadWrite: false) equals: 1

  // ════════════════════════════════════════════════════════════════════════
  //  BT-3176 axis 4 — class-var / state-field mutation, threaded the same
  //  way the rest of the corpus threads outer locals.
  // ════════════════════════════════════════════════════════════════════════
  testStateFieldToDoNonLastReadWriteActor =>
    self assert: self actorCorpus stateFieldToDoNonLastReadWrite equals: 15

  // BT-3483/BT-3484: the TestCase-context (value-type) analogue. Before
  // BT-3484 the loop's own carried-accumulator plumbing never threaded the
  // value-type `Self` binding a field write produces, so this silently
  // returned the field's ORIGINAL value (0) instead of 15. Now the loop
  // carries `Self` through its own recursive tail call, matching the Actor
  // cell directly above.
  testStateFieldToDoNonLastReadWriteTestCase =>
    self bt3484ValueTypeFieldWriteThreadingPending
      ifTrue: [
        ^self skip: "BT-3484: value-type self.field := inside to:do: silently drops the mutation"
      ]
    self assert: self fragStateFieldToDoNonLastReadWrite equals: 15

  testClassVarToDoNonLastReadWriteClassMethod =>
    self assert: MutationCorpusClassMethod classVarToDoNonLastReadWrite equals: 15

  testStateFieldIfTrueNonLastReadWriteTrueActor =>
    self assert: (self actorCorpus stateFieldIfTrueNonLastReadWrite: true) equals: 7

  testStateFieldIfTrueNonLastReadWriteFalseActor =>
    self assert: (self actorCorpus stateFieldIfTrueNonLastReadWrite: false) equals: 0

  // BT-3484: the TestCase-context (value-type) analogue of the two Actor
  // cells directly above. Before BT-3484 this shape could not be checked in
  // at all — the branch's `Self1` binding was scoped inside the `case` arm's
  // own inner `let`, so the post-conditional read of it was an erlc
  // `unbound variable 'Self1'` compile failure for the whole file. The
  // conditional's branch-merge tuple now carries `Self` out of the taken
  // arm (and the untaken arm passes the pre-`case` `Self` through), so both
  // ground truths match the Actor cells: 7 when taken, 0 when not.
  testStateFieldIfTrueNonLastReadWriteTrueTestCase =>
    self bt3484ValueTypeFieldWriteThreadingPending
      ifTrue: [
        ^self skip: "BT-3484: value-type self.field := inside ifTrue: fails to compile"
      ]
    self assert: (self fragStateFieldIfTrueNonLastReadWrite: true) equals: 7

  testStateFieldIfTrueNonLastReadWriteFalseTestCase =>
    self bt3484ValueTypeFieldWriteThreadingPending
      ifTrue: [
        ^self skip: "BT-3484: value-type self.field := inside ifTrue: fails to compile"
      ]
    self assert: (self fragStateFieldIfTrueNonLastReadWrite: false) equals: 0

  // BT-3484 close-out (axis 4 density): the remaining Letrec/conditional
  // construct shapes, un-gated since the underlying mechanism is the same
  // one BT-3484 already fixed and verified for to:do:/ifTrue: above.
  testStateFieldToByDoNonLastReadWriteTestCase =>
    self assert: self fragStateFieldToByDoNonLastReadWrite equals: 25

  testStateFieldTimesRepeatNonLastReadWriteTestCase =>
    self assert: self fragStateFieldTimesRepeatNonLastReadWrite equals: 5

  testStateFieldWhileTrueNonLastReadWriteTestCase =>
    self assert: self fragStateFieldWhileTrueNonLastReadWrite equals: 5

  testStateFieldWhileFalseNonLastReadWriteTestCase =>
    self assert: self fragStateFieldWhileFalseNonLastReadWrite equals: 5

  testStateFieldIfTrueIfFalseNonLastReadWriteTrueTestCase =>
    self assert: (self fragStateFieldIfTrueIfFalseNonLastReadWrite: true) equals: 1

  testStateFieldIfTrueIfFalseNonLastReadWriteFalseTestCase =>
    self assert: (self fragStateFieldIfTrueIfFalseNonLastReadWrite: false) equals: 100

  // BT-3487/BT-3488: no live fixtures for these — both fail erlc outright
  // (unbound variable 'State'), which would break compilation of this whole
  // file if checked in. BT-3487: self.field := inside a Foldl-shaped list-op
  // (do:/collect:/select:/reject:/inject:into:/detect:ifNone:/count:, and a
  // Range's own do:). BT-3488: self.field := inside a conditional nested
  // inside a loop (not itself a top-level loop statement) — inconsistent
  // with the identical ClassVar shape, which gets a clean "Cannot assign to
  // field... inside this block" compile-time rejection instead of crashing;
  // BT-3488 is really about closing that inconsistency, not necessarily
  // adding full support.
  testClassVarIfTrueNonLastReadWriteTrueClassMethod =>
    self assert: (MutationCorpusClassMethod classVarIfTrueNonLastReadWrite: true) equals: 7

  testClassVarIfTrueNonLastReadWriteFalseClassMethod =>
    self assert: (MutationCorpusClassMethod classVarIfTrueNonLastReadWrite: false) equals: 0

  // ── axis 4 × on:do:/ensure: (BT-3486) ────────────────────────────────────
  // The third construct family, at the same density as the loop and
  // conditional cells above. Each TestCase (value-type) cell is paired with
  // the Actor cell for the identical fragment body, and both assert the same
  // ground truth — the "matching Actor's state.field := behavior in the
  // identical shape" bar BT-3486 was written against.
  testStateFieldEnsureTryNonLastReadWriteActor =>
    self assert: self actorCorpus stateFieldEnsureTryNonLastReadWrite equals: 1

  testStateFieldEnsureTryNonLastReadWriteTestCase =>
    self assert: self fragStateFieldEnsureTryNonLastReadWrite equals: 1

  testStateFieldEnsureCleanupNonLastReadWriteActor =>
    self assert: self actorCorpus stateFieldEnsureCleanupNonLastReadWrite equals: 7

  testStateFieldEnsureCleanupNonLastReadWriteTestCase =>
    self assert: self fragStateFieldEnsureCleanupNonLastReadWrite equals: 7

  testStateFieldEnsureBothNonLastReadWriteActor =>
    self assert: self actorCorpus stateFieldEnsureBothNonLastReadWrite equals: 11

  testStateFieldEnsureBothNonLastReadWriteTestCase =>
    self assert: self fragStateFieldEnsureBothNonLastReadWrite equals: 11

  testStateFieldOnDoTryNonLastReadWriteActor =>
    self assert: self actorCorpus stateFieldOnDoTryNonLastReadWrite equals: 3

  testStateFieldOnDoTryNonLastReadWriteTestCase =>
    self assert: self fragStateFieldOnDoTryNonLastReadWrite equals: 3

  testStateFieldOnDoHandlerNonLastReadWriteActor =>
    self assert: self actorCorpus stateFieldOnDoHandlerNonLastReadWrite equals: 5

  testStateFieldOnDoHandlerNonLastReadWriteTestCase =>
    self assert: self fragStateFieldOnDoHandlerNonLastReadWrite equals: 5

  // TestCase-only shapes (see the fragments' own comments).
  testStateFieldEnsureWriteOnlyNonLastTestCase =>
    self assert: self fragStateFieldEnsureWriteOnlyNonLast equals: 1

  testStateFieldEnsureChainedNonLastTestCase =>
    self assert: self fragStateFieldEnsureChainedNonLast equals: 3

  // BT-3492: last-statement / assignment-RHS positions (see the fragments'
  // own comments). The nested-construct position is a compile-time rejection
  // rather than a runtime cell — see `fragStateFieldEnsureAssignRhs`'s
  // neighboring comment for why.
  testStateFieldEnsureLastPositionTestCase =>
    self assert: self fragStateFieldEnsureLastPosition equals: 1

  testStateFieldEnsureAssignRhsTestCase =>
    self assert: self fragStateFieldEnsureAssignRhs equals: 1

  // ════════════════════════════════════════════════════════════════════════
  //  BT-3414 (ADR 0118 phase 0) — self-send POSITION axis, Actor-only
  //  (mutation_corpus_actor.bt; a self-send that mutates actor state has no
  //  Value/class-method analogue). See
  //  stdlib/test/actor_self_send_position_matrix_test.bt for the full
  //  position matrix this corpus axis samples from, and
  //  docs/ADR/0118-expression-level-state-threading-preludes.md for the
  //  phase each row below was fixed by (all phases have landed; every row
  //  asserts the ground-truth behaviour unconditionally).
  // ════════════════════════════════════════════════════════════════════════
  testBinaryOperandSelfSendReadWriteActor =>
    self assert: self actorCorpus binaryOperandSelfSendReadWrite equals: 2

  testKeywordArgumentSelfSendReadWriteActor =>
    self assert: self actorCorpus keywordArgumentSelfSendReadWrite equals: 10

  testAssignRhsSubExprSelfSendReadWriteActor =>
    self assert: self actorCorpus assignRhsSubExprSelfSendReadWrite equals: 101

  // ADR 0118 phase 1b (BT-3416): cascade on self.
  testCascadeOnSelfReadWriteActor =>
    self assert: self actorCorpus cascadeOnSelfReadWrite equals: 2

  // ADR 0118 phase 3 (BT-3419): self-send as a whileTrue: CONDITION
  // binary-op operand.
  testWhileTrueConditionSelfSendReadWriteActor =>
    self assert: self actorCorpus whileTrueConditionSelfSendReadWrite equals: 3

  // ADR 0118 phase 4 (BT-3420): self-send in a match: arm — fixed by phase
  // 4's inline-threaded control flow producer, not phase 2a (see
  // stdlib/test/actor_self_send_position_matrix_test.bt's
  // `testMatchArmSelfSendMatchingArm` comment for why).
  testMatchArmSelfSendReadWriteActorMatching =>
    self assert: (self actorCorpus matchArmSelfSendReadWrite: 1) equals: 2

  testMatchArmSelfSendReadWriteActorWildcard =>
    self assert: (self actorCorpus matchArmSelfSendReadWrite: 2) equals: 0
