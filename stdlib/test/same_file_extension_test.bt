// BT-4721: a file is one compilation unit for its class. An extension written
// in the target class's OWN file (BT-4489 first made it answer at all) is
// folded into the class before codegen, so it is an ordinary method: a dispatch
// arm, never a `beamtalk_extensions` row. The REPL gives the same answers
// (tests/repl-protocol/cases/same_file_extension.btscript).
//
// Fixtures: stdlib/test/fixtures/same_file_ext_obj.bt (plain, class side)
//           stdlib/test/fixtures/same_file_ext_pt.bt (value)
//           stdlib/test/fixtures/same_file_ext_ac.bt (actor)
//           stdlib/test/fixtures/same_file_ext_native.bt (native: class side)

TestCase subclass: SameFileExtensionTest

  testValueInstanceExtension =>
    self assert: ((SameFileExtPt x: 3) extra: 4) equals: 7

  testValueClassSideExtension => self assert: SameFileExtPt make getX equals: 9

  testActorInstanceExtension =>
    a := SameFileExtAc spawn
    self assert: (a plus: 2) equals: 7

  testActorExtensionUpdatesState =>
    a := SameFileExtAc spawn
    a bump
    self assert: a getN equals: 6

  testActorClassSideExtension => self assert: SameFileExtAc cextra equals: 42

  testPlainClassSideExtension =>
    self assert: SameFileExtObj extra equals: 2
    self assert: SameFileExtObj make equals: 7

  testPlainExtensionIsAnOrdinaryClassMethod =>
    self assert: (SameFileExtObj respondsTo: #extra) equals: true
    self assert: SameFileExtObj base equals: 1

  testNativeClassSideExtension =>
    self assert: SameFileExtNative cextra equals: 42
