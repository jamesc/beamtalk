// BT-3744 (ADR 0131 Phase 0a): the ADR 0131 probe matrix, one test per probe
// shape per method context (class method, value-type method, actor instance
// method). The shapes are the rows of the two probe tables in ADR 0131
// §Context (o1-o13: operand position; s1-s9: assign-RHS and statement
// position), the §1a sequencing shape (`seq`), and the `Result tryDo:` failure
// the same section describes. The fixtures, with each body, are
// fixtures/adr0131local_rebind_{class,value,actor}.bt.
//
// A test asserts the ADR's Expected answer. A test whose answer differs today
// pins today's answer under a `PIN-BUG BT-3743` marker naming the correct
// answer; the BT-3743 phases flip the pins they fix, and phase 5 (BT-3751)
// flips the rest. A shape that does not compile in a context today cannot be
// pinned in a compiled module; it is written with its Expected answer in
// adr0131local_rebind_pending_test.bt.pending (and its fixtures in
// fixtures/*_pending.bt.pending), which the runner does not discover. The
// phase that makes it compile drops the `.pending` suffix.
//
// BT-3745 (ADR 0131 Phase 0b) made every shape that crashed or answered wrong
// a compile error: the §6 error for a Tier 2 block value with no return
// channel, or the Phase 0 allow-set error for a construct in a position that
// does not thread its outer-local writes yet (BT-3743). Those cells moved to the pending
// files; the compile errors themselves are pinned by
// `adr0131_probe_matrix_pins` in
// crates/beamtalk-core/src/semantic_analysis/tests/local_threading.rs, which
// checks that every pending fixture method is rejected and every method here
// is not. Class and value-type s4 (`b := [t := t + 1]. b value`) is a
// permanent §6 error and is pinned only there.
//
// Value-type o5/o13 differ from the ADR table's "pass": a value type cannot
// write `self.n :=` (ADR 0042), so the fixture passes the same construct to
// the functional update `self withN:` (an argument position), which is a
// compile error (pending) today.

TestCase subclass: Adr0131LocalRebindTest

  testO5Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o5) equals: #[1, 1]

  testO11Class => self assert: (Adr0131LocalRebindClass o11) equals: #[1, 2]

  testO11Value =>
    self assert: ((Adr0131LocalRebindValue new) o11) equals: #[1, 2]

  testO11Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o11) equals: #[1, 2]

  testO13Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o13: false) equals: #[1, 1]

  testS3Class => self assert: (Adr0131LocalRebindClass s3) equals: #[3, 2]

  testS3Value => self assert: ((Adr0131LocalRebindValue new) s3) equals: #[3, 2]

  testS3Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s3) equals: #[3, 2]

  testS4Actor => self assert: ((Adr0131LocalRebindActor spawn) s4) equals: 1

  testS5Class => self assert: (Adr0131LocalRebindClass s5) equals: #[1, 1]

  testS5Value => self assert: ((Adr0131LocalRebindValue new) s5) equals: #[1, 1]

  testS5Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s5) equals: #[1, 1]

  testS6Class => self assert: (Adr0131LocalRebindClass s6) equals: #[#(1), 0]

  testS6Value =>
    self assert: ((Adr0131LocalRebindValue new) s6) equals: #[#(1), 0]

  testS6Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s6) equals: #[#(1), 0]

  testS7Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s7) equals: #[1, 1]

  testS8Class => self assert: (Adr0131LocalRebindClass s8) equals: 3

  testS8Value => self assert: ((Adr0131LocalRebindValue new) s8) equals: 3

  testS8Actor => self assert: ((Adr0131LocalRebindActor spawn) s8) equals: 3

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is #[true, 0].
  testTryDoRaisesClass =>
    self should: [Adr0131LocalRebindClass tryDoRaises] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is #[true, 0].
  testTryDoRaisesValue =>
    self should: [(Adr0131LocalRebindValue new) tryDoRaises] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is #[true, 0].
  testTryDoRaisesActor =>
    self should: [
      (Adr0131LocalRebindActor spawn) tryDoRaises
    ] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is 1.
  testTryDoStatementClass =>
    self should: [Adr0131LocalRebindClass tryDoStatement] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is 1.
  testTryDoStatementValue =>
    self should: [
      (Adr0131LocalRebindValue new) tryDoStatement
    ] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is 1.
  testTryDoStatementActor =>
    self should: [
      (Adr0131LocalRebindActor spawn) tryDoStatement
    ] raise: #type_error

  testVtLastInjectValue =>
    self assert: ((Adr0131LocalRebindValue new) vtLastInject) equals: 3

  // BT-3753: statement-position shapes that answer right today (the ones that
  // do not are Phase 0 compile errors, in adr0131local_rebind_pending_test).
  testStBlockValueValue =>
    self assert: ((Adr0131LocalRebindValue new) stBlockValue) equals: 1

  testStArmDoActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stArmDo: true) equals: 3

  testStArmInjectActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stArmInject: true) equals: 3

  testStEachWithIndexActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stEachWithIndex) equals: 3

  testStDoSeparatedByActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stDoSeparatedBy) equals: 13

  testStKeysAndValuesDoActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stKeysAndValuesDo) equals: 3

  testStBlockValueActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stBlockValue) equals: 1

  // ADR 0131 Phase 2 (BT-3749): a loop or fold in operand position is a
  // local-threading producer in every method context.
  testO4Class => self assert: (Adr0131LocalRebindClass o4) equals: #[2, 3]

  testO4Value => self assert: ((Adr0131LocalRebindValue new) o4) equals: #[2, 3]

  testO4Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o4) equals: #[2, 3]

  testS9Class => self assert: (Adr0131LocalRebindClass s9) equals: #[2, 2]

  testS9Value => self assert: ((Adr0131LocalRebindValue new) s9) equals: #[2, 2]

  testS9Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s9) equals: #[2, 2]

  testVtReturnInjectValue =>
    self assert: ((Adr0131LocalRebindValue new) vtReturnInject) equals: 3

  // BT-3798 (ADR 0131 Phase 2d): `Dictionary at:ifAbsent:` whose handler
  // writes compiles in every context (s1); the rest of its matrix is
  // adr0131lookup_test.bt.
  testS1Class => self assert: (Adr0131LocalRebindClass s1) equals: #[0, 1]

  testS1Value => self assert: ((Adr0131LocalRebindValue new) s1) equals: #[0, 1]

  testS1Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s1) equals: #[0, 1]

  // BT-3794 (ADR 0131 Phase 2c): `detect:ifNone:` whose handler writes
  // compiles in every context (s2 and the statement form).
  testS2Class => self assert: (Adr0131LocalRebindClass s2) equals: #[0, 1]

  testS2Value => self assert: ((Adr0131LocalRebindValue new) s2) equals: #[0, 1]

  testS2Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s2) equals: #[0, 1]

  testStDetectIfNoneClass =>
    self assert: (Adr0131LocalRebindClass stDetectIfNone) equals: 1

  testStDetectIfNoneValue =>
    self assert: ((Adr0131LocalRebindValue new) stDetectIfNone) equals: 1

  testStDetectIfNoneActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stDetectIfNone) equals: 1

  // ADR 0131 Phase 3 (BT-3738): conditionals as local-threading producers
  testO3Class => self assert: (Adr0131LocalRebindClass o3) equals: #[2, 1]

  testO12Class =>
    self assert: (Adr0131LocalRebindClass o12: false) equals: #[2, 1]

  testO13Class =>
    self assert: (Adr0131LocalRebindClass o13: false) equals: #[1, 1]

  testS7Class => self assert: (Adr0131LocalRebindClass s7) equals: #[1, 1]

  testSeqArgClass =>
    self assert: (Adr0131LocalRebindClass seqArg: true) equals: #[1, 1]

  testSeqRecvClass =>
    self assert: (Adr0131LocalRebindClass seqRecv: true) equals: #[1, 1]

  testStArmDoClass =>
    self assert: (Adr0131LocalRebindClass stArmDo: true) equals: 3

  testStArmWhileClass =>
    self assert: (Adr0131LocalRebindClass stArmWhile: true) equals: 2

  testStArmInjectClass =>
    self assert: (Adr0131LocalRebindClass stArmInject: true) equals: 3

  testO3Value => self assert: ((Adr0131LocalRebindValue new) o3) equals: #[2, 1]

  testO12Value =>
    self assert: ((Adr0131LocalRebindValue new) o12: false) equals: #[2, 1]

  testO13Value =>
    self assert: ((Adr0131LocalRebindValue new) o13: false) equals: #[1, 1]

  testS7Value => self assert: ((Adr0131LocalRebindValue new) s7) equals: #[1, 1]

  testSeqArgValue =>
    self assert: ((Adr0131LocalRebindValue new) seqArg: true) equals: #[1, 1]

  testSeqRecvValue =>
    self assert: ((Adr0131LocalRebindValue new) seqRecv: true) equals: #[1, 1]

  testStArmDoValue =>
    self assert: ((Adr0131LocalRebindValue new) stArmDo: true) equals: 3

  testStArmWhileValue =>
    self assert: ((Adr0131LocalRebindValue new) stArmWhile: true) equals: 2

  testStArmInjectValue =>
    self assert: ((Adr0131LocalRebindValue new) stArmInject: true) equals: 3

  testO3Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o3) equals: #[2, 1]

  testO12Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o12: false) equals: #[2, 1]

  testSeqArgActor =>
    self assert: ((Adr0131LocalRebindActor spawn) seqArg: true) equals: #[1, 1]

  testSeqRecvActor =>
    self assert: ((Adr0131LocalRebindActor spawn) seqRecv: true) equals: #[1, 1]

  testStArmWhileActor =>
    self assert: ((Adr0131LocalRebindActor spawn) stArmWhile: true) equals: 2

  // ADR 0131 Phase 3b (BT-3817): `on:do:`/`ensure:` as local-threading producers.
  testO1Class => self assert: (Adr0131LocalRebindClass o1) equals: #[2, 1]

  testO1Value => self assert: ((Adr0131LocalRebindValue new) o1) equals: #[2, 1]

  testO1Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o1) equals: #[2, 1]

  testO2Class => self assert: (Adr0131LocalRebindClass o2) equals: #[2, 2]

  testO2Value => self assert: ((Adr0131LocalRebindValue new) o2) equals: #[2, 2]

  testO2Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o2) equals: #[2, 2]

  testO5Class => self assert: (Adr0131LocalRebindClass o5) equals: #[1, 1]

  testO5Value => self assert: ((Adr0131LocalRebindValue new) o5) equals: #[1, 1]

  testO6Class => self assert: (Adr0131LocalRebindClass o6: true) equals: #[1, 1]

  testO6Value =>
    self assert: ((Adr0131LocalRebindValue new) o6: true) equals: #[1, 1]

  testO6Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o6: true) equals: #[1, 1]

  testO7Class =>
    self assert: (Adr0131LocalRebindClass o7: false) equals: #[7, 1]

  testO7Value =>
    self assert: ((Adr0131LocalRebindValue new) o7: false) equals: #[7, 1]

  testO7Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o7: false) equals: #[7, 1]

  testO8Class =>
    self assert: (Adr0131LocalRebindClass o8: false) equals: #[2, 1]

  testO8Value =>
    self assert: ((Adr0131LocalRebindValue new) o8: false) equals: #[2, 1]

  testO8Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o8: false) equals: #[2, 1]

  testO9Class => self assert: (Adr0131LocalRebindClass o9) equals: 2

  testO9Value => self assert: ((Adr0131LocalRebindValue new) o9) equals: 2

  testO9Actor => self assert: ((Adr0131LocalRebindActor spawn) o9) equals: 2

  testO10Class => self assert: (Adr0131LocalRebindClass o10: true) equals: 2

  testO10Value =>
    self assert: ((Adr0131LocalRebindValue new) o10: true) equals: 2

  testO10Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o10: true) equals: 2

  testSeqClass => self assert: (Adr0131LocalRebindClass seq) equals: #[1, 1]

  testSeqValue =>
    self assert: ((Adr0131LocalRebindValue new) seq) equals: #[1, 1]

  testSeqActor =>
    self assert: ((Adr0131LocalRebindActor spawn) seq) equals: #[1, 1]

  testStProtectedDoClass =>
