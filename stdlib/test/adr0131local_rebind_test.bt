// BT-3744 (ADR 0131 Phase 0a): the ADR 0131 probe matrix, one test per probe
// shape per method context (class method, value-type method, actor instance
// method). The shapes are the rows of the two probe tables in ADR 0131
// §Context (o1-o13: operand position; s1-s9: assign-RHS and statement
// position), the §1a sequencing shape (`seq`), and the `Result tryDo:` failure
// the same section describes. The fixtures, with each body, are
// fixtures/adr0131local_rebind_{class,value,actor}.bt.
//
// A test asserts the ADR's Expected answer. A test whose answer differs today
// pins today's answer under a `PIN-BUG BT-3743` marker naming the correct
// answer; the BT-3743 phases flip the pins they fix, and phase 5 (BT-3751)
// flips the rest. A shape that does not compile in a context today cannot be
// pinned in a compiled module; it is written with its Expected answer in
// adr0131local_rebind_pending_test.bt.pending (and its fixtures in
// fixtures/*_pending.bt.pending), which the runner does not discover. The
// phase that makes it compile drops the `.pending` suffix.
//
// BT-3745 (ADR 0131 Phase 0b) made every shape that crashed or answered wrong
// a compile error: the §6 error for a Tier 2 block value with no return
// channel, or the Phase 0 allow-set error for a construct in a position that
// does not thread its outer-local writes yet (BT-3743). Those cells moved to the pending
// files; the compile errors themselves are pinned by
// `adr0131_probe_matrix_pins` in
// crates/beamtalk-core/src/semantic_analysis/tests/local_threading.rs, which
// checks that every pending fixture method is rejected and every method here
// is not. Class and value-type s4 (`b := [t := t + 1]. b value`) is a
// permanent §6 error and is pinned only there.
//
// Value-type o5/o13 differ from the ADR table's "pass": a value type cannot
// write `self.n :=` (ADR 0042), so the fixture passes the same construct to
// the functional update `self withN:` (an argument position), which is a
// compile error (pending) today.

TestCase subclass: Adr0131LocalRebindTest

  testO5Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o5) equals: #[1, 1]

  testO11Class => self assert: (Adr0131LocalRebindClass o11) equals: #[1, 2]

  testO11Value =>
    self assert: ((Adr0131LocalRebindValue new) o11) equals: #[1, 2]

  testO11Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o11) equals: #[1, 2]

  testO13Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) o13: false) equals: #[1, 1]

  testS3Class => self assert: (Adr0131LocalRebindClass s3) equals: #[3, 2]

  testS3Value => self assert: ((Adr0131LocalRebindValue new) s3) equals: #[3, 2]

  testS3Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s3) equals: #[3, 2]

  testS4Actor => self assert: ((Adr0131LocalRebindActor spawn) s4) equals: 1

  testS5Class => self assert: (Adr0131LocalRebindClass s5) equals: #[1, 1]

  testS5Value => self assert: ((Adr0131LocalRebindValue new) s5) equals: #[1, 1]

  testS5Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s5) equals: #[1, 1]

  testS6Class => self assert: (Adr0131LocalRebindClass s6) equals: #[#(1), 0]

  testS6Value =>
    self assert: ((Adr0131LocalRebindValue new) s6) equals: #[#(1), 0]

  testS6Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s6) equals: #[#(1), 0]

  testS7Actor =>
    self assert: ((Adr0131LocalRebindActor spawn) s7) equals: #[1, 1]

  testS8Class => self assert: (Adr0131LocalRebindClass s8) equals: 3

  testS8Value => self assert: ((Adr0131LocalRebindValue new) s8) equals: 3

  testS8Actor => self assert: ((Adr0131LocalRebindActor spawn) s8) equals: 3

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is #[true, 0].
  testTryDoRaisesClass =>
    self should: [Adr0131LocalRebindClass tryDoRaises] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is #[true, 0].
  testTryDoRaisesValue =>
    self should: [(Adr0131LocalRebindValue new) tryDoRaises] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is #[true, 0].
  testTryDoRaisesActor =>
    self should: [
      (Adr0131LocalRebindActor spawn) tryDoRaises
    ] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is 1.
  testTryDoStatementClass =>
    self should: [Adr0131LocalRebindClass tryDoStatement] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is 1.
  testTryDoStatementValue =>
    self should: [
      (Adr0131LocalRebindValue new) tryDoStatement
    ] raise: #type_error

  // PIN-BUG BT-3743: pins today's answer (the Tier 2 block reaches the arity-0 `beamtalk_result:'tryDo:'/1` (ADR 0131 §5)); the correct answer is 1.
  testTryDoStatementActor =>
    self should: [
      (Adr0131LocalRebindActor spawn) tryDoStatement
    ] raise: #type_error
