// BUnit tests for `Beamtalk releaseInfo` / `Beamtalk shapeManifest`
// (ADR 0125 §1.8/§3.4, BT-3575).
//
// `Beamtalk releaseInfo`/`shapeManifest` are class-side sends on the sealed,
// stateless `Beamtalk` class (ADR 0129), so they work under `beamtalk test`
// and, with no compiler, through `run-entry`. Both run against this BUnit
// run's own live class registry. Release-mode-specific behaviour
// (`#{#release => nil}` on a non-release node, run-entry reachability with
// no compiler) is covered by
// `tests/repl-protocol/cases/release_console_default.btscript` /
// `release_console_include_compiler.btscript`.

TestCase subclass: BeamtalkReleaseInterfaceTest

  testClassIncludesSelectorReleaseInfo =>
    self assert: (Beamtalk class includesSelector: #releaseInfo)

  testClassIncludesSelectorShapeManifest =>
    self assert: (Beamtalk class includesSelector: #shapeManifest)

  // This BUnit run is not an OTP release (no `-boot_var RELEASE_DIR`), so
  // `releaseInfo` degrades to `#{#release => nil}` — never an error, and
  // never a crash reaching all the way to this test.
  testReleaseInfoOnNonReleaseNodeIsRelease =>
    info := Beamtalk releaseInfo
    self assert: (info at: #release) isNil

  testReleaseInfoReturnsADictionary =>
    self assert: (Beamtalk releaseInfo isKindOf: Dictionary)

  testShapeManifestReturnsADictionary =>
    self assert: (Beamtalk shapeManifest isKindOf: Dictionary)
