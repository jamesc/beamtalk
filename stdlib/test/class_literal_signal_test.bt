// BT-4270: a class-literal signal send (`MyErr signal: m`) raises in the
// caller (BT-4115) only while it still resolves to `Exception`'s compiled
// signal primitive. The call sites below are compiled once, warmed (their
// caller-safe raise key installed), then the class's `class signal:` is
// replaced at run time: the already-compiled call site runs the replacement.
// Before and after, the raised exception's class is the receiving class and
// `on: <that class> do:` catches it. (A reload that adds an override needs a
// workspace: tests/repl-protocol/cases/class_literal_signal_reload.btscript.)
//
// A test that patches a class with a runtime class-method fun removes it
// again (`X class removeSelector:`, BT-4438), so the tests can run twice in
// one VM.
//
// Fixtures: fixtures/bt4270raise_ext_err.bt, fixtures/bt4270raise_fun_err.bt,
// fixtures/bt4270raise_mid.bt, fixtures/bt4270raise_leaf.bt,
// fixtures/bt4270raise_plain.bt.

TestCase subclass: ClassLiteralSignalTest

  // The compiled call sites.
  raiseExt: m => Bt4270RaiseExtErr signal: m

  raiseFun: m => Bt4270RaiseFunErr signal: m

  raiseLeaf: m => Bt4270RaiseLeaf signal: m

  raisePlain: m => Bt4270RaisePlain signal: m

  // What a call site does: the value it answers, or the class and message
  // of what it raised, caught by the class it named.
  outcomeOf: aBlock :: Block on: cls -> List =>
    [
      #(#returned, aBlock value)
    ] on: cls do: [:e | #(#raised, e class, e message)]

  // The hit path is taken, not only the fallback: a warmed `Error signal:`
  // call site's raise key is installed, holding `Error`'s class reference.
  testWarmedSendInstallsItsKey =>
    [Error signal: "warm"] on: Error do: [:e | nil]
    key := Erlang erlang list_to_tuple: #(#caller_safe_raise, #classSignal:, #'bt@stdlib@exception', #class_signal:, #'Error class')
    self assert: (Erlang beamtalk_class_shadow_flags static_call_key_value: key) equals: Error

  testRaiseIsTheReceivingClassAndCaughtByIt =>
    self assert: (self outcomeOf: [
      self raiseExt: "x"
    ] on: Bt4270RaiseExtErr) equals: #(#raised, Bt4270RaiseExtErr, "x")
    self assert: (self outcomeOf: [
      self raisePlain: "y"
    ] on: Bt4270RaisePlain) equals: #(#raised, Bt4270RaisePlain, "y")
    // An ancestor's handler catches it too.
    self assert: ([
      self raiseExt: "z"
    ] on: Error do: [:e | e class]) equals: Bt4270RaiseExtErr

  // A class-side extension of `signal:` registered after warm-up is honoured
  // by the call site compiled before it, and the raise is back once it goes.
  testExtensionAfterWarmUpIsHonoured =>
    self assert: (self outcomeOf: [
      self raiseExt: "x"
    ] on: Bt4270RaiseExtErr) equals: #(#raised, Bt4270RaiseExtErr, "x")
    Erlang beamtalk_extensions
      register: #'Bt4270RaiseExtErr class'
      selector: #signal:
      fun: [:args :receiver | #fromExtension]
      owner: #test
    shadowed := self outcomeOf: [self raiseExt: "x"] on: Bt4270RaiseExtErr
    Erlang beamtalk_extensions
      unregister: #Bt4270RaiseExtErr
      selector: #signal:
      classSide: true
    self assert: shadowed equals: #(#returned, #fromExtension)
    self assert: (self outcomeOf: [
      self raiseExt: "x"
    ] on: Bt4270RaiseExtErr) equals: #(#raised, Bt4270RaiseExtErr, "x")

  // A runtime class-method fun replacing `signal:` on the receiving class
  // after warm-up is honoured, and the raise is back once it goes.
  testRuntimeFunOnTheClassAfterWarmUpIsHonoured =>
    self assert: (self outcomeOf: [
      self raiseFun: "x"
    ] on: Bt4270RaiseFunErr) equals: #(#raised, Bt4270RaiseFunErr, "x")
    pid := Erlang beamtalk_class_registry whereis_class: #Bt4270RaiseFunErr
    @expect type
    Erlang beamtalk_object_class
      put_class_method: pid
      selector: #signal:
      fun: [:classSelf :msg | #fromRuntimeFun]
    [
      self assert: (self outcomeOf: [
        self raiseFun: "x"
      ] on: Bt4270RaiseFunErr) equals: #(#returned, #fromRuntimeFun)
    ] ensure: [Bt4270RaiseFunErr class removeSelector: #signal:]
    self assert: (self outcomeOf: [
      self raiseFun: "x"
    ] on: Bt4270RaiseFunErr) equals: #(#raised, Bt4270RaiseFunErr, "x")

  // The same on an ancestor between the receiving class and `Exception`: the
  // ancestor's write takes away its descendant's key, and removing the fun
  // brings the raise back.
  testRuntimeFunOnAnAncestorAfterWarmUpIsHonoured =>
    self assert: (self outcomeOf: [
      self raiseLeaf: "x"
    ] on: Bt4270RaiseLeaf) equals: #(#raised, Bt4270RaiseLeaf, "x")
    pid := Erlang beamtalk_class_registry whereis_class: #Bt4270RaiseMid
    @expect type
    Erlang beamtalk_object_class
      put_class_method: pid
      selector: #signal:
      fun: [:classSelf :msg | classSelf name]
    // The fun runs with the receiving class as `self`, as the dynamic path does.
    [
      self assert: (self outcomeOf: [
        self raiseLeaf: "x"
      ] on: Bt4270RaiseLeaf) equals: #(#returned, #Bt4270RaiseLeaf)
    ] ensure: [Bt4270RaiseMid class removeSelector: #signal:]
    self assert: (self outcomeOf: [
      self raiseLeaf: "x"
    ] on: Bt4270RaiseLeaf) equals: #(#raised, Bt4270RaiseLeaf, "x")

  // A class-side extension of `signal:` on an ancestor between the receiving
  // class and `Exception`, registered after warm-up, is honoured by the call
  // site compiled before it (BT-4307: an ancestor's extension counts as that
  // ancestor's method, so its registration takes away the descendant's key),
  // and the raise is back once it goes.
  testExtensionOnAnAncestorAfterWarmUpIsHonoured =>
    self assert: (self outcomeOf: [
      self raiseLeaf: "x"
    ] on: Bt4270RaiseLeaf) equals: #(#raised, Bt4270RaiseLeaf, "x")
    Erlang beamtalk_extensions
      register: #'Bt4270RaiseMid class'
      selector: #signal:
      fun: [:args :receiver | receiver name]
      owner: #test
    shadowed := self outcomeOf: [self raiseLeaf: "x"] on: Bt4270RaiseLeaf
    Erlang beamtalk_extensions
      unregister: #Bt4270RaiseMid
      selector: #signal:
      classSide: true
    // The extension runs with the receiving class as `self`.
    self assert: shadowed equals: #(#returned, #Bt4270RaiseLeaf)
    self assert: (self outcomeOf: [
      self raiseLeaf: "x"
    ] on: Bt4270RaiseLeaf) equals: #(#raised, Bt4270RaiseLeaf, "x")
