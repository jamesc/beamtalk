// BT-1514: Tests that extension methods on sealed classes (Integer, String, Array)
// work through the ETS dispatch path (file-loaded extensions, not REPL recompilation).
//
// Extensions are registered directly via beamtalk_extensions:register/4 in each test
// to ensure we test the ETS dispatch mechanism, not REPL class recompilation.
// All extension calls use perform: / perform:withArguments: to bypass the sealed
// class static check (the compiler rejects calls to unknown methods on sealed types).
// Each test registers its extension, runs the assertion, then cleans up the ETS entry.

TestCase subclass: ExtensionSealedTest

  // =========================================================================
  // Integer extensions via ETS
  // =========================================================================
  testIntegerExtensionUnary =>
    // Register: Integer >> triple => self * 3
    extFun := [:a :s | s * 3]
    Erlang beamtalk_extensions
      register: #Integer
      selector: #triple
      fun: extFun
      owner: #test
    result := 14 perform: #triple
    Erlang ets delete: #beamtalk_extensions key: #(#Integer, #triple)
    self assert: result equals: 42

  testIntegerExtensionKeyword =>
    // Register: Integer >> times: n => self * n
    extFun := [:a :s | s * (a at: 1)]
    Erlang beamtalk_extensions
      register: #Integer
      selector: #times:
      fun: extFun
      owner: #test
    result := 7 perform: #times: withArguments: #(6)
    Erlang ets delete: #beamtalk_extensions key: #(#Integer, #times:)
    self assert: result equals: 42

  // =========================================================================
  // String extensions via ETS
  // =========================================================================
  testStringExtensionUnary =>
    // Register: String >> exclaim => self ++ "!"
    extFun := [:a :s | s ++ "!"]
    Erlang beamtalk_extensions
      register: #String
      selector: #exclaim
      fun: extFun
      owner: #test
    result := "hello" perform: #exclaim
    Erlang ets delete: #beamtalk_extensions key: #(#String, #exclaim)
    self assert: result equals: "hello!"

  testStringExtensionKeyword =>
    // Register: String >> wrappedWith: str => str ++ self ++ str
    extFun := [:a :s | (a at: 1) ++ s ++ (a at: 1)]
    Erlang beamtalk_extensions
      register: #String
      selector: #wrappedWith:
      fun: extFun
      owner: #test
    result := "hello" perform: #wrappedWith: withArguments: #("**")
    Erlang ets delete: #beamtalk_extensions key: #(#String, #wrappedWith:)
    self assert: result equals: "**hello**"

  // =========================================================================
  // Array extensions via ETS
  // =========================================================================
  testArrayExtensionUnary =>
    // Register: Array >> isTaggedMap => verifies the receiver is an Array
    // Arrays are tagged maps at the BEAM level: #{'$beamtalk_class' => 'Array', ...}
    extFun := [:a :s | Erlang erlang is_map: s]
    Erlang beamtalk_extensions
      register: #Array
      selector: #isTaggedMap
      fun: extFun
      owner: #test
    arr := #[10, 20, 30]
    result := arr perform: #isTaggedMap
    Erlang ets delete: #beamtalk_extensions key: #(#Array, #isTaggedMap)
    self assert: result

  testArrayExtensionKeyword =>
    // Register: Array >> tagWith: label => returns the label (tests arg passing)
    extFun := [:a :s | a at: 1]
    Erlang beamtalk_extensions
      register: #Array
      selector: #tagWith:
      fun: extFun
      owner: #test
    arr := #[10, 20, 30]
    result := arr perform: #tagWith: withArguments: #("tagged")
    Erlang ets delete: #beamtalk_extensions key: #(#Array, #tagWith:)
    self assert: result equals: "tagged"

  // =========================================================================
  // Class-side extensions via ETS
  // =========================================================================
  testIntegerClassSideExtension =>
    // Register class-side: Integer class >> meaningOfLife => 42
    // Class-side extensions go through the metaclass dispatch chain.
    // The class name in ETS for metaclass dispatch is 'Integer class'.
    // BT-3192: class-side dispatch now checks the extensions table
    // (beamtalk_class_dispatch:handle_class_method_call/6), so this reaches
    // the registered fun instead of raising does_not_understand.
    extFun := [:a :s | 42]
    Erlang beamtalk_extensions
      register: #'Integer class'
      selector: #meaningOfLife
      fun: extFun
      owner: #test
    result := Integer perform: #meaningOfLife
    Erlang ets delete: #beamtalk_extensions key: #(#'Integer class', #meaningOfLife)
    self assert: result equals: 42

  // =========================================================================
  // Verify ETS dispatch properties
  // =========================================================================
  testExtensionIsInEts =>
    // Register an extension and verify it's found via ETS lookup
    extFun := [:a :s | s * 3]
    Erlang beamtalk_extensions
      register: #Integer
      selector: #tripled
      fun: extFun
      owner: #test
    hasIt := Erlang beamtalk_extensions has: #Integer selector: #tripled
    result := 10 perform: #tripled
    Erlang ets delete: #beamtalk_extensions key: #(#Integer, #tripled)
    self assert: hasIt
    self assert: result equals: 30

  testExtensionDoesNotOverrideLocalMethod =>
    // BT-3203: `Integer >> +` is a compiler intrinsic — codegen emits the
    // BEAM arithmetic op directly and this call never reaches dispatch at
    // all. So on its own this test only proves that intrinsics can't be
    // shadowed by extensions; it does NOT by itself demonstrate general
    // local-method-vs-extension dispatch priority. See
    // testLocalMethodWinsOverExtensionForGenuinelyDispatchedMethod below,
    // which confirms empirically that the same "local wins" outcome also
    // holds for a real, non-intrinsic dispatched method — for a different
    // reason (see that test's comment).
    // Register an extension with the same name as a local method
    extFun := [:a :s | 999]
    Erlang beamtalk_extensions
      register: #Integer
      selector: #'+'
      fun: extFun
      owner: #test
    // Local method still wins here — but only because #'+' is an intrinsic
    // that bypasses dispatch entirely, not because extensions generally lose.
    result := 2 + 3
    Erlang ets delete: #beamtalk_extensions key: #(#Integer, #'+')
    self assert: result equals: 5

  testLocalMethodWinsOverExtensionForGenuinelyDispatchedMethod =>
    // BT-3203: unlike Integer >> + above, Bt3203ExtensionPriorityHost >>
    // localGreeting (stdlib/test/fixtures/bt3203extension_priority_host.bt)
    // is a real, non-intrinsic instance method that does reach compiled
    // dispatch. Confirm the local method runs first...
    host := Bt3203ExtensionPriorityHost new
    self assert: host localGreeting equals: "local"
    // ...then register an extension for the same selector.
    //
    // beamtalk_dispatch.erl's lookup/5 doc comment describes an
    // extension-before-local-method-table order ("Step 1: check extension
    // registry... Step 2: check class's own method table"), which might
    // suggest the extension should win here. Empirically it does NOT:
    // lookup/5's Step 1/Step 2 order only governs the module-less/
    // hierarchy-walk fallback path (beamtalk_actor:dispatch_via_hierarchy/4,
    // used for classes with no compiled module, and the supervisor-tuple
    // path in beamtalk_message_dispatch:send/3). Every class compiled from
    // a .bt file — Value, Object, and Actor alike — instead gets a generated
    // dispatch/3 (or /4) function whose `case Selector of` matches each
    // locally-defined method as its own clause; the extension registry is
    // only consulted in the final default/`OtherSelector` arm, for
    // selectors the class does NOT define locally (see
    // value_type_codegen.rs generate_primitive_dispatch and
    // gen_server/dispatch.rs generate_dispatch_default_case). So for every
    // compiled class, a local method — intrinsic or not — always wins over
    // a same-selector extension; extensions only ever add new selectors.
    extFun := [:a :s | "extension"]
    Erlang beamtalk_extensions
      register: #Bt3203ExtensionPriorityHost
      selector: #localGreeting
      fun: extFun
      owner: #test
    result := host localGreeting
    Erlang ets delete: #beamtalk_extensions key: #(#Bt3203ExtensionPriorityHost, #localGreeting)
    self assert: result equals: "local"

  testRespondsToExtension =>
    // Register an extension and check respondsTo:
    extFun := [:a :s | s * 4]
    Erlang beamtalk_extensions
      register: #Integer
      selector: #quadrupled
      fun: extFun
      owner: #test
    result := 42 respondsTo: #quadrupled
    Erlang ets delete: #beamtalk_extensions key: #(#Integer, #quadrupled)
    self assert: result
