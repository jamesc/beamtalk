// BT-815: Tests that a user-defined Collection subclass (implementing only
// do: and size) correctly inherits the abstract Collection protocol

TestCase subclass: CustomCollectionTest
  field: col = nil
  field: empty = nil

  setUp =>
    self.col := NumberList new: #{#items => #(1, 2, 3)}
    self.empty := NumberList new: #{#items => #()}

  testInheritedInjectInto =>
    self assert: (self.col inject: 0 into: [:sum :x | sum + x]) equals: 6
    // Non-commutative: verifies block arg order is (accumulator, element)
    self assert: (self.col inject: #() into: [:acc :x |
      acc addFirst: x
    ]) equals: #(3, 2, 1)

  testInheritedCollect =>
    self assert: (self.col collect: [:x | x * 2]) equals: #(2, 4, 6)

  testInheritedSelect =>
    col := NumberList new: #{#items => #(1, 2, 3, 4)}
    self assert: (col select: [:x | x > 2]) equals: #(3, 4)

  testInheritedReject =>
    col := NumberList new: #{#items => #(1, 2, 3, 4)}
    self assert: (col reject: [:x | x > 2]) equals: #(1, 2)

  testInheritedIncludes =>
    self assert: (self.col includes: 2)
    self deny: (self.col includes: 9)

  testInheritedIsEmpty =>
    self assert: self.empty isEmpty
    self deny: self.empty isNotEmpty
    col := NumberList new: #{#items => #(1)}
    self deny: col isEmpty
    self assert: col isNotEmpty

  testInheritedDetect => self assert: (self.col detect: [:x | x > 1]) equals: 2

  testInheritedDetectIfNone =>
    self assert: (self.col detect: [:x | x > 10] ifNone: [0]) equals: 0

  // BT-3028: the inherited `detect:` raises on a no-match, and the error names
  // the *receiver's* class rather than the abstract `Collection` the method is
  // defined on — so a user-defined subclass reports itself.
  testInheritedDetectNoMatchNamesReceiverClass =>
    errorClass := [
      self.col detect: [:x | x > 10]
    ] on: RuntimeError do: [:e | e errorClass asString]
    self assert: errorClass equals: "NumberList"

  testInheritedAnySatisfy =>
    self assert: (self.col anySatisfy: [:x | x > 2])
    self deny: (self.col anySatisfy: [:x | x > 5])

  testInheritedAllSatisfy =>
    self assert: (self.col allSatisfy: [:x | x > 0])
    self deny: (self.col allSatisfy: [:x | x > 1])

  testEmptyCollectionEdgeCases =>
    self assert: (self.empty inject: 0 into: [:acc :x | acc + x]) equals: 0
    self assert: (self.empty collect: [:x | x * 2]) equals: #()
    self assert: (self.empty select: [:x | x > 0]) equals: #()
    self assert: (self.empty reject: [:x | x > 0]) equals: #()
    self deny: (self.empty includes: 1)
    // BT-3028: `detect:` answers `E`, so a no-match raises rather than
    // answering nil — an empty receiver is just the degenerate no-match case.
    self should: [self.empty detect: [:x | x > 0]] raise: #not_found
    self assert: (self.empty detect: [:x | x > 0] ifNone: [42]) equals: 42
    self deny: (self.empty anySatisfy: [:x | x > 0])
    self assert: (self.empty allSatisfy: [:x | x > 0])
