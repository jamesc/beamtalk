TestCase subclass: ActorDelegateTest
  field: counter = nil

  setUp => self withCounter: Counter spawn

  tearDown => self.counter isNil ifFalse: [self.counter stop]

  testDelegateOnNonNativeActorRaisesError =>
    self should: [self.counter delegate] raise: #signal

  testDelegateRespondsTo =>
    self assert: (self.counter respondsTo: #delegate)
