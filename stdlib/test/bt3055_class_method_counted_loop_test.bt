// BT-3055: `^` inside a `to:do:` counted loop in a class method used to fail
// to compile with `{core_lint, {unbound_var, 'State', ...}}` — the counted
// loop's map-accumulator packing hardcoded `State` as its base without
// checking whether the enclosing method was a class method (which has no
// `State` parameter). See fixtures/bt3055_ancestor.bt and
// fixtures/bt3055_child.bt.

TestCase subclass: BT3055ClassMethodCountedLoopTest

  testCountedLoopWithEarlyReturnInClassMethodCompilesAndRuns =>
    self assert: BT3055Child run equals: #FromAncestor
