// BT-3755 (ADR 0131 §6): the Expected answers of the actor self-send shapes in
// fixtures/adr0131section6callee_actor_pending.bt.pending, which are §6 compile
// errors until the callee-side `{Result, StateAcc}` protocol (BT-3742) lets a
// callee hand the write back. Inert: the runner discovers only `.bt`.

TestCase subclass: Adr0131Section6CalleePendingTest

  testProbeDo =>
    self assert: (Adr0131Section6CalleePending spawn) probeDo equals: 1

  testProbeCond =>
    self assert: (Adr0131Section6CalleePending spawn) probeCond equals: 1

  testProbeOperand =>
    self assert: (Adr0131Section6CalleePending spawn) probeOperand equals: 1

  testProbeNested =>
    self assert: (Adr0131Section6CalleePending spawn) probeNested equals: 1
