// Number methods tests - rounding, predicates, comparisons (migrated from bootstrap/float.bt BT-827)

TestCase subclass: NumberMethodsTest

  testFloatRounded =>
    // rounded — round to nearest integer
    self assert: 3.14 rounded equals: 3
    self assert: 3.75 rounded equals: 4

  testFloatCeiling =>
    // ceiling — smallest integer >= value
    self assert: 3.14 ceiling equals: 4

  testFloatFloor =>
    // floor — largest integer <= value
    self assert: 3.75 floor equals: 3

  testFloatTruncated =>
    // truncated — toward zero
    self assert: 3.75 truncated equals: 3
    self assert: -3.75 truncated equals: -3

  testNegativeRoundingEdgeCases =>
    self assert: -3.14 rounded equals: -3
    self assert: -3.75 rounded equals: -4
    self assert: -3.14 ceiling equals: -3
    self assert: -3.75 floor equals: -4

  testIntegerRoundedIsIdentity =>
    self assert: 42 rounded equals: 42
    self assert: -7 rounded equals: -7
    self assert: 0 rounded equals: 0

  testIntegerCeilingIsIdentity =>
    self assert: 42 ceiling equals: 42
    self assert: -7 ceiling equals: -7
    self assert: 0 ceiling equals: 0

  testIntegerFloorIsIdentity =>
    self assert: 42 floor equals: 42
    self assert: -7 floor equals: -7
    self assert: 0 floor equals: 0

  testIntegerTruncatedIsIdentity =>
    self assert: 42 truncated equals: 42
    self assert: -7 truncated equals: -7
    self assert: 0 truncated equals: 0

  testIntegerRespondsToRoundingMethods =>
    self assert: (42 respondsTo: #ceiling)
    self assert: (42 respondsTo: #floor)
    self assert: (42 respondsTo: #rounded)
    self assert: (42 respondsTo: #truncated)

  testFloatIsZero =>
    self assert: 0.0 isZero
    self deny: 3.14 isZero

  testFloatIsPositive =>
    self assert: 3.14 isPositive
    self deny: -2.5 isPositive

  testFloatIsNegative =>
    self assert: -2.5 isNegative
    self deny: 3.14 isNegative

  testIntegerIsZero =>
    self assert: 0 isZero
    self deny: 5 isZero

  testIntegerIsPositive => self assert: 5 isPositive

  testIntegerIsNegative => self assert: -3 isNegative

  testFloatNegated => self assert: 3.14 negated equals: -3.14

  testFloatAbs => self assert: -3.14 abs equals: 3.14

  testFloatMinMax =>
    self assert: (3.14 min: 2.71) equals: 2.71
    self assert: (3.14 max: 2.71) equals: 3.14

  // BT-3594 (ADR 0127 §9): Integer/Float min:/max: used to be duplicated
  // verbatim; both now inherit one copy from Number (plain inheritance, not
  // `uses: Comparable` — see comparable.bt's own doc for why Number opts
  // out of the trait).
  testIntegerMinMax =>
    self assert: (3 min: 7) equals: 3
    self assert: (10 min: 2) equals: 2
    self assert: (3 max: 7) equals: 7
    self assert: (10 max: 2) equals: 10

  testMixedIntegerFloatMinMaxCarriesArgumentRuntimeType =>
    // Return type is Number; the smaller/larger *argument*'s own runtime
    // type is what comes back — unaffected by the Integer/Float -> Number
    // move (both still resolve `min:`/`max:` to the exact same method).
    self assert: (3 min: 2.5) class equals: Float
    self assert: (3 max: 3.5) class equals: Float
    self assert: (Integer usesProtocol: #Comparable) equals: false
    self assert: (Float usesProtocol: #Comparable) equals: false
    self assert: (Number usesProtocol: #Comparable) equals: false

  testFloatAsInteger =>
    // asInteger (truncates)
    self assert: 3.75 asInteger equals: 3

  testFloatAsString => self assert: 3.14 asString equals: "3.14"

  testFloatIsNaN => self deny: 3.14 isNaN

  testFloatIsInfinite => self deny: 3.14 isInfinite

  testIntegerSign =>
    self assert: 5 sign equals: 1
    self assert: -3 sign equals: -1
    self assert: 0 sign equals: 0

  testIntegerBetween =>
    self assert: (5 between: 1 and: 10)
    self deny: (15 between: 1 and: 10)

  testFloatSign =>
    self assert: 3.14 sign equals: 1
    self assert: -2.5 sign equals: -1

  testFloatBetween => self assert: (3.14 between: 1.0 and: 5.0)

  testRespondsToSign =>
    self assert: (42 respondsTo: #sign)
    self assert: (3.14 respondsTo: #sign)

  testRespondsToBetweenAnd =>
    self assert: (42 respondsTo: #between:and:)
    self assert: (3.14 respondsTo: #between:and:)

  testSquared =>
    self assert: 5 squared equals: 25
    self assert: -3 squared equals: 9
    self assert: 2.5 squared equals: 6.25

  testReciprocal =>
    self assert: 4 reciprocal equals: 0.25
    self assert: 0.5 reciprocal equals: 2.0
    // reciprocal of zero is a domain error (raw badarith)
    self should: [0 reciprocal] raise: #badarith

  testRoundTo =>
    self assert: (42 roundTo: 5) equals: 40
    self assert: (43 roundTo: 5) equals: 45
    self assert: (-7 roundTo: 5) equals: -5
    self assert: (3.14159 roundTo: 0.5) equals: 3.0
    // Float quantum on an Integer promotes the result to Float
    self assert: (42 roundTo: 0.5) equals: 42.0

  testTruncateTo =>
    self assert: (47 truncateTo: 10) equals: 40
    self assert: (-47 truncateTo: 10) equals: -40
    self assert: (3.78 truncateTo: 0.5) equals: 3.5
    self assert: (-3.78 truncateTo: 1.0) equals: -3.0

  testIsIntegerIsFloat =>
    self assert: 5 isInteger
    self deny: 5 isFloat
    self assert: 5.0 isFloat
    self deny: 5.0 isInteger
