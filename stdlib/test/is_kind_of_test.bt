// Tests for Object >> isKindOf: (BT-1229)

TestCase subclass: IsKindOfTest

  testIntegerIsKindOfInteger => self assert: (42 isKindOf: Integer)

  testIntegerIsKindOfObject => self assert: (42 isKindOf: Object)

  testSymbolIsKindOfSymbol => self assert: (#foo isKindOf: Symbol)

  testSymbolIsNotKindOfString => self deny: (#foo isKindOf: String)

  testListIsKindOfList => self assert: (#() isKindOf: List)

  testListIsKindOfObject => self assert: (#() isKindOf: Object)

  testStringIsKindOfString => self assert: ("hello" isKindOf: String)

  testStringIsKindOfObject => self assert: ("hello" isKindOf: Object)

  testIntegerIsNotKindOfString => self deny: (42 isKindOf: String)

  testFloatIsKindOfFloat => self assert: (3.14 isKindOf: Float)

  testFloatIsKindOfObject => self assert: (3.14 isKindOf: Object)

  testTrueIsKindOfBoolean => self assert: (true isKindOf: Boolean)

  testFalseIsKindOfBoolean => self assert: (false isKindOf: Boolean)

  // --- BT-2194/BT-2217: class-object receivers walk the parallel metaclass chain ---

  // Class is an instance of its metaclass — NOT of its instance-side superclass.
  // Integer is an instance of `Integer class`, whose parallel chain is
  // [Number class, Object class, ProtoObject class] — Number is not in it.
  testClassNotKindOfInstanceSuperclass =>
    self deny: (Integer isKindOf: Number)
    self deny: (Counter isKindOf: Actor)

  // BT-2217: The metaclass tower is grounded — `ProtoObject class superclass`
  // is `Class`, so the parallel chain merges into `Class → Behaviour → Object
  // → ProtoObject`. `Integer isKindOf: Object` and `Integer isKindOf: Class`
  // therefore both hold, matching Pharo and the dispatch chain (which already
  // routes through `Class`/`Behaviour`/`Object` for metaclass receivers).
  testClassIsKindOfObject =>
    self assert: (Integer isKindOf: Object)
    self assert: (Counter isKindOf: Object)

  testClassIsKindOfClass =>
    self assert: (Integer isKindOf: Class)
    self assert: (Counter isKindOf: Class)
    self assert: (Integer isKindOf: Behaviour)

  // A class IS a kind of the metaclass of its superclass.
  testClassIsKindOfSuperclassMetaclass =>
    self assert: (Integer isKindOf: Number class)
    self assert: (Counter isKindOf: Actor class)

  // --- BT-2194: inheritsFrom: / includesBehaviour: on metaclass receivers ---

  // `Counter class` is a metaclass. Its parallel chain walks through
  // [Actor class, Object class, ProtoObject class].
  testMetaclassInheritsFromParentMetaclass =>
    self assert: (Counter class inheritsFrom: Actor class)
    self assert: (Counter class inheritsFrom: Object class)
    self deny: (Counter class inheritsFrom: Counter class)

  // BT-2217: With the grounded chain, a metaclass DOES inherit from the
  // instance-side `Class`/`Behaviour`/`Object`/`ProtoObject`. It still does
  // not inherit from sibling instance-side classes like `Counter` or `Actor`.
  testMetaclassDoesNotInheritFromInstanceSiblings =>
    self deny: (Counter class inheritsFrom: Counter)
    self deny: (Counter class inheritsFrom: Actor)

  testMetaclassInheritsFromGroundedInstanceTower =>
    self assert: (Counter class inheritsFrom: Class)
    self assert: (Counter class inheritsFrom: Behaviour)
    self assert: (Counter class inheritsFrom: Object)
    self assert: (Counter class inheritsFrom: ProtoObject)

  testMetaclassIncludesBehaviourMetaclass =>
    self assert: (Counter class includesBehaviour: Counter class)
    self assert: (Counter class includesBehaviour: Actor class)
    self assert: (Counter class includesBehaviour: Object class)
    self deny: (Counter class includesBehaviour: Integer class)

  // --- BT-2194/BT-2217: allSuperclasses returns the grounded chain for metaclass receivers ---
  testMetaclassAllSuperclassesReturnsGroundedChain =>
    // Parallel chain: [Actor class, Object class, ProtoObject class]
    // then grounded: [Class, Behaviour, Object, ProtoObject]
    chain := Counter class allSuperclasses
    self assert: chain size equals: 7
    self assert: chain first == Actor class
    self assert: chain last == ProtoObject
    // Parallel chain members
    self assert: (chain includes: Actor class)
    self assert: (chain includes: Object class)
    self assert: (chain includes: ProtoObject class)
    // Grounded instance-side members
    self assert: (chain includes: Class)
    self assert: (chain includes: Behaviour)
    self assert: (chain includes: Object)
    self assert: (chain includes: ProtoObject)
    // Sibling instance-side classes are NOT in the chain.
    self deny: (chain includes: Counter)
    self deny: (chain includes: Actor)

  testObjectClassAllSuperclassesIsGrounded =>
    // `Object class` parallel chain is `[ProtoObject class]` then grounds
    // into `[Class, Behaviour, Object, ProtoObject]`.
    chain := Object class allSuperclasses
    self assert: chain size equals: 5
    self assert: chain first == ProtoObject class
    self assert: chain last == ProtoObject
    self assert: (chain includes: Class)

  // --- BT-4065: isKindOf: is answered from the class table in the caller ---

  // `isKindOf:` no longer sends `includesBehaviour:` to the receiver's class
  // process; it must still give the answer that send gives, for instances,
  // class objects and metaclass objects against classes and metaclasses.
  testIsKindOfAgreesWithIncludesBehaviour =>
    counter := Counter spawn
    receivers := #(42, nil, "s", #sym, 3.5, true, #(), (Result ok: 1), counter, Integer, Counter, Result, Counter class, Integer class, Metaclass)
    args := #(Integer, Number, Object, ProtoObject, Class, Behaviour, Metaclass, Actor, Counter, Result, Value, Exception, UndefinedObject, Number class, Actor class, Object class, ProtoObject class, Counter class, Result class)
    receivers
      do: [:r |
        args do: [:a |
          self assert: (r isKindOf: a) equals: (r class includesBehaviour: a)
        ]
      ]
    counter stop

  testValueAndActorInstances =>
    counter := Counter spawn
    self assert: ((Result ok: 1) isKindOf: Result)
    self assert: ((Result ok: 1) isKindOf: Value)
    self deny: ((Result ok: 1) isKindOf: Exception)
    self assert: (counter isKindOf: Counter)
    self assert: (counter isKindOf: Actor)
    self deny: (counter isKindOf: Counter class)
    counter stop

  testNilIsKindOf =>
    self assert: (nil isKindOf: UndefinedObject)
    self assert: (nil isKindOf: Object)
    self deny: (nil isKindOf: Exception)

  // --- BT-4221: built-in classes answered from a memoised decision ---

  // Repeated checks (the second is a cache hit) agree with the first, and a
  // bare binary — valid UTF-8 or not — is a Binary, never a String.
  testBuiltinIsKindOfRepeated =>
    invalid := Binary fromBytes: #(255, 254)
    valid := Binary fromBytes: #(104, 105)
    2
      timesRepeat: [
        self assert: ("hi" isKindOf: String)
        self assert: ("hi" isKindOf: Binary)
        self deny: (invalid isKindOf: String)
        self assert: (invalid isKindOf: Binary)
        self deny: (valid isKindOf: String)
        self assert: (valid isKindOf: Binary)
        self deny: (42 isKindOf: String)
        self assert: (#(1) isKindOf: List)
        self deny: (#(1) isKindOf: List class)
      ]

  // A non-class argument takes the original `includesBehaviour:` route.
  testNonClassArgumentIsFalse =>
    @expect type
    self deny: (42 isKindOf: 42)
    @expect type
    self deny: (42 isKindOf: #Integer)
