// BT-3756 (ADR 0131 §6): a block that writes no local of the enclosing method
// still works when it escapes the method (returned, stored in a field, placed
// in a collection literal). Only a block that writes an outer local is a
// compile error there (Rust tests, `ESCAPE_SHAPES`).

TestCase subclass: Adr0131Section6EscapeTest

  testActorPure =>
    self assert: (Adr0131Section6EscapeActor spawn returnedPure value: 1) equals: 2

  testActorOwnLocal =>
    self assert: (Adr0131Section6EscapeActor spawn returnedOwnLocal value: 3) equals: 7

  testActorReadOnly =>
    self assert: (Adr0131Section6EscapeActor spawn returnedReadOnly value: 1) equals: 11

  testActorStoredFieldWriter =>
    a := Adr0131Section6EscapeActor spawn
    a storedFieldWriter
    a runStored
    a runStored
    self assert: a count equals: 2

  testClassPure =>
    self assert: (Adr0131Section6EscapeClass returnedPure value: 1) equals: 2

  testClassOwnLocal =>
    self assert: (Adr0131Section6EscapeClass returnedOwnLocal value: 3) equals: 7

  testClassReadOnly =>
    self assert: (Adr0131Section6EscapeClass returnedReadOnly value: 1) equals: 11

  testClassLiteral =>
    self assert: (Adr0131Section6EscapeClass literalOfPure last value: 4) equals: 8

  testValuePure =>
    self assert: (Adr0131Section6EscapeValue new returnedPure value: 1) equals: 2

  testValueOwnLocal =>
    self assert: (Adr0131Section6EscapeValue new returnedOwnLocal value: 3) equals: 7

  testValueReadOnly =>
    self assert: (Adr0131Section6EscapeValue new returnedReadOnly value: 1) equals: 11

  testValueLiteral =>
    self assert: (Adr0131Section6EscapeValue new literalOfPure first value: 4) equals: 5

  // BT-3859: a method whose last statement is a local assignment answers the
  // assigned value in a class or value-type method. An actor method answers
  // `nil` there today, a bug tracked in BT-3882 (pinned below), so ADR 0131
  // §6 reports a Tier 2 block there as dropped in an actor rather than
  // returned. An assignment that is the last statement of a conditional arm
  // answers the value in all three.
  testLastStatementAssignmentAnswersClass =>
    self assert: Adr0131Section6EscapeClass lastStatementAssignment equals: 5
    self assert: (Adr0131Section6EscapeClass lastStatementBlockAssignment value: 1) equals: 2
    self assert: (Adr0131Section6EscapeClass lastStatementArmAssignment: true) equals: 7

  testLastStatementAssignmentAnswersValue =>
    v := Adr0131Section6EscapeValue new
    self assert: v lastStatementAssignment equals: 5
    self assert: (v lastStatementBlockAssignment value: 1) equals: 2
    self assert: (v lastStatementArmAssignment: true) equals: 7

  testLastStatementAssignmentAnswersActor =>
    a := Adr0131Section6EscapeActor spawn
    // PIN-BUG BT-3882: correct answer 5.
    self assert: a lastStatementAssignment equals: nil
    // PIN-BUG BT-3882: correct answer the block (`value: 1` answers 2).
    self assert: a lastStatementBlockAssignment equals: nil
    self assert: (a lastStatementArmAssignment: true) equals: 7
