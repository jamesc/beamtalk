// Stdlib tests for Regex class (BT-709, updated for ADR 0060 Result migration BT-1256)

TestCase subclass: RegexTest

  testRegexConstruction =>
    self assert: (Regex from: "[0-9]+") unwrap class equals: Regex
    // Source returns the original pattern
    self assert: (Regex from: "[0-9]+") unwrap source equals: "[0-9]+"
    // Compile with options
    self assert: (Regex from: "[a-z]+" options: #(#caseless)) unwrap class equals: Regex

  // BT-2998: a Regex wraps a compiled `re` MP term, so the inherited
  // `basicNew` had nothing to build it from and produced a hollow instance.
  testBareNewIsDisabled =>
    // Rejected at compile time; @expect keeps that diagnostic from failing the
    // build so the runtime guard (for dynamic sends) can be exercised too.
    @expect type
    self should: [Regex new] raise: #instantiation_error
    // The keyword form has refused all along; both now agree.
    self should: [Regex new: 5] raise: #user_error

  testStringMatchesregexWithStringPatterns =>
    // Simple digit match
    self assert: ("hello123" matchesRegex: "[0-9]+")
    // Full string match fails
    self deny: ("hello123" matchesRegex: "^[0-9]+$")
    // Full string match succeeds
    self assert: ("12345" matchesRegex: "^[0-9]+$")
    // Letters only
    self assert: ("hello" matchesRegex: "^[a-z]+$")
    // No match
    self deny: ("hello" matchesRegex: "[0-9]+")

  testStringMatchesregexWithCompiledRegexObjects =>
    // Match with compiled regex
    self assert: ("hello123" matchesRegex: (Regex from: "[0-9]+") unwrap)
    // No match with compiled regex
    self deny: ("hello" matchesRegex: (Regex from: "[0-9]+") unwrap)

  testStringMatchesregexOptions =>
    // Case-insensitive matching
    self assert: ("Hello" matchesRegex: "^[a-z]+$" options: #(#caseless))
    // Without caseless, fails
    self deny: ("Hello" matchesRegex: "^[a-z]+$")

  testStringFirstmatch =>
    // First match returns the matched string
    self assert: ("hello123world456" firstMatch: "[0-9]+") equals: "123"
    // No match returns nil
    self assert: ("hello" firstMatch: "[0-9]+") equals: nil
    // First match with compiled regex
    self assert: ("abc42def" firstMatch: (Regex from: "[0-9]+") unwrap) equals: "42"

  testStringAllmatches =>
    // All matches returns list of matched strings
    self assert: ("a1b2c3" allMatches: "[0-9]+") equals: #("1", "2", "3")
    // No matches returns empty list
    self assert: ("hello" allMatches: "[0-9]+") equals: #()
    // All matches with compiled regex
    self assert: ("x10y20z30" allMatches: (Regex from: "[0-9]+") unwrap) equals: #("10", "20", "30")
    // Single match returns single-element list
    self assert: ("abc123def" allMatches: "[0-9]+") equals: #("123")

  testStringReplaceregexWith =>
    // Replace first match
    self assert: ("hello world" replaceRegex: "[aeiou]" with: "*") equals: "h*llo world"
    // No match leaves string unchanged
    self assert: ("hello" replaceRegex: "[0-9]+" with: "X") equals: "hello"
    // Replace first match with compiled regex
    self assert: ("abc123def456" replaceRegex: (Regex from: "[0-9]+") unwrap with: "NUM") equals: "abcNUMdef456"

  testStringReplaceallregexWith =>
    // Replace all matches
    self assert: ("hello world" replaceAllRegex: "[aeiou]" with: "*") equals: "h*ll* w*rld"
    // No match leaves string unchanged
    self assert: ("hello" replaceAllRegex: "[0-9]+" with: "X") equals: "hello"
    // Replace all with compiled regex
    self assert: ("a1b2c3" replaceAllRegex: (Regex from: "[0-9]+") unwrap with: "N") equals: "aNbNcN"

  testStringSplitregex =>
    // Split on one or more commas
    self assert: ("a,,b,,,c" splitRegex: ",+") equals: #("a", "b", "c")
    // Split on whitespace
    self assert: ("hello   world   test" splitRegex: " +") equals: #("hello", "world", "test")
    // Split with compiled regex
    self assert: ("a1b2c3" splitRegex: (Regex from: "[0-9]+") unwrap) equals: #("a", "b", "c")

  testErrorHandling =>
    // Invalid regex pattern returns a Result error with regex_error kind
    result := Regex from: "[invalid"
    self deny: result isOk
    // Invalid pattern in String method still raises regex_error
    self should: ["hello" matchesRegex: "[invalid"] raise: #regex_error

  // BT-4236: an invalid pattern keeps re:compile's {ErrStr, Pos} as reason,
  // the same term the FFI call `Erlang re compile:` answers
  testInvalidPatternKeepsCompileReason =>
    reason := (Regex from: "(") error reason
    self assert: reason class equals: Tuple
    @expect type
    self assert: (reason at: 2) equals: 1
    @expect type
    self assert: ((Regex from: "(" options: #(#caseless)) error reason at: 2) equals: 1
    @expect type
    self assert: ([
      "hello" matchesRegex: "("
    ] on: Error do: [:e | e reason at: 2]) equals: 1
    // element 1 is OTP's charlist (a List), not a String
    @expect type
    self assert: (reason at: 1) class equals: List
    // invalid only under the caller's options: `#` starts a comment in extended mode
    @expect type
    self
      assert: ([
        "x" matchesRegex: "(#)" options: #(#extended)
      ] on: Error do: [:e | e reason at: 2])
      equals: 3

  // BT-3271: from:options: error path when pattern is invalid
  testFromOptionsErrorPath =>
    result := Regex from: "[invalid" options: #(#caseless)
    self deny: result isOk

  // BT-3271: allMatches: no-match path with a compiled Regex object
  testAllMatchesNoMatchWithCompiledRegex =>
    digitRegex := (Regex from: "[0-9]+") unwrap
    self assert: ("hello" allMatches: digitRegex) equals: #()

  // BT-3271: translate_option/1 for dotall, extended, ungreedy arms
  testRegexOptionsDotatExtendedUngreedy =>
    self assert: (Regex from: "." options: #(#dotall)) isOk
    self assert: (Regex from: "a b" options: #(#extended)) isOk
    self assert: (Regex from: "a+" options: #(#ungreedy)) isOk

  // BT-5030: String regexes compile in Unicode mode ([unicode, ucp]), so `.`
  // matches one character, `\w`/`\b` see non-ASCII letters and caseless
  // matching folds non-ASCII case. (Bare Erlang binaries keep byte semantics.)
  testNonAsciiDotMatchesOneCharacter =>
    self assert: ("héllo" allMatches: ".") equals: #("h", "é", "l", "l", "o")
    self assert: ("héllo" replaceAllRegex: "." with: "x") equals: "xxxxx"
    self assert: ("héllo" firstMatch: "h.l") equals: "hél"
    self assert: ("héllo" replaceRegex: "." with: "x") equals: "xéllo"
    self assert: ("日本語" splitRegex: "本") equals: #("日", "語")

  testNonAsciiWordCharacters =>
    self assert: ("héllo wörld" allMatches: "\\w+") equals: #("héllo", "wörld")
    self assert: ("héllo" matchesRegex: "^\\w+$")
    self assert: ("héllo wörld" allMatches: "\\b\\w") equals: #("h", "w")

  testNonAsciiCaselessMatching =>
    self assert: ("ÉCOLE" matchesRegex: "^école$" options: #(#caseless))
    self assert: ("ÉCOLE" matchesRegex: (Regex from: "école" options: #(#caseless)) unwrap)
    self deny: ("ÉCOLE" matchesRegex: "^école$")

  testNonAsciiCompiledRegex =>
    dots := (Regex from: ".") unwrap
    self assert: ("héllo" allMatches: dots) size equals: 5
    self assert: ("héllo" replaceAllRegex: dots with: "-") equals: "-----"
