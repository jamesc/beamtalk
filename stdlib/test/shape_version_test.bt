// BT-3537 (ADR 0123 Phase 3): shapeVersion:/migrateFromVN: language surface —
// Behaviour >> shapeVersion, Behaviour >> migrateShape:from: (the sealed
// wrapper over beamtalk_shape_migration:migrate/3), and a real
// migrateFromVN: hook on a Value class (no live process for its instances).
//
// Fixture: stdlib/test/fixtures/shape_version_money.bt (ShapeVersionMoney)
//
// BT-3541 regression: ShapeVersionDictSend's migrateFromV1: (fixture:
// stdlib/test/fixtures/shape_version_dict_send.bt) sends Dictionary
// at:/at:put:/removeKey: directly to its `old` parameter instead of
// routing around them via the Erlang FFI gateway (ShapeVersionMoney's own
// BT-3541 workaround) — a dynamically-dispatched send the compiler cannot
// statically resolve, which used to raise `undef` for an @primitive-only
// class like Dictionary. No longer reproduces (every value-type class,
// @primitive-only or not, compiles a real `dispatch/3`), but this test
// pins the behaviour down so it can't silently regress.

TestCase subclass: ShapeVersionTest
  field: cls = nil

  tearDown => self.cls isNil ifFalse: [self.cls removeFromSystem]

  testShapeVersionDefaultsToOneWhenUndeclared =>
    // Object declares no shapeVersion: clause.
    self assert: Object shapeVersion equals: 1

  testDeclaredShapeVersion =>
    self assert: ShapeVersionMoney shapeVersion equals: 2

  testMigrateFromV1DirectCall =>
    // migrateFromV1: is an ordinary class-side method — callable directly,
    // no process needed (ADR 0123 §2's "REPL-testable" promise).
    old := #{#cents => 250, #currency => #USD}
    migrated := ShapeVersionMoney migrateFromV1: old
    self assert: (migrated at: #amount) equals: 2.5
    self deny: (migrated includesKey: #cents)

  testMigrateShapeFromRunsFullChainAndReconciles =>
    old := #{#cents => 500}
    migrated := ShapeVersionMoney migrateShape: old from: 1
    self assert: (migrated at: #amount) equals: 5.0
    self assert: (migrated at: #currency) equals: #USD
    self deny: (migrated includesKey: #cents)

  testMigrateShapeFromIsIdempotentAtCurrentVersion =>
    current := #{#amount => 9.99, #currency => #EUR}
    migrated := ShapeVersionMoney migrateShape: current from: 2
    self assert: migrated equals: current

  testMigrateShapeFromRunsRealChainWithDirectDictionarySends =>
    // BT-3541: old at:/at:put:/removeKey: sent directly (see fixture
    // comment) — through the real migrateShape:from: chain, i.e. via
    // local_call/3, not a direct migrateFromV1: call like the test above.
    old := #{#cents => 500}
    migrated := ShapeVersionDictSend migrateShape: old from: 1
    self assert: (migrated at: #amount) equals: 5.0
    self deny: (migrated includesKey: #cents)

  // ADR 0123 §1: `ClassBuilder shapeVersion:` — the programmatic
  // counterpart, no compiled `.bt` source at all. `Behaviour >> shapeVersion`
  // reads the class gen_server's own seeded field, not `__beamtalk_meta/0`
  // (which a ClassBuilder-only class never exports), so this exercises a
  // different code path than the compiled-class tests above.
  testClassBuilderShapeVersionKeyword =>
    Object classBuilder name: #BT3537ShapeVersionBuilderClass;
      superclass: Object;
      shapeVersion: 3;
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT3537ShapeVersionBuilderClass
    self assert: self.cls shapeVersion equals: 3

  // BT-3556 (ADR 0124 Section 8/B9): fixture: shape_version_late_slot.bt
  // (ShapeVersionLateSlot). A declared-but-never-assigned `late` slot
  // (`proc`) is absent from `old`, not `nil` and not a reconcile failure —
  // it simply stays absent from the migrated dictionary; `flag` (an
  // ordinary eager field with a default) is unaffected.
  testMigrateShapeFromLeavesAnAbsentLateSlotAbsent =>
    migrated := ShapeVersionLateSlot migrateShape: #{} from: 1
    self deny: (migrated includesKey: #proc)
    self assert: (migrated at: #flag) equals: "absent"

  // The `migrateFromV1:` hook reads `proc` (the `late` slot) with
  // `at:ifAbsent:` — the acceptance-criteria pin that a `late` slot's
  // absence needs no new hook contract, just the same guard any other
  // possibly-absent key already needs. This exercises the *present*
  // branch of that same `at:ifAbsent:` read, through the real chain
  // (`local_call/3`), not a direct `migrateFromV1:` call.
  testMigrateShapeFromKeepsAPresentLateSlotAndRunsTheHookOverIt =>
    old := #{#proc => "/bin/bash"}
    migrated := ShapeVersionLateSlot migrateShape: old from: 1
    self assert: (migrated at: #proc) equals: "/bin/bash"
    self assert: (migrated at: #flag) equals: "/bin/bash"
