// BT-4409 / ADR 0142 rule 3: the BT-4099 constructor fast path runs behind
// the same run-time guard as every other class send. A static `X new`
// compiles to the BT-4316 static call key `{Module, new, Tag}`; a dynamic
// `new`/`new:` asks `beamtalk_class_dispatch:lookup_direct_constructor/3`,
// which needs `direct_call_ok/2` and, for `new:`, an ancestor chain with no
// user class-side `new:` (decided at run time from the facts the ancestors
// publish). So a class-side extension or runtime fun of `new` installed after
// warm-up is honoured, and so is an ancestor's `new:` installed after a
// descendant warmed its direct `new:`.
//
// Fixtures: fixtures/gc_ext_point.bt, fixtures/gc_fun_point.bt,
// fixtures/gc_base.bt, fixtures/gc_leaf.bt.

TestCase subclass: GuardedConstructorTest

  // The class held as a Dynamic value: sends to it compile to `class_send`.
  lookUp: name :: Symbol -> Dynamic => Beamtalk classNamed: name

  // A class-side extension of `new` registered after warm-up wins, for the
  // static send and the dynamic one.
  testNewExtensionRegisteredAfterWarmUpWins =>
    self assert: GcExtPoint new x equals: 0
    self assert: (self lookUp: #GcExtPoint) new x equals: 0
    Erlang beamtalk_extensions
      register: #'GcExtPoint class'
      selector: #new
      fun: [:args :receiver | #extension]
      owner: #test
    literal := GcExtPoint new
    dynamic := (self lookUp: #GcExtPoint) new
    Erlang beamtalk_extensions
      unregister: #GcExtPoint
      selector: #new
      classSide: true
    self assert: literal equals: #extension
    self assert: dynamic equals: #extension
    self assert: GcExtPoint new x equals: 0

  // An ADR 0084 runtime fun of `new` installed after warm-up wins.
  testNewRuntimeFunAfterWarmUpWins =>
    self assert: GcFunPoint new x equals: 0
    self assert: (self lookUp: #GcFunPoint) new x equals: 0
    pid := Erlang beamtalk_class_registry whereis_class: #GcFunPoint
    @expect type
    Erlang beamtalk_object_class
      put_class_method: pid
      selector: #new
      fun: [:classSelf | #fromRuntimeFun]
    self assert: GcFunPoint new equals: #fromRuntimeFun
    self assert: (self lookUp: #GcFunPoint) new equals: #fromRuntimeFun
    @expect type
    removed := Erlang beamtalk_object_class remove_class_method: pid selector: #new
    self assert: removed equals: #removed
    self assert: GcFunPoint new x equals: 0

  // An ancestor that gains a user class-side `new:` after a descendant
  // warmed its direct `new:` is honoured by the descendant's dynamic `new:`
  // at once, with no recompile of the descendant.
  testAncestorNewInitAfterWarmUpWins =>
    leaf := self lookUp: #GcLeaf
    self assert: (leaf new: #{#x => 1}) x equals: 1
    pid := Erlang beamtalk_class_registry whereis_class: #GcBase
    @expect type
    Erlang beamtalk_object_class
      put_class_method: pid
      selector: #new:
      fun: [:classSelf :init | #fromAncestorNewInit]
    self assert: (leaf new: #{#x => 1}) equals: #fromAncestorNewInit
    @expect type
    removed := Erlang beamtalk_object_class remove_class_method: pid selector: #new:
    self assert: removed equals: #removed
    self assert: (leaf new: #{#x => 1}) x equals: 1
