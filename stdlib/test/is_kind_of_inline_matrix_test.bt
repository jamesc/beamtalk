// BT-4764: `x isKindOf: C` for a sealed built-in class literal compiles to
// C's inline type test behind the `isKindOf:` override check (no class
// reference is built on the fast path). For every class the lowering handles,
// the lowered literal must agree with
//   - the dynamic send (`kind:of:` takes the class as a value, so it is never
//     lowered), and
//   - the `x :: C` type pattern, which renders the same strategy,
// over a matrix of every representation: Strings and bare binaries, numbers,
// lists, atoms, nil/true/false, actors, Values, tagged maps and futures, and
// classes and a TestCase instance.
//
// A future is the one value a type pattern and `isKindOf:` treat differently
// by design (the pattern answers `false` without awaiting; `isKindOf:` awaits
// its receiver), so futures are compared against the send only.
//
// `stdlib/test/is_kind_of_inline_matrix_test.bt` must name every class the
// lowering handles: `residual_dynamic_sends::is_kind_of_inline_classes_are_covered_by_the_runtime_matrix`
// (beamtalk-codegen) derives that set from the routing fixture and fails on a
// missing class. The override case cannot run here (installing an
// `isKindOf:` override turns the fast path off node-wide); it is covered by
// the serial `stdlib/test/is_kind_of_inline_override_test.bt` and
// EUnit (`beamtalk_tagged_map_routing_conformance_tests`).
//
// Fixtures: stdlib/test/fixtures/type_pattern_actor_fixture.bt,
//           stdlib/test/fixtures/value_point.bt

TestCase subclass: IsKindOfInlineMatrixTest

  kind: value :: Object of: aClass :: Behaviour -> Boolean =>
    value isKindOf: aClass

  // Everything but futures.
  samples -> List(Object) =>
    #(42, -1, 1.5, "ab", "", #ab, nil, true, false, #(1, 2), #(), [:x |
      x
    ], {1, 2}, {}, (Dictionary new at: #a put: 1), (Dictionary new), $a, (Erlang erlang list_to_binary: #(255)), (Binary fromBytes: #(234)), self unaligned, (Erlang erlang self), (Erlang erlang make_ref), TypePatternActorFixture spawn, (ValuePoint new: #{
      #x => 1,
      #y => 2
    }), Integer, self)

  unaligned =>
    (Binary fromBytes: #(234)) match: [<<_:3, rest/bitstring>> -> rest]

  future => (Erlang beamtalk_future) new

  resolvedFuture =>
    f := self future
    (Erlang beamtalk_future) resolve: f with: 7
    f

  testIntegerAgrees =>
    self samples
      do: [:v |
        self assert: (v isKindOf: Integer) equals: (self kind: v of: Integer)
        self
          assert: (v isKindOf: Integer)
          equals: (v match: [
            x :: Integer -> true;
            _ -> false
          ])
      ]
    self assert: (self resolvedFuture isKindOf: Integer) equals: (self kind: self resolvedFuture of: Integer)

  testFloatAgrees =>
    self samples
      do: [:v |
        self assert: (v isKindOf: Float) equals: (self kind: v of: Float)
        self
          assert: (v isKindOf: Float)
          equals: (v match: [
            x :: Float -> true;
            _ -> false
          ])
      ]
    self assert: (self resolvedFuture isKindOf: Float) equals: (self kind: self resolvedFuture of: Float)

  testStringAgrees =>
    self samples
      do: [:v |
        self assert: (v isKindOf: String) equals: (self kind: v of: String)
