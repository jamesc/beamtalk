// BUnit live-behaviour tests for the class-side `Beamtalk` facade
// (ADR 0129 Phase 1). `Beamtalk` is a sealed, stateless class, so these sends
// work under `beamtalk test` (no workspace binding required).
//
// Covers: version, allClasses, classNamed:, help:, help:selector:,
// erlangHelp:, logLevel/logFormat/debugTargets, and the absence of the
// removed `current`/`globals` API.

TestCase subclass: BeamtalkInterfaceTest

  testClassNamedFindsIntegerClass =>
    self assert: (Beamtalk classNamed: #Integer) equals: Integer

  testClassNamedUnknownIsNil =>
    self assert: (Beamtalk classNamed: #NoSuchClassAnywhere) isNil

  testAllClassesIncludesIntegerAndBeamtalk =>
    classes := Beamtalk allClasses
    self assert: (classes includes: Integer)
    self assert: (classes includes: Beamtalk)

  testVersionIsNonEmptyString =>
    self assert: (Beamtalk version isKindOf: String)
    self assert: Beamtalk version isEmpty not

  testHelpMentionsClassName =>
    self assert: ((Beamtalk help: Integer) includesSubstring: "Integer")

  testHelpSelectorReturnsString =>
    self assert: ((Beamtalk help: Integer selector: #'+') isKindOf: String)

  testErlangHelpReturnsString =>
    self assert: ((Beamtalk erlangHelp: "lists") isKindOf: String)

  testLogLevelReturnsSymbol => self assert: (Beamtalk logLevel isKindOf: Symbol)

  testLogFormatIsTextOrJson =>
    fmt := Beamtalk logFormat
    self assert: ((fmt == #text) or: [fmt == #json])

  testDebugTargetsIsList => self assert: (Beamtalk debugTargets isKindOf: List)

  testReleaseInfoIsDictionary =>
    self assert: (Beamtalk releaseInfo isKindOf: Dictionary)

  testInheritsFromObject => self assert: (Beamtalk inheritsFrom: Object)

  testCurrentAndGlobalsAreRemoved =>
    self deny: (Beamtalk class includesSelector: #current)
    self deny: (Beamtalk class includesSelector: #globals)
    self deny: (Beamtalk class includesSelector: #resetCurrent)
