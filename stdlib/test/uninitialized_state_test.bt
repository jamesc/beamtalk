// Tests for BT-1949: UninitializedStateError after Actor initialize.
//
// Fixtures:
//   stdlib/test/fixtures/typed_no_default_actor.bt   (properly initializes)
//   stdlib/test/fixtures/uninitialized_state_actor.bt (forgets to initialize)
//
// Also covers BT-3546 (ADR 0124 §7 A1) — the reimplemented, alias-aware
// definite-assignment predicate:
//   stdlib/test/fixtures/json_value_state_actor.bt (alias-typed, expands to nilable)
//   stdlib/test/fixtures/undefined_object_union_state_actor.bt (UndefinedObject spelling)
//
// Also covers BT-3563 — fixture-internal type-alias pre-loading in
// `beamtalk test` (an alias declared in one fixtures/*.bt file, referenced
// as a declared field type from a *different* fixture file):
//   stdlib/test/fixtures/local_json_value_alias.bt (declares LocalJsonValue)
//   stdlib/test/fixtures/local_json_value_state_actor.bt (references it cross-file)

TestCase subclass: UninitializedStateTest

  // === Success: typed-no-default field properly initialized ===
  testTypedNoDefaultFieldInitialized =>
    a := TypedNoDefaultActor spawn
    self assert: a getLabel equals: "initialized"

  testTypedNoDefaultFieldWithDefaultWorks =>
    a := TypedNoDefaultActor spawn
    self assert: a getCount equals: 0

  // === Failure: typed-no-default field left nil ===
  //
  // BT-1948 (ADR 0124 §6 A2b): `UninitializedStateActor spawn` now ALSO
  // warns at compile time (the point of BT-1948) — `@expect all`
  // acknowledges the diagnostic these tests deliberately trigger, since it
  // has no dedicated `@expect` category by design (ADR 0124 §6:
  // supply/default/widen/`late` are the only accepted fixes for real code).
  testUninitializedTypedFieldRaisesError =>
    @expect all
    self should: [UninitializedStateActor spawn] raise: #instantiation_error

  testUninitializedErrorContainsClassName =>
    @expect all
    result := [UninitializedStateActor spawn] on: Exception do: [:e | e message]
    self assert: (result includesSubstring: "UninitializedStateActor")

  testUninitializedErrorHintContainsFieldName =>
    @expect all
    result := [UninitializedStateActor spawn] on: Exception do: [:e | e hint]
    self assert: (result includesSubstring: "connection")

  testUninitializedErrorHintContainsTypeName =>
    @expect all
    result := [UninitializedStateActor spawn] on: Exception do: [:e | e hint]
    self assert: (result includesSubstring: "String")

  // === Nilable typed-no-default field: nil is valid, no error ===
  testNilAllowedFieldLeftNilSpawnsSuccessfully =>
    a := NilAllowedStateActor spawn
    self assert: a getLabel equals: nil

  testNilAllowedFieldOtherStateWorks =>
    a := NilAllowedStateActor spawn
    self assert: a getCount equals: 1

  // === BT-3546 (ADR 0124 §7 A1): alias-typed field expanding to nilable ===
  // `state: value :: JsonValue` references `stdlib/src/json.bt`'s real
  // `type JsonValue = Nil | Boolean | Integer | Float | String | List |
  // Dictionary` cross-file — a defaultless field of this type must spawn
  // without raising, since the alias resolves to a union containing `Nil`.
  // No `@expect` needed: BT-3561 closed the `beamtalk test` pipeline gap
  // that otherwise made BT-1948's construction-site check see `JsonValue`
  // as an unresolved, non-nilable name and warn.
  testAliasTypedNilableFieldLeftNilSpawnsSuccessfully =>
    a := JsonValueStateActor spawn
    self assert: a getValue equals: nil

  testAliasTypedNilableFieldOtherStateWorks =>
    a := JsonValueStateActor spawn
    self assert: a getCount equals: 1

  // === BT-3563: alias declared in one fixture file, referenced from another ===
  // `state: value :: LocalJsonValue` references
  // `local_json_value_alias.bt`'s `type LocalJsonValue = Nil | Boolean |
  // Integer | Float | String | List | Dictionary`, declared in a *different*
  // fixtures/*.bt file — a defaultless field of this type must spawn without
  // raising, since the alias resolves to a union containing `Nil`. No
  // `@expect` needed: BT-3563 made `build_fixture_class_indexes` pre-load
  // fixture-declared type aliases the same way it already pre-loads
  // fixture-declared `ClassInfo`/`ProtocolInfo`.
  testFixtureAliasTypedNilableFieldLeftNilSpawnsSuccessfully =>
    a := LocalJsonValueStateActor spawn
    self assert: a getValue equals: nil

  testFixtureAliasTypedNilableFieldOtherStateWorks =>
    a := LocalJsonValueStateActor spawn
    self assert: a getCount equals: 1

  // === BT-3546 (ADR 0124 §7 A1): UndefinedObject spelling, not just Nil ===
  // `String | UndefinedObject` must spawn without raising — UndefinedObject
  // is the canonical nil class, not only the `Nil` keyword spelling.
  testUndefinedObjectUnionFieldLeftNilSpawnsSuccessfully =>
    a := UndefinedObjectUnionStateActor spawn
    self assert: a getLabel equals: nil

  testUndefinedObjectUnionFieldOtherStateWorks =>
    a := UndefinedObjectUnionStateActor spawn
    self assert: a getCount equals: 1
