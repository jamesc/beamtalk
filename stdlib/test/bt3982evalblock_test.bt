// BT-3982: runs the cells of fixtures/bt3982evalblock_actor.bt, an actor
// evaluated literal block in value position (BEAM value oracle).

TestCase subclass: Bt3982EvalblockTest

  testTupleElement =>
    self assert: (Bt3982EvalblockActor spawn tupleElement) equals: {5, 5}

  testTupleUnary =>
    self assert: (Bt3982EvalblockActor spawn tupleUnary) equals: {5, 5}

  testListElement =>
