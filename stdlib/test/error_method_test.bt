// E2E tests for Object>>error: (BT-424)

TestCase subclass: ErrorMethodTest
  field: exc = nil

  // BT-1764 group: each test receives a caught badarith exception via setUp.
  setUp => self.exc := [1 / 0] on: Exception do: [:e | e]

  testBasicErrorOnPrimitives =>
    self assert: ([
      42 error: "too big"
    ] on: Exception do: [:e | e message]) equals: "too big"
    // Integer error: has user_error kind
    self assert: ([
      42 error: "too big"
    ] on: Exception do: [:e | e kind]) equals: #user_error
    // Integer error: has correct class
    self assert: ([
      42 error: "too big"
    ] on: Exception do: [:e | e errorClass]) equals: #Integer
    // String error: works
    self assert: ([
      "hello" error: "bad string"
    ] on: Exception do: [:e | e message]) equals: "bad string"
    // String error: has correct class
    self assert: ([
      "hello" error: "bad string"
    ] on: Exception do: [:e | e errorClass]) equals: #String

  testErrorOnValueTypes =>
    // Value type error: is catchable
    v := Validator new
    self assert: ([
      v check: -1
    ] on: Exception do: [:e | e message]) equals: "must be non-negative"
    // Value type error: has correct class
    self assert: ([
      v check: -1
    ] on: Exception do: [:e | e errorClass]) equals: #Validator
    // Value type error: has user_error kind
    self assert: ([
      v check: -1
    ] on: Exception do: [:e | e kind]) equals: #user_error
    // No error when valid
    self assert: (v check: 5) equals: 5

  testErrorWithNonStringArgument =>
    // Integer error message is coerced — raises user_error not type_error
    @expect type
    self should: [42 error: 99] raise: #user_error
    // Verify kind and errorClass via on:do:
    @expect type
    self assert: ([
      42 error: 99
    ] on: Exception do: [:e | e kind]) equals: #user_error
    @expect type
    self assert: ([
      42 error: 99
    ] on: Exception do: [:e | e errorClass]) equals: #Integer

  // BT-4075: `error:` on a variable bound to a class is the class-side send.
  testErrorOnClassVariableIsClassSideSend =>
    cls := Result
    r := cls error: #nope
    self assert: r isError
    self assert: r error equals: #nope
    // The same through an untyped parameter.
    self assert: (Validator new raise: #nope via: Result) isError

  // BT-4075: an instance through the same untyped parameter still raises.
  testErrorOnUntypedInstanceStillRaises =>
    self assert: ([
      Validator new raise: "bad" via: 42
    ] on: Exception do: [:e | e kind]) equals: #user_error
    self assert: ([
      Validator new raise: "bad" via: 42
    ] on: Exception do: [:e | e errorClass]) equals: #Integer

  // BT-4075: `self error:` in a class method without a class-side `error:`
  // still raises user_error.
  testClassMethodSelfErrorRaises =>
    self assert: ([
      Validator rejectAll
    ] on: Exception do: [:e | e message]) equals: "rejected"
    self assert: ([
      Validator rejectAll
    ] on: Exception do: [:e | e kind]) equals: #user_error

  // BT-4417: a class object is an Object, so a class with no class-side
  // `error:` reaches Object>>error: however the send is written.
  testErrorOnClassLiteralWithoutClassSideErrorRaises =>
    self assert: ([
      Integer error: "x"
    ] on: Exception do: [:e | e kind]) equals: #user_error
    self assert: ([
      Integer error: "x"
    ] on: Exception do: [:e | e message]) equals: "x"
    self assert: ([
      Validator error: "v"
    ] on: Exception do: [:e | e kind]) equals: #user_error
    // A class with class variables answers in its class process; the raise
    // still reaches the caller.
    self assert: ([
      DirectDispatchStateful error: "s"
    ] on: Exception do: [:e | e kind]) equals: #user_error

  testErrorViaPerformOnClassWithoutClassSideErrorRaises =>
    self
      assert: ([
        Integer perform: #error: withArguments: #("y")
      ] on: Exception do: [:e | e kind])
      equals: #user_error
    self
      assert: ([
        Integer perform: #error: withArguments: #("y")
      ] on: Exception do: [:e | e message])
      equals: "y"

  testErrorViaPerformOnInstanceRaises =>
    self assert: ([
      42 perform: #error: withArguments: #("z")
    ] on: Exception do: [:e | e kind]) equals: #user_error
    self
      assert: ([
        42 perform: #error: withArguments: #("z")
      ] on: Exception do: [:e | e errorClass])
      equals: #Integer

  // The literal, a variable and `perform:` agree.
  testErrorOnClassLiteralMatchesVariable =>
    cls := Integer
    literal := [Integer error: "x"] on: Exception do: [:e | e errorClass]
    viaVar := [cls error: "x"] on: Exception do: [:e | e errorClass]
    viaPerform := [
      Integer perform: #error: withArguments: #("x")
    ] on: Exception do: [:e | e errorClass]
    self assert: literal equals: viaVar
    self assert: viaPerform equals: viaVar

  // A class-side `error:` still receives the send.
  testClassSideErrorKeepsItsMeaning =>
    self assert: (Result error: #x) isError
    self assert: (Result error: #x) error equals: #x
    self assert: (Result perform: #error: withArguments: #(#x)) error equals: #x

  // `super error:` in a class-side `error:` reaches Object>>error:.
  testSuperErrorInClassSideErrorRaises =>
    self assert: ([
      SuperErrorProbe error: "s"
    ] on: Exception do: [:e | e kind]) equals: #user_error
    self assert: ([
      SuperErrorProbe error: "s"
    ] on: Exception do: [:e | e message]) equals: "s"

  // BT-4191: errorClass answers a Symbol, matching its `-> Symbol` declaration.
  testErrorClassIsSymbol =>
    @expect dnu
    cls := [42 unknownMsg] on: Exception do: [:e | e errorClass]
    self assert: cls class equals: Symbol
    self assert: cls equals: #Integer
    self assert: ([
      Error signal: "boom"
    ] on: Error do: [:e | e errorClass]) class equals: Symbol
    // asString still answers the class name as a String
    self assert: cls asString equals: "Integer"
    self assert: cls asString class equals: String

  // BT-4227: a raw Erlang throw/exit carries no class — errorClass answers nil,
  // never the `#undefined` sentinel Symbol.
  testErrorClassNilForRawThrow =>
    self assert: ([
      (Erlang erlang) throw: #oops
    ] on: ThrowError do: [:e | e errorClass]) equals: nil
    self assert: ([
      (Erlang erlang) throw: #oops
    ] on: Exception do: [:e | e errorClass isNil]) equals: true

  testErrorClassNilForRawExit =>
    self assert: ([
      (Erlang erlang) exit: #bye
    ] on: Exception do: [:e | e errorClass]) equals: nil

  testExceptionDisplayString =>
    // displayString on an Exception delegates to printString
    self assert: ([
      42 error: "too big"
    ] on: Exception do: [:e |
      e displayString
    ]) equals: ([42 error: "too big"] on: Exception do: [:e | e printString])

  // === BT-1764: Object-inherited methods work after removing orchestrator patch ===
  testExceptionRespondsToDisplayString =>
    self assert: (self.exc respondsTo: #displayString)

  testExceptionRespondsToHash => self assert: (self.exc respondsTo: #hash)

  testExceptionRespondsToIsNil => self assert: (self.exc respondsTo: #isNil)

  testExceptionIsNilReturnsFalse => self deny: self.exc isNil

  testExceptionHash =>
    result := self.exc hash
    self assert: (result isKindOf: Integer)

  testExceptionInspect =>
    // ADR 0095 Phase 3 (BT-2504): inspect returns an Inspector cursor, not a String.
    result := self.exc inspect
    self assert: (result isKindOf: Inspector)

  testExceptionRespondsToNonExistentMethod =>
    self deny: (self.exc respondsTo: #totallyBogusMethod)
