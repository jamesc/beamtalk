// BT-2267 / ADR 0084 Phase 2: callable class methods via the programmatic
// ClassBuilder cascade, exercised from a typed TestCase. The compiler lowers
// each `classMethods:` block to a class-method fun (ClassSelf, ClassVars, ...)
// installed as a runtime class-method fun (BT-2266); the name resolver treats
// these blocks as class-method bodies so `self`/`super` resolve and the
// receiver `self` parameter does not warn about shadowing.
//
// The class is dispatched by its registered name via findClass:. (Since
// BT-2258, register also returns the canonical, dispatchable class object;
// these tests keep the registry lookup, which exercises the same class.)

TestCase subclass: ClassBuilderClassMethodTest
  field: cls = nil
  field: parentCls = nil
  field: midCls = nil

  tearDown =>
    self.cls isNil ifFalse: [self.cls removeFromSystem]
    self.midCls isNil ifFalse: [self.midCls removeFromSystem]
    self.parentCls isNil ifFalse: [self.parentCls removeFromSystem]

  // Class-variable mutation persists across calls (the BT-873 "dropped state"
  // regression); classVars: seeds the initial value.
  testClassVarThreadsAcrossCalls =>
    Object classBuilder name: #BT2267BTally;
      superclass: Object;
      classVars: #{#total => 0};
      classMethods: #{#bump => [:self |
          self.total := self.total + 1
          self.total
        ]};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT2267BTally
    self assert: self.cls bump equals: 1
    self assert: self.cls bump equals: 2
    self assert: self.cls bump equals: 3

  // Plain-value and keyword class methods.
  testPlainAndKeywordClassMethods =>
    Object classBuilder name: #BT2267BKw;
      superclass: Object;
      classMethods: #{#answer => [:self | 42], #scale: => [:self :n | n * 3]};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT2267BKw
    self assert: self.cls answer equals: 42
    self assert: (self.cls scale: 4) equals: 12

  // A self class-method send resolves a sibling class method.
  testSelfClassMethodSend =>
    Object classBuilder name: #BT2267BSelf;
      superclass: Object;
      classMethods: #{
        #base => [:self | 10],
        #doubled => [:self | self base * 2]
      };
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT2267BSelf
    self assert: self.cls doubled equals: 20

  // `super` resolves to the superclass's class method.
  testSuperResolvesToSuperclass =>
    Object classBuilder name: #BT2267BSuperBase;
      superclass: Object;
      classMethods: #{#greeting => [:self | "base"]};
      register
    self.parentCls := (Erlang beamtalk_interface) findClass: #BT2267BSuperBase
    Object classBuilder name: #BT2267BSuperChild;
      superclass: #BT2267BSuperBase;
      classMethods: #{#greeting => [:self | super greeting]};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT2267BSuperChild
    self assert: self.cls greeting equals: "base"

  // ADR 0130 §3: a builder `super` send runs the superclass method with the
  // LIVE receiver (`ClassSelf` of the subclass), so a class-variable access in
  // that method uses the receiver's key rather than the static builder
  // class's. Called on a subclass of the builder class, it must not raise
  // class_state_unreachable.
  testSuperFromSubclassReceiverUsesReceiverClassVars =>
    Object classBuilder name: #BT3709SuperVarBase;
      superclass: Object;
      classVars: #{#n => 10};
      classMethods: #{#bump => [:self |
          self.n := self.n + 1
          self.n
        ]};
      register
    self.parentCls := (Erlang beamtalk_interface) findClass: #BT3709SuperVarBase
    Object classBuilder name: #BT3709SuperVarMid;
      superclass: #BT3709SuperVarBase;
      classMethods: #{#bump => [:self | super bump]};
      register
    self.midCls := (Erlang beamtalk_interface) findClass: #BT3709SuperVarMid
    Object classBuilder name: #BT3709SuperVarLeaf;
      superclass: #BT3709SuperVarMid;
      classVars: #{#n => 100};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT3709SuperVarLeaf
    self assert: self.cls bump equals: 101
    self assert: self.cls bump equals: 102

  // The same, for a class-side extension reached from a builder method: the
  // extension is looked up on the builder class but receives the live
  // receiver's `ClassSelf`, so it reads the subclass's class variable.
  testExtensionReadThroughSubclassReceiverUsesReceiverClassVars =>
    Object classBuilder name: #BT3709ExtMid;
      superclass: Object;
      classVars: #{#n => 10};
      classMethods: #{
        #viaSelf => [:self | self foo],
        #viaSuper => [:self | super foo]
      };
      register
    self.midCls := (Erlang beamtalk_interface) findClass: #BT3709ExtMid
    Object classBuilder name: #BT3709ExtLeaf;
      superclass: #BT3709ExtMid;
      classVars: #{#n => 100};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT3709ExtLeaf
    Erlang beamtalk_extensions
      register: #'BT3709ExtMid class'
      selector: #foo
      fun: [:_args :s | Erlang beamtalk_class_vars get: s with: #n]
      owner: #test
    viaSelf := self.cls viaSelf
    viaSuper := self.cls viaSuper
    Erlang ets delete: #beamtalk_extensions key: #(#'BT3709ExtMid class', #foo)
    self assert: viaSelf equals: 100
    self assert: viaSuper equals: 100

  // BT-2276: a computed (non-block-literal) classMethods: fun whose arity does
  // not match the class-method calling convention `fun(ClassSelf, ...)`
  // is rejected at register time with a structured #arity_mismatch error, instead
  // of installing successfully and crashing with an opaque error:undef when the
  // class method is first called. Here `blk` is arity 2 but unary `#size` needs
  // arity 1 (ClassSelf; class variables are not passed, ADR 0130).
  testWrongArityComputedFunRejected =>
    blk := [:_self :_extra | "x" size]
    self
      should: [
        Object classBuilder name: #BT2276Computed;
          superclass: Object;
          classMethods: #{#size => blk};
          register
      ]
      raise: #arity_mismatch

  // A correctly-shaped computed (non-block-literal) class-method fun follows the
  // `fun(ClassSelf, ...)` convention (arity 1 for a unary selector)
  // and registers and dispatches unaffected (BT-2276).
  testCorrectArityComputedFunUnaffected =>
    blk := [:_self | 99]
    Object classBuilder name: #BT2276ComputedOk;
      superclass: Object;
      classMethods: #{#answer => blk};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT2276ComputedOk
    self assert: self.cls answer equals: 99
