// BT-4762: an inline FFI call whose spec states an `{ok, V}` / `ok` /
// `{error, R}` return builds the `Result` at the call site. The values must be
// exactly what the proxy builds (ADR 0076).

TestCase subclass: FfiInlineResultTest

  testBareOkAndBinaryValueRoundTrip =>
    written := Erlang file write_file: "bt4762_inline_tmp.txt" data: "hello"
    r := Erlang file read_file: "bt4762_inline_tmp.txt"
    Erlang file delete: "bt4762_inline_tmp.txt"
    // Asserts after the cleanup so a failure cannot leak the temp file.
    self assert: written ok
    self assert: written value isNil
    self assert: r ok
    self assert: r value size equals: 5

  testErrorReasonIsWrappedException =>
    r := Erlang file read_file: "bt4762_no_such_file"
    self assert: r isError
    self assert: (r error isKindOf: Exception)

  testBareOkIsResultOkNil =>
    r := Erlang application unset_env: #bt4762_app key: #bt4762_key
    self assert: r ok
    self assert: r value isNil

  testNonListValueIsWrapped =>
    r := Erlang maps find: #k in: #{#k => 42}
    self assert: r ok
    self assert: r value equals: 42

  testMissingKeyIsErrorResult =>
    r := Erlang maps find: #missing in: #{#k => 42}
    self assert: r isError
