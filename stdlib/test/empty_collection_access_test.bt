// BUnit tests for empty-collection element access (BT-3021).
//
// Accessing an element of an empty collection used to raise
// `does_not_understand` — a dispatch failure — which sent readers hunting for
// a typo or a wrong receiver type instead of a missing emptiness guard, and
// could not be caught selectively (a genuine typo surfaced identically).
//
// The element accessors (`first`, `last`, `at:`) now raise `empty_collection`.
// The subsequence operations (`rest`, `take:`, `drop:`) stay total and answer
// the empty collection — see the `rest` tests at the bottom.

TestCase subclass: EmptyCollectionAccessTest

  // ==========================================================================
  // List — element accessors raise empty_collection
  // ==========================================================================
  testListFirstOnEmptyRaisesEmptyCollection =>
    self should: [#() first] raise: #empty_collection

  testListLastOnEmptyRaisesEmptyCollection =>
    self should: [#() last] raise: #empty_collection

  testListAtOnEmptyRaisesEmptyCollection =>
    self should: [#() at: 1] raise: #empty_collection

  // A List materialised from another collection behaves the same — this is the
  // shape the bug was originally reported against.
  testEmptySetAsListFirstRaisesEmptyCollection =>
    self should: [Set new asList first] raise: #empty_collection

  // The error names the condition, not a dispatch failure.
  testListFirstMessageNamesTheCondition =>
    message := [#() first] on: Error do: [:e | e message]
    self assert: (message includesSubstring: "is empty")
    self deny: (message includesSubstring: "does not understand")

  testListAtMessageNamesTheCondition =>
    message := [#() at: 1] on: Error do: [:e | e message]
    self assert: (message includesSubstring: "is empty")
    self deny: (message includesSubstring: "does not understand")

  // empty_collection is catchable as a RuntimeError, so `on:do:` can
  // discriminate it from an unrelated failure in the same block.
  testEmptyCollectionIsCatchableAsRuntimeError =>
    caught := [#() first] on: RuntimeError do: [:e | "caught"]
    self assert: caught equals: "caught"

  // ==========================================================================
  // List — out-of-bounds is a *different* condition from empty
  // ==========================================================================
  testListAtBeyondSizeRaisesIndexOutOfBounds =>
    self should: [#(1, 2, 3) at: 9] raise: #index_out_of_bounds

  testListAtZeroRaisesIndexOutOfBounds =>
    self should: [#(1, 2, 3) at: 0] raise: #index_out_of_bounds

  // An index below 1 is malformed whether or not the List is empty, so it
  // reports as out-of-bounds rather than as emptiness.
  testEmptyListAtZeroRaisesIndexOutOfBounds =>
    self should: [#() at: 0] raise: #index_out_of_bounds

  // (A non-Integer index is rejected at compile time, so it has no runtime
  // test here — the type checker reports it before the program runs.)

  // ==========================================================================
  // String — element accessors are grapheme-aware and raise on empty
  // ==========================================================================
  testStringFirstOnEmptyRaisesEmptyCollection =>
    self should: ["" first] raise: #empty_collection

  testStringLastOnEmptyRaisesEmptyCollection =>
    self should: ["" last] raise: #empty_collection

  // `String at:` mirrors `List at:`: empty is empty_collection, out-of-range
  // is index_out_of_bounds, and a sub-1 index is malformed either way.
  testStringAtOnEmptyRaisesEmptyCollection =>
    self should: ["" at: 1] raise: #empty_collection

  testStringAtBeyondLengthRaisesIndexOutOfBounds =>
    self should: ["abc" at: 9] raise: #index_out_of_bounds

  testEmptyStringAtZeroRaisesIndexOutOfBounds =>
    self should: ["" at: 0] raise: #index_out_of_bounds

  testStringFirstReturnsFirstGrapheme => self assert: "hello" first equals: "h"

  testStringLastReturnsLastGrapheme => self assert: "hello" last equals: "o"

  // Grapheme-aware, not byte-aware: "ü" is two UTF-8 bytes.
  testStringFirstIsGraphemeAware => self assert: "über" first equals: "ü"

  testStringLastIsGraphemeAware => self assert: "grüß" last equals: "ß"

  testStringFirstOnSingleCharacterString =>
    self assert: "x" first equals: "x"
    self assert: "x" last equals: "x"

  // ==========================================================================
  // Array — at: agrees with List and String
  // ==========================================================================

  // `Array withAll: #()` — Array has no `new`, only `withAll:` / `new:`.
  testArrayAtOnEmptyRaisesEmptyCollection =>
    self should: [(Array withAll: #()) at: 1] raise: #empty_collection

  testArrayAtBeyondSizeRaisesIndexOutOfBounds =>
    self should: [(Array withAll: #(1, 2, 3)) at: 9] raise: #index_out_of_bounds

  testEmptyArrayAtZeroRaisesIndexOutOfBounds =>
    self should: [(Array withAll: #()) at: 0] raise: #index_out_of_bounds

  // ==========================================================================
  // Array — first/last (BT-3027), same shape as List/String
  // ==========================================================================
  testArrayFirstOnEmptyRaisesEmptyCollection =>
    self should: [#[] first] raise: #empty_collection

  testArrayLastOnEmptyRaisesEmptyCollection =>
    self should: [#[] last] raise: #empty_collection

  testArrayFirstAndLastReturnElements =>
    self assert: #[10, 20, 30] first equals: 10
    self assert: #[10, 20, 30] last equals: 30

  // ==========================================================================
  // Queue — predates empty_collection and keeps its own kind, but classifies
  // as RuntimeError like the rest of the family
  // ==========================================================================
  testQueuePeekOnEmptyStillRaisesEmptyQueue =>
    self should: [Queue new peek] raise: #empty_queue

  testEmptyQueueIsCatchableAsRuntimeError =>
    caught := [Queue new peek] on: RuntimeError do: [:e | "caught"]
    self assert: caught equals: "caught"

  // ==========================================================================
  // Interval — pure-Beamtalk collection, same kind via the Erlang helper
  // ==========================================================================
  testEmptyIntervalFirstRaisesEmptyCollection =>
    self should: [(1 to: 0) first] raise: #empty_collection

  testEmptyIntervalLastRaisesEmptyCollection =>
    self should: [(1 to: 0) last] raise: #empty_collection

  testNonEmptyIntervalFirstAndLastStillWork =>
    self assert: (1 to: 10) first equals: 1
    self assert: (1 to: 10) last equals: 10

  // `Interval>>at:` (BT-3027) is bounds-checked like `Array`/`List` at:, but
  // *always* reports out-of-range as index_out_of_bounds — including on an
  // empty interval — never empty_collection. Only the no-arg accessors
  // (first/last/anyOne) treat emptiness as its own condition.
  testIntervalAtOutOfRangeRaisesIndexOutOfBounds =>
    self should: [(1 to: 10) at: 11] raise: #index_out_of_bounds
    self should: [(1 to: 10) at: 0] raise: #index_out_of_bounds

  testEmptyIntervalAtRaisesIndexOutOfBoundsNotEmptyCollection =>
    self should: [(1 to: 0) at: 1] raise: #index_out_of_bounds

  testIntervalAtReturnsElement =>
    self assert: ((1 to: 10) at: 1) equals: 1
    self assert: ((1 to: 10) at: 10) equals: 10
    self assert: ((1 to: 10 by: 2) at: 3) equals: 5

  // ==========================================================================
  // Set/Bag/Dictionary — deliberately no first/last; anyOne instead (BT-3027)
  // ==========================================================================
  testSetAnyOneOnEmptyRaisesEmptyCollection =>
    self should: [Set new anyOne] raise: #empty_collection

  testBagAnyOneOnEmptyRaisesEmptyCollection =>
    self should: [Bag new anyOne] raise: #empty_collection

  testDictionaryAnyOneOnEmptyRaisesEmptyCollection =>
    self should: [#{} anyOne] raise: #empty_collection

  testSetAnyOneOnNonEmptyReturnsAMember =>
    s := Set new fromList: #(1, 2, 3)
    self assert: (s includes: s anyOne)

  testBagAnyOneOnNonEmptyReturnsAMember =>
    b := Bag withAll: #(1, 2, 3)
    self assert: (b includes: b anyOne)

  testDictionaryAnyOneOnNonEmptyReturnsAValue =>
    d := #{#a => 1, #b => 2}
    self assert: (d includes: d anyOne)

  // Set/Bag/Dictionary have no `first`/`last` at all — the design
  // deliberately does not give them those selectors (they'd misleadingly
  // imply an ordering guarantee). The type checker emits a compile-time
  // hint for the unresolved selector, but this does not block compilation
  // (see `@expect dnu` convention) — it still dispatches at runtime and
  // raises `does_not_understand`, exactly like any other typo.
  @expect dnu
  testSetFirstRaisesDoesNotUnderstand =>
    self should: [Set new first] raise: #does_not_understand

  @expect dnu
  testBagLastRaisesDoesNotUnderstand =>
    self should: [(Bag withAll: #(1, 2)) last] raise: #does_not_understand

  // ==========================================================================
  // Collection aggregates — max/min/average over nothing
  // ==========================================================================
  testEmptyCollectionMaxRaisesEmptyCollection =>
    self should: [#() max] raise: #empty_collection

  testEmptyCollectionMinRaisesEmptyCollection =>
    self should: [#() min] raise: #empty_collection

  testEmptyCollectionAverageRaisesEmptyCollection =>
    self should: [#() average] raise: #empty_collection

  // `sum` has an identity element (0), so it stays total.
  testEmptyCollectionSumIsZero => self assert: #() sum equals: 0

  // ==========================================================================
  // Subsequence operations stay total — the decided `rest` behaviour
  // ==========================================================================

  // `rest` is not an element accessor: unlike `first`/`last` it has a
  // well-defined total answer on empty, so it answers `#()` rather than
  // raising. This keeps the `isEmpty ifFalse: [... rest ...]` recursion idiom
  // working and matches its neighbours `take:`/`drop:`.
  testRestOnEmptyAnswersEmptyList => self assert: #() rest equals: #()

  testRestOnEmptyDoesNotRaise =>
    self assert: ([#() rest] on: Error do: [:e | "raised"]) equals: #()

  testRestOnSingletonAnswersEmptyList => self assert: #(1) rest equals: #()

  testTakeAndDropOnEmptyAreAlsoTotal =>
    self assert: (#() take: 3) equals: #()
    self assert: (#() drop: 3) equals: #()

  // The whole point of the split: `first` raises where `rest` answers.
  testElementAccessorsRaiseWhereSubsequenceOpsAnswer =>
    self should: [#() first] raise: #empty_collection
    self assert: #() rest equals: #()

  // ==========================================================================
  // beamtalk_collection raiseKind:class:selector:hint: — general named-kind
  // raise helper for pure-Beamtalk code (BT-3042). The counterpart to
  // raiseEmpty: above: any kind, with a hint specific to the call site.
  // ==========================================================================
  testRaiseKindRoundTripsIndexOutOfBounds =>
    self
      should: [
        (Erlang beamtalk_collection)
          raiseKind: #index_out_of_bounds
          class: #ListZipper
          selector: #left
          hint: "already at the start of the sequence"
      ]
      raise: #index_out_of_bounds

  testRaiseKindUsesTheSuppliedHint =>
    message := [
      (Erlang beamtalk_collection)
        raiseKind: #index_out_of_bounds
        class: #ListZipper
        selector: #left
        hint: "already at the start of the sequence"
    ] on: Error do: [:e | e message]
    self assert: (message includesSubstring: "already at the start of the sequence")
