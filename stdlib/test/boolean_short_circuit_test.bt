// Proves True/False>>ifTrue:ifFalse:, ifTrue:, ifFalse:, and:, or: only
// evaluate the block(s) their semantics require, never the unused branch —
// by incrementing a named AtomicCounter inside the block that must NOT run
// and asserting it stays at 0 (the AtomicCounter side-effect idiom already
// used in blocks_test.bt for similar non-evaluation proofs).
//
// Migrated (BT-3093) off a hand-rolled Erlang re-implementation of
// True/False dispatch in beamtalk_codegen_simulation_tests.erl that stood
// in for "the exact semantics that compiled Beamtalk Boolean methods must
// produce" — see docs/development/architecture-principles.md § 7
// (Consistency-Test Disposition Rule). Value-correctness for these same
// selectors is covered end-to-end against real compiled True/False/Boolean
// (stdlib/src/true.bt, false.bt, boolean.bt) by
// stdlib/bootstrap-test/booleans.btscript; this file adds the
// short-circuit proof that file's comments claimed but didn't verify.
//
// Conditions are routed through a `cond:` parameter (rather than sending
// ifTrue:ifFalse:/and:/or: directly to a `true`/`false` literal) because
// the compiler's dead-branch lint flags a literal-boolean receiver as
// "Condition is always true/false" under --warnings-as-errors — the
// helper methods below make the boolean a runtime value from the caller's
// perspective, matching how these branches would actually be reached in
// non-toy code.

TestCase subclass: BooleanShortCircuitTest

  ifTrueIfFalse: cond trueBlock: trueBlock falseBlock: falseBlock =>
    cond ifTrue: trueBlock ifFalse: falseBlock

  ifTrue: cond block: aBlock => cond ifTrue: aBlock

  ifFalse: cond block: aBlock => cond ifFalse: aBlock

  and: cond block: aBlock => cond and: aBlock

  or: cond block: aBlock => cond or: aBlock

  testIfTrueIfFalseSkipsFalseBranch =>
    counter := AtomicCounter new: #bt3093IfTrueSkipsFalse
    [
      result := self
        ifTrueIfFalse: true
        trueBlock: [42]
        falseBlock: [
          counter increment
          0
        ]
      self assert: result equals: 42
      self assert: counter value equals: 0
    ] ensure: [counter delete]

  testIfTrueIfFalseSkipsTrueBranch =>
    counter := AtomicCounter new: #bt3093IfFalseSkipsTrue
    [
      result := self
        ifTrueIfFalse: false
        trueBlock: [
          counter increment
          42
        ]
        falseBlock: [0]
      self assert: result equals: 0
      self assert: counter value equals: 0
    ] ensure: [counter delete]

  testFalseIfTrueSkipsBlock =>
    counter := AtomicCounter new: #bt3093FalseIfTrueSkips
    [
      result := self
        ifTrue: false
        block: [
          counter increment
          42
        ]
      self deny: result
      self assert: counter value equals: 0
    ] ensure: [counter delete]

  testTrueIfFalseSkipsBlock =>
    counter := AtomicCounter new: #bt3093TrueIfFalseSkips
    [
      result := self
        ifFalse: true
        block: [
          counter increment
          42
        ]
      self assert: result
      self assert: counter value equals: 0
    ] ensure: [counter delete]

  testFalseAndShortCircuits =>
    counter := AtomicCounter new: #bt3093FalseAndSkips
    [
      result := self
        and: false
        block: [
          counter increment
          true
        ]
      self deny: result
      self assert: counter value equals: 0
    ] ensure: [counter delete]

  testTrueOrShortCircuits =>
    counter := AtomicCounter new: #bt3093TrueOrSkips
    [
      result := self
        or: true
        block: [
          counter increment
          false
        ]
      self assert: result
      self assert: counter value equals: 0
    ] ensure: [counter delete]

  testTrueAndEvaluatesBlock =>
    counter := AtomicCounter new: #bt3093TrueAndEvaluates
    [
      result := self
        and: true
        block: [
          counter increment
          true
        ]
      self assert: result
      self assert: counter value equals: 1
    ] ensure: [counter delete]

  testFalseOrEvaluatesBlock =>
    counter := AtomicCounter new: #bt3093FalseOrEvaluates
    [
      result := self
        or: false
        block: [
          counter increment
          true
        ]
      self assert: result
      self assert: counter value equals: 1
    ] ensure: [counter delete]
