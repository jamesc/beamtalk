// BUnit tests for the Node value class, Pid/Actor node accessors, and the
// NodeUp/NodeDown announcement classes (ADR 0126 Phase 1, BT-3598).
//
// These run on a single node; the two-node behaviour (Node connected after a
// peer connects, NodeUp/NodeDown firing, the insecure_distribution policy) is
// covered by the runtime EUnit suite beamtalk_node_tests.

TestCase subclass: NodeTest

  // ===== Node current =====
  testCurrentIsNode => self assert: Node current class equals: Node

  testCurrentNameIsThisVmNode =>
    self assert: Node current name equals: (Erlang erlang) node

  testCurrentIsCurrent => self assert: Node current isCurrent

  testCurrentIsConnected => self assert: Node current isConnected

  // ===== Node named: =====
  testNamedValid =>
    result := Node named: #'worker@localhost'
    self assert: result isOk
    self assert: result unwrap class equals: Node
    self assert: result unwrap name equals: #'worker@localhost'

  testNamedAcceptsDottedHost =>
    self assert: (Node named: #'app_1-a@host.example.com') isOk

  testNamedWithoutHostIsError =>
    result := Node named: #nohost
    self assert: result isError
    self assert: result error kind equals: #invalid_node_name

  testNamedEmptyPartsAreErrors =>
    self assert: (Node named: #'@host') error kind equals: #invalid_node_name
    self assert: (Node named: #'name@') error kind equals: #invalid_node_name

  testNamedTwoAtSignsIsError =>
    self assert: (Node named: #'a@b@c') error kind equals: #invalid_node_name

  testNamedBadNameCharIsError =>
    self assert: (Node named: #'we ird@host') error kind equals: #invalid_node_name

  testNamedOtherNodeIsNotCurrent =>
    self deny: (Node named: #'somewhere_else@localhost') unwrap isCurrent

  // ===== Equality (value equality on name) =====
  testEqualNamesAreEqual =>
    a := (Node named: #'worker@localhost') unwrap
    b := (Node named: #'worker@localhost') unwrap
    self assert: a =:= b
    self assert: a hash equals: b hash

  testDifferentNamesAreNotEqual =>
    a := (Node named: #'worker@localhost') unwrap
    b := (Node named: #'other@localhost') unwrap
    self deny: a =:= b

  testCurrentEqualsNamedCurrent =>
    self assert: (Node named: Node current name) unwrap =:= Node current

  // ===== ping / disconnect =====
  testPingSelf => self assert: Node current ping

  testDisconnectSelfIsFalse => self deny: Node current disconnect

  testConnectSelfIsOk =>
    result := Node current connect
    self assert: result isOk
    self assert: result unwrap =:= Node current

  // ===== Node connected =====
  testConnectedExcludesCurrent =>
    self deny: (Node connected includes: Node current)

  // ===== printString =====
  testPrintString =>
    n := (Node named: #'worker@localhost') unwrap
    self assert: n printString equals: "Node(worker@localhost)"

  // ===== Pid>>node =====
  testPidNodeIsCurrent =>
    // A short-lived raw process: erlang:node/1 works on a dead pid too.
    pid := Erlang erlang
      spawn: #timer
      module: #sleep
      args: #(0)
    self assert: pid node =:= Node current

  // ===== Actor>>node / isRemote =====
  testActorNodeIsCurrent =>
    c := Counter spawn
    self assert: c node =:= Node current
    self deny: c isRemote
    c stop

  testActorPidNodeMatchesActorNode =>
    c := Counter spawn
    self assert: c pid node =:= c node
    c stop

  testTimeoutProxyForwardsNode =>
    c := Counter spawn
    proxy := c withTimeout: 1000
    self assert: proxy node =:= c node
    self deny: proxy isRemote
    proxy stop
    c stop

  // ===== NodeUp / NodeDown =====
  testNodeEventsAreAnnouncements =>
    self assert: ((NodeUp node: Node current) isKindOf: Announcement)
    self assert: ((NodeDown node: Node current reason: #disconnect) isKindOf: Announcement)

  testNodeUpCarriesNode =>
    e := NodeUp node: Node current
    self assert: e node =:= Node current

  testNodeDownCarriesNodeAndReason =>
    e := NodeDown node: Node current reason: #disconnect
    self assert: e node =:= Node current
    self assert: e reason equals: #disconnect

  // ===== NodeShapeSkew =====
  testNodeShapeSkewIsAnnouncement =>
    self
      assert: ((NodeShapeSkew
        node: Node current
        className: #Counter
        localVersion: 1
        remoteVersion: 2) isKindOf: Announcement)

  testNodeShapeSkewCarriesFields =>
    e := NodeShapeSkew
      node: Node current
      className: #Counter
      localVersion: 1
      remoteVersion: 2
    self assert: e node =:= Node current
    self assert: e className equals: #Counter
    self assert: e localVersion equals: 1
    self assert: e remoteVersion equals: 2

  // ===== Node>>shapeManifest =====
  testShapeManifestOnCurrentIsOk =>
    result := Node current shapeManifest
    self assert: result isOk
    self assert: result unwrap class equals: Dictionary

  // ===== Node introspection (ADR 0129 amendment, BT-3633) =====
  // The actor registry is owned by beamtalk_runtime, so these hold under
  // `beamtalk test` where no workspace runs. Peer/erpc behaviour is covered
  // by tests/repl-protocol/cases/distribution.btscript.
  testCurrentActorsIsOkList =>
    result := Node current actors
    self assert: result isOk
    self assert: (result unwrap isKindOf: List)

  testCurrentActorsIncludesSpawnedActor =>
    c := Counter spawn
    self assert: (Node current actors unwrap includes: c)
    self assert: (Node current actorsOf: Counter) unwrap isEmpty not
    c stop

  testActorsOfFiltersByClass =>
    c := Counter spawn
    all := Node current actors unwrap
    counters := (Node current actorsOf: Counter) unwrap
    self assert: (counters allSatisfy: [:a | a class includesBehaviour: Counter])
    self assert: counters size <= all size
    c stop

  testActorAtInvalidPidIsNil =>
    self assert: (Node current actorAt: "invalid") unwrap isNil

  testStoppedActorLeavesActors =>
    c := Counter spawn
    c stop
    self deny: (Node current actors unwrap includes: c)

  testCurrentProcessesIsOkTree =>
    result := Node current processes
    self assert: result isOk
    self assert: (result unwrap isKindOf: SupervisionTree)

  testCurrentSupervisorsIsOkList =>
    self assert: Node current supervisors isOk

  testCurrentShapeSkewIsZero =>
    self assert: Node current shapeSkew unwrap equals: 0

  testDownPeerAnswersErrorNotRaise =>
    ghost := (Node named: #'ghost@localhost') unwrap
    self assert: ghost actors isError
    self assert: ghost actors error kind equals: #node_down
    self assert: ghost shapeSkew isError
