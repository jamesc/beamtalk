// BT-5098: `to:by:do:` with a step of 0 raises on both code paths.
//
// A block that writes no outer variable is a real send to `Integer>>to:by:do:`;
// a block that writes an outer local is inlined by the compiler as a counted
// loop. Both must raise "Interval step cannot be zero".

TestCase subclass: ToByDoZeroStepTest

  pureLoop: step :: Integer from: from :: Integer to: to :: Integer =>
    from
      to: to
      by: step
      do: [:i | i]

  pureLiteralZeroUp =>
    1
      to: 10
      by: 0
      do: [:i | i]

  pureLiteralZeroDown =>
    10
      to: 1
      by: 0
      do: [:i | i]

  writingLoop: step :: Integer from: from :: Integer to: to :: Integer =>
    s := 0
    from
      to: to
      by: step
      do: [:i | s := s + i]
    s

  writingLiteralZeroUp =>
    s := 0
    1
      to: 10
      by: 0
      do: [:i | s := s + i]
    s

  writingLiteralZeroDown =>
    s := 0
    10
      to: 1
      by: 0
      do: [:i | s := s + i]
    s

  // BT-5136: untyped step/limit so a Float or nil reaches the loop.
  pureAny: step from: from to: to =>
    from
      to: to
      by: step
      do: [:i | i]

  writingAny: step from: from to: to =>
    s := 0
    from
      to: to
      by: step
      do: [:i | s := s + i]
    s

  // --- BT-5136: a Float zero step and non-number step/limit raise on both paths ---
  testFloatZeroStepRaisesOnBothPaths =>
    self
      should: [
        self
          pureAny: 0.0
          from: 1
          to: 10
      ]
      raise: #user_error
    self
      should: [
        self
          writingAny: 0.0
          from: 1
          to: 10
      ]
      raise: #user_error

  testNilStepRaisesTypeErrorOnBothPaths =>
    self
      should: [
        self
          pureAny: nil
          from: 1
          to: 10
      ]
      raise: #type_error
    self
      should: [
        self
          writingAny: nil
          from: 1
          to: 10
      ]
      raise: #type_error

  testNilLimitRaisesTypeErrorOnBothPaths =>
    self
      should: [
        self
          pureAny: 1
          from: 1
          to: nil
      ]
      raise: #type_error
    self
      should: [
        self
          writingAny: 1
          from: 1
          to: nil
      ]
      raise: #type_error

  testStringStepRaisesTypeErrorOnBothPaths =>
    self
      should: [
        self
          pureAny: "x"
          from: 1
          to: 10
      ]
      raise: #type_error
    self
      should: [
        self
          writingAny: "x"
          from: 1
          to: 10
      ]
      raise: #type_error

  // --- pure block (real send, not inlined) ---
  testPureLiteralZeroPositiveRange =>
    self should: [self pureLiteralZeroUp] raise: #user_error

  testPureLiteralZeroNegativeRange =>
    self should: [self pureLiteralZeroDown] raise: #user_error

  testPureRuntimeZeroPositiveRange =>
    self
      should: [
        self
          pureLoop: 0
          from: 1
          to: 10
      ]
      raise: #user_error

  testPureRuntimeZeroNegativeRange =>
    self
      should: [
        self
          pureLoop: 0
          from: 10
          to: 1
      ]
      raise: #user_error

  // --- writing block (inlined counted loop) ---
  testWritingLiteralZeroPositiveRange =>
    self should: [self writingLiteralZeroUp] raise: #user_error

  testWritingLiteralZeroNegativeRange =>
    self should: [self writingLiteralZeroDown] raise: #user_error

  testWritingRuntimeZeroPositiveRange =>
    self
      should: [
        self
          writingLoop: 0
          from: 1
          to: 10
      ]
      raise: #user_error

  testWritingRuntimeZeroNegativeRange =>
    self
      should: [
        self
          writingLoop: 0
          from: 10
          to: 1
      ]
      raise: #user_error

  // The two paths share one message (the stdlib method and the compiler each
  // spell it), so a rewording of either shows up here.
  testBothPathsRaiseTheSameMessage =>
    pureMsg := [
      self
        pureLoop: 0
        from: 1
        to: 10
    ] on: Exception do: [:e | e message]
    writingMsg := [
      self
        writingLoop: 0
        from: 1
        to: 10
    ] on: Exception do: [:e | e message]
    self assert: pureMsg equals: writingMsg

  testWritingZeroStepMessage =>
    msg := [
      self
        writingLoop: 0
        from: 1
        to: 10
    ] on: Exception do: [:e | e message]
    self assert: msg equals: "Interval step cannot be zero"

  // A zero step on an empty range still raises (the check precedes the loop).
  testWritingZeroStepEmptyRangeRaises =>
    self
      should: [
        self
          writingLoop: 0
          from: 5
          to: 1
      ]
      raise: #user_error

  // --- non-zero steps are unchanged ---
  testWritingNonZeroStepsStillRun =>
    self
      assert: (self
        writingLoop: 3
        from: 1
        to: 10)
      equals: 22
    self
      assert: (self
        writingLoop: -3
        from: 10
        to: 1)
      equals: 22
    self
      assert: (self
        writingLoop: 1
        from: 5
        to: 1)
      equals: 0
