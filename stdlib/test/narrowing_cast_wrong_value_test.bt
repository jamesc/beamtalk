// BT-4772: what a WRONG narrowing local annotation does at run time.
//
// `n :: Integer := opts at: #v` is a narrowing cast: the checker accepts it
// (BT-2015) and nothing checks it at run time. These tests pin the behaviour
// for a value that is not an Integer, to answer one question: can a wrong
// cast give a silently wrong ANSWER, or does it always fail?
//
// Result:
//   * Operators on the cast LOCAL are guarded: a wrong value fails loudly
//     with `does_not_understand`.
//   * The same value passed on to a typed parameter, or stored in a typed
//     field, used to be trusted: `<` / `>` compiled to the bare Erlang
//     term-order BIF and ANSWERED (`nil > 10` was `true`, `nil < 10`
//     `false`). BT-4823 puts an inline kind test in front of that BIF, so a
//     receiver that is not the declared kind is dispatched like any other and
//     fails with `does_not_understand`. A Symbol is the exception that
//     proves the rule: it defines its own ordering, so `#foo > 10` reaches
//     `Symbol>>>`, whose argument is unchecked (BT-3928).
//   * Arithmetic on a trusted parameter fails as a raw `type_error`
//     (badarith), as row 11b of `just bench-vs-elixir` predicts.
//
// ADR 0148 stays open for the rest (explicit checked cast, implicit guard on
// `::` locals).

TestCase subclass: NarrowingCastWrongValueTest
  field: probe = nil

  setUp => self withProbe: NarrowingCastProbe new

  /// The kind of the error `blk` raises, or `#none` when it answers.
  kindOf: blk =>
    [
      blk value
      #none
    ] on: Error do: [:e | e kind]

  // --- contrast: a cast local is NOT trusted, so a wrong value is loud ----
  testCastLocalComparisonIsLoud =>
    self assert: (self kindOf: [
      self.probe localLess: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe localGreater: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe localGreater: #{#v => true}
    ]) equals: #does_not_understand

  testCastLocalArithmeticIsLoud =>
    self assert: (self kindOf: [
      self.probe localAdd: #{#v => nil}
    ]) equals: #does_not_understand

  // --- a typed parameter IS trusted: arithmetic crashes raw -----------------
  testWrongValueInTypedParamArithmeticCrashesRaw =>
    self assert: (self kindOf: [
      self.probe castThenParamAdd: #{#v => nil}
    ]) equals: #type_error
    self assert: (self kindOf: [
      self.probe castThenParamAdd: #{#v => #foo}
    ]) equals: #type_error

  // --- a typed parameter: comparison on a wrong kind is loud (BT-4823) ------
  testWrongValueInTypedParamGreaterRaises =>
    // Erlang term order says `nil > 10` is `true`; the kind test in front of
    // the BIF sends it to `nil`, which defines no `>`.
    self assert: (self kindOf: [
      self.probe castThenParamGreater: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe castThenParamGreater: #{#v => true}
    ]) equals: #does_not_understand
    // A Symbol defines `>`: it reaches `Symbol>>>`, whose argument is
    // unchecked (BT-3928), so it term-orders against the Integer.
    self assert: (self.probe castThenParamGreater: #{#v => #foo}) equals: true
    // An actual Integer or Float still answers correctly.
    self assert: (self.probe castThenParamGreater: #{#v => 11}) equals: true
    self assert: (self.probe castThenParamGreater: #{#v => 7.5}) equals: false

  testWrongValueInTypedParamLessRaises =>
    self assert: (self kindOf: [
      self.probe castThenParamLess: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe castThenParamLess: #{#v => true}
    ]) equals: #does_not_understand

  testSameWrongValueWithoutAnyCastRaises =>
    // No narrowing annotation anywhere: a value of the wrong type reaches
    // the typed parameter straight from a dictionary read. A guard at
    // narrowing casts alone would not see this route; the comparison's own
    // kind test does.
    d := #{#v => nil}
    self assert: (self kindOf: [
      self.probe paramGreater: (d at: #v)
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe paramLess: (d at: #v)
    ]) equals: #does_not_understand

  // --- a typed field: same, stored first ------------------------------------
  testWrongValueInTypedFieldGreaterRaises =>
    self assert: (self kindOf: [
      self.probe castThenField: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self.probe castThenField: #{#v => #foo}) equals: true
    self assert: (self.probe castThenField: #{#v => 7.5}) equals: false
