// NOTE: this file pins TODAY's behaviour. BT-4823 flips the
// `...AnswersSilently` cases (`<`, `>`, the field case and
// `testSameWrongAnswerWithoutAnyCast`) to expect `does_not_understand`.

// BT-4772: what a WRONG narrowing local annotation does at run time.
//
// `n :: Integer := opts at: #v` is a narrowing cast: the checker accepts it
// (BT-2015) and nothing checks it at run time. These tests pin today's
// behaviour for a value that is not an Integer, to answer one question:
// can a wrong cast give a silently wrong ANSWER, or does it always crash?
//
// Result (the reason ADR 0148 exists):
//   * Operators on the cast LOCAL are guarded (codegen trusts typed
//     parameters and fields, not annotated locals): a wrong value fails
//     loudly with `does_not_understand`.
//   * The same value passed on to a typed parameter, or stored in a typed
//     field, is trusted: `<` / `>` compile to the bare Erlang term-order
//     BIF and ANSWER. `nil > 10` is `true`, `nil < 10` is `false`.
//   * Arithmetic on a trusted parameter fails as a raw `type_error`
//     (badarith), as row 11b of `just bench-vs-elixir` predicts.
//
// If the decision in ADR 0148 adds a run-time guard, the "silent" tests flip
// to expecting a type error at the cast line.

TestCase subclass: NarrowingCastWrongValueTest
  field: probe = nil

  setUp => self withProbe: NarrowingCastProbe new

  /// The kind of the error `blk` raises, or `#none` when it answers.
  kindOf: blk =>
    [
      blk value
      #none
    ] on: Error do: [:e | e kind]

  // --- contrast: a cast local is NOT trusted, so a wrong value is loud ----
  testCastLocalComparisonIsLoud =>
    self assert: (self kindOf: [
      self.probe localLess: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe localGreater: #{#v => nil}
    ]) equals: #does_not_understand
    self assert: (self kindOf: [
      self.probe localGreater: #{#v => true}
    ]) equals: #does_not_understand

  testCastLocalArithmeticIsLoud =>
    self assert: (self kindOf: [
      self.probe localAdd: #{#v => nil}
    ]) equals: #does_not_understand

  // --- a typed parameter IS trusted: arithmetic crashes raw -----------------
  testWrongValueInTypedParamArithmeticCrashesRaw =>
    self assert: (self kindOf: [
      self.probe castThenParamAdd: #{#v => nil}
    ]) equals: #type_error
    self assert: (self kindOf: [
      self.probe castThenParamAdd: #{#v => #foo}
    ]) equals: #type_error

  // --- a typed parameter IS trusted: comparison gives a silent wrong answer
  testWrongValueInTypedParamGreaterAnswersSilently =>
    // Erlang term order: number < atom, so `nil > 10` is `true`.
    self assert: (self.probe castThenParamGreater: #{#v => nil}) equals: true
    self assert: (self.probe castThenParamGreater: #{#v => #foo}) equals: true
    self assert: (self.probe castThenParamGreater: #{#v => true}) equals: true
    // An actual Integer or Float still answers correctly.
    self assert: (self.probe castThenParamGreater: #{#v => 11}) equals: true
    self assert: (self.probe castThenParamGreater: #{#v => 7.5}) equals: false

  testWrongValueInTypedParamLessAnswersSilently =>
    // The loud local path raised `does_not_understand` for `nil < 10`;
    // through the typed parameter it answers `false`.
    self assert: (self.probe castThenParamLess: #{#v => nil}) equals: false
    self assert: (self.probe castThenParamLess: #{#v => true}) equals: false

  testSameWrongAnswerWithoutAnyCast =>
    // No narrowing annotation anywhere: a value of the wrong type reaches
    // the typed parameter straight from a dictionary read. A guard at
    // narrowing casts alone would not see this route.
    d := #{#v => nil}
    self assert: (self.probe paramGreater: (d at: #v)) equals: true
    self assert: (self.probe paramLess: (d at: #v)) equals: false

  // --- a typed field IS trusted: same silent answer, stored first -----------
  testWrongValueInTypedFieldGreaterAnswersSilently =>
    self assert: (self.probe castThenField: #{#v => nil}) equals: true
    self assert: (self.probe castThenField: #{#v => #foo}) equals: true
    self assert: (self.probe castThenField: #{#v => 7.5}) equals: false
