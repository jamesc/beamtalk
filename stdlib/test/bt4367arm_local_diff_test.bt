// BT-4367: a loop or fold that writes a local of its own conditional arm,
// as a statement or as the value of an assignment in that arm, answers what the
// same body answers at the method root, in actor and value-type methods. A
// class method's plain arm does not lower it and keeps the position error
// (pinned in `local_threading.rs`); an operand or array-literal site in an arm
// does too (a clean diagnostic, never a compiler bug). Fixtures:
// fixtures/bt4367arm_local_diff_{actor,value}.bt.

TestCase subclass: Bt4367ArmLocalDiffTest

  testActor_assign_inject_ifTrue =>
    o := Bt4367ArmLocalDiffActor spawn
    self assert: (o assign_inject_ifTrueArm: true) equals: o assign_inject_ifTrueRoot

  testValue_assign_inject_ifTrue =>
    o := Bt4367ArmLocalDiffValue new
    self assert: (o assign_inject_ifTrueArm: true) equals: o assign_inject_ifTrueRoot

  testActor_assign_inject_ifNil =>
    o := Bt4367ArmLocalDiffActor spawn
    self assert: (o assign_inject_ifNilArm: nil) equals: o assign_inject_ifNilRoot

  testValue_assign_inject_ifNil =>
    o := Bt4367ArmLocalDiffValue new
    self assert: (o assign_inject_ifNilArm: nil) equals: o assign_inject_ifNilRoot

  testActor_stmt_inject_ifTrue =>
    o := Bt4367ArmLocalDiffActor spawn
    self assert: (o stmt_inject_ifTrueArm: true) equals: o stmt_inject_ifTrueRoot

  testValue_stmt_inject_ifTrue =>
    o := Bt4367ArmLocalDiffValue new
    self assert: (o stmt_inject_ifTrueArm: true) equals: o stmt_inject_ifTrueRoot

  testActor_stmt_inject_ifNil =>
    o := Bt4367ArmLocalDiffActor spawn
    self assert: (o stmt_inject_ifNilArm: nil) equals: o stmt_inject_ifNilRoot

  testValue_stmt_inject_ifNil =>
    o := Bt4367ArmLocalDiffValue new
    self assert: (o stmt_inject_ifNilArm: nil) equals: o stmt_inject_ifNilRoot

