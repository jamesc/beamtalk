// BT-3407: classState value set via one class-method call must be visible to
// the supervisor's configuration (instance-side `childSpecs` since ADR 0135,
// which runs inside the supervisor's own `init`). See
// stdlib/test/fixtures/class_state_sup_app.bt.
//
// BT-3962: `supervise` starts the tree in the caller, so `childSpecs` can read
// the class variable through its own class (`ClassStateSupApp cfg`) while
// `ClassStateSupApp supervise` runs.

TestCase subclass: ClassStateSupervisorTest
  field: sup = nil

  tearDown => self.sup isNil ifFalse: [self.sup stop]

  testClassStateSetBeforeSuperviseIsVisibleInChildren =>
    ClassStateSupApp configure: #{#label => "hello"}
    self.sup := ClassStateSupApp supervise unwrap
    w :: ClassStateSupWorker := (self.sup which: ClassStateSupWorker) unwrap
    self assert: w label equals: "hello"
