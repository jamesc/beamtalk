  testOpenDetectBinaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a detectBinaryReadOnly) notNil

  testOpenUserHomUnaryChangingRaises =>
    a := ClosureSelfSendMatrix spawn
    self should: [a userHomUnaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testOpenUserHomUnaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a userHomUnaryReadOnly) notNil

