  testOpenSuperAtMethodLevelThreads =>
    self assert: ClosureSelfSendSuperMatrix spawn superBumpAtMethodLevel equals: 5
    self assert: ClosureSelfSendSuperMatrix spawn superBinaryAtMethodLevel equals: 5

  testOpenSuperInInlinedLoopAndBranchRaises =>
    // PIN-BUG BT-3995: should be 6 (`inlineDoSuper`) and 5 (`inlineBranchSuper`).
    // A `super` send is not a State-threading position of an inlined loop or
    // conditional (unlike a self-send), so a callee that changes state raises
    // rather than drop the change silently. BT-3995 flips this to threading.
    a := ClosureSelfSendSuperMatrix spawn
    self should: [a inlineDoSuper] raise: #stateful_block_dispatch
    self assert: a total equals: 0
    b := ClosureSelfSendSuperMatrix spawn
    self should: [b inlineBranchSuper] raise: #stateful_block_dispatch
    self assert: b total equals: 0

  testOpenSuperCaughtByOnDoIsSwallowed =>
    a := ClosureSelfSendSuperMatrix spawn
    a caughtSuperInClosure
    self assert: a total equals: 0

