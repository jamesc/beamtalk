    self assert: a userHomSuperBinaryReadOnly equals: #(-1, -2, -3)

  testSealedSuperStoredUnaryChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a storedSuperUnaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperStoredUnaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a storedSuperUnaryReadOnly equals: #(0, 0, 0)

  testSealedSuperStoredKeywordChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a storedSuperKeywordChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperStoredKeywordReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a storedSuperKeywordReadOnly equals: #(1, 2, 3)

  testSealedSuperStoredBinaryChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a storedSuperBinaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperStoredBinaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a storedSuperBinaryReadOnly equals: #(-1, -2, -3)

  testSealedSuperNestedUnaryChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a nestedSuperUnaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperNestedUnaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a nestedSuperUnaryReadOnly equals: #(#(0), #(0), #(0))

  testSealedSuperNestedKeywordChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a nestedSuperKeywordChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperNestedKeywordReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a nestedSuperKeywordReadOnly equals: #(#(1), #(2), #(3))

  testSealedSuperNestedBinaryChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a nestedSuperBinaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperNestedBinaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a nestedSuperBinaryReadOnly equals: #(#(-1), #(-2), #(-3))

  testSealedSuperBranchUnaryChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a branchSuperUnaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperBranchUnaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a branchSuperUnaryReadOnly equals: #(0, 0, 0)

  testSealedSuperBranchKeywordChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a branchSuperKeywordChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperBranchKeywordReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a branchSuperKeywordReadOnly equals: #(1, 2, 3)

  testSealedSuperBranchBinaryChangingRaises =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self should: [a branchSuperBinaryChanging] raise: #stateful_block_dispatch
    self assert: a total equals: 0

  testSealedSuperBranchBinaryReadOnlyAnswers =>
