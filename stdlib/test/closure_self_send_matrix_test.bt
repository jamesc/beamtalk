// GENERATED by the BT-3936 matrix: every self-send kind x closure host x
// open/sealed actor. Where the block is a real closure (user HOM, stored
// block) a state-changing callee must raise `stateful_block_dispatch`, never
// answer silently; where the literal block is inlined into the method the
// loop threads State and the change is kept. A read-only callee answers in
// both. A changing binary selector sent to `self` is BT-3985, not covered.

TestCase subclass: ClosureSelfSendMatrixTest

  testOpenCollectUnaryChangingThreads =>
    a := ClosureSelfSendMatrix spawn
    a collectUnaryChanging
    self assert: a total > 0

  testOpenCollectUnaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a collectUnaryReadOnly) notNil

  testOpenCollectKeywordChangingThreads =>
    a := ClosureSelfSendMatrix spawn
    a collectKeywordChanging
    self assert: a total > 0

  testOpenCollectKeywordReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a collectKeywordReadOnly) notNil

  testOpenCollectBinaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a collectBinaryReadOnly) notNil

  testOpenSelectUnaryChangingThreads =>
    a := ClosureSelfSendMatrix spawn
    a selectUnaryChanging
    self assert: a total > 0

  testOpenSelectUnaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a selectUnaryReadOnly) notNil

  testOpenSelectKeywordChangingThreads =>
    a := ClosureSelfSendMatrix spawn
