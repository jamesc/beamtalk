    a := ClosureSelfSendSuperMatrixSealed spawn
    a nestedSuperBinaryChanging
    self assert: a total equals: 6

  testSealedSuperNestedBinaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a nestedSuperBinaryReadOnly equals: #(#(-1), #(-2), #(-3))

  testSealedSuperBranchUnaryChangingKeepsTheChange =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    a branchSuperUnaryChanging
    self assert: a total equals: 3

  testSealedSuperBranchUnaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a branchSuperUnaryReadOnly equals: #(0, 0, 0)

  testSealedSuperBranchKeywordChangingKeepsTheChange =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    a branchSuperKeywordChanging
    self assert: a total equals: 6

  testSealedSuperBranchKeywordReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a branchSuperKeywordReadOnly equals: #(1, 2, 3)

  testSealedSuperBranchBinaryChangingKeepsTheChange =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    a branchSuperBinaryChanging
    self assert: a total equals: 6

  testSealedSuperBranchBinaryReadOnlyAnswers =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    self assert: a branchSuperBinaryReadOnly equals: #(-1, -2, -3)

  testSealedSuperAtMethodLevelThreads =>
    self assert: ClosureSelfSendSuperMatrixSealed spawn superBumpAtMethodLevel equals: 5
    self assert: ClosureSelfSendSuperMatrixSealed spawn superBinaryAtMethodLevel equals: 5

  testSealedSuperInInlinedLoopAndBranchThread =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    a inlineDoSuper
    self assert: a total equals: 6
    b := ClosureSelfSendSuperMatrixSealed spawn
    b inlineBranchSuper
    self assert: b total equals: 5

  testSealedSuperCaughtByOnDoKeepsTheChange =>
    a := ClosureSelfSendSuperMatrixSealed spawn
    a caughtSuperInClosure
    self assert: a total equals: 3
