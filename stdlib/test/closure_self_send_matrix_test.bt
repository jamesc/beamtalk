  testOpenReadOnlyLocalCalleesAnswer =>
    a := ClosureSelfSendMatrix spawn
    self assert: a localCondInClosure equals: #(0, 2, 3)
    self assert: a localOnDoInClosure equals: #(1, 2, 3)
    self assert: a localEnsureInClosure equals: #(1, 2, 3)
    self assert: a localCondTwiceInClosure equals: #(0, 3, 4)
    self assert: a enclosingLocalInClosure equals: 7

  testOpenCaughtByOnDoIsSwallowed =>
    a := ClosureSelfSendMatrix spawn
    a caughtInClosure
    self assert: a total equals: 0
    self assert: ((a caughtInClosureSelector) printString includesSubstring: "stateful_block_dispatch") equals: true

