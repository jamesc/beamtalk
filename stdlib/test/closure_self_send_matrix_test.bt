    self assert: a total > 0

  testOpenSelectKeywordReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a selectKeywordReadOnly) notNil

  testOpenSelectBinaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: (a selectBinaryReadOnly) notNil

