// GENERATED by the BT-3936 matrix: every self-send kind (unary, keyword,
// binary) x closure host x open/sealed actor, plus `super` sends (BT-3985).
// Where the block is a real closure (user HOM, stored block) a state-changing
// callee must raise `stateful_block_dispatch`, never answer silently; where the
// literal block is inlined into the method the loop threads State and the
// change is kept. A read-only callee answers in both. Every assertion is an
// exact value: items are #(1, 2, 3), so a changing callee sums to 3 (unary
// `bump`) or 6 (`bump: x`, `+ x`).

TestCase subclass: ClosureSelfSendMatrixTest

  testOpenCollectUnaryChangingThreads =>
    a := ClosureSelfSendMatrix spawn
    a collectUnaryChanging
    self assert: a total equals: 3

  testOpenCollectUnaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: a collectUnaryReadOnly equals: #(0, 0, 0)

  testOpenCollectKeywordChangingThreads =>
    a := ClosureSelfSendMatrix spawn
    a collectKeywordChanging
    self assert: a total equals: 6

  testOpenCollectKeywordReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: a collectKeywordReadOnly equals: #(1, 2, 3)

  testOpenCollectBinaryChangingThreads =>
    a := ClosureSelfSendMatrix spawn
    a collectBinaryChanging
    self assert: a total equals: 6

  testOpenCollectBinaryReadOnlyAnswers =>
    a := ClosureSelfSendMatrix spawn
    self assert: a collectBinaryReadOnly equals: #(-1, -2, -3)

