// BT-4515 (ADR 0145 § 2): `Object >> then: aBlock` answers `aBlock value:
// self`. It is the escape hatch for putting a value somewhere other than the
// receiver of the next message, usually after `|>`. It is an ordinary
// message, not inlined, so:
//
// - on an actor receiver the block runs in the actor's process;
// - on a class receiver it is a class-side send like any other (ADR 0142);
// - a block passed to it that assigns a captured local is an escaping block,
//   the ADR 0133 compile error (`t := 0. 3 then: [:v | t := v]` does not
//   compile; bind a temp local instead). A test file cannot hold a program
//   that does not compile, so that case is pinned in beamtalk-core
//   (`a_writing_block_passed_to_then_is_an_escaping_block`);
// - a forwarding proxy (`TimeoutProxy`) answers it itself, with the proxy as
//   the block's argument, rather than forwarding it to its target.
//
// Fixtures: fixtures/then_probe_actor.bt, fixtures/then_promise.bt,
// fixtures/in_caller_probe.bt, fixtures/in_caller_stateful.bt,
// fixtures/slow_actor.bt.

TestCase subclass: ThenTest

  // --- Value receivers ---
  testValueReceiver =>
    self assert: (3 then: [:x | x * x]) equals: 9
    self assert: ("abc" then: [:s | s size]) equals: 3

  testNilReceiverIsPassedToTheBlock =>
    self assert: (nil then: [:x | x isNil]) equals: true

  testAfterPipeline =>
    // `/` answers a Float, the mean of 20, 40 and 60.
    average := #(2, 4, 6) collect: [:x |
      x * 10
    ] |> then: [:xs | (xs inject: 0 into: [:a :b | a + b]) / xs size]
    self assert: average equals: 40.0

  testPipelineContinuesAfterThen =>
    self assert: (#(3, 1, 2) |> then: [:xs | xs sort] |> at: 1) equals: 1

  testReadsCapturedLocal =>
    offset := 10
    self assert: (5 then: [:x | x + offset]) equals: 15

  testTempLocalInsteadOfCapturedWrite =>
    // The ADR 0133 workaround: bind the result, do not assign inside.
    total := 3 then: [:x | x + 1]
    self assert: total equals: 4

  // --- Actor receivers: the block runs in the actor's process ---
  testActorReceiverRunsInTheActorProcess =>
    a := ThenProbeActor spawn
    [
      self assert: (a then: [:x | Erlang erlang self]) equals: a pid
      self deny: (a then: [:x | Erlang erlang self]) == Erlang erlang self
    ] ensure: [a stop]

  testActorReceiverPassesItself =>
    a := ThenProbeActor spawn
    [self assert: (a then: [:x | x == a]) equals: true] ensure: [a stop]

  // The block's argument is the actor itself, so a send to it from inside
  // the block is a self-send in the actor's own process, which answers.
  testActorReceiverSendToItselfAnswers =>
    a := ThenProbeActor spawn
    [
      a add: 5
      self assert: (a then: [:x | x total]) equals: 5
    ] ensure: [a stop]

  testActorAfterPipeline =>
    a := ThenProbeActor spawn
    [
      self assert: (a add: 1 |> add: 2 |> total |> then: [:n |
        n * 10
      ]) equals: 30
    ] ensure: [a stop]

  // --- Class receivers ---
  testClassReceiver =>
    self assert: (Integer then: [:c | c name]) equals: #Integer
    self assert: (InCallerProbe then: [:c | c == InCallerProbe]) equals: true

  testStatefulClassReceiver =>
    self assert: (InCallerStateful then: [:c |
      c name
    ]) equals: #InCallerStateful

  // --- A class's own `then:` wins (not sealed) ---
  testOwnThenOverrides =>
    p := (ThenPromise resolved: 2) then: [:v | v + 1]
    self assert: p class equals: ThenPromise
    self assert: p resolved equals: 3

  // --- Forwarding proxies answer `then:` themselves ---
  testTimeoutProxyAnswersThenItself =>
    target := SlowActor spawn
    proxy := target withTimeout: 30000
    [
      self assert: (proxy then: [:p | p class]) equals: TimeoutProxy
      self assert: (proxy then: [:p | p == proxy]) equals: true
    ]
      ensure: [
        proxy stop
        target stop
      ]
