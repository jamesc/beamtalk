// BT-3799 / BT-3860 / BT-3864 (ADR 0131): a local assignment in value position
// (a receiver, an operand, a literal element, an assignment's value) such as
// `(t := t + 1) > 1 ifTrue: [u := 9]` never rebinds its local (BT-3860). Until
// BT-3860 makes the shape a producer it is a `ValuePositionLocalAssignment`
// compile error in every context (BT-3864): the original shapes and their
// correct answers are in adr0131nested_assign_pending_test.bt.pending and
// fixtures/adr0131nested_assign_*_pending.bt.pending (inert).
//
// The tests below run the rewrite the error names, each assignment hoisted
// into its own statement (fixtures/adr0131nested_assign_{class,value,actor}.bt),
// and assert the correct answers in all three columns. The REPL pins are in
// tests/repl-protocol/cases/adr0131_nested_assign.btscript.

TestCase subclass: Adr0131NestedAssignTest

  testRootPlain =>
    self assert: #[Adr0131NestedAssignClass rootPlain, (Adr0131NestedAssignValue new) rootPlain, (Adr0131NestedAssignActor spawn) rootPlain] equals: #[#[1, 2], #[1, 2], #[1, 2]]

  testRootLiteral =>
    self assert: #[Adr0131NestedAssignClass rootLiteral, (Adr0131NestedAssignValue new) rootLiteral, (Adr0131NestedAssignActor spawn) rootLiteral] equals: #[#[0, 7, 7], #[0, 7, 7], #[0, 7, 7]]

  testDoPlain =>
    self assert: #[Adr0131NestedAssignClass doPlain, (Adr0131NestedAssignValue new) doPlain, (Adr0131NestedAssignActor spawn) doPlain] equals: #[2, 2, 2]

  testRootIf =>
    self assert: #[Adr0131NestedAssignClass rootIf, (Adr0131NestedAssignValue new) rootIf, (Adr0131NestedAssignActor spawn) rootIf] equals: #[#[1, 9], #[1, 9], #[1, 9]]

  // BT-3799's shape, hoisted.
  testDoIf =>
    self assert: #[Adr0131NestedAssignClass doIf, (Adr0131NestedAssignValue new) doIf, (Adr0131NestedAssignActor spawn) doIf] equals: #[#[2, 9], #[2, 9], #[2, 9]]

  testDoIfElse =>
    self assert: #[Adr0131NestedAssignClass doIfElse, (Adr0131NestedAssignValue new) doIfElse, (Adr0131NestedAssignActor spawn) doIfElse] equals: #[#[2, 10], #[2, 10], #[2, 10]]

  testDoAnd =>
    self assert: #[Adr0131NestedAssignClass doAnd, (Adr0131NestedAssignValue new) doAnd, (Adr0131NestedAssignActor spawn) doAnd] equals: #[#[2, 9], #[2, 9], #[2, 9]]

  testDoIfFalse =>
    self assert: #[Adr0131NestedAssignClass doIfFalse, (Adr0131NestedAssignValue new) doIfFalse, (Adr0131NestedAssignActor spawn) doIfFalse] equals: #[#[2, 2], #[2, 2], #[2, 2]]

  testToDoIf =>
    self assert: #[Adr0131NestedAssignClass toDoIf, (Adr0131NestedAssignValue new) toDoIf, (Adr0131NestedAssignActor spawn) toDoIf] equals: #[#[2, 9], #[2, 9], #[2, 9]]

  testTimesIf =>
    self assert: #[Adr0131NestedAssignClass timesIf, (Adr0131NestedAssignValue new) timesIf, (Adr0131NestedAssignActor spawn) timesIf] equals: #[#[2, 9], #[2, 9], #[2, 9]]

  testWhileIf =>
    self assert: #[Adr0131NestedAssignClass whileIf, (Adr0131NestedAssignValue new) whileIf, (Adr0131NestedAssignActor spawn) whileIf] equals: #[#[2, 9], #[2, 9], #[2, 9]]

  testCollectIf =>
    self assert: #[Adr0131NestedAssignClass collectIf, (Adr0131NestedAssignValue new) collectIf, (Adr0131NestedAssignActor spawn) collectIf] equals: #[#[2, 9, #(1, 2)], #[2, 9, #(1, 2)], #[2, 9, #(1, 2)]]

  testInjectIf =>
    self assert: #[Adr0131NestedAssignClass injectIf, (Adr0131NestedAssignValue new) injectIf, (Adr0131NestedAssignActor spawn) injectIf] equals: #[#[2, 9, 3], #[2, 9, 3], #[2, 9, 3]]
