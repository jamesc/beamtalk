// BT-4415: a `^` inside an inlined conditional at a method's top level is a
// direct early return (no NLR frame). Behaviour must match the NLR form:
// the returned value, the fall-through value, and actor state written before
// the return.

TestCase subclass: GuardReturnTest

  testIfTrueGuards =>
    self assert: (GuardReturnObject sign: 5) equals: 1
    self assert: (GuardReturnObject sign: -5) equals: -1
    self assert: (GuardReturnObject sign: 0) equals: 0

  testIfNilGuard =>
    self assert: (GuardReturnObject orDefault: nil) equals: #default
    self assert: (GuardReturnObject orDefault: 3) equals: 3

  testIfFalseGuard =>
    self assert: (GuardReturnObject describe: 1) equals: "some"
    self assert: (GuardReturnObject describe: nil) equals: "none"

  testTwoBranchGuardKeepsLocalRebind =>
    self assert: (GuardReturnObject local: 6) equals: 12
    self assert: (GuardReturnObject local: 2) equals: 105

  testClassSideGuard =>
    self assert: (GuardReturnObject canon: nil) equals: "nil"
    self assert: (GuardReturnObject canon: 42) equals: "42"

  testTailMatchArmReturn =>
    self assert: (GuardReturnObject classify: 0) equals: #zero
    self assert: (GuardReturnObject classify: 1) equals: #other

  testActorGuardKeepsStateWrittenBeforeReturn =>
    a := GuardReturnActor spawn
    self assert: (a bump: 20) equals: #big
    self assert: a count equals: 1
    self assert: (a bump: 2) equals: #small
    self assert: a count equals: 4

  testValueGuard =>
    v := GuardReturnValue new
    self assert: (v clamp: -3) n equals: 0
    self assert: (v clamp: 9) n equals: 99
    self assert: (v clamp: 4) n equals: 4

  testTypedComparisonGuardsWithEffects =>
    v := GuardReturnValue new
    self assert: (v bounded: -3) n equals: 0
    self assert: (v bounded: 500) n equals: 100
    self assert: (v bounded: 95) n equals: 90
    self assert: (v bounded: 42) n equals: 42
    self assert: (v positiveOnly: 7) n equals: 7
    self assert: (v positiveOnly: -7) equals: false

  testActorTypedComparisonGuardKeepsStateWrittenInBranch =>
    a := GuardReturnActor spawn
    self assert: (a bumpBig: 20) equals: 100
    self assert: a count equals: 100
    self assert: (a bumpBig: 2) equals: 102
    self assert: a count equals: 102

  testAndOrGuardsWithEffects =>
    v := GuardReturnValue new
    self assert: (v outside: -1) n equals: 0
    self assert: (v outside: 101) n equals: 0
    self assert: (v outside: 50) n equals: 5
    self assert: (v outside: 7) n equals: 7

  // An untyped guard receiver that is not a Boolean is sent the guard's own
  // selector with a block that returns from the method (BT-4244).
  testNonBooleanReceiverThatCallsTheBlockReturnsEarly =>
    r := NonBooleanCondCalling new
    self assert: (GuardReturnObject early: r) equals: #early
    self assert: (GuardReturnObject earlyIfFalse: r) equals: #early

  testNonBooleanReceiverThatIgnoresTheBlockFallsThrough =>
    r := NonBooleanCondIgnoring new
    self assert: (GuardReturnObject early: r) equals: #late
    self assert: (GuardReturnObject earlyIfFalse: r) equals: #late

  testUntypedBooleanReceiver =>
    self assert: (GuardReturnObject early: true) equals: #early
    self assert: (GuardReturnObject early: false) equals: #late
    self assert: (GuardReturnObject earlyIfFalse: false) equals: #early
    self assert: (GuardReturnObject earlyIfFalse: true) equals: #late

  testNonBooleanReceiverWithoutTheSelectorRaises =>
    self should: [GuardReturnObject early: nil] raise: #does_not_understand
    self should: [GuardReturnObject earlyIfFalse: 3] raise: #does_not_understand

  testActorNonBooleanReceiverKeepsState =>
    a := GuardReturnActor spawn
    self assert: (a early: NonBooleanCondCalling new) equals: #early
    self assert: a count equals: 0
    self assert: (a early: NonBooleanCondIgnoring new) equals: #late
    self assert: a count equals: 1
    self assert: (a early: true) equals: #early
    self assert: a count equals: 1
