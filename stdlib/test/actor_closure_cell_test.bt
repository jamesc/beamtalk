// ADR 0137 Phase 2b (BT-4009): actor closures read and write the actor state

TestCase subclass: ActorClosureCellTest

  testAddTwice =>
    c := ClosureCellCounter spawn
    self assert: c addTwice equals: 2

  testArmTick =>
    c := ClosureCellCounter spawn
    c arm
    self assert: c tick equals: 10
    self assert: c tick equals: 20

  testPeek =>
    c := ClosureCellCounter spawn
    self assert: c peek equals: 9

  testReadTwice =>
    c := ClosureCellCounter spawn
    self assert: c readTwice equals: 0

  testPeekVia =>
    c := ClosureCellCounter spawn
    self assert: (c peekVia: ClosureCellRunner spawn) equals: 0
    self assert: c n equals: 99

  testPokeVia =>
    c := ClosureCellCounter spawn
    self should: [
      c pokeVia: ClosureCellRunner spawn
    ] raise: #actor_state_unreachable

  testSelfSendInBlock =>
    c := ClosureCellCounter spawn
    self assert: c selfSendInBlock equals: 2

  testAliasSend =>
    c := ClosureCellCounter spawn
    self assert: c aliasSend equals: 5

  testAliasBump =>
    c := ClosureCellCounter spawn
    self assert: c aliasBump equals: 2

  testEnsureCleanupSeesTheBodysWritesOnANormalExit =>
    c := ClosureCellEnsure spawn
    self assert: c normalExit equals: 5

  testEnsureCleanupSeesTheBodysWritesAfterAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    self assert: (c earlyReturn: rec) equals: 1
    self assert: rec last equals: 7

  // BT-4312: a field the cleanup writes while a `^` unwinds is kept.
  testEnsureCleanupWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c cleanupWriteAfterReturn equals: 1
    self assert: c n equals: 9

  testEnsureCleanupWriteOverTheBodysWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c cleanupReadsTheBodysWriteAfterReturn equals: 1
    self assert: c n equals: 105

  testEnsureCleanupWritesOfNestedCleanupsSurviveAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c nestedCleanupsAfterReturn equals: 1
    self assert: c n equals: 200

  testEnsureCleanupWriteInALoopSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c cleanupInALoopAfterReturn equals: 2
    self assert: c n equals: 3

  testEnsureCleanupWriteInADynamicLoopSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: (c cleanupInADynamicLoopAfterReturn: #(1, 2, 3)) equals: 2
    self assert: c n equals: 3

  testEnsureCleanupWriteInAClosureSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c cleanupInAClosureAfterReturn equals: 1
    self assert: c n equals: 9

  // BT-4312: the same when the receiver or the cleanup is not a block
  // literal, so the cleanup runs as a closure that writes the cell.
  testStoredReceiverCleanupWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c storedReceiverAfterReturn equals: 1
    self assert: c n equals: 9

  testStoredCleanupWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c storedCleanupAfterReturn equals: 1
    self assert: c n equals: 9

  testStoredBlocksCleanupWriteOverTheBodysWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c storedBlocksAfterReturn equals: 1
    self assert: c n equals: 105

  testNestedStoredCleanupWritesSurviveAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c nestedStoredCleanupsAfterReturn equals: 1
    self assert: c n equals: 200

  testPassedCleanupWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c passedCleanupAfterReturn equals: 1
    self assert: c n equals: 9

  testStoredCleanupWriteInALoopSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c storedCleanupInALoopAfterReturn equals: 2
    self assert: c n equals: 2

  testStoredCleanupWriteInAClosureSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c storedCleanupInAClosureAfterReturn equals: 1
    self assert: c n equals: 9

  // BT-4429: the same when `ensure:` is sent with `perform:`, so the
  // `Block>>ensure:` fallback runs it.
  testPerformedEnsureCleanupWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c performedCleanupAfterReturn equals: 1
    self assert: c n equals: 9

  testPerformedEnsureCleanupWriteOverTheBodysWriteSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c performedCleanupOverTheBodysWriteAfterReturn equals: 1
    self assert: c n equals: 105

  // BT-4448: a `^` block run away from home, by another actor of the same
  // class in an equal state, keeps its own actor's state: the peer's
  // cleanup write is not taken for it.
  testPerformedEnsureInAPeerDoesNotTakeThePeersState =>
    a := ClosureCellEnsure spawn
    b := ClosureCellEnsure spawn
    self assert: (a returnThroughPeer: b) equals: 1
    self assert: a n equals: 0
    // The `^` leaves `b`'s callback by a throw, so `b` keeps its entry state.
    self assert: b n equals: 0

  testNestedPerformedEnsureCleanupWritesSurviveAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c nestedPerformedCleanupsAfterReturn equals: 1
    self assert: c n equals: 200

  testPerformedEnsureInsideACompiledEnsureKeepsBothCleanupWrites =>
    c := ClosureCellEnsure spawn
    self assert: c performedInsideCompiledCleanupsAfterReturn equals: 1
    self assert: c n equals: 200

  testCompiledEnsureInsideAPerformedEnsureKeepsBothCleanupWrites =>
    c := ClosureCellEnsure spawn
    self assert: c compiledInsidePerformedCleanupsAfterReturn equals: 1
    self assert: c n equals: 200

  testPerformedEnsureCleanupWriteInALoopSurvivesAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    self assert: c performedCleanupInALoopAfterReturn equals: 2
    self assert: c n equals: 2

  // PIN-BUG BT-4459: a block this actor created, run by another actor,
  // returns here with its creation-time capture, and the method commits that
  // copy: the write made after the block's creation is lost (should be 5).
  testAwayBlocksReturnKeepsTheOwnersWritesSinceItsCreation =>
    a := ClosureCellOwner spawn
    b := ClosureCellOwner spawn
    self assert: (a run: b) equals: 1
    self assert: a n equals: 0
    // The `^` leaves `b`'s callback by a throw, so `b` keeps its entry state.
    self assert: b n equals: 0

  // PIN-BUG BT-4459: the same through a `perform:`ed `ensure:` in the owner
  // (should be 6: the write after creation, then the cleanup's).
  testAwayBlocksReturnThroughAPerformedEnsureKeepsBothWrites =>
    a := ClosureCellOwner spawn
    b := ClosureCellOwner spawn
    self assert: (a runThroughPerformedEnsure: b) equals: 1
    self assert: a n equals: 0
    self assert: b n equals: 0

  // PIN-BUG BT-4459: a foreign `^` through another method's inlined
  // `ensure: [self.n := 40]`: the cleanup stored its write to the cell, but
  // the method commits the carried copy (should be 40).
  testForeignReturnThroughAnInlinedEnsureCommitsTheCleanupsWrite =>
    a := ClosureCellOwner spawn
    self assert: a foreignReturnThroughEnsure equals: 3
    self assert: a n equals: 0

  // ADR 0146 R1 (BT-4534): a `^` from a block passed to another method of
  // the same actor unwinds through that method's inlined `ensure:`; the
  // cleanup's write is in the cell while the `^` is in flight, so the
  // owner's own cleanup reads it. (What the owner finally commits is
  // BT-4535's.)
  testForeignReturnLeavesTheCleanupsWriteInTheCell =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    self assert: (c foreignReturnThroughEnsure: rec) equals: 3
    self assert: rec last equals: 40

  testForeignReturnLeavesTheCleanupsWriteAfterACallInTheCell =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    self assert: (c foreignReturnThroughEnsureAfterACall: rec) equals: 3
    self assert: rec last equals: 41

  testEnsureCleanupSeesTheBodysLexicalWritesAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c errorExit: rec
    self assert: rec last equals: 9

  testEnsureCleanupSeesTheStateAtEntryAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c entryState: rec
    self assert: rec last equals: 3

  // BT-3988: `on:do:` / `ensure:` in a closure whose body self-sends answers the
  // plain result, in open and sealed actors.
  testOnDoInAClosureWithASelfSend =>
    self assert: ClosureCellP spawn run equals: #(0, 0, 0)

  testOnDoInAClosureWithASelfSendSealed =>
    self assert: ClosureCellSealedP spawn run equals: #(0, 0, 0)

  testEnsureInAClosureWithASelfSend =>
    self assert: ClosureCellP spawn runEnsure equals: #(0, 0, 0)

  testEnsureInAClosureWithASelfSendSealed =>
    self assert: ClosureCellSealedP spawn runEnsure equals: #(0, 0, 0)

  testOnDoInAClosureWithAWritingSelfSend =>
    p := ClosureCellP spawn
    self assert: p runWriting equals: #(1, 2, 3)
    self assert: p total equals: 3

  testOnDoInAClosureWithAWritingSelfSendSealed =>
    p := ClosureCellSealedP spawn
    self assert: p runWriting equals: #(1, 2, 3)
    self assert: p total equals: 3

  // A state-changing `super` send in a loop body keeps its change.
  testSuperSendInAWhileLoop =>
    self assert: ClosureCellSuperChild spawn whileLoop equals: 3

  testSuperSendInAToDoLoop =>
    self assert: ClosureCellSuperChild spawn toDoLoop equals: 3

  testSuperSendInATimesRepeatLoop =>
    self assert: ClosureCellSuperChild spawn timesLoop equals: 3

  testSuperSendInADoLoop =>
    self assert: ClosureCellSuperChild spawn doLoop equals: 3

  testEnsureCleanupSeesLoopWritesAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c loopError: rec
    self assert: rec last equals: 3

  testEnsureCleanupSeesASelfSendsWriteAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c selfSendError: rec
    self assert: rec last equals: 1

  // A stored block run by a foreign `dispatch/4` exit keeps its write.
  testStoredBlockRunByPerformKeepsItsWrite =>
    c := ClosureCellForeignExit spawn
    self assert: c viaPerform equals: 9
    self assert: c n equals: 9

  testStoredBlockRunByPerformWithTwoBlocksKeepsItsWrite =>
    c := ClosureCellForeignExit spawn
    self assert: c viaPerformTwoBlocks equals: 11
    self assert: c n equals: 11

  testStoredBlockRunDirectlyKeepsItsWrite =>
    c := ClosureCellForeignExit spawn
    self assert: c direct equals: 7
    self assert: c n equals: 7

  testCompiledMethodWithOnDoStoreReachedByPerformKeepsFinalState =>
    c := ClosureCellForeignExit spawn
    self assert: c runStores equals: 3
    self assert: c n equals: 3

  testCompiledMethodWithEnsureStoreReachedByPerformKeepsFinalState =>
    c := ClosureCellForeignExit spawn
    self assert: c runStoresEnsure equals: 5
    self assert: c n equals: 5

  testCompiledMethodWithEarlyReturnStoreReachedByPerform =>
    c := ClosureCellForeignExit spawn
    self assert: c runStoresEarlyReturn equals: 6
    self assert: c n equals: 6

  testCompiledMethodReturningToEntryValueAfterStoreKeepsFinalState =>
    c := ClosureCellForeignExit spawn
    self assert: c runStoresBackToEntry equals: 2
    self assert: c n equals: 2

  testSuperBlockRunByAnotherActorLeavesItsStateAlone =>
    a := ClosureCellSuperChild spawn
    a bump
    a bump
    b := ClosureCellSuperChild spawn
    self assert: (b runBlock: a peekBlock) equals: 2
    // The `^` leaves `b`'s callback by a throw, so `b` keeps its entry state.
    self assert: b n equals: 0
    self assert: a n equals: 2

  // While an away `super` runs, the cell holds the other actor's state: a
  // block of the host actor running inside the call reads its own capture,
  // not the other actor's fields.
  testAwaySuperRunningHostBlockReadsHostField =>
    a := ClosureCellSuperChild spawn
    a bump
    a bump
    b := ClosureCellSuperChild spawn
    self assert: (b runSuperApplyOnOwnRead: a superApplyBlock) equals: 0
    // The `^` leaves `b`'s callback by a throw, so `b` keeps its entry state.
    self assert: b n equals: 0
    self assert: a n equals: 2

  testAwaySuperRunningHostBlockWriteRaises =>
    a := ClosureCellSuperChild spawn
    b := ClosureCellSuperChild spawn
    self should: [
      b runSuperApplyOnOwnWrite: a superApplyBlock
    ] raise: #actor_state_unreachable
    // The `^` leaves `b`'s callback by a throw, so `b` keeps its entry state.
    self assert: b n equals: 0
    self assert: a n equals: 0

  // A self-send from a host block running inside an away `super` cannot be
  // served (the host's callback is blocked in that call): it raises
  // `deadlock_detected` instead of misreporting the live actor as dead.
  testAwaySuperRunningHostSelfSendRaisesDeadlock =>
    a := ClosureCellSuperChild spawn
    b := ClosureCellSuperChild spawn
    self should: [
      b runSuperApplyOnOwnSelfSend: a superApplyBlock
    ] raise: #deadlock_detected
    // The `^` leaves `b`'s callback by a throw, so `b` keeps its entry state.
    self assert: b n equals: 0
    self assert: a n equals: 0

  // BT-4122 item 5: the protected region commits a write to the host's cell
  // and then raises. The catch runs away from the block's home, so the
  // host's committed write survives instead of being rolled back.
  testAwayOnDoCatchLeavesHostCellWritesAlone =>
    a := ClosureCellRestoreAway spawn
    b := ClosureCellRestoreHost spawn
    self assert: (b run: (a guardedBlock: b)) equals: 7
    self assert: b m equals: 1
