// ADR 0137 Phase 2b (BT-4009): actor closures read and write the actor state

TestCase subclass: ActorClosureCellTest

  testAddTwice =>
    c := ClosureCellCounter spawn
    self assert: c addTwice equals: 2

  testArmTick =>
    c := ClosureCellCounter spawn
    c arm
    self assert: c tick equals: 10
    self assert: c tick equals: 20

  testPeek =>
    c := ClosureCellCounter spawn
    self assert: c peek equals: 9

  testReadTwice =>
    c := ClosureCellCounter spawn
    self assert: c readTwice equals: 0

  testPeekVia =>
    c := ClosureCellCounter spawn
    self assert: (c peekVia: ClosureCellRunner spawn) equals: 0
    self assert: c n equals: 99

  testPokeVia =>
    c := ClosureCellCounter spawn
    self should: [
      c pokeVia: ClosureCellRunner spawn
    ] raise: #actor_state_unreachable

  testSelfSendInBlock =>
    c := ClosureCellCounter spawn
    self assert: c selfSendInBlock equals: 2

  testAliasSend =>
    c := ClosureCellCounter spawn
    self assert: c aliasSend equals: 5

  testAliasBump =>
    c := ClosureCellCounter spawn
    self assert: c aliasBump equals: 2

  testEnsureCleanupSeesTheBodysWritesOnANormalExit =>
    c := ClosureCellEnsure spawn
    self assert: c normalExit equals: 5

  testEnsureCleanupSeesTheBodysWritesAfterAnEarlyReturn =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    self assert: (c earlyReturn: rec) equals: 1
    self assert: rec last equals: 7

  testEnsureCleanupSeesTheBodysLexicalWritesAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c errorExit: rec
    self assert: rec last equals: 9

  testEnsureCleanupSeesTheStateAtEntryAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c entryState: rec
    self assert: rec last equals: 3

  // BT-3988: `on:do:` / `ensure:` in a closure whose body self-sends answers the
  // plain result, in open and sealed actors.
  testOnDoInAClosureWithASelfSend =>
    self assert: ClosureCellP spawn run equals: #(0, 0, 0)

  testOnDoInAClosureWithASelfSendSealed =>
    self assert: ClosureCellSealedP spawn run equals: #(0, 0, 0)

  testEnsureInAClosureWithASelfSend =>
    self assert: ClosureCellP spawn runEnsure equals: #(0, 0, 0)

  testEnsureInAClosureWithASelfSendSealed =>
    self assert: ClosureCellSealedP spawn runEnsure equals: #(0, 0, 0)

  testOnDoInAClosureWithAWritingSelfSend =>
    p := ClosureCellP spawn
    self assert: p runWriting equals: #(1, 2, 3)
    self assert: p total equals: 3

  testOnDoInAClosureWithAWritingSelfSendSealed =>
    p := ClosureCellSealedP spawn
    self assert: p runWriting equals: #(1, 2, 3)
    self assert: p total equals: 3

  // A state-changing `super` send in a loop body keeps its change.
  testSuperSendInAWhileLoop =>
    self assert: ClosureCellSuperChild spawn whileLoop equals: 3

  testSuperSendInAToDoLoop =>
    self assert: ClosureCellSuperChild spawn toDoLoop equals: 3

  testSuperSendInATimesRepeatLoop =>
    self assert: ClosureCellSuperChild spawn timesLoop equals: 3

  testSuperSendInADoLoop =>
    self assert: ClosureCellSuperChild spawn doLoop equals: 3

  testEnsureCleanupSeesLoopWritesAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c loopError: rec
    self assert: rec last equals: 3

  testEnsureCleanupSeesASelfSendsWriteAfterAnError =>
    c := ClosureCellEnsure spawn
    rec := ClosureCellRecorder spawn
    c selfSendError: rec
    self assert: rec last equals: 1

  // A stored block run by a foreign `dispatch/4` exit keeps its write.
  testStoredBlockRunByPerformKeepsItsWrite =>
    c := ClosureCellForeignExit spawn
    self assert: c viaPerform equals: 9
    self assert: c n equals: 9

  testStoredBlockRunByPerformWithTwoBlocksKeepsItsWrite =>
    c := ClosureCellForeignExit spawn
    self assert: c viaPerformTwoBlocks equals: 11
    self assert: c n equals: 11

  testStoredBlockRunDirectlyKeepsItsWrite =>
    c := ClosureCellForeignExit spawn
    self assert: c direct equals: 7
    self assert: c n equals: 7

  testCompiledMethodWithOnDoStoreReachedByPerformKeepsFinalState =>
    c := ClosureCellForeignExit spawn
    self assert: c runStores equals: 3
    self assert: c n equals: 3

  testCompiledMethodWithEnsureStoreReachedByPerformKeepsFinalState =>
    c := ClosureCellForeignExit spawn
    self assert: c runStoresEnsure equals: 5
    self assert: c n equals: 5

  testCompiledMethodWithEarlyReturnStoreReachedByPerform =>
    c := ClosureCellForeignExit spawn
    self assert: c runStoresEarlyReturn equals: 6
    self assert: c n equals: 6

  testCompiledMethodReturningToEntryValueAfterStoreKeepsFinalState =>
    c := ClosureCellForeignExit spawn
    self assert: c runStoresBackToEntry equals: 2
    self assert: c n equals: 2

  testSuperBlockRunByAnotherActorLeavesItsStateAlone =>
    a := ClosureCellSuperChild spawn
    a bump
    a bump
    b := ClosureCellSuperChild spawn
    self assert: (b runBlock: a peekBlock) equals: 2
    self assert: b n equals: 0
    self assert: a n equals: 2
