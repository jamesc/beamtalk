// BT-3704 (ADR 0130 Phase 1): the class-variable semantics matrix for the
// subclass override (base rows, subclass writer). The rows are in
// fixtures/class_var_semantics_matrix_test.bt.

ClassVarSemanticsMatrixTest subclass: ClassVarSemanticsOverrideTest

  subject => CvsOverrideSub

  initSubject => CvsInitOverrideSub

  // The snapshot row uses a reader CvsOverrideSub defines itself (BT-4300:
  // an inherited one is found too, see below).
  snapshotSelector => #snapshotN

  // ADR 0130 §5 runtime-owned snapshot, override only. BT-4300:
  // performLocally: walks the receiving class's class-method chain, so an
  // inherited selector is found and reads the subclass's own snapshot (it used
  // to raise does_not_understand).
  testPerformLocallyFindsInheritedSelector =>
    CvsOverrideSub reset
    CvsOverrideSub bump
    self assert: (CvsOverrideSub performLocally: #n withArguments: #()) equals: 1
