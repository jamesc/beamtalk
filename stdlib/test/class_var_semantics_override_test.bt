// BT-3704 (ADR 0130 Phase 1): the class-variable semantics matrix for the
// subclass override (base rows, subclass writer). The rows are in
// fixtures/class_var_semantics_matrix_test.bt.

ClassVarSemanticsMatrixTest subclass: ClassVarSemanticsOverrideTest

  subject => CvsOverrideSub

  initSubject => CvsInitOverrideSub

  // performLocally: does not walk the superclass chain, so the snapshot row
  // uses a reader CvsOverrideSub defines itself.
  snapshotSelector => #snapshotN

  // ADR 0130 §5 runtime-owned snapshot, override only: performLocally: does not
  // walk the superclass chain (documented limit), so an inherited selector is
  // not found.
  testPerformLocallyInheritedSelectorNotFound =>
    CvsOverrideSub reset
    CvsOverrideSub bump
    self
      assert: ([
        CvsOverrideSub performLocally: #n withArguments: #()
      ] on: Error do: [:e | e kind])
      equals: #does_not_understand
