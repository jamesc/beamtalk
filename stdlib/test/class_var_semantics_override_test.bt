// BT-3704 (ADR 0130 Phase 1): the class-variable semantics matrix for the
// subclass override (base rows, subclass writer). Each test asserts the ADR 0130 section 4/5 answer; a test
// whose answer differed before ADR 0130 pinned the old answer under a PIN-BUG marker
// citing BT-3713; BT-3713 flipped every such pin to the ADR answer.

TestCase subclass: ClassVarSemanticsOverrideTest

  // ADR 0130 §4
  testTop => self assert: CvsOverrideSub rowTop equals: 2

  // ADR 0130 §4
  testArm =>
    self assert: (CvsOverrideSub rowArm: 1) equals: 1
    self assert: (CvsOverrideSub rowArm: 0) equals: 0

  // ADR 0130 §4
  testLetrecTimes => self assert: CvsOverrideSub rowTimes equals: 3

  // ADR 0130 §4
  testLetrecTimesLocal => self assert: CvsOverrideSub rowTimesLocal equals: 3

  // ADR 0130 §4
  testLetrecToDoLocal => self assert: CvsOverrideSub rowToDoLocal equals: 3

  // ADR 0130 §4
  testLetrecWhileLocal => self assert: CvsOverrideSub rowWhileLocal equals: 3

  // ADR 0130 §4
  testFoldDo => self assert: CvsOverrideSub rowDo equals: 3

  // ADR 0130 §4
  testFoldDoThreaded => self assert: CvsOverrideSub rowDoLocal equals: 3

  // ADR 0130 §4
  testFoldCollectThreaded =>
    self assert: CvsOverrideSub rowCollectLocal equals: 3

  // ADR 0130 §4
  testFoldInjectThreaded => self assert: CvsOverrideSub rowInjectLocal equals: 3

  // ADR 0130 §4
  testFoldCollect => self assert: CvsOverrideSub rowCollect equals: 3

  // ADR 0130 §4
  testFoldInject => self assert: CvsOverrideSub rowInject equals: 3

  // ADR 0130 §4 catch boundary
  testOnDoBodyDiscardsWriteBeforeRaise =>
    self assert: CvsOverrideSub rowOnBodyRaise equals: 0

  // ADR 0130 §4 catch boundary
  testOnDoBodyKeepsWriteWhenNoError =>
    self assert: CvsOverrideSub rowOnBodyOk equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoBodyKeepsWriteMadeBeforeTheRegion =>
    self assert: CvsOverrideSub rowOnBodyAfterWrite equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoBodyDiscardsWriteOfFailingSend =>
    self assert: CvsOverrideSub rowOnBodyViaSend equals: 0

  // ADR 0130 §4 catch boundary
  testOnDoHandlerKeepsItsWrite =>
    self assert: CvsOverrideSub rowHandler equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoHandlerKeepsItsWriteBodyWriteDiscarded =>
    self assert: CvsOverrideSub rowHandlerAfterBodyWrite equals: 1

  // ADR 0130 §4 ensure is not a boundary
  testEnsureKeepsBothWrites => self assert: CvsOverrideSub rowEnsure equals: 2

  // ADR 0130 §4 ensure is not a boundary
  testEnsureCleanupWriteGoesWithTheError =>
    self assert: CvsOverrideSub rowEnsureRaise equals: 0

  // ADR 0130 §5 at home
  testBareBlock => self assert: CvsOverrideSub rowBare equals: 1

  // ADR 0130 §5 at home
  testStoredClosureWithinInvocationWrites =>
    self assert: CvsOverrideSub rowStoredWithin equals: 2

  // ADR 0130 §5 at home
  testStoredClosureWithinInvocationReadsLive =>
    self assert: CvsOverrideSub rowStoredReadWithin equals: 1

  // ADR 0130 §5 later invocation of the same class is at home
  testStoredClosureLaterInvocationWrites =>
    CvsOverrideSub reset
    CvsOverrideSub run: CvsOverrideSub makeBumper
    self assert: CvsOverrideSub n equals: 1

  // ADR 0130 §5 later invocation of the same class is at home
  testStoredClosureLaterInvocationReadsLive =>
    CvsOverrideSub reset
    b := CvsOverrideSub makeReader
    CvsOverrideSub bump
    self assert: (CvsOverrideSub run: b) equals: 1

  // ADR 0130 §5 abroad: captured read
  testClosureFromForeignProcessReadsCaptured =>
    CvsOverrideSub reset
    b := CvsOverrideSub makeReader
    CvsOverrideSub bump
    self assert: b value equals: 0

  // ADR 0130 §5 abroad: write raises
  // The error comes from the block's method-level read inside `bump`, which has no capture
  // (a block abroad reads only what its own literal captured); either way the kind is the
  // structured class_state_unreachable and nothing is written.
  testClosureFromForeignProcessWriteRaises =>
    CvsOverrideSub reset
    b := CvsOverrideSub makeBumper
    self should: [b value] raise: #class_state_unreachable
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 carried synchronously: captured equals live
  testSyncBlockToOpenDriverReadsLive =>
    self assert: CvsOverrideSub rowSyncReadOpenDriver equals: 1

  // ADR 0130 §5 abroad: write raises
  testSyncBlockToOpenDriverWriteRaises =>
    CvsOverrideSub reset
    self should: [
      CvsOverrideSub rowSyncWriteOpenDriver
    ] raise: #class_state_unreachable
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 direct-called class method is at home
  testSyncBlockToSealedDriverReadsLive =>
    self assert: CvsOverrideSub rowSyncReadSealedDriver equals: 1

  // ADR 0130 §5 direct-called class method is at home
  testSyncBlockToSealedDriverWrites =>
    self assert: CvsOverrideSub rowSyncWriteSealedDriver equals: 1

  // ADR 0130 §5 carried asynchronously: creation-time value
  testAsyncBlockToActorReadsCreationValue =>
    self assert: CvsOverrideSub rowAsyncRead equals: 0

  // ADR 0130 §5 abroad: write raises
  testAsyncBlockToActorWriteRaises =>
    self assert: CvsOverrideSub rowAsyncWrite equals: #class_state_unreachable
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  testSyncDirectWriteToOpenDriverRaisesWriteError =>
    CvsOverrideSub reset
    self assertWriteAbroadRaises: [CvsOverrideSub rowSyncDirectWriteOpenDriver]
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  testAsyncDirectWriteToActorRaisesWriteError =>
    CvsOverrideSub reset
    self assertWriteAbroadRaises: [CvsOverrideSub rowAsyncDirectWrite]
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  // The closure is kept by the test across a later invocation of the class,
  // then run from the test's process.
  testStoredClosureDirectWriteRaisesWriteError =>
    CvsOverrideSub reset
    b := CvsOverrideSub makeWriter
    CvsOverrideSub reset
    self assertWriteAbroadRaises: [b value]
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  testReturnedClosureDirectWriteRaisesWriteError =>
    CvsOverrideSub reset
    self assertWriteAbroadRaises: [CvsOverrideSub makeWriter value]
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §5 control: the same direct-write block run from a later
  // invocation of the class is at home and writes live (BT-3760)
  testDirectWriteClosureLaterInvocationWrites =>
    CvsOverrideSub reset
    CvsOverrideSub run: CvsOverrideSub makeWriter
    self assert: CvsOverrideSub n equals: 5

  // ADR 0130 §5 runtime-owned snapshot
  // performLocally: does not walk the superclass chain (documented limit), so an inherited
  // selector is not found; a selector the class itself defines reads the snapshot.
  testPerformLocallyInheritedSelectorNotFound =>
    CvsOverrideSub reset
    CvsOverrideSub bump
    self
      assert: ([
        CvsOverrideSub performLocally: #n withArguments: #()
      ] on: Error do: [:e | e kind])
      equals: #does_not_understand

  // ADR 0130 §5 runtime-owned snapshot
  testPerformLocallyReadsSnapshot =>
    CvsOverrideSub reset
    CvsOverrideSub bump
    self assert: (CvsOverrideSub performLocally: #snapshotN withArguments: #()) equals: 1

  // ADR 0130 §5 runtime-owned snapshot
  testPerformLocallyWriteRaises =>
    CvsOverrideSub reset
    self
      assert: ([
        CvsOverrideSub performLocally: #bump withArguments: #()
      ] on: Error do: [:e | e kind])
      equals: #class_state_read_only
    self assert: CvsOverrideSub n equals: 0

  // ADR 0130 §4 non-local return
  testOwnNlrKeepsWriteBeforeCaret =>
    self assert: CvsOverrideSub rowOwnNlr equals: 1
    self assert: CvsOverrideSub n equals: 1

  // ADR 0130 §4 non-local return
  testOwnNlrThroughEnsureKeepsBothWrites =>
    self assert: CvsOverrideSub rowOwnNlrEnsure equals: 7
    self assert: CvsOverrideSub n equals: 2

  // ADR 0130 §4 non-local return
  testForeignNlrThroughOpenDriverKeepsEarlierWrite =>
    self assert: CvsOverrideSub rowForeignNlrAfterWrite equals: 5
    self assert: CvsOverrideSub n equals: 1

  // ADR 0130 §4 non-local return
  testForeignNlrThroughSealedDriverKeepsWriteBeforeCaret =>
    self assert: CvsOverrideSub rowForeignNlrSealedDriver equals: 5
    self assert: CvsOverrideSub n equals: 1

  // ADR 0130 §5 runtime-owned snapshot
  testInitializeHookWriteRaises =>
    CvsInitOverrideSub reset
    self should: [CvsInitOverrideSub supervise] raise: #class_state_read_only
    self assert: CvsInitOverrideSub n equals: 0

  // ADR 0130 §5 (BT-3760): the write error, not the read error: kind
  // class_state_unreachable, a message saying n cannot be *written* from this
  // process, and the hint's remedy.
  assertWriteAbroadRaises: aBlock =>
    e := aBlock on: Error do: [:ex | ex]
    self assert: (e isKindOf: Error) equals: true
    self assert: e kind equals: #class_state_unreachable
    self assert: (e message includesSubstring: "class variable n cannot be written from this process") equals: true
    self assert: (e hint includesSubstring: "return the value and assign it there") equals: true
