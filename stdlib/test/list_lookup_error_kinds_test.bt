// BUnit tests for the non-empty List lookup failures (BT-3025).
//
// `detect:` with no match, and `from:to:` with a malformed start index, both
// used to raise `does_not_understand` — a dispatch failure. The List
// understands both selectors perfectly well; one search came up empty and the
// other was handed a bad index. Reporting a dispatch failure sent readers
// hunting for a typo and left `on:do:` unable to tell either case apart from a
// genuinely misspelled selector.
//
// These are the sibling conditions to the empty-collection ones covered in
// `empty_collection_access_test.bt` (BT-3021) — neither of these receivers is
// empty.

TestCase subclass: ListLookupErrorKindsTest

  // ==========================================================================
  // detect: — a search that ran to completion without matching
  // ==========================================================================
  // The List is full — of non-matches. That is why `not_found` rather than
  // `empty_collection`: nothing here is empty.
  testDetectWithNoMatchRaisesNotFound =>
    self should: [#(1, 2, 3) detect: [:x | x > 10]] raise: #not_found

  // `detect:` is a search, not an element accessor, so an empty receiver is
  // just the degenerate no-match case and reports the same kind.
  testDetectOnEmptyListAlsoRaisesNotFound =>
    self should: [#() detect: [:x | x > 10]] raise: #not_found

  testDetectMessageNamesTheCondition =>
    message := [#(1, 2, 3) detect: [:x | x > 10]] on: Error do: [:e | e message]
    self assert: (message includesSubstring: "no matching element")
    self deny: (message includesSubstring: "does not understand")

  // not_found classifies as RuntimeError, so `on:do:` can discriminate it
  // from an unrelated failure raised by the same block.
  testNotFoundIsCatchableAsRuntimeError =>
    caught := [
      #(1, 2, 3) detect: [:x | x > 10]
    ] on: RuntimeError do: [:e | "caught"]
    self assert: caught equals: "caught"

  testDetectStillAnswersTheFirstMatch =>
    self assert: (#(1, 2, 3) detect: [:x | x > 1]) equals: 2

  // detect:ifNone: stays the non-raising alternative.
  testDetectIfNoneDoesNotRaise =>
    self assert: (#(1, 2, 3) detect: [:x | x > 10] ifNone: [0]) equals: 0

  // ==========================================================================
  // from:to: — a start index below 1 is malformed, matching at:
  // ==========================================================================
  testFromToNegativeStartRaisesIndexOutOfBounds =>
    self should: [#(1, 2, 3) from: -1 to: 2] raise: #index_out_of_bounds

  testFromToZeroStartRaisesIndexOutOfBounds =>
    self should: [#(1, 2, 3) from: 0 to: 2] raise: #index_out_of_bounds

  // The same kind `at:` raises for a sub-1 index — the two agree.
  testFromToAgreesWithAtOnMalformedIndex =>
    self should: [#(1, 2, 3) at: 0] raise: #index_out_of_bounds
    self should: [#(1, 2, 3) from: 0 to: 2] raise: #index_out_of_bounds

  testFromToMessageNamesTheCondition =>
    message := [#(1, 2, 3) from: -1 to: 2] on: Error do: [:e | e message]
    self assert: (message includesSubstring: "index out of bounds")
    self deny: (message includesSubstring: "does not understand")

  testFromToIndexOutOfBoundsIsCatchableAsRuntimeError =>
    caught := [#(1, 2, 3) from: -1 to: 2] on: RuntimeError do: [:e | "caught"]
    self assert: caught equals: "caught"

  // ==========================================================================
  // The total cases stay total — only a sub-1 start raises
  // ==========================================================================
  testFromToInRangeAnswersSubsequence =>
    self assert: (#(10, 20, 30, 40) from: 2 to: 3) equals: #(20, 30)

  // An end below the start is an empty range, not an error.
  testFromToEndBelowStartAnswersEmptyList =>
    self assert: (#(1, 2, 3) from: 3 to: 1) equals: #()

  // An end past the last index is clamped rather than raising.
  testFromToEndPastSizeIsClamped =>
    self assert: (#(1, 2, 3) from: 2 to: 99) equals: #(2, 3)

  // A start past the last index answers empty — it is in range shape, just
  // beyond the data.
  testFromToStartPastSizeAnswersEmptyList =>
    self assert: (#(1, 2, 3) from: 9 to: 12) equals: #()
