// StackFrame introspection tests - migrated from bootstrap/stack_frames.bt (BT-827)

TestCase subclass: StackFrameTest
  field: frame = nil

  setUp => self withFrame: ([1 / 0] on: Exception do: [:e | e stackTrace first])

  testStackTraceExists =>
    // stackTrace returns a list
    result := [1 / 0] on: Exception do: [:e | e stackTrace class]
    self assert: result equals: List

  testStackTraceHasEntries =>
    // stackTrace has entries
    result := [1 / 0] on: Exception do: [:e | e stackTrace size > 0]
    self assert: result

  testStackTraceFromDoesNotUnderstand =>
    // stackTrace from does_not_understand has entries
    @expect dnu
    result := [42 noSuchMethod] on: Exception do: [:e | e stackTrace size > 0]
    self assert: result

  testHandlerWithoutArg =>
    // Handler without arg still works
    result := [1 / 0] on: Exception do: [42]
    self assert: result equals: 42

  testRuntimeErrorStackTrace =>
    // RuntimeError also has stackTrace
    @expect dnu
    result := [42 noSuchMethod] on: RuntimeError do: [:e | e stackTrace class]
    self assert: result equals: List

  testStackFrameClass =>
    // stackTrace first is a StackFrame
    result := [1 / 0] on: Exception do: [:e | e stackTrace first class]
    self assert: result equals: StackFrame

  testStackFrameMethod =>
    // StackFrame method returns a Symbol
    result := [1 / 0] on: Exception do: [:e | (e stackTrace first method) class]
    self assert: result equals: Symbol

  testStackFrameArguments =>
    // StackFrame arguments returns an Integer (arity)
    result := [
      1 / 0
    ] on: Exception do: [:e | (e stackTrace first arguments) class]
    self assert: result equals: Integer

  testStackFramePrintString =>
    // StackFrame printString returns a String
    result := [
      1 / 0
    ] on: Exception do: [:e | (e stackTrace first printString) class]
    self assert: result equals: String

  testStackFrameAccessors =>
    // StackFrame accessors return values without error
    self assert: self.frame class equals: StackFrame
    // line, file, moduleName, receiverClass, sourceLocation may return nil or a value
    // Verify they respond without crashing
    self assert: (self.frame respondsTo: #line)
    self assert: (self.frame respondsTo: #file)
    self assert: (self.frame respondsTo: #moduleName)
    self assert: (self.frame respondsTo: #receiverClass)
    self assert: (self.frame respondsTo: #sourceLocation)

  // === BT-1761: Object-inherited methods work after removing module_for_value override ===
  testDisplayString =>
    // displayString is inherited from Object, not defined on StackFrame
    result := self.frame displayString
    self assert: (result isKindOf: String)

  testRespondsToDisplayString =>
    self assert: (self.frame respondsTo: #displayString)

  testRespondsToHash => self assert: (self.frame respondsTo: #hash)

  testRespondsToIsNil => self assert: (self.frame respondsTo: #isNil)

  testIsNilReturnsFalse => self deny: self.frame isNil

  testHash =>
    result := self.frame hash
    self assert: (result isKindOf: Integer)

  testRespondsToNonExistentMethod =>
    self deny: (self.frame respondsTo: #totallyBogusMethod)

  // BT-3127: the compiled Core Erlang carries a `-|` annotation with this
  // file's real .bt source position, so the runtime stack trace's frame
  // reports the exact line of the erroring message send below — not the
  // enclosing .erl module or a nil placeholder. If a line above this comment
  // shifts, update the expected line number below to match.
  testStackFrameLineMatchesSourcePosition =>
    frame := [1 / 0] on: Exception do: [:e | e stackTrace first]
    self assert: frame line equals: 101

  testStackFrameFileMatchesSourcePosition =>
    self assert: (self.frame file endsWith: "stack_frame_test.bt")
