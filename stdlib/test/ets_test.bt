// BUnit tests for Ets class (BT-1189)

TestCase subclass: EtsTest
  field: table = nil

  setUp => self withTable: (Ets new: #etsTest type: #set)

  tearDown =>
    self.table isNil ifFalse: [[self.table delete] on: Error do: [:e | nil]]

  testInsertAndLookup =>
    self.table at: "key" put: "value"
    self assert: (self.table at: "key") equals: "value"

  testLookupMissingKeyReturnsNil =>
    self assert: (self.table at: "missing") equals: nil

  testLookupIfAbsentWhenPresent =>
    self.table at: "key" put: 42
    self assert: (self.table at: "key" ifAbsent: [0]) equals: 42

  testLookupIfAbsentWhenMissing =>
    self assert: (self.table at: "missing" ifAbsent: [99]) equals: 99

  testIncludesKeyWhenPresent =>
    self.table at: "key" put: "val"
    self assert: (self.table includesKey: "key")

  testIncludesKeyWhenAbsent =>
    self deny: (self.table includesKey: "no_such_key")

  testRemoveKey =>
    self.table at: "key" put: "val"
    self.table removeKey: "key"
    self assert: (self.table at: "key") equals: nil
    self deny: (self.table includesKey: "key")

  testRemoveKeyMissingIsIdempotent =>
    // Removing a key that does not exist does not raise
    self.table removeKey: "no_such_key"
    self assert: (self.table at: "no_such_key") equals: nil

  testKeysEmpty => self assert: self.table keys size equals: 0

  testKeysMultiple =>
    self.table at: "a" put: 1
    self.table at: "b" put: 2
    self.table at: "c" put: 3
    self assert: self.table keys size equals: 3

  testSizeEmpty => self assert: self.table size equals: 0

  testSizeAfterInsert =>
    self.table at: "x" put: 1
    self assert: self.table size equals: 1
    self.table at: "y" put: 2
    self assert: self.table size equals: 2

  testUpdateDoesNotIncreaseSize =>
    self.table at: "key" put: "original"
    self.table at: "key" put: "updated"
    self assert: self.table size equals: 1
    self assert: (self.table at: "key") equals: "updated"

  testNamedTableLookup =>
    // Another reference to the same table via name
    shared := Ets named: #etsTest
    self.table at: "shared" put: "hello"
    self assert: (shared at: "shared") equals: "hello"

  testDelete =>
    self.table delete
    // Table is gone — creating a fresh one with the same name succeeds
    fresh := Ets new: #etsTest type: #set
    self assert: fresh size equals: 0
    fresh delete

  testOrderedSetType =>
    ordered := Ets new: #etsTestOrdered type: #orderedSet
    ordered at: "b" put: 2
    ordered at: "a" put: 1
    ordered at: "c" put: 3
    // All keys are present
    self assert: ordered size equals: 3
    ordered delete

  testNewAlreadyExistsRaisesError =>
    self should: [Ets new: #etsTest type: #set] raise: #already_exists

  testBagUpsertSemantics =>
    // insert on a bag table replaces the existing entry (delete-then-insert upsert)
    bag := Ets new: #etsTestBag type: #bag
    bag at: "key" put: "first"
    bag at: "key" put: "second"
    self assert: (bag at: "key") equals: "second"
    self assert: bag size equals: 1
    bag delete

  // === BT-3831: bulk reads, snapshot, ifPresent, atomic updates ===
  testValues =>
    self.table at: "a" put: 1
    self.table at: "b" put: 2
    self assert: self.table values asSet equals: #(1, 2) asSet

  testValuesEmpty => self assert: self.table values equals: #()

  testKeysAndValuesDo =>
    self.table at: "a" put: 1
    self.table at: "b" put: 2
    seen := Ets new: #etsTestSeenKv type: #set
    self.table keysAndValuesDo: [:k :v | seen at: k put: v]
    self assert: seen asDictionary equals: #{"a" => 1, "b" => 2}
    seen delete

  testAsDictionarySnapshot =>
    self.table at: "a" put: 1
    snap := self.table asDictionary
    self.table at: "a" put: 99
    self assert: snap equals: #{"a" => 1}
    self assert: (self.table at: "a") equals: 99

  testAtIfPresent =>
    self.table at: "n" put: 2
    self assert: (self.table at: "n" ifPresent: [:v | v * 10]) equals: 20
    self assert: (self.table at: "zz" ifPresent: [:v | v * 10]) equals: nil

  testIncrementCreatesMissingKey =>
    self assert: (self.table at: "hits" increment: 1) equals: 1
    self assert: (self.table at: "hits" increment: 5) equals: 6
    self assert: (self.table at: "hits") equals: 6

  testIncrementNonIntegerArgumentRaises =>
    self should: [self.table at: "hits" increment: "x"] raise: #type_error

  testIncrementNonIntegerStoredValueRaises =>
    self.table at: "s" put: "str"
    self should: [self.table at: "s" increment: 1] raise: #type_error

  testUpdateMissingKeyGetsNil =>
    self assert: (self.table at: "k" update: [:old |
      old isNil ifTrue: [1] ifFalse: [2]
    ]) equals: 1
    self assert: (self.table at: "k") equals: 1

  testUpdateExistingKey =>
    self.table at: "k" put: 10
    self assert: (self.table at: "k" update: [:old | old + 1]) equals: 11
    self assert: (self.table at: "k") equals: 11

  testUpdateRaisingBlockWritesNothing =>
    self.table at: "k" put: 10
    self should: [
      self.table at: "k" update: [:old | old / 0]
    ] raise: #type_error
    self assert: (self.table at: "k") equals: 10

  testAtomicUpdatesRejectBagTables =>
    bag := Ets new: #etsTestBagAtomic type: #bag
    self should: [bag at: "k" increment: 1] raise: #unsupported_table_type
    self should: [bag at: "k" update: [:o | 1]] raise: #unsupported_table_type
    bag delete

  testOrderedSetAtomicUpdates =>
    ordered := Ets new: #etsTestOrderedAtomic type: #orderedSet
    ordered at: "k" increment: 2
    self assert: (ordered at: "k" update: [:o | o * 5]) equals: 10
    ordered delete

  testConcurrentIncrementIsAtomic =>
    blocks := (1 to: 20) asList collect: [:i |
      [1 to: 50 do: [:j | (Ets named: #etsTest) at: "n" increment: 1]]
    ]
    Parallel all: blocks
    self assert: (self.table at: "n") equals: 1000

  testConcurrentUpdateIsAtomic =>
    blocks := (1 to: 20) asList
      collect: [:i |
        [
          1
            to: 50
            do: [:j |
              (Ets named: #etsTest) at: "n" update: [:o |
                o isNil ifTrue: [1] ifFalse: [o + 1]
              ]
            ]
        ]
      ]
    Parallel all: blocks
    self assert: (self.table at: "n") equals: 1000

  testIsEmptyNotEmpty =>
    self assert: self.table isEmpty
    self deny: self.table notEmpty
    self.table at: "a" put: 1
    self deny: self.table isEmpty
    self assert: self.table notEmpty

  testIncludesAndDo =>
    self.table at: "a" put: 1
    self.table at: "b" put: 2
    self assert: (self.table includes: 2)
    self deny: (self.table includes: 3)
    seen := Ets new: #etsTestSeenDo type: #set
    self.table do: [:v | seen at: v put: true]
    self assert: seen size equals: 2
    seen delete

  testRemoveAll =>
    self.table at: "a" put: 1
    self.table removeAll
    self assert: self.table size equals: 0
    self.table at: "b" put: 2
    self assert: self.table size equals: 1
