// BT-3151/BT-3169: Runs BT-3151's issue-body repro shapes (Driver
// countedRun:/DriverSelect positives:-style, adapted to do:/select:/collect:)
// end to end — a same-class self-send that mutates a class var, inside a
// Foldl body with a co-occurring local-variable mutation. Before BT-3169
// (ADR 0111 Addendum 9) this shape compiled but silently lost the class-var
// mutation (stuck at 0 across every element); now it compiles AND correctly
// accumulates the mutation across every iteration.

TestCase subclass: FoldClassVarMutationTest

  setUp =>
    FoldClassVarMutation resetRuns
    self

  testSelfSendInDoBodyAccumulates =>
    self assert: (FoldClassVarMutation countedRun: #[1, 2, 3, 4]) equals: 10
    self assert: FoldClassVarMutation runs equals: 4

  testSelfSendAsSelectPredicateAccumulates =>
    self assert: (FoldClassVarMutation positives: #[10, 20, 30]) equals: #[10, 20, 30]
    self assert: FoldClassVarMutation runs equals: 3

  testSelfSendInCollectBodyAccumulates =>
    self assert: (FoldClassVarMutation doubleAllCounting: #[1, 2, 3]) equals: #[2, 4, 6]
    self assert: FoldClassVarMutation runs equals: 3

  testSelfSendAccumulatesAcrossCalls =>
    // Not just correct within one call — the mutation is visible to a later
    // call too (ADR 0110's own persistence guarantee), and picks up where
    // the previous call left off.
    self assert: (FoldClassVarMutation countedRun: #[1, 2]) equals: 3
    self assert: (FoldClassVarMutation countedRun: #[3]) equals: 3
    self assert: FoldClassVarMutation runs equals: 3

  testEmptyListLeavesClassVarUnchanged =>
    // The fold body never runs — the class var must stay at its pre-call
    // value.
    self assert: (FoldClassVarMutation countedRun: #[]) equals: 0
    self assert: FoldClassVarMutation runs equals: 0
