// BT-3072: `Actor.bt` now declares real `class sealed spawn` / `spawnWith:`
// bodies (`(Erlang beamtalk_actor) doSpawn: self` / `doSpawnWith: self
// args: initArgs`) instead of `@intrinsic actorSpawn` / `actorSpawnWith`
// markers. The compiler's static `Counter spawn` fast path
// (`try_handle_spawn_await`) and `self spawn` in a class method
// (`class_self_spawn`) are unchanged and still bypass this declared body —
// this file rounds out coverage for the paths that were already dynamic
// before this change (binding receiver, `perform:`, abstract-class
// rejection) plus the BT-3047 "self spawn inside a block passed to a
// foreign class method" shape, confirming none of them regressed.

TestCase subclass: ActorSpawnDynamicDispatchTest

  testSpawnViaVariableBindingUsesDynamicDispatch =>
    // Only a literal `Counter spawn` class-reference send hits the
    // compiler's static fast path (BT-246); routing the class object
    // through a local first forces the generic dynamic-dispatch path.
    cls := Counter
    c := cls spawn
    self assert: c class equals: Counter
    self assert: c increment equals: 1

  testSpawnwithViaVariableBindingUsesDynamicDispatch =>
    cls := Counter
    c := cls spawnWith: #{#value => 7}
    self assert: c class equals: Counter
    self assert: c getValue equals: 7

  testSpawnViaPerformRaisesNoErrorAndReturnsLiveActor =>
    c := Counter perform: #spawn
    self assert: c class equals: Counter
    self assert: c isAlive

  testSpawnwithViaPerformWithArgumentsAppliesInitArgs =>
    c := Counter perform: #spawnWith: withArguments: #(#{#value => 3})
    self assert: c getValue equals: 3

  testAbstractActorSpawnRaisesInstantiationErrorViaDynamicDispatch =>
    // AbstractShape (fixtures/abstract_shape.bt) is `abstract Actor
    // subclass:` — spawning it must raise the same structured error via
    // the dynamic (binding, perform:) paths as the static send does.
    cls := AbstractShape
    self should: [cls spawn] raise: #instantiation_error
    self should: [AbstractShape perform: #spawn] raise: #instantiation_error

  testSpawnSelfInsideForeignBlockDoesNotDeadlock =>
    // BT-3047 shape: `self spawn` inside a block handed to a foreign
    // class's block-taking method (fixtures/bt3072spawn_parent.bt +
    // fixtures/bt3047driver_plain.bt) must resolve against the block's
    // lexical home class (BT3072SpawnParent), not the driver it executes in.
    actor := BT3072SpawnParent spawnSelfThrough: BT3047DriverPlain over: #(1)
    self assert: actor class equals: BT3072SpawnParent
