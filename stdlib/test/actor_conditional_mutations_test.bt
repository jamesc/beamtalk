// BT-915: Tests that self.slot := inside ifTrue:, ifFalse:, and
// ifTrue:ifFalse: correctly mutates actor state
//
// Without the fix, mutations inside conditional blocks are lost because
// the block executes as a pure closure and the mutated state is local
// to the closure and never returned to handle_call

TestCase subclass: ActorConditionalMutationsTest
  field: c = nil

  setUp => self withC: ConditionalMutationCounter spawn

  tearDown => self.c isNil ifFalse: [self.c stop]

  testIfTrueWithTrueFlag =>
    // Verify flag=true causes the increment to be applied
    self assert: (self.c conditionalIncrement: true) equals: 1
    self assert: (self.c conditionalIncrement: true) equals: 2

  testIfTrueWithFalseFlag =>
    // Verify flag=false leaves state unchanged
    result := self.c conditionalIncrement: false
    self assert: result equals: 0
    self assert: self.c getCount equals: 0

  testIfFalseWithFalseFlag =>
    // Verify flag=false causes the decrement to be applied
    self assert: (self.c conditionalDecrement: false) equals: -1
    self assert: self.c getCount equals: -1

  testIfFalseWithTrueFlag =>
    // Verify flag=true leaves state unchanged
    result := self.c conditionalDecrement: true
    self assert: result equals: 0
    self assert: self.c getCount equals: 0

  testIfTrueIfFalseWithTrueFlag =>
    // Verify true branch of ifTrue:ifFalse: is taken
    result := self.c conditionalToggle: true
    self assert: result equals: 10
    self assert: self.c getCount equals: 10

  testIfTrueIfFalseWithFalseFlag =>
    // Verify false branch of ifTrue:ifFalse: is taken
    result := self.c conditionalToggle: false
    self assert: result equals: -1
    self assert: self.c getCount equals: -1

  testStatePersistedAcrossCalls =>
    // Verify state accumulates across multiple conditional calls
    self.c conditionalIncrement: true;
      conditionalIncrement: true;
      conditionalIncrement: false
    self assert: self.c getCount equals: 2

  testSequentialConditionals =>
    // Verify two sequential conditionals in one method both thread state
    // a=true, b=true => count = 0 + 1 + 10 = 11
    self assert: (self.c doubleConditional: true and: true) equals: 11
    self.c reset
    // a=true, b=false => count = 0 + 1 = 1
    self assert: (self.c doubleConditional: true and: false) equals: 1
    self.c reset
    // a=false, b=true => count = 0 + 10 = 10
    self assert: (self.c doubleConditional: false and: true) equals: 10
    self.c reset
    // a=false, b=false => count = 0
    self assert: (self.c doubleConditional: false and: false) equals: 0

  testNestedConditionals =>
    // Verify nested ifTrue: with mutations threads state correctly
    // outer=true, inner=true => count = 0 + 100 = 100
    self assert: (self.c nestedConditional: true and: true) equals: 100
    self.c reset
    // outer=true, inner=false => count = 0 (inner not taken)
    self assert: (self.c nestedConditional: true and: false) equals: 0
    self.c reset
    // outer=false => count = 0 (outer not taken)
    self assert: (self.c nestedConditional: false and: true) equals: 0

  testConditionalAsLastExpression =>
    // Verify conditional as the last expression in a method
    // flag=true returns the assigned value (5) and mutates state
    result := self.c conditionalLast: true
    self assert: result equals: 5
    self assert: self.c getCount equals: 5
    self.c reset
    // flag=false returns nil and leaves state unchanged
    result2 := self.c conditionalLast: false
    self assert: result2 equals: nil
    self assert: self.c getCount equals: 0

  testLocalVarInIfTrueBlock =>
    // BT-1225: Local var assigned inside ifTrue: block must be readable in subsequent
    // expressions of the same block (no {badkey,y} crash at runtime)
    self assert: (self.c incrementViaLocalVar: true) equals: 1
    self assert: (self.c incrementViaLocalVar: true) equals: 2
    self assert: (self.c incrementViaLocalVar: false) equals: 2

  testLocalVarInIfFalseBlock =>
    // BT-1225: Same fix applies to ifFalse: blocks
    self assert: (self.c decrementViaLocalVar: false) equals: -1
    self assert: (self.c decrementViaLocalVar: false) equals: -2
    self assert: (self.c decrementViaLocalVar: true) equals: -2

  testSelfSendAsConditionalReceiverThreadsMutation =>
    // BT-3382: `(self recordOnce: flag) ifTrue:ifFalse:` — the self-send is
    // the RECEIVER of the conditional, not a statement inside either block
    // body, so the block-mutation scan that decides whether to inline this
    // conditional never even sees a mutation (neither block itself mutates
    // anything). Correct branch selection alone does not prove the
    // self-send's own state mutation was observed afterward — assert the
    // count too, for both branches.
    result := self.c recordThenBranch: true
    self assert: result equals: #recorded
    self assert: self.c getCount equals: 1
    result2 := self.c recordThenBranch: false
    self assert: result2 equals: #gaveUp
    self assert: self.c getCount equals: 2

  testSelfSendNestedInBinaryOpOperandThreadsMutation =>
    // BT-3392: `1 + (self bumpCount: true)` inside an `ifTrue:` block —
    // the self-send is a binary-op operand, not the block's own top-level
    // statement and not the conditional's receiver. Without the fix, this
    // silently drops `bumpCount:`'s mutation even though the arithmetic
    // (and thus the self-send) demonstrably ran.
    self assert: (self.c recordViaBinaryOpOperand: true) equals: 1

  testSelfSendAsBinaryOpArgumentDoesNotRunBeforeEarlierRaisingOperand =>
    // BT-3392 follow-up: `(self.items at: idx) + (self bumpCount: true)` —
    // the self-send is a binary-op ARGUMENT, and `at:` (a non-self-send
    // operand that can itself raise) evaluates before it in source order.
    // Hoisting the self-send unconditionally ahead of `at:` (the original
    // BT-3392 mechanism) would run bumpCount:'s mutation before `at:` gets
    // a chance to fail — an out-of-bounds index must raise WITHOUT ever
    // bumping the count.
    self should: [
      self.c orderSensitiveBinaryOp: 99 flag: true
    ] raise: #index_out_of_bounds
    self assert: self.c getCount equals: 0

  testSelfSendAsBinaryOpArgumentInBoundsThreadsMutation =>
    // ADR 0118 (BT-3417): same `(self.items at: idx) + (self bumpCount:
    // true)` shape as above, but with `idx` IN BOUNDS this time — so `at:`
    // succeeds and `bumpCount:` runs. BT-3392/BT-3399's old planner
    // mechanism left an order-unsafe self-send un-hoisted (since `at:`
    // could have raised) and routed `bumpCount:` through the ordinary,
    // discarding `generate_self_dispatch` path, silently dropping its
    // mutation — this test used to pin that as a known limitation
    // (`testSelfSendAsBinaryOpArgumentInBoundsStillDropsMutationSilently`).
    // ADR 0118's universal sequencing rule (`sequence_children`) fixes it:
    // `at:`'s value is bound to a temp AHEAD of `bumpCount:`'s dispatch —
    // preserving `at:`'s evaluation-order guarantee (still raises first out
    // of bounds, see the paired test above) while threading `bumpCount:`'s
    // mutation via a real `Bind` instead of dropping it. `getCount` and the
    // method's own return value (`self.count`, the block's mutation) both
    // now reflect the bump.
    self assert: (self.c orderSensitiveBinaryOp: 1 flag: true) equals: 1
    self assert: self.c getCount equals: 1

  testSelfSendInsideOnDoProtectedBlockAlreadyThreadsMutation =>
    // BT-3392: verifies the shape confirmed against the actual
    // beamtalk-watcher source (`CheckRegistry.bt`'s `spawnMonitorFor:`
    // pattern) — a self-send as the sole statement of an on:do:-protected
    // block, itself the sole statement of an ifTrue: block. This was
    // already correct before BT-3392 (the pre-existing on:do:/C11 handling
    // covers it); this test pins that down as a regression guard.
    self assert: (self.c recordViaOnDoProtectedBlock: true) equals: 1

  testNonDispatchingSelfSendAsConditionalReceiverDoesNotCrash =>
    // BT-3382 regression: `(self respondsTo: sel) ifTrue:ifFalse:` — the
    // receiver is a self-send, but `respondsTo:` is intercepted before
    // self-dispatch (BT-1420) and is never a real dispatch-table entry.
    // An over-broad receiver check previously routed this through the
    // self-dispatch codegen shortcut, crashing with does_not_understand.
    self assert: (self.c respondsToAsReceiver: #getCount) equals: #yes
    self assert: (self.c respondsToAsReceiver: #bogusSelector) equals: #no
