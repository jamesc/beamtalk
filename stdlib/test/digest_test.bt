// Stdlib tests for Digest class — SHA-2/MD5 hashing and HMAC, checked
// against published NIST/RFC test vectors.

TestCase subclass: DigestTest

  // ===== SHA-256 (NIST FIPS 180-4 short message test) =====
  testSha256OfAbc =>
    self assert: (Digest sha256: "abc") asHex equals: "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

  testSha256OfEmptyString =>
    self assert: (Digest sha256: "") asHex equals: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

  testSha256ByteSize => self assert: (Digest sha256: "abc") byteSize equals: 32

  testSha256AcceptsBinary =>
    self assert: (Digest sha256: (Binary fromBytes: #(97, 98, 99))) asHex equals: "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"

  // ===== SHA-512 (NIST FIPS 180-4 short message test) =====
  testSha512OfAbc =>
    self assert: (Digest sha512: "abc") asHex equals: "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"

  testSha512ByteSize => self assert: (Digest sha512: "abc") byteSize equals: 64

  // ===== MD5 (RFC 1321 test vector) — legacy/non-cryptographic use only =====
  testMd5OfAbc =>
    self assert: (Digest md5: "abc") asHex equals: "900150983cd24fb0d6963f7d28e17f72"

  testMd5ByteSize => self assert: (Digest md5: "abc") byteSize equals: 16

  // ===== HMAC-SHA256 (RFC 4231 test cases 1 and 2) =====
  testHmacSha256TestCase1 =>
    // Key = 20 bytes of 0x0b, Data = "Hi There"
    key := (Binary fromHex: "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b") unwrap
    self assert: (Digest hmacSha256: "Hi There" key: key) asHex equals: "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7"

  testHmacSha256TestCase2 =>
    // Key = "Jefe", Data = "what do ya want for nothing?"
    self assert: (Digest hmacSha256: "what do ya want for nothing?" key: "Jefe") asHex equals: "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843"

  testHmacSha256ByteSize =>
    self assert: (Digest hmacSha256: "message" key: "secret") byteSize equals: 32

  // ===== HMAC-SHA512 (RFC 4231 test cases 1 and 2) =====
  testHmacSha512TestCase1 =>
    key := (Binary fromHex: "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b") unwrap
    self assert: (Digest hmacSha512: "Hi There" key: key) asHex equals: "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"

  testHmacSha512TestCase2 =>
    self assert: (Digest hmacSha512: "what do ya want for nothing?" key: "Jefe") asHex equals: "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"

  testHmacSha512ByteSize =>
    self assert: (Digest hmacSha512: "message" key: "secret") byteSize equals: 64

  // ===== Determinism / distinctness =====
  testSameInputSameDigest =>
    self assert: (Digest sha256: "hello") asHex equals: (Digest sha256: "hello") asHex

  testDifferentInputDifferentDigest =>
    self deny: ((Digest sha256: "hello") asHex =:= (Digest sha256: "world") asHex)

  testSha256AndSha512Differ =>
    self deny: ((Digest sha256: "abc") asHex =:= (Digest sha512: "abc") asHex)
