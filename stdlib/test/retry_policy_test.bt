// BUnit tests for RetryPolicy value type and do: retry executor (BT-2973).
//
// Reuses the shared MyCustomError fixture (stdlib/test/fixtures/my_custom_error.bt)
// as a distinguishable error class for nonRetryableErrors matching.

TestCase subclass: RetryPolicyTest
  field: counter = nil

  setUp =>
    // Defensively clean up any leftover table from a crashed previous run
    [
      (AtomicCounter named: #retryPolicyBUnitTestCounter) delete
    ] on: Error do: [:e | nil]
    self withCounter: (AtomicCounter new: #retryPolicyBUnitTestCounter)

  tearDown =>
    self.counter isNil ifFalse: [[self.counter delete] on: Error do: [:e | nil]]

  // ===== Construction & Defaults =====
  testDefaultConstruction =>
    rp := RetryPolicy new
    self assert: rp initialInterval equals: 1000
    self assert: rp backoffCoefficient equals: 2.0
    self assert: rp maximumInterval equals: nil
    self assert: rp maximumAttempts equals: nil
    self assert: rp jitter equals: false
    self assert: rp nonRetryableErrors equals: #()

  testNewWithMap =>
    rp := RetryPolicy
      new: #{
        #initialInterval => 500,
        #backoffCoefficient => 1.5,
        #maximumInterval => 30000,
        #maximumAttempts => 5,
        #jitter => true,
        #nonRetryableErrors => #("InvalidInput", "NotFound")
      }
    self assert: rp initialInterval equals: 500
    self assert: rp backoffCoefficient equals: 1.5
    self assert: rp maximumInterval equals: 30000
    self assert: rp maximumAttempts equals: 5
    self assert: rp jitter equals: true
    self assert: rp nonRetryableErrors equals: #("InvalidInput", "NotFound")

  testEquality =>
    rp1 := RetryPolicy new: #{
      #initialInterval => 1000,
      #backoffCoefficient => 2.0
    }
    rp2 := RetryPolicy new: #{
      #initialInterval => 1000,
      #backoffCoefficient => 2.0
    }
    self assert: rp1 equals: rp2

  // ===== intervalForAttempt: (pure interval math, no sleeps) =====
  testIntervalForAttemptDefaultBackoff =>
    rp := RetryPolicy new
    self assert: (rp intervalForAttempt: 1) equals: 1000
    self assert: (rp intervalForAttempt: 2) equals: 2000
    self assert: (rp intervalForAttempt: 3) equals: 4000

  testIntervalForAttemptCustomCoefficient =>
    rp := RetryPolicy new: #{
      #initialInterval => 500,
      #backoffCoefficient => 1.5
    }
    self assert: (rp intervalForAttempt: 1) equals: 500
    self assert: (rp intervalForAttempt: 2) equals: 750
    self assert: (rp intervalForAttempt: 3) equals: 1125

  testIntervalForAttemptCappedByMaximumInterval =>
    rp := RetryPolicy new: #{#initialInterval => 1000, #maximumInterval => 1500}
    self assert: (rp intervalForAttempt: 1) equals: 1000
    self assert: (rp intervalForAttempt: 2) equals: 1500
    self assert: (rp intervalForAttempt: 3) equals: 1500

  // BT-3006 regression: `backoffCoefficient raisedTo: (attempt - 1)` used
  // to be computed unconditionally, before `maximumInterval` was ever
  // applied — IEEE-754 doubles overflow to +infinity around
  // `2.0 raisedTo: 1024` (attempt ~1025 with the default coefficient), and
  // `ceiling` on an infinite Float raised a low-level arithmetic error.
  // `intervalForAttempt:` must stay finite well past that point, whether or
  // not `maximumInterval` is set.
  testIntervalForAttemptStaysFiniteWellPastOldFloatOverflowPoint =>
    uncapped := RetryPolicy new: #{#backoffCoefficient => 2.0}
    self assert: ((uncapped intervalForAttempt: 1025) isKindOf: Integer)
    self assert: ((uncapped intervalForAttempt: 5000) isKindOf: Integer)
    self assert: (uncapped intervalForAttempt: 5000) > 0

  // Regression: the cap-guard in growInterval:remaining:cap: divides by
  // backoffCoefficient to check whether the next multiplication would cross
  // the cap. A zero (or negative) coefficient must skip that division
  // instead of raising — the original raisedTo:-based computation never had
  // this failure mode (0.0 raisedTo: N is just 0.0, never an error).
  testIntervalForAttemptHandlesNonPositiveBackoffCoefficient =>
    zeroCoefficient := RetryPolicy new: #{
      #initialInterval => 1000,
      #backoffCoefficient => 0.0
    }
    self assert: (zeroCoefficient intervalForAttempt: 1) equals: 1000
    self assert: (zeroCoefficient intervalForAttempt: 2) equals: 0
    self assert: (zeroCoefficient intervalForAttempt: 5) equals: 0

  // Regression: a negative backoffCoefficient alternates the sign of the
  // running interval on each multiplication (current * negative -> negative,
  // negative * negative -> positive, ...) — an odd `attempt` would otherwise
  // produce a negative Integer, which `Timer sleep:` raises on, breaking
  // do:'s Result(R, Exception) contract. growInterval:remaining:cap: clamps
  // at 0 instead.
  testIntervalForAttemptClampsNegativeBackoffCoefficientAtZero =>
    negativeCoefficient := RetryPolicy new: #{
      #initialInterval => 1000,
      #backoffCoefficient => -2.0
    }
    1 to: 6 do: [:attempt |
      self assert: (negativeCoefficient intervalForAttempt: attempt) >= 0
    ]

  // BT-3016 regression: RetryPolicy's `new:` is entirely compiler-generated
  // from its `field:` declarations (no `initialize:`/constructor hook exists
  // to validate against), so a negative `initialInterval` reached
  // cappedRawIntervalForAttempt: unclamped and could produce a negative
  // Integer delay — which `Timer sleep:` raises on inside `do:`'s executor,
  // breaking `do:`'s documented `Result(R, Exception)` contract. Clamped to
  // 0 at the point of use, matching the existing "negative delay clamps to
  // 0" precedent for a negative backoffCoefficient. Covers both of
  // cappedRawIntervalForAttempt:'s branches: backoffCoefficient > 1.0 (the
  // growInterval: loop) and backoffCoefficient in [0, 1] (the closed-form
  // path) — a negative initialInterval flows unclamped through either one
  // if only one of the two call sites is fixed.
  testIntervalForAttemptClampsNegativeInitialIntervalAtZero =>
    negativeInitialGrowthPath := RetryPolicy new: #{
      #initialInterval => -1000,
      #backoffCoefficient => 2.0
    }
    1
      to: 6
      do: [:attempt |
        self assert: (negativeInitialGrowthPath intervalForAttempt: attempt) >= 0
      ]

    negativeInitialClosedFormPath := RetryPolicy new: #{
      #initialInterval => -1000,
      #backoffCoefficient => 0.5
    }
    1
      to: 6
      do: [:attempt |
        self assert: (negativeInitialClosedFormPath intervalForAttempt: attempt) >= 0
      ]

  testDoDoesNotRaiseWithNegativeInitialInterval =>
    rp := RetryPolicy new: #{#initialInterval => -1000, #maximumAttempts => 3}
    result := rp
      do: [:attempt |
        self.counter increment
        Error signal: "always fails"
      ]
    self assert: result isError
    self assert: self.counter value equals: 3

  // Regression: cappedRawIntervalForAttempt: used to unconditionally route
  // through growInterval:remaining:cap:, an O(attempt) loop — for a
  // constant-backoff (backoffCoefficient = 1.0) or decaying-backoff (< 1.0)
  // policy, that loop never reaches its early-exit (the interval never
  // grows to cross the cap), so intervalForAttempt:'s cost grew linearly
  // with attempt, making an unlimited-attempts do: loop's total
  // interval-computation cost quadratic in the number of retries. Both
  // cases now use a direct O(1) closed-form computation instead (safe from
  // Float overflow in this range, since the value only shrinks or stays
  // constant). A 50-million-attempt call finishing at all demonstrates the
  // O(1) path is actually taken — the old O(attempt) loop would not
  // complete in any reasonable test time at this scale.
  testIntervalForAttemptNonGrowingBackoffStaysFastForHugeAttemptCounts =>
    constant := RetryPolicy new: #{
      #initialInterval => 1000,
      #backoffCoefficient => 1.0
    }
    self assert: (constant intervalForAttempt: 50000000) equals: 1000

    decaying := RetryPolicy new: #{
      #initialInterval => 1000,
      #backoffCoefficient => 0.5
    }
    self assert: (decaying intervalForAttempt: 50000000) equals: 0

  testIntervalForAttemptCappedWellPastOldFloatOverflowPoint =>
    capped := RetryPolicy new: #{
      #backoffCoefficient => 2.0,
      #maximumInterval => 5000
    }
    self assert: (capped intervalForAttempt: 1025) equals: 5000
    self assert: (capped intervalForAttempt: 5000) equals: 5000

  testIntervalForAttemptJitterStaysWithinBounds =>
    plain := RetryPolicy new: #{
      #initialInterval => 1000,
      #maximumInterval => 4000
    }
    jittered := RetryPolicy new: #{
      #initialInterval => 1000,
      #maximumInterval => 4000,
      #jitter => true
    }
    1
      to: 3
      do: [:attempt |
        raw := plain intervalForAttempt: attempt
        10
          timesRepeat: [
            delay := jittered intervalForAttempt: attempt
            self assert: delay >= 0
            self assert: delay <= raw
          ]
      ]

  // ===== retriesExhausted: =====
  testRetriesExhaustedNilIsUnlimited =>
    rp := RetryPolicy new
    self deny: (rp retriesExhausted: 999)

  testRetriesExhaustedZeroIsUnlimited =>
    rp := RetryPolicy new: #{#maximumAttempts => 0}
    self deny: (rp retriesExhausted: 999)

  testRetriesExhaustedAtLimit =>
    rp := RetryPolicy new: #{#maximumAttempts => 3}
    self deny: (rp retriesExhausted: 2)
    self assert: (rp retriesExhausted: 3)

  // ===== isNonRetryable: =====
  testIsNonRetryableTrueForListedClass =>
    rp := RetryPolicy new: #{#nonRetryableErrors => #("MyCustomError")}
    outcome := Result tryDo: [MyCustomError signal: "boom"]
    self assert: (rp isNonRetryable: outcome error)

  testIsNonRetryableFalseForUnlistedClass =>
    rp := RetryPolicy new: #{#nonRetryableErrors => #("MyCustomError")}
    outcome := Result tryDo: [Error signal: "boom"]
    self deny: (rp isNonRetryable: outcome error)

  // ===== do: executor =====
  testDoSucceedsOnFirstAttempt =>
    rp := RetryPolicy new: #{#initialInterval => 1, #maximumAttempts => 3}
    result := rp
      do: [:attempt |
        self.counter increment
        attempt
      ]
    self assert: (self assertOk: result) equals: 1
    self assert: self.counter value equals: 1

  testDoRetriesUntilSuccess =>
    rp := RetryPolicy new: #{#initialInterval => 1, #maximumAttempts => 5}
    result := rp
      do: [:attempt |
        self.counter increment
        attempt < 3 ifTrue: [Error signal: "not yet"] ifFalse: [attempt]
      ]
    self assert: (self assertOk: result) equals: 3
    self assert: self.counter value equals: 3

  testDoExhaustsMaximumAttempts =>
    rp := RetryPolicy new: #{#initialInterval => 1, #maximumAttempts => 3}
    result := rp
      do: [:attempt |
        self.counter increment
        Error signal: "always fails"
      ]
    self assert: result isError
    self assert: self.counter value equals: 3

  testDoHandlesManyAttemptsWithoutStackGrowth =>
    // Regression test: attempt:do:'s recursive step must be a genuine BEAM
    // tail call. An earlier version used `^` (non-local return) inside
    // ifTrue: blocks, which wraps the whole method body in a try/catch and
    // defeats tail-call optimization — every retry would add a stack frame,
    // eventually crashing an unlimited-attempts policy retrying a
    // fast-failing block.
    //
    // 300 attempts is far deeper than a non-tail-call version would survive.
    rp := RetryPolicy new: #{
      #initialInterval => 0,
      #maximumInterval => 1,
      #maximumAttempts => 300
    }
    result := rp
      do: [:attempt |
        self.counter increment
        Error signal: "always fails"
      ]
    self assert: result isError
    self assert: self.counter value equals: 300

  testDoHandlesAttemptsPastOldFloatOverflowPoint =>
    // BT-3006 regression: intervalForAttempt: used to overflow Float and
    // raise around attempt ~1025 regardless of maximumInterval (the cap was
    // applied after the overflow-prone computation), which meant do:'s
    // documented Result(R, Exception) contract could break under an
    // otherwise-ordinary policy retried enough times. 1100 attempts stays
    // safely past that old crash point.
    rp := RetryPolicy new: #{
      #initialInterval => 0,
      #maximumInterval => 1,
      #maximumAttempts => 1100
    }
    result := rp
      do: [:attempt |
        self.counter increment
        Error signal: "always fails"
      ]
    self assert: result isError
    self assert: self.counter value equals: 1100

  testDoShortCircuitsNonRetryableError =>
    rp := RetryPolicy
      new: #{
        #initialInterval => 1,
        #maximumAttempts => 5,
        #nonRetryableErrors => #("MyCustomError")
      }
    result := rp
      do: [:attempt |
        self.counter increment
        MyCustomError signal: "nope"
      ]
    self assert: result isError
    self assert: self.counter value equals: 1
