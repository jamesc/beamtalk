// BT-3366: Tests for ChildSupervisor class-side defaults, subclass override,
// and startChild:/terminateChild: lifecycle.
//
// Fixtures: stdlib/test/fixtures/test_child_supervisor_custom.bt
//
// The regression test for the feature's core guarantee — that a
// crash-triggered restart replays a specific child's own original
// startChild: args — is an e2e btscript
// (tests/repl-protocol/cases/child_supervisor.btscript) because it needs to
// kill a live child process and poll for the supervisor's restart, which
// BUnit's single-method-body execution model cannot express as cleanly as
// the REPL's turn-by-turn evaluation.

TestCase subclass: ChildSupervisorDefaultsTest

  // === ChildSupervisor class-side defaults ===
  testChildSupervisorMaxRestartsDefault =>
    self assert: ChildSupervisor maxRestarts equals: 10

  testChildSupervisorRestartWindowDefault =>
    self assert: ChildSupervisor restartWindow equals: 60

  testChildSupervisorIsSupervisorTrue =>
    self assert: ChildSupervisor isSupervisor equals: true

  // === ChildSupervisor subclass can override defaults ===
  testChildSupervisorSubclassOverridesMaxRestarts =>
    self assert: TestChildSupervisorCustom maxRestarts equals: 5

  testChildSupervisorSubclassOverridesRestartWindow =>
    self assert: TestChildSupervisorCustom restartWindow equals: 120

  testChildSupervisorSubclassIsSupervisorTrue =>
    self assert: TestChildSupervisorCustom isSupervisor equals: true

  // === Type parameter C narrows startChild return type ===
  testStartChildReturnsTypedChild =>
    sup := (TestChildSupervisorCustom supervise) unwrap
    child := sup startChild unwrap
    // If C=Counter resolves, child is typed as Counter and getValue compiles.
    self assert: child getValue equals: 0
    [sup stop] on: Error do: [:e | nil]

  // === startChild: passes per-child args ===
  testStartChildWithArgsSetsInitialState =>
    sup := (TestChildSupervisorCustom supervise) unwrap
    child := (sup startChild: #{#value => 7}) unwrap
    self assert: child getValue equals: 7
    [sup stop] on: Error do: [:e | nil]

  // === Multiple children of the same class each get a distinct OTP id ===
  testMultipleChildrenOfSameClassCanCoexist =>
    sup := (TestChildSupervisorCustom supervise) unwrap
    c1 := sup startChild unwrap
    c2 := sup startChild unwrap
    self assert: sup count equals: 2
    c1 increment
    self assert: c1 getValue equals: 1
    self assert: c2 getValue equals: 0
    [sup stop] on: Error do: [:e | nil]

  // === terminateChild: is idempotent on already-gone children (ADR 0080 Phase 2) ===
  testTerminateChildIsIdempotent =>
    sup := (TestChildSupervisorCustom supervise) unwrap
    child := sup startChild unwrap
    first := sup terminateChild: child
    self assert: first isOk equals: true
    self assert: first unwrap equals: nil
    second := sup terminateChild: child
    self assert: second isOk equals: true
    self assert: second unwrap equals: nil
    [sup stop] on: Error do: [:e | nil]

  // === terminateChild: removes the child so count drops ===
  testTerminateChildDropsCount =>
    sup := (TestChildSupervisorCustom supervise) unwrap
    child := sup startChild unwrap
    self assert: sup count equals: 1
    (sup terminateChild: child) unwrap
    self assert: sup count equals: 0
    [sup stop] on: Error do: [:e | nil]
