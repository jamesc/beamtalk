// BT-4503: a value-type method function answers exactly what a send of it
// answers, block `^` or not. A method or extension whose block holds `^`
// answered `{Result, Self}`, which only its own `dispatch/3` arm unwrapped;
// a value-type extension with a block `^` leaked that pair to the sender.
// The typed sends below go to a class in another module (its `dispatch/3`).

TestCase subclass: ValueTypeNlrAnswerTest

  testMethodWithBlockReturnAnswersItsValue =>
    f := NlrAnswerFinder items: #(1, 20, 3)
    self assert: f firstBig equals: 20
    self assert: (NlrAnswerFinder items: #(1, 2)) firstBig equals: nil

  testTypedCrossModuleSendAnswersItsValue =>
    self assert: (self firstBigOf: (NlrAnswerFinder items: #(5, 30))) equals: 30
    self assert: (self firstBigOf: (NlrAnswerFinder items: #())) equals: nil
    self assert: (self firstBigOrZeroOf: (NlrAnswerFinder items: #(2))) equals: 0
    self assert: (self countOf: (NlrAnswerFinder items: #(1, 2, 3))) equals: 3
    self assert: (self itemsOf: ((NlrAnswerFinder items: #()) withItems: #(7))) equals: #(7)
    self assert: (self itemsOf: (self replaced: (NlrAnswerFinder items: #(1)) by: #(8, 9))) equals: #(8, 9)
    self
      assert: (self
        between: (NlrAnswerFinder items: #(1, 5, 9))
        lo: 4
        hi: 8)
      equals: 5
    self
      assert: (self
        between: (NlrAnswerFinder items: #(1))
        lo: 4
        hi: 8)
      equals: nil

  testDynamicSendAnswersItsValue =>
    self assert: ((NlrAnswerFinder items: #(1, 11)) perform: #firstBig) equals: 11

  testValueTypeExtensionWithBlockReturnAnswersItsValue =>
    self assert: (NlrAnswerFinder items: #(4, 40)) extFirstBig equals: 40
    self assert: (NlrAnswerFinder items: #(4)) extFirstBig equals: nil
    self assert: (self extFirstBigOf: (NlrAnswerFinder items: #(50))) equals: 50

  firstBigOf: f :: NlrAnswerFinder -> Integer | Nil => f firstBig

  firstBigOrZeroOf: f :: NlrAnswerFinder -> Integer => f firstBigOrZero

  countOf: f :: NlrAnswerFinder -> Integer => f count

  itemsOf: f :: NlrAnswerFinder -> List => f items

  replaced: f :: NlrAnswerFinder by: xs :: List -> NlrAnswerFinder =>
    f withItems: xs

  between: f :: NlrAnswerFinder lo: lo :: Integer hi: hi :: Integer -> Integer | Nil =>
    f firstBetween: lo and: hi

  extFirstBigOf: f :: NlrAnswerFinder -> Integer | Nil => f extFirstBig

// A value-type extension whose block holds `^`.
NlrAnswerFinder >> extFirstBig -> Integer | Nil =>
  self items do: [:e | e > 10 ifTrue: [^e]]
  nil
