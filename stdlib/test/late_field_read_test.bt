// Tests for BT-3549 (ADR 0124 §3/B3): the guarded `late` slot read.
//
// Fixtures:
//   stdlib/test/fixtures/late_field_read_actor.bt          (instance `late state:`)
//   stdlib/test/fixtures/late_class_var_read_actor.bt      (class-side, never assigned)
//   stdlib/test/fixtures/late_class_var_assigned_actor.bt  (class-side, assign then read)

TestCase subclass: LateFieldReadTest

  // === Instance `late state:` ===
  testReadBeforeAssignRaisesUninitializedStateError =>
    a := LateFieldReadActor spawn
    self should: [a getProc] raise: #uninitialized_state_error

  testReadBeforeAssignErrorMentionsClassAndField =>
    a := LateFieldReadActor spawn
    result := [a getProc] on: Exception do: [:e | e message]
    self assert: (result includesSubstring: "LateFieldReadActor")

  testReadBeforeAssignHintMentionsFieldAndType =>
    a := LateFieldReadActor spawn
    result := [a getProc] on: Exception do: [:e | e hint]
    self assert: (result includesSubstring: "proc")
    self assert: (result includesSubstring: "Integer")
    self assert: (result includesSubstring: "late")

  testNilInjectedViaSpawnWithReadsBackAsAssigned =>
    // BT-4061: presence — not value — is assignment (ADR 0124 §2). An
    // injected `nil` makes the key present, so `hasField:` is true and the
    // read answers `nil` instead of raising. Built via a variable (not an
    // inline `#{...}` literal at the call site) so the compile-time
    // literal-map type check doesn't reject it up front — exactly the
    // "spawnWith: with a non-literal map" case the ADR names.
    initArgs := Dictionary new at: #proc put: nil
    a := LateFieldReadActor spawnWith: initArgs
    self assert: (a hasField: #proc)
    self assert: a getProc equals: nil

  testNilForgedViaFieldAtPutReadsBackAsAssigned =>
    // BT-4061's repro shape: `hasField:` says assigned while the direct
    // read raised. (`late state: a :: Object` itself no longer compiles —
    // B1 rejects nil-admitting types — so the `nil` is forged through the
    // untyped `fieldAt:put:` writer instead, the only way to reach this
    // state now.) Both surfaces must agree the slot is assigned.
    a := LateFieldReadActor spawn
    a fieldAt: #proc put: nil
    self assert: (a hasField: #proc)
    self assert: a getProc equals: nil

  testFieldAtOnForgedNilAnswersNil =>
    // The reflective read agrees with the direct read: a present key
    // holding `nil` answers `nil`, never raises.
    a := LateFieldReadActor spawn
    a fieldAt: #proc put: nil
    self assert: (a fieldAt: #proc) equals: nil

  testReadAfterAssignAnswersTheValue =>
    a := LateFieldReadActor spawn
    a setProc: 42
    self assert: a getProc equals: 42

  testEagerFieldUnaffectedByLateSibling =>
    a := LateFieldReadActor spawn
    self assert: a getCount equals: 0

  testLateReadInsideLoopThatNeverRunsDoesNotRaise =>
    // The condition is false from the very first check, so the loop body
    // — which reads the unassigned `late` field — never executes. The read
    // guard must not have been pre-extracted ahead of the loop (ADR §4b).
    a := LateFieldReadActor spawn
    result := a pumpWhile: false
    self assert: result equals: nil

  testLateFieldMutatedInsideLoopDoesNotCrashAndAnswersFinalValue =>
    // A `late` field mutated inside a `whileTrue:` body must not select
    // Hybrid mode's pre-extraction (ADR §4e/B3) — it must run to
    // completion and answer the final assigned value, not badkey-crash on
    // the first iteration.
    a := LateFieldReadActor spawn
    result := a pumpAndSetProc: 5
    self assert: result equals: 4

  // === Class-side `late classState:` ===
  testClassReadBeforeAssignRaisesUninitializedStateError =>
    self should: [
      LateClassVarReadActor getCurrent
    ] raise: #uninitialized_state_error

  testClassEagerVarUnaffectedByLateSibling =>
    self assert: LateClassVarReadActor getTotal equals: 0

  testClassReadAfterAssignAnswersTheValue =>
    LateClassVarAssignedActor setCurrent: 7
    self assert: LateClassVarAssignedActor getCurrent equals: 7

  testClassNilForgedViaPerformReadsBackAsAssigned =>
    // BT-4061, class-side counterpart: forge `nil` past the typed
    // `setCurrent:` parameter via dynamic `perform:` (which skips static
    // argument checking), then the class-method read answers it and
    // `hasField:` agrees the variable is assigned. Sets what it needs, so
    // it cannot interfere with the assign-then-read test above whatever
    // order the two run in.
    LateClassVarAssignedActor perform: #setCurrent: withArguments: #(nil)
    self assert: (LateClassVarAssignedActor hasField: #current)
    self assert: LateClassVarAssignedActor getCurrent equals: nil
