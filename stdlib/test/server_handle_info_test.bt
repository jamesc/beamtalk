// BT-1457: Tests for Server handleInfo: codegen dispatch (ADR 0065).
// BT-3958: an error raised in handleInfo: crashes the server (ADR 0134).
//
// Fixtures: stdlib/test/fixtures/handle_info_counter.bt
//           stdlib/test/fixtures/failing_handle_info_server.bt
//           stdlib/test/fixtures/failing_handle_info_sup.bt
//           stdlib/test/fixtures/failing_plain_handle_info_server.bt
//           stdlib/test/fixtures/plain_actor_for_info_test.bt

TestCase subclass: ServerHandleInfoTest

  // === Basic handleInfo: dispatch ===
  testServerReceivesTickMessage =>
    server := HandleInfoCounter spawn
    server pid send: #tick
    self assert: server getCount equals: 1
    server stop

  testServerReceivesMultipleTicks =>
    server := HandleInfoCounter spawn
    server pid send: #tick
    server pid send: #tick
    server pid send: #tick
    self assert: server getCount equals: 3
    server stop

  testServerHandlesNonTickMessage =>
    server := HandleInfoCounter spawn
    server pid send: #something_else
    self assert: server getLastMsg equals: #something_else
    server stop

  // === Plain Actor ignores raw messages ===
  testPlainActorIgnoresRawMessages =>
    actor := PlainActorForInfoTest spawn
    actor increment
    self assert: actor getCount equals: 1
    actor pid send: #tick
    self assert: actor getCount equals: 1
    actor stop

  testServerIsAliveAfterUnknownMessage =>
    server := HandleInfoCounter spawn
    self assert: server isAlive
    server pid send: #anything
    server getCount  // flush: queues behind #anything in mailbox (FIFO) before isAlive check
    self assert: server isAlive
    server stop

  // === Errors crash the server (ADR 0134, BT-3958) ===
  testHandleInfoErrorCrashesServer =>
    table := Ets new: #handleInfoCrash type: #set
    server := FailingHandleInfoServer spawnWith: #{
      #tableName => #handleInfoCrash
    }
    server onExit: [:reason | table at: #exitReason put: reason]
    server pid send: #crash
    50 timesRepeat: [(table at: #exitReason) isNil ifTrue: [Timer sleep: 10]]
    self deny: server isAlive
    // gen_server exits with {Error, Stacktrace}; the error is the one raised.
    exitReason := table at: #exitReason
    self assert: (exitReason at: 1) message equals: "deliberate handleInfo: error"
    // terminate: ran with the same reason.
    self assert: (table at: #terminateReason) equals: exitReason
    table delete

  testHandleInfoErrorCrashesServerWithoutTerminateHook =>
    // No terminate: override, so the server does not trap exits; the
    // crash path is the same.
    table := Ets new: #handleInfoCrashPlain type: #set
    server := FailingPlainHandleInfoServer spawn
    server onExit: [:reason | table at: #exitReason put: reason]
    server pid send: #anything
    50 timesRepeat: [(table at: #exitReason) isNil ifTrue: [Timer sleep: 10]]
    self deny: server isAlive
    self assert: ((table at: #exitReason) at: 1) message equals: "deliberate plain handleInfo: error"
    table delete

  testSupervisedServerRestartsAfterHandleInfoError =>
    sup := (FailingHandleInfoSup supervise) unwrap
    server :: FailingHandleInfoServer := (sup which: FailingHandleInfoServer) unwrap
    server pid send: #crash
    50 timesRepeat: [server isAlive ifTrue: [Timer sleep: 10]]
    self deny: server isAlive
    restarted := (sup which: FailingHandleInfoServer) unwrap
    50
      timesRepeat: [
        (restarted isNil or: [restarted =:= server])
          ifTrue: [
            Timer sleep: 10
            restarted := (sup which: FailingHandleInfoServer) unwrap
          ]
      ]
    fresh :: FailingHandleInfoServer := (sup which: FailingHandleInfoServer) unwrap
    self deny: fresh =:= server
    self assert: fresh isAlive
    self assert: fresh getCount equals: 0
    sup stop
