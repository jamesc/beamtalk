// BT-3750 (ADR 0131 Phase 4): a loop frame x catch-boundary construct matrix
// over `Result tryDo:`, `on:do:` and `ensure:` with a `Dictionary` lookup
// (BT-3798) or a nested `tryDo:` in the protected block, in a class, a
// value-type and an actor method. Each answers the count of `t` writes the
// construct keeps: a raise inside `tryDo:` discards its write.

TestCase subclass: ResultTryDoTier2MatrixTest

  testDoTryLookup =>
    self assert: #[ResultTryDoTier2MatrixClass doTryLookup, (ResultTryDoTier2MatrixValue new) doTryLookup, (ResultTryDoTier2MatrixActor spawn) doTryLookup] equals: #[2, 2, 2]

  testDoTryDirect =>
    self assert: #[ResultTryDoTier2MatrixClass doTryDirect, (ResultTryDoTier2MatrixValue new) doTryDirect, (ResultTryDoTier2MatrixActor spawn) doTryDirect] equals: #[2, 2, 2]

  testDoTryNested =>
    self assert: #[ResultTryDoTier2MatrixClass doTryNested, (ResultTryDoTier2MatrixValue new) doTryNested, (ResultTryDoTier2MatrixActor spawn) doTryNested] equals: #[2, 2, 2]

  testDoTryHeadRead =>
    self assert: #[ResultTryDoTier2MatrixClass doTryHeadRead, (ResultTryDoTier2MatrixValue new) doTryHeadRead, (ResultTryDoTier2MatrixActor spawn) doTryHeadRead] equals: #[4, 4, 4]

  testDoOnDoHeadRead =>
    self assert: #[ResultTryDoTier2MatrixClass doOnDoHeadRead, (ResultTryDoTier2MatrixValue new) doOnDoHeadRead, (ResultTryDoTier2MatrixActor spawn) doOnDoHeadRead] equals: #[4, 4, 4]

  testDoTryPureWrite =>
    self assert: #[ResultTryDoTier2MatrixClass doTryPureWrite, (ResultTryDoTier2MatrixValue new) doTryPureWrite, (ResultTryDoTier2MatrixActor spawn) doTryPureWrite] equals: #[1, 1, 1]

  testDoOnDoPureWrite =>
    self assert: #[ResultTryDoTier2MatrixClass doOnDoPureWrite, (ResultTryDoTier2MatrixValue new) doOnDoPureWrite, (ResultTryDoTier2MatrixActor spawn) doOnDoPureWrite] equals: #[1, 1, 1]

  testDoTryHeadWrite =>
    self assert: #[ResultTryDoTier2MatrixClass doTryHeadWrite, (ResultTryDoTier2MatrixValue new) doTryHeadWrite, (ResultTryDoTier2MatrixActor spawn) doTryHeadWrite] equals: #[5, 5, 5]

  testDoTryRaise =>
    self assert: #[ResultTryDoTier2MatrixClass doTryRaise, (ResultTryDoTier2MatrixValue new) doTryRaise, (ResultTryDoTier2MatrixActor spawn) doTryRaise] equals: #[0, 0, 0]

