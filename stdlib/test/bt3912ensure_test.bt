// BT-3912 (BT-3947): see stdlib/test/fixtures/bt3912ensure_{class,value,actor}.bt.

TestCase subclass: Bt3912EnsureTest

  testDirect0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass direct: (sinks at: 1)), ((Bt3912EnsureValue new) direct: (sinks at: 2)), ((Bt3912EnsureActor spawn) direct: (sinks at: 3))] equals: #[1, 1, 1]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(1), #(1), #(1)]

  testReturnedAssign0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass returnedAssign: (sinks at: 1)), ((Bt3912EnsureValue new) returnedAssign: (sinks at: 2)), ((Bt3912EnsureActor spawn) returnedAssign: (sinks at: 3))] equals: #[1, 1, 1]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(1), #(1), #(1)]

  testInArm0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass inArm: (sinks at: 1) x: true), ((Bt3912EnsureValue new) inArm: (sinks at: 2) x: true), ((Bt3912EnsureActor spawn) inArm: (sinks at: 3) x: true)] equals: #[5, 5, 5]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(5), #(5), #(5)]

  testInArm1 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass inArm: (sinks at: 1) x: false), ((Bt3912EnsureValue new) inArm: (sinks at: 2) x: false), ((Bt3912EnsureActor spawn) inArm: (sinks at: 3) x: false)] equals: #[9, 9, 9]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(9), #(9), #(9)]

  testInCollect0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass inCollect: (sinks at: 1)), ((Bt3912EnsureValue new) inCollect: (sinks at: 2)), ((Bt3912EnsureActor spawn) inCollect: (sinks at: 3))] equals: #[1, 1, 1]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(1), #(1), #(1)]

  testInCounted0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass inCounted: (sinks at: 1)), ((Bt3912EnsureValue new) inCounted: (sinks at: 2)), ((Bt3912EnsureActor spawn) inCounted: (sinks at: 3))] equals: #[6, 6, 6]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(6), #(6), #(6)]

  testInWhile0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass inWhile: (sinks at: 1)), ((Bt3912EnsureValue new) inWhile: (sinks at: 2)), ((Bt3912EnsureActor spawn) inWhile: (sinks at: 3))] equals: #[4, 4, 4]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(4), #(4), #(4)]

  testTwoLocals0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass twoLocals: (sinks at: 1)), ((Bt3912EnsureValue new) twoLocals: (sinks at: 2)), ((Bt3912EnsureActor spawn) twoLocals: (sinks at: 3))] equals: #[3, 3, 3]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(3), #(3), #(3)]

  testNested0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass nested: (sinks at: 1)), ((Bt3912EnsureValue new) nested: (sinks at: 2)), ((Bt3912EnsureActor spawn) nested: (sinks at: 3))] equals: #[1, 1, 1]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(1, 11), #(1, 11), #(1, 11)]

  testCleanupWrites0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass cleanupWrites: (sinks at: 1)), ((Bt3912EnsureValue new) cleanupWrites: (sinks at: 2)), ((Bt3912EnsureActor spawn) cleanupWrites: (sinks at: 3))] equals: #[1, 1, 1]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(101), #(101), #(101)]

  testEnsureInLoop0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass ensureInLoop: (sinks at: 1)), ((Bt3912EnsureValue new) ensureInLoop: (sinks at: 2)), ((Bt3912EnsureActor spawn) ensureInLoop: (sinks at: 3))] equals: #[1, 1, 1]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(1), #(1), #(1)]

  testUnwritten0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass unwritten: (sinks at: 1)), ((Bt3912EnsureValue new) unwritten: (sinks at: 2)), ((Bt3912EnsureActor spawn) unwritten: (sinks at: 3))] equals: #[7, 7, 7]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(4), #(4), #(4)]

  testAfterLoop0 =>
    sinks := #[Bt3912EnsureSink spawn, Bt3912EnsureSink spawn, Bt3912EnsureSink spawn]
    self assert: #[(Bt3912EnsureClass afterLoop: (sinks at: 1)), ((Bt3912EnsureValue new) afterLoop: (sinks at: 2)), ((Bt3912EnsureActor spawn) afterLoop: (sinks at: 3))] equals: #[3, 3, 3]
    self assert: #[(sinks at: 1) items, (sinks at: 2) items, (sinks at: 3) items] equals: #[#(3), #(3), #(3)]

