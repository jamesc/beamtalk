// BT-3803: a parenthesized field assignment in value position of a send is a
// legal expression (docs/beamtalk-language-features.md, "Parenthesized
// assignment") that answers the assigned value AND commits the state change for
// everything after it. Each test runs one shape of
// fixtures/bt3803field_assign_actor.bt on a fresh actor.

TestCase subclass: FieldAssignmentValuePositionTest
  field: a = nil

  setUp => self.a := Bt3803FieldAssignActor spawn

  tearDown => self.a isNil ifFalse: [self.a stop]

  testSendArg => self assert: self.a sendArg equals: #[5, 5]

  testBinaryOperand => self assert: self.a binaryOperand equals: #[6, 5]

  testTwoOperands => self assert: self.a twoOperands equals: #[22, 20]

  testOperandReadsEarlierWrite =>
    self assert: self.a operandReadsEarlierWrite equals: #[10, 5]

  testFieldWriteRhs => self assert: self.a fieldWriteRhs equals: #[7, 7]

  testLastStatement =>
    self assert: self.a lastStatement equals: 9
    self assert: self.a getN equals: 9

  testConditionalArm => self assert: self.a conditionalArm equals: #[4, 4]

  testLoopBody => self assert: self.a loopBody equals: 3
