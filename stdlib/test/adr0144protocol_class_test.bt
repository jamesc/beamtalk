// ADR 0144 (BT-4435): `P class` for a protocol `P` types the class object of
// any class conforming to `P`. Fixtures: fixtures/adr0144transport.bt (the
// protocol), adr0144tcp_transport.bt / adr0144ssl_transport.bt (the two
// conformers) and adr0144socket.bt (a `:: Adr0144Transport class` field).
// The suite runs under `--warnings-as-errors`, so it also pins that the
// fixtures type-check cleanly.

TestCase subclass: Adr0144ProtocolClassTest

  testDefaultTransportSends =>
    self assert: (Adr0144Socket new send: 1) equals: "tcp:1"

  testOtherConformerSends =>
    socket := Adr0144Socket new withTransport: Adr0144SslTransport
    self assert: (socket send: 2) equals: "ssl:2"

  testRequirementWithoutArguments =>
    self assert: (Adr0144Socket new withTransport: Adr0144SslTransport) label equals: "ssl"

  testClassObjectProtocolFallback =>
    self assert: Adr0144Socket new transportName equals: #Adr0144TcpTransport

  testParameterTypedByProtocolClass =>
    self assert: (self labelOf: Adr0144TcpTransport) equals: "tcp"
    self assert: (self labelOf: Adr0144SslTransport) equals: "ssl"

  testConformersConform =>
    self assert: (Adr0144TcpTransport conformsTo: #Adr0144Transport)
    self assert: (Adr0144SslTransport conformsTo: #Adr0144Transport)

  labelOf: transport :: Adr0144Transport class -> String => transport label
