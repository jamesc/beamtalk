// BT-3380: An actor method whose selector collides with a Collection-protocol
// list-op selector (`collect:`, `select:`, `reject:`, `anySatisfy:`,
// `allSatisfy:`, `detect:`, `detect:ifNone:`, `count:`, `flatMap:`,
// `takeWhile:`, `dropWhile:`, `partition:`, `groupBy:`, `sort:`) must return
// its own plain result across the process boundary, not `{#ok, Result}` —
// the list-op runtime `is_list` guard's "not a list" fallback bypassed the
// actor reply-unwrap protocol. Same root cause as BT-3377, different codegen
// family. See fixtures/bt3380_collection_probe_actor.bt for the full
// root-cause writeup.

TestCase subclass: BT3380ActorListOpSelectorTest
  field: probe = nil

  setUp => self.probe := BT3380CollectionProbe spawn

  tearDown => self.probe isNil ifFalse: [self.probe stop]

  testExternalDoReturnsPlainResultNotOkTuple =>
    self.probe setTag: "do"
    self assert: (self.probe do: [:x | x]) equals: "do"

  testExternalCollectReturnsPlainResultNotOkTuple =>
    self.probe setTag: "collect"
    self assert: (self.probe collect: [:x | x]) equals: "collect"

  testExternalSelectReturnsPlainResultNotOkTuple =>
    self.probe setTag: "select"
    self assert: (self.probe select: [:x | x]) equals: "select"

  testExternalRejectReturnsPlainResultNotOkTuple =>
    self.probe setTag: "reject"
    self assert: (self.probe reject: [:x | x]) equals: "reject"

  testExternalAnySatisfyReturnsPlainResultNotOkTuple =>
    self.probe setTag: "anySatisfy"
    self assert: (self.probe anySatisfy: [:x | x]) equals: "anySatisfy"

  testExternalAllSatisfyReturnsPlainResultNotOkTuple =>
    self.probe setTag: "allSatisfy"
    self assert: (self.probe allSatisfy: [:x | x]) equals: "allSatisfy"

  testExternalDetectReturnsPlainResultNotOkTuple =>
    self.probe setTag: "detect"
    self assert: (self.probe detect: [:x | x]) equals: "detect"

  testExternalDetectIfNoneReturnsPlainResultNotOkTuple =>
    self.probe setTag: "detectIfNone"
    self assert: (self.probe detect: [:x |
      x
    ] ifNone: [nil]) equals: "detectIfNone"

  testExternalCountReturnsPlainResultNotOkTuple =>
    self.probe setTag: "count"
    self assert: (self.probe count: [:x | x]) equals: "count"

  testExternalFlatMapReturnsPlainResultNotOkTuple =>
    self.probe setTag: "flatMap"
    self assert: (self.probe flatMap: [:x | x]) equals: "flatMap"

  testExternalTakeWhileReturnsPlainResultNotOkTuple =>
    self.probe setTag: "takeWhile"
    self assert: (self.probe takeWhile: [:x | x]) equals: "takeWhile"

  testExternalDropWhileReturnsPlainResultNotOkTuple =>
    self.probe setTag: "dropWhile"
    self assert: (self.probe dropWhile: [:x | x]) equals: "dropWhile"

  testExternalPartitionReturnsPlainResultNotOkTuple =>
    self.probe setTag: "partition"
    self assert: (self.probe partition: [:x | x]) equals: "partition"

  testExternalGroupByReturnsPlainResultNotOkTuple =>
    self.probe setTag: "groupBy"
    self assert: (self.probe groupBy: [:x | x]) equals: "groupBy"

  testExternalSortReturnsPlainResultNotOkTuple =>
    self.probe setTag: "sort"
    self assert: (self.probe sort: [:a :b | a < b]) equals: "sort"
