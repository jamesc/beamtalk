// BT-3746 (ADR 0131 Phase 1a, PR #4230 review): `whileTrue:` loops whose
// condition writes a method local, in each method context. Each condition
// advances `t` to 3, so `run` answers #[3, 2] and the empty-body forms
// answer 3. A stateful condition (one that sends to `self`) in a value-type
// or actor method packs its write through the loop's `StateAcc`; the shared
// pack/unpack gate (`while_loop_threads`) must include it, or the loop
// produces a tuple nobody unpacks. A plain condition write, or any condition
// write in a class method, crashed or hung and is a compile error (BT-3782,
// ADR 0131 §6; pinned in `semantic_analysis/tests/local_threading.rs`).
// Fixtures: fixtures/bt3746stateful_while_{value,actor}.bt.

TestCase subclass: Bt3746StatefulWhileTest

  testValueTypeStatefulCondition =>
    self assert: Bt3746StatefulWhileValue new run equals: #[3, 2]

  testValueTypeStatefulConditionEmptyBody =>
    self assert: Bt3746StatefulWhileValue new runEmptyBody equals: 3

  testActorStatefulCondition =>
    self assert: Bt3746StatefulWhileActor spawn run equals: #[3, 2]

  testActorStatefulConditionEmptyBody =>
    self assert: Bt3746StatefulWhileActor spawn runEmptyBody equals: 3

  // BT-3845: every other shape the ADR 0131 §6 validator accepts
  // (`block_facts::while_condition_writes_thread`) threads at runtime.
  testValueTypeStatefulWhileFalse =>
    self assert: Bt3746StatefulWhileValue new runWhileFalse equals: #[3, 2]

  testValueTypeStatefulConditionSelfSendBody =>
    self assert: Bt3746StatefulWhileValue new runSelfSendBody equals: #[3, 2]

  testActorStatefulWhileFalse =>
    self assert: Bt3746StatefulWhileActor spawn runWhileFalse equals: #[3, 2]

  testActorFieldWritingCondition =>
    self assert: Bt3746StatefulWhileActor spawn runFieldCondition equals: #[3, 2, 3]

  testActorStatefulConditionSelfSendBody =>
    self assert: Bt3746StatefulWhileActor spawn runSelfSendBody equals: #[3, 2]
