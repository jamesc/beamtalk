// BT-3871 (ADR 0132 Phase 1c, epic BT-3865): a class method with a threading
// block parameter compiles to one body over `Acc` with two entries, and the
// PLAIN entry (today's name and arity) is a wrapper over it. Called from
// Beamtalk with a pure block, every method must answer what the structural
// fallback answered before the change. The threaded entries themselves are
// exercised directly from Erlang (beamtalk_threaded_class_entries_tests.erl),
// since no Beamtalk caller emits a threaded send before ADR 0132 Phase 1e.
//
// Fixture: fixtures/threaded_entry_fixture.bt.

TestCase subclass: ThreadedClassEntryTest
  field: cls = nil

  tearDown => self.cls isNil ifFalse: [self.cls removeFromSystem]

  // --- direct invocation ---------------------------------------------------
  testTwiceAnswersTheBlocksLastValue =>
    self assert: (ThreadedEntryFixture twice: [7]) equals: 7

  testApplyToPassesTheArgument =>
    self assert: (ThreadedEntryFixture apply: [:x | x + 1] to: 4) equals: 5

  testASecondParameterUsedInsideTheFirstsArgument =>
    self assert: (ThreadedEntryFixture two: [:x | x * 10] with: [4]) equals: 40

  // --- the callable argument of a collection message ----------------------
  testEachDoVisitsEveryItemAndAnswersNil =>
    self assert: (ThreadedEntryFixture each: #(1, 2, 3) do: [:x |
      x * 10
    ]) equals: nil

  testSumOverFoldsTheCallable =>
    self assert: (ThreadedEntryFixture sumOver: #(1, 2, 3) with: [:acc :x |
      acc + x
    ]) equals: 6

  testDetectInFindsTheFirstMatch =>
    self assert: (ThreadedEntryFixture detectIn: #(1, 2, 3) with: [:x |
      x > 1
    ]) equals: 2

  testDetectInFallsBackToTheIfNoneHandler =>
    self assert: (ThreadedEntryFixture detectIn: #(1, 2) with: [:x |
      x > 5
    ]) equals: 0

  // --- non-list receivers take the plain send (the fold is for lists) --------
  testACollectionMessageOnADictionaryAnswersWhatItAlwaysDid =>
    d := Dictionary new
    d at: #a put: 1
    d at: #b put: 2
    self assert: (ThreadedEntryFixture collectIn: d with: [:x |
      x
    ]) equals: (d collect: [:x | x])
    self assert: (ThreadedEntryFixture each: d do: [:x |
      x
    ]) equals: (d do: [:x | x])

  testACollectionMessageOnAStreamStaysLazy =>
    s := ThreadedEntryFixture collectIn: (Stream on: #(1, 2, 3)) with: [:x |
      x * 2
    ]
    self assert: (s isKindOf: Stream)
    self assert: s asList equals: #(2, 4, 6)

  testDetectOnAnInfiniteStreamTerminates =>
    self
      assert: (ThreadedEntryFixture
        detectIn: (Stream from: 1)
        with: [:x | x > 3]
        none: [0])
      equals: 4

  testACollectionMessageOnAStringAnswersWhatItAlwaysDid =>
    self assert: (ThreadedEntryFixture collectIn: "abc" with: [:c |
      c
    ]) equals: ("abc" collect: [:c | c])

  // --- a ClassBuilder fun inside a threaded body ----------------------------
  testAClassBuilderFunAfterTheUseAnswersItsBareValue =>
    ThreadedEntryFixture buildAfter: [1]
    self.cls := (Erlang beamtalk_interface) findClass: #ThreadedEntryBuiltAfter
    self assert: self.cls hi equals: 42

  testAClassBuilderFunBeforeTheUseAnswersItsBareValue =>
    ThreadedEntryFixture buildBefore: [1]
    self.cls := (Erlang beamtalk_interface) findClass: #ThreadedEntryBuiltBefore
    self assert: self.cls hi equals: 42

  // --- a same-class pass-on -------------------------------------------------
  testTwiceViaPassesTheBlockOn =>
    self assert: (ThreadedEntryFixture twiceVia: [8]) equals: 8

  // --- a non-local return beside an invocation ------------------------------
  testReturnFromABlockAnswersTheValue =>
    self assert: (ThreadedEntryFixture callThen: [
      1
    ] firstPositiveIn: #(-1, 0, 7, 8)) equals: 7

  testBodyThatFinishesWithoutTheReturnAnswersNil =>
    self assert: (ThreadedEntryFixture callThen: [
      1
    ] firstPositiveIn: #(-1, 0)) equals: nil

  // --- the body's own locals ---------------------------------------------------
  testALocalWrittenInALoopIsNotLostOrLeaked =>
    self assert: (ThreadedEntryFixture withLocals: [:t | t * 2]) equals: 12

  // --- shapes the predicate does not admit: unchanged ----------------------------

  // `b value: x` inside a nested block is ADR 0132 Phase 3: no threaded entry,
  // the method compiles as it always did.
  testDetectFirstWithTheInvocationInANestedBlockIsUnchanged =>
    self assert: (ThreadedEntryFixture detectFirst: [:x |
      x > 2
    ] over: #(1, 2, 3, 4)) equals: 3

  testAMethodWithoutABlockIsUnchanged =>
    self assert: (ThreadedEntryFixture plain: 1) equals: 2

  testAStoredBlockIsUnchanged =>
    self assert: (ThreadedEntryFixture storeAway: [1]) size equals: 2

  // --- the tier gate -------------------------------------------------------------

  // A block of the wrong arity raises a structured error rather than a raw
  // `badarity` (the gate is `beamtalk_dispatch:call_threaded/3`).
  testABlockOfAnImpossibleArityRaisesAStructuredError =>
    self should: [
      ThreadedEntryFixture twice: [:x :y | x]
    ] raise: #arity_mismatch

  // --- the plain entry and a Tier 2 block (BT-3871 review) -------------------
  //
  // The plain entry has no caller map to thread, so a (marked, BT-3885) Tier 2
  // block reaching it raises `stateful_block_dispatch`, unrun. ADR 0133
  // (BT-3902) makes a block that assigns a captured variable and escapes a
  // compile error, so no Beamtalk source can build one any more; the refusal is
  // pinned from Erlang (beamtalk_threaded_class_entries_tests.erl) until ADR
  // 0133 Phase 2 removes the entries.
  //
  // A wrong-arity block (one argument too many) has a Tier 2 block's arity but not
  // its mark (BT-3885), so it is the arity mistake it is, and it is not run.
  testAWrongArityBlockIsAnArityMismatch =>
    c := ThreadedEntryFixture
    self should: [c twice: [:x | x]] raise: #arity_mismatch

  testAWrongArityBlockIsNotRunBeforeTheError =>
    Erlang erlang erase: #bt3885Ran
    c := ThreadedEntryFixture
    self should: [
      c twice: [:x | Erlang erlang put: #bt3885Ran value: true]
    ] raise: #arity_mismatch
    self deny: ((Erlang erlang get_keys) includes: #bt3885Ran)

  // --- the gate with a real Acc map (BT-3885) --------------------------------
  //
  // No Beamtalk caller emits a threaded send, so these call the gate directly
  // through the FFI.
  testAWrongArityBlockGivenARealAccIsNotRun =>
    Erlang erlang erase: #bt3885Ran
    self
      should: [
        (Erlang beamtalk_dispatch)
          call_threaded: [:x | Erlang erlang put: #bt3885Ran value: true]
          with: #()
          with: #{}
      ]
      raise: #arity_mismatch
    self deny: ((Erlang erlang get_keys) includes: #bt3885Ran)

  // An Erlang FFI result shaped like a Tier 2 reply (`{ok, #{...}}`) from a
  // wrong-arity block is never taken for one.
  testAWrongArityBlockAnsweringAnOkMapIsNotATier2Reply =>
    ffi := [:x | Erlang erlang list_to_tuple: #(#ok, #{#foreign => 1})]
    self
      should: [
        (Erlang beamtalk_dispatch)
          call_threaded: ffi
          with: #()
          with: #{}
      ]
      raise: #arity_mismatch

  // An INHERITED class method: the subclass resolves `twice:` to the parent's
  // module and its plain wrapper.
  testAPureBlockThroughAnInheritedClassMethodStillWorks =>
    c := ThreadedEntryChild
    self assert: (c twice: [9]) equals: 9

  // --- valueWithArguments: as before ADR 0132 ---------------------------------
  testValueWithArgumentsOnABlock =>
    self assert: (ThreadedEntryFixture spread: [:x :y |
      x + y
    ] with: #(3, 4)) equals: 7

  // A non-block callable is sent `valueWithArguments:` itself, never `value:value:`.
  testValueWithArgumentsOnACallableThatAnswersOnlyValueWithArguments =>
    self assert: (ThreadedEntryFixture spreadUnthreaded: ArgsOnlyCallable new with: #(1, 2)) equals: 2
    self assert: (ThreadedEntryFixture spread: ArgsOnlyCallable new with: #(1, 2)) equals: 2

  // A non-list argument raises what the unthreaded expression raises.
  testValueWithArgumentsOfANonListRaisesWhatThePlainPathRaises =>
    plain := [
      ThreadedEntryFixture spreadUnthreaded: [:x | x] with: 5
    ] on: Exception do: [:e | e kind]
    threaded := [
      ThreadedEntryFixture spread: [:x | x] with: 5
    ] on: Exception do: [:e | e kind]
    self assert: threaded equals: plain

  testAPureBlockThroughADynamicReceiverStillWorks =>
    c := ThreadedEntryFixture
    self assert: (c twice: [5]) equals: 5
