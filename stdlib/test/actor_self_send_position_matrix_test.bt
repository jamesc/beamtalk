// BT-3414 (ADR 0118 phase 0): the self-send POSITION regression matrix.
//
// Every test method below drives one method of
// stdlib/test/fixtures/self_send_position_counter.bt — one canonical
// syntactic position for a self-send (or an `and:`/`or:` receiver/block
// that carries one), asserting both the method's own return value and the
// observed state-field mutation (`getCount`/`getLog`).
//
// Axes pinned here (see docs/ADR/0118-expression-level-state-threading-preludes.md
// §Context for the source probe table):
//   - PASSING positions (today, and expected to keep passing through every
//     ADR 0118 phase): loop bounds/receiver/body, ensure:, on:do: handler,
//     block `value`, count:/allSatisfy:/reject:/anySatisfy:, list-op
//     receiver, inject:into: initial value, do:separatedBy:, map literal,
//     interpolation, keyword arg, self-send arg, early return in a branch,
//     plain assignment RHS, and:/or: receiver and block.
//   - BROKEN positions (today): gated behind one `adr0118PhaseNPending`
//     switch per ADR 0118 phase (see the phase table in the ADR's
//     Implementation Tracking section). While a switch is `true` the test
//     asserts the CURRENT (wrong) behaviour — a dropped mutation or a
//     runtime crash — so the gate cannot silently mask a change; flipping a
//     switch to `false` (once that phase lands) must be paired with
//     updating the assertion to the correct value in the same commit.
//
// Three shapes from the same probe PANIC the ThreadedIr verifier today (a
// self-send/`and:` in a `whileTrue:` CONDITION block, and a bare-receiver
// `and:` inside an `ifTrue:` branch inside a `do:` body) and are pinned
// instead as `#[should_panic]` Rust unit tests in
// crates/beamtalk-codegen/src/core_erlang/tests/gen_server.rs — a
// debug-build verifier panic would abort this whole BUnit file.

TestCase subclass: ActorSelfSendPositionMatrixTest
  field: c = nil

  setUp => self withC: SelfSendPositionCounter spawn

  tearDown => self.c isNil ifFalse: [self.c stop]

  // ADR 0118 phase 1a (BT-3415): ThreadedValue, self-dispatch producer,
  // Actor body consumer, sequencing rule for sends/binary operands. Landed:
  // a `to:do:` bound / `timesRepeat:` receiver that is (or contains) a
  // self-send now threads ahead of the loop construct through the Actor
  // method body's own IR, so the affected cells run their ground-truth
  // asserts. Kept as a switch for documentation/bisection.
  adr0118Phase1aPending => false

  // ADR 0118 phase 1b: sequencing rule for literals, interpolation,
  // return, assignment, cascade, match: scrutinee.
  adr0118Phase1bPending => false

  // ADR 0118 phase 2a: conditional arms, exception arms, stateful-block
  // bodies, conditional receiver consume ThreadedValue (BT-3417). No matrix
  // row is gated on this phase — every position BT-3417 fixes (a self-send
  // nested in a conditional branch or an `on:do:`/`ensure:` body, including
  // the `Return`-value shapes `generate_conditional_branch_inline`'s C12
  // catch-all now reaches) already ran through the PASSING-POSITIONS
  // section above once landed, and
  // `testSelfSendAsBinaryOpArgumentInBoundsThreadsMutation`
  // (`actor_conditional_mutations_test.bt`) pins the BT-3399-order-unsafe
  // shape phase 2a's universal sequencing rule newly fixes. The two rows
  // that LOOKED phase-2a-shaped at a glance — a self-send nested in
  // `ifNil:ifNotNil:`'s block or a `match:` arm's body — turned out, on
  // inspection while implementing BT-3417, to route through codegen this
  // phase does not touch (`ifNil:ifNotNil:` always compiles its blocks as
  // genuine Tier 1 closures; `generate_match_arm_body`'s mutation-threading
  // fallback compiles its arm via a plain `expression_doc` call, never
  // `generate_conditional_branch_inline`/`thread_ahead`) — both are gated
  // on `adr0118Phase4Pending` below instead (see
  // `testIfNilIfNotNilBlockArgSelfSendNonNil`/`testMatchArmSelfSendMatchingArm`'s
  // own comments).

  // ADR 0118 phase 2b (BT-3418): loop-body consumers
  // (`generate_threaded_loop_body_inner`'s field-assignment RHS path,
  // `emit_non_assign_expr`, `generate_local_var_assignment_in_loop`)
  // consume `ThreadedValue`; the self-send hoist planner, `HoistSink`, and
  // the BT-3399 warning are deleted. Landed: `testDoLoopLocalAssignRhsSelfSend`
  // (a local-assignment RHS binary-op operand inside a `do:` body) is the
  // row this phase newly fixes — `testDoLoopFieldAssignRhsSelfSend` (a
  // field-assignment RHS) was already correct before this phase (see its
  // own comment). One row that LOOKED loop-body-shaped at a glance —
  // `sort:`'s comparator block — turned out, on inspection while
  // implementing BT-3418, to be a stored Tier 1 closure ARGUMENT rather
  // than a statement `generate_threaded_loop_body_inner` itself walks, so
  // none of this phase's three consumers ever reach it; re-scoped onto
  // `adr0118Phase4Pending` instead (see `testSortBlockSelfSend`'s own
  // comment) pending a dedicated follow-up.
  adr0118Phase2bPending => false

  // ADR 0118 phase 3: ConditionalLoop condition as IR.
  adr0118Phase3Pending => false

  // ADR 0118 phase 4 (BT-3420): inline-threaded control flow as a producer;
  // ifNil:ifNotNil:, match: arms, ifNone:, generic Tier 2 blocks. Landed.
  adr0118Phase4Pending => false

  // ════════════════════════════════════════════════════════════════════
  //  PASSING POSITIONS
  // ════════════════════════════════════════════════════════════════════
  testWhileTrueBodySelfSend =>
    self assert: self.c whileTrueBodySelfSend equals: 3
    self assert: self.c getCount equals: 3

  testWhileFalseBodySelfSend =>
    self assert: self.c whileFalseBodySelfSend equals: 3
    self assert: self.c getCount equals: 3

  testToByDoBodySelfSend =>
    self assert: self.c toByDoBodySelfSend equals: 3
    self assert: self.c getCount equals: 3

  testEnsureSelfSend =>
    self assert: self.c ensureSelfSend equals: 1
    self assert: self.c getCount equals: 1

  testOnDoHandlerSelfSend =>
    self assert: self.c onDoHandlerSelfSend equals: 1
    self assert: self.c getCount equals: 1

  testBlockValueSelfSend =>
    self assert: self.c blockValueSelfSend equals: 1
    self assert: self.c getCount equals: 1

  testCountBlockSelfSend =>
    self assert: self.c countBlockSelfSend equals: 3
    self assert: self.c getCount equals: 3

  testAllSatisfyBlockSelfSend =>
    self assert: self.c allSatisfyBlockSelfSend equals: true
    self assert: self.c getCount equals: 3

  testRejectBlockSelfSend =>
    self assert: self.c rejectBlockSelfSend equals: #()
    self assert: self.c getCount equals: 3

  testAnySatisfyBlockSelfSend =>
    self assert: self.c anySatisfyBlockSelfSend equals: false
    self assert: self.c getCount equals: 3

  testListOpReceiverSelfSend =>
    self assert: self.c listOpReceiverSelfSend equals: 1
    self assert: self.c getCount equals: 1

  testInjectIntoInitialValueSelfSend =>
    self assert: self.c injectIntoInitialValueSelfSend equals: 61
    self assert: self.c getCount equals: 1

  testDoSeparatedBySelfSend =>
    self assert: self.c doSeparatedBySelfSend equals: 2
    self assert: self.c getCount equals: 2

  testMapLiteralSelfSend =>
    self assert: self.c mapLiteralSelfSend equals: 1
    self assert: self.c getCount equals: 1

  testInterpolationSelfSend =>
    self assert: self.c interpolationSelfSend equals: "n=1"
    self assert: self.c getCount equals: 1

  testKeywordArgSelfSend =>
    self assert: self.c keywordArgSelfSend equals: 10
    self assert: self.c getCount equals: 1

  testSelfSendArgSelfSend =>
    self assert: self.c selfSendArgSelfSend equals: 1
    self assert: self.c getCount equals: 1
    self assert: self.c getLog equals: #(1)

  // BT-3420 (ADR 0118 phase 4): a mutation-threaded conditional nested as
  // an argument INSIDE another conditional's branch body — the tuple leak
  // that `try generate_expression`'s C12 catch-all inside a branch used to
  // let through unwrapped, fixed by the same inline-control-flow producer
  // as the top-level `conditionalArgToKeywordSendSelfSend` shape.
  testConditionalArgInsideBranchSelfSendTrue =>
    self assert: (self.c conditionalArgInsideBranchSelfSend: true) equals: 1
    self assert: self.c getCount equals: 1
    self assert: self.c getLog equals: #(1)

  testConditionalArgInsideBranchSelfSendFalse =>
    self assert: (self.c conditionalArgInsideBranchSelfSend: false) equals: 0
    self assert: self.c getCount equals: 0

  // BT-3420 (ADR 0118 phase 4): self-send in the `ifNil:` (nil) block
  // specifically — the mirror image of `ifNilIfNotNilBlockArgSelfSend`'s
  // `ifNotNil:` block below.
  testIfNilBlockArgSelfSendNil =>
    self assert: (self.c ifNilBlockArgSelfSend: nil) equals: 1
    self assert: self.c getCount equals: 1

  testIfNilBlockArgSelfSendNonNil =>
    self assert: (self.c ifNilBlockArgSelfSend: 5) equals: 0
    self assert: self.c getCount equals: 0

  testEarlyReturnInBranchSelfSendTrue =>
    self assert: (self.c earlyReturnInBranchSelfSend: true) equals: 10
    self assert: self.c getCount equals: 1

  testEarlyReturnInBranchSelfSendFalse =>
    self assert: (self.c earlyReturnInBranchSelfSend: false) equals: 0
    self assert: self.c getCount equals: 0

  testAssignmentRhsSelfSend =>
    self assert: self.c assignmentRhsSelfSend equals: 1
    self assert: self.c getCount equals: 1

  testFfiArgSelfSend =>
    self assert: self.c ffiArgSelfSend equals: #(1)
    self assert: self.c getCount equals: 1

  // BT-3415 review: `^ 1 + ((self flagTrue) ifTrue: [1] ifFalse: [2])`.
  // Compiles (the method-body `^` arm replies with the state after its
  // PRELUDE, never a version minted inside the value's own closed
  // document — the BT-3415 regression), but the mutation-threaded
  // conditional in operand position still leaks its `{Result, State}`
  // tuple into `+` at runtime — ADR 0118 phase 4 territory, same class
  // as `conditionalArgToKeywordSendSelfSend`.
  testEarlyReturnConditionalReceiverSelfSend =>
    self adr0118Phase4Pending
      ifTrue: [
        self should: [
          self.c earlyReturnConditionalReceiverSelfSend
        ] raise: #does_not_understand
        self assert: self.c getCount equals: 0
      ]
      ifFalse: [
        self assert: self.c earlyReturnConditionalReceiverSelfSend equals: 2
        self assert: self.c getCount equals: 1
      ]

  testRaisingOperandBeforeSelfSendInRange =>
    self assert: (self.c raisingOperandBeforeSelfSend: 1) equals: 11
    self assert: self.c getCount equals: 1

  // Out of range: `at:` raises BEFORE `bumpCount` runs, so no mutation
  // lands — the behavioural half of the evaluation-order guarantee.
  testRaisingOperandBeforeSelfSendOutOfRange =>
    self should: [
      self.c raisingOperandBeforeSelfSend: 99
    ] raise: #index_out_of_bounds
    self assert: self.c getCount equals: 0

  testAndReceiverSelfSend =>
    self assert: self.c andReceiverSelfSend equals: true
    self assert: self.c getCount equals: 1

  testAndBlockSelfSend =>
    self assert: self.c andBlockSelfSend equals: true
    self assert: self.c getCount equals: 1

  testOrReceiverSelfSend =>
    self assert: self.c orReceiverSelfSend equals: true
    self assert: self.c getCount equals: 1

  testOrBlockSelfSend =>
    self assert: self.c orBlockSelfSend equals: true
    self assert: self.c getCount equals: 1

  // ════════════════════════════════════════════════════════════════════
  //  BROKEN POSITIONS — gated, asserting current (wrong) behaviour
  // ════════════════════════════════════════════════════════════════════

  // ADR 0118 phase 1a: `to:do:`'s upper-bound argument is a self-send.
  // Before BT-3415 the sum still computed correctly (the bound literally
  // is 3, so `bumpCount`'s return value fed through) but the mutation to
  // the actor's own `count` field never landed.
  testToDoBoundsSelfSend =>
    self assert: self.c toDoBoundsSelfSend equals: 6
    self adr0118Phase1aPending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  // `timesRepeat:`'s receiver is a self-send: the block runs the correct
  // number of times (`n` = 1, matching `bumpCount`'s return value); before
  // BT-3415 the mutation to the actor's own `count` field was dropped
  // (ADR 0118 phase 1a).
  testTimesRepeatReceiverSelfSend =>
    self assert: self.c timesRepeatReceiverSelfSend equals: 1
    self adr0118Phase1aPending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  // ADR 0118 phase 3 (ConditionalLoop condition as IR): a self-send used
  // as a binary-op operand inside a whileTrue: CONDITION block crashes
  // today (arity mismatch); once the condition's prelude runs in the
  // loop's own frame, `i` should settle at 3 and `bumpCount` run 3 times.
  testWhileTrueConditionBinaryOpSelfSend =>
    self adr0118Phase3Pending
      ifTrue: [
        self should: [
          self.c whileTrueConditionBinaryOpSelfSend
        ] raise: #arity_mismatch
      ]
      ifFalse: [
        self assert: self.c whileTrueConditionBinaryOpSelfSend equals: 3
        self assert: self.c getCount equals: 3
      ]

  testWhileTrueConditionAndOperandSelfSend =>
    self adr0118Phase3Pending
      ifTrue: [
        self should: [
          self.c whileTrueConditionAndOperandSelfSend
        ] raise: #arity_mismatch
      ]
      ifFalse: [
        self assert: self.c whileTrueConditionAndOperandSelfSend equals: 3
        self assert: self.c getCount equals: 2
      ]

  // ADR 0118 phase 4 (inline-threaded control flow as a producer): a
  // conditional used as a keyword-send argument leaks the RAW
  // `{Result, State}` tuple into the argument today — `record:` appends
  // the whole tuple to `log`, and the ACTUAL actor state (`count`) never
  // advances because the leaked tuple, not a real dispatch reply, is what
  // the caller sees. Pinned via `printString` (a Beamtalk literal cannot
  // express a raw Erlang tuple) rather than by reconstructing the leak.
  testConditionalArgToKeywordSendSelfSendTrue =>
    self adr0118Phase4Pending
      ifTrue: [
        leaked := self.c conditionalArgToKeywordSendSelfSend: true
        self assert: (leaked printString includesSubstring: "SelfSendPositionCounter") equals: true
        self assert: self.c getCount equals: 0
      ]
      ifFalse: [
        self assert: (self.c conditionalArgToKeywordSendSelfSend: true) equals: 1
        self assert: self.c getCount equals: 1
        self assert: self.c getLog equals: #(1)
      ]

  testConditionalArgToKeywordSendSelfSendFalse =>
    self adr0118Phase4Pending
      ifTrue: [
        leaked := self.c conditionalArgToKeywordSendSelfSend: false
        self assert: (leaked printString includesSubstring: "SelfSendPositionCounter") equals: true
        self assert: self.c getCount equals: 0
      ]
      ifFalse: [
        self assert: (self.c conditionalArgToKeywordSendSelfSend: false) equals: 0
        self assert: self.c getCount equals: 0
        self assert: self.c getLog equals: #(0)
      ]

  testConditionalArgToAtColonSelfSendTrue =>
    self adr0118Phase4Pending
      ifTrue: [
        self should: [
          self.c conditionalArgToAtColonSelfSend: true
        ] raise: #type_error
      ]
      ifFalse: [
        self assert: (self.c conditionalArgToAtColonSelfSend: true) equals: 10
        self assert: self.c getCount equals: 1
      ]

  testConditionalArgToAtColonSelfSendFalse =>
    self adr0118Phase4Pending
      ifTrue: [
        self should: [
          self.c conditionalArgToAtColonSelfSend: false
        ] raise: #type_error
      ]
      ifFalse: [
        self assert: (self.c conditionalArgToAtColonSelfSend: false) equals: 20
        self assert: self.c getCount equals: 0
      ]

  testDetectIfNoneSelfSend =>
    self adr0118Phase4Pending
      ifTrue: [
        self should: [self.c detectIfNoneSelfSend] raise: #argument_error
      ]
      ifFalse: [
        self assert: self.c detectIfNoneSelfSend equals: 1
        self assert: self.c getCount equals: 1
      ]

  // ADR 0118 phase 1b (sequencing rule for cascade): a cascade on `self`
  // silently drops every message's mutation today — no crash, no warning.
  testCascadeOnSelfSelfSend =>
    self adr0118Phase1bPending
      ifTrue: [
        self assert: self.c cascadeOnSelfSelfSend equals: #()
        self assert: self.c getCount equals: 0
      ]
      ifFalse: [
        self assert: self.c cascadeOnSelfSelfSend equals: #(1, 2)
        self assert: self.c getCount equals: 0
      ]

  testCascadeArgumentSelfSendSelfSend =>
    self adr0118Phase1bPending
      ifTrue: [
        self assert: self.c cascadeArgumentSelfSendSelfSend equals: #()
        self assert: self.c getCount equals: 0
      ]
      ifFalse: [
        self assert: self.c cascadeArgumentSelfSendSelfSend equals: #(1, 1)
        self assert: self.c getCount equals: 1
      ]

  // ADR 0118 phase 4 (BT-3417 correction: `ifNil:ifNotNil:` always compiles
  // its blocks as genuine Tier 1 closures — `intrinsics.rs`'s
  // `WellKnownSelector::IfNilIfNotNil` arm never reaches
  // `generate_block_stateful`, so phase 2a's stateful-block-body migration
  // does not touch this shape; it needs `ifNil:ifNotNil:` itself to become
  // an inline-threaded producer first). The block's own computed VALUE is
  // correct today — only the nested self-send's actor-state mutation is
  // silently lost.
  testIfNilIfNotNilBlockArgSelfSendNonNil =>
    self assert: (self.c ifNilIfNotNilBlockArgSelfSend: 5) equals: 6
    self adr0118Phase4Pending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  testIfNilIfNotNilBlockArgSelfSendNil =>
    self assert: (self.c ifNilIfNotNilBlockArgSelfSend: nil) equals: 0
    self assert: self.c getCount equals: 0

  // ADR 0118 phase 4 (BT-3417 correction: a `match:` arm's mutation-
  // threading fallback, `generate_match_arm_body`, compiles its body via a
  // plain `expression_doc` call — never `generate_conditional_branch_inline`/
  // `thread_ahead` — so phase 2a's conditional-arm migration does not reach
  // this shape either). Same symptom — the arm's own value is correct, the
  // nested mutation is dropped.
  testMatchArmSelfSendMatchingArm =>
    self assert: (self.c matchArmSelfSend: 1) equals: 2
    self adr0118Phase4Pending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  testMatchArmSelfSendWildcardArm =>
    self assert: (self.c matchArmSelfSend: 2) equals: 0
    self assert: self.c getCount equals: 0

  // ADR 0118 phase 1b (match: scrutinee sequencing rule).
  testMatchScrutineeSelfSend =>
    self assert: self.c matchScrutineeSelfSend equals: #one
    self adr0118Phase1bPending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  // Re-scoped off `adr0118Phase2bPending` while implementing BT-3418: this
  // LOOKED loop-body-shaped at a glance (like the two rows below, which
  // phase 2b genuinely does fix), but `sort:`'s comparator is a stored
  // Tier 1 closure ARGUMENT — never a statement inside
  // `generate_threaded_loop_body_inner`'s own per-statement loop — so
  // none of phase 2b's three consumers (`emit_non_assign_expr`,
  // `generate_local_var_assignment_in_loop`, the field-assignment RHS
  // path) ever reach it; confirmed empirically (flipping the gate off
  // while implementing BT-3418 failed this test: `getCount` stayed `0`).
  // `sort:`'s own comparator never affects ordering here, so the sorted
  // VALUE is already correct either way; only the comparator's self-send
  // mutation is dropped. Filed as a genuine gap outside ADR 0118's
  // phase 1-4 consumer list (§Decision 4) rather than folded into any
  // existing phase switch — gated on `adr0118Phase4Pending` for now as
  // the nearest not-yet-landed phase, pending its own follow-up issue.
  testSortBlockSelfSend =>
    self assert: self.c sortBlockSelfSend equals: #(10, 30)
    self adr0118Phase4Pending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  // Loop-body field-assignment RHS with a nested self-send: unlike the
  // ADR 0118 §Context probe's informal note for this shape, empirically
  // this position ALREADY threads correctly today (BT-3176 axis 4's
  // "state field threaded like an outer local" mechanism already covers
  // a field read-then-write whose RHS nests a self-send, even inside a
  // `do:` loop body) — not gated. Per-iteration, `count` is read BEFORE
  // `bumpCount` runs (evaluation order), then reassigned to
  // read-value + bumpCount's return: 0+1=1, then 1+2=3, then 3+4=7.
  testDoLoopFieldAssignRhsSelfSend =>
    self assert: self.c doLoopFieldAssignRhsSelfSend equals: 7

  // ADR 0118 phase 2b (BT-3418): loop-body local-assignment RHS —
  // `generate_local_var_assignment_in_loop` now threads a nested self-send
  // ahead of the RHS's own compile via `thread_ahead`, deleting the
  // BT-3399 warning this shape used to emit. The outer LOCAL `y` already
  // threaded correctly via the pre-existing loop-local mechanism even
  // before this phase; what was missing was `bumpCount`'s own actor-state
  // mutation.
  testDoLoopLocalAssignRhsSelfSend =>
    self assert: self.c doLoopLocalAssignRhsSelfSend equals: 4
    self assert: self.c getCount equals: 3

  // Landed in ADR 0118 phase 1a (BT-3415), not 1b as first expected: the
  // RHS's PARENT node is a binary-op send (`self.items size + (self
  // bumpCount)`), and a method-body local assignment is a phase-1a
  // consumer — the sequencing rule temp-binds `self.items size` ahead of
  // `bumpCount`'s dispatch and the BT-3399 warning is gone for this
  // shape. Phase 1b's "assignment values" scope is an assignment nested
  // INSIDE another expression, which this row is not.
  testAssignRhsBinaryOpSelfSend =>
    self assert: self.c assignRhsBinaryOpSelfSend equals: 4
    self adr0118Phase1aPending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]

  // ADR 0118 phase 1b (interpolation-segment binary-op sequencing;
  // deletes the BT-3399 warning for this shape).
  testInterpolationBinaryOpSelfSend =>
    self assert: self.c interpolationBinaryOpSelfSend equals: "3-1"
    self adr0118Phase1bPending ifTrue: [
      self assert: self.c getCount equals: 0
    ] ifFalse: [self assert: self.c getCount equals: 1]
