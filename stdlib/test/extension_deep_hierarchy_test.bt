// BT-5002: an extension on a class wins over that class's own compiled method
// for every receiver below it, at any depth. Lookup walks the superclass chain
// from the receiver's class; at each class an extension on it takes precedence
// over its compiled method, and the first class that has the selector by
// either route wins. Before the fix, a class two or more levels below the
// extended class skipped the extension whenever the extended class also
// compiled the selector (the owner's compiled method was called directly).
//
// Covers actor and value-type hierarchies, instance and class side, an
// extension installed before and after the receiver's class was first used
// (the memoised verdict is flushed), removal, and a nearer override. One case
// is pinned as still wrong (BT-5060): a value class's direct subclass. The
// `Actor` cases (the three sealed intrinsics) install node-wide extensions, so
// this class runs serially.
//
// Fixtures: fixtures/bt5002actor_*.bt, bt5002value_*.bt, bt4995plain.bt,
// bt4995mid.bt, bt4995leaf.bt.

TestCase subclass: ExtensionDeepHierarchyTest
  field: table = nil

  class serial -> Boolean => true

  setUp => self.table := Ets new: #bt5002Table type: #set

  tearDown => self.table delete

  ext: className selector: sel value: v =>
    Erlang beamtalk_extensions
      register: className
      selector: sel
      fun: [:args :receiver | v]
      owner: #bt5002

  unext: className selector: sel =>
    Erlang beamtalk_extensions unregister: className selector: sel

  /// Run `body` and always spawn, stop, and uninstall afterwards.
  withActor: cls do: body =>
    a := cls spawn
    [body value: a] ensure: [a isAlive ifTrue: [a stop]]

  // === actor instance side ===
  testExtensionOnTheOwnerIsSeenByADirectChild =>
    self
      ext: #Bt5002ActorBase
      selector: #greet
      value: #fromExt
    [
      self withActor: Bt5002ActorMid do: [:a |
        self assert: a greet equals: #fromExt
      ]
    ] ensure: [self unext: #Bt5002ActorBase selector: #greet]

  testExtensionOnTheOwnerIsSeenByAGrandchild =>
    self
      ext: #Bt5002ActorBase
      selector: #greet
      value: #fromExt
    [
      self
        withActor: Bt5002ActorLeaf
        do: [:a |
          self assert: a greet equals: #fromExt
          self assert: a greet equals: #fromExt
        ]
    ] ensure: [self unext: #Bt5002ActorBase selector: #greet]

  /// ADR 0066: an extension cannot override a method of the receiver's own
  /// class body; it only wins over what the receiver inherits.
  testReceiversOwnCompiledMethodBeatsAnExtensionOnItsOwnClass =>
    self
      ext: #Bt5002ActorBase
      selector: #greet
      value: #fromExt
    [
      self withActor: Bt5002ActorBase do: [:a |
        self assert: a greet equals: #compiledBase
      ]
    ] ensure: [self unext: #Bt5002ActorBase selector: #greet]

  testExtensionInstalledAfterTheGrandchildWasWarmIsSeenAndRemovalRestores =>
    self
      withActor: Bt5002ActorLeaf
      do: [:a |
        self assert: a greet equals: #compiledBase
        self assert: a greet equals: #compiledBase
        self
          ext: #Bt5002ActorBase
          selector: #greet
          value: #fromExt
        [
          self assert: a greet equals: #fromExt
        ] ensure: [self unext: #Bt5002ActorBase selector: #greet]
        self assert: a greet equals: #compiledBase
      ]

  testExtensionInstalledBeforeTheGrandchildWasFirstUsed =>
    self
      ext: #Bt5002ActorBase
      selector: #greet
      value: #fromExt
    [
      self withActor: Bt5002ActorLeaf do: [:a |
        self assert: a greet equals: #fromExt
      ]
    ] ensure: [self unext: #Bt5002ActorBase selector: #greet]
    self withActor: Bt5002ActorLeaf do: [:a |
      self assert: a greet equals: #compiledBase
    ]

  testExtensionOnAMiddleClassBeatsTheOwnersCompiledMethodForItsDescendants =>
    self
      ext: #Bt5002ActorMid
      selector: #greet
      value: #fromMidExt
    [
      self withActor: Bt5002ActorLeaf do: [:a |
        self assert: a greet equals: #fromMidExt
      ]
      self withActor: Bt5002ActorBase do: [:a |
        self assert: a greet equals: #compiledBase
      ]
    ] ensure: [self unext: #Bt5002ActorMid selector: #greet]

  testNearerExtensionBeatsFartherExtension =>
    self
      ext: #Bt5002ActorBase
      selector: #greet
      value: #fromBaseExt
    self
      ext: #Bt5002ActorMid
      selector: #greet
      value: #fromMidExt
    [
      self withActor: Bt5002ActorLeaf do: [:a |
        self assert: a greet equals: #fromMidExt
      ]
    ]
      ensure: [
        self unext: #Bt5002ActorMid selector: #greet
        self unext: #Bt5002ActorBase selector: #greet
      ]

  testOverrideBelowTheOwnerBeatsTheOwnersExtension =>
    self
      ext: #Bt5002ActorBase
      selector: #greet
      value: #fromExt
    [
      self withActor: Bt5002ActorOver do: [:a |
        self assert: a greet equals: #compiledOver
      ]
      self withActor: Bt5002ActorDeep do: [:a |
        self assert: a greet equals: #compiledOver
      ]
    ] ensure: [self unext: #Bt5002ActorBase selector: #greet]

  // === actor class side ===
  testClassSideExtensionOnTheOwnerIsSeenByAGrandchild =>
    self
      ext: #'Bt5002ActorBase class'
      selector: #kind
      value: #fromExt
    [
      self assert: Bt5002ActorMid kind equals: #fromExt
      self assert: Bt5002ActorLeaf kind equals: #fromExt
    ] ensure: [self unext: #'Bt5002ActorBase class' selector: #kind]
    self assert: Bt5002ActorLeaf kind equals: #compiledBaseKind

  testClassSideOverrideBeatsTheOwnersClassSideExtension =>
    self
      ext: #'Bt5002ActorBase class'
      selector: #kind
      value: #fromExt
    [
      self assert: Bt5002ActorOver kind equals: #compiledOverKind
      self assert: Bt5002ActorDeep kind equals: #compiledOverKind
    ] ensure: [self unext: #'Bt5002ActorBase class' selector: #kind]

  // === value types ===
  //
  // Untyped call sites: a statically typed one may bind the owner's compiled
  // method at compile time.
  dynGreet: v => v greet

  /// PIN-BUG BT-5060: a direct subclass of a value class takes the one-hop
  /// route to the owner's compiled `dispatch/3` and never tries the owner's
  /// extension. A fix flips this to `#fromExt`.
  testValueExtensionOnTheOwnerIsIgnoredByADirectChildPinned =>
    self
      ext: #Bt5002ValueBase
      selector: #greet
      value: #fromExt
    [
      self assert: (self dynGreet: Bt5002ValueMid new) equals: #compiledBase
    ] ensure: [self unext: #Bt5002ValueBase selector: #greet]

  testValueExtensionOnTheOwnerIsSeenByAGrandchild =>
    self
      ext: #Bt5002ValueBase
      selector: #greet
      value: #fromExt
    [
      self assert: (self dynGreet: Bt5002ValueLeaf new) equals: #fromExt
      self assert: (self dynGreet: Bt5002ValueLeaf new) equals: #fromExt
    ] ensure: [self unext: #Bt5002ValueBase selector: #greet]

  testValueExtensionInstalledAfterTheGrandchildWasWarmIsSeenAndRemovalRestores =>
    self assert: (self dynGreet: Bt5002ValueLeaf new) equals: #compiledBase
    self assert: (self dynGreet: Bt5002ValueLeaf new) equals: #compiledBase
    self
      ext: #Bt5002ValueBase
      selector: #greet
      value: #fromExt
    [
      self assert: (self dynGreet: Bt5002ValueLeaf new) equals: #fromExt
    ] ensure: [self unext: #Bt5002ValueBase selector: #greet]
    self assert: (self dynGreet: Bt5002ValueLeaf new) equals: #compiledBase

  testValueOverrideBelowTheOwnerBeatsTheOwnersExtension =>
    self
      ext: #Bt5002ValueBase
      selector: #greet
      value: #fromExt
    [
      self assert: (self dynGreet: Bt5002ValueOver new) equals: #compiledOver
    ] ensure: [self unext: #Bt5002ValueBase selector: #greet]

  testValueClassSideExtensionOnTheOwnerIsSeenByAGrandchild =>
    self
      ext: #'Bt5002ValueBase class'
      selector: #kind
      value: #fromExt
    [
      self assert: Bt5002ValueLeaf kind equals: #fromExt
    ] ensure: [self unext: #'Bt5002ValueBase class' selector: #kind]
    self assert: Bt5002ValueLeaf kind equals: #compiledBaseKind

  // === the sealed Actor intrinsics, extended on Actor itself ===
  //
  // Bt4995Leaf is three levels below Actor (Plain, Mid, Leaf). An extension on
  // `Actor` replaces the compiled `terminate:` for every actor class, whatever
  // its depth; installing and removing it is seen each time.
  recordingExt: sel key: key =>
    tbl := self.table
    Erlang beamtalk_extensions
      register: #Actor
      selector: sel
      fun: [:args :receiver |
        tbl at: key put: args first
        #ok
      ]
      owner: #bt5002

  testTerminateExtensionOnActorIsSeenByAClassThreeLevelsDown =>
    self recordingExt: #terminate: key: #extTerminate
    [
      a := Bt4995Leaf spawnWith: #{#tableName => #bt5002Table}
      a stop
      50 timesRepeat: [
        (self.table at: #extTerminate) isNil ifTrue: [Timer sleep: 10]
      ]
      self assert: (self.table at: #extTerminate) equals: #normal
    ] ensure: [self unext: #Actor selector: #terminate:]

  testActorTerminateExtensionIsInstalledAndRemovedForADeepClassEachTime =>
    2
      timesRepeat: [
        self recordingExt: #terminate: key: #extTerminate
        a := Bt4995Leaf spawnWith: #{#tableName => #bt5002Table}
        a stop
        50 timesRepeat: [
          (self.table at: #extTerminate) isNil ifTrue: [Timer sleep: 10]
        ]
        self assert: (self.table at: #extTerminate) equals: #normal
        self.table removeKey: #extTerminate
        self unext: #Actor selector: #terminate:
        b := Bt4995Leaf spawnWith: #{#tableName => #bt5002Table}
        b stop
        50 timesRepeat: [b isAlive ifTrue: [Timer sleep: 10]]
        self assert: (self.table at: #extTerminate) isNil
      ]

  testContinueWithExtensionOnActorIsSeenByAClassThreeLevelsDown =>
    self recordingExt: #continueWith: key: #extContinue
    [
      a := Bt4995Leaf spawnWith: #{#tableName => #bt5002Table}
      [
        self assert: a partialThenContinue equals: #queued
        50 timesRepeat: [
          (self.table at: #extContinue) isNil ifTrue: [Timer sleep: 10]
        ]
        self assert: (self.table at: #extContinue) equals: #stepAfterPartial
        self assert: (self.table at: #stepSaw) isNil
      ] ensure: [a stop]
    ] ensure: [self unext: #Actor selector: #continueWith:]

  testStopWithExtensionOnActorIsSeenByAClassThreeLevelsDown =>
    self recordingExt: #stopWith: key: #extStop
    a := Bt4995Leaf spawnWith: #{#tableName => #bt5002Table}
    [
      a stopAfterPartial
      50 timesRepeat: [
        (self.table at: #extStop) isNil ifTrue: [Timer sleep: 10]
      ]
      self assert: (self.table at: #extStop) equals: #partial
      self assert: a isAlive
    ]
      ensure: [
        self unext: #Actor selector: #stopWith:
        a stop
      ]
