// BT-3755 (ADR 0131 §6), generalized by BT-3866 (ADR 0132 Phase 0a, epic
// BT-3865): the expected answers of the inventory shapes (I1, I2, I3, I4, I6,
// I7, I8) in fixtures/adr0132section6_{class,value,actor}.bt.pending, which
// are §6 compile errors until the ADR 0132 phase beside each shape lands.
// Inert: the runner discovers only `.bt`. A phase that fixes a shape moves
// its fixture method and test into a compiled `.bt` pair.

TestCase subclass: Adr0132Section6PendingTest

  testActorProbeDo =>
    self assert: (Adr0132Section6Actor spawn) probeDo equals: 1

  testActorProbeCond =>
    self assert: (Adr0132Section6Actor spawn) probeCond equals: 1

  testActorProbeOperand =>
    self assert: (Adr0132Section6Actor spawn) probeOperand equals: 1

  testActorProbeNested =>
    self assert: (Adr0132Section6Actor spawn) probeNested equals: 1

  testClassProbeI1 =>
    self assert: Adr0132Section6Class probeI1 equals: 1

  testClassProbeI2 =>
    self assert: Adr0132Section6Class probeI2 equals: 1

  testClassProbeI4 =>
    self assert: Adr0132Section6Class probeI4 equals: 1

  testClassProbeI6 =>
    self assert: Adr0132Section6Class probeI6 equals: 3

  testClassProbeI7 =>
    self assert: Adr0132Section6Class probeI7 equals: 1

  testClassProbeI8 =>
    self assert: Adr0132Section6Class probeI8 equals: 1

  testValueProbeI1 =>
    self assert: Adr0132Section6Value new probeI1 equals: 1

  testValueProbeI1Self =>
    self assert: Adr0132Section6Value new probeI1Self equals: 1

  testValueProbeI2 =>
    self assert: Adr0132Section6Value new probeI2 equals: 1

  testValueProbeI4 =>
    self assert: Adr0132Section6Value new probeI4 equals: 1

  testValueProbeI6 =>
    self assert: Adr0132Section6Value new probeI6 equals: 3

  testValueProbeI8 =>
    self assert: Adr0132Section6Value new probeI8 equals: 1

  testActorProbeOpen =>
    self assert: (Adr0132Section6Actor spawn) probeOpen equals: 1

  testActorProbeStored =>
    self assert: (Adr0132Section6Actor spawn) probeStored equals: 3
