// BT-3745 (ADR 0131 §6): each exempt actor shape in
// fixtures/adr0131section6exemptions_actor.bt really threads its write. If
// codegen stops threading one, this fails and the §6 exemption for it must
// go (crates/beamtalk-core/src/semantic_analysis/validators/local_threading.rs).

TestCase subclass: Adr0131Section6ExemptionsTest

  testSelfSendStatement =>
    self assert: (Adr0131Section6ExemptionsActor spawn) selfSendStatement equals: 1

  testSelfSendAssign =>
    self assert: (Adr0131Section6ExemptionsActor spawn) selfSendAssign equals: #[7, 1]

  testSelfSendReturn =>
    self assert: (Adr0131Section6ExemptionsActor spawn) selfSendReturn equals: 1

  testStoredValue =>
    self assert: (Adr0131Section6ExemptionsActor spawn) storedValue equals: 2

  testStoredValueCascade =>
    self assert: (Adr0131Section6ExemptionsActor spawn) storedValueCascade equals: 3

  // BT-3755: a sealed same-class callee that invokes the block directly.
  testCalleeArg =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeArg equals: 5

  testCalleeAssign =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeAssign equals: 1

  testCalleeReturn =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeReturn equals: 1

  testCalleeTwice =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeTwice equals: 2

  testCalleeCascade =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeCascade equals: 3

  testCalleeLoop =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeLoop equals: 6

  testCalleeOpaque =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeOpaque equals: 6

  testCalleeOpaqueOperand =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeOpaqueOperand equals: 6

  testCalleeOpaqueBranch =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleeOpaqueBranch equals: 6

  testCalleePassOn =>
    self assert: (Adr0131Section6ExemptionsActor spawn) calleePassOn equals: 7
