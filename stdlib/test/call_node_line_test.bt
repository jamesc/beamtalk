// BT-4366: sends whose control-transferring `apply` is nested inside a
// `let`/`case`/`try`/`letrec` (`ifNotNil:`, `ensure:`, `whileTrue:` on
// non-literal blocks) carry the source line on that `apply` node itself, so
// the frame of the method making the send reports its real `.bt` line.
// Each helper keeps its send out of tail position (a tail call leaves no
// frame to report). If a line above a helper shifts, update the expected
// line numbers below to match.

TestCase subclass: CallNodeLineTest

  notNil: x block: blk =>
    x ifNotNil: blk
    nil

  ensure: blk cleanup: cleanup =>
    blk ensure: cleanup
    nil

  loop: cond body: body =>
    cond whileTrue: body
    nil

  frameFor: selector in: trace => trace detect: [:f | f method =:= selector]

  // BT-4836: the failing operation is a BIF, not a send.
  divide: n =>
    x := n / 0
    x + 1

  divideTyped: n :: Integer =>
    x := n / 0
    x + 1

  power: n =>
    x := n ** "a"
    x + 1

  // BT-4851: `++` lowering — `string_to_binary` fails on a non-String operand.
  concatLiteral: n =>
    x := "a" ++ n
    x size

  concatDynamic: a with: n =>
    x := a ++ n
    x size

  // BT-4851: an inline `Erlang ...` call in non-tail position.
  inlineNonTail: n =>
    x := Erlang erlang abs: n
    x + 1

  // Typed arguments let codegen emit the direct `try call 'M':'F'` form
  // (BT-4485) instead of the proxy; `ffi_direct_call.rs` pins that this exact
  // send takes it.
  inlineDirect: s :: String =>
    x := Erlang erlang binary_to_integer: s
    x + 1

  testIfNotNilFrameReportsItsLine =>
    trace := [
      self notNil: 1 block: [:x | x / 0]
    ] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #notNil:block: in: trace
    self assert: frame line equals: 15
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testEnsureFrameReportsItsLine =>
    trace := [
      self ensure: [1 / 0] cleanup: [nil]
    ] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #ensure:cleanup: in: trace
    self assert: frame line equals: 19
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testWhileTrueFrameReportsItsLine =>
    trace := [
      self loop: [true] body: [1 / 0]
    ] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #loop:body: in: trace
    self assert: frame line equals: 23
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testGuardedBifFrameReportsItsLine =>
    trace := [self divide: 1] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #divide: in: trace
    self assert: frame line equals: 30
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testBareBifFrameReportsItsLine =>
    trace := [self divideTyped: 1] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #divideTyped: in: trace
    self assert: frame line equals: 34
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testPowerBifFrameReportsItsLine =>
    trace := [self power: 1] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #power: in: trace
    self assert: frame line equals: 38
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testConcatLiteralFrameReportsItsLine =>
    trace := [self concatLiteral: 1] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #concatLiteral: in: trace
    self assert: frame line equals: 43
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testConcatDynamicFrameReportsItsLine =>
    trace := [
      self concatDynamic: "a" with: 1
    ] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #concatDynamic:with: in: trace
    self assert: frame line equals: 47
    self assert: (frame file endsWith: "call_node_line_test.bt")

  testInlineErlangNonTailFrameReportsItsLine =>
    trace := [self inlineNonTail: "a"] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #inlineNonTail: in: trace
    self assert: frame line equals: 52
    self assert: (frame file endsWith: "call_node_line_test.bt")

  // BT-4851: the BT-4485 direct `try call 'M':'F'` form (typed argument) also
  // reports the send's line. A tail-position `Erlang ...` call is not tested:
  // a tail call leaves no frame for the method, so there is no line to report.
  testInlineErlangDirectFrameReportsItsLine =>
    trace := [self inlineDirect: "a"] on: Exception do: [:e | e stackTrace]
    frame := self frameFor: #inlineDirect: in: trace
    self assert: frame line equals: 59
    self assert: (frame file endsWith: "call_node_line_test.bt")
