// BT-4995: pins, on the code before the dispatch of the Actor intrinsics
// (`continueWith:`, `stopWith:`, the default `terminate:`) changes, where an
// actor's `State` is committed around them, and that an override added at run
// time (an extension on the class, an ancestor or `Actor`, before or after an
// actor started) wins on the next send. They pass before and after the change:
// it is meant to be invisible. The workspace half (a reload that adds a
// `terminate:` override) is tests/repl-protocol/cases/actor_intrinsic_dispatch.btscript.
//
// Fixtures: fixtures/bt4995plain.bt, bt4995recorder.bt, bt4995mid.bt, bt4995leaf.bt.

TestCase subclass: ActorIntrinsicDispatchTest
  field: table = nil
  field: tableName = nil
  field: actor = nil

  setUp =>
    self.tableName := #bt4995Table
    self.table := Ets new: self.tableName type: #set

  tearDown =>
    self.actor isNil ifFalse: [self.actor isAlive ifTrue: [self.actor stop]]
    self.table delete

  spawnPlain: cls =>
    self.actor := cls spawnWith: #{#tableName => self.tableName}
    self.actor

  /// Wait until `key` is in the table (or about half a second passed).
  seen: key =>
    50 timesRepeat: [(self.table at: key) isNil ifTrue: [Timer sleep: 10]]
    self.table at: key

  waitDead: anActor =>
    50 timesRepeat: [anActor isAlive ifTrue: [Timer sleep: 10]]
    self deny: anActor isAlive

  // === continueWith: commit point ===
  testWritesAfterTheRequestAreSeenByTheContinuation =>
    a := self spawnPlain: Bt4995Plain
    self assert: a partialThenContinue equals: #queued
    self assert: (self seen: #stepSaw) equals: 2
    self assert: a n equals: 12

  testStoredBlockWritesSeeTheStateAtTheRequest =>
    a := self spawnPlain: Bt4995Plain
    self assert: a blockAcrossContinue equals: 101
    self assert: a n equals: 101

  testStoredBlockWriteBeforeTheRequestSurvivesIt =>
    a := self spawnPlain: Bt4995Plain
    self assert: a blockWritesThenContinue equals: 7
    self assert: a n equals: 7

  testStoredBlockWritesBetweenTwoRequestsAccumulate =>
    a := self spawnPlain: Bt4995Plain
    self assert: a blockWritesBetweenRequests equals: 2
    self assert: a n equals: 2

  testContinuationChainHandsStateOnStepByStep =>
    a := self spawnPlain: Bt4995Plain
    self assert: a chain equals: #queued
    self assert: (self seen: #chainTwoSaw) equals: 11
    self assert: a n equals: 111

  testContinuationWithArgumentsSeesTheWritesAfterTheRequest =>
    a := self spawnPlain: Bt4995Plain
    self assert: a continueWithArgs equals: #queued
    self assert: (self seen: #argStepSaw) equals: 4
    self assert: a n equals: 16

  testRaisingContinuationCrashesTheActorAndDropsItsWrite =>
    a := self spawnPlain: Bt4995Plain
    self assert: a raisingContinuation equals: #queued
    self assert: (self seen: #failingStepRan) equals: true
    self waitDead: a

  testPendingStopBeatsPendingContinuation =>
    a := self spawnPlain: Bt4995Plain
    a onExit: [:reason | self.table at: #exitReason put: reason]
    self assert: a stopBeatsContinue equals: #queued
    self assert: (self seen: #exitReason) equals: #wins
    self assert: (self.table at: #neverRan) isNil
    self waitDead: a

  // === stopWith: commit point (terminate: sees the final State) ===
  testStopAfterPartialChangesTerminatesWithTheFinalState =>
    a := self spawnPlain: Bt4995Recorder
    self assert: a stopAfterPartial equals: #stillRunning
    self assert: (self seen: #terminateReason) equals: #partial
    self assert: (self.table at: #terminateN) equals: 2
    self waitDead: a

  testStopThenBlockWriteTerminatesWithTheBlocksWrite =>
    a := self spawnPlain: Bt4995Recorder
    self assert: a stopAfterBlockWrite equals: #stillRunning
    self assert: (self seen: #terminateReason) equals: #viaBlock
    self assert: (self.table at: #terminateN) equals: 5
    self waitDead: a

  testFirstStopReasonWins =>
    a := self spawnPlain: Bt4995Recorder
    self assert: a stopTwice equals: #stillRunning
    self assert: (self seen: #terminateReason) equals: #first
    self assert: (self.table at: #terminateN) equals: 2
    self waitDead: a

  testStopThenRaiseStillStopsWithTheRequestedReason =>
    a := self spawnPlain: Bt4995Recorder
    a onExit: [:reason | self.table at: #exitReason put: reason]
    err := [a stopThenRaise] on: Error do: [:e | e]
    self deny: err isNil
    self assert: (self seen: #exitReason) equals: #requested
    self waitDead: a

  testStopNormalTerminatesWithNormalAndTheFinalState =>
    a := self spawnPlain: Bt4995Recorder
    self assert: a stopNormal equals: #stillRunning
    self assert: (self seen: #terminateReason) equals: #normal
    self assert: (self.table at: #terminateN) equals: 41
    self waitDead: a

  // === the default terminate: (no override anywhere) ===
  testDefaultTerminateLetsAnActorStopWithItsReason =>
    a := self spawnPlain: Bt4995Plain
    a onExit: [:reason | self.table at: #exitReason put: reason]
    self assert: a stopAfterPartial equals: #stillRunning
    self assert: (self seen: #exitReason) equals: #partial
    self waitDead: a

  testDefaultTerminateOnPlainStop =>
    a := self spawnPlain: Bt4995Plain
    a onExit: [:reason | self.table at: #exitReason put: reason]
    self assert: a stop equals: #ok
    self assert: (self seen: #exitReason) equals: #normal
    self waitDead: a

  // === overrides added at run time: extensions ===
  //
  // `register:selector:fun:owner:` installs an extension the way `Cls extend`
  // does (ADR 0066). The fun records what it was sent into the table.
  registerExt: className selector: sel key: key =>
    Erlang beamtalk_extensions
      register: className
      selector: sel
      fun: [:args :receiver |
        self.table at: key put: args
        #ok
      ]
      owner: #bt4995

  testTerminateExtensionOnActorAddedBeforeTheActorStarted =>
    self
      registerExt: #Actor
      selector: #terminate:
      key: #extTerminate
    [
      a := self spawnPlain: Bt4995Plain
      a stop
      self assert: (self seen: #extTerminate) equals: #(#normal)
    ] ensure: [Actor removeSelector: #terminate: ifAbsent: [nil]]

  testTerminateExtensionOnActorAddedAfterTheActorStarted =>
    a := self spawnPlain: Bt4995Plain
    a n
    self
      registerExt: #Actor
      selector: #terminate:
      key: #extTerminate
    [
      a stop
      self assert: (self seen: #extTerminate) equals: #(#normal)
    ] ensure: [Actor removeSelector: #terminate: ifAbsent: [nil]]

  testTerminateExtensionRemovedAfterTheActorStartedIsNoLongerCalled =>
    self
      registerExt: #Actor
      selector: #terminate:
      key: #extTerminate
    a := self spawnPlain: Bt4995Plain
    a n
    Actor removeSelector: #terminate: ifAbsent: [nil]
    a stop
    self waitDead: a
    self assert: (self.table at: #extTerminate) isNil

  testTerminateExtensionOnTheSuperclassBeatsTheActorDefault =>
    self
      registerExt: #Bt4995Plain
      selector: #terminate:
      key: #extTerminate
    [
      a := self spawnPlain: Bt4995Mid
      a stop
      self assert: (self seen: #extTerminate) equals: #(#normal)
    ] ensure: [Bt4995Plain removeSelector: #terminate: ifAbsent: [nil]]

  testTerminateExtensionOnTheAncestorTwoLevelsUpWins =>
    self
      registerExt: #Bt4995Plain
      selector: #terminate:
      key: #extTerminate
    [
      a := self spawnPlain: Bt4995Leaf
      a n
      a stop
      self assert: (self seen: #extTerminate) equals: #(#normal)
    ] ensure: [Bt4995Plain removeSelector: #terminate: ifAbsent: [nil]]

  testTerminateExtensionOnTheClassItselfWins =>
    self
      registerExt: #Bt4995Leaf
      selector: #terminate:
      key: #extTerminate
    [
      a := self spawnPlain: Bt4995Leaf
      a stop
      self assert: (self seen: #extTerminate) equals: #(#normal)
    ] ensure: [Bt4995Leaf removeSelector: #terminate: ifAbsent: [nil]]

  testClassOverrideBeatsAnActorTerminateExtension =>
    self
      registerExt: #Actor
      selector: #terminate:
      key: #extTerminate
    [
      a := self spawnPlain: Bt4995Recorder
      a stop
      self assert: (self seen: #terminateReason) equals: #normal
      self waitDead: a
      self assert: (self.table at: #extTerminate) isNil
    ] ensure: [Actor removeSelector: #terminate: ifAbsent: [nil]]

  testContinueWithExtensionAddedAfterTheActorStartedIsSeenOnTheNextSend =>
    a := self spawnPlain: Bt4995Plain
    self assert: a partialThenContinue equals: #queued
    self assert: (self seen: #stepSaw) equals: 2
    self.table removeKey: #stepSaw
    self
      registerExt: #Actor
      selector: #continueWith:
      key: #extContinue
    [
      self assert: a partialThenContinue equals: #queued
      self assert: (self seen: #extContinue) equals: #(#stepAfterPartial)
      self assert: (self.table at: #stepSaw) isNil
    ] ensure: [Actor removeSelector: #continueWith: ifAbsent: [nil]]

  testContinueWithExtensionOnAnAncestorWins =>
    self
      registerExt: #Bt4995Plain
      selector: #continueWith:
      key: #extContinue
    [
      a := self spawnPlain: Bt4995Leaf
      self assert: a partialThenContinue equals: #queued
      self assert: (self seen: #extContinue) equals: #(#stepAfterPartial)
    ] ensure: [Bt4995Plain removeSelector: #continueWith: ifAbsent: [nil]]

  testContinueWithExtensionRemovedRestoresTheIntrinsic =>
    a := self spawnPlain: Bt4995Plain
    self
      registerExt: #Actor
      selector: #continueWith:
      key: #extContinue
    Actor removeSelector: #continueWith: ifAbsent: [nil]
    self assert: a partialThenContinue equals: #queued
    self assert: (self seen: #stepSaw) equals: 2
    self assert: (self.table at: #extContinue) isNil

  // Pinned as observed before BT-4995: an extension on `Actor` itself does not
  // intercept a self-sent `stopWith:` (the actor stops with the requested
  // reason); one on an ancestor below `Actor` does (next test).
  testStopWithExtensionOnActorDoesNotInterceptASelfSend =>
    a := self spawnPlain: Bt4995Recorder
    a n
    self
      registerExt: #Actor
      selector: #stopWith:
      key: #extStop
    [
      self assert: a stopAfterPartial equals: #stillRunning
      self assert: (self seen: #terminateReason) equals: #partial
      self assert: (self.table at: #extStop) isNil
    ] ensure: [Actor removeSelector: #stopWith: ifAbsent: [nil]]

  testStopWithExtensionOnAnAncestorWins =>
    self
      registerExt: #Bt4995Plain
      selector: #stopWith:
      key: #extStop
    [
      a := self spawnPlain: Bt4995Leaf
      self assert: a stopAfterPartial equals: #stillRunning
      self assert: (self seen: #extStop) equals: #(#partial)
      self assert: a isAlive
    ] ensure: [Bt4995Plain removeSelector: #stopWith: ifAbsent: [nil]]

  testStopWithExtensionRemovedRestoresTheIntrinsic =>
    a := self spawnPlain: Bt4995Recorder
    self
      registerExt: #Actor
      selector: #stopWith:
      key: #extStop
    Actor removeSelector: #stopWith: ifAbsent: [nil]
    self assert: a stopAfterPartial equals: #stillRunning
    self assert: (self seen: #terminateReason) equals: #partial
    self assert: (self.table at: #extStop) isNil

  // Pinned as observed before BT-4995: an extension on `Actor` itself is not
  // seen from a class three levels below it (`Actor`'s own compiled method
  // wins); it is seen from a direct subclass (tests above).
  testTerminateExtensionOnActorIsIgnoredByADeepSubclass =>
    self
      registerExt: #Actor
      selector: #terminate:
      key: #extTerminate
    [
      a := self spawnPlain: Bt4995Leaf
      a stop
      self waitDead: a
      self.table at: #deepTerminateSeen put: (self.table at: #extTerminate) isNil not
    ] ensure: [Actor removeSelector: #terminate: ifAbsent: [nil]]
    self assert: (self.table at: #deepTerminateSeen) equals: false

  testContinueWithExtensionOnActorIsIgnoredByADeepSubclass =>
    self
      registerExt: #Actor
      selector: #continueWith:
      key: #extContinue
    [
      a := self spawnPlain: Bt4995Leaf
      a partialThenContinue
      self.table at: #deepContinueSeen put: (self seen: #extContinue) isNil not
    ] ensure: [Actor removeSelector: #continueWith: ifAbsent: [nil]]
    self assert: (self.table at: #deepContinueSeen) equals: false

  testStopWithExtensionOnActorIsIgnoredByADeepSubclass =>
    self
      registerExt: #Actor
      selector: #stopWith:
      key: #extStop
    [
      a := self spawnPlain: Bt4995Leaf
      a stopAfterPartial
      Timer sleep: 200
      self.table at: #deepStopSeen put: (self.table at: #extStop) isNil not
    ] ensure: [Actor removeSelector: #stopWith: ifAbsent: [nil]]
    self assert: (self.table at: #deepStopSeen) equals: false

  // === the other Actor intrinsics keep their path ===
  testOnExitSeesTheStopReason =>
    a := self spawnPlain: Bt4995Plain
    a onExit: [:reason | self.table at: #exitReason put: reason]
    a stopAfterPartial
    self assert: (self seen: #exitReason) equals: #partial

  testMonitorFromAnotherProcessSeesTheStop =>
    a := self spawnPlain: Bt4995Plain
    ref := a monitor
    self deny: ref isNil
    a stop
    self waitDead: a

  testPidAndIsAliveAreUnchanged =>
    a := self spawnPlain: Bt4995Plain
    self deny: a pid isNil
    self assert: a isAlive
    a stop
    self waitDead: a
