// BT-3055: `^` inside a `to:do:` counted loop in a class method used to fail
// to compile with `{core_lint, {unbound_var, 'State', ...}}` — the counted
// loop's StateAcc pack/unpack helpers hardcoded `State` as their base without
// checking whether the enclosing method was a class method (which has no
// `State` parameter). See fixtures/bt3055actor.bt for the two distinct
// codegen paths this covers.

TestCase subclass: BT3055ClassMethodCountedLoopTest

  testCountedLoopWithEarlyReturnInClassMethodCompilesAndRuns =>
    self assert: BT3055Actor runWithSelfSend equals: #FromAncestor

  testCountedLoopWithNoStateEffectsInClassMethodCompilesAndRuns =>
    self assert: BT3055Actor runPlainSum equals: 15
