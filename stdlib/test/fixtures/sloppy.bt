// BT-5214 fixture: a value type whose `>` and `<` answer a non-Boolean
// (`nil`), so `max` / `min` must raise what `Number>>max:` raises.

Value subclass: Sloppy

  /// Answers `nil`, not a Boolean.
  > _other => nil

  /// Answers `nil`, not a Boolean.
  < _other => nil
