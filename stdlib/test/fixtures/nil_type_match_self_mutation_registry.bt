// BT-2880: Actor fixture reproducing the bug report's repro — a match:
// arm whose body is a multi-statement `[...] value` block that mutates
// `self.<state>` must thread actor state correctly and return the block's
// real last-statement value, not an internal state-threading Tuple. Mixes
// a native `nil ->` arm (the mutating one) with a `Pattern::Type` arm
// (`x :: Integer -> x`), matching the repro and exercising the
// chain-of-nested-cases codegen path (generate_match_chain).
//
// Unlike the bug report's own repro, `count` has a default value here
// rather than being a bare `state: count :: Integer` (no default) — a
// non-`typed` Actor with a no-default typed field plus an explicit
// `initialize` hits an unrelated, pre-existing gap where `handle_continue`
// never dispatches to `initialize` at all (also silently bypassing the
// uninitialized-state safety check), unrelated to this match: bug.
//
// `bumpMatchIfTrue:` covers the same bug in a second shape: an arm body
// that is itself a nested `ifTrue:`/`ifFalse:` mutation, with no `[...]
// value` wrapper at all.
//
// `bumpEitherOf:` covers a third shape (review follow-up): TWO different
// arms each mutate a DIFFERENT field via a `[...] value` block. Since only
// one arm fires per call, each must start from the same pre-match state —
// this pins that compiling arm 2 doesn't see any state leaked from
// compiling arm 1 (they're alternatives, not a sequence). Uses Integer
// literal patterns (1/2), not bare `true`/`false` — those are rejected at
// compile time with a diagnostic (BT-2883) rather than parsing as a
// boolean-literal test; use `x :: True`/`x :: False`/`x :: Boolean`
// instead (ADR 0107 Phase A).

Actor subclass: NilTypeMatchSelfMutationRegistry
  state: count :: Integer = 0
  state: otherCount :: Integer = 0

  initialize =>
    self.count := 0
    self.otherCount := 0
    nil

  bumpMatch -> Integer =>
    nil match: [
      nil -> [
        self.count := self.count + 1
        self.count
      ] value;
      x :: Integer -> x
    ]

  bumpMatchIfTrue: flag -> Integer =>
    nil match: [
      nil -> flag ifTrue: [
        self.count := self.count + 1
      ] ifFalse: [self.count := self.count - 1];
      x :: Integer -> x
    ]

  bumpEitherOf: choice -> Integer =>
    choice match: [
      1 -> [
        self.count := self.count + 1
        self.count
      ] value;
      2 -> [
        self.otherCount := self.otherCount + 1
        self.otherCount
      ] value
    ]

  // BT-3489: the *bare* shape — a match: arm body that is a plain
  // `self.field := ...` write, with no `[...] value` wrapper and no nested
  // `ifTrue:` around it. Before BT-3489 nothing classified this as needing
  // state threading, so each arm's `State{N}` binding stayed scoped to its
  // own `case` clause while the post-match read referenced it anyway —
  // `erlc: unbound variable 'State1' in dispatch/4`, despite an (also
  // wrong) "has no effect" warning promising a silent no-op.
  bumpBare: v -> Integer =>
    v match: [
      1 -> self.count := self.count + 10;
      _ -> self.count := self.count + 1
    ]
    self.count

  // BT-3489: two arms writing DIFFERENT fields, bare. Same alternatives-not-a-
  // sequence invariant `bumpEitherOf:` pins for the `[...] value` shape.
  bumpBareEitherOf: choice -> Integer =>
    choice match: [
      1 -> self.count := self.count + 1;
      _ -> self.otherCount := self.otherCount + 1
    ]
    self.count + self.otherCount

  // BT-3489: the match: value itself is used after a bare field-writing arm —
  // the arm's assigned value must be the match's value, and the mutated
  // state must still be visible to the read that follows.
  bumpBareUsingResult: v -> Integer =>
    r := v match: [
      1 -> self.count := self.count + 10;
      _ -> self.count := self.count + 1
    ]
    r + self.count

  // BT-3489: the same bare shape through the OTHER lowering path — a
  // `Pattern::Type` arm (`x :: Integer`) forces `generate_match_chain`'s
  // chain-of-nested-`case`s instead of the all-native single-`case` fast
  // path the `bumpBare*` methods above take. Both must thread a bare arm
  // field write identically.
  bumpBareTyped: v -> Integer =>
    v match: [
      x :: Integer -> self.count := self.count + x;
      _ -> self.count := self.count + 1
    ]
    self.count

  // BT-3489: a bare field-writing arm inside a LOOP body — the match's own
  // arm threading has to compose with the loop's `StateAcc` threading, one
  // write per iteration. A wrong `base_state` here would not crash; it would
  // silently accumulate the wrong total, so the ground truth below is the
  // only thing that pins it.
  bumpBareInLoop: n -> Integer =>
    1
      to: n
      do: [:i |
        i match: [
          1 -> self.count := self.count + 10;
          _ -> self.count := self.count + 1
        ]
      ]
    self.count

  // BT-3489: a bare field-writing arm inside a NESTED match: arm. The outer
  // match sees its arm body is itself a threading match: (the mutual
  // recursion between `control_flow_has_mutations` and
  // `match_needs_mutation_threading`), so both levels must root at the same
  // pre-match state.
  bumpBareNested: v -> Integer =>
    v match: [
      1 -> v match: [
        1 -> self.count := self.count + 5;
        _ -> 0
      ];
      _ -> 0
    ]
    self.count

  // ── BT-3493: a `self.field := ...` write wrapped in a local assignment
  // (`r := (self.x := ...)`) — unlike the BT-3489 fixtures above, none of
  // these has a `match:` anywhere; the bug reproduces identically in a
  // plain `ifTrue:`/`ifTrue:ifFalse:` branch body and a counted loop body,
  // since all three share the ADR 0111 Addendum 5 statement classifier.
  // `bumpWrappedMatch:` below covers the third construct (a `match:` arm's
  // `[...] value` block body).

  // The `ifTrue:` arm captures the field write's own assigned value in `r`,
  // then writes it again (offset by 1) to prove `r` really does hold the
  // freshly-written value, not a stale or dropped one.
  bumpWrappedIfTrue: flag -> Integer =>
    flag
      ifTrue: [
        r := (self.count := self.count + 10)
        self.count := r + 1
      ]
      ifFalse: [self.count := self.count - 1]
    self.count

  // Each iteration writes `self.count` via the wrapped shape, then reads
  // the local `r` it was just bound to back into the field — a wrong base
  // state here would accumulate the wrong total silently, not crash.
  bumpWrappedInLoop: n -> Integer =>
    1
      to: n
      do: [:i |
        r := (self.count := self.count + i)
        self.count := r
      ]
    self.count

  bumpWrappedMatch: v -> Integer =>
    v match: [
      1 -> [
        r := (self.count := self.count + 10)
        r
      ] value;
      _ -> [
        r := (self.count := self.count + 1)
        r
      ] value
    ]

  // `r` is bound INSIDE the `ifTrue:` branch, then read by a NESTED loop in
  // the SAME branch — every other local assignment this branch-arm lowering
  // handles threads its local through StateAcc precisely so a later nested
  // construct in the same frame can `maps:get` it back; this pins that the
  // wrapped-field-write shape's local gets that same visibility, not just a
  // same-frame lexical binding that a nested closure wouldn't see.
  bumpWrappedIfTrueNestedLoopReadsCapturedLocal: flag -> Integer =>
    flag
      ifTrue: [
        r := (self.count := self.count + 10)
        1 to: 2 do: [:i | self.count := self.count + r]
      ]
    self.count

  // A loop-local accumulator (`sum`) declared OUTSIDE the loop and mutated
  // INSIDE it, alongside the wrapped field write — `sum` being a genuine
  // cross-iteration "threaded local" is what can route this loop through
  // hybrid-params mode (direct field params, ADR 0111 Addendum 15) instead
  // of the plain `StateAcc` fallback `bumpWrappedInLoop:` above exercises,
  // reaching a DIFFERENT lowering function
  // (`lower_direct_var_update_in_loop_bind`) for the wrapped assignment.
  bumpWrappedInHybridLoop: n -> Integer =>
    sum := 0
    1
      to: n
      do: [:i |
        r := (self.count := self.count + i)
        sum := sum + r
      ]
    sum

  // The `Foldl*` list-op family (`do:`/`collect:`/etc.) shares
  // `try_generate_block_local_plain_let`/`lower_direct_var_update_in_loop_bind`/
  // `lower_local_var_assignment_bind` with the `Letrec` family above
  // (`bumpWrappedInLoop:`) — a field write present anywhere in the body
  // (including wrapped) disqualifies `use_tuple_acc`, forcing the same
  // `StateAcc` fallback this pins here for `do:` specifically.
  bumpWrappedInDo: items -> Integer =>
    items
      do: [:x |
        r := (self.count := self.count + x)
        self.count := r
      ]
    self.count

  currentCount => self.count

  currentOtherCount => self.otherCount
