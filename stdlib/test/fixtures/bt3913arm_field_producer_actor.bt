// BT-3913: `self.n := <loop or fold>` as a statement of a conditional arm in an
// actor method. The arm threads the right-hand side ahead, then puts the
// unwrapped value into the field, so both the field and the outer local the
// loop wrote hold the loop's results afterwards. Asserted in
// bt3913arm_field_producer_test.bt.

Actor subclass: Bt3913ArmFieldProducerActor
  state: n = 0

  // A `do:` loop answers `nil`.
  viaDo: c =>
    t := 0
    c ifTrue: [self.n := #(1, 2) do: [:e | t := t + e]]
    #[t, self.n]

  // A fold answers its accumulator.
  viaInject: c =>
    t := 0
    c
      ifTrue: [
        self.n := #(1, 2)
          inject: 0
          into: [:a :e |
            t := t + e
            a + e
          ]
      ]
    #[t, self.n]

  // A collection operation answers a new collection.
  viaCollect: c =>
    t := 0
    c
      ifTrue: [
        self.n := #(1, 2)
          collect: [:e |
            t := t + e
            e * 2
          ]
      ]
    #[t, self.n]

  // An evaluated block answers its last expression.
  viaValue: c =>
    t := 0
    c
      ifTrue: [
        self.n := [
          t := t + 1
          5
        ] value
      ]
    #[t, self.n]

  // An `on:do:` that does not raise answers the protected block's value.
  viaOnDo: c =>
    t := 0
    c
      ifTrue: [
        self.n := [
          t := t + 1
          5
        ] on: Error do: [:e | 0]
      ]
    #[t, self.n]

  // An inline conditional answers the taken branch.
  viaIf: c =>
    t := 0
    c
      ifTrue: [
        self.n := c
          ifTrue: [
            t := t + 1
            7
          ]
          ifFalse: [8]
      ]
    #[t, self.n]
