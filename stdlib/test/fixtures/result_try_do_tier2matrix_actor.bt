// BT-3750 (ADR 0131 Phase 4): generated matrix, loop frame x catch-boundary
// construct, in one method context; the expected counts are in
// stdlib/test/result_try_do_tier2matrix_test.bt.

Actor subclass: ResultTryDoTier2MatrixActor
  state: n = 0

  doTryLookup =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            #{#a => 1}
              at: #k
              ifAbsent: [
                t := t + 1
                0
              ]
            7
          ]
      ]
    t

  doTryDirect =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            t := t + 1
            7
          ]
      ]
    t

  doTryNested =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            Result
              tryDo: [
                t := t + 1
                1
              ]
            7
          ]
      ]
    t

  doTryHeadRead =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            t := t + 1
            #{#a => 1}
              at: #k
              ifAbsent: [
                t := t + 1
                0
              ]
            7
          ]
      ]
    t

  doOnDoHeadRead =>
    t := 0
    #(1, 2)
      do: [:k |
        [
          t := t + 1
          #{#a => 1}
            at: #k
            ifAbsent: [
              t := t + 1
              0
            ]
        ] on: Error do: [:e | 0]
      ]
    t

  doTryPureWrite =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            #{#a => 1} at: #k ifAbsent: [t := 1]
            2
          ]
      ]
    t

  doOnDoPureWrite =>
    t := 0
    #(1, 2)
      do: [:k |
        [
          (t < 100) ifTrue: [t := 1]
          1
        ] on: Error do: [:e | 0]
      ]
    t

  doTryHeadWrite =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            t := 5
            2
          ]
      ]
    t

  doTryRaise =>
    t := 0
    #(1, 2)
      do: [:k |
        Result
          tryDo: [
            t := t + 1
            Error signal: "boom"
          ]
      ]
    t

  doOnDoLookup =>
    t := 0
    #(1, 2)
      do: [:k |
        [
          #{#a => 1}
            at: #k
            ifAbsent: [
              t := t + 1
              0
            ]
        ] on: Error do: [:e | 0]
      ]
    t

  doEnsureLookup =>
    t := 0
    #(1, 2)
      do: [:k |
        [
          #{#a => 1}
            at: #k
            ifAbsent: [
              t := t + 1
              0
            ]
        ] ensure: [nil]
      ]
    t

  doOnDoTry =>
    t := 0
    #(1, 2)
      do: [:k |
        [
          Result
            tryDo: [
              t := t + 1
              1
            ]
        ] on: Error do: [:e | 0]
      ]
    t

  todoTryLookup =>
