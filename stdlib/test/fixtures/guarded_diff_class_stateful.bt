// BT-4298 (ADR 0142 §1, rule 2): a class with class variables. Its class
// methods touch its own variables, so they always run in its class process.
// GuardedDiffClassForgot inherits them without redeclaring the variable.

Object subclass: GuardedDiffClassStateful
  classState: hits :: Integer = 0

  class peek -> Integer => self.hits

  class bump -> Integer =>
    self.hits := self.hits + 1
    self.hits

  // BT-4317: an explicit own-class send reads this class's variable, also
  // when the method runs for a subclass; `peekOf:` is the same send with the
  // class held in a variable.
  class ownLiteralPeek -> Integer => GuardedDiffClassStateful peek

  class peekOf: cls -> Integer => cls peek
