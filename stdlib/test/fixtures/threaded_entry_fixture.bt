// BT-3871 (ADR 0132 Phase 1c): class methods with a threading block parameter.
// Each of these compiles to one body over `Acc` (`'__t2_class_<sel>'`) with the
// plain `'class_<sel>'` as a wrapper over it; nothing calls a threaded entry
// from Beamtalk yet (ADR 0132 Phase 1e), so the BUnit test
// (adr0132_threaded_class_entry_test.bt) pins that the PLAIN entry answers
// exactly what the structural fallback did, with pure blocks. The threaded
// entries are exercised directly from Erlang by
// runtime/apps/beamtalk_runtime/test/beamtalk_threaded_class_entries_tests.erl.

sealed Object subclass: ThreadedEntryFixture

  // A direct invocation, twice.
  class sealed twice: b =>
    b value
    b value

  // The callable argument of a collection message (ADR 0128's opaque fold).
  class sealed each: items do: b => items do: b

  // A same-class pass-on: calls `twice:`'s threaded entry with the current Acc.
  class sealed twiceVia: b => self twice: b

  class sealed apply: b to: x => b value: x

  class sealed sumOver: items with: b => items inject: 0 into: b

  class sealed detectIn: items with: b => items detect: b ifNone: [0]

  // A `^` from a block beside an invocation: the NLR carries Acc.
  class sealed callThen: b firstPositiveIn: items =>
    b value
    items do: [:x | x > 0 ifTrue: [^x]]
    nil

  // The body's own local stays out of Acc.
  class sealed withLocals: b =>
    total := 0
    #(1, 2, 3) do: [:i | total := total + i]
    b value: total

  // The issue's own NLR example. `b value: x` sits inside a nested block
  // literal, which is ADR 0132 Phase 3 (the predicate counts it as non-threading
  // in this Epic), so this method has NO threaded entry and compiles as before.
  class sealed detectFirst: b over: items =>
    items do: [:x | (b value: x) ifTrue: [^x]]
    nil

  // `valueWithArguments:` through the threaded entry, and the same expression
  // in a method whose block parameter is also stored (so it has no entry),
  // compiled as before ADR 0132: the control the threaded one must match.
  class sealed spread: b with: xs => b valueWithArguments: xs

  class sealed spreadUnthreaded: b with: xs =>
    #(1) collect: [:i | b]
    b valueWithArguments: xs

  // No block parameter: compiled exactly as before.
  class sealed plain: n => n + 1

  // The block is stored in a collection: not a threading parameter.
  class sealed storeAway: b => #(1, 2) collect: [:x | b]
