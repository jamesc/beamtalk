// BT-3981: an evaluated block literal that binds a local, writes a field or
// sends to `self`, in the host/position cells that answer the value.
// The actor cells are the shapes that answer the value; the rest are compile errors
// (BT-3981, see the generated corpus in semantic_analysis/tests/local_threading.rs).

Actor subclass: Bt3981EvalblockActor
  state: hits = 0

  sealed ap: b => b value

  peek: v => v

  methodAssignedSimple =>
    r := [
      n := 3
      n
    ] value
    r

  methodAssignedLoop =>
    r := [
      n := 0
      #(1, 2) do: [:y | n := n + y]
      n
    ] value
    r

  methodAssignedSeq =>
    r := [
      n := 1
      n := n + 2
      n
    ] value
    r

  methodAssignedSend =>
    r := [self peek: 3] value
    r

  methodLastSimple =>
    [
      n := 3
      n
    ] value

  methodLastLoop =>
    [
      n := 0
      #(1, 2) do: [:y | n := n + y]
      n
    ] value

  methodLastSeq =>
    [
      n := 1
      n := n + 2
      n
    ] value

  methodLastSend => [self peek: 3] value

  methodNestedSimple =>
    [
      [
        n := 3
        n
      ] value
    ] value

  methodNestedLoop =>
    [
      [
        n := 0
        #(1, 2) do: [:y | n := n + y]
        n
      ] value
    ] value

  methodNestedSeq =>
    [
      [
        n := 1
        n := n + 2
        n
      ] value
    ] value

  methodNestedSend => [[self peek: 3] value] value

  methodReturnSimple =>
    ^[
      n := 3
      n
    ] value

  methodReturnLoop =>
    ^[
      n := 0
      #(1, 2) do: [:y | n := n + y]
      n
    ] value

  methodReturnSeq =>
    ^[
      n := 1
      n := n + 2
      n
    ] value

  methodReturnSend => ^[self peek: 3] value

  armAssignedSimple =>
    flag := true
    flag
      ifTrue: [
        r := [
          n := 3
          n
        ] value
        r
      ]
      ifFalse: [0]

  armAssignedLoop =>
    flag := true
    flag
      ifTrue: [
        r := [
          n := 0
          #(1, 2) do: [:y | n := n + y]
          n
        ] value
        r
      ]
      ifFalse: [0]

  armAssignedSeq =>
    flag := true
    flag
      ifTrue: [
        r := [
          n := 1
          n := n + 2
          n
        ] value
        r
      ]
      ifFalse: [0]

  armAssignedSend =>
    flag := true
    flag
      ifTrue: [
        r := [self peek: 3] value
        r
      ]
      ifFalse: [0]

  armLastSimple =>
    flag := true
    flag
      ifTrue: [
        [
          n := 3
          n
        ] value
      ]
      ifFalse: [0]

  armLastLoop =>
    flag := true
    flag
      ifTrue: [
        [
          n := 0
          #(1, 2) do: [:y | n := n + y]
          n
        ] value
      ]
      ifFalse: [0]

  armLastSeq =>
    flag := true
    flag
      ifTrue: [
        [
          n := 1
          n := n + 2
          n
        ] value
      ]
      ifFalse: [0]

  armLastSend =>
    flag := true
    flag ifTrue: [[self peek: 3] value] ifFalse: [0]

  armNestedSimple =>
    flag := true
    flag
      ifTrue: [
        [
          [
            n := 3
            n
          ] value
        ] value
      ]
      ifFalse: [0]

  armNestedLoop =>
    flag := true
    flag
      ifTrue: [
        [
          [
            n := 0
            #(1, 2) do: [:y | n := n + y]
            n
          ] value
        ] value
      ]
      ifFalse: [0]

  armNestedSeq =>
    flag := true
    flag
      ifTrue: [
        [
          [
            n := 1
            n := n + 2
            n
          ] value
        ] value
      ]
      ifFalse: [0]

  armNestedSend =>
    flag := true
    flag ifTrue: [[[self peek: 3] value] value] ifFalse: [0]

  collectAssignedSimple =>
    #(1)
      collect: [:z |
        r := [
          n := 3
          n
        ] value
        r
      ]

  collectAssignedLoop =>
    #(1)
      collect: [:z |
        r := [
          n := 0
          #(1, 2) do: [:y | n := n + y]
          n
        ] value
        r
      ]

  collectAssignedSeq =>
    #(1)
      collect: [:z |
        r := [
          n := 1
          n := n + 2
          n
        ] value
        r
      ]

  collectAssignedSend =>
    #(1)
      collect: [:z |
        r := [self peek: 3] value
        r
      ]

  collectLastSimple =>
    #(1)
      collect: [:z |
        [
          n := 3
          n
        ] value
      ]

  collectLastLoop =>
    #(1)
      collect: [:z |
        [
          n := 0
          #(1, 2) do: [:y | n := n + y]
          n
        ] value
      ]

  collectLastSeq =>
    #(1)
      collect: [:z |
        [
          n := 1
          n := n + 2
          n
        ] value
      ]

  collectLastSend => #(1) collect: [:z | [self peek: 3] value]

  collectNestedSimple =>
    #(1)
      collect: [:z |
        [
          [
            n := 3
            n
          ] value
        ] value
      ]

  collectNestedLoop =>
    #(1)
      collect: [:z |
        [
          [
            n := 0
            #(1, 2) do: [:y | n := n + y]
            n
          ] value
        ] value
      ]

  collectNestedSeq =>
    #(1)
      collect: [:z |
        [
          [
            n := 1
            n := n + 2
            n
          ] value
        ] value
      ]

  collectNestedSend => #(1) collect: [:z | [[self peek: 3] value] value]

  protectedAssignedSimple =>
    [
      r := [
        n := 3
        n
      ] value
      r
    ] on: Error do: [:e | 0]

  protectedAssignedLoop =>
    [
      r := [
        n := 0
        #(1, 2) do: [:y | n := n + y]
        n
      ] value
      r
    ] on: Error do: [:e | 0]

  protectedAssignedSeq =>
    [
      r := [
        n := 1
        n := n + 2
        n
      ] value
      r
    ] on: Error do: [:e | 0]

  protectedAssignedSend =>
    [
      r := [self peek: 3] value
      r
    ] on: Error do: [:e | 0]

  matchArmSimple =>
    3 match: [
      3 -> [
        n := 3
        n
      ] value;
      _ -> 0
    ]

  matchArmAssigned =>
    r := 3 match: [
      3 -> [
        n := 3
        n
      ] value;
      _ -> 0
    ]
    r

  matchArmSend =>
    3 match: [
      3 -> [self peek: 3] value;
      _ -> 0
    ]

  // A `do:` body that writes an outer local is a fold carrying it: the
  // evaluated block answers only as the value of the write to that one local,
  // or inside an arm of the body. As a statement it is a compile error.
  foldAssignsOuter =>
    r := 0
    #(1)
      do: [:z |
        r := [
          n := 3
          n
        ] value
      ]
    r

  foldArmAssignsOuter =>
    r := 0
    flag := true
    #(1)
      do: [:z |
        flag
          ifTrue: [
            r := [
              n := 3
              n
            ] value
          ]
          ifFalse: [0]
      ]
    r

  foldWritesThenArm =>
    r := 0
    flag := true
    #(1)
      do: [:z |
        r := 3
        flag
          ifTrue: [
            [
              n := 4
              n
            ] value
          ]
          ifFalse: [0]
      ]
    r

  collectAssignsOuter =>
    r := 0
    #(1)
      collect: [:z |
        r := [
          n := 3
          n
        ] value
      ]
    r

  injectAssignsOuter =>
    r := 0
    #(1)
      inject: 0
      into: [:a :z |
        r := [
          n := 3
          n
        ] value
      ]
    r

  selectAssignsOuter =>
    r := 0
    #(1)
      select: [:z |
        r := [
          n := 3
          n
        ] value
        true
      ]
    r

  detectAssignsOuter =>
    r := 0
    #(1)
      detect: [:z |
        r := [
          n := 3
          n
        ] value
        true
      ]
      ifNone: [0]
    r

  countedAssignsOuter =>
    r := 0
    1
      to: 1
      do: [:z |
        r := [
          n := 3
          n
        ] value
      ]
    r

  timesAssignsOuter =>
    r := 0
    1
      timesRepeat: [
        r := [
          n := 3
          n
        ] value
      ]
    r

  collectArmE =>
    r := 0
    flag := true
    #(1)
      collect: [:z |
        r := 3
        flag
          ifTrue: [
            [
              n := 4
              n
            ] value
          ]
          ifFalse: [0]
      ]
    r

  injectArmAssign =>
    r := 0
    flag := true
    #(1)
      inject: 0
      into: [:a :z |
        flag
          ifTrue: [
            r := [
              n := 3
              n
            ] value
          ]
          ifFalse: [0]
      ]
    r
