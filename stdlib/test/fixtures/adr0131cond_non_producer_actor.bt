// BT-3738 (ADR 0131 Phase 3): actor conditionals that are NOT local-threading
// producers (their arms write a field or send to `self`, and write no outer
// local) but hold a loop or fold that writes a local of the arm. Codegen
// registers an arm frame only for a conditional producer, the same predicate
// the Phase 0 check reads, so these keep the legacy arm lowering. The expected
// answers are in stdlib/test/adr0131cond_non_producer_test.bt.

Actor subclass: Adr0131CondNonProducerActor
  state: n = 0

  bump => self.n := self.n + 1

  doInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        #(1, 2) do: [:e | m := m + e]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  toDoInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        1 to: 2 do: [:i | m := m + i]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  injectInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        s := #(1, 2)
          inject: 0
          into: [:a :e |
            m := m + e
            a + e
          ]
        m + s
      ]
      ifFalse: [0]
    #[r, self.n]

  whileInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        [m < 2] whileTrue: [m := m + 1]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  collectInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        sq := #(1, 2) collect: [:e | m := m + e]
        sq size + m
      ]
      ifFalse: [0]
    #[r, self.n]

  selfSendInArm: c =>
    r := c
      ifTrue: [
        self bump
        m := 0
        #(1, 2) do: [:e | m := m + e]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  nestedInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        c
          ifTrue: [
            self.n := 2
            m := 0
            #(1, 2) do: [:e | m := m + e]
            m
          ]
          ifFalse: [9]
      ]
      ifFalse: [0]
    #[r, self.n]

  nilInArm: x =>
    r := x
      ifNil: [
        self.n := 1
        m := 0
        #(1, 2) do: [:e | m := m + e]
        m
      ]
      ifNotNil: [:v | v]
    #[r, self.n]
