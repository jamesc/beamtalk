// BT-3738 (ADR 0131 Phase 3): actor conditionals that are NOT local-threading
// producers (their arms write a field or send to `self`, and write no outer
// local) but hold a loop or fold that writes a local of the arm. BT-3913
// retired the legacy arm lowering these relied on: the writing loop answers
// right as a statement of its own, but as the value of an assignment in the
// arm it keeps the `UnmigratedLocalThreading` error (pinned in
// `local_threading.rs`), so `injectInArm` and `collectInArm` hoist the
// arm-local write to a `do:` of its own and capture the pure fold value.
// The expected answers are in
// stdlib/test/adr0131cond_non_producer_test.bt.

Actor subclass: Adr0131CondNonProducerActor
  state: n = 0

  bump => self.n := self.n + 1

  doInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        #(1, 2) do: [:e | m := m + e]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  toDoInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        1 to: 2 do: [:i | m := m + i]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  injectInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        #(1, 2) do: [:e | m := m + e]
        s := #(1, 2) inject: 0 into: [:a :e | a + e]
        m + s
      ]
      ifFalse: [0]
    #[r, self.n]

  whileInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        [m < 2] whileTrue: [m := m + 1]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  collectInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        m := 0
        #(1, 2) do: [:e | m := m + e]
        sq := #(1, 2) collect: [:e | e * 2]
        sq size + m
      ]
      ifFalse: [0]
    #[r, self.n]

  selfSendInArm: c =>
    r := c
      ifTrue: [
        self bump
        m := 0
        #(1, 2) do: [:e | m := m + e]
        m
      ]
      ifFalse: [0]
    #[r, self.n]

  nestedInArm: c =>
    r := c
      ifTrue: [
        self.n := 1
        c
          ifTrue: [
            self.n := 2
            m := 0
            #(1, 2) do: [:e | m := m + e]
            m
          ]
          ifFalse: [9]
      ]
      ifFalse: [0]
    #[r, self.n]

  nilInArm: x =>
    r := x
      ifNil: [
        self.n := 1
        m := 0
        #(1, 2) do: [:e | m := m + e]
        m
      ]
      ifNotNil: [:v | v]
    #[r, self.n]
