// BT-3407: root supervisor that nests ClassStateSupApp, so ClassStateSupApp's
// class process is free while its configuration runs. See
// stdlib/test/fixtures/class_state_sup_app.bt.

Supervisor subclass: ClassStateSupRoot

  childSpecs => #(ClassStateSupApp)
