// BT-4567 fixture: an actor declaring a secret state slot and secret
// selectors. See stdlib/test/actor_secret_redaction_test.bt.

Actor subclass: SecretVault
  state: verifier = 31337
  state: count = 4242

  class secretState -> List(Symbol) => #(#verifier)

  class secretSelectors -> List(Symbol) => #(#unlock:)

  unlock: code => code * 3

  count => self.count
