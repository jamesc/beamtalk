// BT-3744 (ADR 0131 Phase 0a): the actor-instance-method column of the ADR 0131 probe
// matrix. Each method is one probe shape, named after its row in the ADR's
// tables (o1-o13: operand position; s1-s9: assign-RHS and statement
// position; `seq`: the §1a sequencing shape; `tryDo*`: the `Result tryDo:`
// failure the ADR's Context describes). Each starts from `t := 0` and uses the
// ADR's body (laid out by `beamtalk fmt`); it answers `#[r, t]` (or `#[self.n, t]` for a field
// write, or the one value the ADR expects). See
// stdlib/test/adr0131local_rebind_test.bt for the expected answers.
//
// Every shape compiled in an actor instance method before BT-3745. Since
// BT-3745 (ADR 0131 Phase 0b) the ones that crashed or answered wrong (o1-o4,
// o6-o10, o12, s1, s2, s9, seq) are compile errors and live in
// adr0131local_rebind_actor_pending.bt.pending, so this module compiles.

Actor subclass: Adr0131LocalRebindActor
  state: n = 0

  o5 =>
    t := 0
    self.n := [
      t := t + 1
      1
    ] on: Error do: [:e | 0]
    #[self.n, t]

  o11 =>
    t := 0
    4 =:= 5 ifFalse: [t := t + 1]
    a := t
    [t := t + 1] ensure: [nil]
    #[a, t]

  o13: c =>
    t := 0
    self.n := c
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]
    #[self.n, t]

  s3 =>
    t := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]
    #[r, t]

  s4 =>
    t := 0
    b := [t := t + 1]
    b value
    t

  s5 =>
    t := 0
    r := 4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]
    #[r, t]

  s6 =>
    t := 0
    r := (Erlang lists)
      map: [:x |
        t := t + 1
        x
      ]
      with: #(1)
    #[r, t]

  s7 =>
    t := 0
    r := nil
      ifNil: [
        t := t + 1
        1
      ]
    #[r, t]

  s8 =>
    t := 0
    #(1, 2) do: [:x | t := t + x]
    t

  tryDoRaises =>
    t := 0
    r := (Result
      tryDo: [
        t := t + 1
        1 / 0
      ]) isError
    #[r, t]

  tryDoStatement =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        1
      ]
    t

  // BT-3753: the statement-position shapes that are Phase 0 compile errors in
  // class and value-type methods but answer right in an actor method.
  stArmDo: c =>
    t := 0
    c ifTrue: [#(1, 2) do: [:e | t := t + e]]
    t

  stArmInject: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2)
          inject: 0
          into: [:a :e |
            t := t + e
            a + e
          ]
      ]
    t

  stEachWithIndex =>
    t := 0
    #(1, 2) eachWithIndex: [:x :i | t := t + x]
    t

  stDoSeparatedBy =>
    t := 0
    #(1, 2) do: [:x | t := t + x] separatedBy: [t := t + 10]
    t

  stKeysAndValuesDo =>
    t := 0
    #{#a => 1, #b => 2} keysAndValuesDo: [:k :v | t := t + v]
    t

  stBlockValue =>
    t := 0
    [t := t + 1] value
    t
