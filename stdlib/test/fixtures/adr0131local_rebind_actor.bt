// BT-3744 (ADR 0131 Phase 0a): the actor-instance-method column of the ADR 0131 probe
// matrix. Each method is one probe shape, named after its row in the ADR's
// tables (o1-o13: operand position; s1-s9: assign-RHS and statement
// position; `seq`: the §1a sequencing shape; `tryDo*`: the `Result tryDo:`
// failure the ADR's Context describes). Each starts from `t := 0` and uses the
// ADR's body (laid out by `beamtalk fmt`); it answers `#[r, t]` (or `#[self.n, t]` for a field
// write, or the one value the ADR expects). See
// stdlib/test/adr0131local_rebind_test.bt for the expected answers.
//
// Every shape compiled in an actor instance method before BT-3745. Since
// BT-3745 (ADR 0131 Phase 0b) the ones that crashed or answered wrong (o1-o4,
// o6-o10, o12, s1, s2, s9, seq) are compile errors and live in
// adr0131local_rebind_actor_pending.bt.pending, so this module compiles. o4
// and s9 moved back when ADR 0131 Phase 2 (BT-3749) made loops and folds
// local-threading producers.

Actor subclass: Adr0131LocalRebindActor
  state: n = 0

  o5 =>
    t := 0
    self.n := [
      t := t + 1
      1
    ] on: Error do: [:e | 0]
    #[self.n, t]

  o11 =>
    t := 0
    4 =:= 5 ifFalse: [t := t + 1]
    a := t
    [t := t + 1] ensure: [nil]
    #[a, t]

  o13: c =>
    t := 0
    self.n := c
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]
    #[self.n, t]

  s3 =>
    t := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]
    #[r, t]

  s4 =>
    t := 0
    b := [t := t + 1]
    b value
    t

  s5 =>
    t := 0
    r := 4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]
    #[r, t]

  s6 =>
    t := 0
    r := (Erlang lists)
      map: [:x |
        t := t + 1
        x
      ]
      with: #(1)
    #[r, t]

  s7 =>
    t := 0
    r := nil
      ifNil: [
        t := t + 1
        1
      ]
    #[r, t]

  s8 =>
    t := 0
    #(1, 2) do: [:x | t := t + x]
    t

  tryDoRaises =>
    t := 0
    r := (Result
      tryDo: [
        t := t + 1
        1 / 0
      ]) isError
    #[r, t]

  tryDoStatement =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        1
      ]
    t

  // BT-3753: the statement-position shapes that are Phase 0 compile errors in
  // class and value-type methods but answer right in an actor method.
  stArmDo: c =>
    t := 0
    c ifTrue: [#(1, 2) do: [:e | t := t + e]]
    t

  stArmInject: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2)
          inject: 0
          into: [:a :e |
            t := t + e
            a + e
          ]
      ]
    t

  stEachWithIndex =>
    t := 0
    #(1, 2) eachWithIndex: [:x :i | t := t + x]
    t

  stDoSeparatedBy =>
    t := 0
    #(1, 2) do: [:x | t := t + x] separatedBy: [t := t + 10]
    t

  stKeysAndValuesDo =>
    t := 0
    #{#a => 1, #b => 2} keysAndValuesDo: [:k :v | t := t + v]
    t

  stBlockValue =>
    t := 0
    [t := t + 1] value
    t

  o4 =>
    t := 0
    r := (#(1, 2) collect: [:x | t := t + x]) size
    #[r, t]

  s9 =>
    t := 0
    r := (#(1, 2)
      reject: [:x |
        t := t + 1
        false
      ]) size
    #[r, t]

  // BT-3794 (ADR 0131 Phase 2c): `detect:ifNone:` whose handler writes.
  s2 =>
    t := 0
    r := #(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        0
      ]
    #[r, t]

  stDetectIfNone =>
    t := 0
    #(1, 2) detect: [:e | e > 5] ifNone: [t := t + 1]
    t

  // ADR 0131 Phase 3 (BT-3738): conditionals as local-threading producers
  o3 =>
    t := 0
    r := (4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]) + 1
    #[r, t]

  o12: c =>
    t := 0
    self.n := (c
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]) + 1
    #[self.n, t]

  // BT-3748 review: the §1a shape with the threading construct nested inside
  // the right operand (an argument of a send, the receiver of a binary send)
  // rather than the operand itself. Source order reads `t` first: #[1, 1].
  seqArg: flag =>
    t := 0
    r := t + (0
      max: (flag
        ifTrue: [
          t := t + 1
          1
        ]
        ifFalse: [0]))
    #[r, t]

  seqRecv: flag =>
    t := 0
    r := t + ((flag
      ifTrue: [
        t := t + 1
        1
      ]
      ifFalse: [0]) + 0)
    #[r, t]

  // A loop in a conditional arm.
  stArmWhile: c =>
    t := 0
    c ifTrue: [[t < 2] whileTrue: [t := t + 1]]
    t

  // ADR 0131 Phase 3b (BT-3817): `on:do:`/`ensure:` as local-threading producers
  // (o1, o2, o5-o10, seq and the protected-body `do:`).
  o1 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  o2 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] ensure: [t := t + 1]) + 1
    #[r, t]

  o6: cond =>
    t := 0
    cond
      ifTrue: [
        ^#[([
          t := t + 1
          1
        ] on: Error do: [:e | 0]), t]
      ]
    #[0, t]

  o7: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
      7
    ] on: Error do: [:x | 3]
    #[r, t]

  o8: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
    ] on: Error do: [:x | 3]
    #[r, t]

  // o9: o1's operand as the method's last expression.
  o9 =>
    t := 0
    ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1

  // o10: o1's operand as a `^` value inside an arm.
  o10: cond =>
    t := 0
    cond
      ifTrue: [
        ^([
          t := t + 1
          1
        ] on: Error do: [:e | 0]) + 1
      ]
    0

  seq =>
    t := 0
    r := t + ([
      t := t + 1
      1
    ] on: Error do: [:e | 0])
    #[r, t]

  // A `do:` in an `on:do:` body.
  stProtectedDo =>
    t := 0
    [
      #(1, 2) do: [:x | t := t + x]
      7
    ] on: Error do: [:e | 0]
    t
