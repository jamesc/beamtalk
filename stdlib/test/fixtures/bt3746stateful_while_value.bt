// BT-3746 (ADR 0131 Phase 1a): `whileTrue:` loops whose condition writes a
// method local, in a value-type method. `run`/`runEmptyBody` use a stateful
// condition (it sends to `self`); `plainEmptyBody` a plain one (BT-3782).
// See stdlib/test/bt3746stateful_while_test.bt.

Value subclass: Bt3746StatefulWhileValue

  check: n => n < 3

  run =>
    t := 0
    u := 0
    [
      t := t + 1
      self check: t
    ] whileTrue: [u := u + 1]
    #[t, u]

  runEmptyBody =>
    t := 0
    [
      t := t + 1
      self check: t
    ] whileTrue: [nil]
    t

  plainEmptyBody =>
    t := 0
    [
      t := t + 1
      t < 3
    ] whileTrue: [nil]
    t
