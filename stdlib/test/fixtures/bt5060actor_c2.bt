// BT-5060: link 2 of the actor chain in lookup_order_matrix_test.bt. Each selector is
// compiled on a different subset of the chain and answers the symbol naming the
// class that compiled it (#c0 .. #c3). `superS*` send the named selector to super.

Bt5060ActorC1 subclass: Bt5060ActorC2

  class s02 -> Symbol => #c2

  s02 -> Symbol => #c2

  class s2 -> Symbol => #c2

  s2 -> Symbol => #c2

  class sAll -> Symbol => #c2

  sAll -> Symbol => #c2

  class superS0 -> Symbol => super s0

  superS0 -> Symbol => super s0

  class superSAll -> Symbol => super sAll

  superSAll -> Symbol => super sAll

  class superS02 -> Symbol => super s02

  superS02 -> Symbol => super s02

