// BT-4252: Behaviour-protocol selectors sent to `self`/`super` from
// `class sealed` methods of a sealed, stateless class, which are
// direct-called in the caller (ADR 0129 Phase 0b).

sealed Bt4252ClassProtocolObjectBase subclass: Bt4252ClassProtocolSealed

  class sealed selfName => self name

  class sealed superName => super name

  class sealed selfSuperclass => self superclass

  class sealed superSuperclass => super superclass

  class sealed superNameInClosure => #(1) collect: [:x | super name]

  // Direct-called in the caller, so even `doc` (whose primitive messages the
  // class process) answers.
  class sealed selfDoc => self doc
