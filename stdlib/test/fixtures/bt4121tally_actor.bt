// BT-4121 fixture: an actor whose loops add `Bt4121TallyMoney` amounts over
// untyped locals. Each slow path reports back through `noteAdd:`, so the
// count answers how many slow-path writes the loop loaded back. Every loop
// below holds no whole `State` (tuple-accumulator fold or direct-params
// letrec): the guarded operator must still see the live cell.

Actor subclass: Bt4121TallyActor
  state: count = 0
  state: total = 0
  state: hits = 0

  count => self.count

  total => self.total

  hits => self.hits

  noteAdd: sum =>
    self.count := self.count + 1
    self.total := sum
    self.count

  items =>
    t := self
    #((((Bt4121TallyMoney new) withCents: 100) withTally: t), (((Bt4121TallyMoney new) withCents: 200) withTally: t), (((Bt4121TallyMoney new) withCents: 300) withTally: t))

  // `do:` over untyped locals: `acc + m` dispatches to `Bt4121TallyMoney>>+`.
  sum: items =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    items do: [:m | acc := acc + m]
    acc cents

  // A field write before the loop must be visible to the slow path.
  sumSeeded: items =>
    self.count := 100
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    items do: [:m | acc := acc + m]
    self.count

  // `0 + m` reaches `plusFromNumber:` through the coercion branch.
  sumFromNumber: items =>
    acc := 0
    items do: [:m | acc := acc + m]
    self.count

  // Non-carried block: the `do:` itself must bracket the closure call.
  pokeAll: items =>
    items do: [:m | m + m]
    self.count

  // `whileTrue:` direct-params loop over untyped locals.
  repeatAdd: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    i := n
    [i > 0]
      whileTrue: [
        acc := acc + m
        i := i - 1
      ]
    acc cents

  // Counted `to:do:` loop over untyped locals.
  repeatAddTo: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    1 to: n do: [:i | acc := acc + m]
    acc cents

  // `timesRepeat:` loop over untyped locals.
  repeatAddTimes: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    n timesRepeat: [acc := acc + m]
    acc cents

  // `collect:` with a carried local answers every running sum.
  collectSums: items =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    items collect: [:m | acc := acc + m]

  // `inject:into:` already brackets its closure call; pins that behaviour.
  injectSums: items =>
    items inject: (((Bt4121TallyMoney new) withCents: 0) withTally: self) into: [:acc :m |
      acc + m
    ]

  // Non-carried `timesRepeat:` lowers to a runtime call: the send itself
  // must bracket the closure holding the guarded operator.
  pokeTimes: g count: n =>
    n timesRepeat: [g + g]
    self.count

  // An evaluated literal block holding only a guarded operator: the
  // `value:` send must bracket the closure call.
  applyValue: x =>
    [:m | m + m] value: x
    self.count

  // A field read inside the loop must see the slow paths' writes, not the
  // loop-entry `State`.
  readCountWhileAdding: items =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    k := 0
    items
      do: [:m |
        k := self.count
        acc := acc + m
      ]
    k

  // Same, for a `whileTrue:` direct-params loop.
  repeatAddCounting: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    k := 0
    i := n
    [i > 0]
      whileTrue: [
        k := self.count
        acc := acc + m
        i := i - 1
      ]
    k

  // A conditional `^` out of a bracketed loop lowers through the closure
  // arm, which reads the live cell the bracket keeps current.
  sumUntil: items limit: cents =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    items
      do: [:m |
        acc := acc + m
        (acc cents) > cents ifTrue: [^acc]
      ]
    acc

  // A direct `^` out of a bracketed loop carries the live cell, like the
  // loop's own exit pack — the slow-path writes made before it survive.
  sumFirst: items =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    items
      do: [:m |
        acc := acc + m
        ^acc
      ]
    acc

  // BT-4179: an `on:do:` in a bracketed counted loop whose handler catches
  // and lets the loop continue (`m - m` is a guarded operator whose slow path
  // raises does_not_understand). The boundary snapshots the live cell on
  // entry to the protected block, so the slow-path writes of earlier
  // iterations (and of this one, before the `try`) survive the catch.
  sumCatching: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    1
      to: n
      do: [:i |
        acc := acc + m
        [m - m] on: Error do: [:e | nil]
      ]
    self.count

  // Same, for a `whileTrue:` direct-params loop.
  repeatAddCatching: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    i := n
    [i > 0]
      whileTrue: [
        acc := acc + m
        [m - m] on: Error do: [:e | nil]
        i := i - 1
      ]
    self.count

  // BT-4179: the protected block's own slow-path write (`m + m`) still rolls
  // back when the block raises (ADR 0130 §4), while the loop's writes survive.
  sumRollingBack: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    1
      to: n
      do: [:i |
        acc := acc + m
        [
          m + m
          m - m
        ] on: Error do: [:e | nil]
      ]
    self.count

  // BT-4179: a hybrid inner loop (it holds `hits`, which it writes, and
  // `total`, which it reads, in fun parameters) with a caught `on:do:`,
  // nested in a loop that brackets guarded operators. A hybrid body runs no
  // user code, so its boundary stores the threaded `State`; the pre-`try`
  // write and the slow paths' writes both survive.
  hybridCatching: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    k := 0
    1
      to: n
      do: [:i |
        acc := acc + m
        1
          to: 2
          do: [:j |
            k := self.total
            self.hits := k
            [0 error: "boom"] on: Error do: [:e | nil]
          ]
      ]
    (self.count * 1000) + self.hits

  // Same, the hybrid loop reading the field the slow paths write.
  hybridReadingCatching: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    k := 0
    1
      to: n
      do: [:i |
        acc := acc + m
        1
          to: 2
          do: [:j |
            k := self.count
            self.hits := k
            [0 error: "boom"] on: Error do: [:e | nil]
          ]
      ]
    (self.count * 1000) + self.hits

  // The hybrid inner loop's `on:do:` does not match, so the error escapes the
  // method: the failed call rolls back every write, like the same method
  // without the boundary (`hybridEscapingBare:`).
  hybridEscaping: m =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    k := 0
    self.total := 7
    1
      to: 1
      do: [:i |
        acc := acc + m
        1
          to: 2
          do: [:j |
            k := j
            self.hits := j
            [0 error: "boom"] on: TypeError do: [:e | nil]
          ]
      ]
    k

  hybridEscapingBare: m =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    k := 0
    self.total := 7
    1
      to: 1
      do: [:i |
        acc := acc + m
        1
          to: 2
          do: [:j |
            k := j
            self.hits := j
            0 error: "boom"
          ]
      ]
    k

  // An inner loop whose protected block writes a field and then raises (the
  // write keeps it out of hybrid mode, so it threads `State`), nested in a
  // bracketing loop: the protected write rolls back, the others survive.
  nestedRollingBack: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    1
      to: n
      do: [:i |
        acc := acc + m
        j := 2
        [j > 0]
          whileTrue: [
            self.hits := self.hits + 1
            [
              self.hits := self.hits + 100
              Error signal: "boom"
            ] on: Error do: [:e | nil]
            j := j - 1
          ]
      ]
    (self.count * 1000) + self.hits

  // An `on:do:` in an inner direct-params loop nested in a bracketing loop.
  nestedCatching: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    1
      to: n
      do: [:i |
        acc := acc + m
        k := 0
        1
          to: 2
          do: [:j |
            k := k + 1
            [m - m] on: Error do: [:e | nil]
          ]
      ]
    self.count

  // An `ensure:` in a bracketed loop keeps the slow paths' writes too.
  sumEnsuring: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    1
      to: n
      do: [:i |
        acc := acc + m
        [0] ensure: [nil]
      ]
    self.count

  // BT-4179: a fold nested in a bracketing loop, whose body holds a
  // parenthesised conditional writing an outer local, threads its own
  // `StateAcc` while the loop keeps direct parameters. It seeds that
  // accumulator from the cell, so its stores (the bracket around `t + 1`,
  // the `on:do:` boundary) keep the slow paths' writes.
  foldInLoopCatching: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    t := 0
    1
      to: n
      do: [:k |
        acc := acc + m
        #(1) do: [:i | ((k == k) ifTrue: [[t := t + 1] on: Error do: [:e | 0]])]
      ]
    (self.count * 1000) + t

  // Same, without the `on:do:`.
  foldInLoop: m times: n =>
    acc := ((Bt4121TallyMoney new) withCents: 0) withTally: self
    t := 0
    1
      to: n
      do: [:k |
        acc := acc + m
        #(1) do: [:i | ((k == k) ifTrue: [t := t + 1])]
      ]
    (self.count * 1000) + t
