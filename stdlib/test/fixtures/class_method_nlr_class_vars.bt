// BT-1202: Fixture for non-local return (^) inside blocks in class methods
// that also rebind a method-level local. Tests that the local's value at the
// point of the non-local return is the one the method answers.

Object subclass: ClassMethodNlrClassVars

  // Rebinds the local, then uses ^ to return early if positive. The answer
  // carries the local so the test observes the write that preceded the ^.
  class check: x =>
    seen := 0
    seen := seen + 1
    x > 0 ifTrue: [^#("positive", seen)]
    #("negative", seen)
