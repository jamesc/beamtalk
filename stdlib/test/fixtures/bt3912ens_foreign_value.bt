// BT-3912 (BT-3947): a `^` thrown from a closure that one `ensure:` built and a
// different `ensure:` later runs carries the first construct's locals, not the
// second's. Each `ensure:` takes only the wrapper it built (a per-construct id),
// so the second catch never runs its cleanup over the first's locals, even when
// both use the same local name (`same:`), and a different name no longer crashes
// (`escaped:`). The `^` still answers its value. The second cleanup sees its
// entry locals (the known limitation of a throw it did not build).

Value subclass: Bt3912EnsForeignValue

  escaped: sink =>
    t := 0
    blk := [0]
    [
      t := 1
      blk := [^t]
    ] ensure: [sink record: t]
    u := 0
    [
      u := 1
      blk value
      ^u
    ] ensure: [sink record: u]

  same: sink =>
    t := 0
    blk := [0]
    [
      t := 1
      blk := [^t]
    ] ensure: [sink record: t]
    t := 5
    [
      t := 2
      blk value
    ] ensure: [sink record: t]
