// BT-3746 (ADR 0131 Phase 1a): `whileTrue:` loops whose condition writes a
// method local, in an actor instance method, with a stateful condition (it
// sends to `self`). A plain condition write, or any condition write in a
// class method, is a compile error (BT-3782, ADR 0131 §6). See
// stdlib/test/bt3746stateful_while_test.bt.

Actor subclass: Bt3746StatefulWhileActor

  check: n => n < 3

  run =>
    t := 0
    u := 0
    [
      t := t + 1
      self check: t
    ] whileTrue: [u := u + 1]
    #[t, u]

  runEmptyBody =>
    t := 0
    [
      t := t + 1
      self check: t
    ] whileTrue: [nil]
    t
