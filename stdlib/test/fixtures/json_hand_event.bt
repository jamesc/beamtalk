// Fixture for BT-2819 (JsonMappable / JsonMapping); see json_mapping_test.bt.
// Mirrors beamtalk-symphony / beamtalk-exdura classes; the Hand* twins are the
// hand-written asJson equivalents used for byte-identical comparison.

Value subclass: JsonHandEvent
  field: eventType = #started
  field: seq = 0

  asJson => #{"event_type" => self.eventType asString, "seq" => self.seq}
