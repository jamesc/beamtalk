// BT-3981: an evaluated block literal that binds a local, writes a field or
// sends to `self`, in the host/position cells that answer the value.
// A class method answers the value at every position.

Object subclass: Bt3981EvalblockClass

  class ap: b => b value

  class peek: v => v

  class methodAssignedSimple =>
    r := [
