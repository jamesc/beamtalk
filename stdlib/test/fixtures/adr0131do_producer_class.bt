// BT-3796 (ADR 0131 Phase 2c): `do:` is a local-threading producer
// (`producer_body_arg_index`), so a `do:` whose block writes an outer local
// is lowered through the construct tuple in every operand position of a
// method-body statement, in every method context: the write is visible to
// everything evaluated after it, and the `do:` answers `nil`. The columns are
// adr0131do_producer_{class,value,actor}.bt; the expected answers are in
// stdlib/test/adr0131do_producer_test.bt.

Object subclass: Adr0131DoProducerClass
  classState: n = 0

  class plain => 0

  class doAsAssignedValue =>
    t := 0
    r := #(1, 2) do: [:x | t := t + x]
    #[r, t]

  class doInLiteral =>
    t := 0
    #[#(1, 2) do: [:x | t := t + x], t]

  class doReturnedInLiteral =>
    t := 0
    ^#[#(1, 2) do: [:x | t := t + x], t]

  class doAsReceiver =>
    t := 0
    r := (#(1, 2) do: [:x | t := t + x]) isNil
    #[r, t]

  class doTwoLocals =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + x
        u := u + 10
      ]
    #[t, u]

  class doTwice =>
    t := 0
    #[#(1, 2) do: [:x | t := t + x], #(3) do: [:x | t := t + x], t]

  class doAfterLeftRead =>
    t := 0
    #[t, #(1, 2) do: [:x | t := t + x], t]

  class doParenthesisedAssigned =>
    t := 0
    r := (#(1, 2) do: [:x | t := t + x])
    #[r, t]

  class doStatementThenRead =>
    t := 0
    #(1, 2) do: [:x | t := t + x]
    t

  class doAsArgument =>
    t := 0
    r := t max: (#(1, 2) do: [:x | t := t + x]) isNil printString size
    #[r, t]

  class doWithSelfSend =>
    t := 0
    r := #(1, 2)
      do: [:x |
        t := t + x
        self plain
      ]
    #[r, t]

  class dictLiteralDoAssigned =>
    t := 0
    r := #{#a => 1, #b => 2} do: [:x | t := t + x]
    #[r, t]

  class dictLiteralDoInToDo =>
    t := 0
    1 to: 2 do: [:i | #{#a => 1, #b => 2} do: [:x | t := t + x]]
    t

  class doReadsAndWrites =>
    t := 5
    r := #(1, 2) do: [:x | t := t * x]
    #[r, t]

  class doWithFieldWrite =>
    self.n := 0
    t := 0
    r := #(1, 2)
      do: [:x |
        t := t + x
        self.n := self.n + 1
      ]
    #[r, t, self.n]

  class doInFieldAssignment =>
    self.n := 0
    t := 0
    self.n := (#(1, 2) do: [:x | t := t + x]) printString
    #[self.n, t]
