// BT-3022: a driver that runs a block over a list, offered both class-side and
// instance-side with identical bodies.
//
// The class-side form hops into the class gen_server process, so a block passed
// through it runs in a *different* process from its caller. Used by
// `ClassDrivenCollection` (class-side) and `SelfDrivenCollection` (instance-side)
// to compare the two paths.

Value subclass: CollectionDriver

  // CLASS-side driver — running this hops into the class process.
  class run: aBlock :: Block over: aList :: List -> Nil =>
    aList do: [:x | aBlock value: x]
    nil

  // BT-3022: re-entrant. This class method iterates a collection whose `do:`
  // delegates back to *this same class*, so the inner class send targets the
  // process already executing this method.
  class reentrantAsListOf: aList :: List -> List =>
    (ClassDrivenCollection of: aList) asList

  // Instance-side control, identical body — stays in the caller's process.
  run: aBlock :: Block over: aList :: List -> Nil =>
    aList do: [:x | aBlock value: x]
    nil
