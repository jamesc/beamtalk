// Fixture for BT-2819 (JsonMappable / JsonMapping); see json_mapping_test.bt.
// Mirrors beamtalk-symphony / beamtalk-exdura classes; the Hand* twins are the
// hand-written asJson equivalents used for byte-identical comparison.

Value subclass: JsonHandRunningEntry
  field: issueId = ""
  field: issueIdentifier = ""
  field: state = ""
  field: turnCount = 0
  field: tokens = nil

  asJson =>
    #{
      "issue_id" => self.issueId,
      "issue_identifier" => self.issueIdentifier,
      "state" => self.state,
      "turn_count" => self.turnCount,
      "tokens" => self.tokens
    }
