// BT-3666: template-method fixture; see self_send_override_test.bt.

SsoClassVarBase subclass: SsoClassVarSub
  classState: subHits = 0

  class foo -> Integer =>
    self.subHits := self.subHits + 1
    2

  class subHits -> Integer => self.subHits
