// BT-4280: the owner of the inherited selectors in
// actor_inherited_target_test.bt (Bt4280Leaf defines none of them, so each
// send reaches its dispatch/4 default arm).

Actor subclass: Bt4280Root
  state: stash = nil

  tier -> Symbol => #fromRoot

  runStashed => self.stash value
