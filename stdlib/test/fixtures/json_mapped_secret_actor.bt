// Fixture for BT-5191; see json_mapping_test.bt.

// A mapped secretState slot with no converter is emitted as "[redacted]".
Actor subclass: JsonMappedSecretActor
  uses: JsonMappable
  state: token = "zqxv-json-secret-marker"
  state: label = "public"

  class secretState -> List(Symbol) => #(#token)

  class jsonMapping -> JsonMapping =>
    JsonMapping new |> mapField: #token |> mapField: #label
