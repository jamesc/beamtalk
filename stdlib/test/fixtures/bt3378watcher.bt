// BT-3378: Fixture actor for the "flat, sibling ifTrue: sequence" actor
// liveness regression. Mirrors a crash-recovery dispatcher — a method with
// several flat `cond ifTrue: [actor-spawning-work]` statements (not nested
// ifTrue:ifFalse:) — where only one, non-last, branch matches and spawns a
// child actor (BT3378Child, see bt3378child.bt). See
// bt3378flat_if_true_actor_liveness_test.bt.

Actor subclass: BT3378Watcher
  state: alertLog = nil
  state: router = nil
  state: registry = nil
  state: receiver = nil
  state: dashboard = nil

  configureAlertLog =>
    self.alertLog := BT3378Child spawn
    self.alertLog setTag: #alertLog

  configureRouter =>
    self.router := BT3378Child spawn
    self.router setTag: #router

  configureRegistry =>
    self.registry := BT3378Child spawn
    self.registry setTag: #registry

  configureReceiver =>
    self.receiver := BT3378Child spawn
    self.receiver setTag: #receiver

  configureDashboard =>
    self.dashboard := BT3378Child spawn
    self.dashboard setTag: #dashboard

  getAlertLog => self.alertLog

  getRouter => self.router

  getRegistry => self.registry

  getReceiver => self.receiver

  getDashboard => self.dashboard

  // Original repro shape (BT-3378): five flat, sibling `ifTrue:` checks —
  // no `ifFalse:`, no early exit. Only the matching branch's block ever
  // runs, but every condition is *evaluated* regardless of position.
  childExited: which :: Symbol reason: _reason :: Object -> BT3378Watcher =>
    which == #alertLog ifTrue: [self configureAlertLog]
    which == #router ifTrue: [self configureRouter]
    which == #registry ifTrue: [self configureRegistry]
    which == #receiver ifTrue: [self configureReceiver]
    which == #dashboard ifTrue: [self configureDashboard]
    self

  // Confirmed workaround shape from BT-3378: the same dispatch expressed as
  // nested ifTrue:ifFalse: so a match short-circuits and no later condition
  // is even evaluated. Used as a same-behavior baseline.
  childExitedNested: which :: Symbol reason: _reason :: Object -> BT3378Watcher =>
    which == #alertLog
      ifTrue: [self configureAlertLog]
      ifFalse: [
        which == #router
          ifTrue: [self configureRouter]
          ifFalse: [
            which == #registry
              ifTrue: [self configureRegistry]
              ifFalse: [
                which == #receiver ifTrue: [
                  self configureReceiver
                ] ifFalse: [
                  which == #dashboard ifTrue: [
                    self configureDashboard
                  ] ifFalse: [self]
                ]
              ]
          ]
      ]
    self
