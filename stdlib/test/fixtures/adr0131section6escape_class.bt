// BT-3756 (ADR 0131 §6): class-method column of
// adr0131section6escape_actor.bt (blocks that write no local of the method
// frame stay legal when returned or placed in a collection literal).

Object subclass: Adr0131Section6EscapeClass

  class returnedPure => [:x | x + 1]

  class returnedOwnLocal =>
    ^[:x |
      y := x * 2
      y + 1
    ]

  class returnedReadOnly =>
    t := 10
    ^[:x | x + t]

  class literalOfPure => #([:x | x + 1], [:x | x * 2])

  // BT-3859: what a method whose last statement is a local assignment
  // answers (pinned in adr0131section6escape_test.bt; BT-3882).
  class lastStatementAssignment => _r := 5

  class lastStatementBlockAssignment => _b := [:x | x + 1]

  class lastStatementArmAssignment: c => c ifTrue: [_r := 7] ifFalse: [nil]
