Object subclass: Bt3911CvOpen
  classState: n = 0
  classState: m = 0

  class n => self.n
  class m => self.m

  class h0: x =>
    1 to: 1 do: [:i1 | #(2, 1) do: [:e2 | self.m := 2 + e2. self.n := 2 + self.n]]
    self.n

  class h1: x =>
    self h0: 1
    _ := (#(3, 3, 3) collect: [:e3 | 5 =:= (2 + 3) ifTrue: [self.m := 1 + (self h0: x)] ifFalse: [self h0: x]. #(3, 4, 3) do: [:e4 | self.m := x]. [self.n := 4. self.n := 4. self h0: e3. e3] ensure: [self h0: 0]]) inject: 0 into: [:sa :sx | sa + sx]
    ^(Result tryDo: [i5 := 0. [i5 + (self h0: 3) < 2] whileTrue: [self h0: 3. self.m := 2 + self.n. i5 := i5 + 1]. self h0: x. v6 := 2 + (self h0: self.m). #(1, 3) inject: 3 into: [:a7 :e8 | v6 := v6 + 1. self.m := self h0: a7. 1 + e8]]) valueOr: 0

  class h2: x =>
    #(1, 2, 3) do: [:e9 | self h0: 1. b10 := [self.n := 3. self h1: x]]
    ^(Result tryDo: [self h0: self.m. self.n := 1. 4]) valueOr: 0

  class h3: x =>
    0 < (2 + (self h1: x)) ifTrue: [^self h1: 2]
    self h1: x

  class run =>
    _ := (Result tryDo: [i11 := 0. [i11 < 3] whileTrue: [#(4, 1) do: [:e12 | Error signal: "boom". Error signal: "boom"]. i11 := i11 + 1]. 5 < 1 ifTrue: [^3 + (self h2: 1)]. (#(4, 2) collect: [:e13 | b14 := [self h2: e13. self.n := self.n. e13]. 1 to: 3 do: [:i15 | self h3: 3]. [Error signal: "boom". Error signal: "boom". 1 + e13] on: Error do: [:x16 | self h1: 0]]) inject: 0 into: [:sa :sx | sa + sx]]) valueOr: 0
    self.n := 3
    1 =:= (3 + (self h1: self.n)) ifTrue: [^2 + 2]
    0
