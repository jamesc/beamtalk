// ADR 0137 Phase 2b (BT-4009): a state-changing `super` send in a loop body.

ClosureCellSuperBase subclass: ClosureCellSuperChild

  bump => super bump

  whileLoop =>
    i := 0
    [i < 3]
      whileTrue: [
        super bump
        i := i + 1
      ]
    self.n

  toDoLoop =>
    1 to: 3 do: [:i | super bump]
    self.n

  timesLoop =>
    3 timesRepeat: [super bump]
    self.n

  doLoop =>
    #(1, 2, 3) do: [:e | super bump]
    self.n

  peekBlock => [super peekViaPerform]

  runBlock: aBlock => aBlock value

  // A block that `super`-sends: run by another actor, the send goes away.
  superApplyBlock => [:blk | super apply: blk]

  // Runs `superBlk` (another actor's block) with a block reading this actor's
  // own field: while the away super runs, the cell holds the other actor's
  // state, so this must read the creation-time capture.
  runSuperApplyOnOwnRead: superBlk => superBlk value: [self.n]

  runSuperApplyOnOwnWrite: superBlk => superBlk value: [self.n := 99]

  runSuperApplyOnOwnSelfSend: superBlk => superBlk value: [self n]
