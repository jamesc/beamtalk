// BT-3750 (ADR 0131 Phase 4): the fixture behind
// stdlib/test/result_try_do_tier2test.bt, the Rust <-> Erlang conformance
// check for `Result tryDo:`.
//
// Codegen picks the arity of the native: a block that writes no outer local is
// a Tier 1 `fun()` and reaches `beamtalk_result:tryDo/1`; a block that
// writes one is a Tier 2 `fun(StateAcc)` and reaches `tryDo/2`. Each pair
// of methods below runs the SAME block body (the raise or the value) through both arities, the Tier 2 one with an extra local
// write, and answers what the test compares: the Result and (Tier 2 only) the local.

Object subclass: ResultTryDoTier2Fixture

  // --- non-raising path ----------------------------------------------------
  class tier1Ok =>
    r := Result tryDo: [7]
    #[r isOk, r value]

  class tier2Ok =>
    t := 0
    r := Result
      tryDo: [
        t := t + 1
        7
      ]
    #[r isOk, r value]

  class tier2OkLocal =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        7
      ]
    t

  // --- raising path --------------------------------------------------------
  class tier1Raise =>
    r := Result tryDo: [Error signal: "boom"]
    #[r isError, r error class, r error message]

  class tier2Raise =>
    t := 0
    r := Result
      tryDo: [
        t := t + 1
        Error signal: "boom"
      ]
    #[r isError, r error class, r error message]

  class tier2RaiseLocal =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        Error signal: "boom"
      ]
    t

  // --- local write kept across a prior success, discarded by a later raise ---
  class tier2Sequence =>
    t := 0
    Result tryDo: [t := t + 1]
    Result
      tryDo: [
        t := t + 100
        Error signal: "boom"
      ]
    Result tryDo: [t := t + 10]
    t

  // --- `^` is control flow, not an error: it leaves tryDo: untouched ---------
  class tier2NonLocalReturn =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        ^t + 41
      ]
    -1

  // --- a Dictionary lookup producer nested in the block (BT-3798) -------------
  class tier2Lookup =>
    t := 0
    Result
      tryDo: [
        (Dictionary new at: #a put: 1) at: #k ifAbsent: [t := t + 1]
        7
      ]
    t
