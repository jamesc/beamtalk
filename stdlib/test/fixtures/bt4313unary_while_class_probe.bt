// BT-4313: the unary `[...] whileTrue` / `[...] whileFalse` loops in class
// methods. See stdlib/test/bt4313unary_while_test.bt.

Object subclass: Bt4313UnaryWhileClassProbe

  class countUpWith: counter =>
    [counter bump < 3] whileTrue
    counter count

  class countUntilWith: counter =>
    [counter bump >= 5] whileFalse
    counter count
