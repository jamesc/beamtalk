// BT-3841 (ADR 0131): `anySatisfy:` / `allSatisfy:` as local-threading producers. Each method starts
// from `t := 0` and writes it from the block in one position; the expected
// answers are in stdlib/test/adr0131satisfy_test.bt. The block runs for every element
// (the fold does not short-circuit, as in an actor method since ADR 0041): a
// predicate that answers true early still runs its writes for the rest.
// `c` is the condition of the arm shapes.

Object subclass: Adr0131SatisfyClass

  class topAny =>
    t := 0
    #(1, 2)
      anySatisfy: [:v |
        t := t + v
        false
      ]
    t

  class inArmAny: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inArmElseAny: c =>
    t := 0
    c
      ifTrue: [t := 100]
      ifFalse: [
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inDoAny =>
    t := 0
    #(1, 2)
      do: [:z |
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inToDoAny =>
    t := 0
    1
      to: 2
      do: [:z |
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inTimesAny =>
    t := 0
    2
      timesRepeat: [
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inWhileAny =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        i := i + 1
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inOnDoAny =>
    t := 0
    [
      #(1, 2)
        anySatisfy: [:v |
          t := t + v
          false
        ]
    ] on: Error do: [:e | 0]
    t

  class inEnsureAny =>
    t := 0
    [
      #(1, 2)
        anySatisfy: [:v |
          t := t + v
          false
        ]
    ] ensure: [nil]
    t

  class inHandlerAny =>
    t := 0
    [Error signal: "x"]
      on: Error
      do: [:e |
        #(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class inArmInDoAny: c =>
    t := 0
    #(1, 2)
      do: [:z |
        c
          ifTrue: [
            #(1, 2)
              anySatisfy: [:v |
                t := t + v
                false
              ]
          ]
      ]
    t

  class returnInArmAny: c =>
    t := 0
    c
      ifTrue: [
        ^#(1, 2)
          anySatisfy: [:v |
            t := t + v
            false
          ]
      ]
    t

  class assignedAny =>
    t := 0
    r := #(1, 2)
      anySatisfy: [:v |
        t := t + v
        false
      ]
    #[r, t]

  class topAll =>
    t := 0
    #(1, 2)
      allSatisfy: [:v |
        t := t + v
        true
      ]
    t

