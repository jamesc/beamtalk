// BT-3704 (ADR 0130 Phase 1): a supervisor whose `class initialize:` hook writes a
// class variable (the `class initialize:` row), sealed spelling.

sealed Supervisor subclass: CvsInitSealed
  classState: n = 0

  class strategy -> Symbol => #oneForOne

  class children -> List => #()

  class n => self.n

  class reset => self.n := 0

  class bump => self.n := self.n + 1

  class initialize: _sup => self bump
