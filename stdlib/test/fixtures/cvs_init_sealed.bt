// BT-3704 (ADR 0130 Phase 1): a supervisor whose `initialize` hook writes a
// class variable through a class method (the `initialize` row; instance-side since ADR 0135), sealed spelling.

sealed Supervisor subclass: CvsInitSealed
  classState: n = 0

  class n => self.n

  class reset => self.n := 0

  class bump => self.n := self.n + 1

  strategy -> Symbol => #oneForOne

  childSpecs -> List => #()

  initialize => self class bump
