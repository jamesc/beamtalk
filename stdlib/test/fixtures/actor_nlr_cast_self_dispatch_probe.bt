// BT-3374: victim actor used by fixtures/actor_nlr_cast_self_dispatch.bt's
// BT3374CastNlrSender — spawned and then stopped to trigger an `onExit:`
// callback (a foreign-process cast) into the sender. See that file for the
// full bug writeup.

Actor subclass: BT3374Probe
  state: log = #()

  trace: s =>
    self.log := self.log add: s
    self

  log => self.log
