// BT-3913: a field write made in an enclosing actor loop body must survive a
// nested `do:separatedBy:`. Asserted in bt3913nested_seed_test.bt.

Actor subclass: Bt3913NestedSeedActor
  state: n = 0

  run =>
    t := 0
    m := 0
    [m < 2]
      whileTrue: [
        m := m + 1
        #(1, 2)
          do: [:z |
            self.n := self.n + 1
            u := 0
            #(1, 2) do: [:x | u := u + x] separatedBy: [u := u + 10]
            t := t + u
          ]
      ]
    #[t, self.n]
