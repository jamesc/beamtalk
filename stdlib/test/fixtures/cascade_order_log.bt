// BT-3406 review follow-up: shared order-recording actor for
// stdlib/test/fixtures/cascade_order_preserved.bt — see that file for full
// context. `record:` both mutates `entries` and returns a value, so it can
// be used directly as a cascade argument expression.

Actor subclass: CascadeOrderLog
  state: entries :: List = #()

  record: tag -> Symbol =>
    self.entries := self.entries ++ #(tag)
    tag

  entries -> List => self.entries
