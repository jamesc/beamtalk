// GENERATED by the BT-3936 matrix (self-send kind x block host x
// state-changing / read-only callee); see closure_self_send_matrix_test.bt.
// A self-send inside a closure cannot return the callee's State: when the
// callee changed it the send raises `stateful_block_dispatch`, when it did
// not the send answers normally.

Actor subclass: ClosureSelfSendMatrix
  state: items = #(1, 2, 3)
  state: total = 0

  each: blk => self.items collect: blk

  bump => self.total := self.total + 1

  bump: x => self.total := self.total + x

  + x => self.total := self.total + x

  peek => self.total

  peek: x => self.total + x

  - x => self.total - x

  total => self.total

  peekCond: x =>
    r := self.total
    x > 1 ifTrue: [r := x]
    r

  peekOnDo: x =>
    r := self.total
    [r := x] on: Error do: [:e | r := 0]
    r

  peekEnsure: x =>
    r := self.total
    [x] ensure: [r := x]
    r

  peekCondTwice: x =>
    r := self.total
    x > 1 ifTrue: [r := x] ifFalse: [r := 0]
    x > 1 ifTrue: [r := r + 1]
    r

  collectUnaryChanging => self.items collect: [:x | self bump]

  collectUnaryReadOnly => self.items collect: [:x | self peek]

  collectKeywordChanging => self.items collect: [:x | self bump: x]

  collectKeywordReadOnly => self.items collect: [:x | self peek: x]

  collectBinaryReadOnly => self.items collect: [:x | self - x]

  selectUnaryChanging =>
    self.items
      select: [:x |
        self bump
        true
      ]

  selectUnaryReadOnly =>
    self.items
      select: [:x |
        self peek
        true
      ]

  selectKeywordChanging =>
    self.items
      select: [:x |
        self bump: x
        true
      ]

  selectKeywordReadOnly =>
    self.items
      select: [:x |
        self peek: x
        true
      ]

  selectBinaryReadOnly =>
    self.items
      select: [:x |
        self - x
        true
      ]

  injectUnaryChanging =>
    self.items
      inject: 0
      into: [:a :x |
        self bump
        a + 1
      ]

  injectUnaryReadOnly =>
    self.items
      inject: 0
      into: [:a :x |
        self peek
        a + 1
      ]

  injectKeywordChanging =>
    self.items
      inject: 0
      into: [:a :x |
        self bump: x
        a + 1
      ]

  injectKeywordReadOnly =>
    self.items
      inject: 0
      into: [:a :x |
        self peek: x
        a + 1
      ]

  injectBinaryReadOnly =>
    self.items
      inject: 0
      into: [:a :x |
        self - x
        a + 1
      ]

  detectUnaryChanging =>
    self.items
      detect: [:x |
        self bump
        false
      ]
      ifNone: [0]

  detectUnaryReadOnly =>
    self.items
      detect: [:x |
        self peek
        false
      ]
      ifNone: [0]

  detectKeywordChanging =>
    self.items
      detect: [:x |
        self bump: x
        false
      ]
      ifNone: [0]

  detectKeywordReadOnly =>
    self.items
      detect: [:x |
        self peek: x
        false
      ]
      ifNone: [0]

  detectBinaryReadOnly =>
    self.items
      detect: [:x |
        self - x
        false
      ]
      ifNone: [0]

  userHomUnaryChanging => self each: [:x | self bump]

  userHomUnaryReadOnly => self each: [:x | self peek]

  userHomKeywordChanging => self each: [:x | self bump: x]

  userHomKeywordReadOnly => self each: [:x | self peek: x]

  userHomBinaryReadOnly => self each: [:x | self - x]

  storedUnaryChanging =>
    blk := [:x | self bump]
    self.items collect: blk

  storedUnaryReadOnly =>
    blk := [:x | self peek]
    self.items collect: blk

  storedKeywordChanging =>
    blk := [:x | self bump: x]
    self.items collect: blk

  storedKeywordReadOnly =>
    blk := [:x | self peek: x]
    self.items collect: blk

  storedBinaryReadOnly =>
    blk := [:x | self - x]
    self.items collect: blk

  nestedUnaryChanging =>
    self.items collect: [:x | #(1) collect: [:y | self bump]]

  nestedUnaryReadOnly =>
    self.items collect: [:x | #(1) collect: [:y | self peek]]

  nestedKeywordChanging =>
    self.items collect: [:x | #(1) collect: [:y | self bump: x]]

  nestedKeywordReadOnly =>
    self.items collect: [:x | #(1) collect: [:y | self peek: x]]

  nestedBinaryReadOnly =>
    self.items collect: [:x | #(1) collect: [:y | self - x]]

  branchUnaryChanging =>
    self.items collect: [:x | x > 0 ifTrue: [self bump] ifFalse: [0]]

  branchUnaryReadOnly =>
    self.items collect: [:x | x > 0 ifTrue: [self peek] ifFalse: [0]]

  branchKeywordChanging =>
    self.items collect: [:x | x > 0 ifTrue: [self bump: x] ifFalse: [0]]

  branchKeywordReadOnly =>
    self.items collect: [:x | x > 0 ifTrue: [self peek: x] ifFalse: [0]]

  branchBinaryReadOnly =>
    self.items collect: [:x | x > 0 ifTrue: [self - x] ifFalse: [0]]

  localCondInClosure => self each: [:x | self peekCond: x]

  localOnDoInClosure => self each: [:x | self peekOnDo: x]

  localEnsureInClosure => self each: [:x | self peekEnsure: x]

  localCondTwiceInClosure => self each: [:x | self peekCondTwice: x]

  enclosingLocalInClosure =>
    r := 7
    self.total > 100 ifTrue: [r := 8]
    blk := [:x | self peekCond: x]
    self each: blk
    r

  caughtInClosure => self each: [:x | [self bump] on: Error do: [:e | 0]]

  caughtInClosureSelector =>
    self each: [:x | [self bump] on: Error do: [:e | e kind]]

  inlineDoKeyword =>
    self.items do: [:x | self bump: x]
    self.total

  inlineDoUnary =>
    self.items do: [:x | self bump]
    self.total

  inlineBranchKeyword =>
    self.items isEmpty ifFalse: [self bump: 5]
    self.total
