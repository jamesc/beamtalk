// Fixture for BT-5191; see json_mapping_test.bt.

// Counts how often its class jsonMapping is built, in the caller's process
// dictionary (class methods without class variables run in the caller).
Value subclass: JsonMappedCounted
  uses: JsonMappable
  field: n = 1

  class jsonMapping -> JsonMapping =>
    builds :: Dynamic := ProcessDictionary at: #jsonMappedCountedBuilds ifAbsent: [0]
    ProcessDictionary at: #jsonMappedCountedBuilds put: builds + 1
    JsonMapping new |> mapField: #n
