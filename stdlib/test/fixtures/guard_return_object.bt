// BT-4415: GuardReturnObject — guard-style early returns (`cond ifTrue: [^v]` at a
// method's top level) compiled as direct returns.

Object subclass: GuardReturnObject

  class sign: x :: Integer =>
    x > 0 ifTrue: [^1]
    x < 0 ifTrue: [^-1]
    0

  class orDefault: x =>
    x ifNil: [^#default]
    x

  class describe: x =>
    x isNil ifFalse: [^"some"]
    "none"

  class local: x :: Integer =>
    y := x * 2
    y =:= 12 ifTrue: [^y] ifFalse: [y := y + 1]
    y + 100

  class sealed canon: x =>
    x isNil ifTrue: [^"nil"]
    x printString

  class classify: x =>
    x match: [
      0 -> ^#zero;
      _ -> #other
    ]

  // Untyped receivers: the condition goes through `beamtalk_guard_return`.
  class early: x =>
    x ifTrue: [^#early]
    #late

  class earlyIfFalse: x =>
    x ifFalse: [^#early]
    #late

  // BT-4998: `^` in both branches, as the method's last statement, on an
  // untyped receiver. Effect-free values.
  class both: x => x ifTrue: [^#yes] ifFalse: [^#no]

  class bothFalseFirst: x => x ifFalse: [^#no] ifTrue: [^#yes]

  class bothVars: x with: a with: b => x ifTrue: [^a] ifFalse: [^b]

  // Nested inside another inlined conditional's branch (tail position).
  class nested: x inner: y =>
    x ifTrue: [y ifTrue: [^#tt] ifFalse: [^#tf]] ifFalse: [^#f]

  // With an `ensure:` running around the conditional.
  class bothEnsure: x on: counter =>
    [x ifTrue: [^#yes] ifFalse: [^#no]] ensure: [counter bump: 0]
