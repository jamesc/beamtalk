// BT-3704 (ADR 0130 Phase 1), collapsed by BT-3768: the class-variable semantics
// matrix. Every row is written once here and runs against each spelling through
// the `subject` hook: class_var_semantics_open_test.bt (CvsOpen),
// class_var_semantics_sealed_test.bt (CvsSealed) and
// class_var_semantics_override_test.bt (CvsOverrideSub). The fixtures must differ
// as source (the ADR's matrix design), so each spelling is its own class with the
// same rows; a row missing from one of them fails here with does_not_understand.
// Each test asserts the ADR 0130 section 4/5 answer. Rows whose answer differed
// before ADR 0130 were pinned to the old answer and flipped by BT-3713; the
// loop, fold, loop-condition and nested ensure rows did not compile before
// ADR 0130 and were enabled by BT-3713.
//
// This class lives under fixtures/ so the test runner does not run it: only its
// concrete subclasses are test cases.

abstract TestCase subclass: ClassVarSemanticsMatrixTest

  // The spelling under test: a class with the rows of fixtures/cvs_open.bt.
  subject => self subclassResponsibility

  // The spelling's supervisor whose `class initialize:` hook writes `n`.
  initSubject => self subclassResponsibility

  // A selector the subject defines itself that answers `n`, for the
  // `performLocally:` snapshot row (performLocally: does not walk the
  // superclass chain).
  snapshotSelector => #n

  // ADR 0130 §4
  testTop => self assert: self subject rowTop equals: 2

  // ADR 0130 §4
  testArm =>
    self assert: (self subject rowArm: 1) equals: 1
    self assert: (self subject rowArm: 0) equals: 0

  // ADR 0130 §4
  testLetrecTimes => self assert: self subject rowTimes equals: 3

  // ADR 0130 §4
  testLetrecTimesLocal => self assert: self subject rowTimesLocal equals: 3

  // ADR 0130 §4
  testLetrecToDoLocal => self assert: self subject rowToDoLocal equals: 3

  // ADR 0130 §4
  testLetrecWhileLocal => self assert: self subject rowWhileLocal equals: 3

  // ADR 0130 §4 (BT-3694 shape)
  testLoopCondition => self assert: self subject rowLoopCondition equals: 3

  // ADR 0130 §4
  testFoldDo => self assert: self subject rowDo equals: 3

  // ADR 0130 §4
  testFoldCollect => self assert: self subject rowCollect equals: 3

  // ADR 0130 §4
  testFoldInject => self assert: self subject rowInject equals: 3

  // ADR 0130 §4
  testFoldDoThreaded => self assert: self subject rowDoLocal equals: 3

  // ADR 0130 §4
  testFoldCollectThreaded => self assert: self subject rowCollectLocal equals: 3

  // ADR 0130 §4
  testFoldInjectThreaded => self assert: self subject rowInjectLocal equals: 3

  // ADR 0130 §4 catch boundary
  testOnDoBodyDiscardsWriteBeforeRaise =>
    self assert: self subject rowOnBodyRaise equals: 0

  // ADR 0130 §4 catch boundary
  testOnDoBodyKeepsWriteWhenNoError =>
    self assert: self subject rowOnBodyOk equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoBodyKeepsWriteMadeBeforeTheRegion =>
    self assert: self subject rowOnBodyAfterWrite equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoBodyDiscardsWriteOfFailingSend =>
    self assert: self subject rowOnBodyViaSend equals: 0

  // ADR 0130 §4 catch boundary
  testOnDoHandlerKeepsItsWrite => self assert: self subject rowHandler equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoHandlerKeepsItsWriteBodyWriteDiscarded =>
    self assert: self subject rowHandlerAfterBodyWrite equals: 1

  // ADR 0130 §4 catch boundary
  testNonMatchingInnerOnDoWithEnsureBetween =>
    self assert: self subject rowNonMatchingInnerEnsure equals: 0

  // ADR 0130 §4 ensure is not a boundary
  testEnsureKeepsBothWrites => self assert: self subject rowEnsure equals: 2

  // ADR 0130 §4 ensure is not a boundary
  testEnsureCleanupWriteGoesWithTheError =>
    self assert: self subject rowEnsureRaise equals: 0

  // ADR 0130 §5 at home
  testBareBlock => self assert: self subject rowBare equals: 1

  // ADR 0130 §5 at home
  testStoredClosureWithinInvocationWrites =>
    self assert: self subject rowStoredWithin equals: 2

  // ADR 0130 §5 at home
  testStoredClosureWithinInvocationReadsLive =>
    self assert: self subject rowStoredReadWithin equals: 1

  // ADR 0130 §5 later invocation of the same class is at home
  testStoredClosureLaterInvocationWrites =>
    self subject reset
    self subject run: self subject makeBumper
    self assert: self subject n equals: 1

  // ADR 0130 §5 later invocation of the same class is at home
  testStoredClosureLaterInvocationReadsLive =>
    self subject reset
    b := self subject makeReader
    self subject bump
    self assert: (self subject run: b) equals: 1

  // ADR 0130 §5 abroad: captured read
  testClosureFromForeignProcessReadsCaptured =>
    self subject reset
    b := self subject makeReader
    self subject bump
    self assert: b value equals: 0

  // ADR 0130 §5 abroad: write raises
  // The error comes from the block's method-level read inside `bump`, which has no capture
  // (a block abroad reads only what its own literal captured); either way the kind is the
  // structured class_state_unreachable and nothing is written.
  testClosureFromForeignProcessWriteRaises =>
    self subject reset
    b := self subject makeBumper
    self should: [b value] raise: #class_state_unreachable
    self assert: self subject n equals: 0

  // ADR 0130 §5 carried synchronously: captured equals live
  testSyncBlockToOpenDriverReadsLive =>
    self assert: self subject rowSyncReadOpenDriver equals: 1

  // ADR 0130 §5 abroad: write raises
  testSyncBlockToOpenDriverWriteRaises =>
    self subject reset
    self should: [
      self subject rowSyncWriteOpenDriver
    ] raise: #class_state_unreachable
    self assert: self subject n equals: 0

  // ADR 0130 §5 direct-called class method is at home
  testSyncBlockToSealedDriverReadsLive =>
    self assert: self subject rowSyncReadSealedDriver equals: 1

  // ADR 0130 §5 direct-called class method is at home
  testSyncBlockToSealedDriverWrites =>
    self assert: self subject rowSyncWriteSealedDriver equals: 1

  // ADR 0130 §5 carried asynchronously: creation-time value
  testAsyncBlockToActorReadsCreationValue =>
    self assert: self subject rowAsyncRead equals: 0

  // ADR 0130 §5 abroad: write raises
  testAsyncBlockToActorWriteRaises =>
    self assert: self subject rowAsyncWrite equals: #class_state_unreachable
    self assert: self subject n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  testSyncDirectWriteToOpenDriverRaisesWriteError =>
    self subject reset
    self assertWriteAbroadRaises: [self subject rowSyncDirectWriteOpenDriver]
    self assert: self subject n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  testAsyncDirectWriteToActorRaisesWriteError =>
    self subject reset
    self assertWriteAbroadRaises: [self subject rowAsyncDirectWrite]
    self assert: self subject n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  // The closure is kept by the test across a later invocation of the class,
  // then run from the test's process.
  testStoredClosureDirectWriteRaisesWriteError =>
    self subject reset
    b := self subject makeWriter
    self subject reset
    self assertWriteAbroadRaises: [b value]
    self assert: self subject n equals: 0

  // ADR 0130 §5 abroad: a direct write raises the write error (BT-3760)
  testReturnedClosureDirectWriteRaisesWriteError =>
    self subject reset
    self assertWriteAbroadRaises: [self subject makeWriter value]
    self assert: self subject n equals: 0

  // ADR 0130 §5 control: the same direct-write block run from a later
  // invocation of the class is at home and writes live (BT-3760)
  testDirectWriteClosureLaterInvocationWrites =>
    self subject reset
    self subject run: self subject makeWriter
    self assert: self subject n equals: 5

  // ADR 0130 §5 runtime-owned snapshot
  testPerformLocallyReadsSnapshot =>
    self subject reset
    self subject bump
    self assert: (self subject performLocally: self snapshotSelector withArguments: #()) equals: 1

  // ADR 0130 §5 runtime-owned snapshot
  testPerformLocallyWriteRaises =>
    self subject reset
    self
      assert: ([
        self subject performLocally: #bump withArguments: #()
      ] on: Error do: [:e | e kind])
      equals: #class_state_read_only
    self assert: self subject n equals: 0

  // ADR 0130 §4 non-local return
  testOwnNlrKeepsWriteBeforeCaret =>
    self assert: self subject rowOwnNlr equals: 1
    self assert: self subject n equals: 1

  // ADR 0130 §4 non-local return
  testOwnNlrThroughEnsureKeepsBothWrites =>
    self assert: self subject rowOwnNlrEnsure equals: 7
    self assert: self subject n equals: 2

  // ADR 0130 §4 non-local return
  testForeignNlrThroughOpenDriverKeepsEarlierWrite =>
    self assert: self subject rowForeignNlrAfterWrite equals: 5
    self assert: self subject n equals: 1

  // ADR 0130 §4 non-local return
  testForeignNlrThroughSealedDriverKeepsWriteBeforeCaret =>
    self assert: self subject rowForeignNlrSealedDriver equals: 5
    self assert: self subject n equals: 1

  // ADR 0130 §5 runtime-owned snapshot
  testInitializeHookWriteRaises =>
    self initSubject reset
    self should: [self initSubject supervise] raise: #class_state_read_only
    self assert: self initSubject n equals: 0

  // ADR 0130 §5 (BT-3760): the write error, not the read error: kind
  // class_state_unreachable, a message saying n cannot be *written* from this
  // process, and the hint's remedy.
  assertWriteAbroadRaises: aBlock =>
    e := aBlock on: Error do: [:ex | ex]
    self assert: (e isKindOf: Error) equals: true
    self assert: e kind equals: #class_state_unreachable
    self assert: (e message includesSubstring: "class variable n cannot be written from this process") equals: true
    self assert: (e hint includesSubstring: "return the value and assign it there") equals: true
