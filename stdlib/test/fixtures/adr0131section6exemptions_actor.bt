// BT-3745 (ADR 0131 §6): the actor-instance-method shapes in which a block
// that writes an outer local still compiles, because codegen threads the
// write back. Each method is exactly the syntactic shape a codegen
// recognizer matches (see the EXEMPTION comments in
// crates/beamtalk-core/src/semantic_analysis/validators/local_threading.rs).
// adr0131section6exemptions_test.bt asserts each really threads the write;
// `section6_exemptions_match_codegen_shapes` (beamtalk-core) asserts this
// file compiles with no §6 error and that each near miss is rejected.

Actor subclass: Adr0131Section6ExemptionsActor

  // The callee must thread the block (BT-3755): a `sealed` method of this
  // class whose every use of the parameter is a direct `value` send.
  sealed ap: b => b value

  sealed apArg: b => b value: 5

  sealed apAssign: b =>
    r := b value
    r

  sealed apReturn: b => ^b value

  sealed apTwice: b =>
    b value
    b value

  sealed apCascade: b => b value: 1; value: 2

  // A bare block literal to a self-send, as a method-body statement
  // (`detect_tier2_self_send`).
  selfSendStatement =>
    t := 0
    self ap: [t := t + 1]
    t

  // ... as the value of a method-body assignment.
  selfSendAssign =>
    t := 0
    r := self
      ap: [
        t := t + 1
        7
      ]
    #[r, t]

  // ... as a method-body `^`.
  selfSendReturn =>
    t := 0
    ^self ap: [t := t + 1]

  // A stored block sent `value` as method-body statements
  // (`prescan_tier2_local_vars`, `is_tier2_value_call`).
  storedValue =>
    t := 0
    b := [t := t + 1]
    b value
    b value
    t

  // ... sent `value:` in a cascade.
  storedValueCascade =>
    t := 0
    b := [:n | t := t + n]
    b value: 1; value: 2
    t

  // The callee shapes above, each as a method-body statement self-send.
  calleeArg =>
    t := 0
    self apArg: [:x | t := t + x]
    t

  calleeAssign =>
    t := 0
    self apAssign: [t := t + 1]
    t

  calleeReturn =>
    t := 0
    self apReturn: [t := t + 1]
    t

  calleeTwice =>
    t := 0
    self apTwice: [t := t + 1]
    t

  calleeCascade =>
    t := 0
    self apCascade: [:x | t := t + x]
    t

  // The other callee shapes codegen threads (BT-3755,
  // `semantic_analysis::tier2_callee`): a `do:` loop whose body assigns the
  // invocation to a local bound before the loop, ...
  sealed apLoop: b =>
    last := nil
    #(1, 2, 3) do: [:e | last := b value: e]
    last

  // ... the block as the callable of a collection HOM (ADR 0128), ...
  sealed apOpaque: b => #(1, 2, 3) do: b

  sealed apOpaqueOperand: b => (#(1, 2, 3) collect: b) size

  sealed apOpaqueBranch: b =>
    4 > 3 ifTrue: [#(1, 2, 3) do: b]
    nil

  // ... and passed on to another sealed callee of the class.
  sealed apPassOn: b => self apTarget: b

  sealed apTarget: b => b value: 7

  calleeLoop =>
    t := 0
    self apLoop: [:x | t := t + x]
    t

  calleeOpaque =>
    t := 0
    self apOpaque: [:x | t := t + x]
    t

  calleeOpaqueOperand =>
    t := 0
    self apOpaqueOperand: [:x | t := t + x]
    t

  calleeOpaqueBranch =>
    t := 0
    self apOpaqueBranch: [:x | t := t + x]
    t

  calleePassOn =>
    t := 0
    self apPassOn: [:x | t := t + x]
    t

  // BT-3755: the opaque-callable fold nested below the method-body statement
  // (an argument of a self-send, an argument of a keyword send,
  // the receiver of a keyword send, two folds in one statement).
  sealed apNestArg: b => self apSink: (#(1, 2) collect: b)

  sealed apSink: xs => xs size

  sealed apNestKwArg: b => #(5, 6, 7, 8) at: (#(1, 2) inject: 0 into: b)

  sealed apNestRecv: b => (#(1, 2) collect: b) at: 1

  sealed apNestDeep: b =>
    (#(1, 2) collect: b) at: (#(1) collect: b) size

  calleeNestArg =>
    t := 0
    self apNestArg: [:x | t := t + x]
    t

  calleeNestKwArg =>
    t := 0
    self apNestKwArg: [:acc :x | t := t + x. acc + x]
    t

  calleeNestRecv =>
    t := 0
    self apNestRecv: [:x | t := t + x]
    t

  calleeNestDeep =>
    t := 0
    self apNestDeep: [:x | t := t + x]
    t
