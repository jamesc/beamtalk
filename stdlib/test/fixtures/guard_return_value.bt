// BT-4415: GuardReturnValue — guard-style early returns (`cond ifTrue: [^v]` at a
// method's top level) compiled as direct returns.

Value subclass: GuardReturnValue
  field: n :: Integer = 0

  clamp: x :: Integer =>
    x < 0 ifTrue: [^self]
    x =:= 9 ifTrue: [^self withN: 99]
    self withN: x

  // BT-4452: `x :: Integer` makes each comparison a bare BIF (a Boolean by
  // construction), so effectful returns, two-branch guards and a tail guard
  // compile as direct returns too.
  bounded: x :: Integer =>
    x < 0 ifTrue: [^self withN: 0]
    x > 100
      ifTrue: [
        @expect discarded_update
        self withN: 1
        ^self withN: 100
      ]
      ifFalse: [x]
    x >= 90 ifFalse: [^self withN: x]
    self withN: 90

  positiveOnly: x :: Integer => 0 < x ifTrue: [^self withN: x]

  // BT-4496: an `and:`/`or:` of Booleans by construction is a Boolean, so
  // the effectful guards on it compile as direct returns.
  outside: x :: Integer =>
    (x < 0 or: [x > 100]) ifTrue: [^self withN: 0]
    (x =:= 50 and: [x == 50]) ifTrue: [^self withN: 5] ifFalse: [self withN: x]
