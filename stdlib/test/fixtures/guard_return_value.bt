// BT-4415: GuardReturnValue — guard-style early returns (`cond ifTrue: [^v]` at a
// method's top level) compiled as direct returns.

Value subclass: GuardReturnValue
  field: n :: Integer = 0

  clamp: x :: Integer =>
    x < 0 ifTrue: [^self]
    x =:= 9 ifTrue: [^self withN: 99]
    self withN: x
