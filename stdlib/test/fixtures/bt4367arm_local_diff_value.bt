// BT-4367: differential fixture (value method). Each shape is written twice: at
// the method root (`...Root`, the proven producer path) and inside the arm of
// a conditional that writes no outer local (`...Arm:`, a plain `BranchArm`
// frame, BT-3911), where the loop or fold writes a local of the arm. The two
// must answer the same. Shapes: eight loop and fold kinds, each as a statement
// and as the whole value of an assignment, in an `ifTrue:ifFalse:` arm and an
// `ifNil:ifNotNil:` arm. Asserted in bt4367arm_local_diff_test.bt.

Value subclass: Bt4367ArmLocalDiffValue
  field: n = 0

  assign_inject_ifTrueRoot =>
    m := 0
    s := #(1, 2)
      inject: 0
      into: [:acc :e |
        m := m + e
        acc + e
      ]
    v := s
    v + m

  assign_inject_ifTrueArm: c =>
    c
      ifTrue: [
        m := 0
        s := #(1, 2)
          inject: 0
          into: [:acc :e |
            m := m + e
            acc + e
          ]
        v := s
        v + m
      ]
      ifFalse: [0]

  assign_inject_ifNilRoot =>
    m := 0
    s := #(1, 2)
      inject: 0
      into: [:acc :e |
        m := m + e
        acc + e
      ]
    v := s
    v + m

  assign_inject_ifNilArm: c =>
    c
      ifNil: [
        m := 0
        s := #(1, 2)
          inject: 0
          into: [:acc :e |
            m := m + e
            acc + e
          ]
        v := s
        v + m
      ]
      ifNotNil: [:x | 0]

  stmt_inject_ifTrueRoot =>
    m := 0
    #(1, 2)
      inject: 0
      into: [:acc :e |
        m := m + e
        acc + e
