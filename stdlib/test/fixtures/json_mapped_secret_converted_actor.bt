// Fixture for BT-5191; see json_mapping_test.bt.

// A converter on a secret slot is the explicit opt-out: it sees the value.
Actor subclass: JsonMappedSecretConvertedActor
  uses: JsonMappable
  state: token = "abcdef"

  class secretState -> List(Symbol) => #(#token)

  class jsonMapping -> JsonMapping =>
    JsonMapping new
      |> mapField: #token
         to: "token_length"
         using: [:v | v size]
