// BT-3639 / ADR 0129 Phase 0b: a class WITH `classState:` is never
// direct-call eligible, so its class methods keep running in the class
// gen_server process however they are reached.

sealed Object subclass: DirectDispatchStateful
  classState: hits = 0

  class sealed callerPid => Erlang erlang self

  class sealed bump =>
    self.hits := self.hits + 1
    self.hits
