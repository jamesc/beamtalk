// BT-3744 (ADR 0131 Phase 0a): the value-type probe shapes that do not
// compile today (see adr0131local_rebind_value.bt for the rest). Inert: the
// runner discovers only `.bt`. The phase that makes these compile drops the
// `.pending` suffix (and from adr0131local_rebind_pending_test.bt.pending).
// As in adr0131local_rebind_value.bt, o12/o13 pass the construct to the
// functional update `self withN:`, since a value type cannot write `self.n :=`.
//
//   o3, o12, o13, s2: erlc `unbound variable 'State'` (ADR 0131 §3)
//   o1, o2, o4-o10, s1, s7, s9, seq: ADR 0131 Phase 0 compile errors
//     (BT-3745: the allow-set error, or §6 for s1's `at:ifAbsent:` block)
//
// Every method here is rejected by an ADR 0131 diagnostic today;
// `adr0131_probe_matrix_pins` in beamtalk-core checks that.

Value subclass: Adr0131LocalRebindValuePending
  field: n = 0

  o3 =>
    t := 0
    r := (4 =:= 5 ifTrue: [2] ifFalse: [t := t + 1. 1]) + 1
    #[r, t]

  o12: c =>
    t := 0
    v := self withN: ((c ifTrue: [2] ifFalse: [t := t + 1. 1]) + 1)
    #[v n, t]

  o13: c =>
    t := 0
    v := self withN: (c ifTrue: [2] ifFalse: [t := t + 1. 1])
    #[v n, t]

  s2 =>
    t := 0
    r := #(1, 2) detect: [:x | x > 5] ifNone: [t := t + 1. 0]
    #[r, t]

  o1 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  o2 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] ensure: [t := t + 1]) + 1
    #[r, t]

  o4 =>
    t := 0
    r := (#(1, 2) collect: [:x | t := t + x]) size
    #[r, t]

  o5 =>
    t := 0
    v := self
      withN: ([
        t := t + 1
        1
      ] on: Error do: [:e | 0])
    #[v n, t]

  o6: cond =>
    t := 0
    cond
      ifTrue: [
        ^#[([
          t := t + 1
          1
        ] on: Error do: [:e | 0]), t]
      ]
    #[0, t]

  o7: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
      7
    ] on: Error do: [:x | 3]
    #[r, t]

  o8: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
    ] on: Error do: [:x | 3]
    #[r, t]

  // o9: o1's operand as the method's last expression.
  o9 =>
    t := 0
    ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1

  // o10: o1's operand as a `^` value inside an arm.
  o10: cond =>
    t := 0
    cond
      ifTrue: [
        ^([
          t := t + 1
          1
        ] on: Error do: [:e | 0]) + 1
      ]
    0

  s1 =>
    t := 0
    d := #{#a => 1}
    r := d
      at: #k
      ifAbsent: [
        t := t + 1
        0
      ]
    #[r, t]

  s7 =>
    t := 0
    r := nil
      ifNil: [
        t := t + 1
        1
      ]
    #[r, t]

  s9 =>
    t := 0
    r := (#(1, 2)
      reject: [:x |
        t := t + 1
        false
      ]) size
    #[r, t]

  seq =>
    t := 0
    r := t + ([
      t := t + 1
      1
    ] on: Error do: [:e | 0])
    #[r, t]

  // BT-3748 review: the §1a shape with the threading construct nested inside
  // the right operand (an argument of a send, the receiver of a binary send)
  // rather than the operand itself. Source order reads `t` first: #[1, 1].
  seqArg: flag =>
    t := 0
    r := t + (0 max: (flag ifTrue: [t := t + 1. 1] ifFalse: [0]))
    #[r, t]

  seqRecv: flag =>
    t := 0
    r := t + ((flag ifTrue: [t := t + 1. 1] ifFalse: [0]) + 0)
    #[r, t]

  // BT-3745 review: `^` of a list op answers the leaked `{3, StateAcc}`
  // tuple today (the implicit-last `vtLastInject` answers 3), so it is a
  // Phase 0 compile error.
  vtReturnInject =>
    t := 0
    ^#(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]

  // BT-3753: statement-position shapes that answered wrong, raised or failed
  // to compile before; each is an ADR 0131 Phase 0 compile error now.

  // A `do:` in a conditional arm.
  stArmDo: c =>
    t := 0
    c ifTrue: [#(1, 2) do: [:e | t := t + e]]
    t

  // A loop in a conditional arm.
  stArmWhile: c =>
    t := 0
    c ifTrue: [[t < 2] whileTrue: [t := t + 1]]
    t

  // `inject:into:` in a conditional arm.
  stArmInject: c =>
    t := 0
    c ifTrue: [
      #(1, 2) inject: 0 into: [:a :e |
        t := t + e
        a + e
      ]
    ]
    t

  // A `do:` in an `on:do:` body.
  stProtectedDo =>
    t := 0
    [
      #(1, 2) do: [:x | t := t + x]
      7
    ] on: Error do: [:e | 0]
    t

  // `eachWithIndex:` as a statement.
  stEachWithIndex =>
    t := 0
    #(1, 2) eachWithIndex: [:x :i | t := t + x]
    t

  // `do:separatedBy:` as a statement.
  stDoSeparatedBy =>
    t := 0
    #(1, 2) do: [:x | t := t + x] separatedBy: [t := t + 10]
    t

  // `keysAndValuesDo:` as a statement.
  stKeysAndValuesDo =>
    t := 0
    #{#a => 1, #b => 2} keysAndValuesDo: [:k :v | t := t + v]
    t

  // A conditional in a `whileTrue:` body (erlc `unbound variable` before).
  stLoopArm =>
    t := 0
    i := 0
    [i < 2] whileTrue: [
      i := i + 1
      i > 1 ifTrue: [t := t + 5]
    ]
    t

  // `detect:ifNone:` whose handler writes, as a statement.
  stDetectIfNone =>
    t := 0
    #(1, 2) detect: [:e | e > 5] ifNone: [t := t + 1]
    t
