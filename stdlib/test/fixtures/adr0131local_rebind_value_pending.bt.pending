// BT-3744 (ADR 0131 Phase 0a): the value-type probe shapes that do not
// compile today (see adr0131local_rebind_value.bt for the rest). Inert: the
// runner discovers only `.bt`. The phase that makes these compile drops the
// `.pending` suffix (and from adr0131local_rebind_pending_test.bt.pending).
// As in adr0131local_rebind_value.bt, o12/o13 pass the construct to the
// functional update `self withN:`, since a value type cannot write `self.n :=`.
//
//   o3, o12, o13, s2: erlc `unbound variable 'State'` (ADR 0131 §3)
//   o1, o2, o4-o10, s1, s7, s9, seq: ADR 0131 Phase 0 compile errors
//     (BT-3745: the allow-set error, or §6 for s1's `at:ifAbsent:` block)
//
// Every method here is rejected by an ADR 0131 diagnostic today;
// `adr0131_probe_matrix_pins` in beamtalk-core checks that.

Value subclass: Adr0131LocalRebindValuePending
  field: n = 0

  o3 =>
    t := 0
    r := (4 =:= 5 ifTrue: [2] ifFalse: [t := t + 1. 1]) + 1
    #[r, t]

  o12: c =>
    t := 0
    v := self withN: ((c ifTrue: [2] ifFalse: [t := t + 1. 1]) + 1)
    #[v n, t]

  o13: c =>
    t := 0
    v := self withN: (c ifTrue: [2] ifFalse: [t := t + 1. 1])
    #[v n, t]

  s2 =>
    t := 0
    r := #(1, 2) detect: [:x | x > 5] ifNone: [t := t + 1. 0]
    #[r, t]

  o1 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  o2 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] ensure: [t := t + 1]) + 1
    #[r, t]

  o4 =>
    t := 0
    r := (#(1, 2) collect: [:x | t := t + x]) size
    #[r, t]

  o5 =>
    t := 0
    v := self
      withN: ([
        t := t + 1
        1
      ] on: Error do: [:e | 0])
    #[v n, t]

  o6: cond =>
    t := 0
    cond
      ifTrue: [
        ^#[([
          t := t + 1
          1
        ] on: Error do: [:e | 0]), t]
      ]
    #[0, t]

  o7: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
      7
    ] on: Error do: [:x | 3]
    #[r, t]

  o8: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
    ] on: Error do: [:x | 3]
    #[r, t]

  // o9: o1's operand as the method's last expression.
  o9 =>
    t := 0
    ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1

  // o10: o1's operand as a `^` value inside an arm.
  o10: cond =>
    t := 0
    cond
      ifTrue: [
        ^([
          t := t + 1
          1
        ] on: Error do: [:e | 0]) + 1
      ]
    0

  s1 =>
    t := 0
    d := #{#a => 1}
    r := d
      at: #k
      ifAbsent: [
        t := t + 1
        0
      ]
    #[r, t]

  s7 =>
    t := 0
    r := nil
      ifNil: [
        t := t + 1
        1
      ]
    #[r, t]

  s9 =>
    t := 0
    r := (#(1, 2)
      reject: [:x |
        t := t + 1
        false
      ]) size
    #[r, t]

  seq =>
    t := 0
    r := t + ([
      t := t + 1
      1
    ] on: Error do: [:e | 0])
    #[r, t]

  // BT-3745 review: `^` of a list op answers the leaked `{3, StateAcc}`
  // tuple today (the implicit-last `vtLastInject` answers 3), so it is a
  // Phase 0 compile error.
  vtReturnInject =>
    t := 0
    ^#(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]
