// BT-3744 (ADR 0131 Phase 0a): the value-type probe shapes that do not
// compile today (see adr0131local_rebind_value.bt for the rest). Inert: the
// runner discovers only `.bt`. The phase that makes these compile drops the
// `.pending` suffix (and from adr0131local_rebind_pending_test.bt.pending).
// As in adr0131local_rebind_value.bt, o12/o13 pass the construct to the
// functional update `self withN:`, since a value type cannot write `self.n :=`.
//
//   o3, o12, o13: erlc `unbound variable 'State'` (ADR 0131 §3)
//   o1, o2, o5-o10, s7, seq: ADR 0131 Phase 0 compile errors
//     (BT-3745: the allow-set error)
//   (s1, `Dictionary at:ifAbsent:` whose handler writes, moved to the
//   compiled fixture with BT-3798, ADR 0131 Phase 2d.)
//
// (stLoopArm, a conditional in a `whileTrue:` body, moved to the compiled
// fixture with BT-3822, ADR 0131 Phase 3c.)
//
// Every method here is rejected by an ADR 0131 diagnostic today;
// `adr0131_probe_matrix_pins` in beamtalk-core checks that.

Value subclass: Adr0131LocalRebindValuePending

  field: n = 0

  // BT-3753: statement-position shapes that answered wrong, raised or failed
  // to compile before; each is an ADR 0131 Phase 0 compile error now.

  // `eachWithIndex:` as a statement.
  stEachWithIndex =>
    t := 0
    #(1, 2) eachWithIndex: [:x :i | t := t + x]
    t

  // `do:separatedBy:` as a statement.
  stDoSeparatedBy =>
    t := 0
    #(1, 2) do: [:x | t := t + x] separatedBy: [t := t + 10]
    t

