// BT-3864 (ADR 0131 stopgap): the shapes of
// adr0131nested_assign_value_pending.bt.pending with each value-position local
// assignment hoisted into its own statement, the rewrite the
// `ValuePositionLocalAssignment` error names. They answer the correct values
// today (stdlib/test/adr0131nested_assign_test.bt); the class and actor
// columns are adr0131nested_assign_{class,actor}.bt.

Value subclass: Adr0131NestedAssignValue

  rootPlain =>
    t := 0
    t := t + 1
    x := t + 1
    #[t, x]

  rootLiteral =>
    t := 0
    before := t
    t := 7
    #[before, t, t]

  doPlain =>
    t := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 0
      ]
    t

  rootIf =>
    t := 0
    u := 0
    t := t + 1
    t > 0 ifTrue: [u := 9]
    #[t, u]

  doIf =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
      ]
    #[t, u]

  doIfElse =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 1 ifTrue: [u := u + 9] ifFalse: [u := u + 1]
      ]
    #[t, u]

  doAnd =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 1
          and: [
            u := 9
            true
          ]
      ]
    #[t, u]

  doIfFalse =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 5 ifFalse: [u := u + 1]
      ]
    #[t, u]

  toDoIf =>
    t := 0
    u := 0
    1
      to: 2
      do: [:x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
      ]
    #[t, u]

  timesIf =>
    t := 0
    u := 0
    2
      timesRepeat: [
        t := t + 1
        t > 1 ifTrue: [u := 9]
      ]
    #[t, u]

  whileIf =>
    t := 0
    u := 0
    i := 0
    [i < 2]
      whileTrue: [
        t := t + 1
        t > 1 ifTrue: [u := 9]
        i := i + 1
      ]
    #[t, u]

  collectIf =>
    t := 0
    u := 0
    r := #(1, 2)
      collect: [:x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
        x
      ]
    #[t, u, r]

  injectIf =>
    t := 0
    u := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
        a + x
      ]
    #[t, u, r]
