// BT-3704 (ADR 0130 Phase 1): rows of the open spelling that do not compile
// today. They are written in the shape ADR 0130 makes legal and kept out of the
// build with the `.pending` suffix (the BUnit runner only discovers `.bt`
// files). BT-3713 (the Phase 3 flip) enables them by dropping the suffix from this
// file, its sibling fixtures and its test file.

Object subclass: CvsOpenPending
  classState: n = 0

  class bump => self.n := self.n + 1

  class n => self.n


  class reset => self.n := 0


  class boom =>
    self bump
    1 / 0


  class rowTimes =>
    self reset
    3 timesRepeat: [self bump]
    self.n


  class rowLoopCondition =>
    self reset
    [self n < 3] whileTrue: [self bump]
    self.n


  class rowDo =>
    self reset
    #(1, 2, 3) do: [:x | self bump]
    self.n


  class rowCollect =>
    self reset
    #(1, 2, 3) collect: [:x | self bump]
    self.n


  class rowInject =>
    self reset
    #(1, 2, 3) inject: 0 into: [:a :x |
      self bump
      a + x
    ]
    self.n


  class rowNonMatchingInnerEnsure =>
    self reset
    [
      [
        [
          self bump
          1 / 0
        ] on: TypeError do: [:e | nil]
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n


  class rowEnsureRaise =>
    self reset
    [
      [
        self bump
        1 / 0
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n


  class rowOwnNlrEnsure =>
    self reset
    [
      [
        self bump
        ^7
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    99

