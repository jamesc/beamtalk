// BT-3965 fixture: static supervisor whose slow-stopping child gets less
// shutdown time than its terminate: needs, so it is killed. See
// stdlib/test/supervision_shutdown_test.bt.

Supervisor subclass: Bt3965ImpatientSup

  strategy -> #oneForOne | #oneForAll | #restForOne => #oneForOne

  childSpecs -> List =>
    spec := (Bt3965SlowStopper supervisionSpec withArgs: #{
      #tableName => #bt3965Shutdown
    }) withShutdown: 50
    #(spec)
