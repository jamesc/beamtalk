// BT-4415: GuardReturnActor — guard-style early returns (`cond ifTrue: [^v]` at a
// method's top level) compiled as direct returns.

Actor subclass: GuardReturnActor
  state: count :: Integer = 0

  bump: x :: Integer =>
    self.count := self.count + 1
    x > 10 ifTrue: [^#big]
    self.count := self.count + x
    #small

  early: x =>
    x ifTrue: [^#early]
    self.count := self.count + 1
    #late

  count => self.count

  // BT-4452: a typed comparison guard whose returning branch writes state.
  bumpBig: x :: Integer =>
    x > 10
      ifTrue: [
        self.count := self.count + 100
        ^self.count
      ]
    self.count := self.count + x
    self.count
