// Fixture for BT-5191; see json_mapping_test.bt.

// Two of these linked to each other form an asJson cycle.
Actor subclass: JsonMappedLinkActor
  uses: JsonMappable
  state: other = nil

  class jsonMapping -> JsonMapping => JsonMapping new |> mapField: #other

  link: anActor => self.other := anActor
