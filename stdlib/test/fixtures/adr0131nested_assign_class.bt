// BT-3860 (ADR 0131): the shapes of adr0131nested_assign_value_pos_class.bt with
// each value-position local assignment hoisted into its own statement. They
// answer the same values (stdlib/test/adr0131nested_assign_test.bt, against
// adr0131nested_assign_value_position_test.bt); the other columns are
// adr0131nested_assign_{class,value,actor}.bt.

Object subclass: Adr0131NestedAssignClass

  class rootPlain =>
    t := 0
    t := t + 1
    x := t + 1
    #[t, x]

  class rootLiteral =>
    t := 0
    before := t
    t := 7
    #[before, t, t]

  class doPlain =>
    t := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 0
      ]
    t

  class rootIf =>
    t := 0
    u := 0
    t := t + 1
    t > 0 ifTrue: [u := 9]
    #[t, u]

  class doIf =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
      ]
    #[t, u]

  class doIfElse =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 1 ifTrue: [u := u + 9] ifFalse: [u := u + 1]
      ]
    #[t, u]

  class doAnd =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 1
          and: [
            u := 9
            true
          ]
      ]
    #[t, u]

  class doIfFalse =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        t := t + 1
        t > 5 ifFalse: [u := u + 1]
      ]
    #[t, u]

  class toDoIf =>
    t := 0
    u := 0
    1
      to: 2
      do: [:x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
      ]
    #[t, u]

  class timesIf =>
    t := 0
    u := 0
    2
      timesRepeat: [
        t := t + 1
        t > 1 ifTrue: [u := 9]
      ]
    #[t, u]

  class whileIf =>
    t := 0
    u := 0
    i := 0
    [i < 2]
      whileTrue: [
        t := t + 1
        t > 1 ifTrue: [u := 9]
        i := i + 1
      ]
    #[t, u]

  class collectIf =>
    t := 0
    u := 0
    r := #(1, 2)
      collect: [:x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
        x
      ]
    #[t, u, r]

  class injectIf =>
    t := 0
    u := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        t > 1 ifTrue: [u := 9]
        a + x
      ]
    #[t, u, r]
