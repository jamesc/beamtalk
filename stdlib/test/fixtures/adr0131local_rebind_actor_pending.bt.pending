// BT-3745 (ADR 0131 Phase 0b): the actor-instance-method probe shapes that
// are compile errors today (see adr0131local_rebind_actor.bt for the rest).
// Inert: the runner discovers only `.bt`. The phase that makes a shape
// compile moves it back (and its test from
// adr0131local_rebind_pending_test.bt.pending).
//
//   o1-o4, o6-o10, o12, s2, s9, seq: the ADR 0131 Phase 0 allow-set error
//   s1: ADR 0131 §6 (`at:ifAbsent:` cannot return the block's write)
//
// Every method here is rejected by an ADR 0131 diagnostic today;
// `adr0131_probe_matrix_pins` in beamtalk-core checks that.

Actor subclass: Adr0131LocalRebindActorPending
  state: n = 0

  o1 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  o2 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] ensure: [t := t + 1]) + 1
    #[r, t]

  o3 =>
    t := 0
    r := (4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]) + 1
    #[r, t]

  o4 =>
    t := 0
    r := (#(1, 2) collect: [:x | t := t + x]) size
    #[r, t]

  o6: cond =>
    t := 0
    cond
      ifTrue: [
        ^#[([
          t := t + 1
          1
        ] on: Error do: [:e | 0]), t]
      ]
    #[0, t]

  o7: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
      7
    ] on: Error do: [:x | 3]
    #[r, t]

  o8: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
    ] on: Error do: [:x | 3]
    #[r, t]

  // o9: o1's operand as the method's last expression.
  o9 =>
    t := 0
    ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1

  // o10: o1's operand as a `^` value inside an arm.
  o10: cond =>
    t := 0
    cond
      ifTrue: [
        ^([
          t := t + 1
          1
        ] on: Error do: [:e | 0]) + 1
      ]
    0

  o12: c =>
    t := 0
    self.n := (c
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]) + 1
    #[self.n, t]

  s1 =>
    t := 0
    d := #{#a => 1}
    r := d
      at: #k
      ifAbsent: [
        t := t + 1
        0
      ]
    #[r, t]

  s2 =>
    t := 0
    r := #(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        0
      ]
    #[r, t]

  s9 =>
    t := 0
    r := (#(1, 2)
      reject: [:x |
        t := t + 1
        false
      ]) size
    #[r, t]

  seq =>
    t := 0
    r := t + ([
      t := t + 1
      1
    ] on: Error do: [:e | 0])
    #[r, t]

  // BT-3753: statement-position shapes that answered wrong, raised or failed
  // to compile before; each is an ADR 0131 Phase 0 compile error now.

  // A loop in a conditional arm.
  stArmWhile: c =>
    t := 0
    c ifTrue: [[t < 2] whileTrue: [t := t + 1]]
    t

  // A `do:` in an `on:do:` body.
  stProtectedDo =>
    t := 0
    [
      #(1, 2) do: [:x | t := t + x]
      7
    ] on: Error do: [:e | 0]
    t

  // `detect:ifNone:` whose handler writes, as a statement.
  stDetectIfNone =>
    t := 0
    #(1, 2) detect: [:e | e > 5] ifNone: [t := t + 1]
    t
