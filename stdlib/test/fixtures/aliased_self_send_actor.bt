// BT-1325: Fixture actor for testing aliased self-send (Layer 1).

Actor subclass: AliasedSelfSendActor
  state: x = 0
  state: y = 0

  // Alias self and read fieldNames via the alias
  aliasedFieldNames =>
    other := self
    other fieldNames

  // Alias self and read a field via the alias
  aliasedFieldAt =>
    other := self
    other fieldAt: #x

  // Alias self and mutate a field via the alias, then read back via alias
  aliasedFieldAtPut =>
    other := self
    other fieldAt: #x put: 42
    other fieldAt: #x

  // Alias self and call a user-defined method via the alias
  aliasedUserMethod =>
    other := self
    other getValue

  // Read the current x value
  getValue => self.x

  // Run a block after writing x, so a `^` in it must keep the write
  run: aBlock =>
    self.x := 5
    aBlock value

  // BT-4525: a `^` in a block run through the compiled self-send
  directNonLocalReturn =>
    self run: [^3]
    99

  // BT-4525: the same through an aliased self-send (Layer 1 self_dispatch)
  aliasedNonLocalReturn =>
    other := self
    other run: [^3]
    99
