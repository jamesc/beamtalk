// BT-1325: Fixture actor for testing aliased self-send (Layer 1).

Actor subclass: AliasedSelfSendActor
  state: x = 0
  state: y = 0

  // Alias self and read fieldNames via the alias
  aliasedFieldNames =>
    other := self
    other fieldNames

  // Alias self and read a field via the alias
  aliasedFieldAt =>
    other := self
    other fieldAt: #x

  // BT-3998: a state-changing send to an alias of self (`other fieldAt: #x
  // put: 42`, `other setX: 1`, any user method) is a compile error, since the
  // change is lost when the message ends; see
  // tests/repl-protocol/cases/adr0133_escaping_block.btscript. ADR 0137
  // (BT-4006) makes alias writes correct. A read-only user method is
  // rejected conservatively too.

  // Read the current x value
  getValue => self.x
