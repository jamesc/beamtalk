// BT-3999: `whileTrue:`/`whileFalse:` loops whose condition sends to `self`
// and whose body writes no outer local, in an actor method (the control: the
// condition's self-send threads the actor `State`). See
// stdlib/test/bt3999while_self_send_condition_test.bt.

Actor subclass: Bt3999WhileSelfSendActor
  state: polls = 0

  done => false

  isAlive: n => n > 0

  // A self-send that changes state: the loop must see each new value.
  pollAgain =>
    self.polls := self.polls + 1
    self.polls < 3

  emptyBody =>
    [self done] whileTrue: [nil]
    #ok

  keywordCondition =>
    [self isAlive: 0] whileTrue: [nil]
    #ok

  localArgument =>
    n := 0
    [self isAlive: n] whileTrue: [Timer sleep: 10]
    #ok

  andTrue =>
    n := 0
    [(self isAlive: n) and: [true]] whileTrue: [Timer sleep: 10]
    #ok

  andDeadline =>
    n := 0
    deadline := Time nowMs + 50
    [
      (self isAlive: n) and: [Time nowMs < deadline]
    ] whileTrue: [Timer sleep: 10]
    #ok

  statefulCondition =>
    [self pollAgain] whileTrue: [nil]
    self.polls
