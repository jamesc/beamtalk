// BT-3666: the base class declares no `classState:`, yet an override in a
// subclass that does must have its class-variable write kept. See
// self_send_override_test.bt.

Object subclass: SsoNoVarsBase

  class foo -> Integer => 1

  class bar -> Integer => self foo
