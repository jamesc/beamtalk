// A callable that answers only `valueWithArguments:` (no `value`, `value:`,
// ...), so `b valueWithArguments: xs` in a class method must send it
// `valueWithArguments:` itself. Used by class_method_callable_test.bt.

Value subclass: ClassMethodArgsOnlyCallable

  valueWithArguments: xs => xs size
