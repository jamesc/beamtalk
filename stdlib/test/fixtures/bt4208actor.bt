// BT-4208 fixtures: `self error:` inside a block body (an `on:do:` receiver
// or a `do:` body) in a Server, a plain Actor and a value class, reached
// from a sync method, a cast and (Server) `handleInfo:`.
// See stdlib/test/self_error_in_block_test.bt.

Actor subclass: Bt4208Actor
  state: last = nil

  caught => [self error: "x"] on: Error do: [:e | e message]

  caughtInDo =>
    [#(1, 2) do: [:_ | self error: "x"]] on: Error do: [:e | e message]

  uncaughtInDo => #(1, 2) do: [:_ | self error: "x"]

  castCaught => self.last := [self error: "x"] on: Error do: [:e | e message]

  last => self.last

  // `super error:` inside a block runs through the actor-state cell's
  // super send (beamtalk_actor_state:super_send/5).
  superCaught => [super error: "x"] on: Error do: [:e | e message]
