// BT-3958 fixture: supervises one FailingHandleInfoServer, restarted when a
// handleInfo: error crashes it (ADR 0134). See
// stdlib/test/server_handle_info_test.bt.

Supervisor subclass: FailingHandleInfoSup

  strategy -> #oneForOne | #oneForAll | #restForOne => #oneForOne

  childSpecs -> List =>
    #(FailingHandleInfoServer supervisionSpec withRestart: #permanent)
