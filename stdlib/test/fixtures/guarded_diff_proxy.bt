// BT-4292: a Value class answering every unknown selector through
// `doesNotUnderstand:args:`.

Value subclass: GuardedDiffProxy
  field: tag :: Symbol = #proxy

  doesNotUnderstand: selector args: arguments =>
    #(#proxied, selector, arguments)
