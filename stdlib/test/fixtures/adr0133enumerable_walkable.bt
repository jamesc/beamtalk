// BT-3903 (ADR 0133 Phase 1): the Smalltalk idiom "define `do:`, inherit the
// rest" as a package-local trait. A user package cannot `uses:` the stdlib's
// own `Enumerable` today (only the stdlib build carries stdlib protocol
// definitions; BT-3915), and `Enumerable` requires `elements` rather than
// `do:` anyway, so this trait is the shape ADR 0133 § Consequences describes:
// one required `do:`, and the iteration messages provided on top of it, each
// a block literal sent with `self do:` that writes the provision's own local.
// Users: adr0133enumerable_{forwarding,hand_walk,own_any}.bt.

Protocol define: Adr0133EnumerableWalkable
  /// Required: evaluate `block` with each element, in order.
  do: block -> Object

  inject: initial into: block =>
    acc := initial
    self do: [:x | acc := block value: acc value: x]
    acc

  collect: block =>
    out := #()
    self do: [:x | out := out add: (block value: x)]
    out

  select: block =>
    out := #()
    self do: [:x | (block value: x) ifTrue: [out := out add: x]]
    out

  detect: block ifNone: noneBlock =>
    self do: [:x | (block value: x) ifTrue: [^x]]
    noneBlock value

  anySatisfy: block =>
    self do: [:x | (block value: x) ifTrue: [^true]]
    false
