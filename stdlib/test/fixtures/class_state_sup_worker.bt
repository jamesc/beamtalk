// BT-3407: Worker actor for classState visibility test — see
// stdlib/test/fixtures/class_state_sup_app.bt for the Supervisor and full
// context.

Actor subclass: ClassStateSupWorker
  state: label :: String = ""

  class start: label :: String -> ClassStateSupWorker =>
    self spawnWith: #{#label => label}

  label -> String => self.label
