// BT-3965 fixture: DynamicSupervisor whose `childShutdown` overrides
// Bt3965CappedStopper's own 50 ms with 10 s. See
// stdlib/test/supervision_shutdown_test.bt.

DynamicSupervisor(Bt3965CappedStopper) subclass: Bt3965OverridePool

  class childClass => Bt3965CappedStopper

  class childShutdown -> Integer => 10000
