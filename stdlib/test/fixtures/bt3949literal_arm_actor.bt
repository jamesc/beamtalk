// BT-3949: a self-call `collect:` (or a fold whose block writes a field) is a
// construct that writes no outer local but threads the actor's `State`, so it
// compiles to a `{Value, State}` carrier. Written as an operand of a literal
// or a keyword argument inside an arm of a construct that writes no outer
// local (an `ifTrue:`/`ifFalse:` arm, a `match:` arm), it is a producer of
// that arm's frame: the operand is the fold's value, never its carrier, and
// the fold's `State` survives the arm. The columns are
// bt3949literal_arm_{class,value,actor}.bt; the expected answers are in
// stdlib/test/bt3949literal_arm_test.bt.

Actor subclass: Bt3949LiteralArmActor
  state: flag :: Object = nil
  state: hits = 0

  wrap: x => x * 10

  hits => self.hits

  // The issue's repro.
  inBranchMapLiteral =>
    data := self.flag isNil ifTrue: [
      #{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])}
    ] ifFalse: [#{}]
    data at: "xs"

  mapIf: flag =>
    data := flag ifTrue: [
      #{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])}
    ] ifFalse: [#{"xs" => #()}]
    data at: "xs"

  arrayIf: flag =>
    data := flag ifTrue: [
      #[0, (#(1, 2) asList collect: [:s | self wrap: s])]
    ] ifFalse: [#[0, #()]]
    data at: 2

  keywordIf: flag =>
    data := flag ifTrue: [
      #{} at: "xs" put: (#(1, 2) asList collect: [:s | self wrap: s])
    ] ifFalse: [#{"xs" => #()}]
    data at: "xs"

  mapIfFalse: flag =>
    data := flag ifTrue: [
      #{"xs" => #()}
    ] ifFalse: [#{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])}]
    data at: "xs"

  mapMatch: x =>
    data := x match: [
      1 -> #{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])};
      _ -> #{"xs" => #()}
    ]
    data at: "xs"

  arrayMatch: x =>
    data := x match: [
      1 -> #[0, (#(1, 2) asList collect: [:s | self wrap: s])];
      _ -> #[0, #()]
    ]
    data at: 2

  keywordMatch: x =>
    data := x match: [
      1 -> (#{} at: "xs" put: (#(1, 2) asList collect: [:s | self wrap: s]));
      _ -> #{"xs" => #()}
    ]
    data at: "xs"

  // A fold whose block writes a field: its `State` (the field write) must
  // survive the arm, and its value must be the fold's.
  fieldFoldIf: flag =>
    data := flag
      ifTrue: [
        #{"xs" => (#(1, 2) asList
            collect: [:s |
              self.hits := self.hits + s
              s
            ])}
      ]
      ifFalse: [#{"xs" => #()}]
    #[data at: "xs", self.hits]

  fieldFoldMatch: x =>
    data := x match: [
      1 -> #[(#(1, 2) asList
        collect: [:s |
          self.hits := self.hits + s
          s
        ])];
      _ -> #[#()]
    ]
    #[data at: 1, self.hits]
