// BT-3666: template-method fixture. BT-4317: `Base bar` binds `self` to Base
// (a class literal always denotes that class), so its nested `self foo` runs
// Base's `foo` even when `baz` runs for SsoNestedSub. See
// self_send_override_test.bt.

Object subclass: SsoNestedBase

  class foo -> Integer => 1

  class bar -> Integer => self foo

  class baz -> Integer => SsoNestedBase bar

  class sealed qux -> Integer => self foo

  class viaSealed -> Integer => self qux
