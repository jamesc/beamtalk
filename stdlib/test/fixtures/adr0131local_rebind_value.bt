// BT-3744 (ADR 0131 Phase 0a): the value-type (instance method of a `Value subclass:`) column of the ADR 0131 probe
// matrix. Each method is one probe shape, named after its row in the ADR's
// tables (o1-o13: operand position; s1-s9: assign-RHS and statement
// position; `seq`: the §1a sequencing shape; `tryDo*`: the `Result tryDo:`
// failure the ADR's Context describes). Each starts from `t := 0` and uses the
// ADR's body (laid out by `beamtalk fmt`); it answers `#[r, t]` (or `#[self.n, t]` for a field
// write, or the one value the ADR expects). A value type cannot write
// `self.n :=` (ADR 0042, a hard compile error), so o5/o12/o13 pass the same
// construct to the functional update `self withN:` and answer `#[v n, t]`. See
// stdlib/test/adr0131local_rebind_test.bt for the expected answers.
//
// The shapes that do not compile in a value-type method today (o3, o12, o13, s2)
// are in adr0131local_rebind_value_pending.bt.pending, so this module compiles.

Value subclass: Adr0131LocalRebindValue
  field: n = 0

  o1 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  o2 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] ensure: [t := t + 1]) + 1
    #[r, t]

  o4 =>
    t := 0
    r := (#(1, 2) collect: [:x | t := t + x]) size
    #[r, t]

  o5 =>
    t := 0
    v := self
      withN: ([
        t := t + 1
        1
      ] on: Error do: [:e | 0])
    #[v n, t]

  o6: cond =>
    t := 0
    cond
      ifTrue: [
        ^#[([
          t := t + 1
          1
        ] on: Error do: [:e | 0]), t]
      ]
    #[0, t]

  o7: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
      7
    ] on: Error do: [:x | 3]
    #[r, t]

  o8: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
    ] on: Error do: [:x | 3]
    #[r, t]

  // o9: o1's operand as the method's last expression.
  o9 =>
    t := 0
    ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1

  // o10: o1's operand as a `^` value inside an arm.
  o10: cond =>
    t := 0
    cond
      ifTrue: [
        ^([
          t := t + 1
          1
        ] on: Error do: [:e | 0]) + 1
      ]
    0

  o11 =>
    t := 0
    4 =:= 5 ifFalse: [t := t + 1]
    a := t
    [t := t + 1] ensure: [nil]
    #[a, t]

  s1 =>
    t := 0
    d := #{#a => 1}
    r := d
      at: #k
      ifAbsent: [
        t := t + 1
        0
      ]
    #[r, t]

  s3 =>
    t := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]
    #[r, t]

  s4 =>
    t := 0
    b := [t := t + 1]
    b value
    t

  s5 =>
    t := 0
    r := 4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]
    #[r, t]

  s6 =>
    t := 0
    r := (Erlang lists)
      map: [:x |
        t := t + 1
        x
      ]
      with: #(1)
    #[r, t]

  s7 =>
    t := 0
    r := nil
      ifNil: [
        t := t + 1
        1
      ]
    #[r, t]

  s8 =>
    t := 0
    #(1, 2) do: [:x | t := t + x]
    t

  s9 =>
    t := 0
    r := (#(1, 2)
      reject: [:x |
        t := t + 1
        false
      ]) size
    #[r, t]

  seq =>
    t := 0
    r := t + ([
      t := t + 1
      1
    ] on: Error do: [:e | 0])
    #[r, t]

  tryDoRaises =>
    t := 0
    r := (Result
      tryDo: [
        t := t + 1
        1 / 0
      ]) isError
    #[r, t]

  tryDoStatement =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        1
      ]
    t
