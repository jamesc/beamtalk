// BT-3744 (ADR 0131 Phase 0a): the value-type (instance method of a `Value subclass:`) column of the ADR 0131 probe
// matrix. Each method is one probe shape, named after its row in the ADR's
// tables (o1-o13: operand position; s1-s9: assign-RHS and statement
// position; `seq`: the §1a sequencing shape; `tryDo*`: the `Result tryDo:`
// failure the ADR's Context describes). Each starts from `t := 0` and uses the
// ADR's body (laid out by `beamtalk fmt`); it answers `#[r, t]` (or `#[self.n, t]` for a field
// write, or the one value the ADR expects). A value type cannot write
// `self.n :=` (ADR 0042, a hard compile error), so o5/o12/o13 pass the same
// construct to the functional update `self withN:` and answer `#[v n, t]`. See
// stdlib/test/adr0131local_rebind_test.bt for the expected answers.
//
// The shapes that do not compile in a value-type method today are in
// adr0131local_rebind_value_pending.bt.pending, so this module compiles: o3,
// o12, o13 and s2 (codegen failures before BT-3745), and o1, o2, o5-o10,
// s7 and seq (ADR 0131 Phase 0 compile errors since BT-3745). o4, s9 and
// vtReturnInject moved here when ADR 0131 Phase 2 (BT-3749) made loops and
// folds local-threading producers. s4 is a permanent ADR 0131 §6 error and is
// pinned only in the Rust tests.

Value subclass: Adr0131LocalRebindValue
  field: n = 0

  o11 =>
    t := 0
    4 =:= 5 ifFalse: [t := t + 1]
    a := t
    [t := t + 1] ensure: [nil]
    #[a, t]

  s3 =>
    t := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]
    #[r, t]

  s5 =>
    t := 0
    r := 4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]
    #[r, t]

  s6 =>
    t := 0
    r := (Erlang lists)
      map: [:x |
        t := t + 1
        x
      ]
      with: #(1)
    #[r, t]

  s8 =>
    t := 0
    #(1, 2) do: [:x | t := t + x]
    t

  tryDoRaises =>
    t := 0
    r := (Result
      tryDo: [
        t := t + 1
        1 / 0
      ]) isError
    #[r, t]

  tryDoStatement =>
    t := 0
    Result
      tryDo: [
        t := t + 1
        1
      ]
    t

  // BT-3745 review: the implicit-last form of value-type `^#(1, 2) inject:
  // ...` (which leaks its tuple and is pending). Answers 3.
  vtLastInject =>
    t := 0
    #(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]

  // BT-3753: `[...] value` as a statement answers right in a value-type
  // method (unlike a class method, where it is a Phase 0 compile error).
  stBlockValue =>
    t := 0
    [t := t + 1] value
    t

  o4 =>
    t := 0
    r := (#(1, 2) collect: [:x | t := t + x]) size
    #[r, t]

  s9 =>
    t := 0
    r := (#(1, 2)
      reject: [:x |
        t := t + 1
        false
      ]) size
    #[r, t]

  // BT-3745 review: `^` of a list op answered the leaked `{3, StateAcc}`
  // tuple (the implicit-last `vtLastInject` answered 3). ADR 0131 Phase 2
  // (BT-3749) lowers it as a producer, so it answers 3 too.
  vtReturnInject =>
    t := 0
    ^#(1, 2)
      inject: 0
      into: [:a :x |
        t := t + 1
        a + x
      ]

  // BT-3798 (ADR 0131 Phase 2d): `Dictionary at:ifAbsent:` whose handler writes.
  s1 =>
    t := 0
    d := #{#a => 1}
    r := d
      at: #k
      ifAbsent: [
        t := t + 1
        0
      ]
    #[r, t]

  // BT-3794 (ADR 0131 Phase 2c): `detect:ifNone:` whose handler writes.
  s2 =>
    t := 0
    r := #(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        0
      ]
    #[r, t]

  stDetectIfNone =>
    t := 0
    #(1, 2) detect: [:e | e > 5] ifNone: [t := t + 1]
    t

  // ADR 0131 Phase 3 (BT-3738): conditionals as local-threading producers
  o3 =>
    t := 0
    r := (4 =:= 5
      ifTrue: [2]
      ifFalse: [
        t := t + 1
        1
      ]) + 1
    #[r, t]

  o12: c =>
    t := 0
    v := self
      withN: ((c
        ifTrue: [2]
        ifFalse: [
          t := t + 1
          1
        ]) + 1)
    #[v n, t]

  o13: c =>
    t := 0
    v := self
      withN: (c
        ifTrue: [2]
        ifFalse: [
          t := t + 1
          1
        ])
    #[v n, t]

  s7 =>
    t := 0
    r := nil
      ifNil: [
        t := t + 1
        1
      ]
    #[r, t]

  // BT-3748 review: the §1a shape with the threading construct nested inside
  // the right operand (an argument of a send, the receiver of a binary send)
  // rather than the operand itself. Source order reads `t` first: #[1, 1].
  seqArg: flag =>
    t := 0
    r := t + (0
      max: (flag
        ifTrue: [
          t := t + 1
          1
        ]
        ifFalse: [0]))
    #[r, t]

  seqRecv: flag =>
    t := 0
    r := t + ((flag
      ifTrue: [
        t := t + 1
        1
      ]
      ifFalse: [0]) + 0)
    #[r, t]

  // A `do:` in a conditional arm.
  stArmDo: c =>
    t := 0
    c ifTrue: [#(1, 2) do: [:e | t := t + e]]
    t

  // A loop in a conditional arm.
  stArmWhile: c =>
    t := 0
    c ifTrue: [[t < 2] whileTrue: [t := t + 1]]
    t

  // `inject:into:` in a conditional arm.
  stArmInject: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2)
          inject: 0
          into: [:a :e |
            t := t + e
            a + e
          ]
      ]
    t

  // ADR 0131 Phase 3b (BT-3817): `on:do:`/`ensure:` as local-threading producers
  // (o1, o2, o5-o10, seq and the protected-body `do:`).
  o1 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  o2 =>
    t := 0
    r := ([
      t := t + 1
      1
    ] ensure: [t := t + 1]) + 1
    #[r, t]

  o5 =>
    t := 0
    v := self
      withN: ([
        t := t + 1
        1
      ] on: Error do: [:e | 0])
    #[v n, t]

  o6: cond =>
    t := 0
    cond
      ifTrue: [
        ^#[([
          t := t + 1
          1
        ] on: Error do: [:e | 0]), t]
      ]
    #[0, t]

  o7: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
      7
    ] on: Error do: [:x | 3]
    #[r, t]

  o8: c =>
    t := 0
    r := [
      c
        ifTrue: [2]
        ifFalse: [
          ([
            t := t + 1
            1
          ] on: Error do: [:e | 0]) + 1
        ]
    ] on: Error do: [:x | 3]
    #[r, t]

  // o9: o1's operand as the method's last expression.
  o9 =>
    t := 0
    ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + 1

  // o10: o1's operand as a `^` value inside an arm.
  o10: cond =>
    t := 0
    cond
      ifTrue: [
        ^([
          t := t + 1
          1
        ] on: Error do: [:e | 0]) + 1
      ]
    0

  seq =>
    t := 0
    r := t + ([
      t := t + 1
      1
    ] on: Error do: [:e | 0])
    #[r, t]

  // A `do:` in an `on:do:` body.
  stProtectedDo =>
    t := 0
    [
      #(1, 2) do: [:x | t := t + x]
      7
    ] on: Error do: [:e | 0]
    t

  // BT-3822 (ADR 0131 Phase 3c): a conditional in a `whileTrue:` body is a
  // local-threading producer in the loop frame (erlc `unbound variable` before).
  stLoopArm =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        i := i + 1
        i > 1 ifTrue: [t := t + 5]
      ]
    t

  // `keysAndValuesDo:` as a statement.
  stKeysAndValuesDo =>
    t := 0
    #{#a => 1, #b => 2} keysAndValuesDo: [:k :v | t := t + v]
    t

  // `eachWithIndex:` as a statement.
  stEachWithIndex =>
    t := 0
    #(1, 2) eachWithIndex: [:x :i | t := t + x]
    t

  // `do:separatedBy:` as a statement.
  stDoSeparatedBy =>
    t := 0
    #(1, 2) do: [:x | t := t + x] separatedBy: [t := t + 10]
    t
