// BT-3817 (ADR 0131 Phase 3b): the statement-position matrix cells that
// answered wrong, raised or failed to compile before `on:do:`/`ensure:`
// became local-threading producers (`adr0131_statement_probes.tsv`, verdict
// `bad`, now `ok`). Each method is one cell of the matrix: a construct
// (`kind`) writing the method-level local `t` (`target`) inside a block role
// (`container`), in a class, value-type or actor method. `c` is the
// condition. The expected answers are in stdlib/test/adr0131exc_matrix_test.bt.

Object subclass: Adr0131ExcMatrixClass
  classState: n = 0

  class plain => 0

  class armCvarOnDo: c =>
    t := 0
    c
      ifTrue: [
        [
          t := t + 1
          self.n := 1
        ] on: Error do: [:e | 0]
      ]
    t

  class armCvarOuterOnDo: c =>
    t := 0
    c
      ifTrue: [
        self.n := 1
        [t := t + 1] on: Error do: [:e | 0]
