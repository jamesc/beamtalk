// BT-3911 (ADR 0133 Phase 3): arm-bearing constructs as frames, in a class
// method. See stdlib/test/bt3911arm_frames_test.bt and its value-type and
// actor siblings.

Object subclass: Bt3911ArmFramesClass
  classState: n = 0

  // BT-3891: a local bound in a conditional arm of a `whileTrue:` condition
  // is a local of that arm; it used to emit an unbound `StateAcc`.
  class condAnd: m :: Integer =>
    i := 0
    [
      i < m
        and: [
          x := i
          x < 5
        ]
    ] whileTrue: [i := i + 1]
    i

  class condIfTrue: m :: Integer =>
    i := 0
    [
      i < m
        ifTrue: [
          x := i
          x
        ]
      i < 4
    ] whileTrue: [i := i + 1]
    i

  class condIfNil: m :: Integer =>
    i := 0
    [
      nil
        ifNil: [
          x := i
          x + 1
        ]
      i < m
    ] whileTrue: [i := i + 1]
    i

  class condOrWhileFalse: m :: Integer =>
    i := 0
    [
      i >= m
        or: [
          x := i
          x < 0
        ]
    ] whileFalse: [i := i + 1]
    i

  class condNested: m :: Integer =>
    i := 0
    [
      i < m
        and: [
          x := i
          x < 5
            and: [
              y := x + 1
              y < 4
            ]
        ]
    ] whileTrue: [i := i + 1]
    i

  // Nestings of the arm in the condition: through a `do:` body, through a
  // closure, and writing a local the condition itself bound first.
  class condDoBody: m :: Integer =>
    i := 0
    [
      #(1)
        do: [:e |
          e > 0
            ifTrue: [
              x := e
              x
            ]
        ]
      i < m
    ] whileTrue: [i := i + 1]
    i

  class condClosure: m :: Integer =>
    i := 0
    [
      [:z |
        z > 0
          ifTrue: [
            x := z
            x
          ]
      ] value: 1
      i < m
    ] whileTrue: [i := i + 1]
    i

  class condBoundBefore: m :: Integer =>
    i := 0
    [
      x := 0
      m > 0 ifTrue: [x := 1]
      i < (m + x) - 1
    ] whileTrue: [i := i + 1]
    i

  // A `ClassBuilder` `classMethods:` fun is a body of its own: the enclosing
  // method's non-local-return token survives it, so the `^` in a block
  // lexically after the cascade still reaches the method's catch.
  class firstOver: limit in: xs =>
    Object classBuilder name: #Bt3911BuiltBeforeNlr;
      superclass: Object;
      classMethods: #{#answer => [:cls | 7]};
      register
    xs do: [:e | e > limit ifTrue: [^e]]
    0
