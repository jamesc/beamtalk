// BT-3981: an evaluated block literal that binds a local, writes a field or
// sends to `self`, in the host/position cells that answer the value.
// A value-type method answers the value at every position.

Value subclass: Bt3981EvalblockValue
  field: hits = 0

  ap: b => b value

  peek: v => v

  methodAssignedSimple =>
    r := [
      n := 3
      n
    ] value
    r

  methodAssignedLoop =>
    r := [
      n := 0
      #(1, 2) do: [:y | n := n + y]
      n
    ] value
    r

  methodAssignedSeq =>
    r := [
      n := 1
      n := n + 2
      n
    ] value
    r

  methodAssignedSend =>
    r := [self peek: 3] value
