// BT-3916 (ADR 0133): a `Collection` with `do:` and its own `inject:into:`
// (which ignores the elements) but the stdlib's `eachWithIndex:` and
// `do:separatedBy:`. A writing block sent either of those is lowered through a
// synthetic `inject:into:` fold, yet it must still thread: the receiver guard
// checks the selector the user sent, which resolves to the stdlib. Driven by
// adr0133enumerable_user_test.bt.

Collection subclass: Adr0133EnumerableOwnInject
  field: items :: List = #()

  size -> Integer => self.items size

  do: block :: Block -> Nil =>
    self.items do: block
    nil

  printString -> String => "Adr0133EnumerableOwnInject"

  inject: initial :: Object into: _block :: Block(Object, Object, Object) -> Object =>
    initial
