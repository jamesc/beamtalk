// BT-3971: an Erlang FFI argument block that writes a captured local (`t`) is
// a Tier 2 body. Ending it in `[n := 3. n] value` is a compile error (it
// answered the raw `{Value, State}` tuple; see the codegen corpus
// `tier2_block_local_corpus.rs`). These neighbours answer right and are pinned.

Actor subclass: Bt3971Actor
  state: hits = 0

  assigned =>
    t := 0
    (Erlang lists)
      map: [:x |
        t := t + 1
        r := [
          n := 3
          n
        ] value
        r
      ]
      with: #(1)

  notLast =>
    t := 0
    (Erlang lists)
      map: [:x |
        t := t + 1
        [
          n := 3
          n
        ] value
        7
      ]
      with: #(1)

  pureValue =>
    t := 0
    (Erlang lists)
      map: [:x |
        t := t + 1
        [3] value
      ]
      with: #(1)

  inArm =>
    t := 0
    (Erlang lists)
      map: [:x |
        t := t + 1
        (self.hits =:= 0)
          ifTrue: [
            [
              n := 3
              n
            ] value
          ]
          ifFalse: [0]
      ]
      with: #(1)
