Actor subclass: Wip3793Actor

  whileInToDo =>
    s := 0
    1 to: 3 do: [:i | [s < i] whileTrue: [s := s + 1]]
    s

  whileInDo =>
    s := 0
    #(1, 2, 3) do: [:i | [s < i] whileTrue: [s := s + 1]]
    s

  whileFalseInToDo =>
    s := 0
    1 to: 3 do: [:i | [s >= i] whileFalse: [s := s + 1]]
    s

  doInToDo =>
    t := 0
    1 to: 2 do: [:i | #(1, 2) do: [:j | t := t + j]]
    t

  doInDo =>
    t := 0
    #(1, 2) do: [:i | #(1, 2) do: [:j | t := t + j]]
    t

  doInWhile =>
    t := 0
    i := 0
    [i < 2] whileTrue: [#(1, 2) do: [:x | t := t + x]. i := i + 1]
    t

  collectInWhile =>
    t := 0
    i := 0
    [i < 2] whileTrue: [#(1, 2) collect: [:x | t := t + x]. i := i + 1]
    t

  timesInTimes =>
    t := 0
    2 timesRepeat: [3 timesRepeat: [t := t + 1]]
    t

  toDoInCollect =>
    t := 0
    #(1, 2) collect: [:x | 1 to: 2 do: [:k | t := t + x]. x]
    t

  assignCollectInToDo =>
    t := 0
    1 to: 2 do: [:i | r := #(1, 2) collect: [:x | t := t + x]. t := t + r size]
    t

  injectInDo =>
    t := 0
    #(1, 2) do: [:i | #(1, 2) inject: 0 into: [:a :x | t := t + x. a + x]]
    t

  assignInjectInDo =>
    t := 0
    u := 0
    #(1, 2) do: [:i | r := #(1, 2) inject: 0 into: [:a :x | t := t + x. a + x]. u := u + r]
    #[t, u]

  twoLocals =>
    t := 0
    u := 0
    1 to: 2 do: [:i | #(1, 2) do: [:j | t := t + j. u := u + i]]
    #[t, u]

  localInOuterOnly =>
    t := 0
    #(1, 2) do: [:i | w := 0. #(1, 2) do: [:j | w := w + j]. t := t + w]
    t

  readAfterInner =>
    t := 0
    #(1, 2) do: [:i | #(1, 2) do: [:j | t := t + j]. t := t * 2]
    t

  selectInDo =>
    t := 0
    #(1, 2) do: [:i | #(1, 2, 3) select: [:x | t := t + 1. x > 1]]
    t

  doInCollectLast =>
    t := 0
    r := #(1, 2) collect: [:i | #(1, 2) do: [:j | t := t + j]. i]
    #[r, t]

  threeDeep =>
    t := 0
    1 to: 2 do: [:i | 1 to: 2 do: [:j | #(1, 2) do: [:k | t := t + 1]]]
    t

  whileInWhile =>
    t := 0
    i := 0
    [i < 2] whileTrue: [j := 0. [j < 3] whileTrue: [t := t + 1. j := j + 1]. i := i + 1]
    t

