// BT-4025: collects the raw `{Event, Ref, Measurements, Metadata}` messages
// sent by the Erlang-side `telemetry_test` handler, so TelemetryTest can check
// exactly what a plain Erlang handler receives from `Telemetry execute:` and
// `Telemetry span:`. `returnFromSpan` checks a `^` out of a span inside an
// actor method (the state-carrying NLR shape).

Server subclass: TelemetryEventCollector
  state: received = #()

  handleInfo: msg => self.received := self.received add: msg

  received => self.received

  returnFromSpan =>
    Telemetry
      span: #(#bt4025, #actornlr)
      metadata: #{}
      do: [^7]
    0
