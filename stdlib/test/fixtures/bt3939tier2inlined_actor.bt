// BT-3939: a local bound and rebound by a loop inside an INLINED block (a
// conditional arm, an evaluated `[...] value`) of a Tier 2 body (here the
// block an Erlang FFI call receives) is lowered
// by that inlined block's own frame, and answers the right value. The block
// an Erlang FFI call receives no longer writes a captured local (BT-3917: such
// a block is a compile error, ADR 0133), so these bodies are plain funs; the
// binding of an inlined block's local is still lowered by its own frame. The
// gate (a compile error) is for a local the Tier 2 body itself binds; see
// stdlib/test/bt3939tier2inlined_test.bt.

Actor subclass: Bt3939Tier2InlinedActor
  state: hits = 0

  arm: flag =>
    xs := #(1, 2)
    (Erlang lists)
      map: [:x |
        flag
          ifTrue: [
            n := 0
            xs do: [:y | n := n + y]
            n
          ]
          ifFalse: [0]
      ]
      with: #(1)

  nested: flag =>
    xs := #(1, 2)
    (Erlang lists)
      map: [:x |
        flag
          ifTrue: [
            flag
              ifTrue: [
                n := 0
                xs do: [:y | n := n + y]
                n
              ]
              ifFalse: [1]
          ]
          ifFalse: [0]
      ]
      with: #(1)
