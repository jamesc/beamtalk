// BT-3909 (ADR 0133 Phase 3): the actor `groupBy:` positions that unpack the
// threaded fold's result and answer the grouped dictionary, which the
// `GroupByValue` row of `RESIDUAL_DENY_SET` leaves accepted. Every other
// position of a `groupBy:` whose block binds a local is a compile error until
// BT-3912 (BT-3897). Asserted in adr0133residuals_test.bt.

Actor subclass: Adr0133ResidualsActor
  state: groups = nil

  // A method-body assignment, then a receiver.
  assigned =>
    r := #(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]
    r at: true

  // The method's last statement: its implicit reply.
  lastStatement =>
    #(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]

  // `^` at the method body.
  returned =>
    ^#(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]

  // A method-body field assignment.
  stored =>
    self.groups := #(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]
    self.groups at: true

  // An assignment inside a `do:` body.
  assignedInDo =>
    r := Dictionary new
    #(1)
      do: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
      ]
    r at: true

  // An assignment inside a conditional arm.
  assignedInArm: c =>
    r := Dictionary new
    c
      ifTrue: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
      ]
    r at: true

  // A block that writes a field: the threaded fold, assigned.
  fieldWriting =>
    r := #(1, 3)
      groupBy: [:x |
        self.groups := x
        x > 2
      ]
    #(r at: true, self.groups)
