// BT-3909 (ADR 0133 Phase 3): the actor `groupBy:` positions that unpack the
// threaded fold's result and answer the grouped dictionary. Every position of
// a `groupBy:` whose block binds a local does since BT-3912 (BT-3897: it is a
// fold producer); `bt3912group_by.bt` covers the rest. Asserted in
// adr0133residuals_test.bt.

Actor subclass: Adr0133ResidualsActor
  state: groups = nil

  // A method-body assignment, then a receiver.
  assigned =>
    r := #(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]
    r at: true

  // The method's last statement: its implicit reply.
  lastStatement =>
    #(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]

  // `^` at the method body.
  returned =>
    ^#(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]

  // A method-body field assignment.
  stored =>
    self.groups := #(1, 3)
      groupBy: [:x |
        k := x > 2
        k
      ]
    self.groups at: true

  // An assignment inside a `do:` body.
  assignedInDo =>
    r := Dictionary new
    #(1)
      do: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
      ]
    r at: true

  // An assignment inside a conditional arm.
  assignedInArm: c =>
    r := Dictionary new
    c
      ifTrue: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
      ]
    r at: true

  // An assignment inside an `on:do:` protected body.
  assignedInOnDo =>
    r := Dictionary new
    [
      r := #(1, 3)
        groupBy: [:x |
          k := x > 2
          k
        ]
      0
    ] on: Error do: [:e | 0]
    r at: true

  // An assignment inside an `ensure:` cleanup.
  assignedInEnsure =>
    r := Dictionary new
    [nil]
      ensure: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
      ]
    r at: true

  // An assignment inside a `collect:` body.
  assignedInCollect =>
    r := Dictionary new
    #(1)
      collect: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        z
      ]
    r at: true

  // An assignment inside an `inject:into:` body.
  assignedInInject =>
    r := Dictionary new
    #(1)
      inject: 0
      into: [:a :z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        a
      ]
    r at: true

  // An assignment inside a `detect:ifNone:` handler.
  assignedInIfNone =>
    r := Dictionary new
    #(1)
      detect: [:z | false]
      ifNone: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        0
      ]
    r at: true

  // A block that writes a field: the threaded fold, assigned.
  fieldWriting =>
    r := #(1, 3)
      groupBy: [:x |
        self.groups := x
        x > 2
      ]
    #(r at: true, self.groups)

  // Do: a block-local `r`, read in the same block after the assignment.
  assignedLocalInDo =>
    self.groups := nil
    #(1)
      do: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
      ]
    self.groups

  // Do: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInDo =>
    r := Dictionary new
    self.groups := nil
    #(1)
      do: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
      ]
    self.groups

  // Arm: a block-local `r`, read in the same block after the assignment.
  assignedLocalInArm: c =>
    self.groups := nil
    c
      ifTrue: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
      ]
    self.groups

  // Arm: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInArm: c =>
    r := Dictionary new
    self.groups := nil
    c
      ifTrue: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
      ]
    self.groups

  // OnDo: a block-local `r`, read in the same block after the assignment.
  assignedLocalInOnDo =>
    self.groups := nil
    [
      r := #(1, 3)
        groupBy: [:x |
          k := x > 2
          k
        ]
      self.groups := r at: true
      0
    ] on: Error do: [:e | 0]
    self.groups

  // OnDo: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInOnDo =>
    r := Dictionary new
    self.groups := nil
    [
      r := #(1, 3)
        groupBy: [:x |
          k := x > 2
          k
        ]
      self.groups := r at: true
      0
    ] on: Error do: [:e | 0]
    self.groups

  // Ensure: a block-local `r`, read in the same block after the assignment.
  assignedLocalInEnsure =>
    self.groups := nil
    [nil]
      ensure: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
      ]
    self.groups

  // Ensure: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInEnsure =>
    r := Dictionary new
    self.groups := nil
    [nil]
      ensure: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
      ]
    self.groups

  // Collect: a block-local `r`, read in the same block after the assignment.
  assignedLocalInCollect =>
    self.groups := nil
    #(1)
      collect: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
        z
      ]
    self.groups

  // Collect: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInCollect =>
    r := Dictionary new
    self.groups := nil
    #(1)
      collect: [:z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
        z
      ]
    self.groups

  // Inject: a block-local `r`, read in the same block after the assignment.
  assignedLocalInInject =>
    self.groups := nil
    #(1)
      inject: 0
      into: [:a :z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
        a
      ]
    self.groups

  // Inject: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInInject =>
    r := Dictionary new
    self.groups := nil
    #(1)
      inject: 0
      into: [:a :z |
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
        a
      ]
    self.groups

  // IfNone: a block-local `r`, read in the same block after the assignment.
  assignedLocalInIfNone =>
    self.groups := nil
    #(1)
      detect: [:z | false]
      ifNone: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
        0
      ]
    self.groups

  // IfNone: an outer-bound `r`, read in the same block after the assignment.
  assignedReadInIfNone =>
    r := Dictionary new
    self.groups := nil
    #(1)
      detect: [:z | false]
      ifNone: [
        r := #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := r at: true
        0
      ]
    self.groups

  // A non-final `groupBy:` statement in a `do:` body.
  statementInDo =>
    #(1)
      do: [:z |
        #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := z
      ]
    self.groups

  // A non-final `groupBy:` statement in a `timesRepeat:` body.
  statementInTimesRepeat =>
    1
      timesRepeat: [
        #(1, 3)
          groupBy: [:x |
            k := x > 2
            k
          ]
        self.groups := 7
      ]
    self.groups
