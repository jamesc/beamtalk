// BT-3407: Test fixtures for classState visibility during supervisor
// configuration: a value set via an ordinary class-method call (`configure:`)
// before the supervisor starts must be visible to its configuration.
//
// Since ADR 0135 the configuration is instance-side (`childSpecs`), running
// inside the supervisor's own `init`, and reads the class variable through a
// class-side message (`ClassStateSupApp cfg`). That message is served by the
// class process, which is busy while `ClassStateSupApp supervise` itself runs
// (until BT-3962 moves `supervise` out of the class process), so the test
// starts this supervisor nested under ClassStateSupRoot.
//
// The worker actor (`ClassStateSupWorker`) lives in its own file,
// class_state_sup_worker.bt, since a .bt file may only declare one
// class.

Supervisor subclass: ClassStateSupApp
  classState: cfg = nil

  class configure: aDict =>
    self.cfg := aDict
    nil

  class cfg => self.cfg

  strategy -> Symbol => #oneForOne

  childSpecs -> List =>
    ClassStateSupApp cfg
      ifNil: [#()]
      ifNotNil: [:c |
        lbl := c at: #label ifAbsent: ["default"]
        spec := (ClassStateSupWorker supervisionSpec withClassMethod: #start:) withArgs: #(lbl)
        spec := spec withRestart: #permanent
        #(spec)
      ]
