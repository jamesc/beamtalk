// BT-3407: Test fixtures for classState visibility across class-method
// calls, specifically under a Supervisor's `class children` (invoked via
// `beamtalk_supervisor:static_init/2`, which bypasses the class gen_server
// to avoid the deadlock documented on that function). Before the fix,
// `static_init` read a hardcoded empty ClassVars map, so a value set via an
// ordinary class-method call (`configure:`) before `supervise` was invisible
// inside `class children` — crashing with `{badkey, ...}` even though
// `classState: cfg = nil` declares a default.
//
// The worker actor (`ClassStateSupWorker`) lives in its own file,
// class_state_sup_worker.bt, since a .bt file may only declare one
// class.

Supervisor subclass: ClassStateSupApp
  classState: cfg = nil

  class strategy -> Symbol => #oneForOne

  class configure: aDict =>
    self.cfg := aDict
    nil

  class children -> List =>
    self.cfg
      ifNil: [#()]
      ifNotNil: [:c |
        lbl := c at: #label ifAbsent: ["default"]
        spec := (ClassStateSupWorker supervisionSpec withClassMethod: #start:) withArgs: #(lbl)
        spec := spec withRestart: #permanent
        #(spec)
      ]
