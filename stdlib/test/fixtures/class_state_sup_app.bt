// BT-3407: Test fixtures for shared configuration visibility during supervisor
// configuration: a value set on the named `ClassStateSupConfig` actor
// (`#bt3407_sup_cfg`) before the supervisor starts must be visible to its
// configuration.
//
// Since ADR 0135 the configuration is instance-side (`childSpecs`), running
// inside the supervisor's own `init`, and reads the value by messaging the
// named actor. The actor is free while `ClassStateSupApp supervise` runs.
//
// The worker actor (`ClassStateSupWorker`) lives in its own file,
// class_state_sup_worker.bt, since a .bt file may only declare one
// class.

Supervisor subclass: ClassStateSupApp

  strategy -> Symbol => #oneForOne

  childSpecs -> List =>
    ((ClassStateSupConfig named: #bt3407_sup_cfg) unwrap) cfg
      ifNil: [#()]
      ifNotNil: [:c |
        lbl := c at: #label ifAbsent: ["default"]
        spec := (ClassStateSupWorker supervisionSpec withClassMethod: #start:) withArgs: #(lbl)
        spec := spec withRestart: #permanent
        #(spec)
      ]
