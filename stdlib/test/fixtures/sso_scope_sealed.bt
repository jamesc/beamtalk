// BT-3675: characterises a class's OWN mutating self-send nested in a
// conditional arm and in a threaded loop body (one that also mutates a captured
// local). The open and sealed variants must agree.

sealed Object subclass: SsoScopeSealed
  classState: n = 0

  class n -> Integer => self.n

  class resetN -> Integer => self.n := 0

  class increment -> Integer => self.n := self.n + 1

  class setN: v :: Integer -> Integer => self.n := v

  class condArm: x -> Integer =>
    x > 0 ifTrue: [self increment]
    x

  class threadedTimes: k -> Integer =>
    i := 0
    k
      timesRepeat: [
        i := i + 1
        self increment
      ]
    i

  class threadedToDo: k -> Integer =>
    i := 0
    1
      to: k
      do: [:j |
        i := i + j
        self increment
      ]
    i

  // BT-3675 review: a direct class-var write between sends inside a scope.
  class mixedLoop -> Integer =>
    self.n := 0
    seen := 0
    1
      to: 3
      do: [:i |
        self increment
        self.n := self.n + 1
        seen := seen + 1
      ]
    self.n

  class mixedArm: x -> Integer =>
    self.n := 0
    seen := 0
    x > 0
      ifTrue: [
        self increment
        self.n := self.n + 10
        self increment
        seen := seen + 1
      ]
    self.n

  // BT-3683: an arm that is not taken (or sends a non-writing method) in a
  // later iteration must not roll back an earlier iteration's class-var write.
  class armsInListDoThree -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2, 3)
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment]
        i =:= 2 ifTrue: [self nonWriting]
        i =:= 3 ifTrue: [self increment]
      ]
    self.n

  class armsInToDo -> Integer =>
    self.n := 0
    seen := 0
    1
      to: 3
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment]
        i =:= 2 ifTrue: [self nonWriting]
        i =:= 3 ifTrue: [self nonWriting]
      ]
    self.n

  class armsInTimesRepeat -> Integer =>
    self.n := 0
    seen := 0
    3
      timesRepeat: [
        seen := seen + 1
        seen =:= 1 ifTrue: [self increment]
        seen =:= 2 ifTrue: [self nonWriting]
        seen =:= 3 ifTrue: [self nonWriting]
      ]
    self.n

  class armsIfTrueIfFalseInListDo -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2)
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment] ifFalse: [self nonWriting]
      ]
    self.n

  class armsNestedConditionalInListDo -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2)
      do: [:i |
        seen := seen + 1
        i > 0
          ifTrue: [
            i =:= 1 ifTrue: [self increment]
            i =:= 2 ifTrue: [self nonWriting]
          ]
      ]
    self.n

  class armsInOnDoBody -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2)
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment]
        [self nonWriting] on: Error do: [:e | nil]
      ]
    self.n

  class armsInOnDoHandler -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2)
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment]
        [1 / 0] on: Error do: [:e | self nonWriting]
      ]
    self.n

  // A direct write in a later iteration must win over the earlier commit; the
  // skipped arm must not roll it back.
  class armsDirectWriteBetween -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2, 3)
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment]
        i =:= 2 ifTrue: [self setN: 100]
        i =:= 3 ifTrue: [self nonWriting]
      ]
    self.n

  // A write made in an iteration that raised (and was caught) stays discarded
  // even though a later iteration's skipped arm falls back to the enclosing
  // scope's commit.
  class armsRaisedIterationDiscarded -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2)
      do: [:i |
        seen := seen + 1
        [
          self increment
          1 / 0
        ] on: Error do: [:e | nil]
        i =:= 2 ifTrue: [self nonWriting]
      ]
    self.n

  // Statically able to write `n` (so codegen cannot treat it as pure and takes
  // the full late-bound path), but the write never runs here.
  class nonWriting -> Integer =>
    self.n > 100 ifTrue: [self increment]
    0

  // BT-3683: a writing send in one arm of a `do:` over a list, then a
  // non-writing send in another arm of the next iteration; the first write
  // must survive.
  class armsInListDo -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2)
      do: [:i |
        seen := seen + 1
        i =:= 1 ifTrue: [self increment]
        i =:= 2 ifTrue: [self nonWriting]
      ]
    self.n

  // The skipped arm must fall back to whatever the loop body already
  // committed this iteration, whichever statement shape made it.
  class armsAfterSendInListDo -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2, 3)
      do: [:i |
        seen := seen + 1
        self increment
        i =:= 9 ifTrue: [self nonWriting]
      ]
    self.n

  class armsAfterAssignedSendInListDo -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2, 3)
      do: [:i |
        seen := seen + 1
        _r := self increment
        i =:= 9 ifTrue: [self nonWriting]
      ]
    self.n

  class armsAfterDirectWriteInListDo -> Integer =>
    self.n := 0
    seen := 0
    #(1, 2, 3)
      do: [:i |
        seen := seen + 1
        self setN: self n + 5
        i =:= 9 ifTrue: [self nonWriting]
      ]
    self.n
