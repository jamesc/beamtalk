// BT-3755 (ADR 0131 §6): actor self-sends of a block that writes an outer
// local to a callee that does not hand the block's `StateAcc` back. Each
// `probe*` method compiled and answered 0 (write dropped) or raised before
// BT-3755 (probed on the debug build); each is now a §6 compile error. The
// `callee*` methods are the callees; they compile on their own. Inert: the
// runner discovers only `.bt`. BT-3742 (callee-side `{Result, StateAcc}`
// protocol) moves the shapes it fixes back into
// adr0131section6exemptions_actor.bt.
//
// `adr0131_section6_callee_pins` in beamtalk-core checks that every `probe*`
// method is rejected and no `callee*` method is.
//
// Not representable here (one class per file), pinned by
// `section6_actor_self_send_to_a_non_threading_callee_is_an_error` instead:
// a callee inherited from a superclass raises `stateful_block_dispatch`, and
// an override in a subclass raises a `perform:` arity error. A callee that
// passes the block on to another same-class callee that does not itself
// thread it (BT-3755) is rejected too.

Actor subclass: Adr0131Section6CalleePending
  state: n = 0

  sealed calleeDo: b => #(1) do: [:x | b value]

  sealed calleeCond: b => 4 > 3 ifTrue: [b value]

  sealed calleeOperand: b => (b value) + 1

  sealed calleeNested: b =>
    f := [b value]
    f value

  probeDo =>
    t := 0
    self calleeDo: [t := t + 1]
    t

  probeCond =>
    t := 0
    self calleeCond: [t := t + 1]
    t

  probeOperand =>
    t := 0
    self calleeOperand: [t := t + 1]
    t

  probeNested =>
    t := 0
    self calleeNested: [t := t + 1]
    t
