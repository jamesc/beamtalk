// BT-3936 case A: like `SelfSendHomPool`, but no method passes `do:` a
// field-writing block, so `do:`'s parameter is not a promoted Tier 2
// position and the block in `recordAll` is a plain closure. Its self-send
// (`record:`) changes `total`; the closure runs inside the actor, so the
// change is kept (ADR 0137, actor_self_send_hom_test.bt). `lookupAll` is the
// read-only twin.

Actor subclass: SelfSendHomPlainPool
  state: items = #(1, 2, 3)
  state: total = 0

  do: block => self.items do: block

  record: each => self.total := self.total + each

  scale: each => each * 10

  lookupAll => self.items collect: [:each | self scale: each]

  recordAll =>
    self.total := 0
    self do: [:each | self record: each]
    self.total

  // Not a promoted Tier 2 position (no caller in the class passes a
  // field-writing block), so a wrong-arity block sent from another process
  // is seeded with an empty map, never the actor's state (BT-3908).
  sortWith: block => self.items sort: block
