// BT-3867 (ADR 0132 Phase 0b, I5) made a stored Tier 2 block sent `value` in
// a class method an inline producer over a fresh map (deleted by ADR 0133
// Phase 2, BT-3908). ADR 0133 Phase 1
// (BT-3902): a block stored in a local may read captured variables but not
// assign them, so each `st*` method is now an escaping-block compile error
// ("`t` is assigned in a block stored in `b`"). Inert: the runner discovers
// only `.bt`; `adr0133_rejected_fixtures_report_the_escaping_assignment`
// (beamtalk-core) is the assertion. The columns are
// adr0132stored_value_{class,value,actor}.bt.rejected.

Object subclass: Adr0132StoredValueClass

  class stValue =>
    t := 0
    b := [t := t + 1]
    b value
    t

  class stTwice =>
    t := 0
    b := [t := t + 1]
    b value
    b value
    t

  class stArg =>
    t := 0
    b := [:n | t := t + n]
    b value: 5
    t

  class stArg2 =>
    t := 0
    b := [:a :c | t := t + a + c]
    b value: 1 value: 2
    t

  class stAssign =>
    t := 0
    b := [
      t := t + 5
      7
    ]
    r := b value
    #[r, t]

  class stReturn =>
    t := 0
    b := [
      t := t + 1
      t
    ]
    ^b value

  class stLast =>
    t := 0
    b := [
      t := t + 1
      t
    ]
    b value

  class stCascade =>
    t := 0
    b := [:n | t := t + n]
    b value: 1; value: 2
    t

  class stCascadeAssign =>
    t := 0
    b := [:n |
      t := t + n
      t
    ]
    r := b value: 1; value: 2
    #[r, t]

  class stTwoLocals =>
    x := 0
    y := 10
    b := [
      x := x + 1
      y := y + 2
    ]
    b value
    #[x, y]

  class stMixed =>
    t := 0
    b := [:n |
      t := t + n size
      t
    ]
    b value: "abcd"
    r := (b value: #(1, 2)) + 10
    #[t, r]

  class stNestedLocal =>
    t := 0
    b := [
      #(1, 2)
        do: [:e |
          y := e
          y
        ]
      t := t + 1
    ]
    b value
    y := 5
    #[t, y]
