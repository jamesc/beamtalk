// BT-3841 (ADR 0131): `detect:ifNone:` as local-threading producers. Each method starts
// from `t := 0` and writes it from the block in one position; the expected
// answers are in stdlib/test/adr0131detect_test.bt. The block runs up to and including
// the first element that decides the answer (BT-3805), so a decisive first
// element leaves the later elements' writes undone. `c` is the condition of
// the arm shapes.

Object subclass: Adr0131DetectClass

  class topHit =>
    t := 0
    #(1, 2)
      detect: [:v |
        t := t + v
        true
      ]
      ifNone: [
        t := t + 100
        0
      ]
    t

  class inArmHit: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inArmElseHit: c =>
    t := 0
    c
      ifTrue: [t := 100]
      ifFalse: [
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inDoHit =>
    t := 0
    #(1, 2)
      do: [:z |
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inToDoHit =>
    t := 0
    1
      to: 2
      do: [:z |
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inTimesHit =>
    t := 0
    2
      timesRepeat: [
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inWhileHit =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        i := i + 1
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inOnDoHit =>
    t := 0
    [
      #(1, 2)
        detect: [:v |
          t := t + v
          true
        ]
        ifNone: [
          t := t + 100
          0
        ]
    ] on: Error do: [:e | 0]
    t

  class inEnsureHit =>
    t := 0
    [
      #(1, 2)
        detect: [:v |
          t := t + v
          true
        ]
        ifNone: [
          t := t + 100
          0
        ]
    ] ensure: [nil]
    t

  class inHandlerHit =>
    t := 0
    [Error signal: "x"]
      on: Error
      do: [:e |
        #(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class inArmInDoHit: c =>
    t := 0
    #(1, 2)
      do: [:z |
        c
          ifTrue: [
            #(1, 2)
              detect: [:v |
                t := t + v
                true
              ]
              ifNone: [
                t := t + 100
                0
              ]
          ]
      ]
    t

  class returnInArmHit: c =>
    t := 0
    c
      ifTrue: [
        ^#(1, 2)
          detect: [:v |
            t := t + v
            true
          ]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  class assignedHit =>
    t := 0
    r := #(1, 2)
      detect: [:v |
        t := t + v
        true
      ]
      ifNone: [
        t := t + 100
        0
      ]
    #[r, t]

