// BT-3809: a self-send statement in a do:/collect:/inject:into: body sequences its
// operands, so every operand's state change is committed before the dispatch and
// visible to the next operand. Expected answers are in
// stdlib/test/fold_body_self_send_operand_test.bt.

Actor subclass: Bt3809FoldSelfSendActor
  state: n = 0

  bump =>
    self.n := self.n + 1
    self.n

  take: x => x

  take: x with: y => x * 10 + y

  getN => self.n

  // One state-changing operand per iteration.
  doOneOperand =>
    #(1, 2) do: [:e | self take: (self bump)]
    self.n

  // Two state-changing operands per iteration, evaluated left to right.
  doTwoOperands =>
    #(1, 2) do: [:e | self take: (self bump) with: (self bump)]
    self.n

  // The last operand reads the state the first one wrote.
  doOperandThenRead =>
    #(1, 2) do: [:e | self take: (self bump) with: self.n]
    self.n

  collectTwoOperands =>
    #(1, 2) collect: [:e | self take: (self bump) with: (self bump)]

  injectTwoOperands =>
    #(1, 2) inject: 0 into: [:a :e | self take: (self bump) with: (self bump)]

  selectOneOperand => #(1, 2, 3) select: [:e | (self take: (self bump)) > 1]
