// BT-3881: a block literal sent a `value`-family selector of another arity is
// never inlined, so it raises the run-time arity error any block raises and
// its body (and its writes) never run. The analyser reads the same rule
// (BT-3884), so such a send is accepted in every position, a class method
// included, and reports no write. The columns are
// adr0131block_arity_{class,value,actor}.bt; the expected answers are in
// stdlib/test/adr0131block_arity_test.bt.

Actor subclass: Adr0131BlockArityActor
  state: n = 0

  dropArg =>
    t := 0
    [t := t + 1] value: 1
    t

  missingArg =>
    t := 0
    [:k | t := t + k] value
    t

  extraArgs =>
    t := 0
    [:k | t := t + k] value: 1 value: 2
    t

  last =>
    t := 0
    [t := t + 1] value: 1

  arm =>
    t := 0
    4 > 3 ifTrue: [[t := t + 1] value: 1]
    t

  fieldDrop =>
    self.n := 0
    [self.n := self.n + 1] value: 1
    self.n

  fieldMissing =>
    self.n := 0
    [:k | self.n := self.n + k] value
    self.n

  fieldN => self.n

  dropArgValue =>
    t := 0
    x := [t := t + 1] value: 1
    #[x, t]

  missingArgOperand =>
    t := 0
    ([:k | t := t + k] value) printString size + t

  matched =>
    t := 0
    [:k | t := t + k] value: 2
    [:j :k | t := t + j + k] value: 1 value: 2
    t
