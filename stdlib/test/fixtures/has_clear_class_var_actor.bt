// HasClearClassVarActor — test fixture for BT-3551 (ADR 0124 §1/§4i/§9/B4)
//
// The class-side (`classState:`) counterpart to `has_clear_field_actor.bt`'s
// `HasClearFieldActor` — the stdlib singleton shape (§Context (e)): a
// `late classState:` slot, a factory-style `launch:`, and `clearField:` to
// make it relaunchable. `self hasField:`/`self clearField:` compile to
// `maps:is_key`/`maps:remove` on `ClassVars` (§4i), tested here from inside
// a class method AND from outside (`Cls hasField:`/`Cls clearField:`
// reaching the class gen_server's `has_class_var`/`clear_class_var`).

typed Actor subclass: HasClearClassVarActor
  late classState: current :: Integer

  // `@expect type`: a class method's `self <reflection selector>` send
  // (like the pre-existing `self respondsTo:`/`self fieldAt:`) infers as
  // `Dynamic` rather than the reflection selector's own declared `Object`
  // return type — a pre-existing type-checker gap (reproduced with `self
  // respondsTo:` too), not something ADR 0124 B4 introduces, so
  // acknowledged here rather than fixed (CLAUDE.md scope control).
  @expect type
  class hasCurrent -> Boolean => self hasField: #current

  class launch: value :: Integer -> Nil =>
    self.current := value
    nil

  // Top-level (last-position) `self clearField:` in a class method —
  // ADR 0124 §4i's `class_method_prelude_producer`/`lower_class_method_body`
  // path.
  @expect type
  class clearCurrent -> Self => self clearField: #current
