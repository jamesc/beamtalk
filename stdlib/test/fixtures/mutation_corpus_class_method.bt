// BT-2360: Shared mutation-fragment corpus — class-method context.
//
// Peer of mutation_corpus_value.bt (Value subclass) and mutation_corpus_actor.bt
// (Actor). Exposes the SAME fragment method names as those corpora, but as
// *class methods* (ADR 0048 — prefix `class`, called on the class name directly),
// so the outer-local threading runs in class-method codegen.
//
// Class-method block threading was hardened by BT-2349 (loops / foldl list-ops /
// conditionals in last / non-last / assignment-RHS positions), BT-2350 (collect:/
// select:/inject:into: combining a self-send and a captured local), and BT-2358
// (explicit `^` return of a threading construct). All three have landed, so these
// fragments thread correctly and the matrix asserts their ground-truth values.
//
// Each method is one corpus fragment, named `<construct><Position><WriteMode>`,
// and returns the *final threaded value* of an outer local mutated inside the
// construct — identical semantics to the value/actor corpora (same expected
// ground-truth values). See mutation_corpus_value.bt for the axis legend.

Object subclass: MutationCorpusClassMethod

  // ── to:do: ────────────────────────────────────────────────────────────────
  class toDoNonLastWriteOnly =>
    last := 0
    1 to: 5 do: [:i | last := i]
    last

  class toDoNonLastReadWrite =>
    sum := 0
    1 to: 5 do: [:i | sum := sum + i]
    sum

  class toDoAssignRhsReadWrite =>
    sum := 0
    _r := (1 to: 5 do: [:i | sum := sum + i])
    sum

  // ── to:by:do: ───────────────────────────────────────────────────────────────
  class toByDoNonLastWriteOnly =>
    last := 0
    1
      to: 10
      by: 2
      do: [:i | last := i]
    last

  class toByDoNonLastReadWrite =>
    sum := 0
    1
      to: 10
      by: 2
      do: [:i | sum := sum + i]
    sum

  // ── timesRepeat: ────────────────────────────────────────────────────────────
  class timesRepeatNonLastWriteOnly =>
    last := 0
    3 timesRepeat: [last := 7]
    last

  class timesRepeatNonLastReadWrite =>
    count := 0
    5 timesRepeat: [count := count + 1]
    count

  // ── whileTrue: ──────────────────────────────────────────────────────────────
  class whileTrueNonLastReadWrite =>
    n := 0
    [n < 5] whileTrue: [n := n + 1]
    n

  // ── whileFalse: ─────────────────────────────────────────────────────────────
  class whileFalseNonLastReadWrite =>
    n := 0
    [n >= 5] whileFalse: [n := n + 1]
    n

  // ── (1 to: n) do: ──────────────────────────────────────────────────────────
  class rangeDoNonLastReadWrite =>
    sum := 0
    (1 to: 5) do: [:i | sum := sum + i]
    sum

  // ── nested loop-in-loop (BT-3176 axis 1) ─────────────────────────────────────
  // Loop nested inside another loop, both threading the SAME outer local — see
  // mutation_corpus_value.bt for the BT-3172 cross-reference (direct class-var
  // mutation nested two loops deep is a deliberate compile error; that shape is
  // covered by crates/beamtalk-core/src/codegen/core_erlang/tests/gen_server.rs,
  // not here).
  class nestedToDoNonLastReadWrite =>
    sum := 0
    1 to: 3 do: [:i | 1 to: 3 do: [:j | sum := sum + j]]
    sum

  // ── construct-equivalence summing accumulators (BT-2345) ────────────────────
  // timesRepeat: / whileTrue: variants that SUM 1..5 (the count/n fragments
  // above only count iterations). Carry their own index so they are
  // sum-equivalent to to:do: / rangeDo, letting the metamorphic harness assert
  // construct equivalence *within the class-method context*. See
  // metamorphic_threading_test.bt relation 3.
  class timesRepeatAccumulatorReadWrite =>
    sum := 0
    i := 1
    5
      timesRepeat: [
        sum := sum + i
        i := i + 1
      ]
    sum

  class whileTrueAccumulatorReadWrite =>
    sum := 0
    i := 1
    [i <= 5]
      whileTrue: [
        sum := sum + i
        i := i + 1
      ]
    sum

  // ── collect: ────────────────────────────────────────────────────────────────
  // NonLast: collect is a bare side-effect statement; result is discarded.
  class collectNonLastReadWrite =>
    n := 0
    @expect discarded_update
    #(1, 2, 3)
      collect: [:i |
        n := n + 1
        i * 2
      ]
    n

  // AssignRhs: collect result is bound to a local (different codegen path).
  class collectAssignRhsReadWrite =>
    n := 0
    _r := #(1, 2, 3)
      collect: [:i |
        n := n + 1
        i * 2
      ]
    n

  // ── select: ─────────────────────────────────────────────────────────────────
  class selectNonLastReadWrite =>
    n := 0
    @expect discarded_update
    #(1, 2, 3, 4)
      select: [:i |
        n := n + 1
        i > 2
      ]
    n

  // ── reject: ─────────────────────────────────────────────────────────────────
  class rejectNonLastReadWrite =>
    n := 0
    @expect discarded_update
    #(1, 2, 3, 4)
      reject: [:i |
        n := n + 1
        i > 2
      ]
    n

  // ── inject:into: ─────────────────────────────────────────────────────────────
  // NonLast: inject result is discarded; only the outer local matters.
  class injectNonLastReadWrite =>
    t := 0
    #(1, 2, 3)
      inject: 0
      into: [:a :b |
        t := t + b
        a + b
      ]
    t

  // AssignRhs: inject result bound to a local.
  class injectAssignRhsReadWrite =>
    t := 0
    _r := #(1, 2, 3)
      inject: 0
      into: [:a :b |
        t := t + b
        a + b
      ]
    t

  // BT-2378: AssignRhs where the assignment *target* is itself the threaded local
  // mutated inside the construct. The target must observe the construct's logical
  // result (element 1 of the {value, StateAcc} tuple — here the inject fold = 106),
  // NOT the threaded accumulator value (__local__total = 6). The Actor assign-RHS path
  // wrongly rebound the target from the threaded state before the fix.
  class injectAssignRhsTargetMutated =>
    total := 0
    total := (#(1, 2, 3)
      inject: 100
      into: [:a :b |
        total := total + b
        a + b
      ])
    total

  // ── detect: ─────────────────────────────────────────────────────────────────
  class detectNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      detect: [:i |
        n := n + 1
        i > 10
      ]
      ifNone: [-1]
    n

  // ── count: ──────────────────────────────────────────────────────────────────
  class countNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      count: [:i |
        n := n + 1
        i > 0
      ]
    n

  // ── ifTrue: ─────────────────────────────────────────────────────────────────
  // Conditions are passed in (not literals) so the always-true/false lint does
  // not fire; callers pass `true` to drive the threading path.
  class ifTrueNonLastWriteOnly: flag =>
    m := 0
    flag ifTrue: [m := 9]
    m

  class ifTrueNonLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]
    sum

  // read+write conditional as the last expression.
  class ifTrueLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]

  // ── ifTrue:ifFalse: ──────────────────────────────────────────────────────────
  class ifTrueIfFalseNonLastReadWrite: flag =>
    x := 1
    flag ifTrue: [x := x + 1] ifFalse: [x := x + 100]
    x

  class ifTrueIfFalseAssignRhsReadWrite: flag =>
    x := 0
    _r := flag
      ifTrue: [
        x := 5
        42
      ]
      ifFalse: [0]
    x

  // ── on:do:/ensure: + nested conditional (BT-3176 axis 3) ────────────────────
  // A nested conditional as the LAST statement of an `ensure:` try body
  // (BT-3161 Flavor B / E5's shape) — fixed by BT-3177, same root cause and
  // fix as mutation_corpus_value.bt's copy of this fragment
  // (`exception_body_outer_state`, exception_handling.rs).
  class ensureNestedConditionalLastReadWrite: flag =>
    t := 0
    [
      t := t + 1
      flag ifTrue: [t := t + 10]
    ] ensure: [nil]
    t

  // ── opaque (non-literal) callable forwarded to a collection HOM (BT-3615) ──
  // ADR 0128 / BT-3583 / BT-3615: each `opaque*:` helper forwards its block
  // parameter — opaque at the primitive's call site — straight to
  // `do:`/`collect:`/`select:`/`inject:into:`/`detect:`/`detect:ifNone:`/
  // `count:`/`anySatisfy:`/`allSatisfy:`. In Actor instance context that
  // lowers to ADR 0128's `State`-threading `lists:foldl`; in value-type and
  // class-method context to the plain-value path (no `State` map). The
  // `opaque*NonLastReadWrite` fragments pass a PURE block (the one shape
  // every context supports) and thread the HOM's answer into an outer local
  // — through a loop, a conditional or a `do:` over the answer — so a leaked
  // `{Result, State}` tuple or a wrong answer in any context shows up as a
  // wrong ground-truth value.
  // (`opaqueDoNonLastReadWrite` checks only that threading survives the
  // send: an inline `lists:foreach` `do:` answers `ok`, not `nil` — a
  // separate, pre-existing, REPL-visible inconsistency left for follow-up.)
  // The answer is bound to `r` before a loop/conditional/`do:` consumes
  // it (keeping every self-send at a statement's top level, so the
  // class-method loop-body family detectors agree — see
  // `family_detector_differential.rs`); besides, a
  // same-class class-method self-send used DIRECTLY as the receiver of a
  // threaded `do:`/`ifTrue:` in a class with class state is a separate,
  // pre-existing compiler crash (`unbound variable 'ClassVars1'`) — see
  // ADR 0128's Scope section.
  class opaqueDo: block => #(1, 2, 3) do: block

  class opaqueCollect: block => #(1, 2, 3) collect: block

  class opaqueSelect: block => #(1, 2, 3) select: block

  class opaqueInject: initial into: block =>
    #(1, 2, 3) inject: initial into: block

  class opaqueDetect: block => #(1, 2, 3) detect: block

  class opaqueDetect: block ifNone: noneBlock =>
    #(1, 2, 3) detect: block ifNone: noneBlock

  class opaqueCount: block => #(1, 2, 3) count: block

  class opaqueAnySatisfy: block => #(1, 2, 3) anySatisfy: block

  class opaqueAllSatisfy: block => #(1, 2, 3) allSatisfy: block

  class opaqueDoNonLastReadWrite =>
    n := 0
    1
      to: 2
      do: [:_k |
        self opaqueDo: [:i | i]
        n := n + 1
      ]
    n

  class opaqueCollectNonLastReadWrite =>
    sum := 0
    r := self opaqueCollect: [:i | i * 2]
    r do: [:x | sum := sum + x]
    sum

  class opaqueSelectNonLastReadWrite =>
    sum := 0
    r := self opaqueSelect: [:i | i > 1]
    r do: [:x | sum := sum + x]
    sum

  class opaqueInjectNonLastReadWrite =>
    sum := 0
    r := self opaqueInject: 0 into: [:a :b | a + b]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueDetectNonLastReadWrite =>
    sum := 0
    r := self opaqueDetect: [:i | i > 1]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueDetectIfNoneNonLastReadWrite =>
    sum := 0
    r := self opaqueDetect: [:i | i > 10] ifNone: [5]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueCountNonLastReadWrite =>
    sum := 0
    r := self opaqueCount: [:i | i > 1]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueAnySatisfyNonLastReadWrite =>
    n := 0
    r := self opaqueAnySatisfy: [:i | i > 2]
    r ifTrue: [n := n + 1]
    n

  class opaqueAllSatisfyNonLastReadWrite =>
    n := 0
    r := self opaqueAllSatisfy: [:i | i > 0]
    r ifTrue: [n := n + 1]
    n
