// BT-2360: Shared mutation-fragment corpus — class-method context.
//
// Peer of mutation_corpus_value.bt (Value subclass) and mutation_corpus_actor.bt
// (Actor). Exposes the SAME fragment method names as those corpora, but as
// *class methods* (ADR 0048 — prefix `class`, called on the class name directly),
// so the outer-local threading runs in class-method codegen.
//
// Class-method block threading was hardened by BT-2349 (loops / foldl list-ops /
// conditionals in last / non-last / assignment-RHS positions), BT-2350 (collect:/
// select:/inject:into: combining a self-send and a captured local), and BT-2358
// (explicit `^` return of a threading construct). All three have landed, so these
// fragments thread correctly and the matrix asserts their ground-truth values.
//
// Each method is one corpus fragment, named `<construct><Position><WriteMode>`,
// and returns the *final threaded value* of an outer local mutated inside the
// construct — identical semantics to the value/actor corpora (same expected
// ground-truth values). See mutation_corpus_value.bt for the axis legend.

Object subclass: MutationCorpusClassMethod
  // BT-3176 axis 4: a class var, distinct from the outer locals every fragment
  // above threads. Every fragment that reads/writes it resets it to 0 first,
  // so results stay deterministic regardless of prior test-call order (unlike
  // the actor corpus, class methods run against one shared class object —
  // there is no per-test "spawn fresh" the way `MutationCorpusActor spawn`
  // gives the actor fragments).
  classState: runs = 0

  // ── to:do: ────────────────────────────────────────────────────────────────
  class toDoNonLastWriteOnly =>
    last := 0
    1 to: 5 do: [:i | last := i]
    last

  class toDoNonLastReadWrite =>
    sum := 0
    1 to: 5 do: [:i | sum := sum + i]
    sum

  class toDoAssignRhsReadWrite =>
    sum := 0
    _r := (1 to: 5 do: [:i | sum := sum + i])
    sum

  // ── to:by:do: ───────────────────────────────────────────────────────────────
  class toByDoNonLastWriteOnly =>
    last := 0
    1
      to: 10
      by: 2
      do: [:i | last := i]
    last

  class toByDoNonLastReadWrite =>
    sum := 0
    1
      to: 10
      by: 2
      do: [:i | sum := sum + i]
    sum

  // ── timesRepeat: ────────────────────────────────────────────────────────────
  class timesRepeatNonLastWriteOnly =>
    last := 0
    3 timesRepeat: [last := 7]
    last

  class timesRepeatNonLastReadWrite =>
    count := 0
    5 timesRepeat: [count := count + 1]
    count

  // ── whileTrue: ──────────────────────────────────────────────────────────────
  class whileTrueNonLastReadWrite =>
    n := 0
    [n < 5] whileTrue: [n := n + 1]
    n

  // ── whileFalse: ─────────────────────────────────────────────────────────────
  class whileFalseNonLastReadWrite =>
    n := 0
    [n >= 5] whileFalse: [n := n + 1]
    n

  // ── (1 to: n) do: ──────────────────────────────────────────────────────────
  class rangeDoNonLastReadWrite =>
    sum := 0
    (1 to: 5) do: [:i | sum := sum + i]
    sum

  // ── nested loop-in-loop (BT-3176 axis 1) ─────────────────────────────────────
  // Loop nested inside another loop, both threading the SAME outer local — see
  // mutation_corpus_value.bt for the BT-3172 cross-reference (direct class-var
  // mutation nested two loops deep is a deliberate compile error; that shape is
  // covered by crates/beamtalk-core/src/codegen/core_erlang/tests/gen_server.rs,
  // not here).
  class nestedToDoNonLastReadWrite =>
    sum := 0
    1 to: 3 do: [:i | 1 to: 3 do: [:j | sum := sum + j]]
    sum

  // A nested loop where only the OUTER loop's top-level body mutates the class
  // var (the inner loop touches only its own local) — the compiling
  // counterpart of BT-3172's rejected inner-mutates shape. Class-var threading
  // is top-level-body-only by design (`loop_body_threads_class_vars`), so this
  // shape threads correctly and must keep doing so.
  class nestedWhileTrueOuterOnlyClassVarReadWrite =>
    self.runs := 0
    i := 0
    [i < 3]
      whileTrue: [
        self.runs := self.runs + 1
        j := 0
        [j < 3] whileTrue: [j := j + 1]
        i := i + 1
      ]
    self.runs

  // ── construct-equivalence summing accumulators (BT-2345) ────────────────────
  // timesRepeat: / whileTrue: variants that SUM 1..5 (the count/n fragments
  // above only count iterations). Carry their own index so they are
  // sum-equivalent to to:do: / rangeDo, letting the metamorphic harness assert
  // construct equivalence *within the class-method context*. See
  // metamorphic_threading_test.bt relation 3.
  class timesRepeatAccumulatorReadWrite =>
    sum := 0
    i := 1
    5
      timesRepeat: [
        sum := sum + i
        i := i + 1
      ]
    sum

  class whileTrueAccumulatorReadWrite =>
    sum := 0
    i := 1
    [i <= 5]
      whileTrue: [
        sum := sum + i
        i := i + 1
      ]
    sum

  // ── collect: ────────────────────────────────────────────────────────────────
  // NonLast: collect is a bare side-effect statement; result is discarded.
  class collectNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      collect: [:i |
        n := n + 1
        i * 2
      ]
    n

  // AssignRhs: collect result is bound to a local (different codegen path).
  class collectAssignRhsReadWrite =>
    n := 0
    _r := #(1, 2, 3)
      collect: [:i |
        n := n + 1
        i * 2
      ]
    n

  // ── select: ─────────────────────────────────────────────────────────────────
  class selectNonLastReadWrite =>
    n := 0
    #(1, 2, 3, 4)
      select: [:i |
        n := n + 1
        i > 2
      ]
    n

  // ── reject: ─────────────────────────────────────────────────────────────────
  class rejectNonLastReadWrite =>
    n := 0
    #(1, 2, 3, 4)
      reject: [:i |
        n := n + 1
        i > 2
      ]
    n

  // ── inject:into: ─────────────────────────────────────────────────────────────
  // NonLast: inject result is discarded; only the outer local matters.
  class injectNonLastReadWrite =>
    t := 0
    #(1, 2, 3)
      inject: 0
      into: [:a :b |
        t := t + b
        a + b
      ]
    t

  // AssignRhs: inject result bound to a local.
  class injectAssignRhsReadWrite =>
    t := 0
    _r := #(1, 2, 3)
      inject: 0
      into: [:a :b |
        t := t + b
        a + b
      ]
    t

  // BT-2378: AssignRhs where the assignment *target* is itself the threaded local
  // mutated inside the construct. The target must observe the construct's logical
  // result (element 1 of the {value, StateAcc} tuple — here the inject fold = 106),
  // NOT the threaded accumulator value (__local__total = 6). The Actor assign-RHS path
  // wrongly rebound the target from the threaded state before the fix.
  class injectAssignRhsTargetMutated =>
    total := 0
    total := (#(1, 2, 3)
      inject: 100
      into: [:a :b |
        total := total + b
        a + b
      ])
    total

  // ── detect: ─────────────────────────────────────────────────────────────────
  class detectNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      detect: [:i |
        n := n + 1
        i > 10
      ]
      ifNone: [-1]
    n

  // ── count: ──────────────────────────────────────────────────────────────────
  class countNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      count: [:i |
        n := n + 1
        i > 0
      ]
    n

  // ── ifTrue: ─────────────────────────────────────────────────────────────────
  // Conditions are passed in (not literals) so the always-true/false lint does
  // not fire; callers pass `true` to drive the threading path.
  class ifTrueNonLastWriteOnly: flag =>
    m := 0
    flag ifTrue: [m := 9]
    m

  class ifTrueNonLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]
    sum

  // read+write conditional as the last expression.
  class ifTrueLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]

  // ── ifTrue:ifFalse: ──────────────────────────────────────────────────────────
  class ifTrueIfFalseNonLastReadWrite: flag =>
    x := 1
    flag ifTrue: [x := x + 1] ifFalse: [x := x + 100]
    x

  class ifTrueIfFalseAssignRhsReadWrite: flag =>
    x := 0
    _r := flag
      ifTrue: [
        x := 5
        42
      ]
      ifFalse: [0]
    x

  // ── on:do:/ensure: + nested conditional (BT-3176 axis 3) ────────────────────
  // NOT present here: a nested conditional as the LAST statement of an
  // `ensure:` try body (BT-3161 Flavor B / E5's shape) still fails erlc with
  // "unbound variable 'State'" in class-method context (same as value-type
  // context — see mutation_corpus_value.bt). See mutation_corpus_actor.bt's
  // `ensureNestedConditionalLastReadWrite` for the working fragment and
  // BT-3177 for the gap this discovery filed.

  // ── self-send as the mutation mechanism (BT-3176 axis 2) ────────────────────
  // A fragment method that calls another class method (a same-class self-send)
  // which mutates the class var, inside a loop/conditional body — not a direct
  // `self.field :=`. See BT-3159 (class-method conditional + self-send) and
  // BT-3150 (loop + self-send, actor context) for the bugs this generalizes.
  class bump => self.runs := self.runs + 1

  class selfSendWhileTrueNonLastReadWrite =>
    self.runs := 0
    i := 0
    [i < 5]
      whileTrue: [
        self bump
        i := i + 1
      ]
    self.runs

  // `needs_mutation_threading` requires a co-occurring outer-local read+write
  // alongside the class-var write/self-send — a bare self-send with no other
  // mutation in the block never reaches the threaded path at all (see
  // `resetRuns`/`bump`'s own callers in loop_class_var_mutation.bt).
  class selfSendIfTrueNonLastReadWrite: flag =>
    self.runs := 0
    seen := 0
    flag
      ifTrue: [
        self bump
        seen := seen + 1
      ]
    self.runs

  // ── on:do: + self-send (BT-3176 axis 3) ──────────────────────────────────────
  // NOT present here: a same-class self-send as the LAST statement of an
  // `on:do:` try body (BT-3161 Flavor A's shape) still produces invalid Core
  // Erlang (an empty value fragment before a doubled `in` — erlc
  // `core_parse_error`) in class-method context; BT-3161 only fixed the
  // Actor-context analogue. See mutation_corpus_actor.bt's
  // `onDoSelfSendLastReadWrite` for the working fragment and BT-3177 for the
  // class-method gap this discovery filed.

  // ── class-var mutation, threaded like an outer local (BT-3176 axis 4) ───────
  // Every fragment above threads an outer LOCAL; these mirror the same
  // constructs but mutate the class var directly instead.
  class classVarToDoNonLastReadWrite =>
    self.runs := 0
    seen := 0
    1
      to: 5
      do: [:i |
        self.runs := self.runs + i
        seen := seen + 1
      ]
    self.runs

  class classVarIfTrueNonLastReadWrite: flag =>
    self.runs := 0
    seen := 0
    flag
      ifTrue: [
        self.runs := self.runs + 7
        seen := seen + 1
      ]
    self.runs
