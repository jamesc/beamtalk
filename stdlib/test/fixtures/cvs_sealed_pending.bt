// BT-3704 (ADR 0130 Phase 1): rows of the sealed spelling that did not compile
// before ADR 0130; enabled by BT-3713.

sealed Object subclass: CvsSealedPending
  classState: n = 0

  class bump => self.n := self.n + 1

  class n => self.n

  class reset => self.n := 0

  class boom =>
    self bump
    1 / 0

  class rowTimes =>
    self reset
    3 timesRepeat: [self bump]
    self.n

  class rowLoopCondition =>
    self reset
    [self n < 3] whileTrue: [self bump]
    self.n

  class rowDo =>
    self reset
    #(1, 2, 3) do: [:x | self bump]
    self.n

  class rowCollect =>
    self reset
    #(1, 2, 3) collect: [:x | self bump]
    self.n

  class rowInject =>
    self reset
    #(1, 2, 3)
      inject: 0
      into: [:a :x |
        self bump
        a + x
      ]
    self.n

  // `1 / 0` raises a TypeError, so the inner handler names RuntimeError to decline it.
  class rowNonMatchingInnerEnsure =>
    self reset
    [
      [
        [
          self bump
          1 / 0
        ] on: RuntimeError do: [:e | nil]
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n

  class rowEnsureRaise =>
    self reset
    [
      [
        self bump
        1 / 0
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n

  class rowOwnNlrEnsure =>
    self reset
    [
      [
        self bump
        ^7
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    99
