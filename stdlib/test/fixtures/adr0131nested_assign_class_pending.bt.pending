// BT-3799 / BT-3860 (ADR 0131): a local assignment in value position (an
// operand, a literal element, an assignment's value, a conditional's receiver)
// at the method root and in loop and fold bodies. Its write must be visible to
// everything after it. The receivers (class, value type, actor) must agree.
//
// Inert: every method is a `ValuePositionLocalAssignment` compile error until
// BT-3860 (the BT-3864 stopgap; pinned by `adr0131_nested_assign_pins` in
// crates/beamtalk-core/src/semantic_analysis/tests/local_threading.rs). The
// expected answers are in stdlib/test/adr0131nested_assign_pending_test.bt.pending;
// BT-3860 drops the `.pending` suffixes. The hoisted forms that compile today
// are in adr0131nested_assign_{class,value,actor}.bt.

Object subclass: Adr0131NestedAssignPendingClass

  class rootPlain =>
    t := 0
    x := (t := t + 1) + 1
    #[t, x]

  class rootLiteral =>
    t := 0
    #[t, (t := 7), t]

  class doPlain =>
    t := 0
    #(1, 2) do: [:x | (t := t + 1) > 0]
    t

  class rootIf =>
    t := 0
    u := 0
    (t := t + 1) > 0 ifTrue: [u := 9]
    #[t, u]

  class doIf =>
    t := 0
    u := 0
    #(1, 2) do: [:x | (t := t + 1) > 1 ifTrue: [u := 9]]
    #[t, u]

  class doIfElse =>
    t := 0
    u := 0
    #(1, 2) do: [:x |
      (t := t + 1) > 1 ifTrue: [u := u + 9] ifFalse: [u := u + 1]
    ]
    #[t, u]

  class doAnd =>
    t := 0
    u := 0
    #(1, 2)
      do: [:x |
        (t := t + 1) > 1
          and: [
            u := 9
            true
          ]
      ]
    #[t, u]

  class doIfFalse =>
    t := 0
    u := 0
    #(1, 2) do: [:x | (t := t + 1) > 5 ifFalse: [u := u + 1]]
    #[t, u]

  class toDoIf =>
    t := 0
    u := 0
    1 to: 2 do: [:x | (t := t + 1) > 1 ifTrue: [u := 9]]
    #[t, u]

  class timesIf =>
    t := 0
    u := 0
    2 timesRepeat: [(t := t + 1) > 1 ifTrue: [u := 9]]
    #[t, u]

  class whileIf =>
    t := 0
    u := 0
    i := 0
    [i < 2]
      whileTrue: [
        (t := t + 1) > 1 ifTrue: [u := 9]
        i := i + 1
      ]
    #[t, u]

  class collectIf =>
    t := 0
    u := 0
    r := #(1, 2)
      collect: [:x |
        (t := t + 1) > 1 ifTrue: [u := 9]
        x
      ]
    #[t, u, r]

  class injectIf =>
    t := 0
    u := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        (t := t + 1) > 1 ifTrue: [u := 9]
        a + x
      ]
    #[t, u, r]
