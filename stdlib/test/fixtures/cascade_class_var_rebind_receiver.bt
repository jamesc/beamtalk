// BT-3412: minimal cascade receiver for
// stdlib/test/fixtures/cascade_class_var_rebind.bt — see that file for full
// context. `add:value:`'s own arguments are irrelevant to the test (only the
// hoisting they trigger matters); `noop` exists purely to make the cascade a
// genuine 2-message cascade rather than a single send.

Actor subclass: CascadeClassVarRebindReceiver

  add: _a value: _b -> Nil => nil

  noop -> Nil => nil
