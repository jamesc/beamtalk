// BT-2346: Shared mutation-fragment corpus — Actor context.
//
// Same fragment method names as MutationCorpusValue (the value-type corpus),
// so both the absolute oracle (BT-2346, value_type_mutation_matrix_test.bt) and
// the relative/metamorphic oracle (BT-2345) can run the *same* fragments across
// the Actor and value-type contexts and assert ground truth / cross-context
// equality respectively.
//
// These fragments thread *outer locals* (not Actor state fields) inside an
// Actor method body — the Actor context is the historically dense, working
// baseline that BT-2308/BT-2342 brought the value-type context up to. Each
// method returns the final threaded value, so a tuple-leak or dropped-mutation
// regression in either context surfaces as a wrong asserted value.

Actor subclass: MutationCorpusActor
  // BT-3176 axis 4: the actor's own state field, distinct from the outer
  // locals every fragment above threads. A fresh actor is spawned per test
  // (`actorCorpus => MutationCorpusActor spawn`), so this never bleeds state
  // across assertions.
  state: total = 0

  // ── to:do: ────────────────────────────────────────────────────────────────
  toDoNonLastWriteOnly =>
    last := 0
    1 to: 5 do: [:i | last := i]
    last

  toDoNonLastReadWrite =>
    sum := 0
    1 to: 5 do: [:i | sum := sum + i]
    sum

  toDoAssignRhsReadWrite =>
    sum := 0
    _r := (1 to: 5 do: [:i | sum := sum + i])
    sum

  // ── to:by:do: ───────────────────────────────────────────────────────────────
  toByDoNonLastWriteOnly =>
    last := 0
    1
      to: 10
      by: 2
      do: [:i | last := i]
    last

  toByDoNonLastReadWrite =>
    sum := 0
    1
      to: 10
      by: 2
      do: [:i | sum := sum + i]
    sum

  // ── timesRepeat: ────────────────────────────────────────────────────────────
  timesRepeatNonLastWriteOnly =>
    last := 0
    3 timesRepeat: [last := 7]
    last

  timesRepeatNonLastReadWrite =>
    count := 0
    5 timesRepeat: [count := count + 1]
    count

  // ── whileTrue: ──────────────────────────────────────────────────────────────
  whileTrueNonLastReadWrite =>
    n := 0
    [n < 5] whileTrue: [n := n + 1]
    n

  // ── whileFalse: ─────────────────────────────────────────────────────────────
  whileFalseNonLastReadWrite =>
    n := 0
    [n >= 5] whileFalse: [n := n + 1]
    n

  // ── (1 to: n) do: ──────────────────────────────────────────────────────────
  rangeDoNonLastReadWrite =>
    sum := 0
    (1 to: 5) do: [:i | sum := sum + i]
    sum

  // ── nested loop-in-loop (BT-3176 axis 1) ─────────────────────────────────────
  // Loop nested inside another loop, both threading the SAME outer local — see
  // mutation_corpus_value.bt for the BT-3172 cross-reference (direct class-var
  // mutation nested two loops deep is a deliberate compile error; that shape is
  // covered by crates/beamtalk-core/src/codegen/core_erlang/tests/gen_server.rs,
  // not here).
  nestedToDoNonLastReadWrite =>
    sum := 0
    1 to: 3 do: [:i | 1 to: 3 do: [:j | sum := sum + j]]
    sum

  // A nested loop where only the OUTER loop's top-level body mutates the actor
  // state field (the inner loop touches only its own local) — the compiling
  // counterpart of BT-3172's rejected inner-mutates shape. Class-var/state-field
  // threading is top-level-body-only by design (`loop_body_threads_class_vars`),
  // so this shape threads correctly and must keep doing so.
  nestedWhileTrueOuterOnlyStateReadWrite =>
    i := 0
    [i < 3]
      whileTrue: [
        self.total := self.total + 1
        j := 0
        [j < 3] whileTrue: [j := j + 1]
        i := i + 1
      ]
    self.total

  // ── construct-equivalence summing accumulators (BT-2345) ────────────────────
  // timesRepeat: / whileTrue: variants that SUM 1..5 (the count/n fragments
  // above only count iterations). Carry their own index so they are
  // sum-equivalent to to:do: / rangeDo, letting the metamorphic harness assert
  // construct equivalence *within the Actor context*. See
  // metamorphic_threading_test.bt relation 3.
  timesRepeatAccumulatorReadWrite =>
    sum := 0
    i := 1
    5
      timesRepeat: [
        sum := sum + i
        i := i + 1
      ]
    sum

  whileTrueAccumulatorReadWrite =>
    sum := 0
    i := 1
    [i <= 5]
      whileTrue: [
        sum := sum + i
        i := i + 1
      ]
    sum

  // ── collect: ────────────────────────────────────────────────────────────────
  // NonLast: collect is a bare side-effect statement; result is discarded.
  collectNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      collect: [:i |
        n := n + 1
        i * 2
      ]
    n

  // AssignRhs: collect result is bound to a local (different codegen path).
  collectAssignRhsReadWrite =>
    n := 0
    _r := #(1, 2, 3)
      collect: [:i |
        n := n + 1
        i * 2
      ]
    n

  // ── select: ─────────────────────────────────────────────────────────────────
  selectNonLastReadWrite =>
    n := 0
    #(1, 2, 3, 4)
      select: [:i |
        n := n + 1
        i > 2
      ]
    n

  // ── reject: ─────────────────────────────────────────────────────────────────
  rejectNonLastReadWrite =>
    n := 0
    #(1, 2, 3, 4)
      reject: [:i |
        n := n + 1
        i > 2
      ]
    n

  // ── inject:into: ─────────────────────────────────────────────────────────────
  // NonLast: inject result is discarded; only the outer local matters.
  injectNonLastReadWrite =>
    t := 0
    #(1, 2, 3)
      inject: 0
      into: [:a :b |
        t := t + b
        a + b
      ]
    t

  // AssignRhs: inject result bound to a local.
  injectAssignRhsReadWrite =>
    t := 0
    _r := #(1, 2, 3)
      inject: 0
      into: [:a :b |
        t := t + b
        a + b
      ]
    t

  // BT-2378: AssignRhs where the assignment *target* is itself the threaded local
  // mutated inside the construct. The target must observe the construct's logical
  // result (element 1 of the {value, StateAcc} tuple — here the inject fold = 106),
  // NOT the threaded accumulator value (__local__total = 6). The Actor assign-RHS path
  // wrongly rebound the target from the threaded state before the fix.
  injectAssignRhsTargetMutated =>
    total := 0
    total := (#(1, 2, 3)
      inject: 100
      into: [:a :b |
        total := total + b
        a + b
      ])
    total

  // ── detect: ─────────────────────────────────────────────────────────────────
  detectNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      detect: [:i |
        n := n + 1
        i > 10
      ]
      ifNone: [-1]
    n

  // ── count: ──────────────────────────────────────────────────────────────────
  countNonLastReadWrite =>
    n := 0
    #(1, 2, 3)
      count: [:i |
        n := n + 1
        i > 0
      ]
    n

  // ── ifTrue: ─────────────────────────────────────────────────────────────────
  // Conditions are passed in (not literals) so the always-true/false lint does
  // not fire; callers pass `true` to drive the threading path.
  ifTrueNonLastWriteOnly: flag =>
    m := 0
    flag ifTrue: [m := 9]
    m

  ifTrueNonLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]
    sum

  ifTrueLastReadWrite: flag =>
    sum := 0
    flag ifTrue: [sum := sum + 7]

  // ── ifTrue:ifFalse: ──────────────────────────────────────────────────────────
  ifTrueIfFalseNonLastReadWrite: flag =>
    x := 1
    flag ifTrue: [x := x + 1] ifFalse: [x := x + 100]
    x

  ifTrueIfFalseAssignRhsReadWrite: flag =>
    x := 0
    _r := flag
      ifTrue: [
        x := 5
        42
      ]
      ifFalse: [0]
    x

  // ── on:do:/ensure: + nested conditional (BT-3176 axis 3) ────────────────────
  // The try body's LAST statement is a nested conditional mutating the same
  // outer local assigned earlier in the try body — BT-3161 Flavor B / E5's
  // shape (`ambiguous_catch_try_state`), folded into the shared corpus so the
  // metamorphic/matrix harnesses cover it too, not just the dedicated
  // bt3161nested_conditional_actor.bt fixture. The value-type/class-method
  // analogue (mutation_corpus_value.bt/mutation_corpus_class_method.bt's own
  // copies of this fragment) was fixed by BT-3177.
  ensureNestedConditionalLastReadWrite: flag =>
    t := 0
    [
      t := t + 1
      flag ifTrue: [t := t + 10]
    ] ensure: [nil]
    t

  // ── self-send as the mutation mechanism (BT-3176 axis 2) ────────────────────
  // A fragment method that calls another method (a same-actor self-send) which
  // mutates the actor's own state field, inside a loop/conditional body — not
  // a direct `self.field :=`. See BT-3150 (whileTrue:) and
  // mutation_corpus_class_method.bt's `bump`-based fragments for the
  // class-method analogue.
  bump => self.total := self.total + 1

  selfSendWhileTrueNonLastReadWrite =>
    i := 0
    [i < 5]
      whileTrue: [
        self bump
        i := i + 1
      ]
    self.total

  // `needs_mutation_threading` requires a co-occurring outer-local read+write
  // alongside the field write/self-send — a bare self-send with no other
  // mutation in the block never reaches the threaded path at all (see
  // mutation_corpus_class_method.bt's classState comment).
  selfSendIfTrueNonLastReadWrite: flag =>
    seen := 0
    flag
      ifTrue: [
        self bump
        seen := seen + 1
      ]
    self.total

  // ── on:do: + self-send (BT-3176 axis 3) ──────────────────────────────────────
  // The try body's LAST statement is a self-send that mutates state — BT-3161
  // Flavor A's exact shape, folded into the shared corpus so the
  // metamorphic/matrix harnesses cover it too, not just the dedicated
  // bt3161self_send_actor.bt fixture. The class-method analogue
  // (mutation_corpus_class_method.bt's own copy of this fragment) was fixed
  // by BT-3177.
  onDoSelfSendLastReadWrite =>
    t := 0
    [
      t := t + 1
      self bump
    ] on: Error do: [:e | nil]
    t

  // ── class-var / state-field mutation, threaded like an outer local (BT-3176 axis 4) ──
  // Every fragment above threads an outer LOCAL (see file header); these mirror
  // the same constructs but mutate the actor's own state field instead — the
  // shape the actor corpus explicitly excluded until now.
  stateFieldToDoNonLastReadWrite =>
    seen := 0
    1
      to: 5
      do: [:i |
        self.total := self.total + i
        seen := seen + 1
      ]
    self.total

  stateFieldIfTrueNonLastReadWrite: flag =>
    seen := 0
    flag
      ifTrue: [
        self.total := self.total + 7
        seen := seen + 1
      ]
    self.total

  // ── self-send POSITION axis (BT-3414, ADR 0118 phase 0) ─────────────────
  // `bump`'s own mutation to `self.total`, nested at one SYNTACTIC POSITION
  // per fragment — the same axis
  // stdlib/test/fixtures/self_send_position_counter.bt /
  // stdlib/test/actor_self_send_position_matrix_test.bt pin in isolation,
  // joining the shared corpus so the absolute oracle
  // (value_type_mutation_matrix_test.bt) and the metamorphic oracle
  // (metamorphic_threading_test.bt) cover it too. Actor-only: a self-send
  // that mutates actor state has no Value/class-method analogue.
  binaryOperandSelfSendReadWrite =>
    n := 1 + (self bump)
    n

  keywordArgumentSelfSendReadWrite => #(10, 20, 30) at: (self bump)

  assignRhsSubExprSelfSendReadWrite =>
    n := 0
    n := 100 + (self bump)
    n

  cascadeOnSelfReadWrite =>
    self bump; bump
    self.total

  whileTrueConditionSelfSendReadWrite =>
    i := 0
    [
      i := i + 1
      (self bump) + i < 5
    ] whileTrue: [nil]
    i

  matchArmSelfSendReadWrite: v =>
    v match: [
      1 -> 1 + (self bump);
      _ -> 0
    ]
