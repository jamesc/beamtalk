// BT-4113: an actor whose methods thread an outer local through the state map
// (under a `__local__` key) and one that threads nothing. Generated callbacks
// skip the `__local__` strip scan when the committed state has exactly the
// declared size, so both must still commit identical, clean state.

Actor subclass: StateSizeGuardActor
  state: total = 0

  addAll: items =>
    sum := 0
    items do: [:x | sum := sum + x]
    self.total := self.total + sum
    sum

  add: n =>
    self.total := self.total + n
    self.total

  total => self.total
