// BT-3949: the class-method column of bt3949literal_arm_actor.bt. A class
// method threads no `State`, so a self-call `collect:` is a plain value here;
// these pin that it answers the same in every literal and keyword position of
// an `ifTrue:`/`ifFalse:` or `match:` arm. The expected answers are in
// stdlib/test/bt3949literal_arm_test.bt.

Object subclass: Bt3949LiteralArmClass

  class wrap: x => x * 10

  class mapIf: flag =>
    data := flag ifTrue: [
      #{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])}
    ] ifFalse: [#{"xs" => #()}]
    data at: "xs"

  class arrayIf: flag =>
    data := flag ifTrue: [
      #[0, (#(1, 2) asList collect: [:s | self wrap: s])]
    ] ifFalse: [#[0, #()]]
    data at: 2

  class keywordIf: flag =>
    data := flag ifTrue: [
      #{} at: "xs" put: (#(1, 2) asList collect: [:s | self wrap: s])
    ] ifFalse: [#{"xs" => #()}]
    data at: "xs"

  class mapIfFalse: flag =>
    data := flag ifTrue: [
      #{"xs" => #()}
    ] ifFalse: [#{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])}]
    data at: "xs"

  class mapMatch: x =>
    data := x match: [
      1 -> #{"xs" => (#(1, 2) asList collect: [:s | self wrap: s])};
      _ -> #{"xs" => #()}
    ]
    data at: "xs"

  class arrayMatch: x =>
    data := x match: [
      1 -> #[0, (#(1, 2) asList collect: [:s | self wrap: s])];
      _ -> #[0, #()]
    ]
    data at: 2

  class keywordMatch: x =>
    data := x match: [
      1 -> (#{} at: "xs" put: (#(1, 2) asList collect: [:s | self wrap: s]));
      _ -> #{"xs" => #()}
    ]
    data at: "xs"
