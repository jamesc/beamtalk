// BT-1457: Server subclass fixture for handleInfo: codegen testing
// BT-4077: `watch:` monitors a pid from inside this Server, so the DOWN
// lands in `handleInfo:` (and `getLastMsg`).

Server subclass: HandleInfoCounter
  state: count = 0
  state: lastMsg = nil

  handleInfo: msg =>
    msg == #tick ifTrue: [
      self.count := self.count + 1
    ] ifFalse: [self.lastMsg := msg]

  getCount => self.count

  getLastMsg => self.lastMsg

  watch: aPid => aPid monitor
