// BT-3756 (ADR 0131 §6): value-type column of
// adr0131section6escape_actor.bt (blocks that write no local of the method
// frame stay legal when returned or placed in a collection literal).

Value subclass: Adr0131Section6EscapeValue

  returnedPure => [:x | x + 1]

  returnedOwnLocal =>
    ^[:x |
      y := x * 2
      y + 1
    ]

  returnedReadOnly =>
    t := 10
    ^[:x | x + t]

  literalOfPure => #([:x | x + 1], [:x | x * 2])

  // BT-3859: what a method whose last statement is a local assignment
  // answers (asserted in adr0131section6escape_test.bt; BT-3882).
  lastStatementAssignment => _r := 5

  lastStatementBlockAssignment => _b := [:x | x + 1]

  lastStatementArmAssignment: c => c ifTrue: [_r := 7] ifFalse: [nil]
