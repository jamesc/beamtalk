// BT-3965 fixture: DynamicSupervisor whose children are killed at once on
// shutdown. See stdlib/test/supervision_shutdown_test.bt.

DynamicSupervisor(Bt3965SlowStopper) subclass: Bt3965BrutalPool

  childClass => Bt3965SlowStopper

  childShutdown -> Symbol => #brutalKill
