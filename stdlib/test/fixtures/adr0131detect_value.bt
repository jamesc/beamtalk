    [
      #(1, 2)
        detect: [:v | v > 5]
        ifNone: [
          t := t + 100
          0
        ]
    ] on: Error do: [:e | 0]
    t

  inEnsureHandler =>
    t := 0
    [
      #(1, 2)
        detect: [:v | v > 5]
        ifNone: [
          t := t + 100
          0
        ]
    ] ensure: [nil]
    t

