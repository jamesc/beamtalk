  topHandler =>
    t := 0
    #(1, 2)
      detect: [:v | v > 5]
      ifNone: [
        t := t + 100
        0
      ]
    t

  inArmHandler: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2)
          detect: [:v | v > 5]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  inArmElseHandler: c =>
    t := 0
    c
      ifTrue: [t := 100]
      ifFalse: [
        #(1, 2)
          detect: [:v | v > 5]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

  inDoHandler =>
    t := 0
    #(1, 2)
      do: [:z |
        #(1, 2)
          detect: [:v | v > 5]
          ifNone: [
            t := t + 100
            0
          ]
      ]
    t

