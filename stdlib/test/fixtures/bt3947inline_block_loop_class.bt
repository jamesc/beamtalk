// BT-3947 (closes BT-3948): a literal block applied in place that assigns a
// local of its own, in a loop or fold body or a loop condition. BT-3948 made
// the actor shapes a compile error (they failed erlc or answered a carrier);
// they answer what the class-method twin answers now.

Object subclass: Bt3947InlineBlockLoopClass
  classState: n = 0

  class cell0 =>
    t := 0
    1
      to: 3
      do: [:i |
        t := t + ([:z |
          w := 0
          z > 0 ifTrue: [w := z]
          w
        ] value: i)
      ]
    t

