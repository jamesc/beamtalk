// BT-3704 (ADR 0130 Phase 1): rows of the override spelling that did not compile
// before ADR 0130; enabled by BT-3713.

Object subclass: CvsOverrideBasePending
  classState: n = 0

  class bump => self.n

  class writeN => self.n := self.n + 1

  class n => self.n


  class reset => self.n := 0


  class boom =>
    self bump
    1 / 0


  class rowLoopCondition =>
    self reset
    [self n < 3] whileTrue: [self bump]
    self.n


  // `1 / 0` raises a TypeError, so the inner handler names RuntimeError to decline it.
  class rowNonMatchingInnerEnsure =>
    self reset
    [
      [
        [
          self bump
          1 / 0
        ] on: RuntimeError do: [:e | nil]
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n

