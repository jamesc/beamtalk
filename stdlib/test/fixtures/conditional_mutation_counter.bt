// BT-915: Actor fixture for testing self.slot := inside conditional blocks
// Exercises ifTrue:, ifFalse:, and ifTrue:ifFalse: with field mutation threading

Actor subclass: ConditionalMutationCounter
  state: count = 0
  state: items :: List(Integer) = #(10, 20, 30)

  // Increment count only when flag is true
  conditionalIncrement: flag =>
    flag ifTrue: [self.count := self.count + 1]
    self.count

  // Decrement count only when flag is false
  conditionalDecrement: flag =>
    flag ifFalse: [self.count := self.count - 1]
    self.count

  // Two-branch conditional: +10 if true, -1 if false
  conditionalToggle: flag =>
    flag ifTrue: [
      self.count := self.count + 10
    ] ifFalse: [self.count := self.count - 1]
    self.count

  // Method with two sequential conditional mutations
  doubleConditional: a and: b =>
    a ifTrue: [self.count := self.count + 1]
    b ifTrue: [self.count := self.count + 10]
    self.count

  // Nested conditionals: outer and inner both have mutations
  nestedConditional: outer and: inner =>
    outer ifTrue: [inner ifTrue: [self.count := self.count + 100]]
    self.count

  // Conditional as last expression (no trailing self.count)
  conditionalLast: flag => flag ifTrue: [self.count := self.count + 5]

  // BT-1225: Local var assigned inside ifTrue: block, then used in same block
  // Exercises the __local__ prefix key consistency fix
  incrementViaLocalVar: flag =>
    flag
      ifTrue: [
        y := self.count + 1
        self.count := y
      ]
    self.count

  // BT-1225: Same pattern for ifFalse:
  decrementViaLocalVar: flag =>
    flag
      ifFalse: [
        y := self.count - 1
        self.count := y
      ]
    self.count

  // BT-3382: self-send as the RECEIVER of ifTrue:ifFalse: (not inside either
  // block body) must still thread the callee's own state mutation. Branch
  // selection alone proves the self-send ran (its Boolean return value
  // picks the branch) but does not, by itself, prove its mutation was
  // observed afterward.
  recordThenBranch: flag =>
    (self recordOnce: flag) ifTrue: [#recorded] ifFalse: [#gaveUp]

  internal recordOnce: flag =>
    self.count := self.count + 1
    flag

  // BT-3382 regression: `respondsTo:` is a self-send but is intercepted
  // BEFORE self-dispatch (BT-1420) — using it as a conditional receiver must
  // not be routed through the self-dispatch-shortcut codegen, which builds
  // a `safe_dispatch` call for the selector atom and would crash with
  // does_not_understand since `respondsTo:` is never a real dispatch-table
  // entry.
  respondsToAsReceiver: sel =>
    (self respondsTo: sel) ifTrue: [#yes] ifFalse: [#no]

  // BT-3392: self-send nested inside a binary-op operand within an ifTrue:
  // block body — `1 + (self bumpCount: true)` — not the block's own
  // top-level statement, not the conditional's receiver. The arithmetic
  // result is discarded (this is the block's only statement, but the
  // enclosing method's own last expression is `self.count` below), so the
  // only way to observe the fix is the mutation `bumpCount:` performs.
  recordViaBinaryOpOperand: flag =>
    flag ifTrue: [1 + (self bumpCount: true)] ifFalse: [0]
    self.count

  internal bumpCount: _unused =>
    self.count := self.count + 1
    1

  // BT-3392 follow-up: a self-send as a binary-op ARGUMENT must not be
  // hoisted ahead of an earlier, non-self-send operand in the SAME chain
  // that can itself raise — (self.items at: idx) + (self bumpCount: true)
  // must raise from an out-of-bounds `at:` WITHOUT ever running
  // bumpCount:'s mutation first. Hoisting unconditionally (the original
  // BT-3392 mechanism, before this fix) would run the mutation before
  // `at:` gets a chance to fail, reversing source evaluation order.
  orderSensitiveBinaryOp: idx flag: flag =>
    flag ifTrue: [(self.items at: idx) + (self bumpCount: true)] ifFalse: [0]
    self.count

  // BT-3392: verifies (rather than fixes) a shape confirmed by inspecting
  // github.com/jamesc/beamtalk-watcher's actual `CheckRegistry.bt` — a
  // self-send as the SOLE top-level statement of an `on:do:`-protected
  // block, itself the sole statement of an `ifTrue:` block (mirrors
  // `monitorExited:reason:`'s `[self spawnMonitorFor: name] on: Error do:
  // [...]`, nested inside `withinBudget ifTrue: [...]`). Already threaded
  // correctly before this issue via the pre-existing `on:do:`/C11 handling
  // (`control_flow/exception_handling.rs`) — this test exists to pin that
  // down as a regression guard, not because it was ever broken.
  recordViaOnDoProtectedBlock: flag =>
    flag ifTrue: [
      [self recordOnce: true] on: Error do: [:e | false]
    ] ifFalse: [false]
    self.count

  getCount => self.count

  reset => self.count := 0
