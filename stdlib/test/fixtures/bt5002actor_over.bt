// BT-5002: a class below the owner that overrides `greet` and `kind`; the
// override must beat an extension on the owner.

Bt5002ActorMid subclass: Bt5002ActorOver

  class kind -> Symbol => #compiledOverKind

  greet -> Symbol => #compiledOver
