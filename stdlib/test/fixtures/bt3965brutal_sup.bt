// BT-3965 fixture: static supervisor whose child is `withShutdown:
// #brutalKill` — killed at once, terminate: never runs. See
// stdlib/test/supervision_shutdown_test.bt.

Supervisor subclass: Bt3965BrutalSup

  strategy -> #oneForOne | #oneForAll | #restForOne => #oneForOne

  childSpecs -> List =>
    spec := (Bt3965SlowStopper supervisionSpec withArgs: #{
      #tableName => #bt3965Shutdown
    }) withShutdown: #brutalKill
    #(spec)
