// An Actor whose user-defined HOMs forward an OPAQUE (non-literal) block
// across a self-send straight to a stdlib collection primitive, for the
// operators beyond `do:`/`collect:`/`select:` (`inject:into:`, `detect:`,
// `detect:ifNone:` and its `ifNone:` handler, `count:`, `anySatisfy:`,
// `allSatisfy:`, `reject:`, `flatMap:`, `takeWhile:`, `dropWhile:`,
// `partition:`, `groupBy:`, `sort:`) and for `Array`/`Set` receivers
// (BT-3615, BT-3908).
//
// Since ADR 0133 removed the ADR 0128 fold (BT-3908), every forwarded
// callable goes through the one arity-normalizing wrapper
// (`non_literal_callable_doc`). The `pure*` callers below pass blocks that
// change no state. (Callers whose blocks wrote `self.total` used to promote
// each HOM's block position to Tier 2 and raise `stateful_block_dispatch`; since
// BT-3922 they are an ADR 0133 compile error, so they are no longer fixtures.)

Actor subclass: SelfSendHomFoldPool
  state: items = #(1, 2, 3, 4)
  state: arr = #[1, 2, 3, 4]
  state: set = #(1, 2, 3, 4) asSet
  state: total = 0
  state: groups = #(#(1, 2), #(3))

  // ── forwarding HOMs: opaque `block` straight to the primitive ─────────────
  sealed fwdInject: initial into: block =>
    self.items inject: initial into: block

  sealed fwdDetect: block => self.items detect: block

  sealed fwdDetect: block ifNone: noneBlock =>
    self.items detect: block ifNone: noneBlock

  sealed fwdCount: block => self.items count: block

  sealed fwdAnySatisfy: block => self.items anySatisfy: block

  sealed fwdAllSatisfy: block => self.items allSatisfy: block

  sealed arrDo: block => self.arr do: block

  sealed arrCollect: block => self.arr collect: block

  sealed arrInject: initial into: block => self.arr inject: initial into: block

  sealed setDo: block => self.set do: block

  sealed setCollect: block => self.set collect: block

  setSelect: block => self.set select: block

  sealed setInject: initial into: block => self.set inject: initial into: block

  // Opaque-callable folds in expression position (a receiver, a binary
  // operand, a conditional receiver) and inside a conditional arm / loop
  // body — each must unwrap the fold's `{Result, NewState}` tuple and
  // thread its `State`, not leak the tuple as a value or drop the state.
  nestedCollectSize: block => (self.items collect: block) size

  nestedInjectPlusOne: block => (self.items inject: 0 into: block) + 1

  nestedAnyAnswer: block =>
    (self.items anySatisfy: block) ifTrue: ["yes"] ifFalse: ["no"]

  sealed doWhen: flag with: block =>
    flag ifTrue: [self.items do: block]
    nil

  sealed injectTwice: block =>
    t := 0
    1 to: 2 do: [:_k | t := t + (self.items inject: 0 into: block)]
    t

  sealed countUpWhile: block =>
    i := 0
    [(self.items count: block) > i] whileTrue: [i := i + 1]
    i

  sealed fwdReject: block => self.items reject: block

  sealed fwdFlatMap: block => self.items flatMap: block

  sealed fwdTakeWhile: block => self.items takeWhile: block

  sealed fwdDropWhile: block => self.items dropWhile: block

  sealed fwdPartitionSize: block => (self.items partition: block) size

  sealed fwdGroupBySize: block => (self.items groupBy: block) size

  sealed fwdSort: block => self.items sort: block

  sealed fwdIfNone: noneBlock =>
    self.items detect: [:x | x > 20] ifNone: noneBlock

  // ── callers inside the actor (BT-3908) ──────────────────────────────────
  pureInject => self fwdInject: 0 into: [:a :x | a + x]

  pureDetect => self fwdDetect: [:x | x > 2]

  pureDetectIfNone => self fwdDetect: [:x | x > 20] ifNone: [7]

  pureCount => self fwdCount: [:x | x > 2]

  pureAnySatisfy => self fwdAnySatisfy: [:x | x > 3]

  pureAllSatisfy => self fwdAllSatisfy: [:x | x > 0]

  pureArrCollect => self arrCollect: [:x | x * 2]

  pureReject => self fwdReject: [:x | x > 2]

  pureFlatMap => self fwdFlatMap: [:x | #(1)]

  pureTakeWhile => self fwdTakeWhile: [:x | x < 3]

  pureDropWhile => self fwdDropWhile: [:x | x < 3]

  purePartitionSize => self fwdPartitionSize: [:x | x > 2]

  pureGroupBySize => self fwdGroupBySize: [:x | x isEven]

  pureSort => self fwdSort: [:a :b | a > b]

  pureIfNone => self fwdIfNone: [7]

  // The predicate writes a field (a literal block of an inlined
  // `detect:ifNone:`, so legal). The `ifNone:` handler is passed the field
  // value instead of reading `self.total` itself: a block that reads a field
  // and is passed to an actor's own method would see the value from when it
  // was made, so that is a compile error (BT-3952).
  sealed fwdIfNoneAfterFold: noneBlock =>
    self.items
      detect: [:x |
        self.total := self.total + 1
        x > 20
      ]
      ifNone: [noneBlock value: self.total]

  pureIfNoneAfterFold =>
    self.total := 0
    self fwdIfNoneAfterFold: [:seen | seen]

  // A block that rebinds a block-local inside an inner loop (BT-3939).
  weight: y => y * 10

  sealed fwdGroupsCollect: block => self.groups collect: block

  groupWeights =>
    self
      fwdGroupsCollect: [:xs |
        n := 0
        xs do: [:y | n := n + (self weight: y)]
        n
      ]

  // A Tier 1 block of one argument too many for its position (an `ifNone:`
  // handler takes none).
  oneArgBlock => [:x | 7]

  wrongArityIfNone => self.items detect: [:x | x > 20] ifNone: self oneArgBlock

// BT-3615's other callers, a block that assigns a captured local through each
// forwarding HOM, are ADR 0133 escaping-block compile errors since BT-3902.
