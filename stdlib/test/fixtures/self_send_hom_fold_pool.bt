// BT-3615 (ADR 0128 scope extension): `self_send_hom_pool.bt`'s shape —
// an Actor whose user-defined HOM forwards an OPAQUE (non-literal) block
// across a self-send straight to a stdlib collection primitive — for the
// operators BT-3583 did not cover (`inject:into:`, `detect:`,
// `detect:ifNone:`, `count:`, `anySatisfy:`, `allSatisfy:`) and for
// `Array`/`Set` receivers. Before the fix every one of the six operators
// CRASHED when the forwarded block was a Tier 2 (captured-local-mutating)
// block — `badarity` for `inject:into:`, `function_clause` inside
// `lists:any/all/filter`, a type error inside `beamtalk_list:detect` — and
// a `Set` `collect:`/`select:` answered a `List`.

Actor subclass: SelfSendHomFoldPool
  state: items = #(1, 2, 3, 4)
  state: arr = #[1, 2, 3, 4]
  state: set = #(1, 2, 3, 4) asSet
  state: total = 0

  // ── forwarding HOMs: opaque `block` straight to the primitive ─────────────
  sealed fwdInject: initial into: block =>
    self.items inject: initial into: block

  sealed fwdDetect: block => self.items detect: block

  sealed fwdDetect: block ifNone: noneBlock =>
    self.items detect: block ifNone: noneBlock

  sealed fwdCount: block => self.items count: block

  sealed fwdAnySatisfy: block => self.items anySatisfy: block

  sealed fwdAllSatisfy: block => self.items allSatisfy: block

  sealed arrDo: block => self.arr do: block

  sealed arrCollect: block => self.arr collect: block

  sealed arrInject: initial into: block => self.arr inject: initial into: block

  sealed setDo: block => self.set do: block

  sealed setCollect: block => self.set collect: block

  setSelect: block => self.set select: block

  sealed setInject: initial into: block => self.set inject: initial into: block

  // Opaque-callable folds in expression position (a receiver, a binary
  // operand, a conditional receiver) and inside a conditional arm / loop
  // body — each must unwrap the fold's `{Result, NewState}` tuple and
  // thread its `State`, not leak the tuple as a value or drop the state.
  nestedCollectSize: block => (self.items collect: block) size

  nestedInjectPlusOne: block => (self.items inject: 0 into: block) + 1

  nestedAnyAnswer: block =>
    (self.items anySatisfy: block) ifTrue: ["yes"] ifFalse: ["no"]

  sealed doWhen: flag with: block =>
    flag ifTrue: [self.items do: block]
    nil

  sealed injectTwice: block =>
    t := 0
    1 to: 2 do: [:_k | t := t + (self.items inject: 0 into: block)]
    t

  sealed countUpWhile: block =>
    i := 0
    [(self.items count: block) > i] whileTrue: [i := i + 1]
    i

// BT-3615's callers, a Tier 2 block (one that assigns a captured local, or a
// captured local and `self.total`) through each forwarding HOM, are ADR 0133
// escaping-block compile errors since BT-3902; actor_self_send_hom_test.bt
// sends the HOMs pure blocks.
