// BT-1664: Test fixture for performLocally:withArguments:
// Open, stateless class with a class method that returns the caller's Erlang
// PID: it runs in the caller (ADR 0142).

Object subclass: LocalCallHelper

  class callerPid =>
    @expect class_method_process_resource "the test observes that the method runs in the caller"
    Erlang erlang self

  class echo: value => value

  class add: a to: b => a + b
