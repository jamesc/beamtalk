// BT-3581: Shared mutation-fragment corpus — Actor CLASS-METHOD context.
//
// Peer of mutation_corpus_class_method.bt, but rooted on an `Actor subclass:`
// instead of `Object subclass:`. Every prior class-method corpus cell was
// exercised only against a ValueType-rooted class, on the documented
// assumption (see `eligible_families`'s doc comment in
// crates/beamtalk-codegen/src/core_erlang/control_flow/analysis.rs) that "an
// Actor's and a ValueType's class methods compile identically." That is true
// for the `ClassVars` family threading ADR 0122 unified, but two SEPARATE
// call sites never adopted the equivalent guard and were only found by
// giving the class-method corpus this Actor-rooted twin:
//
// 1. `exception_body_outer_state` (exception_handling.rs) branches on
//    `self.context` alone, so an Actor subclass's own class-side
//    `on:do:`/`ensure:` block seeded its `StateAcc` scratch map from the
//    bare `State` identifier, which does not exist in a class method
//    (`erlc: unbound variable 'State'`) — the `*LocalOnly*`/
//    `ensureNestedConditionalLastReadWrite:` fragments below.
// 2. `is_actor_self_send` (expr_shape.rs) also branched on `ctx.context`
//    alone, so a same-class self-send (`self bump`) inside a class-method
//    loop/conditional body (`control_flow/body.rs`) or `on:do:`/`ensure:`
//    body (`exception_handling.rs`'s E2 branch) was misrouted through
//    `safe_dispatch` — the actor INSTANCE self-dispatch mechanism, which
//    reads a `State` parameter that does not exist in a class method AND
//    dispatches through the class's own gen_server from inside a call it is
//    already synchronously handling. This did not fail to compile: it
//    deadlocked (or, when the fallback selector-not-found path raised a
//    `dispatch_error` instead of hanging, was silently miscompiled into a
//    caught "would deadlock" error) at RUNTIME — the `selfSend*`/
//    `onDoSelfSend*` fragments below.

Actor subclass: MutationCorpusActorClassMethod
  // Actor subclasses require at least the instance-state shape; unused by
  // any class-method fragment below (they only thread outer LOCALS).
  state: unused = 0
  // BT-3584: a class var, distinct from the outer locals the fragments
  // above thread — the peer of mutation_corpus_class_method.bt's own
  // `runs`. Every fragment that reads/writes it resets it to 0 first, same
  // rationale as that file's own `runs` field.
  classState: runs = 0

  // Byte-for-byte the same body as mutation_corpus_class_method.bt's
  // `onDoSelfSendLastReadWrite`'s sibling `ensureNestedConditionalLastReadWrite:`
  // shape, minus the self-send — the plainest possible `on:do:`/`ensure:`
  // outer-local mutation, now on an Actor-rooted class.
  class ensureLocalOnlyReadWrite =>
    t := 0
    [
      t := t + 1
      nil
    ] ensure: [nil]
    t

  class onDoLocalOnlyReadWrite =>
    t := 0
    [
      t := t + 1
      nil
    ] on: Error do: [:e | nil]
    t

  // Nested-conditional-as-last-statement shape (BT-3176 axis 3) — the exact
  // peer of mutation_corpus_class_method.bt's `ensureNestedConditionalLastReadWrite:`.
  class ensureNestedConditionalLastReadWrite: flag =>
    t := 0
    [
      t := t + 1
      flag ifTrue: [t := t + 10]
    ] ensure: [nil]
    t

  // ── self-send as the mutation mechanism (`is_actor_self_send` gap) ────────
  // BT-3584: now mutates `runs` (was `class bump => 1`, a no-op that could
  // never expose the Foldl-shape `ClassVars`-threading gap below, since
  // there was no class var to lose) — every fragment above this point
  // returns an outer LOCAL, unaffected by `bump`'s own body, so this change
  // is safe for them.
  class bump => self.runs := self.runs + 1

  // Peer of mutation_corpus_class_method.bt's `selfSendWhileTrueNonLastReadWrite`
  // (`control_flow/body.rs`'s loop-body self-send branch).
  class selfSendWhileTrueNonLastReadWrite =>
    seen := 0
    i := 0
    [i < 5]
      whileTrue: [
        self bump
        i := i + 1
        seen := seen + 1
      ]
    seen

  // Peer of mutation_corpus_class_method.bt's `onDoSelfSendLastReadWrite`
  // (`exception_handling.rs`'s E2 branch — the exact shape
  // `ExduraHttpServer`'s own route handlers use: a same-class self-send as
  // the `on:do:` try body's LAST statement, alongside a local mutation).
  class onDoSelfSendLastReadWrite =>
    t := 0
    [
      t := t + 1
      self bump
    ] on: Error do: [:e | nil]
    t

  // BT-3584: the `Foldl*` (`do:`/`collect:`) counterpart of
  // `selfSendWhileTrueNonLastReadWrite` above (a Letrec-shaped construct,
  // which already threaded `ClassVars` correctly for an Actor class method
  // before this issue) — a same-class self-send plus a co-occurring
  // outer-local read+write inside a NON-last `do:`/`collect:` statement,
  // followed by a POST-FOLD read of the class var. Before the fix,
  // `plan.rs`'s `threads_class_vars_answer` unconditionally excluded
  // `CodeGenContext::Actor` from a Foldl* body's own `ClassVars` threading —
  // stale since BT-3581 fixed `is_actor_self_send` to exclude
  // `in_class_method()` too — so the mutation compiled but was silently
  // dropped: `self.runs` read back `0` instead of `5`, with no diagnostic
  // and no compile error.
  class selfSendDoNonLastReadWrite =>
    self.runs := 0
    seen := 0
    (1 to: 5)
      do: [:x |
        self bump
        seen := seen + 1
      ]
    self.runs

  // BT-3584's `collect:` peer — see `selfSendDoNonLastReadWrite` above.
  // Also exercises BT-3611's `unbound 'ClassVarsN'` fix
  // (`generate_vt_foldl_list_op_open`), since lifting the Actor exclusion
  // alone would otherwise route this fragment into that same crash the
  // Object-rooted `mutation_corpus_class_method.bt` twin hit.
  class selfSendCollectNonLastReadWrite =>
    self.runs := 0
    seen := 0
    (1 to: 5)
      collect: [:x |
        self bump
        seen := seen + 1
        x
      ]
    self.runs

  // ── opaque (non-literal) callable forwarded to a collection HOM (BT-3615) ──
  // ADR 0128 / BT-3583 / BT-3615: each `opaque*:` helper forwards its block
  // parameter — opaque at the primitive's call site — straight to
  // `do:`/`collect:`/`select:`/`inject:into:`/`detect:`/`detect:ifNone:`/
  // `count:`/`anySatisfy:`/`allSatisfy:`. In Actor instance context that
  // lowers to ADR 0128's `State`-threading `lists:foldl`; in value-type and
  // class-method context to the plain-value path (no `State` map). The
  // `opaque*NonLastReadWrite` fragments pass a PURE block (the one shape
  // every context supports) and thread the HOM's answer into an outer local
  // — through a loop, a conditional or a `do:` over the answer — so a leaked
  // `{Result, State}` tuple or a wrong answer in any context shows up as a
  // wrong ground-truth value.
  // (`opaqueDoNonLastReadWrite` checks only that threading survives the
  // send: an inline `lists:foreach` `do:` answers `ok`, not `nil` — a
  // separate, pre-existing, REPL-visible inconsistency left for follow-up.)
  // The answer is bound to `r` before a loop/conditional/`do:` consumes
  // it (keeping every self-send at a statement's top level, so the
  // class-method loop-body family detectors agree — see
  // `family_detector_differential.rs`); besides, a
  // same-class class-method self-send used DIRECTLY as the receiver of a
  // threaded `do:`/`ifTrue:` in a class with a `classState:` is a separate,
  // pre-existing compiler crash (`unbound variable 'ClassVars1'`) — see
  // ADR 0128's Scope section.
  class opaqueDo: block => #(1, 2, 3) do: block

  class opaqueCollect: block => #(1, 2, 3) collect: block

  class opaqueSelect: block => #(1, 2, 3) select: block

  class opaqueInject: initial into: block =>
    #(1, 2, 3) inject: initial into: block

  class opaqueDetect: block => #(1, 2, 3) detect: block

  class opaqueDetect: block ifNone: noneBlock =>
    #(1, 2, 3) detect: block ifNone: noneBlock

  class opaqueCount: block => #(1, 2, 3) count: block

  class opaqueAnySatisfy: block => #(1, 2, 3) anySatisfy: block

  class opaqueAllSatisfy: block => #(1, 2, 3) allSatisfy: block

  class opaqueDoNonLastReadWrite =>
    n := 0
    1
      to: 2
      do: [:_k |
        self opaqueDo: [:i | i]
        n := n + 1
      ]
    n

  class opaqueCollectNonLastReadWrite =>
    sum := 0
    r := self opaqueCollect: [:i | i * 2]
    r do: [:x | sum := sum + x]
    sum

  class opaqueSelectNonLastReadWrite =>
    sum := 0
    r := self opaqueSelect: [:i | i > 1]
    r do: [:x | sum := sum + x]
    sum

  class opaqueInjectNonLastReadWrite =>
    sum := 0
    r := self opaqueInject: 0 into: [:a :b | a + b]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueDetectNonLastReadWrite =>
    sum := 0
    r := self opaqueDetect: [:i | i > 1]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueDetectIfNoneNonLastReadWrite =>
    sum := 0
    r := self opaqueDetect: [:i | i > 10] ifNone: [5]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueCountNonLastReadWrite =>
    sum := 0
    r := self opaqueCount: [:i | i > 1]
    1 to: 2 do: [:_k | sum := sum + r]
    sum

  class opaqueAnySatisfyNonLastReadWrite =>
    n := 0
    r := self opaqueAnySatisfy: [:i | i > 2]
    r ifTrue: [n := n + 1]
    n

  class opaqueAllSatisfyNonLastReadWrite =>
    n := 0
    r := self opaqueAllSatisfy: [:i | i > 0]
    r ifTrue: [n := n + 1]
    n
