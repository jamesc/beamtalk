// BT-3903 (ADR 0133 Phase 1): a user collection whose `do:` walks by hand, a
// `whileTrue:` over an index, so it never reaches a stdlib collection's
// iteration; every other iteration message is provided by the trait
// (adr0133enumerable_walkable.bt). Driven by adr0133enumerable_user.bt.

Value subclass: Adr0133EnumerableHandWalk
  uses: Adr0133EnumerableWalkable
  field: items = #()

  do: block =>
    i := 1
    [i <= self.items size] whileTrue: [
      block value: (self.items at: i)
      i := i + 1
    ]
    nil
