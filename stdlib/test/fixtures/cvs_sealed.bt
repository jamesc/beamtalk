// BT-3704 (ADR 0130 Phase 1): sealed class spelling of the class-variable
// semantics matrix. The rows are the same as cvs_open.bt and
// cvs_override_base.bt. See fixtures/class_var_semantics_matrix_test.bt.

sealed Object subclass: CvsSealed
  classState: n = 0

  class bump => self.n := self.n + 1

  class n => self.n

  class reset => self.n := 0

  class boom =>
    self bump
    1 / 0

  class makeBumper => [self bump]

  class makeReader =>
    @expect class_state_abroad "BT-3712: the returned block reads the captured value outside the class"
    [self.n]

  // BT-3760: a block whose only class-variable access is a direct write.
  class makeWriter => [self.n := 5]

  class run: aBlock => aBlock value

  class rowTop =>
    self reset
    self bump
    self bump
    self.n

  class rowArm: x =>
    self reset
    x > 0 ifTrue: [self bump]
    self.n

  class rowTimes =>
    self reset
    3 timesRepeat: [self bump]
    self.n

  class rowTimesLocal =>
    self reset
    i := 0
    3
      timesRepeat: [
        i := i + 1
        self bump
      ]
    self.n

  class rowToDoLocal =>
    self reset
    sum := 0
    1
      to: 3
      do: [:j |
        sum := sum + j
        self bump
      ]
    self.n

  class rowWhileLocal =>
    self reset
    i := 0
    [i < 3]
      whileTrue: [
        self bump
        i := i + 1
      ]
    self.n

  class rowLoopCondition =>
    self reset
    [self n < 3] whileTrue: [self bump]
    self.n

  class rowDo =>
    self reset
    #(1, 2, 3) do: [:x | self bump]
    self.n

  class rowCollect =>
    self reset
    #(1, 2, 3) collect: [:x | self bump]
    self.n

  class rowInject =>
    self reset
    #(1, 2, 3)
      inject: 0
      into: [:a :x |
        self bump
        a + x
      ]
    self.n

  class rowDoLocal =>
    self reset
    sum := 0
    #(1, 2, 3)
      do: [:x |
        sum := sum + x
        self bump
      ]
    self.n

  class rowCollectLocal =>
    self reset
    sum := 0
    #(1, 2, 3)
      collect: [:x |
        sum := sum + x
        self bump
      ]
    self.n

  class rowInjectLocal =>
    self reset
    sum := 0
    #(1, 2, 3)
      inject: 0
      into: [:a :x |
        sum := sum + x
        self bump
        a + x
      ]
    self.n

  class rowOnBodyRaise =>
    self reset
    [
      self bump
      1 / 0
    ] on: Error do: [:e | nil]
    self.n

  class rowOnBodyOk =>
    self reset
    [self bump] on: Error do: [:e | nil]
    self.n

  class rowOnBodyAfterWrite =>
    self reset
    self bump
    [
      self bump
      1 / 0
    ] on: Error do: [:e | nil]
    self.n

  class rowOnBodyViaSend =>
    self reset
    [self boom] on: Error do: [:e | nil]
    self.n

  class rowHandler =>
    self reset
    [1 / 0] on: Error do: [:e | self bump]
    self.n

  class rowHandlerAfterBodyWrite =>
    self reset
    [
      self bump
      1 / 0
    ] on: Error do: [:e | self bump]
    self.n

  // `1 / 0` raises a TypeError, so the inner handler names RuntimeError to decline it.
  class rowNonMatchingInnerEnsure =>
    self reset
    [
      [
        [
          self bump
          1 / 0
        ] on: RuntimeError do: [:e | nil]
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n

  class rowEnsure =>
    self reset
    [self bump] ensure: [self bump]
    self.n

  class rowEnsureRaise =>
    self reset
    [
      [
        self bump
        1 / 0
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    self.n

  class rowBare =>
    self reset
    [self bump] value
    self.n

  class rowStoredWithin =>
    self reset
    b := [self bump]
    b value
    b value
    self.n

  class rowStoredReadWithin =>
    self reset
    @expect class_state_abroad "BT-3712: a stored block is flagged even when run within the invocation"
    b := [self.n]
    self bump
    b value

  class rowSyncReadOpenDriver =>
    self reset
    self bump
    CvsDriver each: [self.n]

  class rowSyncWriteOpenDriver =>
    self reset
    @expect class_state_abroad "BT-3712: the block writes in CvsDriver's process"
    CvsDriver each: [self bump]
    self.n

  class rowSyncReadSealedDriver =>
    self reset
    self bump
    CvsSealedDriver each: [self.n]

  class rowSyncWriteSealedDriver =>
    self reset
    CvsSealedDriver each: [self bump]
    self.n

  class rowAsyncRead =>
    self reset
    a := CvsActor spawn
    @expect class_state_abroad "BT-3712: the actor runs the block later with the captured value"
    a keep: [self.n]
    self bump
    a run

  class rowAsyncWrite =>
    self reset
    a := CvsActor spawn
    a keep: [self bump]
    [
      a run
      #ok
    ] on: Error do: [:e | e kind]

  class rowSyncDirectWriteOpenDriver =>
    self reset
    @expect class_state_abroad "BT-3760: the direct write runs in CvsDriver's process"
    CvsDriver each: [self.n := 5]
    self.n

  class rowAsyncDirectWrite =>
    self reset
    a := CvsActor spawn
    a keep: [self.n := 5]
    a run
    self.n

  class rowOwnNlr =>
    self reset
    [
      self bump
      ^self.n
    ] on: Error do: [:e | nil]
    99

  class rowOwnNlrEnsure =>
    self reset
    [
      [
        self bump
        ^7
      ] ensure: [self bump]
    ] on: Error do: [:e | nil]
    99

  class rowForeignNlrAfterWrite =>
    self reset
    self bump
    CvsDriver guard: [^5]
    99

  class rowForeignNlrSealedDriver =>
    self reset
    CvsSealedDriver
      guard: [
        self bump
        ^5
      ]
    99
