// BT-4033: a static Supervisor whose anonymous child calls it from
// `initialize` (breaks the ADR 0135 hang rule).

Supervisor subclass: Bt4033InitCallerSup

  childSpecs =>
    #((Bt4033InitParentCaller supervisionSpec withArgs: #{#parent => self}))
