// BT-3793 (ADR 0131 Phase 2b): a loop or fold nested in the body of another
// loop or fold is a local-threading producer in that body's frame. Each
// method writes the outer local `t` (and sometimes `u`/`s`) inside a nested
// construct; the enclosing frame (direct-params, tuple-acc or StateAcc)
// lowers the rebinds, so the write is visible to everything after the
// construct. The receivers (class, value type, actor) must agree.

Object subclass: Adr0131LoopBodyProducerClass

  class whileInToDo =>
    s := 0
    1 to: 3 do: [:i | [s < i] whileTrue: [s := s + 1]]
    s

  class whileInDo =>
    s := 0
    #(1, 2, 3) do: [:i | [s < i] whileTrue: [s := s + 1]]
    s

  class whileFalseInToDo =>
    s := 0
    1 to: 3 do: [:i | [s >= i] whileFalse: [s := s + 1]]
    s

  class doInDo =>
    t := 0
    #(1, 2) do: [:i | #(1, 2) do: [:j | t := t + j]]
    t

  class collectInWhile =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        #(1, 2) collect: [:x | t := t + x]
        i := i + 1
      ]
    t

  class timesInTimes =>
    t := 0
    2 timesRepeat: [3 timesRepeat: [t := t + 1]]
    t

  class toDoInCollect =>
    t := 0
    #(1, 2)
      collect: [:x |
        1 to: 2 do: [:k | t := t + x]
        x
      ]
    t

  class assignCollectInToDo =>
    t := 0
    1
      to: 2
      do: [:i |
        r := #(1, 2) collect: [:x | t := t + x]
        t := t + r size
      ]
    t

  class injectInDo =>
    t := 0
    #(1, 2)
      do: [:i |
        #(1, 2)
          inject: 0
          into: [:a :x |
            t := t + x
            a + x
          ]
      ]
    t

  class assignInjectInDo =>
    t := 0
    u := 0
    #(1, 2)
      do: [:i |
        r := #(1, 2)
          inject: 0
          into: [:a :x |
            t := t + x
            a + x
          ]
        u := u + r
      ]
    #[t, u]

  class localInOuterOnly =>
    t := 0
    #(1, 2)
      do: [:i |
        w := 0
        #(1, 2) do: [:j | w := w + j]
        t := t + w
      ]
    t

  class readAfterInner =>
    t := 0
    #(1, 2)
      do: [:i |
        #(1, 2) do: [:j | t := t + j]
        t := t * 2
      ]
    t

  class selectInDo =>
    t := 0
    #(1, 2)
      do: [:i |
        #(1, 2, 3)
          select: [:x |
            t := t + 1
            x > 1
          ]
      ]
    t

  class whileInWhile =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        j := 0
        [j < 3]
          whileTrue: [
            t := t + 1
            j := j + 1
          ]
        i := i + 1
      ]
    t

  class operandInBody =>
    t := 0
    #(1, 2)
      do: [:i |
        r := (#(1, 2) collect: [:x | t := t + x]) size
        t := t + r
      ]
    t

  class collectLastIsLoop =>
    t := 0
    r := #(1, 2) collect: [:x | 1 to: 2 do: [:k | t := t + k]]
    #[r size, t]

  class whileInInject =>
    t := 0
    #(1, 2)
      inject: 0
      into: [:a :x |
        s := 0
        [s < x]
          whileTrue: [
            s := s + 1
            t := t + 1
          ]
        a
      ]
    t

  class countInTimes =>
    t := 0
    u := 0
    2
      timesRepeat: [
        u := u + (#(1, 2, 3)
          count: [:x |
            t := t + 1
            x > 1
          ])
      ]
    #[t, u]

  class selectLastInDo =>
    t := 0
    #(1, 2)
      do: [:i |
        #(1, 2, 3)
          select: [:x |
            t := t + x
            x > 1
          ]
      ]
    t

  class threadedAndLocal =>
    t := 0
    u := 0
    1
      to: 2
      do: [:i |
        w := 0
        #(1, 2)
          collect: [:x |
            w := w + x
            t := t + x
          ]
        u := u + w
      ]
    #[t, u]

  class nlrOutOfInner =>
    t := 0
    #(1, 2)
      do: [:i |
        #(1, 2)
          collect: [:x |
            t := t + 1
            i == 2 ifTrue: [^t]
            x
          ]
      ]
    t

  class assignInjectInTimes =>
    t := 0
    2
      timesRepeat: [
        r := #(1, 2)
          inject: 0
          into: [:a :x |
            t := t + x
            a + x
          ]
        t := t + r
      ]
    t

  class assignInjectInToDo =>
    t := 0
    1
      to: 2
      do: [:i |
        r := #(1, 2)
          inject: 0
          into: [:a :x |
            t := t + x
            a + x
          ]
        t := t + r
      ]
    t

  // BT-3796 (ADR 0131 Phase 2c): `do:` is a local-threading producer through
  // `producer_body_arg_index`, so a `do:` nested in a loop or fold body
  // rebinds the locals it writes in the enclosing frame.
  class doInToDo =>
    t := 0
    1 to: 2 do: [:i | #(1, 2) do: [:j | t := t + j]]
    t

  class doInWhile =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        #(1, 2) do: [:j | t := t + j]
        i := i + 1
      ]
    t

  class twoLocals =>
    t := 0
    u := 0
    1
      to: 2
      do: [:i |
        #(1, 2)
          do: [:j |
            t := t + j
            u := u + i
          ]
      ]
    #[t, u]

  class doInCollectLast =>
    t := 0
    r := #(1, 2) collect: [:x | #(1, 2) do: [:k | t := t + k]]
    #[r size, t]

  class threeDeep =>
    t := 0
    1 to: 2 do: [:i | 1 to: 2 do: [:j | #(1, 2) do: [:k | t := t + 1]]]
    t

  class injectLastValue =>
    t := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        #(1, 2)
          inject: a
          into: [:b :y |
            t := t + y
            b + y
          ]
      ]
    #[r, t]

  // A `do:` in a loop body whose enclosing loop also touches state: the
  // body's own self-send or field write picks the frame's `StateAcc` mode.
  class doInToDoStateful =>
    t := 0
    1
      to: 2
      do: [:i |
        #(1, 2)
          do: [:j |
            t := t + j
            self plain
          ]
      ]
    t

  // BT-3793 review: a local the outer body reassigns before the nested `do:`
  // (`body_introduced_locals`) is the body's own, the nested `do:` still
  // rebinds it.
  class outerLocalReassignedFirst =>
    w := 5
    1
      to: 2
      do: [:i |
        w := 0
        #(1, 2) do: [:j | w := w + j]
      ]
    w

  // BT-3793 review: a producer nested two frames deep with a value-bearing
  // assignment, where the outermost frame is a fold and the middle one a
  // letrec loop, and the same under a letrec loop inside a `collect:`
  // (both answered 24 in a probe).
  class foldInLetrecInFold =>
    t := 0
    #(1, 2)
      do: [:k |
        1
          to: 2
          do: [:i |
            r := #(1, 2)
              inject: 0
              into: [:a :x |
                t := t + x
                a + x
              ]
            t := t + r
          ]
      ]
    t

  class foldInLetrecInCollect =>
    t := 0
    #(1, 2)
      collect: [:k |
        2
          timesRepeat: [
            r := #(1, 2)
              inject: 0
              into: [:a :x |
                t := t + x
                a + x
              ]
            t := t + r
          ]
        k
      ]
    t

  class plain => 0

  class armLoopInFoldStatement =>
    t := 0
    #(1, 2)
      do: [:k |
        k > 0
          ifTrue: [
            1 to: 2 do: [:i | t := t + 1]
          ]
      ]
    t
