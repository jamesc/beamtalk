// BT-4367: differential fixture (actor method). Every shape is written twice: at
// the method root (`...Root`, the proven producer path) and inside the arm of a
// conditional that writes no outer local (`...Arm:`, a plain `BranchArm` frame,
// BT-3911), where a loop or fold writes a local of the arm. The two must answer
// the same. The grid is conditional selector (for a two-arm selector, the loop in
// the first arm and, as `...Second`, in the second arm) x position of the
// conditional (last statement, non-last statement, assigned value, `^`, operand)
// x body shape (an assigned `inject:into:`, a `do:` statement, an `inject:into:`
// or `collect:` as the arm's value, an early `^`). A collection as an operand is
// a type error at the root too, so it is left out. Asserted in
// bt4367arm_local_grid_test.bt.

Actor subclass: Bt4367ArmLocalGridActor
  state: n = 0

  ifTrue_ifFalse_last_assign_injectRoot =>
    m := 0
    s := #(1, 2)
      inject: 0
      into: [:acc :e |
        m := m + e
        acc + e
      ]
    m + s

  ifTrue_ifFalse_last_assign_injectArm: c =>
    c
      ifTrue: [
        m := 0
        s := #(1, 2)
          inject: 0
          into: [:acc :e |
            m := m + e
            acc + e
          ]
        m + s
