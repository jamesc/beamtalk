// Fixture for BT-2819 (JsonMappable / JsonMapping); see json_mapping_test.bt.
// Mirrors beamtalk-symphony / beamtalk-exdura classes; the Hand* twins are the
// hand-written asJson equivalents used for byte-identical comparison.

Value subclass: JsonMappedRunningEntry
  uses: JsonMappable
  field: issueId = ""
  field: issueIdentifier = ""
  field: state = ""
  field: turnCount = 0
  field: tokens = nil
  field: internalNote = "hidden"

  class jsonMapping -> JsonMapping =>
    JsonMapping new
      |> mapField: #issueId to: "issue_id"
      |> mapField: #issueIdentifier to: "issue_identifier"
      |> mapField: #state
      |> mapField: #turnCount to: "turn_count"
      |> mapField: #tokens
