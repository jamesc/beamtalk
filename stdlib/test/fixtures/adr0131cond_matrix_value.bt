  armNLDirectToDo: c =>
    t := 0
    c
      ifTrue: [
        t := t + 0
        1 to: 2 do: [:i | t := t + i]
        5
      ]
    t

  armNLDirectWhile: c =>
    t := 0
    c
      ifTrue: [
        t := t + 0
