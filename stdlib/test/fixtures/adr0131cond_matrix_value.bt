      ifTrue: [
        #(1, 2)
          inject: 0
          into: [:a :x |
            t := t + x
            a + x
          ]
        5
      ]
    t

  armNLOuterTimes: c =>
    t := 0
    c
      ifTrue: [
        2 timesRepeat: [t := t + 1]
        5
