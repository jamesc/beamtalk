    t

  armNLOuterDo: c =>
    t := 0
    c
      ifTrue: [
        #(1, 2) do: [:e | t := t + e]
        5
      ]
    t

  armNLOuterIfNil: c =>
    t := 0
    c
      ifTrue: [
