    t

  armNLOuterToDo: c =>
    t := 0
    c
      ifTrue: [
        1 to: 2 do: [:i | t := t + i]
        5
      ]
    t

  armNLOuterWhile: c =>
    t := 0
    c
      ifTrue: [
        [t < 2] whileTrue: [t := t + 1]
        5
      ]
    t

  iterArmDirectCollect: c =>
    t := 0
    c
      ifTrue: [
        #(1)
          do: [:z |
            t := t + 0
            #(1, 2) collect: [:x | t := t + x]
          ]
      ]
    t

  iterArmDirectDo: c =>
    t := 0
    c
      ifTrue: [
        #(1)
          do: [:z |
            t := t + 0
            #(1, 2) do: [:e | t := t + e]
          ]
      ]
    t

  iterArmDirectInject: c =>
    t := 0
    c
