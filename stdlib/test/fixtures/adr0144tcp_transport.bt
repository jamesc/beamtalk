// ADR 0144 (BT-4435): one of two class-side conformers of Adr0144Transport.
sealed Object subclass: Adr0144TcpTransport

  class send: data :: Object -> Result(String, Object) =>
    Result ok: "tcp:" ++ data printString

  class label -> String => "tcp"
