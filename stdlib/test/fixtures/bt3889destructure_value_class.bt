// BT-3889: a destructuring assignment `#(a, b) := expr` evaluates to its
// right-hand side, like `x := expr`. One method per lowering that ends a body
// in one: the method body (with and without a `^` in a block), a block, a
// conditional arm (plain and one that threads a local), a protected block
// (`on:do:`, `ensure:`), and the fold epilogues (`collect:`, `inject:into:`,
// `groupBy:`, plain and threading a local). Asserted in
// bt3889destructure_value_test.bt.

Object subclass: Bt3889DestructureValueClass

  class last => #(_a, _b) := #(1, 2)

  class lastNlr: c =>
    c ifTrue: [^0]
    #(_a, _b) := #(1, 2)

  class lastTuple => {_a, _b} := Erlang erlang list_to_tuple: #(1, 2)

  class lastMap => #{#k => _v} := #{#k => 1}

  class block => [#(_a, _b) := #(1, 2)] value

  class arm: c => c ifTrue: [#(_a, _b) := #(1, 2)] ifFalse: [0]

  class threadedArm: c =>
    t := 0
    r := c
      ifTrue: [
        t := 5
        #(_a, _b) := #(t, 2)
      ]
      ifFalse: [0]
    #(r, t)

  class onDo => [#(_a, _b) := #(1, 2)] on: Error do: [:e | 0]

  class ensure => [#(_a, _b) := #(1, 2)] ensure: [nil]

  class collect => #(1, 3) collect: [:x | #(_a, _b) := #(x, 2)]

  class threadedCollect =>
    t := 0
    r := #(1, 3)
      collect: [:x |
        t := t + x
        #(_a, _b) := #(x, t)
      ]
    #(r, t)

  // A predicate: the right-hand side is not a boolean, so it raises like any
  // other non-boolean predicate.
  class select => #(1) select: [:x | #(_a, _b) := #(x, 2)]

  class inject => #(1, 3) inject: 0 into: [:acc :x | #(_a, _b) := #(x, acc)]

  class groupBy =>
    (#(1, 3) groupBy: [:x | #(_a, _b) := #(x > 2, 0)]) at: #(true, 0)
