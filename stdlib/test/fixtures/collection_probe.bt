// BT-3022: reaches a class-driven Collection from *inside* a class method, so the
// process that sets up the iteration accumulator is itself a class gen_server
// rather than the eval worker.

Value subclass: CollectionProbe
  // BT-3164: own class-var, mutated as the LAST statement of a method that
  // also contains a literal `^` (below) — the shape that mints a real local
  // NlrCatch AND a real class-var Bind in the SAME method body, closing the
  // ADR 0110 joint-visibility gap for `VerifyError::ShadowWriteMissing`.
  classState: hits = 0

  // The accumulating process is CollectionProbe's class process; the iteration
  // block then hops on to CollectionDriver's.
  class asListOf: aList :: List -> List =>
    (ClassDrivenCollection of: aList) asList

  class sumOf: aList :: List -> Number => (ClassDrivenCollection of: aList) sum

  class includes: x :: Integer in: aList :: List -> Boolean =>
    (ClassDrivenCollection of: aList) includes: x

  // BT-3022: reaches the driver through a class held in a *variable*. The `^`
  // belongs to this method's frame, so the non-local return still has to cross
  // back out of CollectionDriver's class process.
  class firstOver: aList :: List -> Integer =>
    k := CollectionDriver
    k run: [:x | x > 1 ifTrue: [^x]] over: aList
    0

  // BT-3032 / ADR 0110: the repro from the ADR — the `^` here is foreign to
  // CollectionDriver's `countedRun:over:` frame, so the driver's class-var
  // increment travels via the '$bt_class_vars_shadow' write-through when the
  // NLR relays back out of the driver's class process.
  class escapeAfterCountedRun: aList :: List -> Integer =>
    CollectionDriver countedRun: [:x | x > 1 ifTrue: [^x]] over: aList
    0

  // BT-3031: `CollectionDriver class class` is a true metaclass receiver
  // (beamtalk_behaviour_intrinsics:classClass/1 tags it 'Metaclass'), so this
  // routes through metaclass_send/4 instead of class_send/3. The `^` belongs to
  // this method's frame and must cross back along that path too.
  class firstViaMetaclassOver: aList :: List -> Integer =>
    k := CollectionDriver class class
    k run: [:x | x > 1 ifTrue: [^x]] over: aList
    0

  // BT-3164: the `^` here is this method's OWN — `has_block_nlr_or_walk`
  // sees it directly in `escapeAfterCountedRunThenBump:`'s own body (unlike
  // `escapeAfterCountedRun:` above, whose `^` only ever needs a local catch
  // via this same shape), so this method mints its own real local
  // `NlrCatch`. `self.hits := self.hits + 1` is this method's OWN last
  // statement, so it lowers as a real class-var `Bind` — the two now sit in
  // the SAME `Vec<ThreadedStmt>`. When `aList` has no element `> 1`, the
  // call completes normally and the mutation lands; when it does, the local
  // `^` unwinds before the last statement ever runs, so `hits` stays
  // unchanged — ordinary local-NLR semantics, unrelated to the ADR 0110
  // shadow write (which only matters for a FOREIGN relay), but exercising
  // both branches pins that the new `Bind`/`NlrCatch` construction doesn't
  // disturb either.
  class escapeAfterCountedRunThenBump: aList :: List -> Integer =>
    CollectionDriver countedRun: [:x | x > 1 ifTrue: [^x]] over: aList
    self.hits := self.hits + 1

  class hits -> Integer => self.hits

  class resetHits => self.hits := 0

  // BT-3164 review finding: a class-method self-send to THIS SAME class
  // (`self bumpHitsViaSelfSend`, below) mutates `hits` via the shared
  // `emit_class_var_result_unwrap` path — an opaque `Statement` whose own
  // internal `next_class_var()` bump has no `Bind` of its own in THIS
  // method's IR, so `verify_body_with_opaque_version_gaps`'s `ClassVars`
  // backfill must synthesize a gap-filler `Bind` for it. `aList do: [...]`
  // contains a literal `^`, directly in this method's own body, so
  // `needs_nlr` is true and a real local `NlrCatch` wraps the whole body.
  // The LAST statement, `self.hits := self.hits + 1`, is this method's own
  // second direct mutation, lowered as a real `Bind`. Before this issue's
  // review caught it, the backfilled gap-filler `Bind` for the self-send's
  // invisible bump spuriously tripped `ShadowWriteMissing` in this exact
  // shape (a real `NlrCatch` present + a `ClassVars` version gap before a
  // real top-level `Bind`) — compiling this class at all is the regression
  // pin.
  class bumpViaSelfSendThenBumpDirectlyWithNlr: aList :: List -> Integer =>
    self bumpHitsViaSelfSend
    aList do: [:x | x > 100 ifTrue: [^x]]
    self.hits := self.hits + 1

  class bumpHitsViaSelfSend => self.hits := self.hits + 1
