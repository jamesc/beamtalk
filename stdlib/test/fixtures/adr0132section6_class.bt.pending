// BT-3866 (ADR 0132 Phase 0a, epic BT-3865): class-method column of the
// ADR 0132 §"The inventory" shapes ADR 0131 §6 rejects today. Each `probe*`
// class method hands a block that writes the outer local `t` to a callee and
// is a `Tier2BlockNoReturnChannel` compile error until the ADR 0132 phase
// named beside it lands; the `callee*` class methods are the callees and
// compile on their own. Inert: the runner discovers only `.bt`. The phase that
// makes a shape compile moves its probe into a compiled fixture (and its test
// out of adr0132section6_pending_test.bt.pending).
//
// `adr0132_section6_inventory_pins` in beamtalk-core checks that every
// `probe*` method is rejected and no `callee*` method is.
//
// I1 direct invoke (Phase 1)        I2 invoke in a nested construct (Phase 3)
// I4 pass-through to a HOM (Phase 1) I6 stored block to `do:` (Phase 2)
// I7 class-side `self hom:` (Phase 1) I8 class method not `class sealed`
// (Phase 4). I5 (stored block `value`) is BT-3865 issue 2's.

Object subclass: Adr0132Section6Class

  class sealed calleeDirect: b => b value

  class sealed calleeDo: b => #(1) do: [:x | b value]

  class sealed calleePass: b => self calleeDirect: b

  class calleeOpen: b => b value

  class probeI1 =>
    t := 0
    Adr0132Section6Class calleeDirect: [t := t + 1]
    t

  class probeI2 =>
    t := 0
    Adr0132Section6Class calleeDo: [t := t + 1]
    t

  class probeI4 =>
    t := 0
    Adr0132Section6Class calleePass: [t := t + 1]
    t

  class probeI6 =>
    t := 0
    blk := [:x | t := t + x]
    #(1, 2) do: blk
    t

  class probeI7 =>
    t := 0
    self calleeDirect: [t := t + 1]
    t

  class probeI8 =>
    t := 0
    Adr0132Section6Class calleeOpen: [t := t + 1]
    t
