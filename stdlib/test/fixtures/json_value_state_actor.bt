// JsonValueStateActor — regression fixture for BT-3546 (ADR 0124 §7 A1)
// and BT-3561 (cross-file alias pre-loading in `beamtalk test`).
//
// A typed-no-default state field whose type is the real `stdlib/src/json.bt`
// `JsonValue` alias (`type JsonValue = Nil | Boolean | Integer | Float |
// String | List | Dictionary`), referenced across files/packages rather than
// declared locally — this exercises BT-3561's fix (`beamtalk test`'s
// pipeline now pre-loads same-package `stdlib/src` type aliases the same
// way it pre-loads `ClassInfo`) in addition to BT-3546's alias-aware
// definite-assignment predicate.
//
// Before BT-3546, the definite-assignment predicate did not resolve
// aliases, so `JsonValue` was (wrongly) reported non-nilable and this actor
// raised `UninitializedStateError` at spawn even though `Nil` is a member of
// the alias's expansion. Should spawn successfully and leave `value` unset
// (`nil`).

typed Actor subclass: JsonValueStateActor
  state: value :: JsonValue
  state: count :: Integer = 0

  initialize -> Integer =>
    // Deliberately does NOT set self.value — JsonValue expands to
    // include Nil, so nil is a legitimate value here.
    self.count := 1

  getValue -> JsonValue => self.value

  getCount -> Integer => self.count
