// BT-4000: a loop body statement that is a conditional whose receiver is a
// self-send. The receiver's state change must reach the next iteration and the
// code after the loop. See stdlib/test/bt4000loop_body_conditional_receiver_test.bt.

Actor subclass: Bt4000LoopBodyConditionalReceiverActor
  state: ticks = 0
  state: hits = 0

  done => false

  // Advances `ticks`; answers true from the second call on.
  tick =>
    self.ticks := self.ticks + 1
    self.ticks > 1

  whileRepro =>
    n := 0
    [n > 0] whileTrue: [(self done) ifTrue: [Timer sleep: 0]]
    n

  timesRepro =>
    3 timesRepeat: [(self tick) ifTrue: [self.hits := self.hits + 1]]
    #[self.ticks, self.hits]

  whileLocal =>
    k := 0
    n := 3
    [n > 0]
      whileTrue: [
        n := n - 1
        (self tick) ifTrue: [k := k + 1]
      ]
    #[k, self.ticks]

  whileUnparenthesised =>
    n := 2
    [n > 0]
      whileTrue: [
        n := n - 1
        self tick ifTrue: [3]
      ]
    self.ticks

  whileFalseIfFalse =>
    n := 0
    [n >= 2]
      whileFalse: [
        n := n + 1
        (self tick) ifFalse: [self.hits := self.hits + 10]
      ]
    #[self.ticks, self.hits]

  toDoIfFalse =>
    1 to: 4 do: [:i | (self tick) ifFalse: [self.hits := self.hits + 10]]
    #[self.ticks, self.hits]

  toByDoIfTrueIfFalse =>
    1
      to: 5
      by: 2
      do: [:i | (self tick) ifTrue: [self.hits := self.hits + i] ifFalse: [nil]]
    #[self.ticks, self.hits]

  andOperand =>
    3 timesRepeat: [
      ((self tick) and: [self.ticks > 2]) ifTrue: [self.hits := self.hits + 1]
    ]
    #[self.ticks, self.hits]

  foldBody =>
    #(1, 2, 3) do: [:e | (self tick) ifTrue: [self.hits := self.hits + e]]
    #[self.ticks, self.hits]
