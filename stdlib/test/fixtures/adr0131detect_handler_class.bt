// BT-3794 (ADR 0131 Phase 2c): `detect:ifNone:` whose `ifNone:` handler writes
// an outer local, class-method column. The fold packs the handler's writes with the
// search block's (core's `producer_packed_blocks`), so the send is a
// local-threading producer in every operand position and a statement. The
// other columns are adr0131detect_handler_{class,value,actor}.bt; the
// expected answers are in stdlib/test/adr0131detect_handler_test.bt.

Object subclass: Adr0131DetectHandlerClass

  // A `detect:ifNone:` whose handler (not the search block) writes `t`, as the whole value of an assignment (s2).
  class s2 =>
    t := 0
    r := #(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        0
      ]
    #[r, t]

  // The same as a statement (stDetectIfNone).
  class handlerStatement =>
    t := 0
    #(1, 2) detect: [:e | e > 5] ifNone: [t := t + 1]
    t

  // The handler does not run when the search finds an element: `t` is unchanged.
  class handlerFound =>
    t := 0
    r := #(1, 2)
      detect: [:x | x > 1]
      ifNone: [
        t := t + 1
        0
      ]
    #[r, t]

  // A handler that only writes (never reads) the local.
  class handlerWriteOnly =>
    t := 0
    r := #(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := 7
        0
      ]
    #[r, t]

  // The search block and the handler write different locals.
  class handlerOtherLocal =>
    t := 0
    u := 0
    r := #(1, 2)
      detect: [:x |
        t := t + 1
        x > 5
      ]
      ifNone: [
        u := u + 10
        0
      ]
    #[r, t, u]

  // The same, with the search finding an element: only the search block's write happens.
  class handlerOtherLocalFound =>
    t := 0
    u := 0
    r := #(1, 2)
      detect: [:x |
        t := t + 1
        x > 1
      ]
      ifNone: [
        u := u + 10
        0
      ]
    #[r, t, u]

  // A handler writing two locals.
  class handlerTwoLocals =>
    t := 0
    u := 0
    r := #(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        u := u + 2
        0
      ]
    #[r, t, u]

  // A handler-writing `detect:ifNone:` as the left operand of a `^` value that reads `t` afterwards.
  class handlerReturned =>
    t := 0
    ^(#(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        5
      ]) + t

  // A handler-writing `detect:ifNone:` as a binary operand after a read of `t`.
  class handlerLeftRead =>
    t := 0
    r := t + (#(1, 2)
      detect: [:x | x > 5]
      ifNone: [
        t := t + 1
        5
      ])
    #[r, t]

  // A handler-writing `detect:ifNone:` as the method's last expression.
  class handlerLast =>
    t := 0
    #(1, 2) detect: [:x | x > 5] ifNone: [t := t + 1. 3]

  // A parenthesised handler-writing `detect:ifNone:` statement.
  class handlerParenthesised =>
    t := 0
    (#(1, 2) detect: [:x | x > 5] ifNone: [t := t + 1])
    t

  // The assignment target is the local the handler writes: the assigned value wins.
  class handlerAssignsTarget =>
    t := 0
    t := #(1) detect: [:x | x > 5] ifNone: [t := t + 1. 9]
    t

  // A found `nil` is a hit, not a miss: the handler does not run.
  class handlerNilFound =>
    t := 0
    r := #(nil) detect: [:x | x isNil] ifNone: [t := t + 1. 5]
    #[r, t]

  // An empty collection runs the handler.
  class handlerEmpty =>
    t := 0
    r := #() detect: [:x | x > 5] ifNone: [t := t + 1. 5]
    #[r, t]

  // Two handler-writing sends in a row, as statements.
  class handlerTwice =>
    t := 0
    #(1) detect: [:x | x > 5] ifNone: [t := t + 1]
    #(2) detect: [:x | x > 5] ifNone: [t := t + 10]
    t

  // A handler-writing send as an argument, before a read of `t`.
  class handlerInArgument =>
    t := 0
    r := 0 max: (#(1, 2) detect: [:x | x > 5] ifNone: [t := t + 4. 3])
    #[r, t]
