// BT-4300 (ADR 0142): an open class with no class variables. Its class
// methods run in the caller, so a block passed to one runs there too.
// Fixture for class_method_in_caller_test.bt.

Object subclass: InCallerProbe

  class me => self

  // A class-side self-send that answers `self`: inherited by
  // InCallerProbeSub, it must answer the subclass's real reference.
  class meVia => self me

  // `clearField:` on a class with no class variables: its state is empty
  // wherever the method runs (ADR 0142 §3).
  class clearMissing => self clearField: #missing

  class hasMissing => self hasField: #missing

  // `performLocally:` from an inherited class method resolves through the
  // class-method chain of the receiving class (BT-4300).
  class parentOnly -> Symbol => #parent

  class overridden -> Symbol => #parent

  class viaLocally => self performLocally: #parentOnly withArguments: #()

  class viaLocallyOverridden =>
    self performLocally: #overridden withArguments: #()

  class myName -> Symbol => self name

  class double: n :: Integer -> Integer => n * 2

  class call: aBlock => aBlock value

  // `run:` is a process-bound selector (a TestCase run selector, ADR 0142 §1
  // rule 3), whatever class defines it: it keeps the class process.
  class run: aBlock => aBlock value

  class each: items :: List do: aBlock :: Block -> List =>
    items collect: [:x | aBlock value: x]

  class boom -> Integer => self error: "in-caller boom"
