// BT-5289: a `match:` whose scrutinee is a send (it runs in a `SyncedCall`
// window, or is a self-send that advances `State`) and whose arm writes a
// field, as a statement of a conditional arm and of a loop body. Used by
// stdlib/test/bt5289match_sent_scrutinee_test.bt.

Actor subclass: Bt5289MatchSentScrutineeActor
  state: total = 0
  state: bumps = 0

  total => self.total

  bumps => self.bumps

  // The issue's repro: the `match:` is the false arm's statement.
  classify: items =>
    items isNil ifTrue: [
      nil
    ] ifFalse: [
      items first match: [_ -> items first > 0 ifTrue: [
        self.total := items first
      ]]
    ]
    self.total

  // The same after two guard-style returns (BT-4415 nests the rest of the
  // method in a conditional arm).
  guarded: items =>
    items isNil ifTrue: [^#none]
    items isEmpty ifTrue: [^#empty]
    items first match: [_ -> items first > 0 ifTrue: [
      self.total := self.total + items first
    ]]
    self.total

  bump =>
    self.bumps := self.bumps + 1
    self.bumps

  // A self-send scrutinee that writes a field, in a loop body: each pass
  // sees the field the previous pass's scrutinee and arm wrote.
  loop: n =>
    1
      to: n
      do: [:i |
        self bump match: [
          k :: Integer -> self.total := self.total + k;
          _ -> nil
        ]
      ]
    {self.bumps, self.total}

  // A scrutinee holding a local assignment (the other trigger of the same
  // splice), in a conditional arm and in a loop body: the local keeps the
  // value the scrutinee assigned.
  localScrutinee: x =>
    t := 0
    r := 0
    x isNil
      ifTrue: [nil]
      ifFalse: [
        r := (t := t + x) match: [
          1 -> 10;
          _ -> 20
        ]
      ]
    1 to: 2 do: [:i | (t := t + 1) match: [_ -> nil]]
    {t, r}
