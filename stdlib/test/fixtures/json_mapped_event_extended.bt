// Fixture for BT-5191; see json_mapping_test.bt.

// Adds a field and extends the parent's mapping with it.
JsonMappedEvent subclass: JsonMappedEventExtended
  field: extra = "added"

  class jsonMapping -> JsonMapping => super jsonMapping |> mapField: #extra
