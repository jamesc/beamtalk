// BT-4252: Behaviour-protocol selectors (`name`, `superclass`) sent to
// `self`/`super` from Actor class methods answer what the external send
// (`Bt4252ClassProtocolActorChild name`) answers.

Bt4252ClassProtocolActorBase subclass: Bt4252ClassProtocolActorChild

  class selfName => self name

  class superName => super name

  class selfSuperclass => self superclass

  class superSuperclass => super superclass

  class superNameInClosure => #(1) collect: [:x | super name]

  // `doc` is protocol whose primitive messages the class process, so from a
  // class method running in that process it raises a structured error.
  class selfDoc => self doc
