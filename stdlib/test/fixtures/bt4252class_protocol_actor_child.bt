// BT-4252: Behaviour-protocol selectors (`name`, `superclass`) sent to
// `self`/`super` from Actor class methods answer what the external send
// (`Bt4252ClassProtocolActorChild name`) answers.

/// The actor child of the BT-4252 class-protocol fixtures.
Bt4252ClassProtocolActorBase subclass: Bt4252ClassProtocolActorChild

  class selfName => self name

  class superName => super name

  class selfSuperclass => self superclass

  class superSuperclass => super superclass

  class superNameInClosure => #(1) collect: [:x | super name]

  // `includesSelector:` lost its dedicated codegen path (BT-4252), so it
  // reaches `Behaviour>>includesSelector:` through the protocol fallthrough.
  class selfIncludesFoo => self includesSelector: #foo

  class selfIncludesBar => self includesSelector: #bar

  // `doc` reads the class doc's published copy, so it answers from a class
  // method running in the class process (BT-4262).
  class selfDoc => self doc

  // `Class>>printString` is a Beamtalk body that sends `self name`; from the
  // class process that send answers through the class-object protocol
  // (BT-4262).
  class selfPrintString => self printString

  // A block run inside another class's class method reads the doc while
  // this class waits on that one (BT-4262; it used to time out).
  class selfDocAbroad => Bt4252ClassProtocolActorBase runBlock: [self doc]

  // The setter still messages the class process, so from a class method
  // running in that process it raises `dispatch_error` (BT-4262).
  class selfSetDoc => self doc: "changed"

  // Sends from the class process to the class looked up at run time
  // (BT-4262; a literal class name in its own class method compiles to the
  // class-side self-send): a selector only the `Class` chain answers runs in
  // place; one the class defines, or a class-variable reflection send, still
  // raises `dispatch_error`.
  class byNamePrintString =>
    (Beamtalk classNamed: #Bt4252ClassProtocolActorChild) printString

  class byNameDefinedSelector =>
    @expect dnu "BT-4262: a run-time class lookup, so the send is not the class-side self-send"
    (Beamtalk classNamed: #Bt4252ClassProtocolActorChild) selfName

  class byNameHasField =>
    (Beamtalk classNamed: #Bt4252ClassProtocolActorChild) hasField: #x

  foo => 1
