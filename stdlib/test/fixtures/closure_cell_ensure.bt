// ADR 0137 Phase 2b (BT-4009): `ensure:` write-through, entry store and the
// cleanup that reads the cell. An `ensure:` cleanup sees every write the
// protected body made before it ran when the body exits normally or with `^`,
// and after an error the state at entry plus the body's own writes made before
// the error.

Actor subclass: ClosureCellEnsure
  state: n = 0
  state: seen = 0

  seen => self.seen

  normalExit =>
    [self.n := 5] ensure: [self.seen := self.n]
    self.seen

  // A `^` stores before it throws, so the cleanup sees every write before it.
  earlyReturn: rec =>
    [
      self.n := 7
      ^1
    ] ensure: [rec record: self.n]
    0

  // The cleanup runs because of an error: it records what it sees in `rec`,
  // an actor the on:do: rollback does not touch.
  errorExit: rec =>
    [
      [
        self.n := 9
        1 / 0
      ] ensure: [rec record: self.n]
    ] on: Error do: [:e | nil]
    self.n

  // A call before the failure that wrote through a closure is not guaranteed
  // to reach the cleanup, but a lexical write is.
  entryState: rec =>
    self.n := 3
    [[1 / 0] ensure: [rec record: self.n]] on: Error do: [:e | nil]
    self.n

  bump => self.n := self.n + 1

  // Writes kept in loop parameters or made by a compiled self-send reach the
  // cleanup of a failed body as well.
  loopError: rec =>
    [
      [
        #(1, 2, 3)
          do: [:i |
            self.n := self.n + i
            i == 2 ifTrue: [1 / 0]
          ]
      ] ensure: [rec record: self.n]
    ] on: Error do: [:e | nil]
    self.n

  selfSendError: rec =>
    [
      [
        self bump
        1 / 0
      ] ensure: [rec record: self.n]
    ] on: Error do: [:e | nil]
    self.n

  n => self.n

  // BT-4312: a cleanup that a `^` runs keeps its writes: the throw resumes
  // with the cleanup's state, so the method's boundary answers it.
  cleanupWriteAfterReturn =>
    [^1] ensure: [self.n := 9]
    0

  cleanupReadsTheBodysWriteAfterReturn =>
    [
      self.n := 5
      ^1
    ] ensure: [self.n := self.n + 100]
    0

  nestedCleanupsAfterReturn =>
    [[^1] ensure: [self.n := self.n + 100]] ensure: [self.n := self.n * 2]
    0

  cleanupInALoopAfterReturn =>
    #(1, 2, 3) do: [:i | [i == 2 ifTrue: [^i]] ensure: [self.n := self.n + i]]
    0

  cleanupInADynamicLoopAfterReturn: xs =>
    xs do: [:i | [i == 2 ifTrue: [^i]] ensure: [self.n := self.n + i]]
    0

  cleanupInAClosureAfterReturn =>
    b := [[^1] ensure: [self.n := 9]]
    b value
    0

  // BT-4312: an `ensure:` whose receiver or cleanup is not a block literal
  // runs the cleanup as a closure, which writes the cell in place. The throw
  // resumes with the cell's fields, so the method's boundary answers them.
  storedReceiverAfterReturn =>
    b := [^1]
    b ensure: [self.n := 9]
    0

  storedCleanupAfterReturn =>
    c := [self.n := 9]
    [^1] ensure: c
    0

  storedBlocksAfterReturn =>
    b := [
      self.n := 5
      ^1
    ]
    c := [self.n := self.n + 100]
    b ensure: c
    0

  nestedStoredCleanupsAfterReturn =>
    c1 := [self.n := self.n + 100]
    c2 := [self.n := self.n * 2]
    [[^1] ensure: c1] ensure: c2
    0

  passedCleanupAfterReturn => self returnThrough: [self.n := 9]

  returnThrough: cleanup =>
    [^1] ensure: cleanup
    0

  storedCleanupInALoopAfterReturn =>
    c := [self.n := self.n + 1]
    #(1, 2, 3) do: [:i | [i == 2 ifTrue: [^i]] ensure: c]
    0

  storedCleanupInAClosureAfterReturn =>
    c := [self.n := 9]
    b := [[^1] ensure: c]
    b value
    0

  // BT-4429: `Block>>ensure:` reached by `perform:` runs in the Block
  // method, where the `^` is a foreign throw: its catch resumes it with the
  // cell the cleanup wrote, since the throw carried the cell's state.
  performedCleanupAfterReturn =>
    c := [self.n := 9]
    [^1] perform: #ensure: withArguments: #(c)
    0

  performedCleanupOverTheBodysWriteAfterReturn =>
    c := [self.n := self.n + 100]
    [
      self.n := 5
      ^1
    ] perform: #ensure: withArguments: #(c)
    0

  nestedPerformedCleanupsAfterReturn =>
    c1 := [self.n := self.n + 100]
    c2 := [self.n := self.n * 2]
    [
      [^1] perform: #ensure: withArguments: #(c1)
    ] perform: #ensure: withArguments: #(c2)
    0

  performedInsideCompiledCleanupsAfterReturn =>
    c1 := [self.n := self.n + 100]
    [[^1] perform: #ensure: withArguments: #(c1)] ensure: [self.n := self.n * 2]
    0

  compiledInsidePerformedCleanupsAfterReturn =>
    c2 := [self.n := self.n * 2]
    [
      [^1] ensure: [self.n := self.n + 100]
    ] perform: #ensure: withArguments: #(c2)
    0

  // BT-4448: this actor's `^` block run by `peer`, an actor of the same
  // class in an equal state, through a `perform:`ed `ensure:`. Away from
  // home the `^` carries this actor's creation-time capture, which equals
  // the peer's cell: the peer's relay must not resume it with the peer's
  // state, or this actor's boundary answers the peer's state as its own.
  returnThroughPeer: peer =>
    peer performEnsureOn: [^1]
    0

  performEnsureOn: blk =>
    c := [self.n := self.n + 1]
    blk perform: #ensure: withArguments: #(c)
    0

  performedCleanupInALoopAfterReturn =>
    c := [self.n := self.n + 1]
    #(1, 2, 3) do: [:i |
      [i == 2 ifTrue: [^i]] perform: #ensure: withArguments: #(c)
    ]
    0

  // ADR 0146 R1 (BT-4534): a `^` of this method, from a block it passes to
  // another method of this actor, unwinds through that method's inlined
  // `ensure:` (a foreign `^` there). Its cleanup's write is in the cell while
  // the `^` is in flight, so this method's own cleanup, which reads the
  // cell, sees it.
  foreignReturnThroughEnsure: rec =>
    [self runEnsure: [^3]] ensure: [rec record: self.n]
    0

  runEnsure: blk =>
    [blk value] ensure: [self.n := 40]
    0

  // The same where the cleanup writes after a call it brackets: the write
  // after the call is stored too.
  foreignReturnThroughEnsureAfterACall: rec =>
    [self runEnsureAfterACall: [^3]] ensure: [rec record: self.n]
    0

  runEnsureAfterACall: blk =>
    [blk value]
      ensure: [
        self bump
        self.n := self.n + 40
      ]
    0
