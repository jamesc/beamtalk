// BT-3817 (ADR 0131 Phase 3b): an `on:do:` / `ensure:` that writes an outer
// local is a local-threading producer at the method root, whatever position it
// sits in (statement, last expression, an assignment's value, an operand), in
// an arm of another producer and in a loop or fold body, and its protected
// body, handler and cleanup are `BranchArm` frames: a loop, fold, conditional
// or `on:do:` in one of them rebinds its locals into the frame's own scratch
// map. A raise discards the protected body's writes (ADR 0131 §"REPL and error
// examples"). The columns are adr0131exc_producer_{class,value,actor}.bt; the
// expected answers are in stdlib/test/adr0131exc_producer_test.bt.

Object subclass: Adr0131ExcProducerClass
  classState: n = 0

  class stA =>
    t := 0
    [t := t + 1] on: Error do: [:e | t := t + 100]
    t

  class stRaise =>
    t := 0
    [
      t := t + 1
      Error signal: "x"
    ] on: Error do: [:e | t := t + 100]
    t

  class stEnsure =>
    t := 0
    [t := t + 1] ensure: [t := t + 10]
    t

  // The cleanup writes `t` but does not read it: a cleanup that read the
  // protected block's write after the raise is a compile error (BT-4003).
  class stEnsureRaise =>
    t := 0
    [
      [
        t := t + 1
        Error signal: "x"
      ] ensure: [t := 10]
    ] on: Error do: [:e | nil]
    t

  class last =>
    t := 0
    [
      t := t + 1
      t
    ] on: Error do: [:e | 0]

  class lastRaise =>
    t := 0
    [
      Error signal: "x"
      1
    ]
      on: Error
      do: [:e |
        t := 5
        t + 2
      ]

  class assign =>
    t := 0
    r := [
      t := t + 1
      2
    ] on: Error do: [:e | 0]
    #[r, t]

  class assignRaise =>
    t := 0
    r := [
      t := t + 1
      Error signal: "x"
      2
    ]
      on: Error
      do: [:e |
        t := t + 7
        3
      ]
    #[r, t]

  class assignValue =>
    t := 0
    r := [t := t + 1] on: Error do: [:e | 0]
    #[r, t]

  class assignEnsureValue =>
    t := 0
    r := [t := t + 1] ensure: [nil]
    #[r, t]

  class operand =>
    t := 0
    r := ([
      t := t + 1
      2
    ] on: Error do: [:e | 0]) + 1
    #[r, t]

  class operandRight =>
    t := 0
    r := 10 + ([
      t := t + 1
      2
    ] on: Error do: [:e | 0])
    #[r, t]

  class operandEnsure =>
    t := 0
    r := ([
      t := t + 1
      2
    ] ensure: [t := t + 10]) + 1
    #[r, t]

  class seqRead =>
    t := 0
    r := t + ([
      t := t + 1
      2
    ] on: Error do: [:e | 0])
    #[r, t]

  class seqTwo =>
    t := 0
    r := ([
      t := t + 1
      1
    ] on: Error do: [:e | 0]) + ([
      t := t + 10
      2
    ] on: Error do: [:e | 0])
    #[r, t]

  class nestedBody =>
    t := 0
    [
      [t := t + 1] on: Error do: [:e | t := t + 100]
      t := t + 10
    ] on: Error do: [:e | t := t + 1000]
    t

  class nestedHandler =>
    t := 0
    [Error signal: "x"] on: Error do: [:e | [t := t + 1] ensure: [t := t + 10]]
    t

  class nestedOperand =>
    t := 0
    r := [
      ([
        t := t + 1
        1
      ] on: Error do: [:e | 0]) + 1
    ] on: Error do: [:e | 9]
    #[r, t]

  class doInBody =>
    t := 0
    [
      #(1, 2) do: [:x | t := t + x]
      t := t + 10
    ] on: Error do: [:e | nil]
    t

  class injectInBody =>
    t := 0
    r := [
      #(1, 2)
        inject: 0
        into: [:a :x |
          t := t + x
          a + x
        ]
    ] on: Error do: [:e | 0]
    #[r, t]

  class whileInBody =>
    t := 0
    [[t < 3] whileTrue: [t := t + 1]] on: Error do: [:e | nil]
    t

  class toDoInHandler =>
    t := 0
    [Error signal: "x"] on: Error do: [:e | 1 to: 3 do: [:i | t := t + i]]
    t

  class raiseInDo =>
    t := 0
    [
      #(1, 2)
        do: [:x |
          t := t + x
          x > 1 ifTrue: [Error signal: "x"]
        ]
    ] on: Error do: [:e | t := t + 100]
    t

  class condInBody: c =>
    t := 0
    [c ifTrue: [t := t + 1] ifFalse: [t := t + 2]] on: Error do: [:e | nil]
    t

  class condInHandler: c =>
    t := 0
    [
      Error signal: "x"
    ] on: Error do: [:e | c ifTrue: [t := t + 1] ifFalse: [t := t + 2]]
    t

  class inLoopBody =>
    t := 0
    #(1, 2) do: [:x | [t := t + x] on: Error do: [:e | nil]]
    t

  class inLoopOperand =>
    t := 0
    #(1, 2)
      do: [:x |
        t := t + ([
          t := t + x
          x
        ] on: Error do: [:e | 0])
      ]
    t

  class inLoopAssign =>
    t := 0
    #(1, 2)
      do: [:x |
        y := [
          t := t + x
          x
        ] on: Error do: [:e | 0]
        t := t + y
      ]
    t

  class inToDo =>
    t := 0
    1 to: 3 do: [:i | [t := t + i] ensure: [t := t + 10]]
    t

  class inWhile =>
    t := 0
    i := 0
    [i < 2]
      whileTrue: [
        i := i + 1
        [t := t + 1] on: Error do: [:e | nil]
      ]
    t

  class inTimes =>
    t := 0
    3 timesRepeat: [[t := t + 1] on: Error do: [:e | nil]]
    t

  class inCollect =>
    t := 0
    r := #(1, 2)
      collect: [:x |
        [
          t := t + x
          x * 2
        ] on: Error do: [:e | 0]
      ]
    #[r, t]

  class inInject =>
    t := 0
    r := #(1, 2)
      inject: 0
      into: [:a :x |
        a + ([
          t := t + x
          x
        ] on: Error do: [:e | 0])
      ]
    #[r, t]

  class raiseInLoop =>
    t := 0
    #(1, 2)
      do: [:x |
        [
          t := t + x
          Error signal: "x"
        ] on: Error do: [:e | t := t + 10]
      ]
    t

  class inArm: c =>
    t := 0
    c ifTrue: [[t := t + 1] on: Error do: [:e | nil]]
    t

  class armOperand: c =>
    t := 0
    c
      ifTrue: [
        t := ([
          t := t + 1
          5
        ] on: Error do: [:e | 0]) + t
      ]
    t

  class armEnsure: c =>
    t := 0
    c
      ifTrue: [
        r := [
          t := t + 1
          3
        ] ensure: [t := t + 10]
        t := t + r
      ]
    t

  class returnInBody =>
    t := 0
    [
      t := t + 1
      ^t
    ] on: Error do: [:e | 0]
    9

  class returnInArm: c =>
    t := 0
    c
      ifTrue: [
        ^[
          t := t + 1
          7
        ] on: Error do: [:e | 0]
      ]
    t

  class returnOperandInArm: c =>
    t := 0
    c
      ifTrue: [
        ^([
          t := t + 1
          7
        ] on: Error do: [:e | 0]) + t
      ]
    t

  class writeOnlyOnDo =>
    t := 0
    [t := 5] on: Error do: [:e | t := 6]
    t

  class writeOnlyEnsure =>
    t := 0
    [t := 5] ensure: [t := t + 1]
    t

  class writeOnlyHandler =>
    t := 0
    [Error signal: "x"] on: Error do: [:e | t := 4]
    t

  class zeroArgHandler =>
    t := 0
    [Error signal: "x"] on: Error do: [t := 4]
    t

  class twoLocals =>
    t := 0
    u := 0
    [
      t := t + 1
      u := u + 2
    ] on: Error do: [:e | nil]
    #[t, u]

  class blockLocal =>
    t := 0
    [
      m := 3
      t := t + m
    ] on: Error do: [:e | nil]
    t

  class ensureReads =>
    t := 0
    [
      t := t + 1
      t
    ] ensure: [t := t * 10]
    t

  class ensureTwice =>
    t := 0
    [t := t + 1] ensure: [t := t + 10]
    [t := t + 100] ensure: [t := t + 1000]
    t

  class afterEach =>
    t := 0
    [t := t + 1] on: Error do: [:e | nil]
    a := t
    [t := t + 1] on: Error do: [:e | nil]
    #[a, t]

  class fieldValueInLoop =>
    t := 0
    1
      to: 2
      do: [:x |
        self.n := ([
          t := t + x
          x
        ] on: Error do: [:e | 0]) + 1
      ]
    #[self.n, t]

  class fieldValueFoldInLoop =>
    t := 0
    1
      to: 2
      do: [:x |
        self.n := #(1, 2)
          inject: 0
          into: [:a :y |
            t := t + y
            a + y
          ]
      ]
    #[self.n, t]

  class fieldAssignOnDoInLoop =>
    t := 0
    2
      to: 3
      do: [:x |
        self.n := [
          t := t + 1
          x
        ] on: Error do: [:e | 0]
      ]
    #[self.n, t]

  class fieldValueInCondArm: c =>
    t := 0
    self.n := 0
    c ifTrue: [self.n := (#(1, 2) collect: [:x | t := t + x]) size]
    #[self.n, t]

  class fieldValueInArm: c =>
    t := 0
    self.n := 0
    c
      ifTrue: [
        self.n := ([
          t := t + 1
          5
        ] on: Error do: [:e | 0]) + 1
      ]
    #[self.n, t]

  class cvarInBody =>
    t := 0
    self.n := 0
    [
      self.n := self.n + 1
      t := t + 1
    ] on: Error do: [:e | nil]
    #[self.n, t]

  class cvarRaise =>
    t := 0
    self.n := 0
    [
      self.n := 5
      t := t + 1
      Error signal: "x"
    ] on: Error do: [:e | nil]
    #[self.n, t]

  class cvarFieldAssign =>
    t := 0
    self.n := [
      t := t + 1
      4
    ] on: Error do: [:e | 0]
    #[self.n, t]
