// BT-3985: superclass for the `super`-send rows of the closure self-send
// matrix (closure_self_send_matrix_test.bt). Its methods write `total`.

Actor subclass: ClosureSelfSendSuperBase
  state: items = #(1, 2, 3)
  state: total = 0

  bump => self.total := self.total + 1

  bump: x => self.total := self.total + x

  + x => self.total := self.total + x

  peek => self.total

  peek: x => self.total + x

  - x => self.total - x

  total => self.total
