// BT-1457 / BT-3958: Server subclass that raises an error in handleInfo:.
// Since ADR 0134 the error crashes the server; `terminate:` records the
// reason in the Ets table named by `tableName` (when set) so a test can see
// it after the process is gone. See stdlib/test/server_handle_info_test.bt.

Server subclass: FailingHandleInfoServer
  state: count = 0
  state: tableName = nil

  handleInfo: msg =>
    msg == #crash ifTrue: [
      Error signal: "deliberate handleInfo: error"
    ] ifFalse: [self.count := self.count + 1]

  getCount => self.count

  terminate: reason =>
    self.tableName isNil ifFalse: [
      (Ets named: self.tableName) at: #terminateReason put: reason
    ]
