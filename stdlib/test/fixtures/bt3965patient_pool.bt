// BT-3965 fixture: DynamicSupervisor whose children get 10 s to stop —
// enough for Bt3965SlowStopper's terminate:. See
// stdlib/test/supervision_shutdown_test.bt.

DynamicSupervisor(Bt3965SlowStopper) subclass: Bt3965PatientPool

  class childClass => Bt3965SlowStopper

  class childShutdown -> Integer => 10000
