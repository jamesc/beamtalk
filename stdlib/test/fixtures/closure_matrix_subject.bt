  awayRunR: other =>
    b := [self.n]
    self.n := 50
    other run: b

  awayCollectRunR: other =>
    b := [self.n]
    self.n := 50
    other collect: #(1, 2, 3) run: [:e | b value]

  awayViaFieldR: other =>
    b := [self.n]
    self.n := 50
    self.f := b
    other run: self.f

  awayRunRW: other =>
    b := [
      self.n := self.n + 1
      self.n
    ]
    self.n := 50
    other run: b

  awayCollectRunRW: other =>
    b := [
      self.n := self.n + 1
      self.n
    ]
    self.n := 50
    other collect: #(1, 2, 3) run: [:e | b value]

  awayViaFieldRW: other =>
    b := [
      self.n := self.n + 1
      self.n
    ]
    self.n := 50
    self.f := b
    other run: self.f

  awayNestedRunR: other =>
    inner := [self.n]
    b := [inner value]
    self.n := 50
    other run: b

  awayNestedRunRW: other =>
    inner := [
      self.n := self.n + 1
      self.n
    ]
    b := [inner value]
    self.n := 50
    other run: b
