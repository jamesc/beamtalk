// BT-4313: the unary `[...] whileTrue` / `[...] whileFalse` loops in actor
// methods, and the counter the other rows' conditions send to. See
// stdlib/test/bt4313unary_while_test.bt.

Actor subclass: Bt4313UnaryWhileActor
  state: n = 0

  fieldWhileTrue =>
    [
      self.n := self.n + 1
      self.n < 3
    ] whileTrue
    self.n

  fieldWhileFalse =>
    [
      self.n := self.n + 2
      self.n >= 6
    ] whileFalse
    self.n

  selfSendWhileTrue =>
    [self bump < 4] whileTrue
    self.n

  bump =>
    self.n := self.n + 1
    self.n

  count => self.n
