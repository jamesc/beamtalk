// BT-4292: an unrelated Value class passed where a GuardedDiffPoint is
// declared (a lying annotation). It understands `sum` and `describe` but not
// `add:`.

Value subclass: GuardedDiffImpostor
  field: x :: Integer = 0

  sum -> Integer => 2000 + self x

  describe -> String => "impostor"
