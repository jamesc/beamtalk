// BT-3704 (ADR 0130 Phase 1): a supervisor whose `initialize` hook sends
// `bump` to its class, which only the subclass makes write (the `initialize` row;
// instance-side since ADR 0135).

Supervisor subclass: CvsInitOverrideBase
  classState: n = 0

  class n => self.n

  class reset => self.n := 0

  class bump => self.n

  class writeN => self.n := self.n + 1

  strategy -> Symbol => #oneForOne

  childSpecs -> List => #()

  initialize => self class bump
