// BT-4310: the actor column of the BT-4310 cells of
// stdlib/test/bt4003residuals_test.bt. A fold whose block sends to `self`
// (`self.items inject: 0 into: [:b :y | b + self bump]`, 3 on a fresh actor,
// advancing `n` by 2) at an operand the sequencing rule leaves to another
// lowering: a conditional's receiver, a lookup key, a cascade message's
// argument, the argument of a `super`, `error:`, block-invocation, cast or
// block-taking send. Before BT-4310 each of these crashed (`Tuple does not
// understand '>'`), answered a wrong value or the raw `{Value, State}`
// carrier, or dropped the writes, and was a compile error until it was
// lowered as a producer of the frame that holds it.

Bt4310UnsequencedBase subclass: Bt4310UnsequencedActor

  bump =>
    self.n := self.n + 1
    self.n

  apply: v with: blk => blk value: v

  // At the method root.
  condRoot =>
    r := ((self.items inject: 0 into: [:b :y |
      b + self bump
    ]) > 2) ifTrue: [1] ifFalse: [0]
    #(r, self.n)

  condLeftRoot =>
    r := (0 < (self.items inject: 0 into: [:b :y |
      b + self bump
    ])) ifTrue: [1] ifFalse: [0]
    #(r, self.n)

  andRoot =>
    r := ((self.items inject: 0 into: [:b :y | b + self bump]) > 2) and: [true]
    #(r, self.n)

  orRoot =>
    r := ((self.items inject: 0 into: [:b :y | b + self bump]) > 5) or: [false]
    #(r, self.n)

  ifNilRoot =>
    r := (self.items inject: 0 into: [:b :y |
      b + self bump
    ]) ifNil: [0] ifNotNil: [:v | v + 1]
    #(r, self.n)

  keyRoot =>
    r := #{
      3 => 30
    } at: (self.items inject: 0 into: [:b :y | b + self bump]) ifAbsent: [0]
    #(r, self.n)

  superRoot =>
    super note: (self.items inject: 0 into: [:b :y | b + self bump])
    self.n

  errorRoot =>
    self error: (self.items inject: 0 into: [:b :y | b + self bump]) printString

  blockArgRoot =>
    r := [:z |
      z + 1
    ] value: (self.items inject: 0 into: [:b :y | b + self bump])
    #(r, self.n)

  selfBlockRoot =>
    r := self apply: (self.items inject: 0 into: [:b :y |
      b + self bump
    ]) with: [:z | z + 1]
    #(r, self.n)

  cascadeRoot =>
    r := 0 max: 1; max: (self.items inject: 0 into: [:b :y | b + self bump])
    #(r, self.n)

  castRoot: rec =>
    rec record: (self.items inject: 0 into: [:b :y | b + self bump])!
    #(rec last, self.n)

  // In a `collect:` body: the fold answers 3, then 7.
  condInCollect =>
    r := #(1, 2)
      collect: [:x |
        ((self.items inject: 0 into: [:b :y |
          b + self bump
        ]) > 5) ifTrue: [1] ifFalse: [0]
      ]
    #(r, self.n)

  andInCollect =>
    r := #(1, 2) collect: [:x |
      ((self.items inject: 0 into: [:b :y | b + self bump]) > 5) and: [true]
    ]
    #(r, self.n)

  ifNilInCollect =>
    r := #(1, 2)
      collect: [:x |
        (self.items inject: 0 into: [:b :y |
          b + self bump
        ]) ifNil: [0] ifNotNil: [:v | v + 1]
      ]
    #(r, self.n)

  keyInCollect =>
    r := #(1, 2)
      collect: [:x |
        #{
          3 => 30,
          7 => 70
        } at: (self.items inject: 0 into: [:b :y | b + self bump]) ifAbsent: [0]
      ]
    #(r, self.n)

  superInCollect =>
    r := #(1, 2) collect: [:x |
      super wrap: (self.items inject: 0 into: [:b :y | b + self bump])
    ]
    #(r, self.n)

  blockArgInCollect =>
    r := #(1, 2) collect: [:x |
      [:z | z + 1] value: (self.items inject: 0 into: [:b :y | b + self bump])
    ]
    #(r, self.n)

  selfBlockInCollect =>
    r := #(1, 2)
      collect: [:x |
        self apply: (self.items inject: 0 into: [:b :y |
          b + self bump
        ]) with: [:z | z + 1]
      ]
    #(r, self.n)

  cascadeInCollect =>
    r := #(1, 2) collect: [:x |
      0 max: 1; max: (self.items inject: 0 into: [:b :y | b + self bump])
    ]
    #(r, self.n)

  castInDo: rec =>
    #(1, 2) do: [:x |
      rec record: (self.items inject: 0 into: [:b :y | b + self bump])!
    ]
    #(rec last, self.n)

  // In the other frame kinds.
  condInMatchArm =>
    r := 1 match: [
      1 -> ((self.items inject: 0 into: [:b :y |
        b + self bump
      ]) > 2) ifTrue: [1] ifFalse: [0];
      _ -> 0
    ]
    #(r, self.n)

  condInMatchArmInDo =>
    r := 0
    #(5)
      do: [:x |
        r := x match: [
          5 -> (0 < (self.items inject: 0 into: [:b :y |
            b + self bump
          ])) ifTrue: [1];
          _ -> 0
        ]
      ]
    #(r, self.n)

  andInArm =>
    r := (self.n == 0) ifTrue: [
      ((self.items inject: 0 into: [:b :y | b + self bump]) > 2) and: [true]
    ]
    #(r, self.n)

  keyInEvaluatedBlock =>
    r := [:w |
      #{
        3 => 30
      } at: (self.items inject: 0 into: [:b :y | b + self bump]) ifAbsent: [w]
    ] value: 0
    #(r, self.n)

  ifNilInTimesRepeat =>
    r := 0
    2
      timesRepeat: [
        r := r + ((self.items inject: 0 into: [:b :y |
          b + self bump
        ]) ifNil: [0] ifNotNil: [:v | v])
      ]
    #(r, self.n)

  condInProtectedBody =>
    r := [
      ((self.items inject: 0 into: [:b :y |
        b + self bump
      ]) > 2) ifTrue: [1] ifFalse: [0]
    ] on: Error do: [:e | -1]
    #(r, self.n)

  // Real closures: their folds run against the actor-state cell (ADR 0137).
  superInStoredClosure =>
    blk := [super wrap: (self.items inject: 0 into: [:b :y | b + self bump])]
    #(blk value, self.n)

  blockArgInLookupHandler =>
    r := #{} at: #k ifAbsent: [
      [:z | z + 1] value: (self.items inject: 0 into: [:b :y | b + self bump])
    ]
    #(r, self.n)
