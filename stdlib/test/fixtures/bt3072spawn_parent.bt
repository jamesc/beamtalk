// BT-3072: an Actor whose class method hands a block containing `self spawn`
// to another class's block-taking method (fixtures/bt3047driver_plain.bt).
// The block executes inside the driver's own gen_server process (ADR 0109),
// so `self spawn` must still resolve against THIS class's lexical identity —
// closure-captured via `ClassSelf` (BT-3047) — spawning a BT3072SpawnParent
// instance rather than one of the driver's. Mirrors fixtures/bt3047parent.bt,
// which pins the same shape for `self new`.

Actor subclass: BT3072SpawnParent

  class spawnSelfThrough: aDriverClass over: aList :: List =>
    aDriverClass
      run: [:x |
        result := self spawn
        ^result
      ]
      over: aList
    #wrong
