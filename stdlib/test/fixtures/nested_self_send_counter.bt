// BT-3402: Actor fixture for self-sends (and field mutations) nested inside
// `and:`/`or:` block arguments.
//
// `and:`/`or:` are ordinary self-hosted Boolean methods (Boolean.bt: `and:
// aBlock => self ifTrue: aBlock ifFalse: [false]`), not compiler
// intrinsics, so before this fix the block argument compiled as a plain
// Tier 1 closure: a self-send (or `self.slot :=`) inside it ran, but its
// state mutation never made it back to the enclosing actor method.

Actor subclass: NestedSelfSendCounter
  state: count = 0

  // BT-3402: self-send as the RECEIVER of `and:` (`recordOnce:`, always
  // evaluated) plus a self-send NESTED INSIDE the block argument
  // (`bumpCount`, evaluated only when `and:`'s receiver is true).
  recordOnceAndBump: flag => (self recordOnce: flag) and: [self bumpCount > 0]

  // Same shape for `or:` — the block runs only when the receiver is false.
  recordOnceOrBump: flag => (self recordOnce: flag) or: [self bumpCount > 0]

  // BT-3402: a direct field mutation (`self.count :=`) inside the `and:`
  // block body itself, not via a nested self-send.
  mutateDirectlyInAndBlock: flag =>
    (self recordOnce: flag)
      and: [
        self.count := self.count + 100
        true
      ]

  mutateDirectlyInOrBlock: flag =>
    (self recordOnce: flag)
      or: [
        self.count := self.count + 100
        true
      ]

  internal recordOnce: flag =>
    self.count := self.count + 1
    flag

  internal bumpCount =>
    self.count := self.count + 1
    self.count

  getCount => self.count

  reset => self.count := 0
