// BUnit tests for ProcessDictionary (BT-4320)

TestCase subclass: ProcessDictionaryTest

  tearDown =>
    ProcessDictionary erase: #pdTestA
    ProcessDictionary erase: #pdTestB

  testMissingKeyAnswersNil =>
    self assert: (ProcessDictionary at: #pdTestA) equals: nil

  testPutThenAt =>
    ProcessDictionary at: #pdTestA put: 42
    self assert: (ProcessDictionary at: #pdTestA) equals: 42

  testPutAnswersNilWhenNew =>
    self assert: (ProcessDictionary at: #pdTestA put: 1) equals: nil

  testPutAnswersPreviousValue =>
    ProcessDictionary at: #pdTestA put: 1
    self assert: (ProcessDictionary at: #pdTestA put: 2) equals: 1
    self assert: (ProcessDictionary at: #pdTestA) equals: 2

  testAtIfAbsentRunsBlockWhenMissing =>
    self assert: (ProcessDictionary at: #pdTestA ifAbsent: [7]) equals: 7

  testAtIfAbsentSkipsBlockWhenPresent =>
    ProcessDictionary at: #pdTestA put: 1
    self assert: (ProcessDictionary at: #pdTestA ifAbsent: [7]) equals: 1

  testEraseAnswersRemovedValueAndRemoves =>
    ProcessDictionary at: #pdTestA put: 5
    self assert: (ProcessDictionary erase: #pdTestA) equals: 5
    self assert: (ProcessDictionary at: #pdTestA) equals: nil

  testEraseMissingAnswersNil =>
    self assert: (ProcessDictionary erase: #pdTestB) equals: nil

  testKeysListsStoredKeys =>
    ProcessDictionary at: #pdTestA put: 1
    ProcessDictionary at: #pdTestB put: 2
    keys := ProcessDictionary keys
    self assert: (keys includes: #pdTestA) equals: true
    self assert: (keys includes: #pdTestB) equals: true

  testKeysOmitsErasedKey =>
    ProcessDictionary at: #pdTestA put: 1
    ProcessDictionary erase: #pdTestA
    self assert: (ProcessDictionary keys includes: #pdTestA) equals: false

  // The class doc promises every operation acts on the *calling* process
  // (ADR 0142). If the class ever gained class variables, calls would move to
  // the shared class process and these two tests would fail.
  testWriteInTestProcessIsInvisibleToAnotherProcess =>
    ProcessDictionary at: #pdTestA put: 1
    other := (Parallel all: #([ProcessDictionary at: #pdTestA])) first
    self assert: other value equals: nil

  testWriteInAnotherProcessIsInvisibleToTestProcess =>
    (Parallel all: #([ProcessDictionary at: #pdTestB put: 2])) first
    self assert: (ProcessDictionary at: #pdTestB) equals: nil
