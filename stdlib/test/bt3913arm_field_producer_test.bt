// BT-3913: an actor arm's `self.n := <loop or fold>` keeps both the loop's
// outer-local write and the field. Pins the answer at runtime, which the
// codegen test `arm_field_assignment_with_producer_rhs_threads_ahead` does
// not. See fixtures/bt3913arm_field_producer_actor.bt.

TestCase subclass: Bt3913ArmFieldProducerTest

  testDoKeepsTheLocalAndStoresNil =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaDo: true) equals: #[3, nil]

  testDoNotTakenLeavesBoth =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaDo: false) equals: #[0, 0]

  testInjectKeepsTheLocalAndTheField =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaInject: true) equals: #[3, 3]

  testInjectNotTakenLeavesBoth =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaInject: false) equals: #[0, 0]

  testCollectKeepsTheLocalAndTheField =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaCollect: true) equals: #[3, #(2, 4)]

  testValueKeepsTheLocalAndTheField =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaValue: true) equals: #[1, 5]

  testOnDoKeepsTheLocalAndTheField =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaOnDo: true) equals: #[1, 5]

  testIfKeepsTheLocalAndTheField =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaIf: true) equals: #[1, 7]

  testNoneTakenLeavesBothForEveryKind =>
    self assert: (Bt3913ArmFieldProducerActor spawn viaCollect: false) equals: #[0, 0]
    self assert: (Bt3913ArmFieldProducerActor spawn viaValue: false) equals: #[0, 0]
    self assert: (Bt3913ArmFieldProducerActor spawn viaOnDo: false) equals: #[0, 0]
    self assert: (Bt3913ArmFieldProducerActor spawn viaIf: false) equals: #[0, 0]
