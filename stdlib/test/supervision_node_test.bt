// BT-2427: Tests for the SupervisionNode value class (ADR 0092 Phase 1).
//
// SupervisionNode records are minted by the runtime shim
// (beamtalk_process_navigation) and surfaced via `Workspace processes`. The
// end-to-end `Workspace processes` path needs a live workspace tree and is
// covered by the REPL e2e suite (BT-2433); here we exercise the value class
// directly via its auto-generated keyword constructor.

TestCase subclass: SupervisionNodeTest

  // --- Fixture helpers ---

  dbSupervisorNode =>
    SupervisionNode
      pid: nil
      registeredName: #db
      kind: #beamtalkSupervisor
      behaviourClass: nil
      childCount: 3

  otpProcessNode =>
    SupervisionNode
      pid: nil
      registeredName: nil
      kind: #otpProcess
      behaviourClass: nil
      childCount: 0

  beamtalkSupervisorNode =>
    SupervisionNode
      pid: nil
      registeredName: nil
      kind: #beamtalkSupervisor
      behaviourClass: nil
      childCount: 0

  beamtalkActorNode =>
    SupervisionNode
      pid: nil
      registeredName: nil
      kind: #beamtalkActor
      behaviourClass: nil
      childCount: 0

  beamtalkActorWithCounterNode =>
    SupervisionNode
      pid: nil
      registeredName: nil
      kind: #beamtalkActor
      behaviourClass: Counter
      childCount: 0

  restartingNode =>
    SupervisionNode
      pid: nil
      registeredName: nil
      kind: #restarting
      behaviourClass: nil
      childCount: 0

  // === Accessors return the stored field values ===
  testKindAccessor =>
    self assert: self dbSupervisorNode kind equals: #beamtalkSupervisor

  testRegisteredNameAccessor =>
    self assert: self dbSupervisorNode registeredName equals: #db

  testChildCountAccessor =>
    self assert: self dbSupervisorNode childCount equals: 3

  testBehaviourClassAccessor =>
    self assert: self beamtalkActorWithCounterNode behaviourClass equals: Counter

  testPidAccessorNilForRestarting =>
    self assert: self restartingNode pid equals: nil

  // === Accessor values ===
  testKindOtpProcess =>
    self assert: self otpProcessNode kind equals: #otpProcess

  testChildCountZero =>
    self assert: self otpProcessNode childCount equals: 0

  // === isSupervisor: true for both supervisor kinds ===
  testIsSupervisorBeamtalkSupervisor =>
    self assert: self beamtalkSupervisorNode isSupervisor equals: true

  testIsSupervisorOtpSupervisor =>
    node := SupervisionNode
      pid: nil
      registeredName: nil
      kind: #otpSupervisor
      behaviourClass: nil
      childCount: 0
    self assert: node isSupervisor equals: true

  testIsSupervisorFalseForActor =>
    self assert: self beamtalkActorNode isSupervisor equals: false

  // === isBeamtalk: true only for the #beamtalk* kinds ===
  testIsBeamtalkActor =>
    self assert: self beamtalkActorNode isBeamtalk equals: true

  testIsBeamtalkSupervisor =>
    self assert: self beamtalkSupervisorNode isBeamtalk equals: true

  testIsBeamtalkFalseForForeign =>
    self assert: self otpProcessNode isBeamtalk equals: false

  testIsBeamtalkFalseForRestarting =>
    self assert: self restartingNode isBeamtalk equals: false

  // === printString shape ===
  testPrintStringActorFormat =>
    self assert: self beamtalkActorWithCounterNode printString equals: "#SupervisionNode<#beamtalkActor Counter restarting>"

  testPrintStringSupervisorShowsChildCount =>
    node := SupervisionNode
      pid: nil
      registeredName: #appSup
      kind: #beamtalkSupervisor
      behaviourClass: nil
      childCount: 3
    self assert: node printString equals: "#SupervisionNode<#beamtalkSupervisor appSup restarting children: 3>"

  testPrintStringRestartingShowsRestarting =>
    self assert: self restartingNode printString equals: "#SupervisionNode<#restarting restarting>"
