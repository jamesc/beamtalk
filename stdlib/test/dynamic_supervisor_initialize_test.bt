// BT-1542: Tests for the DynamicSupervisor `initialize` hook (instance-side
// since ADR 0135 §1; it was `class initialize: sup`).
//
// Lifecycle tests (supervise → initialize → startChild) are also in
// tests/repl-protocol/cases/supervisor_initialize.btscript.

TestCase subclass: DynamicSupervisorInitializeTest

  class serial -> Boolean => true

  tearDown =>
    pool := DynSupWithInitialize current
    pool isNil ifFalse: [[pool stop] on: Error do: [:e | nil]]

  // The hook runs once per top-level start, with `self` the new pool, and can
  // message it (`self startChild`).
  testInitializePrepopulatesChildren =>
    pool := DynSupWithInitialize supervise unwrap
    self assert: pool count equals: 2
    // `supervise` again answers the running pool without re-running the hook
    again := DynSupWithInitialize supervise unwrap
    self assert: again count equals: 2

  // DynSupWithInitialize inherits isSupervisor from DynamicSupervisor
  testDynSupWithInitializeIsSupervisor =>
    self assert: DynSupWithInitialize isSupervisor equals: true
