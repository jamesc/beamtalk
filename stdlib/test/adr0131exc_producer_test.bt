  testArmOperand0 =>
    self assert: #[Adr0131ExcProducerClass armOperand: true, (Adr0131ExcProducerValue new) armOperand: true, (Adr0131ExcProducerActor spawn) armOperand: true] equals: #[6, 6, 6]

