  testInArm0 =>
    self assert: #[Adr0131ExcProducerClass inArm: true, (Adr0131ExcProducerValue new) inArm: true, (Adr0131ExcProducerActor spawn) inArm: true] equals: #[1, 1, 1]

  testInArm1 =>
