  testActorFieldValueInCondArm1 =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldValueInCondArm: false) equals: #[0, 0]

  testActorFieldValueInArm0 =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldValueInArm: true) equals: #[6, 1]

  testActorFieldValueInArm1 =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldValueInArm: false) equals: #[0, 0]

  testActorFieldInBody =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldInBody) equals: #[1, 1]

  testActorFieldRaise =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldRaise) equals: #[0, 0]

  testActorFieldFieldAssign =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldFieldAssign) equals: #[4, 1]

  testActorFieldInHandler =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldInHandler) equals: #[10, 1]

  testActorFieldInLoop =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldInLoop) equals: #[3, 3]
