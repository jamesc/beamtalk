  testInLoopBody =>
    self assert: #[Adr0131ExcProducerClass inLoopBody, (Adr0131ExcProducerValue new) inLoopBody, (Adr0131ExcProducerActor spawn) inLoopBody] equals: #[3, 3, 3]

  testInLoopOperand =>
    self assert: #[Adr0131ExcProducerClass inLoopOperand, (Adr0131ExcProducerValue new) inLoopOperand] equals: #[3, 3]

