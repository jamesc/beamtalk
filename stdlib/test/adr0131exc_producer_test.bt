  testCondInBody0 =>
    self assert: #[Adr0131ExcProducerClass condInBody: true, (Adr0131ExcProducerValue new) condInBody: true, (Adr0131ExcProducerActor spawn) condInBody: true] equals: #[1, 1, 1]

