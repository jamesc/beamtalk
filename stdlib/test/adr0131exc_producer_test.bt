  testClassCvarRaise =>
    self assert: (Adr0131ExcProducerClass cvarRaise) equals: #[0, 0]

  testClassCvarFieldAssign =>
    self assert: (Adr0131ExcProducerClass cvarFieldAssign) equals: #[4, 1]

  testActorFieldValueInLoop =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldValueInLoop) equals: #[3, 3]

  testActorFieldValueFoldInLoop =>
    self assert: ((Adr0131ExcProducerActor spawn) fieldValueFoldInLoop) equals: #[3, 6]

  testActorFieldAssignOnDoInLoop =>
