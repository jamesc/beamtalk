// BT-3817 (ADR 0131 Phase 3b): an `on:do:` / `ensure:` that writes an outer
// local is a local-threading producer at the method root, whatever position it
// sits in (statement, last expression, an assignment's value, an operand), in
// an arm of another producer and in a loop or fold body, and its protected
// body, handler and cleanup are `BranchArm` frames: a loop, fold, conditional
// or `on:do:` in one of them rebinds its locals into the frame's own scratch
// map. A raise discards the protected body's writes (ADR 0131 §"REPL and error
// examples"). The columns are adr0131exc_producer_{class,value,actor}.bt; the
// expected answers are in stdlib/test/adr0131exc_producer_test.bt.

TestCase subclass: Adr0131ExcProducerTest

  testStA =>
    self assert: #[Adr0131ExcProducerClass stA, (Adr0131ExcProducerValue new) stA, (Adr0131ExcProducerActor spawn) stA] equals: #[1, 1, 1]

  testStRaise =>
    self assert: #[Adr0131ExcProducerClass stRaise, (Adr0131ExcProducerValue new) stRaise, (Adr0131ExcProducerActor spawn) stRaise] equals: #[100, 100, 100]

  testStEnsure =>
    self assert: #[Adr0131ExcProducerClass stEnsure, (Adr0131ExcProducerValue new) stEnsure, (Adr0131ExcProducerActor spawn) stEnsure] equals: #[11, 11, 11]

  testStEnsureRaise =>
    self assert: #[Adr0131ExcProducerClass stEnsureRaise, (Adr0131ExcProducerValue new) stEnsureRaise, (Adr0131ExcProducerActor spawn) stEnsureRaise] equals: #[0, 0, 0]

  testLast =>
    self assert: #[Adr0131ExcProducerClass last, (Adr0131ExcProducerValue new) last, (Adr0131ExcProducerActor spawn) last] equals: #[1, 1, 1]

  testLastRaise =>
    self assert: #[Adr0131ExcProducerClass lastRaise, (Adr0131ExcProducerValue new) lastRaise, (Adr0131ExcProducerActor spawn) lastRaise] equals: #[7, 7, 7]

  testAssign =>
    self assert: #[Adr0131ExcProducerClass assign, (Adr0131ExcProducerValue new) assign, (Adr0131ExcProducerActor spawn) assign] equals: #[#[2, 1], #[2, 1], #[2, 1]]

  testAssignRaise =>
    self assert: #[Adr0131ExcProducerClass assignRaise, (Adr0131ExcProducerValue new) assignRaise, (Adr0131ExcProducerActor spawn) assignRaise] equals: #[#[3, 7], #[3, 7], #[3, 7]]

  testAssignValue =>
    self assert: #[Adr0131ExcProducerClass assignValue, (Adr0131ExcProducerValue new) assignValue, (Adr0131ExcProducerActor spawn) assignValue] equals: #[#[1, 1], #[1, 1], #[1, 1]]

  testAssignEnsureValue =>
    self assert: #[Adr0131ExcProducerClass assignEnsureValue, (Adr0131ExcProducerValue new) assignEnsureValue, (Adr0131ExcProducerActor spawn) assignEnsureValue] equals: #[#[1, 1], #[1, 1], #[1, 1]]

  testOperand =>
    self assert: #[Adr0131ExcProducerClass operand, (Adr0131ExcProducerValue new) operand, (Adr0131ExcProducerActor spawn) operand] equals: #[#[3, 1], #[3, 1], #[3, 1]]

  testOperandRight =>
    self assert: #[Adr0131ExcProducerClass operandRight, (Adr0131ExcProducerValue new) operandRight, (Adr0131ExcProducerActor spawn) operandRight] equals: #[#[12, 1], #[12, 1], #[12, 1]]

  testOperandEnsure =>
    self assert: #[Adr0131ExcProducerClass operandEnsure, (Adr0131ExcProducerValue new) operandEnsure, (Adr0131ExcProducerActor spawn) operandEnsure] equals: #[#[3, 11], #[3, 11], #[3, 11]]

  testSeqRead =>
    self assert: #[Adr0131ExcProducerClass seqRead, (Adr0131ExcProducerValue new) seqRead, (Adr0131ExcProducerActor spawn) seqRead] equals: #[#[2, 1], #[2, 1], #[2, 1]]

  testSeqTwo =>
    self assert: #[Adr0131ExcProducerClass seqTwo, (Adr0131ExcProducerValue new) seqTwo, (Adr0131ExcProducerActor spawn) seqTwo] equals: #[#[3, 11], #[3, 11], #[3, 11]]

  testNestedBody =>
    self assert: #[Adr0131ExcProducerClass nestedBody, (Adr0131ExcProducerValue new) nestedBody, (Adr0131ExcProducerActor spawn) nestedBody] equals: #[11, 11, 11]

