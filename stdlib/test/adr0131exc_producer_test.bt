    self assert: #[Adr0131ExcProducerClass condInBody: false, (Adr0131ExcProducerValue new) condInBody: false, (Adr0131ExcProducerActor spawn) condInBody: false] equals: #[2, 2, 2]

  testCondInHandler0 =>
