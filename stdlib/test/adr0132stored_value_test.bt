// BT-3867 (ADR 0132 Phase 0b, I5): a stored Tier 2 block sent `value` in a class
// or value-type method is an inline producer over a fresh map (ADR 0131 probe
// s4), as an actor instance method already threads it through `State`. The
// methods under test are in
// stdlib/test/fixtures/adr0132stored_value_{class,value,actor}.bt; the expected
// answers are the assertions below.

TestCase subclass: Adr0132StoredValueTest

  testValue =>
    self assert: #[Adr0132StoredValueClass stValue, (Adr0132StoredValueValue new) stValue, (Adr0132StoredValueActor spawn) stValue] equals: #[1, 1, 1]

  testTwice =>
    self assert: #[Adr0132StoredValueClass stTwice, (Adr0132StoredValueValue new) stTwice, (Adr0132StoredValueActor spawn) stTwice] equals: #[2, 2, 2]

  testArg =>
    self assert: #[Adr0132StoredValueClass stArg, (Adr0132StoredValueValue new) stArg, (Adr0132StoredValueActor spawn) stArg] equals: #[5, 5, 5]

  testCascade =>
    self assert: #[Adr0132StoredValueClass stCascade, (Adr0132StoredValueValue new) stCascade, (Adr0132StoredValueActor spawn) stCascade] equals: #[3, 3, 3]

  testArg2 =>
    self assert: #[Adr0132StoredValueClass stArg2, (Adr0132StoredValueValue new) stArg2] equals: #[3, 3]

  testAssign =>
    self assert: #[Adr0132StoredValueClass stAssign, (Adr0132StoredValueValue new) stAssign] equals: #[#[7, 5], #[7, 5]]

  testReturn =>
    self assert: #[Adr0132StoredValueClass stReturn, (Adr0132StoredValueValue new) stReturn] equals: #[1, 1]

  testLast =>
    self assert: #[Adr0132StoredValueClass stLast, (Adr0132StoredValueValue new) stLast] equals: #[1, 1]

  testCascadeAssign =>
    self assert: #[Adr0132StoredValueClass stCascadeAssign, (Adr0132StoredValueValue new) stCascadeAssign] equals: #[#[3, 3], #[3, 3]]

  testTwoLocals =>
    self assert: #[Adr0132StoredValueClass stTwoLocals, (Adr0132StoredValueValue new) stTwoLocals] equals: #[#[1, 12], #[1, 12]]
