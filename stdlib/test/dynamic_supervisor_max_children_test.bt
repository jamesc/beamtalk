// BT-3964: DynamicSupervisor maxChildren limit (instance-side since ADR 0135).
//
// Fixtures: stdlib/test/fixtures/test_dynamic_supervisor_capped.bt,
//           stdlib/test/fixtures/test_dynamic_supervisor_bad_cap.bt

TestCase subclass: DynamicSupervisorMaxChildrenTest

  // Each fixture supervise/stop registers a single node-wide,
  // name-registered process — run serially (same as
  // DynamicSupervisorDefaultsTest, BT-3379).
  class serial -> Boolean => true

  // Stop the shared pool even when an assertion fails mid-test, so the next
  // test starts from an empty supervisor rather than `already_started`.
  tearDown =>
    pool := TestDynamicSupervisorCapped current
    pool isNil ifFalse: [[pool stop] on: Error do: [:e | nil]]

  testSubclassOverridesMaxChildren =>
    pool := TestDynamicSupervisorCapped supervise unwrap
    self assert: pool maxChildren equals: 2

  testStartChildFailsAtLimitAndRecoversAfterTerminate =>
    pool := (TestDynamicSupervisorCapped supervise) unwrap
    first := pool startChild unwrap
    pool startChild unwrap
    self assert: pool count equals: 2
    third := pool startChild
    self assert: third isError equals: true
    self assert: third error kind equals: #max_children
    self assert: (third error message includesSubstring: "2") equals: true
    self assert: pool count equals: 2
    (pool terminateChild: first) unwrap
    self assert: pool count equals: 1
    self assert: pool startChild isOk equals: true
    self assert: pool count equals: 2

  testStartChildWithArgsFailsAtLimit =>
    pool := (TestDynamicSupervisorCapped supervise) unwrap
    (pool startChild: #{#value => 1}) unwrap
    (pool startChild: #{#value => 2}) unwrap
    result := pool startChild: #{#value => 3}
    self assert: result isError equals: true
    self assert: result error kind equals: #max_children

  testStartChildWithNameFailsAtLimit =>
    pool := (TestDynamicSupervisorCapped supervise) unwrap
    (pool startChild: #{#value => 1} name: #dsMaxChildrenTestA) unwrap
    (pool startChild: #{#value => 2} name: #dsMaxChildrenTestB) unwrap
    result := pool startChild: #{#value => 3} name: #dsMaxChildrenTestC
    self assert: result isError equals: true
    self assert: result error kind equals: #max_children
    // The refused child was never started, so its name is not registered.
    self assert: (Counter named: #dsMaxChildrenTestC) isError equals: true

  testSuperviseIsIdempotentWithCap =>
    // A second `supervise` returns the running, capped instance.
    pool := (TestDynamicSupervisorCapped supervise) unwrap
    pool startChild unwrap
    again := (TestDynamicSupervisorCapped supervise) unwrap
    self assert: again count equals: 1

  testInvalidMaxChildrenFailsSupervise =>
    result := TestDynamicSupervisorBadCap supervise
    self assert: result isError equals: true
    self assert: result error kind equals: #supervisor_start_failed
    self assert: TestDynamicSupervisorBadCap current equals: nil
