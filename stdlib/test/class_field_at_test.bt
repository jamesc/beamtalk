// Tests for BT-4148 (ADR 0124 §4i): `Cls fieldAt:` / `Cls fieldAt:put:` sent
// to a class object from outside the class reach the class gen_server's own
// class variables, instead of crashing it.
//
// Fixtures:
//   stdlib/test/fixtures/field_at_class_var_outside_actor.bt

TestCase subclass: ClassFieldAtTest

  // One test drives the fixture class through the whole lifecycle: its class
  // variables live in one long-lived class gen_server, never reset between
  // test methods, so several methods on the same class would be
  // order-dependent.
  testClassFieldAtLifecycleFromOutside =>
    // Eager class variable: read its initial value.
    self assert: (FieldAtClassVarOutsideActor fieldAt: #total) equals: 0
    // Unassigned `late` class variable: the read raises, like `get_class_var`.
    self should: [
      FieldAtClassVarOutsideActor fieldAt: #current
    ] raise: #uninitialized_state_error
    // The class process survived the error and still answers sends.
    self deny: (FieldAtClassVarOutsideActor hasField: #current)
    // Write answers the assigned value; a class method sees it.
    self assert: (FieldAtClassVarOutsideActor fieldAt: #current put: 7) equals: 7
    self assert: FieldAtClassVarOutsideActor getCurrent equals: 7
    self assert: (FieldAtClassVarOutsideActor fieldAt: #current) equals: 7
    self assert: (FieldAtClassVarOutsideActor fieldAt: #total put: 3) equals: 3
    self assert: FieldAtClassVarOutsideActor getTotal equals: 3
    // Undeclared names: the read and the (checked) write both raise.
    self should: [
      FieldAtClassVarOutsideActor fieldAt: #nope
    ] raise: #undeclared_class_variable
    self should: [
      FieldAtClassVarOutsideActor fieldAt: #nope put: 1
    ] raise: #undeclared_class_variable
    self deny: (FieldAtClassVarOutsideActor hasField: #nope)
    // Still alive after every error above.
    self assert: FieldAtClassVarOutsideActor getCurrent equals: 7

  // Primitive receivers keep the intrinsic's inline `immutable_value` error,
  // hint included (`fieldAt:put:` on a literal is a compile-time error;
  // reflection_basic_test.bt covers its runtime path).
  testPrimitiveFieldAtStillRaisesImmutableValue =>
    self should: [42 fieldAt: #x] raise: #immutable_value

  testPrimitiveFieldAtKeepsItsHint =>
    hint := [42 fieldAt: #x] on: Exception do: [:e | e hint]
    self assert: hint equals: "Value types have no instance variables"
