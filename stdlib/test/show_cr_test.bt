// BT-984 / BT-3642: BUnit tests for Object>>show: and Object>>showCr:
//
// Both delegate to the `Transcript` class-side facade (ADR 0129 §5). Under
// `beamtalk test` there is no interactive workspace, so the output is a Logger
// notice; the tests assert on return values, not on captured output.

TestCase subclass: ShowCrTest

  testShowCrReturnsReceiver => self assert: (42 showCr: "hello") equals: 42

  testShowReturnsReceiver => self assert: (42 show: "hello") equals: 42

  testShowCrAcceptsNonStringValue =>
    self assert: ("abc" showCr: 7) equals: "abc"
