    self should: [c awayCollectRunRW: runner] raise: #actor_state_unreachable
    self assert: c n equals: 2

  testAwayViaFieldRW =>
    c := ClosureMatrixSubject spawn
    runner := ClosureCellRunner spawn
    self should: [c awayViaFieldRW: runner] raise: #actor_state_unreachable
    self assert: c n equals: 2

  testAwayNestedRunR =>
    c := ClosureMatrixSubject spawn
    runner := ClosureCellRunner spawn
    self assert: (c awayNestedRunR: runner) equals: 2
    self assert: c n equals: 50

  testAwayNestedRunRW =>
    c := ClosureMatrixSubject spawn
    runner := ClosureCellRunner spawn
    self should: [c awayNestedRunRW: runner] raise: #actor_state_unreachable
    self assert: c n equals: 2
