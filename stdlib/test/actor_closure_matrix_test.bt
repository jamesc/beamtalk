    self assert: c n equals: 50

  testAwayRunRW =>
    c := ClosureMatrixSubject spawn
    runner := ClosureCellRunner spawn
    self should: [c awayRunRW: runner] raise: #actor_state_unreachable
    self assert: c n equals: 2

  testAwayCollectRunRW =>
