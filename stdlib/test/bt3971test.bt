// BT-3971: see fixtures/bt3971actor.bt.

TestCase subclass: Bt3971Test

  testBlockValueNotLastIsDiscarded =>
    self assert: Bt3971Actor spawn notLast equals: #(7)

  testPureBlockValueAnswersTheValue =>
    self assert: Bt3971Actor spawn pureValue equals: #(3)

  testBlockValueInConditionalArmAnswersTheValue =>
    self assert: Bt3971Actor spawn inArm equals: #(3)
