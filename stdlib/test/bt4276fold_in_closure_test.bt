// BT-4276: an actor-state fold as an operand inside a closure in a loop body
// is judged by the closure's own context. Measured right on the BEAM: every
// state change is kept and the fold answers its value, not a raw
// `{Value, State}` pair. Fixture: fixtures/bt4276fold_in_closure.bt.

TestCase subclass: Bt4276FoldInClosureTest
  field: actor = nil

  setUp => self.actor := Bt4276FoldInClosure spawn

  tearDown => self.actor isNil ifFalse: [self.actor stop]

  testInjectInClosureRunInLoop =>
    self assert: self.actor injectInClosureRunInLoop equals: 9
    self assert: self.actor n equals: 4

  testInjectInClosuresRunAfterLoop =>
    self assert: self.actor injectInClosuresRunAfterLoop equals: #(4, 9)
    self assert: self.actor n equals: 4

  testDoReceiverInClosure =>
    self assert: self.actor doReceiverInClosure equals: 4

  testCollectWritingFieldInClosure =>
    self assert: self.actor collectWritingFieldInClosure equals: 4

  testInjectInClosurePassedToMethod =>
    self assert: self.actor injectInClosurePassedToMethod equals: 17
    self assert: self.actor n equals: 8
