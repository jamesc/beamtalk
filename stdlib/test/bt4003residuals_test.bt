// BT-4003: the residuals found during BT-3912, measured on a
// BEAM in class, value-type and actor methods (the REPL column is
// tests/repl-protocol/cases/bt4003_repl_returns.btscript). Every cell here is
// an accepted shape that answers right:
//
// 1. an `ensure:` cleanup reading a local the protected block wrote, when no
//    error can follow the write (a permanent rule, ADR 0133);
// 2. a `^` closure that reads only its own locals, or locals written before it;
// 3. an actor fold that sends to `self` or writes a field, as an operand
//    inside a fold or loop body: BT-4287 lowered it as a producer of the frame
//    that holds it, at every producer site of the statement (the
//    `bt4287_*` acceptance test in
//    crates/beamtalk-core/src/semantic_analysis/tests/local_threading.rs),
//    and BT-4310 at every other operand (a conditional's receiver, a lookup
//    key, a cascade message's argument, the argument of a `super`, `error:`,
//    block-invocation, cast or block-taking send; the `bt4310_*` acceptance
//    test), at the method root and in every frame. Class and value-type
//    methods answer right everywhere; a value-type self-send never changes
//    the caller's `self`;
// 4. a `^` in a `do:` that threads a local and the actor's state.
//
// The shapes of items 1 and 2 that answered wrong are compile errors (the
// `bt4003_*` tests in the same file).
//
// Fixtures: fixtures/bt4003residuals_actor.bt, fixtures/bt4003residuals_class.bt,
// and for BT-4310 fixtures/bt4310unsequenced_actor.bt (its superclass
// fixtures/bt4310unsequenced_base.bt) and fixtures/bt4310unsequenced_class.bt.

TestCase subclass: Bt4003ResidualsTest
  field: n = 0

  vEnsureWriteLast: rec =>
    t := 0
    [t := 9] ensure: [rec record: t]
    rec last

  vEnsureRaiseBeforeWrite: rec =>
    t := 0
    [
      [
        1 / 0
        t := 9
      ] ensure: [rec record: t]
    ] on: Error do: [:e | nil]
    rec last

  vClosureOwnLocalReturn =>
    b := [:z |
      w := z
      #(1, 2)
        do: [:k |
          w := w + k
          k == 2 ifTrue: [^w]
        ]
      -2
    ]
    b value: 10
    -1

  vClosureLocalWrittenBefore =>
    t := 5
    b := [^t]
    b value
    -1

  vTupleAccDoReturn =>
    t := 0
    #(1, 2, 3)
      do: [:x |
        t := t + x
        self.n := self.n + 1
        x == 2 ifTrue: [^#(t, self.n)]
      ]
    -1

  testEnsureWriteLast =>
    self assert: (self vEnsureWriteLast: ClosureCellRecorder spawn) equals: 9
    self assert: (Bt4003ResidualsClass ensureWriteLast: ClosureCellRecorder spawn) equals: 9
    self assert: (Bt4003ResidualsActor spawn ensureWriteLast: ClosureCellRecorder spawn) equals: 9

  testEnsureRaiseBeforeWrite =>
    self assert: (self vEnsureRaiseBeforeWrite: ClosureCellRecorder spawn) equals: 0
    self assert: (Bt4003ResidualsClass ensureRaiseBeforeWrite: ClosureCellRecorder spawn) equals: 0
    self assert: (Bt4003ResidualsActor spawn ensureRaiseBeforeWrite: ClosureCellRecorder spawn) equals: 0

  testClosureOwnLocalReturn =>
    self assert: self vClosureOwnLocalReturn equals: 13
    self assert: Bt4003ResidualsClass closureOwnLocalReturn equals: 13
    self assert: Bt4003ResidualsActor spawn closureOwnLocalReturn equals: 13

  testClosureLocalWrittenBefore =>
    self assert: self vClosureLocalWrittenBefore equals: 5
    self assert: Bt4003ResidualsClass closureLocalWrittenBefore equals: 5
    self assert: Bt4003ResidualsActor spawn closureLocalWrittenBefore equals: 5

  testActorStateFoldPositionsInAFoldBody =>
    self assert: Bt4003ResidualsActor spawn stmtFoldInFold equals: 4
    self assert: Bt4003ResidualsActor spawn assignInFold equals: 4
    self assert: Bt4003ResidualsActor spawn fieldWriteStmtInDo equals: 4
    self assert: Bt4003ResidualsActor spawn collectReceiverInCollect equals: #(#(3, 4), 4)
    self assert: Bt4003ResidualsActor spawn collectReceiverInDo equals: 4
    self assert: Bt4003ResidualsActor spawn selectReceiverInCollect equals: #(#(2, 2), 4)
    self assert: Bt4003ResidualsActor spawn collectReceiverInTimes equals: 4
    self assert: Bt4003ResidualsActor spawn collectReceiverInArmInDo equals: 4
    self assert: Bt4003ResidualsActor spawn injectOperandAtTop equals: #(4, 2)

  // BT-4287: a state fold as an operand inside a fold or loop body.
  testActorStateFoldAsAnOperandInAFoldBody =>
    self assert: Bt4003ResidualsActor spawn injectArgInInject equals: #(10, 4)
    self assert: Bt4003ResidualsActor spawn injectOperandInDo equals: 4
    self assert: Bt4003ResidualsActor spawn injectArgInCollect equals: #(#(3, 7), 4)
    self assert: Bt4003ResidualsActor spawn doReceiverInDo equals: 4
    self assert: Bt4003ResidualsActor spawn fieldCollectReceiverInDo equals: 4
    self assert: Bt4003ResidualsActor spawn fieldCollectReceiverInCollect equals: #(#(3, 4), 4)
    self assert: Bt4003ResidualsActor spawn doElementInTimes equals: 4
    self assert: Bt4003ResidualsActor spawn injectOperandInArmInDo equals: 4
    self assert: Bt4003ResidualsActor spawn injectOperandInEvaluatedBlockInDo equals: 4
    self assert: Bt4003ResidualsActor spawn injectOperandInDoInClosure equals: 4
    self assert: Bt4003ResidualsActor spawn detectArgInSelect equals: #(#(1, 2, 3), 6)
    self assert: Bt4003ResidualsActor spawn countedLoopReceiverInDo equals: 4
    self assert: Bt4003ResidualsActor spawn injectInCascadeInDo equals: 4
    self assert: Bt4003ResidualsActor spawn injectOperandInLocalThreadingDo equals: #(13, 4)
    self assert: Bt4003ResidualsActor spawn andArgInCollect equals: #(#(false, true), 4)
    self assert: Bt4003ResidualsActor spawn deeperOperandInCollect equals: #(#(5, 10), 4)

  // BT-4287 review: the same fold as an operand in every other kind of frame
  // (plain and producer exception bodies and handlers, `match:` arms, lookup
  // and `ifNone:` handlers, applied and stored blocks, a `whileTrue:`
  // condition), in a fold body and at the method root.
  testStateFoldAsAnOperandInEveryFrameKind =>
    self assert: Bt4003ResidualsActor spawn oProtectedInDo equals: 4
    self assert: Bt4003ResidualsClass oProtectedInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oHandlerInDo equals: 4
    self assert: Bt4003ResidualsClass oHandlerInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oEnsureBodyInDo equals: 4
    self assert: Bt4003ResidualsClass oEnsureBodyInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oEnsureCleanupInDo equals: 4
    self assert: Bt4003ResidualsClass oEnsureCleanupInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oMatchArmInDo equals: 2
    self assert: Bt4003ResidualsClass oMatchArmInDo equals: 2
    self assert: Bt4003ResidualsActor spawn oIfAbsentInDo equals: 4
    self assert: Bt4003ResidualsClass oIfAbsentInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oIfNoneHandler equals: 2
    self assert: Bt4003ResidualsClass oIfNoneHandler equals: 2
    self assert: Bt4003ResidualsActor spawn oValueArgBlockInDo equals: 4
    self assert: Bt4003ResidualsClass oValueArgBlockInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oWhileConditionInDo equals: 4
    self assert: Bt4003ResidualsClass oWhileConditionInDo equals: 4
    self assert: Bt4003ResidualsActor spawn oRootProtected equals: 2
    self assert: Bt4003ResidualsClass oRootProtected equals: 2
    self assert: Bt4003ResidualsActor spawn oRootEnsureBody equals: 2
    self assert: Bt4003ResidualsClass oRootEnsureBody equals: 2
    self assert: Bt4003ResidualsActor spawn oRootMatchArm equals: 2
    self assert: Bt4003ResidualsClass oRootMatchArm equals: 2
    self assert: Bt4003ResidualsActor spawn oRootIfAbsent equals: 2
    self assert: Bt4003ResidualsClass oRootIfAbsent equals: 2
    self assert: Bt4003ResidualsActor spawn oProducerArmInDo equals: #(2, 4)
    self assert: Bt4003ResidualsClass oProducerArmInDo equals: #(2, 4)
    self assert: Bt4003ResidualsActor spawn oProducerProtectedInDo equals: #(2, 4)
    self assert: Bt4003ResidualsClass oProducerProtectedInDo equals: #(2, 4)
    self assert: Bt4003ResidualsActor spawn oStoredClosureInDo equals: 4

  testClassStateFoldAsAnOperandInAFoldBody =>
    self assert: Bt4003ResidualsClass injectOperandInDo equals: 4
    self assert: Bt4003ResidualsClass doReceiverInDo equals: 4
    self assert: Bt4003ResidualsClass injectArgInCollect equals: #(#(3, 7), 4)
    self assert: Bt4003ResidualsClass injectArgInInject equals: #(10, 4)
    self assert: Bt4003ResidualsClass fieldCollectReceiverInDo equals: 4
    self assert: Bt4003ResidualsClass fieldCollectReceiverInCollect equals: #(#(3, 4), 4)
    self assert: Bt4003ResidualsClass doElementInTimes equals: 4
    self assert: Bt4003ResidualsClass injectOperandInArmInDo equals: 4
    self assert: Bt4003ResidualsClass detectArgInSelect equals: #(#(1, 2, 3), 6)
    self assert: Bt4003ResidualsClass countedLoopReceiverInDo equals: 4
    self assert: Bt4003ResidualsClass injectInCascadeInDo equals: 4

  testReturnInATupleAccDo =>
    self assert: self vTupleAccDoReturn equals: #(3, 2)
    self assert: Bt4003ResidualsClass tupleAccDoReturn equals: 3
    a := Bt4003ResidualsActor spawn
    self assert: a tupleAccDoReturn equals: 3
    self assert: a n equals: 2
    b := Bt4003ResidualsActor spawn
    self assert: b tupleAccDoReturnBump equals: #(3, 2)
    self assert: b n equals: 2

  // BT-4310: the fold (3, then 7; `n` advances by 2 each time) at an operand
  // the sequencing rule leaves to another lowering, at the method root.
  testStateFoldAtAnUnsequencedOperandAtTheRoot =>
    self assert: Bt4310UnsequencedActor spawn condRoot equals: #(1, 2)
    self assert: Bt4310UnsequencedClass condRoot equals: #(1, 2)
    self assert: Bt4310UnsequencedActor spawn condLeftRoot equals: #(1, 2)
    self assert: Bt4310UnsequencedClass condLeftRoot equals: #(1, 2)
    self assert: Bt4310UnsequencedActor spawn andRoot equals: #(true, 2)
    self assert: Bt4310UnsequencedClass andRoot equals: #(true, 2)
    self assert: Bt4310UnsequencedActor spawn orRoot equals: #(false, 2)
    self assert: Bt4310UnsequencedClass orRoot equals: #(false, 2)
    self assert: Bt4310UnsequencedActor spawn ifNilRoot equals: #(4, 2)
    self assert: Bt4310UnsequencedClass ifNilRoot equals: #(4, 2)
    self assert: Bt4310UnsequencedActor spawn keyRoot equals: #(30, 2)
    self assert: Bt4310UnsequencedClass keyRoot equals: #(30, 2)
    self assert: Bt4310UnsequencedActor spawn superRoot equals: 302
    self assert: ([
      Bt4310UnsequencedActor spawn errorRoot
    ] on: Error do: [:e | e message]) equals: "3"
    self assert: ([
      Bt4310UnsequencedClass errorRoot
    ] on: Error do: [:e | e message]) equals: "3"
    self assert: Bt4310UnsequencedActor spawn blockArgRoot equals: #(4, 2)
    self assert: Bt4310UnsequencedClass blockArgRoot equals: #(4, 2)
    self assert: Bt4310UnsequencedActor spawn selfBlockRoot equals: #(4, 2)
    self assert: Bt4310UnsequencedClass selfBlockRoot equals: #(4, 2)
    self assert: Bt4310UnsequencedActor spawn cascadeRoot equals: #(3, 2)
    self assert: Bt4310UnsequencedClass cascadeRoot equals: #(3, 2)
    self assert: (Bt4310UnsequencedActor spawn castRoot: ClosureCellRecorder spawn) equals: #(3, 2)
    self assert: (Bt4310UnsequencedClass castRoot: ClosureCellRecorder spawn) equals: #(3, 2)

  // BT-4310: the same operands in a `collect:` or `do:` body.
  testStateFoldAtAnUnsequencedOperandInAFoldBody =>
    self assert: Bt4310UnsequencedActor spawn condInCollect equals: #(#(0, 1), 4)
    self assert: Bt4310UnsequencedClass condInCollect equals: #(#(0, 1), 4)
    self assert: Bt4310UnsequencedActor spawn andInCollect equals: #(#(false, true), 4)
    self assert: Bt4310UnsequencedActor spawn ifNilInCollect equals: #(#(4, 8), 4)
    self assert: Bt4310UnsequencedClass ifNilInCollect equals: #(#(4, 8), 4)
    self assert: Bt4310UnsequencedActor spawn keyInCollect equals: #(#(30, 70), 4)
    self assert: Bt4310UnsequencedClass keyInCollect equals: #(#(30, 70), 4)
    self assert: Bt4310UnsequencedActor spawn superInCollect equals: #(#(30, 70), 4)
    self assert: Bt4310UnsequencedActor spawn blockArgInCollect equals: #(#(4, 8), 4)
    self assert: Bt4310UnsequencedClass blockArgInCollect equals: #(#(4, 8), 4)
    self assert: Bt4310UnsequencedActor spawn selfBlockInCollect equals: #(#(4, 8), 4)
    self assert: Bt4310UnsequencedActor spawn cascadeInCollect equals: #(#(3, 7), 4)
    self assert: Bt4310UnsequencedClass cascadeInCollect equals: #(#(3, 7), 4)
    self assert: (Bt4310UnsequencedActor spawn castInDo: ClosureCellRecorder spawn) equals: #(7, 4)

  // BT-4310: in the other frame kinds, and in real closures (which run
  // against the actor-state cell and answered right before too).
  testStateFoldAtAnUnsequencedOperandInEveryFrameKind =>
    self assert: Bt4310UnsequencedActor spawn condInMatchArm equals: #(1, 2)
    self assert: Bt4310UnsequencedClass condInMatchArm equals: #(1, 2)
    self assert: Bt4310UnsequencedActor spawn condInMatchArmInDo equals: #(1, 2)
    self assert: Bt4310UnsequencedActor spawn andInArm equals: #(true, 2)
    self assert: Bt4310UnsequencedActor spawn keyInEvaluatedBlock equals: #(30, 2)
    self assert: Bt4310UnsequencedActor spawn ifNilInTimesRepeat equals: #(10, 4)
    self assert: Bt4310UnsequencedClass ifNilInTimesRepeat equals: #(10, 4)
    self assert: Bt4310UnsequencedActor spawn condInProtectedBody equals: #(1, 2)
    self assert: Bt4310UnsequencedActor spawn superInStoredClosure equals: #(30, 2)
    self assert: Bt4310UnsequencedActor spawn blockArgInLookupHandler equals: #(4, 2)

  // BT-4310: the fold in the method's last statement (the reply) and in a `^`
  // value; `n` read back by a later message.
  testStateFoldAtAnUnsequencedOperandInTheReply =>
    a := Bt4310UnsequencedActor spawn
    self assert: a condLast equals: 1
    self assert: a n equals: 2
    b := Bt4310UnsequencedActor spawn
    self assert: b condReturn equals: 1
    self assert: b n equals: 2
    c := Bt4310UnsequencedActor spawn
    self assert: c keyReturn equals: 30
    self assert: c n equals: 2
    d := Bt4310UnsequencedActor spawn
    self assert: d superLast equals: 30
    self assert: d n equals: 2
    e := Bt4310UnsequencedActor spawn
    self assert: e superReturn equals: 30
    self assert: e n equals: 2
    f := Bt4310UnsequencedActor spawn
    self assert: f blockArgLast equals: 4
    self assert: f n equals: 2
    g := Bt4310UnsequencedActor spawn
    self assert: g cascadeLast equals: 3
    self assert: g n equals: 2
    h := Bt4310UnsequencedActor spawn
    self assert: h cascadeReturn equals: 3
    self assert: h n equals: 2
