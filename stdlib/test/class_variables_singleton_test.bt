// BT-488, ADR 0019 Phase 1: Tests that the TranscriptStream singleton exposes
// a current accessor that returns nil before initialization. (`Workspace` and
// `Beamtalk` are class-side facades with no `current` — ADR 0129.)

TestCase subclass: ClassVariablesSingletonTest

  testSingletonCurrentAccessors =>
    // TranscriptStream has current accessor
    self assert: TranscriptStream current equals: nil
