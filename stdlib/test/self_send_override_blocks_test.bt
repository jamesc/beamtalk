TestCase subclass: SelfSendOverrideBlocksTest

  setUp =>
    SsoBlocksSub resetSubHits
    SsoStaleSub resetHits
    SsoScopeOpen resetN
    SsoScopeSealed resetN

  testCollect =>
    self assert: SsoBlocksSub viaCollect equals: #(10, 20)
    self assert: SsoBlocksSub subHits equals: 2

  testDo =>
    SsoBlocksSub viaDo
    self assert: SsoBlocksSub subHits equals: 3

  testEnsure =>
    self assert: (SsoBlocksSub viaEnsure: true) equals: 10
    self assert: SsoBlocksSub subHits equals: 1

  testOnDo =>
    self assert: (SsoBlocksSub viaOnDo: true) equals: 10
    self assert: SsoBlocksSub subHits equals: 1

  testTimes =>
    SsoBlocksSub viaTimesRepeat
    self assert: SsoBlocksSub subHits equals: 3

  testToDo =>
    SsoBlocksSub viaToDo
    self assert: SsoBlocksSub subHits equals: 3

  testWhile =>
    SsoBlocksSub viaWhile
    self assert: SsoBlocksSub subHits equals: 3

  testBlock =>
    self assert: SsoBlocksSub viaBlock equals: 50
    self assert: SsoBlocksSub subHits equals: 1

  testEnsureNested =>
    SsoBlocksSub ensureNested: true
    self assert: SsoBlocksSub subHits equals: 1

  testOnDoNested =>
    SsoBlocksSub onDoNested: true
    self assert: SsoBlocksSub subHits equals: 1

  testWhileNested =>
    SsoBlocksSub whileNested: true
    self assert: SsoBlocksSub subHits equals: 3

  testTimesNested =>
    SsoBlocksSub timesNested: true
    self assert: SsoBlocksSub subHits equals: 3

  testDoNested =>
    SsoBlocksSub doNested: true
    self assert: SsoBlocksSub subHits equals: 2

  testEnsureMatch =>
    SsoBlocksSub ensureMatch: 1
    self assert: SsoBlocksSub subHits equals: 1

  // A block passed to another class's method runs in that class's process,
  // away from its home: a write there raises class_state_unreachable (ADR 0130
  // §5, Migration Path) and leaves no stale state for the next external call.
  testForeignProcessBlockDoesNotLeak =>
    self should: [SsoBlocksSub viaForeign] raise: #class_state_unreachable
    self assert: SsoBlocksSub subHits equals: 0
    self should: [SsoBlocksSub viaForeign] raise: #class_state_unreachable
    self assert: SsoBlocksSub subHits equals: 0

  testOwnClassWrapperInBlock =>
    SsoBlocksSub viaOwnClassBlock
    self assert: SsoBlocksSub subHits equals: 2

  testSealedSelectorWrapperInBlock =>
    SsoBlocksSub viaSealedSelectorBlock
    self assert: SsoBlocksSub subHits equals: 2

  // --- BT-3675: per-scope tokens ------------------------------------------

  // A write made by a callee that raised and was caught must not be
  // resurrected by a later late-bound send or a later confined scope.
  testCaughtThenSend =>
    SsoBlocksSub caughtThenSend
    self assert: SsoBlocksSub subHits equals: 0

  testCaughtThenBlock =>
    SsoBlocksSub caughtThenBlock
    self assert: SsoBlocksSub subHits equals: 0

  testCaughtThenSealedHelperInBlock =>
    SsoStaleSub caughtThenSealedHelper
    self assert: SsoStaleSub hits equals: 0

  // The method's own on:do: try body writes (via a self-send) then raises.
  testOwnTryBodyRaiseThenSend =>
    self assert: SsoStaleSub ownTryRaise equals: 0
    self assert: SsoStaleSub hits equals: 0

  // A completed writer followed by a raise in the same scope: all discarded.
  testCompletedThenRaiseInSameScope =>
    SsoStaleSub completedThenRaise
    self assert: SsoStaleSub hits equals: 0

  // ... including when the raise is caught by a runtime `Result tryDo:`.
  testCompletedThenRaiseCaughtByRuntime =>
    SsoStaleSub completedThenRaiseRuntime
    self assert: SsoStaleSub hits equals: 0

  testRuntimeCatcherKeepsCompletedWrites =>
    SsoStaleSub runtimeKept
    self assert: SsoStaleSub hits equals: 1

  // Only each iteration's second `foo` counts.
  testClosureCaughtRaiseThenSend =>
    SsoStaleSub closureCaughtThenSend
    self assert: SsoStaleSub hits equals: 2

  testClosureCompletedTryThenSend =>
    SsoStaleSub closureCompletedTry
    self assert: SsoStaleSub hits equals: 4

  testNestedClosuresKeepWrites =>
    SsoStaleSub nestedClosures
    self assert: SsoStaleSub hits equals: 4

  testHandlerArmSendKept =>
    SsoStaleSub handlerSend
    self assert: SsoStaleSub hits equals: 1

  testOuterHandlerDiscardsRaisedTryBody =>
    SsoStaleSub outerCaught
    self assert: SsoStaleSub hits equals: 0

  // Control: a normally finishing scope keeps every write.
  testCompletedWritesKept =>
    SsoStaleSub completedKept
    self assert: SsoStaleSub hits equals: 2

  // A statically bound wrapper in a loop that READS before its own late-bound
  // send sees the previous iteration's write.
  testWrapperReadSeesPreviousIteration =>
    self assert: SsoStaleSub viaReadLoop equals: #(0, 1, 2)
    self assert: SsoStaleSub hits equals: 3

  // Sealed and open classes agree: a class's own mutating self-send nested in
  // a conditional arm keeps its write.
  testOpenConditionalArmKeepsWrite =>
    self assert: (SsoScopeOpen condArm: 5) equals: 5
    self assert: SsoScopeOpen n equals: 1

  testSealedConditionalArmKeepsWrite =>
    self assert: (SsoScopeSealed condArm: 5) equals: 5
    self assert: SsoScopeSealed n equals: 1

  testOpenConditionalArmNotTakenNoWrite =>
    self assert: (SsoScopeOpen condArm: 0) equals: 0
    self assert: SsoScopeOpen n equals: 0

  testSealedConditionalArmNotTakenNoWrite =>
    self assert: (SsoScopeSealed condArm: 0) equals: 0
    self assert: SsoScopeSealed n equals: 0

  // Threaded loop bodies (also mutating a captured local).
  testOpenThreadedTimesRepeat =>
    self assert: (SsoScopeOpen threadedTimes: 3) equals: 3
    self assert: SsoScopeOpen n equals: 3

  testSealedThreadedTimesRepeat =>
    self assert: (SsoScopeSealed threadedTimes: 3) equals: 3
    self assert: SsoScopeSealed n equals: 3

  testOpenThreadedToDo =>
    self assert: (SsoScopeOpen threadedToDo: 3) equals: 6
    self assert: SsoScopeOpen n equals: 3

  testSealedThreadedToDo =>
    self assert: (SsoScopeSealed threadedToDo: 3) equals: 6
    self assert: SsoScopeSealed n equals: 3

  // --- BT-3675 review: direct writes between sends in a scope ---------------
  // BT-3683: a skipped or non-writing arm in a later iteration keeps the
  // earlier iterations' class-variable writes (open and sealed class).
  testOpenArmsInListDo => self assert: SsoScopeOpen armsInListDo equals: 1

  testSealedArmsInListDo => self assert: SsoScopeSealed armsInListDo equals: 1

  testOpenArmsInListDoThree =>
    self assert: SsoScopeOpen armsInListDoThree equals: 2

  testSealedArmsInListDoThree =>
    self assert: SsoScopeSealed armsInListDoThree equals: 2

  testOpenArmsInToDo => self assert: SsoScopeOpen armsInToDo equals: 1

  testSealedArmsInToDo => self assert: SsoScopeSealed armsInToDo equals: 1

  testOpenArmsInTimesRepeat =>
    self assert: SsoScopeOpen armsInTimesRepeat equals: 1

  testSealedArmsInTimesRepeat =>
    self assert: SsoScopeSealed armsInTimesRepeat equals: 1

  testOpenArmsIfTrueIfFalseInListDo =>
    self assert: SsoScopeOpen armsIfTrueIfFalseInListDo equals: 1

  testSealedArmsIfTrueIfFalseInListDo =>
    self assert: SsoScopeSealed armsIfTrueIfFalseInListDo equals: 1

  testOpenArmsNestedConditionalInListDo =>
    self assert: SsoScopeOpen armsNestedConditionalInListDo equals: 1

  testSealedArmsNestedConditionalInListDo =>
    self assert: SsoScopeSealed armsNestedConditionalInListDo equals: 1

  testOpenArmsInOnDoBody => self assert: SsoScopeOpen armsInOnDoBody equals: 1

  testSealedArmsInOnDoBody =>
    self assert: SsoScopeSealed armsInOnDoBody equals: 1

  testOpenArmsInOnDoHandler =>
    self assert: SsoScopeOpen armsInOnDoHandler equals: 1

  testSealedArmsInOnDoHandler =>
    self assert: SsoScopeSealed armsInOnDoHandler equals: 1

  testOpenArmsDirectWriteBetween =>
    self assert: SsoScopeOpen armsDirectWriteBetween equals: 100

  testSealedArmsDirectWriteBetween =>
    self assert: SsoScopeSealed armsDirectWriteBetween equals: 100

  testOpenArmsRaisedIterationDiscarded =>
    self assert: SsoScopeOpen armsRaisedIterationDiscarded equals: 0

  testSealedArmsRaisedIterationDiscarded =>
    self assert: SsoScopeSealed armsRaisedIterationDiscarded equals: 0

  testOpenArmsAfterSendInListDo =>
    self assert: SsoScopeOpen armsAfterSendInListDo equals: 3

  testSealedArmsAfterSendInListDo =>
    self assert: SsoScopeSealed armsAfterSendInListDo equals: 3

  testOpenArmsAfterAssignedSendInListDo =>
    self assert: SsoScopeOpen armsAfterAssignedSendInListDo equals: 3

  testSealedArmsAfterAssignedSendInListDo =>
    self assert: SsoScopeSealed armsAfterAssignedSendInListDo equals: 3

  testOpenArmsAfterDirectWriteInListDo =>
    self assert: SsoScopeOpen armsAfterDirectWriteInListDo equals: 15

  testSealedArmsAfterDirectWriteInListDo =>
    self assert: SsoScopeSealed armsAfterDirectWriteInListDo equals: 15

  testOpenMixedDirectWriteLoop => self assert: SsoScopeOpen mixedLoop equals: 6

  testSealedMixedDirectWriteLoop =>
    self assert: SsoScopeSealed mixedLoop equals: 6

  testOpenMixedDirectWriteArm =>
    self assert: (SsoScopeOpen mixedArm: 1) equals: 12

  testSealedMixedDirectWriteArm =>
    self assert: (SsoScopeSealed mixedArm: 1) equals: 12

  // ADR 0130 §1/§5 (BT-3713): a closure stored in a local and invoked by a
  // LATER statement writes the one live class variable, so every write is kept.
  // (ADR 0110's BT-3675/BT-3681 limit, which dropped these writes, is gone.)
  testStoredClosureInvokedLaterKeepsWrite =>
    SsoStaleSub deferred
    self assert: SsoStaleSub hits equals: 1

  // BT-3688: a stored closure handed to a collection HOM by name keeps its write.
  testStoredClosurePassedToCollectionHomKeepsWrite =>
    SsoStaleSub deferredViaDo
    self assert: SsoStaleSub hits equals: 1

  testStoredClosureInvokedLaterInArmKeepsWrite =>
    SsoStaleSub deferredInArm
    self assert: SsoStaleSub hits equals: 1

  testStoredClosureInvokedTwiceKeepsWrites =>
    SsoStaleSub deferredTwice
    self assert: SsoStaleSub hits equals: 2

  // The closure's write and the writing send are both kept.
  testStoredClosureThenWritingSendKeepsBoth =>
    SsoStaleSub deferredThenSend
    self assert: SsoStaleSub hits equals: 2

  testStoredClosureWithStatementsCompilesAndRuns =>
    SsoStaleSub deferredWithStatements
    self assert: SsoStaleSub hits equals: 1

  // BT-3682 (ADR 0130 §5): a block literal passed to a user-defined class-side
  // higher-order method of the same class runs at home, so its write is kept,
  // with and without the callee's own write.
  testBlockPassedToClassSideHomKeepsBlockWrite =>
    SsoStaleSub viaSection
    self assert: SsoStaleSub hits equals: 1

  testBlockPassedToClassSideHomThenSendKeepsBlockWrite =>
    SsoStaleSub viaSectionThenSend
    self assert: SsoStaleSub hits equals: 1

  testClassSideHomKeepsItsOwnWriteWithNonWritingBlock =>
    SsoStaleSub viaTimedNoWrite
    self assert: SsoStaleSub hits equals: 1

  // `viaTimedWriting` passes `[self foo]` to the same class's class-side HOM
  // `timed:`, so the block runs at home (ADR 0130 §5): the HOM's own write (1)
  // and the block's `foo` write (2) are both kept. (Settled against the ADR in
  // BT-3713; the earlier expectation of 1 was the dropped block write.)
  testClassSideHomKeepsItsOwnWriteWithWritingBlock =>
    SsoStaleSub viaTimedWriting
    self assert: SsoStaleSub hits equals: 2

  // A closure calling the class's own mutating selector keeps its write too.
  testStoredClosureOwnMutatingSelectorKeepsWrite =>
    SsoStaleSub storedBump
    self assert: SsoStaleSub hits equals: 1

  // A stored closure reads and writes the live variable: the caught raise
  // discards the write made inside its protected region (ADR 0130 §4), so the
  // later call bumps from 0 to 1; and a bump in between is seen (1, 2, then 3).
  testStoredClosureReadsLiveValueAfterCaughtRaise =>
    self assert: SsoStaleSub staleAfterRaise equals: 1

  testStoredClosureReadsLiveValueAfterBump =>
    self assert: SsoStaleSub staleAfterBump equals: 3

  // BT-3682: the same HOM shape inside a loop body keeps the block's write.
  testBlockPassedToClassSideHomInLoopBodyKeepsWrite =>
    SsoStaleSub viaSectionInLoop
    self assert: SsoStaleSub hits equals: 1
