// BT-1222: Tests for DynamicSupervisor configuration defaults and subclass
// override. Since ADR 0135 §2 the configuration is instance-side, so it is read
// from a running pool.
//
// Fixtures: stdlib/test/fixtures/test_dynamic_supervisor_custom.bt,
//           stdlib/test/fixtures/bt3965default_pool.bt

TestCase subclass: DynamicSupervisorDefaultsTest

  // BT-3379: TestDynamicSupervisorCustom supervise/stop registers a single
  // node-wide, name-registered process (see beamtalk_supervisor:startLink/1).
  // Run serially so a concurrently-running test class cannot `stop` the
  // shared supervisor out from under this one.
  class serial -> Boolean => true

  // === DynamicSupervisor instance-side defaults ===
  testDynamicSupervisorDefaults =>
    pool := Bt3965DefaultPool supervise unwrap
    self assert: pool maxRestarts equals: 10
    self assert: pool restartWindow equals: 60
    self assert: pool maxChildren equals: #infinity
    self assert: pool childShutdown equals: nil
    self assert: pool childClass equals: Bt3965CappedStopper
    [pool stop] on: Error do: [:e | nil]

  testDynamicSupervisorIsSupervisorTrue =>
    self assert: DynamicSupervisor isSupervisor equals: true

  // === DynamicSupervisor subclass can override defaults ===
  testDynamicSupervisorSubclassOverridesDefaults =>
    pool := TestDynamicSupervisorCustom supervise unwrap
    self assert: pool maxRestarts equals: 5
    self assert: pool restartWindow equals: 120
    [pool stop] on: Error do: [:e | nil]

  testDynamicSupervisorSubclassIsSupervisorTrue =>
    self assert: TestDynamicSupervisorCustom isSupervisor equals: true

  // === Type parameter C narrows startChild return type ===
  testStartChildReturnsTypedChild =>
    pool := (TestDynamicSupervisorCustom supervise) unwrap
    child := pool startChild unwrap
    // If C=Counter resolves, child is typed as Counter and getValue compiles.
    // Without the type parameter this would fail: "Object does not understand 'getValue'"
    self assert: child getValue equals: 0
    [pool stop] on: Error do: [:e | nil]

  // === BT-1999: terminateChild: is idempotent on already-gone children ===
  //
  // ADR 0080 Phase 2 contracts `terminateChild:` to return `Result ok: nil`
  // both for a live child and for one that has already been terminated —
  // callers should not have to distinguish "I succeeded" from "already done".
  testTerminateChildIsIdempotent =>
    pool := (TestDynamicSupervisorCustom supervise) unwrap
    child := pool startChild unwrap
    first := pool terminateChild: child
    self assert: first isOk equals: true
    self assert: first unwrap equals: nil
    second := pool terminateChild: child
    self assert: second isOk equals: true
    self assert: second unwrap equals: nil
    [pool stop] on: Error do: [:e | nil]
