// BT-3566: WorkspaceInterface gained a resetCurrent class method mirroring
// TranscriptStream's, for symmetry after BT-3559 converted its `current`
// classState singleton to a `late` slot with no default. Verifies
// resetCurrent is safe to call and leaves the singleton unassigned
// (current == nil), the same shape as TranscriptStream's own resetCurrent
// test (show_cr_test.bt). (`Beamtalk` no longer has a singleton — ADR 0129.)

TestCase subclass: SingletonResetCurrentTest

  testWorkspaceInterfaceResetCurrentClearsSingleton =>
    WorkspaceInterface resetCurrent
    self assert: WorkspaceInterface current equals: nil
