// One conformance matrix for method lookup order (ADR 0152 §2).
//
// The lookup order is implemented in several places that can drift apart (the
// generated actor / value-type / class-side dispatch arms, the memoised
// `inherited_target/2` verdict, the class-chain walk, `super` sends,
// `perform:`, `respondsTo:`). This file states the order ONCE
// (`resolve:from:` below) and drives every shape through every runtime path,
// comparing each answer to it. Nothing here is hand-written per cell: the
// cells are the cross product of
//
//   kind        value | actor
//   side        instance | class side
//   receiver    depth 0, 1, 2, 3 of a four-class chain (fixtures/bt5060*_c0..c3.bt)
//   selector    compiled on {0}, {0,2}, {1}, {2}, {0,3}, {0,1,2,3}, {1,3} or nowhere
//   phase       cold, then warm (the memoised verdicts are populated)
//   path        a literal send, `perform:`, `respondsTo:`, and a `super` send
//               made from the receiver's own class
//
// The order: walk from the receiver's class up; the first class that compiles
// the selector answers; none is does-not-understand. Nothing outside a class's
// own source (no other file, no package) can change which method answers
// (ADR 0152); a live `Foo >> sel` at the prompt recompiles the class itself.
// Hot reload, a live `>>` definition, class removal and the other
// live-workspace shapes are in tests/repl-protocol/cases/lookup_order_live.btscript.
//
// Serial: the mismatch table is a named Ets table.

TestCase subclass: LookupOrderMatrixTest
  field: found = nil

  class serial -> Boolean => true

  setUp => self.found := Ets new: #bt5060Found type: #set

  tearDown => self.found delete

  // === the one statement of the order ===

  /// The classes (0 = root) that compile `sel`.
  compiledOn: sel =>
    table := #{
      #s0 => #(0),
      #s02 => #(0, 2),
      #s1 => #(1),
      #s2 => #(2),
      #s03 => #(0, 3),
      #sAll => #(0, 1, 2, 3),
      #s13 => #(1, 3),
      #sNone => #()
    }
    table at: sel

  /// What a send of `sel` answers: the symbol of the class that answers it
  /// (`#c<k>`), or `#dnu`. `k` is the class being examined: the receiver's
  /// class first, then each ancestor in turn.
  resolve: sel from: k =>
    k < 0 ifTrue: [^#dnu]
    ((self compiledOn: sel) includes: k) ifTrue: [
      ^#(#c0, #c1, #c2, #c3) at: k + 1
    ]
    self resolve: sel from: k - 1

  // === the runtime paths ===
  sends =>
    #{
      #s0 => [:o | o s0],
      #s02 => [:o | o s02],
      #s1 => [:o | o s1],
      #s2 => [:o | o s2],
      #s03 => [:o | o s03],
      #sAll => [:o | o sAll],
      #s13 => [:o | o s13],
      #sNone => [:o | o sNone]
    }

  superNames => #{#s0 => #superS0, #sAll => #superSAll, #s02 => #superS02}

  try: block => [block value] on: Error do: [:e | #dnu]

  /// Every path's answer for `sel` sent to `o`.
  observe: o sel: sel receiver: r =>
    send := self sends at: sel
    sup := self superNames at: sel ifAbsent: [nil]
    paths := #{
      #send => (self try: [send value: o]),
      #perform => (self try: [o perform: sel]),
      #responds => (o respondsTo: sel)
    }
    (r > 0 and: [
      sup isNil not
    ]) ifTrue: [
      paths at: #super put: (self try: [o perform: sup])
    ] ifFalse: [paths]

  /// Compare one observation against the reference.
  check: cell observed: observed sel: sel receiver: r =>
    observed
      keysAndValuesDo: [:path :actual |
        expected := self
          expectedFor: path
          sel: sel
          receiver: r
        actual =:= expected
          ifFalse: [
            self.found at: "{cell} path={path}: expected {expected printString}, got {actual printString}" put: true
          ]
      ]

  expectedFor: path sel: sel receiver: r =>
    path =:= #super
      ifTrue: [self resolve: sel from: r - 1]
      ifFalse: [
        answer := self resolve: sel from: r
        path =:= #responds ifTrue: [(answer =:= #dnu) not] ifFalse: [answer]
      ]

  /// One receiver, every selector, cold then warm.
  cells: kind side: side receiver: r object: o =>
    #(#s0, #s02, #s1, #s2, #s03, #sAll, #s13, #sNone)
      do: [:sel |
        base := "{kind}/{side} r={r} sel={sel}"
        self
          check: "{base} phase=cold"
          observed: (self
            observe: o
            sel: sel
            receiver: r)
          sel: sel
          receiver: r
        self
          check: "{base} phase=warm"
          observed: (self
            observe: o
            sel: sel
            receiver: r)
          sel: sel
          receiver: r
      ]

  /// Fail with every mismatch the cells recorded.
  verify =>
    lines := self.found keys
    lines isEmpty ifFalse: [self fail: (lines join: "\n")]

  // === the matrix ===
  testValueInstanceSide =>
    #(0, 1, 2, 3)
      do: [:r |
        o := #(Bt5060ValueC0, Bt5060ValueC1, Bt5060ValueC2, Bt5060ValueC3) at: r + 1
        self
          cells: #value
          side: #instance
          receiver: r
          object: o new
      ]
    self verify

  testValueClassSide =>
    #(0, 1, 2, 3)
      do: [:r |
        o := #(Bt5060ValueC0, Bt5060ValueC1, Bt5060ValueC2, Bt5060ValueC3) at: r + 1
        self
          cells: #value
          side: #class
          receiver: r
          object: o
      ]
    self verify

  testActorInstanceSide =>
    #(0, 1, 2, 3)
      do: [:r |
        cls := #(Bt5060ActorC0, Bt5060ActorC1, Bt5060ActorC2, Bt5060ActorC3) at: r + 1
        a := cls spawn
        [
          self
            cells: #actor
            side: #instance
            receiver: r
            object: a
        ] ensure: [a stop]
      ]
    self verify

  testActorClassSide =>
    #(0, 1, 2, 3)
      do: [:r |
        o := #(Bt5060ActorC0, Bt5060ActorC1, Bt5060ActorC2, Bt5060ActorC3) at: r + 1
        self
          cells: #actor
          side: #class
          receiver: r
          object: o
      ]
    self verify
