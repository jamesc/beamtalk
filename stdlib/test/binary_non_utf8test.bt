// Non-UTF-8 Binary handling (BT-2999).
//
// String and Binary share one BEAM representation, so a bare binary carries
// no runtime tag saying which it is. Valid UTF-8 stays ambiguous and answers
// String; bytes that are *not* valid UTF-8 cannot be a String, so they answer
// Binary and dispatch to Binary's byte-level methods.
//
// Before BT-2999, `.size`/`.class` on such a binary went through String's
// grapheme-aware path, and the resulting error message embedded the raw bytes.
// That invalid-UTF-8 message then reached `json:encode/1` in the BUnit runner
// and crashed the whole test VM — so this file passing at all is the
// regression test for the crash.

TestCase subclass: BinaryNonUtf8Test

  // ═══════════════════════════════════════════════════════════════════
  // Helpers
  // ═══════════════════════════════════════════════════════════════════

  /// Bytes that are definitely not valid UTF-8 (FF/FE are never legal).
  invalidUtf8 -> Binary => Binary fromBytes: #(255, 254, 253, 0, 200)

  // ═══════════════════════════════════════════════════════════════════
  // class — non-UTF-8 bytes answer Binary, valid UTF-8 stays String
  // ═══════════════════════════════════════════════════════════════════
  testNonUtf8BinaryAnswersBinary =>
    self assert: self invalidUtf8 class name equals: #Binary

  testRandomBytesAnswerBinary =>
    // The original repro: cryptographically random bytes are almost never
    // valid UTF-8.
    bytes := (Erlang crypto) strong_rand_bytes: 16
    self assert: bytes class name equals: #Binary

  testValidUtf8BinaryStillAnswersString =>
    // A binary that *is* valid UTF-8 remains indistinguishable from a String.
    self assert: (Binary fromBytes: #(104, 101, 108, 108, 111)) class name equals: #String

  testStringStillAnswersString =>
    self assert: "hello" class name equals: #String
    self assert: "café" class name equals: #String

  // ═══════════════════════════════════════════════════════════════════
  // size — byte count, not a grapheme walk over invalid bytes
  // ═══════════════════════════════════════════════════════════════════
  testNonUtf8BinarySize => self assert: self invalidUtf8 size equals: 5

  testRandomBytesSize =>
    bytes := (Erlang crypto) strong_rand_bytes: 16
    self assert: bytes size equals: 16

  testNonUtf8BinaryByteSize => self assert: self invalidUtf8 byteSize equals: 5

  testStringSizeStillGraphemeCount =>
    // No regression: valid UTF-8 keeps grapheme semantics.
    self assert: "café" size equals: 4
    self assert: "café" byteSize equals: 5

  // ═══════════════════════════════════════════════════════════════════
  // printString / displayString — always valid UTF-8 output
  // ═══════════════════════════════════════════════════════════════════
  testNonUtf8BinaryPrintStringIsHex =>
    self assert: self invalidUtf8 printString equals: "<<FF FE FD 00 C8>>"

  testNonUtf8BinaryPrintStringIsValidUtf8 =>
    // The whole point: the rendering can be re-read as text, so it can be
    // embedded in JSON, logs, and test failure messages.
    self assert: self invalidUtf8 printString class name equals: #String

  testStringPrintStringUnchanged =>
    self assert: "hello" printString equals: """hello"""

  // ═══════════════════════════════════════════════════════════════════
  // Byte-level operations keep working
  // ═══════════════════════════════════════════════════════════════════
  testNonUtf8BinaryToBytes =>
    self assert: self invalidUtf8 toBytes equals: #(255, 254, 253, 0, 200)

  testNonUtf8BinaryAsHex =>
    self assert: self invalidUtf8 asHex equals: "fffefd00c8"

  testNonUtf8BinaryIsEmpty =>
    self assert: self invalidUtf8 isEmpty equals: false
