// BT-663: Tests for binary pattern matching in match: expressions.
// Covers integer segments, binary segments, and guards.

TestCase subclass: BinaryPatternsTest

  testMatchFirstByteOfString =>
    // Strings are UTF-8 binaries; "A" is byte 65
    result := "ABC" match: [
      <<first:8, _/binary>> -> first;
      _ -> 0
    ]
    self assert: result equals: 65

  testMatchRestBinary =>
    // Extract the tail of a binary after the first byte
    result := "ABC" match: [
      <<_:8, rest/binary>> -> rest size;
      _ -> 0
    ]
    self assert: result equals: 2

  testMatchWildcardBinary =>
    // Wildcard binary segment matches any binary
    result := "hello" match: [
      <<_/binary>> -> true;
      _ -> false
    ]
    self assert: result

  testMatchIntegerSegmentFallthrough =>
    // When no arm matches, fall through to wildcard
    result := "X" match: [
      <<first:8, _/binary>> when: [first > 200] -> "high";
      _ -> "low"
    ]
    self assert: result equals: "low"

  testMatchLengthPrefixedPayload =>
    // BT-4096: a segment size may name a variable bound by an earlier segment
    bin := Binary fromBytes: #(3, 104, 105, 33, 99)
    result := bin match: [
      <<n:8, payload:n/binary, rest/binary>> -> {n, payload toBytes, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 3
    self assert: (result at: 2) equals: #(104, 105, 33)
    self assert: (result at: 3) equals: #(99)

  testMatchLengthPrefixedIncompleteFallsThrough =>
    // BT-4096: fewer bytes buffered than the bound size claims — no match
    bin := Binary fromBytes: #(10, 1, 2)
    result := bin match: [
      <<n:8, payload:n/binary, rest/binary>> -> payload;
      _ -> nil
    ]
    self assert: result isNil

  testMatchBitsSegment =>
    // BT-4097: bits/bitstring segments (234 = 0b11101010)
    bin := Binary fromBytes: #(234, 7)
    result := bin match: [
      <<flags:3, v:5, rest/bitstring>> -> {flags, v, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 7
    self assert: (result at: 2) equals: 10
    // The tail is 8 bits, byte-aligned, so it is a Binary (ADR 0141).
    self assert: (result at: 3) equals: #(7)

  testMatchUnalignedBitstringTail =>
    // BT-4139: an unaligned tail is a Bitstring — read it with
    // bitSize/toBits; the byte protocol is not understood (ADR 0141).
    bin := Binary fromBytes: #(234)
    rest := bin match: [
      <<_:3, r/bitstring>> -> r;
      _ -> nil
    ]
    self assert: rest class equals: Bitstring
    self assert: rest bitSize equals: 5
    self assert: rest toBits equals: #(0, 1, 0, 1, 0)
    self should: [rest perform: #toBytes] raise: #does_not_understand
    self should: [rest perform: #size] raise: #does_not_understand

  testMatchBitstringTailChained =>
    // BT-4097: an unaligned rest/bits tail matches again as a bitstring
    bin := Binary fromBytes: #(234)
    result := bin match: [
      <<_:3, rest/bitstring>> -> (rest match: [
        <<v:5>> -> v;
        _ -> -1
      ]);
      _ -> -1
    ]
    self assert: result equals: 10

  testMatchLiteralSegmentValue =>
    // BT-4097: integer literal segment values (10 = 0b00001010)
    bin := Binary fromBytes: #(10, 9)
    result := bin match: [
      <<0:1, v:7, rest/binary>> -> {v, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 10
    self assert: (result at: 2) equals: #(9)

  testMatchLiteralSegmentValueFallsThrough =>
    // BT-4097: first bit is 1 (138 = 0b10001010), so <<0:1, ...>> rejects it
    bin := Binary fromBytes: #(138, 9)
    result := bin match: [
      <<0:1, v:7, rest/binary>> -> v;
      _ -> nil
    ]
    self assert: result isNil

  testMatchSizeExpression =>
    // BT-4097: parenthesized size expressions (234 = 0b11_101010)
    q := 2
    bin := Binary fromBytes: #(234, 7)
    result := bin match: [
      <<a:(4 - q), b:(4 + q), rest/binary>> -> {a, b, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 3
    self assert: (result at: 2) equals: 42
    self assert: (result at: 3) equals: #(7)

  testMatchSkippedFlagBits =>
    // BT-4097: sizes from locals (skip is used only as a size — no
    // unused-variable warning under --warnings-as-errors)
    p := 5
    skip := 8 - p
    bin := Binary fromBytes: #(234)
    result := bin match: [
      <<_f:skip, v:p, rest/binary>> -> v;
      _ -> -1
    ]
    self assert: result equals: 10

  testSizeOnlyParameterIsUsed =>
    // BT-4097: n is used only as a segment size — no unused-parameter warning
    self assert: (self take: 2 from: (Binary fromBytes: #(7, 8, 9))) toBytes equals: #(7, 8)

  take: n :: Integer from: bin :: Binary -> Binary =>
    bin match: [
      <<payload:n/binary, _/binary>> -> payload;
      _ -> Binary fromBytes: #()
    ]

  testMatchMultipleWildcardsInBinary =>
    // BT-4098: every _ in one pattern is a fresh anonymous variable
    result := (Binary fromBytes: #(1)) match: [
      <<_:1, _:7>> -> true;
      _ -> false
    ]
    self assert: result

  testMatchRaisingSizeExpressionFallsThrough =>
    // Review finding 1: a raising size fails the arm, never crashes the
    // match — including against a non-binary scrutinee. A computed
    // negative size simply never matches.
    q := 0
    bin := Binary fromBytes: #(1, 2, 3)
    self
      assert: (bin match: [
        <<a:(4 / q), rest/binary>> -> a;
        _ -> #fallback
      ])
      equals: #fallback
    self
      assert: (42 match: [
        <<a:(4 / q), rest/binary>> -> a;
        _ -> #fallback
      ])
      equals: #fallback
    self
      assert: (bin match: [
        <<a:(1 - 5), rest/binary>> -> a;
        _ -> #fallback
      ])
      equals: #fallback

  testMatchNegativeLiteralValue =>
    // Review finding 8: `<<-1:8/signed>>` matches 255, both spellings.
    bin := Binary fromBytes: #(255, 9)
    self
      assert: (bin match: [
        <<-1:8/signed, rest/binary>> -> rest toBytes;
        _ -> #()
      ])
      equals: #(9)
    self
      assert: (bin match: [
        <<-1:8/signed, rest/binary>> -> rest toBytes;
        _ -> #()
      ])
      equals: #(9)

  testMatchSplitWithHoistedExpression =>
    // Review finding 8: size expression over a pattern-bound variable —
    // split at `a`, hoist `(n + 2)` between the matches. 234 is 0b11101010.
    bin := Binary fromBytes: #(3, 234, 7)
    result := bin match: [
      <<n:8, a:(n + 2), rest/bitstring>> -> {n, a, rest};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 3
    self assert: (result at: 2) equals: 29
    // BT-4139: the 11-bit tail is a Bitstring (ADR 0141).
    self assert: (result at: 3) class equals: Bitstring
    self assert: (result at: 3) bitSize equals: 11
    self assert: (result at: 3) toBits equals: #(0, 1, 0, 0, 0, 0, 0, 0, 1, 1, 1)
    tail := (result at: 3) match: [
      <<b:3, c:8>> -> {b, c};
      _ -> nil
    ]
    self assert: (tail at: 1) equals: 2
    self assert: (tail at: 2) equals: 7

  testMatchGuardedSegmentedArmFallsThrough =>
    // Review finding 8: the guard applies innermost; rejection falls
    // through to the next (also segmented) arm.
    bin := Binary fromBytes: #(3, 1, 2, 3)
    self
      assert: (bin match: [
        <<n:8, p:n/binary>> when: [n > 100] -> #big;
        <<n:8, p:n/binary>> -> #small;
        _ -> #none
      ])
      equals: #small

  testMatchThreeChunks =>
    // Review finding 8: two split points in one arm.
    bin := Binary fromBytes: #(8, 2, 9, 9, 9)
    result := bin match: [
      <<n:8, m:n/integer, p:m/binary, rest/binary>> -> {n, m, p toBytes, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 8
    self assert: (result at: 2) equals: 2
    self assert: (result at: 3) equals: #(9, 9)
    self assert: (result at: 4) equals: #(9)

  testMatchNativeBeforeSegmentedArm =>
    // Review finding 8: a native binary arm ahead of a segmented one.
    bin := Binary fromBytes: #(3, 1, 2, 3)
    self
      assert: (bin match: [
        <<1:8, _/binary>> -> #one;
        <<n:8, p:n/binary>> -> #prefixed;
        _ -> #none
      ])
      equals: #prefixed

  testMatchNestedTrivialParenthesizedSize =>
    // Review finding 6: `<<a:(8)>>` inlines — no hoist, so nesting is fine.
    bin := Binary fromBytes: #(10, 9)
    pair := {#ok, bin}
    self
      assert: (pair match: [
        {#ok, <<a:(8), rest/binary>>} -> a;
        _ -> -1
      ])
      equals: 10

  // BT-4223: a binary pattern nested inside a composite pattern unwraps a
  // `String` element to its bytes, like a top-level binary arm does.
  testMatchNestedBinaryInTupleMatchesString =>
    result := {#ok, "GET /x"} match: [
      {#ok, <<71, 69, 84, 32, rest/binary>>} -> rest toBytes;
      _ -> nil
    ]
    self assert: result equals: #(47, 120)

  testMatchNestedBinaryInTupleMatchesBareBinary =>
    pair := {#ok, Binary fromBytes: #(71, 69, 84, 32, 47)}
    result := pair match: [
      {#ok, <<71, 69, 84, 32, rest/binary>>} -> rest toBytes;
      _ -> nil
    ]
    self assert: result equals: #(47)

  testMatchNestedBinaryNoMatchFallsThrough =>
    result := {#ok, "PUT /x"} match: [
      {#ok, <<71, 69, 84, 32, rest/binary>>} -> rest toBytes;
      {#ok, <<80, 85, 84, 32, _/binary>>} -> #put;
      _ -> nil
    ]
    self assert: result equals: #put

  testMatchNestedBinaryNonBinaryFallsThrough =>
    result := {#ok, 42} match: [
      {#ok, <<_:8, _/binary>>} -> #binary;
      {#ok, n} -> n
    ]
    self assert: result equals: 42

  testMatchNestedBinaryGuardSeesSegments =>
    // The guard runs after every nested binary has matched.
    result := {"A", "B"} match: [
      {<<a:8>>, <<b:8>>} when: [a > b] -> #descending;
      {<<a:8>>, <<b:8>>} -> {a, b};
      _ -> nil
    ]
    self assert: result equals: {65, 66}

  testMatchNestedBinarySizeNamesOuterVariable =>
    // A nested binary matches after the enclosing tuple, so its segment
    // size may name a variable the tuple bound.
    pair := {2, "hello"}
    result := pair match: [
      {n, <<head:n/binary, _/binary>>} -> head toBytes;
      _ -> nil
    ]
    self assert: result equals: #(104, 101)

  // BT-4143: utf16 segments decode 2-byte big-endian code units.
  testMatchUtf16Segment =>
    bin := Binary fromBytes: #(0, 65)
    result := bin match: [
      <<c/utf16, rest/binary>> -> {c, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 65
    self assert: (result at: 2) equals: #()

  // BT-4143: an odd byte count cannot match a utf16 segment.
  testMatchUtf16Fallthrough =>
    bin := Binary fromBytes: #(65)
    result := bin match: [
      <<c/utf16>> -> c;
      _ -> #fallback
    ]
    self assert: result equals: #fallback

  // BT-4143: utf32 segments decode 4-byte big-endian code units.
  testMatchUtf32Segment =>
    bin := Binary fromBytes: #(0, 0, 0, 65)
    result := bin match: [
      <<c/utf32, rest/binary>> -> {c, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 65
    self assert: (result at: 2) equals: #()

  // BT-4143: size 2, unit 8 reads 16 bits big-endian (18 * 256 + 52).
  testMatchUnitSegment =>
    bin := Binary fromBytes: #(18, 52, 7)
    result := bin match: [
      <<v:2/unit:8, rest/binary>> -> {v, rest toBytes};
      _ -> nil
    ]
    self assert: (result at: 1) equals: 4660
    self assert: (result at: 2) equals: #(7)

  // BT-4143: 1.5 as big-endian float64 is #(63, 248, 0, 0, 0, 0, 0, 0).
  testMatchFloatLiteralValue =>
    bin := Binary fromBytes: #(63, 248, 0, 0, 0, 0, 0, 0)
    result := bin match: [
      <<1.5/float, rest/binary>> -> rest size;
      _ -> -1
    ]
    self assert: result equals: 0

  // BT-4143: 2.5 (#(64, 4, ...)) does not match <<1.5/float>>.
  testMatchFloatLiteralValueFallsThrough =>
    bin := Binary fromBytes: #(64, 4, 0, 0, 0, 0, 0, 0)
    result := bin match: [
      <<1.5/float, rest/binary>> -> #matched;
      _ -> #fallback
    ]
    self assert: result equals: #fallback

  // BT-4143: -1.5 as big-endian float64 is #(191, 248, 0, 0, 0, 0, 0, 0).
  testMatchNegativeFloatLiteralValue =>
    bin := Binary fromBytes: #(191, 248, 0, 0, 0, 0, 0, 0)
    result := bin match: [
      <<-1.5/float, rest/binary>> -> rest size;
      _ -> -1
    ]
    self assert: result equals: 0

  // BT-4143: <<"hi">> matches the exact bytes.
  testMatchStringLiteralValue =>
    result := "hi" match: [
      <<"hi", rest/binary>> -> rest size;
      _ -> -1
    ]
    self assert: result equals: 0

  // BT-4143: "ho" does not match <<"hi">>.
  testMatchStringLiteralValueFallsThrough =>
    result := "ho" match: [
      <<"hi">> -> #matched;
      _ -> #fallback
    ]
    self assert: result equals: #fallback

  // BT-4143: <<$A>> matches byte 65.
  testMatchCharacterLiteralValue =>
    result := "A" match: [
      <<$A, rest/binary>> -> rest size;
      _ -> -1
    ]
    self assert: result equals: 0

  // BT-4143: "B" does not match <<$A>>.
  testMatchCharacterLiteralValueFallsThrough =>
    result := "B" match: [
      <<$A>> -> #matched;
      _ -> #fallback
    ]
    self assert: result equals: #fallback
