// BT-4567: an actor's `class secretState` / `class secretSelectors` are
// redacted by its compiled format_status/1, so `sys:get_status` shows
// "[redacted]" for secret slots, and neither the arguments of a secret
// send nor its reply appear in the logged events.
//
// Fixtures: stdlib/test/fixtures/secret_vault.bt
//           stdlib/test/fixtures/secret_pin_vault.bt
// Crash reports are covered at the Erlang level, against a compiled actor:
// runtime/apps/beamtalk_runtime/test/beamtalk_actor_redaction_tests.erl

TestCase subclass: ActorSecretRedactionTest

  // The part of `sys:get_status` that format_status/1 produced, printed.
  // (OTP also returns the raw sys debug term beside it, unformatted.)
  formattedStatusOf: actor =>
    status := Erlang sys get_status: actor pid
    misc := (Erlang erlang element: 4 tuple: status) last
    (Erlang erlang list_to_binary: (Erlang io_lib format: "~p" args: #(misc))) asStringUnchecked

  testDefaultsAreEmpty =>
    self assert: Actor secretState equals: #()
    self assert: Actor secretSelectors equals: #()

  testDeclarationsAreOrdinaryClassMethods =>
    self assert: SecretVault secretState equals: #(#verifier)
    self assert: SecretVault secretSelectors equals: #(#unlock:)

  testGetStatusRedactsSecretSlots =>
    vault := SecretVault spawn
    text := self formattedStatusOf: vault
    self deny: (text includesSubstring: "31337")
    self assert: (text includesSubstring: "[redacted]")
    self assert: (text includesSubstring: "4242")
    vault stop

  testSecretCallArgumentsAndReplyAreRedactedInLog =>
    vault := SecretVault spawn
    Erlang sys log: vault pid flag: true
    self assert: (vault unlock: 55555) equals: 166665
    self assert: vault count equals: 4242
    text := self formattedStatusOf: vault
    self deny: (text includesSubstring: "55555")
    self deny: (text includesSubstring: "166665")
    self assert: (text includesSubstring: "unlock:")
    vault stop

  testSubclassSecretsAddToSuperclass =>
    vault := SecretPinVault spawn
    text := self formattedStatusOf: vault
    self deny: (text includesSubstring: "31337")
    self deny: (text includesSubstring: "80808")
    self assert: (text includesSubstring: "4242")
    vault stop

  testNoDeclarationsShowsStatusAsToday =>
    counter := Counter spawn
    status := Erlang sys get_status: counter pid
    misc := (Erlang erlang element: 4 tuple: status) last
    stateData := Erlang lists last: misc
    // {data, [{"State", State}]}: the raw gen_server state, unchanged.
    formatted := Erlang erlang element: 2 tuple: (Erlang erlang element: 2 tuple: stateData) first
    self assert: formatted equals: (Erlang sys get_state: counter pid)
    counter stop
