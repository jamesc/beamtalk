// BT-4048: message timers — `Timer send:to:after:` / `send:to:every:`
// deliver a message that a Server receives in handleInfo:.

TestCase subclass: TimerMessageTest
  field: s = nil

  setUp => self.s := TimerMessageServer spawn

  tearDown => self.s isNil ifFalse: [self.s isAlive ifTrue: [self.s stop]]

  testOneShotDeliversToHandleInfo =>
    t := Timer
      send: #tick
      to: self.s
      after: 500
    self assert: t class equals: Timer
    self assert: self.s ticks equals: 0
    Timer sleep: 1000
    self assert: self.s ticks equals: 1

  testOneShotDeliversTupleMessage =>
    Timer
      send: {#data, 42}
      to: self.s
      after: 10
    Timer sleep: 500
    self assert: self.s payloads equals: #(42)

  testOneShotToPid =>
    Timer
      send: #tick
      to: self.s pid
      after: 10
    Timer sleep: 500
    self assert: self.s ticks equals: 1

  testDurationDelay =>
    t := Timer
      send: #tick
      to: self.s
      after: (Duration milliseconds: 500)
    self assert: t isActive
    Timer sleep: 1000
    self assert: self.s ticks equals: 1
    self deny: t isActive

  testCancelBeforeFiringPreventsDelivery =>
    t := Timer
      send: #tick
      to: self.s
      after: 300
    self assert: t cancel equals: true
    Timer sleep: 600
    self assert: self.s ticks equals: 0

  testCancelAfterFiringAnswersFalse =>
    t := Timer
      send: #tick
      to: self.s
      after: 10
    Timer sleep: 500
    self assert: self.s ticks equals: 1
    self assert: t cancel equals: false

  testOneShotIsActive =>
    t := Timer
      send: #tick
      to: self.s
      after: 10000
    self assert: t isActive
    t cancel
    self deny: t isActive
    self assert: t printString equals: "Timer(inactive)"

  testRepeatingDeliversUntilCancelled =>
    t := Timer
      send: #tick
      to: self.s
      every: 20
    self assert: t isActive
    Timer sleep: 500
    self assert: t cancel equals: true
    self deny: t isActive
    n := self.s ticks
    self assert: n >= 3
    Timer sleep: 100
    self assert: self.s ticks equals: n
    self assert: t cancel equals: false

  testRepeatingDurationInterval =>
    t := Timer
      send: #tick
      to: self.s
      every: (Duration milliseconds: 20)
    Timer sleep: 500
    t cancel
    self assert: self.s ticks >= 2

  testSelfReschedulingServer =>
    self.s startPeriodic
    Timer sleep: 1000
    self assert: self.s ticks equals: 3

  testDeadTargetOneShotIsSilent =>
    self.s stop
    t := Timer
      send: #tick
      to: self.s
      after: 10
    Timer sleep: 50
    self deny: t isActive

  testDeadTargetRepeatingStops =>
    t := Timer
      send: #tick
      to: self.s
      every: 10
    self.s stop
    Timer sleep: 100
    self deny: t isActive

  testErrorNegativeDelay =>
    self
      should: [
        Timer
          send: #tick
          to: self.s
          after: -1
      ]
      raise: #type_error

  testErrorZeroInterval =>
    self
      should: [
        Timer
          send: #tick
          to: self.s
          every: 0
      ]
      raise: #type_error

  testErrorDelayTooLarge =>
    // erlang:send_after/3 caps delays at 2^32 - 1 ms
    self
      should: [
        Timer
          send: #tick
          to: self.s
          after: 4294967296
      ]
      raise: #type_error

  testErrorBadTarget =>
    @expect type
    self
      should: [
        Timer
          send: #tick
          to: 42
          after: 10
      ]
      raise: #type_error
