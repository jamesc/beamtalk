// BT-4048: message timers — `Timer send:to:after:` / `send:to:every:`
// deliver a message that a Server receives in handleInfo:.

TestCase subclass: TimerMessageTest
  field: s = nil

  setUp => self.s := TimerMessageServer spawn

  tearDown => self.s isNil ifFalse: [self.s isAlive ifTrue: [self.s stop]]

  testOneShotDeliversToHandleInfo =>
    t := Timer
      send: #tick
      to: self.s
      after: 20
    self assert: t class equals: Timer
    self assert: self.s ticks equals: 0
    Timer sleep: 150
    self assert: self.s ticks equals: 1

  testOneShotDeliversTupleMessage =>
    Timer
      send: {#data, 42}
      to: self.s
      after: 10
    Timer sleep: 150
    self assert: self.s payloads equals: #(42)

  testOneShotToPid =>
    Timer
      send: #tick
      to: self.s pid
      after: 10
    Timer sleep: 150
    self assert: self.s ticks equals: 1

  testDurationDelay =>
    t := Timer
      send: #tick
      to: self.s
      after: (Duration milliseconds: 20)
    self assert: t isActive
    Timer sleep: 150
    self assert: self.s ticks equals: 1
    self deny: t isActive

  testCancelBeforeFiringPreventsDelivery =>
    t := Timer
      send: #tick
      to: self.s
      after: 50
    self assert: t cancel equals: true
    Timer sleep: 150
    self assert: self.s ticks equals: 0

  testCancelAfterFiringAnswersFalse =>
    t := Timer
      send: #tick
      to: self.s
      after: 10
    Timer sleep: 150
    self assert: self.s ticks equals: 1
    self assert: t cancel equals: false

  testOneShotIsActive =>
    t := Timer
      send: #tick
      to: self.s
      after: 10000
    self assert: t isActive
    t cancel
    self deny: t isActive
    self assert: t printString equals: "Timer(inactive)"

  testRepeatingDeliversUntilCancelled =>
    t := Timer
      send: #tick
      to: self.s
      every: 20
    self assert: t isActive
    Timer sleep: 150
    self assert: t cancel equals: true
    self deny: t isActive
    n := self.s ticks
    self assert: n >= 3
    Timer sleep: 100
    self assert: self.s ticks equals: n
    self assert: t cancel equals: false

  testRepeatingDurationInterval =>
    t := Timer
      send: #tick
      to: self.s
      every: (Duration milliseconds: 20)
    Timer sleep: 100
    t cancel
    self assert: self.s ticks >= 2

  testSelfReschedulingServer =>
    self.s startPeriodic
    Timer sleep: 300
    self assert: self.s ticks equals: 3

  testDeadTargetOneShotIsSilent =>
    self.s stop
    t := Timer
      send: #tick
      to: self.s
      after: 10
    Timer sleep: 50
    self deny: t isActive

  testDeadTargetRepeatingStops =>
    t := Timer
      send: #tick
      to: self.s
      every: 10
    self.s stop
    Timer sleep: 100
    self deny: t isActive

  testErrorNegativeDelay =>
    self
      should: [
        Timer
          send: #tick
          to: self.s
          after: -1
      ]
      raise: #type_error

  testErrorZeroInterval =>
    self
      should: [
        Timer
          send: #tick
          to: self.s
          every: 0
      ]
      raise: #type_error
