// BT-3841 (ADR 0131): an evaluated literal block (`[...] value`) that writes an
// outer local is an arm-like local-threading producer: the block is a
// `BranchArm` frame that always runs, so its writes come back through the
// enclosing frame's `LocalRebind`s wherever the send sits (statement, last
// expression, an assignment's value, an operand, an arm, a protected body, a
// handler, a loop or fold body, another evaluated block). The receiver is a
// block literal, so no other class's `value` can run. The methods under test
// are in stdlib/test/fixtures/adr0131eval_block_{class,value,actor}.bt; the
// expected answers are the assertions below.
//
// BT-4263: the `arg*` methods are the same producer for the `value:` family
// (`[:y | t := y] value: 5`, `value:value:`, `value:value:value:`): its
// arguments are evaluated first, in order, in the enclosing frame, then the
// block is the same arm (`{[:y | t := y] value: 5, t}` answers `{5, 5}`).

TestCase subclass: Adr0131EvalBlockTest

  testStA =>
    self assert: #[Adr0131EvalBlockClass stA, (Adr0131EvalBlockValue new) stA, (Adr0131EvalBlockActor spawn) stA] equals: #[1, 1, 1]

  testStSeq =>
    self assert: #[Adr0131EvalBlockClass stSeq, (Adr0131EvalBlockValue new) stSeq, (Adr0131EvalBlockActor spawn) stSeq] equals: #[11, 11, 11]

  testLast =>
    self assert: #[Adr0131EvalBlockClass last, (Adr0131EvalBlockValue new) last, (Adr0131EvalBlockActor spawn) last] equals: #[1, 1, 1]

  testAssign =>
    self assert: #[Adr0131EvalBlockClass assign, (Adr0131EvalBlockValue new) assign, (Adr0131EvalBlockActor spawn) assign] equals: #[#[7, 5], #[7, 5], #[7, 5]]

  testOperand =>
    self assert: #[Adr0131EvalBlockClass operand, (Adr0131EvalBlockValue new) operand, (Adr0131EvalBlockActor spawn) operand] equals: #[#[5, 1], #[5, 1], #[5, 1]]

  testArm =>
    self assert: #[Adr0131EvalBlockClass arm, (Adr0131EvalBlockValue new) arm, (Adr0131EvalBlockActor spawn) arm] equals: #[1, 1, 1]

  testArmNotTaken =>
    self assert: #[Adr0131EvalBlockClass armNotTaken, (Adr0131EvalBlockValue new) armNotTaken, (Adr0131EvalBlockActor spawn) armNotTaken] equals: #[0, 0, 0]

  testNested =>
    self assert: #[Adr0131EvalBlockClass nested, (Adr0131EvalBlockValue new) nested, (Adr0131EvalBlockActor spawn) nested] equals: #[11, 11, 11]

  testTwoLocals =>
    self assert: #[Adr0131EvalBlockClass twoLocals, (Adr0131EvalBlockValue new) twoLocals, (Adr0131EvalBlockActor spawn) twoLocals] equals: #[#[1, 2], #[1, 2], #[1, 2]]

  testBlockLocal =>
    self assert: #[Adr0131EvalBlockClass blockLocal, (Adr0131EvalBlockValue new) blockLocal, (Adr0131EvalBlockActor spawn) blockLocal] equals: #[5, 5, 5]

  testInDo =>
    self assert: #[Adr0131EvalBlockClass inDo, (Adr0131EvalBlockValue new) inDo, (Adr0131EvalBlockActor spawn) inDo] equals: #[6, 6, 6]

