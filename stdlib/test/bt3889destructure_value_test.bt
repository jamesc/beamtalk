// BT-3889: a destructuring assignment evaluates to its right-hand side in every
// method kind and body-ending position. See fixtures/bt3889destructure_value_*.bt.

TestCase subclass: Bt3889DestructureValueTest

  check: o =>
    self assert: o last equals: #(1, 2)
    self assert: (o lastNlr: false) equals: #(1, 2)
    self assert: (o lastNlr: true) equals: 0
    self assert: o lastTuple equals: (Erlang erlang list_to_tuple: #(1, 2))
    self assert: o lastMap equals: #{#k => 1}
    self assert: o block equals: #(1, 2)
    self assert: (o arm: true) equals: #(1, 2)
    self assert: (o arm: false) equals: 0
    self assert: (o threadedArm: true) equals: #(#(5, 2), 5)
    self assert: o onDo equals: #(1, 2)
    self assert: o ensure equals: #(1, 2)
    self assert: o collect equals: #(#(1, 2), #(3, 2))
    self assert: (o threadedCollect) equals: #(#(#(1, 1), #(3, 4)), 4)
    self assert: o inject equals: #(3, #(1, 0))
    self assert: o groupBy equals: #(3)
    self assert: ([o select] on: Error do: [:e | #raised]) equals: #raised

  testClass =>
    self check: Bt3889DestructureValueClass
    self assert: Bt3889DestructureValueClass groupBy equals: #(3)

  testValue =>
    self check: Bt3889DestructureValueValue new
    self assert: Bt3889DestructureValueValue new groupBy equals: #(3)

  testActor => self check: Bt3889DestructureValueActor spawn

  testActorControlFlowRightHandSide =>
    a := Bt3889DestructureValueActor spawn
    self assert: (a lastCf: true) equals: #(1, 2)
    self assert: a n equals: 1
    self assert: (a lastCf: false) equals: #(3, 4)

  testActorBlockThroughASelfSend =>
    self assert: Bt3889DestructureValueActor spawn tier2Block equals: #(#(1, 10), #(2, 20))
