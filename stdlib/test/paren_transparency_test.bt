// BT-4059: a redundant pair of parentheses around a send operand means
// nothing — `(e) foo` compiles and runs exactly like `e foo` — and reflected
// method source drops it. BT-4091: a parenthesised block argument to an
// inlined construct that writes a captured local or a field compiles and
// threads the write like the bare block.

TestCase subclass: ParenTransparencyTest
  field: actor = nil

  setUp => self.actor := ParenTransparencyActor spawn

  tearDown => self.actor stop

  // --- BT-4005's class-method cells, with the receiver parenthesised ---
  testParenthesisedOwnClassBinaryReceiver =>
    self assert: ParenTransparencyHost runParenBinary equals: 1

  testDoublyParenthesisedOwnClassBinaryReceiver =>
    self assert: ParenTransparencyHost runDoubleParenBinary equals: 1

  testParenthesisedSelfBinaryReceiverInClassMethod =>
    self assert: ParenTransparencyHost runParenSelfBinary equals: 1

  testParenthesisedOwnClassUnaryReceiver =>
    self assert: ParenTransparencyHost runParenUnary equals: 2

  testParenthesisedOwnClassKeywordReceiver =>
    self assert: ParenTransparencyHost runParenKeyword equals: 7

  testParenthesisedOwnActorClassBinaryReceiver =>
    self assert: ParenTransparencyActor runParenBinary equals: 101

  testParenthesisedSelfBinaryReceiverInActorMethod =>
    self assert: self.actor runParenSelfBinary equals: 1001

  // --- BT-4091: parenthesised block arguments to inlined constructs ---
  testParenthesisedDoBlockWritesCapturedLocal =>
    self assert: self.actor parenDo equals: 2

  testParenthesisedToDoBlockWritesCapturedLocal =>
    self assert: self.actor parenToDo equals: 2

  testParenthesisedDoBlockWithValueWritesCapturedLocal =>
    self assert: self.actor parenDoWithValue equals: 2

  testParenthesisedDoBlockInActorClassMethod =>
    self assert: (ParenTransparencyActor countItems: #(1, 2, 3)) equals: 3

  testParenthesisedCollectBlockWritesField =>
    self assert: (self.actor doubleAllWithFieldMutation: #(1, 2, 3)) equals: #(2, 4, 6)
    self assert: self.actor getCount equals: 3

  testParenthesisedCollectBlockInBranchWritesCapturedLocal =>
    self assert: (self.actor countLocal: #(1, 2, 3) when: true) equals: 3
    self assert: (self.actor countLocal: #(1, 2, 3) when: false) equals: 0

  // --- Reflected source is canonical ---
  testReflectedSourceDropsRedundantOperandParens =>
    self assert: (ParenTransparencyHost >> #reflectSelf) source equals: "reflectSelf => self printString"

  testReflectedSourceKeepsNeededParens =>
    self assert: (ParenTransparencyHost >> #reflectProduct:) source equals: "reflectProduct: a => a * (a + 1)"
