// BT-3738 (ADR 0131 Phase 3): a conditional (`ifTrue:` ... `ifNil:ifNotNil:`,
// `and:`/`or:`) that writes an outer local is a local-threading producer at
// the method root, whatever position it sits in (statement, last expression,
// an assignment's value, an operand), and each of its arms is a `BranchArm`
// frame: a loop, fold or nested conditional in an arm rebinds its locals into
// the arm's own scratch map. In a class or value-type method the scratch map
// is private (no `State` family exists there); in an actor instance method it
// continues `State`. The columns are
// adr0131cond_producer_{class,value,actor}.bt; the expected answers are in
// stdlib/test/adr0131cond_producer_test.bt.

TestCase subclass: Adr0131CondProducerTest

  testStA0 =>
    self assert: #[Adr0131CondProducerClass stA: true, (Adr0131CondProducerValue new) stA: true, (Adr0131CondProducerActor spawn) stA: true] equals: #[5, 5, 5]

  testStA1 =>
    self assert: #[Adr0131CondProducerClass stA: false, (Adr0131CondProducerValue new) stA: false, (Adr0131CondProducerActor spawn) stA: false] equals: #[0, 0, 0]

  testStB0 =>
    self assert: #[Adr0131CondProducerClass stB: true, (Adr0131CondProducerValue new) stB: true, (Adr0131CondProducerActor spawn) stB: true] equals: #[1, 1, 1]

  testStB1 =>
    self assert: #[Adr0131CondProducerClass stB: false, (Adr0131CondProducerValue new) stB: false, (Adr0131CondProducerActor spawn) stB: false] equals: #[10, 10, 10]

  testStC0 =>
    self assert: #[Adr0131CondProducerClass stC: nil, (Adr0131CondProducerValue new) stC: nil, (Adr0131CondProducerActor spawn) stC: nil] equals: #[1, 1, 1]

  testStC1 =>
    self assert: #[Adr0131CondProducerClass stC: 5, (Adr0131CondProducerValue new) stC: 5, (Adr0131CondProducerActor spawn) stC: 5] equals: #[0, 0, 0]

  testStD0 =>
    self assert: #[Adr0131CondProducerClass stD: true, (Adr0131CondProducerValue new) stD: true, (Adr0131CondProducerActor spawn) stD: true] equals: #[1, 1, 1]

  testStD1 =>
    self assert: #[Adr0131CondProducerClass stD: false, (Adr0131CondProducerValue new) stD: false, (Adr0131CondProducerActor spawn) stD: false] equals: #[0, 0, 0]

  testLast0 =>
    self assert: #[Adr0131CondProducerClass last: true, (Adr0131CondProducerValue new) last: true, (Adr0131CondProducerActor spawn) last: true] equals: #[7, 7, 7]

  testLast1 =>
    self assert: #[Adr0131CondProducerClass last: false, (Adr0131CondProducerValue new) last: false, (Adr0131CondProducerActor spawn) last: false] equals: #[8, 8, 8]

  testAssign0 =>
    self assert: #[Adr0131CondProducerClass assign: true, (Adr0131CondProducerValue new) assign: true, (Adr0131CondProducerActor spawn) assign: true] equals: #[#[2, 1], #[2, 1], #[2, 1]]

  testAssign1 =>
    self assert: #[Adr0131CondProducerClass assign: false, (Adr0131CondProducerValue new) assign: false, (Adr0131CondProducerActor spawn) assign: false] equals: #[#[3, 0], #[3, 0], #[3, 0]]

