    self assert: #[Adr0131CondProducerClass assignNil: nil, (Adr0131CondProducerValue new) assignNil: nil, (Adr0131CondProducerActor spawn) assignNil: nil] equals: #[#[2, 1], #[2, 1], #[2, 1]]

