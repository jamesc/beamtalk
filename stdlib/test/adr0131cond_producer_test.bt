    self assert: #[Adr0131CondProducerClass assignNil: 5, (Adr0131CondProducerValue new) assignNil: 5, (Adr0131CondProducerActor spawn) assignNil: 5] equals: #[#[5, 0], #[5, 0], #[5, 0]]

