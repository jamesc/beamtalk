// BT-3377: An actor method literally named `value` (or `value:`/
// `value:value:`/`value:value:value:`/`valueWithArguments:`) must return its
// own plain result across the process boundary, not `{#ok, Result}` — the
// literal selector name collided with Block's `value`-family runtime
// dispatch guard, whose "not a function" fallback bypassed the actor
// reply-unwrap protocol. See fixtures/bt3377value_probe.bt for the
// full root-cause writeup.

TestCase subclass: BT3377ActorValueSelectorTest

  testExternalUnaryValueReturnsPlainResultNotOkTuple =>
    probe := BT3377ValueProbe spawn
    probe setIt
    self assert: probe value equals: 99
    probe stop

  testExternalValueColonReturnsPlainResultNotOkTuple =>
    probe := BT3377ValueProbe spawn
    probe setIt
    self assert: (probe value: 1) equals: 100
    probe stop

  testExternalValueValueColonReturnsPlainResultNotOkTuple =>
    probe := BT3377ValueProbe spawn
    probe setIt
    self assert: (probe value: 1 value: 2) equals: 102
    probe stop

  testExternalValueValueValueColonReturnsPlainResultNotOkTuple =>
    probe := BT3377ValueProbe spawn
    probe setIt
    self
      assert: (probe
        value: 1
        value: 2
        value: 3)
      equals: 105
    probe stop

  testExternalValueWithArgumentsReturnsPlainResultNotOkTuple =>
    probe := BT3377ValueProbe spawn
    probe setIt
    self assert: (probe valueWithArguments: #(1, 2, 3)) equals: 105
    probe stop
