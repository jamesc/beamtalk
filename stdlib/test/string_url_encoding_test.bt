// Stdlib tests for String urlEncoded/urlDecoded (RFC 3986 percent-encoding).

TestCase subclass: StringUrlEncodingTest

  // ===== urlEncoded =====
  testUrlEncodedEncodesSpace =>
    self assert: "hello world" urlEncoded equals: "hello%20world"

  testUrlEncodedEncodesReservedCharacters =>
    self assert: "a/b+c" urlEncoded equals: "a%2Fb%2Bc"
    self assert: "key=value&other=1" urlEncoded equals: "key%3Dvalue%26other%3D1"

  testUrlEncodedLeavesUnreservedCharactersUnchanged =>
    self assert: "abcXYZ019-._~" urlEncoded equals: "abcXYZ019-._~"

  testUrlEncodedEmptyString => self assert: "" urlEncoded equals: ""

  // ===== urlDecoded =====
  testUrlDecodedDecodesPercentEscapes =>
    self assert: "hello%20world" urlDecoded equals: "hello world"
    self assert: "a%2Fb%2Bc" urlDecoded equals: "a/b+c"

  testUrlDecodedLeavesUnescapedCharactersUnchanged =>
    self assert: "abcXYZ019-._~" urlDecoded equals: "abcXYZ019-._~"

  testUrlDecodedEmptyString => self assert: "" urlDecoded equals: ""

  // ===== Round trip =====
  testUrlEncodedDecodedRoundTrip =>
    original := "hello world/foo?bar=baz&x=1 2 3"
    self assert: original urlEncoded urlDecoded equals: original
