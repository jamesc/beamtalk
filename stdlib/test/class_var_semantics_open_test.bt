// BT-3704 (ADR 0130 Phase 1): the class-variable semantics matrix for the
// open class. Each test asserts the ADR 0130 section 4/5 answer; a test
// whose answer differed before ADR 0130 pinned the old answer under a PIN-BUG marker
// citing BT-3713; BT-3713 flipped every such pin to the ADR answer.

TestCase subclass: ClassVarSemanticsOpenTest

  // ADR 0130 §4
  testTop => self assert: CvsOpen rowTop equals: 2

  // ADR 0130 §4
  testArm =>
    self assert: (CvsOpen rowArm: 1) equals: 1
    self assert: (CvsOpen rowArm: 0) equals: 0

  // ADR 0130 §4
  testLetrecTimesLocal => self assert: CvsOpen rowTimesLocal equals: 3

  // ADR 0130 §4
  testLetrecToDoLocal => self assert: CvsOpen rowToDoLocal equals: 3

  // ADR 0130 §4
  testLetrecWhileLocal => self assert: CvsOpen rowWhileLocal equals: 3

  // ADR 0130 §4
  testFoldDoThreaded => self assert: CvsOpen rowDoLocal equals: 3

  // ADR 0130 §4
  testFoldCollectThreaded => self assert: CvsOpen rowCollectLocal equals: 3

  // ADR 0130 §4
  testFoldInjectThreaded => self assert: CvsOpen rowInjectLocal equals: 3

  // ADR 0130 §4 catch boundary
  testOnDoBodyDiscardsWriteBeforeRaise =>
    self assert: CvsOpen rowOnBodyRaise equals: 0

  // ADR 0130 §4 catch boundary
  testOnDoBodyKeepsWriteWhenNoError =>
    self assert: CvsOpen rowOnBodyOk equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoBodyKeepsWriteMadeBeforeTheRegion =>
    self assert: CvsOpen rowOnBodyAfterWrite equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoBodyDiscardsWriteOfFailingSend =>
    self assert: CvsOpen rowOnBodyViaSend equals: 0

  // ADR 0130 §4 catch boundary
  testOnDoHandlerKeepsItsWrite => self assert: CvsOpen rowHandler equals: 1

  // ADR 0130 §4 catch boundary
  testOnDoHandlerKeepsItsWriteBodyWriteDiscarded =>
    self assert: CvsOpen rowHandlerAfterBodyWrite equals: 1

  // ADR 0130 §4 ensure is not a boundary
  testEnsureKeepsBothWrites => self assert: CvsOpen rowEnsure equals: 2

  // ADR 0130 §5 at home
  testBareBlock => self assert: CvsOpen rowBare equals: 1

  // ADR 0130 §5 at home
  testStoredClosureWithinInvocationWrites =>
    self assert: CvsOpen rowStoredWithin equals: 2

  // ADR 0130 §5 at home
  testStoredClosureWithinInvocationReadsLive =>
    self assert: CvsOpen rowStoredReadWithin equals: 1

  // ADR 0130 §5 later invocation of the same class is at home
  testStoredClosureLaterInvocationWrites =>
    CvsOpen reset
    CvsOpen run: CvsOpen makeBumper
    self assert: CvsOpen n equals: 1

  // ADR 0130 §5 later invocation of the same class is at home
  testStoredClosureLaterInvocationReadsLive =>
    CvsOpen reset
    b := CvsOpen makeReader
    CvsOpen bump
    self assert: (CvsOpen run: b) equals: 1

  // ADR 0130 §5 abroad: captured read
  testClosureFromForeignProcessReadsCaptured =>
    CvsOpen reset
    b := CvsOpen makeReader
    CvsOpen bump
    self assert: b value equals: 0

  // ADR 0130 §5 abroad: write raises
  // The error comes from the block's method-level read inside `bump`, which has no capture
  // (a block abroad reads only what its own literal captured); either way the kind is the
  // structured class_state_unreachable and nothing is written.
  testClosureFromForeignProcessWriteRaises =>
    CvsOpen reset
    b := CvsOpen makeBumper
    self should: [b value] raise: #class_state_unreachable
    self assert: CvsOpen n equals: 0

  // ADR 0130 §5 carried synchronously: captured equals live
  testSyncBlockToOpenDriverReadsLive =>
    self assert: CvsOpen rowSyncReadOpenDriver equals: 1

  // ADR 0130 §5 abroad: write raises
  testSyncBlockToOpenDriverWriteRaises =>
    CvsOpen reset
    self should: [
      CvsOpen rowSyncWriteOpenDriver
    ] raise: #class_state_unreachable
    self assert: CvsOpen n equals: 0

  // ADR 0130 §5 direct-called class method is at home
  testSyncBlockToSealedDriverReadsLive =>
    self assert: CvsOpen rowSyncReadSealedDriver equals: 1

  // ADR 0130 §5 direct-called class method is at home
  testSyncBlockToSealedDriverWrites =>
    self assert: CvsOpen rowSyncWriteSealedDriver equals: 1

  // ADR 0130 §5 carried asynchronously: creation-time value
  testAsyncBlockToActorReadsCreationValue =>
    self assert: CvsOpen rowAsyncRead equals: 0

  // ADR 0130 §5 abroad: write raises
  testAsyncBlockToActorWriteRaises =>
    self assert: CvsOpen rowAsyncWrite equals: #class_state_unreachable
    self assert: CvsOpen n equals: 0

  // ADR 0130 §5 runtime-owned snapshot
  testPerformLocallyReadsSnapshot =>
    CvsOpen reset
    CvsOpen bump
    self assert: (CvsOpen performLocally: #n withArguments: #()) equals: 1

  // ADR 0130 §5 runtime-owned snapshot
  testPerformLocallyWriteRaises =>
    CvsOpen reset
    self assert: ([
      CvsOpen performLocally: #bump withArguments: #()
    ] on: Error do: [:e | e kind]) equals: #class_state_read_only
    self assert: CvsOpen n equals: 0

  // ADR 0130 §4 non-local return
  testOwnNlrKeepsWriteBeforeCaret =>
    self assert: CvsOpen rowOwnNlr equals: 1
    self assert: CvsOpen n equals: 1

  // ADR 0130 §4 non-local return
  testForeignNlrThroughOpenDriverKeepsEarlierWrite =>
    self assert: CvsOpen rowForeignNlrAfterWrite equals: 5
    self assert: CvsOpen n equals: 1

  // ADR 0130 §4 non-local return
  testForeignNlrThroughSealedDriverKeepsWriteBeforeCaret =>
    self assert: CvsOpen rowForeignNlrSealedDriver equals: 5
    self assert: CvsOpen n equals: 1

  // ADR 0130 §5 runtime-owned snapshot
  testInitializeHookWriteRaises =>
    CvsInitOpen reset
    self should: [CvsInitOpen supervise] raise: #class_state_read_only
    self assert: CvsInitOpen n equals: 0
