// BT-4367: a loop or fold that writes a local of its own conditional arm answers
// what the same body answers at the method root, for every conditional selector
// in `PLAIN_ARM_SELECTORS` at every position of the conditional, in actor and
// value-type methods. This grid is the runtime evidence behind the validator's
// plain-arm rule. A class method, a dictionary-lookup handler, `and:`/`or:`, a
// conditional nested in a loop, fold or arm, and a loop at an operand or
// array-literal site of an arm keep the position error (pinned in
// `local_threading.rs`). Fixtures: fixtures/bt4367arm_local_grid_{actor,value}.bt.

TestCase subclass: Bt4367ArmLocalGridTest

  test_actor_ifTrue_ifFalse_last_assign_inject =>
    o := Bt4367ArmLocalGridActor spawn
    self assert: (o ifTrue_ifFalse_last_assign_injectArm: true) equals: o ifTrue_ifFalse_last_assign_injectRoot

