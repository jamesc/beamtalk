// BT-3746 (ADR 0131 Phase 1a): `1 to: 3 do: [:i | [s < i] whileTrue: [s := s + 1]]`
// in each method context. The `to:do:` body's nested `whileTrue:` writes the
// method local `s`, and the correct answer is 3. Today the enclosing
// `to:do:` does not carry a nested `whileTrue:`'s writes (`threaded_today_blocks`,
// ADR 0131 §1 transitive closure), so the write is lost and every context
// answers 0. Fixtures: fixtures/bt3746nested_while_{class,value,actor}.bt.

TestCase subclass: Bt3746NestedWhileTest
  // PIN-BUG BT-3749: pins today's answer (the nested `whileTrue:` write is lost); the correct answer is 3.
  testClassMethod => self assert: Bt3746NestedWhileClass run equals: 0

  // PIN-BUG BT-3749: pins today's answer (the nested `whileTrue:` write is lost); the correct answer is 3.
  testValueTypeMethod => self assert: Bt3746NestedWhileValue new run equals: 0

  // PIN-BUG BT-3749: pins today's answer (the nested `whileTrue:` write is lost); the correct answer is 3.
  testActorMethod => self assert: Bt3746NestedWhileActor spawn run equals: 0
