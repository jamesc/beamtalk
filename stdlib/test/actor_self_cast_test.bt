// BT-3998: `self foo!` is a real cast to the actor's own mailbox. It lands
// after the current message and its State change is kept (it used to run
// inline and drop the write).

TestCase subclass: ActorSelfCastTest
  field: a = nil

  setUp => self withA: SelfCastActor spawn

  tearDown => self.a isNil ifFalse: [self.a stop]

  testSelfCastDoesNotRunInline => self assert: self.a castBump equals: 0

  testSelfCastWriteIsKept =>
    self.a castBump
    self assert: self.a getBumped equals: 1

  testSelfCastWithArgumentWriteIsKept =>
    self assert: self.a castSetX equals: 0
    self assert: self.a getX equals: 9
