// Tests the Logger class — info:, warn:, error:, debug:, metadata variants, and runtime
// logging configuration (logLevel, logFormat, debug targets)

TestCase subclass: LoggerTest

  testInfoReturnsNil =>
    // info: returns nil
    self assert: (Logger info: "test info message") equals: nil

  testInfoWithMetadata =>
    // info:metadata: returns nil
    self assert: (Logger info: "test info" metadata: #{
      "key" => "value"
    }) equals: nil

  testWarnReturnsNil =>
    // warn: returns nil
    self assert: (Logger warn: "test warn message") equals: nil

  testWarnWithMetadata =>
    // warn:metadata: returns nil
    self assert: (Logger warn: "test warn" metadata: #{
      "attempt" => 2
    }) equals: nil

  testErrorReturnsNil =>
    // error: returns nil
    self assert: (Logger error: "test error message") equals: nil

  testErrorWithMetadata =>
    // error:metadata: returns nil
    self assert: (Logger error: "test error" metadata: #{
      "reason" => "timeout"
    }) equals: nil

  testDebugReturnsNil =>
    // debug: returns nil
    self assert: (Logger debug: "test debug message") equals: nil

  testDebugWithMetadata =>
    // debug:metadata: returns nil
    self assert: (Logger debug: "test debug" metadata: #{
      "count" => 42
    }) equals: nil

  // === Logging configuration (BT-3653: moved from Beamtalk) ===
  testLogLevelReturnsSymbol => self assert: (Logger logLevel isKindOf: Symbol)

  testLogLevelRoundTrip =>
    saved := Logger logLevel
    [
      Logger logLevel: #notice
      self assert: Logger logLevel equals: #notice
    ]
      ensure: [
        // Restore the level BUnit started with (test sys.config uses #error),
        // even if the assertion above fails. Not asserted: the `#error` atom
        // is coerced to a Result on return.
        Logger logLevel: #error
      ]
    self assert: (saved isKindOf: Symbol)

  testLogFormatIsTextOrJson =>
    fmt := Logger logFormat
    self assert: ((fmt == #text) or: [fmt == #json])

  testDebugTargetsIsList => self assert: (Logger debugTargets isKindOf: List)

  testActiveDebugTargetsIsList =>
    self assert: (Logger activeDebugTargets isKindOf: List)

  testLoggerInfoIsString => self assert: (Logger loggerInfo isKindOf: String)
