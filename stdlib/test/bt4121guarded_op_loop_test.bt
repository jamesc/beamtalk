// BT-4121 (ADR 0137): a guarded operator's slow path in a loop that holds
// no whole `State` must see the live cell and have its writes loaded back.
// Each cell below adds tally-reporting money over untyped locals and then
// answers the actor's count. Fixtures: fixtures/bt4121tally_money.bt and
// fixtures/bt4121tally_actor.bt.

TestCase subclass: Bt4121GuardedOpLoopTest
  field: a = nil

  setUp =>
    self.a := Bt4121TallyActor spawn
    self

  testDoLoopLoadsSlowPathWrites =>
    self assert: (self.a sum: self.a items) equals: 600
    self assert: self.a count equals: 3

  testDoLoopSeesPreLoopWrite =>
    self assert: (self.a sumSeeded: self.a items) equals: 103

  testDoLoopFromNumberCoercion =>
    self assert: (self.a sumFromNumber: self.a items) equals: 3
    self assert: self.a total equals: 600

  testNonCarriedDoBracketsClosureCall =>
    self.a pokeAll: self.a items
    self assert: self.a count equals: 3

  testWhileLoopLoadsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a repeatAdd: m times: 3) equals: 300
    self assert: self.a count equals: 3

  testToDoLoopLoadsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a repeatAddTo: m times: 3) equals: 300
    self assert: self.a count equals: 3

  testTimesRepeatLoadsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a repeatAddTimes: m times: 3) equals: 300
    self assert: self.a count equals: 3

  testCollectLoadsSlowPathWrites =>
    self assert: (self.a collectSums: self.a items) size equals: 3
    self assert: self.a count equals: 3

  testInjectStaysBracketed =>
    self assert: (self.a injectSums: self.a items) cents equals: 600
    self assert: self.a count equals: 3

  testNonCarriedTimesRepeatBracketsClosureCall =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self.a pokeTimes: m count: 3
    self assert: self.a count equals: 3

  testEvaluatedBlockBracketsClosureCall =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self.a applyValue: m
    self assert: self.a count equals: 1

  testDoLoopFieldReadSeesSlowPathWrites =>
    self assert: (self.a readCountWhileAdding: self.a items) equals: 2
    self assert: self.a count equals: 3

  testWhileLoopFieldReadSeesSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a repeatAddCounting: m times: 3) equals: 2
    self assert: self.a count equals: 3

  testEarlyReturnKeepsSlowPathWrites =>
    self assert: (self.a sumUntil: self.a items limit: 150) cents equals: 300
    self assert: self.a count equals: 2

  testDirectReturnKeepsSlowPathWrites =>
    self assert: (self.a sumFirst: self.a items) cents equals: 100
    self assert: self.a count equals: 1

  // BT-4179: catch-and-continue keeps earlier-iteration slow-path writes.
  testOnDoCatchKeepsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a sumCatching: m times: 3) equals: 3
    self assert: self.a count equals: 3

  testWhileLoopOnDoCatchKeepsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a repeatAddCatching: m times: 3) equals: 3
    self assert: self.a count equals: 3

  // BT-4179: the protected block's own slow-path writes still roll back.
  testOnDoCatchRollsBackProtectedWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a sumRollingBack: m times: 3) equals: 3
    self assert: self.a count equals: 3

  // BT-4179 review: an `on:do:` in a hybrid loop nested in a bracketing loop.
  testHybridLoopOnDoKeepsWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a hybridCatching: m times: 3) equals: 3300

  testHybridLoopOnDoReadsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a hybridReadingCatching: m times: 3) equals: 3003

  testHybridLoopEscapingErrorRollsBack =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self should: [self.a hybridEscaping: m] raise: #user_error
    self assert: self.a count equals: 0
    self assert: self.a total equals: 0
    self assert: self.a hits equals: 0

  testHybridLoopEscapingErrorWithoutOnDoRollsBack =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self should: [self.a hybridEscapingBare: m] raise: #user_error
    self assert: self.a count equals: 0
    self assert: self.a total equals: 0
    self assert: self.a hits equals: 0

  testNestedLoopOnDoRollsBackProtectedFieldWrite =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a nestedRollingBack: m times: 3) equals: 3006

  testNestedLoopOnDoKeepsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a nestedCatching: m times: 3) equals: 3

  testEnsureKeepsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a sumEnsuring: m times: 3) equals: 3

  // BT-4179: a StateAcc fold nested in a bracketing loop keeps the slow
  // paths' writes.
  testFoldInLoopOnDoKeepsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a foldInLoopCatching: m times: 3) equals: 3003

  testFoldInLoopKeepsSlowPathWrites =>
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    self assert: (self.a foldInLoop: m times: 3) equals: 3003

  // BT-4180: a block created inside a bracketed loop and run in another
  // process reads the slow-path writes made before its creation.
  testBlockCreatedInBracketedLoopCapturesTheCell =>
    runner := ClosureCellRunner spawn
    blocks := self.a blocksWhileAdding: self.a items
    self assert: (blocks collect: [:b | runner run: b]) equals: #(1, 2, 3)

  testBlockCreatedInBracketedCountedLoopCapturesTheCell =>
    runner := ClosureCellRunner spawn
    m := ((Bt4121TallyMoney new) withCents: 100) withTally: self.a
    b := self.a lastBlockWhileAdding: m times: 3
    self assert: (runner run: b) equals: 3
