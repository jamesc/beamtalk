TestCase subclass: ScratchcvTest

  testH0 =>
    self assert: (Bt3911CvOpen h0: 1) equals: 6

  testH1 =>
    self assert: (Bt3911CvOpen h1: 1) equals: 0

  testH2 =>
    self assert: (Bt3911CvOpen h2: 1) equals: 0

  testH3 =>
    self assert: (Bt3911CvOpen h3: 1) equals: 0

  testRun =>
    self assert: Bt3911CvOpen run equals: 0
