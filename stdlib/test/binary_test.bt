// Stdlib tests for Binary class — instance methods, Collection protocol,
// byte access, slicing, conversion, and serialization (BT-1594, ADR 0086 Phase 3a)
//
// BT-4173: binaries dispatch as Binary (byte-level). Only tagged Strings
// dispatch as String. `size`/`at:`/`do:` and the inherited Collection
// protocol (`collect:`/`select:`/`reject:`/`detect:`/`anySatisfy:`,
// `allSatisfy:`/`includes:`) are byte-level here; `byteSize` is deleted
// (use `size`); `asString` answers `Result ok:`/`error:` uniformly.

TestCase subclass: BinaryTest
  field: bin = nil
  field: binBytes = nil

  setUp =>
    self.bin := Binary fromBytes: #(65, 66, 67)
    self.binBytes := Binary fromBytes: #(1, 2, 3)

  // ═══════════════════════════════════════════════════════════════════
  // Serialization (class methods — existing)
  // ═══════════════════════════════════════════════════════════════════
  testSerializeAndDeserializeInteger =>
    bin := Binary serialize: 42
    self assert: (Binary deserialize: bin) equals: 42

  testSerializeAndDeserializeString =>
    bin := Binary serialize: "hello"
    self assert: (Binary deserialize: bin) equals: "hello"

  testSerializeAndDeserializeArray =>
    bin := Binary serialize: #(1, 2, 3)
    self assert: (Binary deserialize: bin) equals: #(1, 2, 3)

  testSerializeAndDeserializeNil =>
    bin := Binary serialize: nil
    self assert: (Binary deserialize: bin) equals: nil

  testSerializeAndDeserializeBoolean =>
    binTrue := Binary serialize: true
    self assert: (Binary deserialize: binTrue) equals: true
    binFalse := Binary serialize: false
    self assert: (Binary deserialize: binFalse) equals: false

  testSerializeProducesBinary =>
    bin := Binary serialize: 42
    self assert: bin size > 0

  // testDeserializeTypeError: removed — type checker now prevents Binary deserialize: 42
  // at compile time (BT-1828 tightened :: Object → :: Binary)
  testClassIdentity =>
    // BT-802 (ADR 0036): class on class returns a real metaclass object
    self assert: (Binary class) isMeta equals: true

  // ═══════════════════════════════════════════════════════════════════
  // fromIolist: and fromBytes: (class methods)
  // ═══════════════════════════════════════════════════════════════════
  testFromIolist =>
    result := Binary fromIolist: #("hello", " ", "world")
    self assert: result class equals: Binary
    self assert: result equals: (Binary fromIolist: #("hello world"))

  testFromIolistEmpty =>
    result := Binary fromIolist: #()
    self assert: result equals: (Binary fromBytes: #())

  testFromBytes =>
    bin := Binary fromBytes: #(104, 101, 108, 108, 111)
    self assert: bin equals: (Binary fromIolist: #("hello"))

  testFromBytesEmpty =>
    bin := Binary fromBytes: #()
    self assert: bin size equals: 0

  testFromBytesSingleByte =>
    bin := Binary fromBytes: #(65)
    self assert: bin equals: (Binary fromIolist: #("A"))

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: size, isEmpty, isNotEmpty
  // size is byte-level on Binary, grapheme-level on String.
  // ═══════════════════════════════════════════════════════════════════
  testSize =>
    bin := Binary fromBytes: #(65, 66, 67, 68, 69)
    self assert: bin size equals: 5

  testSizeEmpty =>
    bin := Binary fromBytes: #()
    self assert: bin size equals: 0

  testSizeOfSerializedValue =>
    bin := Binary serialize: 42
    self assert: bin size > 0

  testIsEmpty => self assert: (Binary fromBytes: #()) isEmpty

  testIsEmptyFalse => self deny: (Binary fromBytes: #(1)) isEmpty

  testIsNotEmpty => self assert: (Binary fromBytes: #(1, 2)) isNotEmpty

  testIsNotEmptyFalse => self deny: (Binary fromBytes: #()) isNotEmpty

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: do:
  // Byte-level on Binary: elements are byte Integers.
  // ═══════════════════════════════════════════════════════════════════
  testDoIteratesBytes =>
    collected := List new
    self.bin do: [:b | collected := collected add: b]
    self assert: collected equals: #(65, 66, 67)

  testDoOnEmptyBinary =>
    bin := Binary fromBytes: #()
    count := 0
    bin do: [:ch | count := count + 1]
    self assert: count equals: 0

  testDoReturnValue =>
    // do: returns nil
    bin := Binary fromBytes: #(65, 66)
    result := bin do: [:ch | ch]
    self assert: result equals: nil

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: includes:
  // Byte-level on Binary: compares byte Integers.
  // ═══════════════════════════════════════════════════════════════════
  testIncludesByte => self assert: (self.bin includes: 66)

  testIncludesByteNotFound => self deny: (self.bin includes: 90)

  testIncludesOnEmpty =>
    bin := Binary fromBytes: #()
    self deny: (bin includes: 65)

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: collect:
  // Byte-level on Binary; answers a Binary via species.
  // ═══════════════════════════════════════════════════════════════════
  testCollectTransformsBytes =>
    // Identity over bytes reassembles the same Binary
    result := self.bin collect: [:b | b]
    self assert: result class equals: Binary
    self assert: result equals: self.bin

  testCollectMapsBytes =>
    result := self.bin collect: [:b | b + 1]
    self assert: result equals: (Binary fromBytes: #(66, 67, 68))

  testCollectOnEmpty =>
    bin := Binary fromBytes: #()
    result := bin collect: [:b | b]
    self assert: result equals: (Binary fromBytes: #())

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: select:, reject:
  // Byte-level on Binary; answer a Binary via species.
  // ═══════════════════════════════════════════════════════════════════
  testSelectFiltersBytes =>
    bin := Binary fromBytes: #(65, 66, 67, 68, 69)
    result := bin select: [:b | b /= 67]
    self assert: result equals: (Binary fromBytes: #(65, 66, 68, 69))

  testSelectNoneMatch =>
    result := self.bin select: [:b | b =:= 90]
    self assert: result equals: (Binary fromBytes: #())

  testRejectFiltersBytes =>
    bin := Binary fromBytes: #(65, 66, 67, 68, 69)
    result := bin reject: [:b | b =:= 67]
    self assert: result equals: (Binary fromBytes: #(65, 66, 68, 69))

  testRejectNoneMatch =>
    result := self.bin reject: [:b | b =:= 90]
    self assert: result equals: self.bin

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: inject:into:
  // Byte-level on Binary: elements are byte Integers.
  // ═══════════════════════════════════════════════════════════════════
  testInjectIntoSumsBytes =>
    result := self.bin inject: 0 into: [:acc :b | acc + b]
    self assert: result equals: 198

  testInjectIntoOnEmpty =>
    bin := Binary fromBytes: #()
    result := bin inject: 42 into: [:acc :b | acc + b]
    self assert: result equals: 42

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: detect:
  // Byte-level on Binary: elements are byte Integers.
  // ═══════════════════════════════════════════════════════════════════
  testDetectFindsFirstMatch =>
    bin := Binary fromBytes: #(65, 66, 67, 68, 69)
    result := bin detect: [:b | b =:= 67]
    self assert: result equals: 67

  // BT-3028: a no-match raises `not_found` rather than answering nil — the
  // inherited `Collection>>detect:` answers `E`, on every receiver.
  testDetectRaisesNotFoundWhenNoMatch =>
    self should: [self.bin detect: [:b | b =:= 90]] raise: #not_found

  testDetectIfNoneAnswersDefaultWhenNoMatch =>
    self assert: (self.bin detect: [:b |
      b =:= 90
    ] ifNone: ["none"]) equals: "none"

  // ═══════════════════════════════════════════════════════════════════
  // Collection protocol: anySatisfy:, allSatisfy:
  // Byte-level on Binary: elements are byte Integers.
  // ═══════════════════════════════════════════════════════════════════
  testAnySatisfyTrue => self assert: (self.bin anySatisfy: [:b | b =:= 66])

  testAnySatisfyFalse => self deny: (self.bin anySatisfy: [:b | b =:= 90])

  testAllSatisfyTrue => self assert: (self.bin allSatisfy: [:b | b > 0])

  testAllSatisfyFalse => self deny: (self.bin allSatisfy: [:b | b =:= 65])

  // ═══════════════════════════════════════════════════════════════════
  // Byte access: at: (1-based)
  // 1-based, byte-level on Binary.
  // ═══════════════════════════════════════════════════════════════════
  testAtReturnsByte =>
    bin := Binary fromBytes: #(104, 101, 108)
    self assert: (bin at: 1) equals: 104

  testAtLastByte =>
    bin := Binary fromBytes: #(104, 101, 108)
    self assert: (bin at: 3) equals: 108

  testAtOutOfBoundsHigh =>
    self should: [self.binBytes at: 4] raise: #index_out_of_bounds

  testAtOutOfBoundsZero =>
    self should: [self.binBytes at: 0] raise: #index_out_of_bounds

  // BT-3021: indexing an empty collection is `empty_collection`, not
  // `index_out_of_bounds` — the latter is reserved for an index that misses a
  // populated receiver.
  testAtOnEmptyBinary =>
    bin := Binary fromBytes: #()
    self should: [bin at: 1] raise: #empty_collection

  testAtBeyondSizeOnBinaryIsOutOfBounds =>
    bin := Binary fromBytes: #(104, 105)
    self should: [bin at: 9] raise: #index_out_of_bounds

  // ═══════════════════════════════════════════════════════════════════
  // Byte access: byteAt: (0-based) — Binary-only, not overridden
  // ═══════════════════════════════════════════════════════════════════
  testByteAtFirstByte =>
    bin := Binary fromBytes: #(104, 101, 108)
    self assert: (bin byteAt: 0) equals: 104

  testByteAtLastByte =>
    bin := Binary fromBytes: #(104, 101, 108)
    self assert: (bin byteAt: 2) equals: 108

  testByteAtMiddleByte =>
    bin := Binary fromBytes: #(104, 101, 108)
    self assert: (bin byteAt: 1) equals: 101

  testByteAtOutOfBoundsHigh =>
    self should: [self.binBytes byteAt: 3] raise: #index_out_of_bounds

  testByteAtOutOfBoundsNegative =>
    self should: [self.binBytes byteAt: -1] raise: #index_out_of_bounds

  testByteAtOnEmptyBinary =>
    bin := Binary fromBytes: #()
    self should: [bin byteAt: 0] raise: #index_out_of_bounds

  // ═══════════════════════════════════════════════════════════════════
  // size — byte count on Binary (BT-4173: byteSize deleted), grapheme
  // count on String
  // ═══════════════════════════════════════════════════════════════════
  testSizeCountsBytesOnBinary => self assert: self.binBytes size equals: 3

  testSizeEmptyBinary =>
    bin := Binary fromBytes: #()
    self assert: bin size equals: 0

  testSizeCountsGraphemesOnString => self assert: "hello" size equals: 5

  testSizeOfEmptyString => self assert: "" size equals: 0

  // ═══════════════════════════════════════════════════════════════════
  // part:size: — zero-copy slicing (Binary-only, not overridden)
  // ═══════════════════════════════════════════════════════════════════
  testPartSlice =>
    bin := Binary fromBytes: #(1, 2, 3, 4, 5)
    result := bin part: 1 size: 3
    self assert: result equals: (Binary fromBytes: #(2, 3, 4))

  testPartFromStart =>
    bin := Binary fromBytes: #(1, 2, 3, 4, 5)
    result := bin part: 0 size: 3
    self assert: result equals: (Binary fromBytes: #(1, 2, 3))

  testPartToEnd =>
    bin := Binary fromBytes: #(1, 2, 3, 4, 5)
    result := bin part: 3 size: 2
    self assert: result equals: (Binary fromBytes: #(4, 5))

  testPartEmptySlice =>
    result := self.binBytes part: 0 size: 0
    self assert: result equals: (Binary fromBytes: #())

  testPartFullSlice =>
    result := self.binBytes part: 0 size: 3
    self assert: result equals: self.binBytes

  testPartOutOfBounds =>
    self should: [self.binBytes part: 0 size: 10] raise: #index_out_of_bounds

  testPartNegativeOffset =>
    self should: [self.binBytes part: -1 size: 1] raise: #index_out_of_bounds

  // ═══════════════════════════════════════════════════════════════════
  // concat: — binary concatenation (Binary-only, not overridden)
  // ═══════════════════════════════════════════════════════════════════
  testConcatTwoBinaries =>
    a := Binary fromBytes: #(1, 2)
    b := Binary fromBytes: #(3, 4)
    result := a concat: b
    self assert: result equals: (Binary fromBytes: #(1, 2, 3, 4))

  testConcatBinaryAndString =>
    // A String concatenates as its UTF-8 bytes; the result is a Binary
    bin := Binary fromBytes: #(104, 105)
    result := bin concat: "!"
    self assert: result class equals: Binary
    self assert: result equals: (Binary fromIolist: #("hi!"))

  testConcatWithEmptyBinary =>
    empty := Binary fromBytes: #()
    self assert: (self.binBytes concat: empty) equals: self.binBytes

  testConcatEmptyWithBinary =>
    empty := Binary fromBytes: #()
    self assert: (empty concat: self.binBytes) equals: self.binBytes

  // ═══════════════════════════════════════════════════════════════════
  // toBytes and fromBytes: roundtrip
  // ═══════════════════════════════════════════════════════════════════
  testToBytes =>
    bin := Binary fromBytes: #(104, 101, 108, 108, 111)
    self assert: bin toBytes equals: #(104, 101, 108, 108, 111)

  testToBytesEmpty =>
    bin := Binary fromBytes: #()
    self assert: bin toBytes equals: #()

  testToBytesFromBytesRoundtrip =>
    bytes := #(0, 127, 255, 42, 1)
    bin := Binary fromBytes: bytes
    self assert: bin toBytes equals: bytes

  testToBytesOnString =>
    self assert: "hello" toBytes equals: #(104, 101, 108, 108, 111)

  // ═══════════════════════════════════════════════════════════════════
  // asString — UTF-8 validation (BT-4169, BT-4173)
  // Answers `Result` uniformly: `ok:` the String on success, `error:`
  // with the byte offset on invalid UTF-8.
  // ═══════════════════════════════════════════════════════════════════
  testAsStringOnBinaryReturnsOkResult =>
    bin := Binary fromBytes: #(104, 101, 108, 108, 111)
    result := bin asString
    self assert: result class equals: Result
    self assert: result isOk
    self assert: result value equals: "hello"
    self assert: (result value class) equals: String

  testAsStringEmptyBinary =>
    bin := Binary fromBytes: #()
    result := bin asString
    self assert: result isOk
    self assert: result value equals: ""

  testAsStringInvalidUtf8IsErrorResult =>
    result := (Binary fromBytes: #(255, 254)) asString
    self assert: result class equals: Result
    self assert: result isError
    self deny: result isOk

  testAsStringInvalidUtf8ReportsOffset =>
    result := (Binary fromBytes: #(104, 101, 108, 108, 111, 255)) asString
    self assert: result isError
    self assert: (result error kind) equals: #parse_error
    // Pin the exact message: the offset is only reachable from Beamtalk
    // via message parsing until Exception exposes details (BT-4169 review)
    self assert: (result error message) equals: "Invalid UTF-8 at byte offset 5"

  testAsStringInvalidUtf8UnwrapRaises =>
    result := (Binary fromBytes: #(255, 254)) asString
    self should: [result unwrap] raise: #parse_error

  testAsStringInvalidUtf8ValueOr =>
    result := (Binary fromBytes: #(255, 254)) asString
    self assert: (result valueOr: "fallback") equals: "fallback"

  testPrintStringInvalidUtf8 =>
    // Pins the dispatch + render chain: BT-4169 rewired print_string/1
    // internals from as_string/1 to check_utf8/1
    self assert: (Binary fromBytes: #(255)) printString equals: "<<FF>>"

  // ═══════════════════════════════════════════════════════════════════
  // asStringUnchecked — no validation
  // ═══════════════════════════════════════════════════════════════════
  testAsStringUncheckedValidUtf8 =>
    bin := Binary fromBytes: #(104, 101, 108, 108, 111)
    result := bin asStringUnchecked
    self assert: result equals: "hello"

  testAsStringUncheckedEmpty =>
    bin := Binary fromBytes: #()
    result := bin asStringUnchecked
    self assert: result equals: ""

  // ═══════════════════════════════════════════════════════════════════
  // deserializeWithUsed: — ETF decode with byte count
  // ═══════════════════════════════════════════════════════════════════
  testDeserializeWithUsed =>
    bin := Binary serialize: 42
    result := Binary deserializeWithUsed: bin
    self assert: result size equals: 2
    self assert: (result at: 1) equals: 42
    self assert: (result at: 2) equals: bin size

  testDeserializeWithUsedString =>
    bin := Binary serialize: "hello"
    result := Binary deserializeWithUsed: bin
    self assert: (result at: 1) equals: "hello"
    self assert: (result at: 2) equals: bin size

  // testDeserializeWithUsedTypeError: removed — type checker now prevents
  // Binary deserializeWithUsed: 42 at compile time (BT-1828)

  // ═══════════════════════════════════════════════════════════════════
  // printString — display representation
  // At runtime, dispatches to String's printString (quoted string)
  // for valid UTF-8 binaries.
  // ═══════════════════════════════════════════════════════════════════
  testPrintStringValidUtf8 =>
    bin := Binary fromBytes: #(104, 105)
    result := bin printString
    self assert: result equals: """hi"""

  testPrintStringOnString =>
    result := "hello" printString
    self assert: result equals: """hello"""
