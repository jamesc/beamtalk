// BT-2880: match: arm with self-mutating multi-statement block returns
// internal state tuple instead of value. Verifies bumpMatch returns the
// mutated Integer (not an internal state-threading Tuple), and that the
// mutation is actually visible in subsequent state reads. Also covers the
// generalized shape — a match: arm whose body is itself a nested
// ifTrue:/ifFalse: mutation with no `[...] value` wrapper — and a match:
// with two adjacent arms that each mutate a different field.

TestCase subclass: NilTypeMatchSelfMutationActorTest

  testBumpMatchReturnsIntegerNotTuple =>
    a := NilTypeMatchSelfMutationRegistry spawn
    result := a bumpMatch
    self assert: result equals: 1
    self assert: a currentCount equals: 1

  testBumpMatchThreadsStateAcrossCalls =>
    a := NilTypeMatchSelfMutationRegistry spawn
    a bumpMatch
    a bumpMatch
    result := a bumpMatch
    self assert: result equals: 3
    self assert: a currentCount equals: 3

  testBumpMatchIfTrueReturnsIntegerNotTuple =>
    a := NilTypeMatchSelfMutationRegistry spawn
    result := a bumpMatchIfTrue: true
    self assert: result equals: 1
    self assert: a currentCount equals: 1

  testBumpMatchIfTrueThreadsStateAcrossCalls =>
    // count: 0 -> 1 -> 2 -> 1 (the last call passes false, taking the
    // ifFalse: branch, self.count := self.count - 1 = 1). The assignment's
    // value is what's returned, so `result` is that decremented count, not
    // the pre-decrement value.
    a := NilTypeMatchSelfMutationRegistry spawn
    a bumpMatchIfTrue: true
    a bumpMatchIfTrue: true
    result := a bumpMatchIfTrue: false
    self assert: result equals: 1
    self assert: a currentCount equals: 1

  testBumpEitherOfMutatesOnlyTheMatchingArmsField =>
    // Each arm must start from the same pre-match state: bumping the `2`
    // arm after two `1` bumps must not see (or leak into) the count the
    // `1` arm mutated, and vice versa.
    a := NilTypeMatchSelfMutationRegistry spawn
    r1 := a bumpEitherOf: 1
    r2 := a bumpEitherOf: 1
    r3 := a bumpEitherOf: 2
    self assert: r1 equals: 1
    self assert: r2 equals: 2
    self assert: r3 equals: 1
    self assert: a currentCount equals: 2
    self assert: a currentOtherCount equals: 1

  // --- BT-3489: bare `self.field := ...` arm bodies -------------------------
  testBumpBareThreadsMatchingArmMutation =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBare: 1) equals: 10
    self assert: a currentCount equals: 10

  testBumpBareThreadsWildcardArmMutation =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBare: 99) equals: 1
    self assert: a currentCount equals: 1

  testBumpBareAccumulatesAcrossCalls =>
    a := NilTypeMatchSelfMutationRegistry spawn
    a bumpBare: 1
    a bumpBare: 99
    self assert: (a bumpBare: 1) equals: 21
    self assert: a currentCount equals: 21

  testBumpBareEitherOfMutatesOnlyTheMatchingArmsField =>
    a := NilTypeMatchSelfMutationRegistry spawn
    a bumpBareEitherOf: 1
    a bumpBareEitherOf: 1
    self assert: (a bumpBareEitherOf: 2) equals: 3
    self assert: a currentCount equals: 2
    self assert: a currentOtherCount equals: 1

  testBumpBareUsingResultSeesBothValueAndMutation =>
    // The arm's assigned value (10) is the match's value, and the post-match
    // `self.count` read sees the same mutated 10 — so 20, not 10 or 0.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBareUsingResult: 1) equals: 20
    self assert: a currentCount equals: 10

  testBumpBareTypedThreadsTypePatternArmMutation =>
    // `Pattern::Type` arm -> generate_match_chain lowering, not the
    // all-native fast path the other bumpBare* tests exercise.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBareTyped: 5) equals: 5
    self assert: a currentCount equals: 5

  testBumpBareTypedThreadsWildcardArmMutation =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBareTyped: "not an integer") equals: 1
    self assert: a currentCount equals: 1

  testBumpBareInLoopAccumulatesOnePerIteration =>
    // i=1 takes the `1 ->` arm (+10), i=2..4 take the wildcard (+1 each): 13.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBareInLoop: 4) equals: 13
    self assert: a currentCount equals: 13

  testBumpBareNestedThreadsInnerArmMutation =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBareNested: 1) equals: 5
    self assert: a currentCount equals: 5

  testBumpBareNestedLeavesStateAloneOnNonMatchingArm =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpBareNested: 99) equals: 0
    self assert: a currentCount equals: 0

  // --- BT-3493: `self.field := ...` wrapped in a local assignment
  // (`r := (self.x := ...)`), reproduced with no `match:` involved at all
  // for the first two: a plain `ifTrue:ifFalse:` branch body and a counted
  // loop body. -------------------------------------------------------------
  testBumpWrappedIfTrueTakenBranchSeesFreshlyWrittenLocal =>
    // r := (self.count := 0 + 10) = 10; self.count := r + 1 = 11.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedIfTrue: true) equals: 11
    self assert: a currentCount equals: 11

  testBumpWrappedIfTrueNotTakenBranchMutatesIndependently =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedIfTrue: false) equals: -1
    self assert: a currentCount equals: -1

  testBumpWrappedIfTrueAccumulatesAcrossCalls =>
    a := NilTypeMatchSelfMutationRegistry spawn
    a bumpWrappedIfTrue: true
    result := a bumpWrappedIfTrue: true
    self assert: result equals: 22
    self assert: a currentCount equals: 22

  testBumpWrappedIfTrueReadAfterMergeSeesFieldWrittenValue =>
    // Claude Review follow-up: `r` is seeded (declared before the
    // conditional) and reassigned via the wrapped shape only in the taken
    // arm — the post-merge read must see 10 + 1 = 11, not the stale seeded
    // 0 + 1 = 1 a missing StateAcc `Put` in the C2z fast path would produce.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedIfTrueReadAfterMerge: true) equals: 11
    self assert: a currentCount equals: 10

  testBumpWrappedIfTrueReadAfterMergeNonTakenBranchUnaffected =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedIfTrueReadAfterMerge: false) equals: 6
    self assert: a currentCount equals: 0

  testBumpWrappedInLoopAccumulatesOnePerIteration =>
    // 1+2+3+4 = 10, written and re-read through the wrapped local each
    // iteration.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedInLoop: 4) equals: 10
    self assert: a currentCount equals: 10

  testBumpWrappedInLoopZeroIterationsLeavesStateAlone =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedInLoop: 0) equals: 0
    self assert: a currentCount equals: 0

  testBumpWrappedInLoopReadAfterLoopSeesLastIterationValue =>
    // i=1: count 0->1. i=2: count 1->3. i=3: count 3->6. r == 6 after the
    // loop, read from outside every iteration's own frame.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedInLoopReadAfterLoop: 3) equals: 6
    self assert: a currentCount equals: 6

  testBumpWrappedMatchThreadsMatchingArmMutation =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedMatch: 1) equals: 10
    self assert: a currentCount equals: 10

  testBumpWrappedMatchThreadsWildcardArmMutation =>
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedMatch: 99) equals: 1
    self assert: a currentCount equals: 1

  testBumpWrappedMatchAccumulatesAcrossCalls =>
    a := NilTypeMatchSelfMutationRegistry spawn
    a bumpWrappedMatch: 1
    a bumpWrappedMatch: 99
    result := a bumpWrappedMatch: 1
    self assert: result equals: 21
    self assert: a currentCount equals: 21

  testBumpWrappedIfTrueNestedLoopReadsCapturedLocal =>
    // count: 0 -> (r=10) -> 10 -> +10 -> 20 -> +10 -> 30.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedIfTrueNestedLoopReadsCapturedLocal: true) equals: 30
    self assert: a currentCount equals: 30

  testBumpWrappedInHybridLoopThreadsBothFieldAndOuterLocal =>
    // i=1: count 0->1, sum 0->1. i=2: count 1->3, sum 1->4.
    // i=3: count 3->6, sum 4->10.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedInHybridLoop: 3) equals: 10
    self assert: a currentCount equals: 6

  testBumpWrappedInDoAccumulatesOverList =>
    // x=1: count 0->1. x=2: count 1->3. x=3: count 3->6.
    a := NilTypeMatchSelfMutationRegistry spawn
    self assert: (a bumpWrappedInDo: #(1, 2, 3)) equals: 6
    self assert: a currentCount equals: 6
