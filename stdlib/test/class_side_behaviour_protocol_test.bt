// BT-4252: Behaviour-protocol selectors (`name`, `superclass`) sent to `self`
// or `super` from a class method answer what the external send to the class
// object answers. The class-method chain does not define them, so the runtime
// falls through to the class-object protocol (Class -> Behaviour -> ...), the
// same chain the type checker resolves them against.
//
// Fixtures: stdlib/test/fixtures/bt4252class_protocol_*.bt

TestCase subclass: ClassSideBehaviourProtocolTest

  testActorClassMethodSelfName =>
    self assert: Bt4252ClassProtocolActorChild selfName equals: Bt4252ClassProtocolActorChild name

  testActorClassMethodSuperName =>
    self assert: Bt4252ClassProtocolActorChild superName equals: #Bt4252ClassProtocolActorChild

  testActorClassMethodSelfSuperclass =>
    self assert: Bt4252ClassProtocolActorChild selfSuperclass equals: Bt4252ClassProtocolActorBase

  testActorClassMethodSuperSuperclass =>
    self assert: Bt4252ClassProtocolActorChild superSuperclass equals: Bt4252ClassProtocolActorBase

  testActorClassMethodSuperNameInClosure =>
    self assert: Bt4252ClassProtocolActorChild superNameInClosure equals: #(#Bt4252ClassProtocolActorChild)

  testActorInheritedClassMethodAnswersForReceiver =>
    self assert: Bt4252ClassProtocolActorChild inheritedSelfName equals: #Bt4252ClassProtocolActorChild
    self assert: Bt4252ClassProtocolActorChild inheritedSuperName equals: #Bt4252ClassProtocolActorChild

  testObjectClassMethodSelfName =>
    self assert: Bt4252ClassProtocolObjectChild selfName equals: Bt4252ClassProtocolObjectChild name

  testObjectClassMethodSuperName =>
    self assert: Bt4252ClassProtocolObjectChild superName equals: #Bt4252ClassProtocolObjectChild

  testObjectClassMethodSelfSuperclass =>
    self assert: Bt4252ClassProtocolObjectChild selfSuperclass equals: Bt4252ClassProtocolObjectBase

  testObjectClassMethodSuperSuperclass =>
    self assert: Bt4252ClassProtocolObjectChild superSuperclass equals: Bt4252ClassProtocolObjectBase

  testObjectClassMethodSuperNameInClosure =>
    self assert: Bt4252ClassProtocolObjectChild superNameInClosure equals: #(#Bt4252ClassProtocolObjectChild)

  testObjectInheritedClassMethodAnswersForReceiver =>
    self assert: Bt4252ClassProtocolObjectChild inheritedSelfName equals: #Bt4252ClassProtocolObjectChild
    self assert: Bt4252ClassProtocolObjectChild inheritedSuperName equals: #Bt4252ClassProtocolObjectChild

  testValueClassMethodSelfName =>
    self assert: Bt4252ClassProtocolValueChild selfName equals: Bt4252ClassProtocolValueChild name

  testValueClassMethodSuperName =>
    self assert: Bt4252ClassProtocolValueChild superName equals: #Bt4252ClassProtocolValueChild

  testValueClassMethodSelfSuperclass =>
    self assert: Bt4252ClassProtocolValueChild selfSuperclass equals: Bt4252ClassProtocolValueBase

  testValueClassMethodSuperSuperclass =>
    self assert: Bt4252ClassProtocolValueChild superSuperclass equals: Bt4252ClassProtocolValueBase

  testValueClassMethodSuperNameInClosure =>
    self assert: Bt4252ClassProtocolValueChild superNameInClosure equals: #(#Bt4252ClassProtocolValueChild)

  testValueInheritedClassMethodAnswersForReceiver =>
    self assert: Bt4252ClassProtocolValueChild inheritedSelfName equals: #Bt4252ClassProtocolValueChild
    self assert: Bt4252ClassProtocolValueChild inheritedSuperName equals: #Bt4252ClassProtocolValueChild

  testSealedDirectCalledClassMethodSelfName =>
    self assert: Bt4252ClassProtocolSealed selfName equals: Bt4252ClassProtocolSealed name

  testSealedDirectCalledClassMethodSuperName =>
    self assert: Bt4252ClassProtocolSealed superName equals: #Bt4252ClassProtocolSealed

  testSealedDirectCalledClassMethodSelfSuperclass =>
    self assert: Bt4252ClassProtocolSealed selfSuperclass equals: Bt4252ClassProtocolObjectBase

  testSealedDirectCalledClassMethodSuperSuperclass =>
    self assert: Bt4252ClassProtocolSealed superSuperclass equals: Bt4252ClassProtocolObjectBase

  testSealedDirectCalledClassMethodSuperNameInClosure =>
    self assert: Bt4252ClassProtocolSealed superNameInClosure equals: #(#Bt4252ClassProtocolSealed)

  // BT-4262: `doc` reads the class doc's published copy, so it answers from a
  // class method running in the class process, and from a block of it run
  // while the class waits on another class.
  testActorClassMethodSelfDocInClassProcess =>
    self assert: Bt4252ClassProtocolActorChild selfDoc equals: Bt4252ClassProtocolActorChild doc
    self assert: Bt4252ClassProtocolActorChild selfDoc equals: "The actor child of the BT-4252 class-protocol fixtures."

  testObjectClassMethodSelfDocInClassProcess =>
    self assert: Bt4252ClassProtocolObjectChild selfDoc equals: Bt4252ClassProtocolObjectChild doc
    self assert: Bt4252ClassProtocolObjectChild selfDoc equals: "The object child of the BT-4252 class-protocol fixtures."

  testActorClassMethodSelfDocAbroad =>
    self assert: Bt4252ClassProtocolActorChild selfDocAbroad equals: Bt4252ClassProtocolActorChild doc

  testObjectClassMethodSelfDocAbroad =>
    self assert: Bt4252ClassProtocolObjectChild selfDocAbroad equals: Bt4252ClassProtocolObjectChild doc

  // BT-4262: a Beamtalk-bodied protocol method that sends to its receiver.
  testActorClassMethodSelfPrintStringInClassProcess =>
    self assert: Bt4252ClassProtocolActorChild selfPrintString equals: Bt4252ClassProtocolActorChild printString

  testObjectClassMethodSelfPrintStringInClassProcess =>
    self assert: Bt4252ClassProtocolObjectChild selfPrintString equals: Bt4252ClassProtocolObjectChild printString

  // BT-4262: the `doc:` setter still messages the class process, which
  // cannot answer from inside one of its own class methods: a structured
  // `dispatch_error` naming the send, and the doc is unchanged.
  testActorClassMethodSelfSetDocInClassProcessRaisesDispatchError =>
    self should: [
      Bt4252ClassProtocolActorChild selfSetDoc
    ] raise: #dispatch_error
    selector := [
      Bt4252ClassProtocolActorChild selfSetDoc
    ] on: Exception do: [:e | e selector]
    self assert: selector equals: #doc:
    self assert: Bt4252ClassProtocolActorChild doc equals: "The actor child of the BT-4252 class-protocol fixtures."

  testObjectClassMethodSelfSetDocInClassProcessRaisesDispatchError =>
    self should: [
      Bt4252ClassProtocolObjectChild selfSetDoc
    ] raise: #dispatch_error

  // BT-4262: `doc` follows an external `doc:` (the published copy is written
  // by the setter).
  testSelfDocFollowsExternalSetter =>
    original := Bt4252ClassProtocolActorChild doc
    Bt4252ClassProtocolActorChild doc: "Set from outside"
    self assert: Bt4252ClassProtocolActorChild selfDoc equals: "Set from outside"
    Bt4252ClassProtocolActorChild doc: original
    self assert: Bt4252ClassProtocolActorChild selfDoc equals: original

  // BT-4262: by-name sends from inside the class process.
  testActorByNameProtocolSendInClassProcess =>
    self assert: Bt4252ClassProtocolActorChild byNamePrintString equals: Bt4252ClassProtocolActorChild printString

  testObjectByNameProtocolSendInClassProcess =>
    self assert: Bt4252ClassProtocolObjectChild byNamePrintString equals: Bt4252ClassProtocolObjectChild printString

  testActorByNameDefinedSelectorInClassProcessRaisesDispatchError =>
    self should: [
      Bt4252ClassProtocolActorChild byNameDefinedSelector
    ] raise: #dispatch_error

  testObjectByNameDefinedSelectorInClassProcessRaisesDispatchError =>
    self should: [
      Bt4252ClassProtocolObjectChild byNameDefinedSelector
    ] raise: #dispatch_error

  testActorByNameClassVarReflectionInClassProcessRaisesDispatchError =>
    self should: [
      Bt4252ClassProtocolActorChild byNameHasField
    ] raise: #dispatch_error

  // BT-4262: a primitive that changes the class is refused before any side
  // effect, and the class is still there.
  testRemoveFromSystemInClassProcessIsRefused =>
    // An instance of the class: removal stops the class's actors first, so a
    // refusal that came after that would leave it dead.
    instance := Bt4262RemoveGuard spawn
    self should: [Bt4262RemoveGuard removeSelf] raise: #dispatch_error
    self should: [Bt4262RemoveGuard removeByName] raise: #dispatch_error
    self should: [Bt4262RemoveGuard renameSelf] raise: #dispatch_error
    self assert: Bt4262RemoveGuard name equals: #Bt4262RemoveGuard
    self assert: instance isAlive
    instance stop

  testActorClassMethodSelfIncludesSelector =>
    self assert: Bt4252ClassProtocolActorChild selfIncludesFoo equals: (Bt4252ClassProtocolActorChild includesSelector: #foo)
    self assert: Bt4252ClassProtocolActorChild selfIncludesFoo
    self deny: Bt4252ClassProtocolActorChild selfIncludesBar

  testObjectClassMethodSelfIncludesSelector =>
    self assert: Bt4252ClassProtocolObjectChild selfIncludesFoo equals: (Bt4252ClassProtocolObjectChild includesSelector: #foo)
    self assert: Bt4252ClassProtocolObjectChild selfIncludesFoo
    self deny: Bt4252ClassProtocolObjectChild selfIncludesBar

  testSealedDirectCalledClassMethodSelfDoc =>
    self assert: Bt4252ClassProtocolSealed selfDoc equals: Bt4252ClassProtocolSealed doc
