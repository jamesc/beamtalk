// BT-3412: regression test for the cascade ClassVars-rebind scoping bug. See
// stdlib/test/fixtures/cascade_class_var_rebind.bt for the fixture and full
// context. This test compiling at all is itself most of the regression
// coverage (the bug was a load-time BEAM compile failure, "unbound variable
// 'ClassVarsN'"); the assertion additionally confirms both messages ran.

TestCase subclass: CascadeClassVarRebindTest

  testNonTailCascadeWithSelfSendArgCompilesInKeywordClassMethod =>
    log := CascadeClassVarRebindLog spawn
    CascadeClassVarRebind run: log
    self assert: log entries equals: #(#first, #second)
