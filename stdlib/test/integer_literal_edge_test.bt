// BT-5182: integer literals of any size (BEAM bignums) and character
// escapes that mean what the string escapes mean. Radix literals are covered
// in tests/repl-protocol/cases/literal_edge_cases.btscript, since `beamtalk
// fmt` still rewrites them to decimal (BT-5183).

TestCase subclass: IntegerLiteralEdgeTest

  testIntegerLiteralAboveI64 =>
    self assert: 9223372036854775808 equals: 9223372036854775807 + 1
    self assert: 100000000000000000000 printString equals: "100000000000000000000"
    self assert: 100000000000000000000 class equals: Integer

  testNegativeIntegerLiteralBelowI64 =>
    self assert: -9223372036854775809 equals: -9223372036854775808 - 1
    self assert: (-100000000000000000000 + 100000000000000000000) equals: 0

  testCharacterEscapesMatchStringEscapes =>
    self assert: $\0 equals: 0
    self assert: $" equals: 34
    self assert: $\\ equals: 92
    self assert: ($\0 asString) equals: "\0"
    self assert: ($" asString) equals: """"
