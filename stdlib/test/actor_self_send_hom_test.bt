// BT-3580: a block passed to a user-defined higher-order method THROUGH an
// actor self-send lost both `^` (non-local return) and captured-local
// mutation — `safe_dispatch/3`'s catch-all had no NLR exclusion, so the
// throw was misclassified as an ordinary runtime_error before it could
// reach the defining method's own NLR catch. See
// `fixtures/self_send_hom_pool.bt` for the reproduction (mirrors the
// issue's `Pool`/`detect:ifNone:`/`size` shapes) and
// `fixtures/self_send_hom_sackful.bt` for the already-working
// Value-class twin.
//
// The `^` half is fixed (below). The captured-local-write half (`size`,
// via `inject:into:`) was threaded by the ADR 0128 fold (BT-3583); since ADR
// 0133 (BT-3908) a block that assigns a captured local and is passed to an
// actor self-send of `do:` is an escaping-block compile error instead.
//
// testDoInvokedCrossProcessRelaysNlr covers a second, distinct gap the
// self-send fix alone didn't close: `^` inside a block passed to
// `SelfSendHomPool>>do:` from a genuinely DIFFERENT process (no self-send
// hop at all — `do:`'s own body, `self.items do: block`, is the outermost
// dispatch for this call). That block's NLR escapes `do:`'s `dispatch/4`
// clause uncaught (it isn't `do:`'s own `^`) straight into the compiled
// module's `safe_dispatch/3`, the boundary every compiled actor's
// generated `handle_call/3` calls for *every* incoming message — a
// different, more fundamental catch site than the self-dispatch one.

TestCase subclass: ActorSelfSendHomTest

  testDetectIfNoneReturnsMatchViaNlrThroughSelfSendHom =>
    pool := SelfSendHomPool spawn
    result := pool detect: [:x | x > 2] ifNone: [0]
    self assert: result equals: 3

  testDetectIfNoneFallsBackToNoneBlockWhenNoMatch =>
    pool := SelfSendHomPool spawn
    result := pool detect: [:x | x > 100] ifNone: [42]
    self assert: result equals: 42

  testDoInvokedCrossProcessRelaysNlr =>
    pool := SelfSendHomPool spawn
    result := self firstGreaterThanTwoIn: pool
    self assert: result equals: 3

  // Helper: `^x` targets THIS method's own frame, not `do:`'s. `pool` is a
  // different actor process, and `do:`'s body invokes `block` directly
  // (no self-send hop) — the outermost, most common dispatch boundary.
  firstGreaterThanTwoIn: pool =>
    pool do: [:x | x > 2 ifTrue: [^x]]
    0

  // ADR 0128 / BT-3583 Constraints regression (a): a pure (Tier 1) opaque
  // callable forwarded to `collect:`/`select:` — `pool` is a different
  // actor process (no self-send), so the block is a genuine, non-mutating
  // arity-1 closure. Must keep compiling and behaving identically after
  // the fold-based rewrite.
  testPureOpaqueCallableCollectAndSelect =>
    pool := SelfSendHomPool spawn
    self assert: (pool collect: [:x | x * 2]) equals: #(2, 4, 6, 8)
    self assert: (pool select: [:x | x > 2]) equals: #(3, 4)

  // PIN-BUG (BT-3922): a block that mutates ONLY `self.field`, passed
  // through a self-send to `do:`, which forwards it to `self.items do:`. The
  // ADR 0128 fold threaded the write; since ADR 0133 removed it (BT-3908) the
  // write cannot be kept, so it raises rather than drop it. BT-3922 makes
  // the shape a compile error, and this test and `accumulateTotal` go.
  testFieldOnlyMutationOpaqueCallableThroughSelfSendDo =>
    pool := SelfSendHomPool spawn
    self should: [pool accumulateTotal] raise: #stateful_block_dispatch

  // PIN-BUG (BT-3936, BT-3922): a block that assigns nothing, but whose
  // self-send (`record:`) changes a field, passed through `self do:` to a
  // `do:` whose parameter is a promoted Tier 2 position (case B). The ADR
  // 0128 fold kept the change (answer 10); since BT-3908 it raises rather
  // than drop it. A fix for BT-3936 flips this to `equals: 10`.
  testSelfSendStateChangeThroughSelfSendDo =>
    pool := SelfSendHomPool spawn
    self should: [pool recordAll] raise: #stateful_block_dispatch

  // PIN-BUG (BT-3936): the same block where `do:`'s parameter is not
  // promoted (case A): the block is a plain closure, so the self-send's
  // change is dropped silently and the answer is 0, not 6 (as on main
  // before BT-3908). A fix for BT-3936 flips this to `equals: 6`.
  testSelfSendStateChangeThroughPlainSelfSendDoPinBug =>
    pool := SelfSendHomPlainPool spawn
    self assert: pool recordAll equals: 0

  // ADR 0128 / BT-3583 regression (review-flagged on PR #4030): a class
  // method (no `State`/`StateAcc` parameter — see
  // `SelfSendHomPool>>classCollect:`'s doc comment) forwarding an opaque
  // callable to `collect:`. Must not crash on an unbound `State` reference.
  testClassMethodOpaqueCallableCollectDoesNotCrash =>
    result := SelfSendHomPool classCollect: [:x | x * 2]
    self assert: result equals: #(2, 4, 6)

  testValueClassTwinDetectIfNoneReturnsMatch =>
    sackful := SelfSendHomSackful new
    result := sackful detect: [:x | x > 2] ifNone: [0]
    self assert: result equals: 3

  testValueClassTwinSize =>
    sackful := SelfSendHomSackful new
    self assert: sackful size equals: 4

  // ADR 0128 / BT-3583 regression (review-flagged on PR #4030): a
  // `ValueType` loop already needing local-mutation threading, whose
  // loop body ALSO forwards an opaque callable to `do:` — see
  // `sumWithSideEffect:`'s doc comment in `self_send_hom_sackful.bt` for
  // why this specifically exercises the `!ValueType` gate on the new
  // `control_flow_has_mutations` check.
  testValueTypeLoopWithNestedOpaqueCallableDoesNotCrash =>
    sackful := SelfSendHomSackful new
    result := sackful sumWithSideEffect: [:x | x]
    self assert: result equals: 6

  // ── BT-3615: ADR 0128 extended to the remaining collection HOMs ──────────
  // `fixtures/self_send_hom_fold_pool.bt` forwards an opaque block across a
  // self-send to each operator. Its Tier 2 callers (a block that assigns a
  // captured local through the self-send) are ADR 0133 escaping-block compile
  // errors since BT-3902; the pure callables below remain.
  //
  // Pure (Tier 1) opaque callables from another process — the common case
  // that worked before and must keep working, with the right result type.
  testPureOpaqueCallableRemainingOperators =>
    pool := SelfSendHomFoldPool spawn
    self assert: (pool fwdInject: 0 into: [:a :b | a + b]) equals: 10
    self assert: (pool fwdDetect: [:x | x > 2]) equals: 3
    self assert: (pool fwdDetect: [:x | x > 20] ifNone: [7]) equals: 7
    self assert: (pool fwdCount: [:x | x > 2]) equals: 2
    self assert: (pool fwdAnySatisfy: [:x | x > 3]) equals: true
    self assert: (pool fwdAllSatisfy: [:x | x > 3]) equals: false
    self assert: (pool setCollect: [:x | x * 2]) class equals: Set
    self assert: (pool setSelect: [:x | x > 2]) class equals: Set
    self assert: (pool arrCollect: [:x | x * 2]) class equals: Array

  testOpaqueDetectRaisesNotFound =>
    pool := SelfSendHomFoldPool spawn
    self should: [pool fwdDetect: [:x | x > 100]] raise: #not_found

  testOpaqueFoldInExpressionPositionUnwrapsResult =>
    pool := SelfSendHomFoldPool spawn
    self assert: (pool nestedCollectSize: [:x | x]) equals: 4
    self assert: (pool nestedInjectPlusOne: [:a :b | a + b]) equals: 11
    self assert: (pool nestedAnyAnswer: [:x | x > 3]) equals: "yes"

  testOpaqueFoldInConditionalArmAndLoopBody =>
    pool := SelfSendHomFoldPool spawn
    self assert: (pool doWhen: true with: [:x | x]) equals: nil
    self assert: (pool injectTwice: [:a :b | a + b]) equals: 20
    self assert: (pool countUpWhile: [:x | x > 2]) equals: 2
