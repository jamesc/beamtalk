// BT-3140/BT-3150/BT-3168: Runs BT-3140's and BT-3150's repros end to end —
// a direct class-var field write, and a same-class self-send that mutates a
// class var, each inside a whileTrue:/timesRepeat:/to:do: loop body with a
// co-occurring local-variable mutation. Before BT-3168 (ADR 0111 Addendum 9)
// both shapes were rejected at compile time; now they compile AND correctly
// accumulate the class var's mutation across every iteration (not just once,
// and not silently stuck at 0 — the exact failure mode BT-3140/BT-3150
// investigated).

TestCase subclass: LoopClassVarMutationTest

  setUp =>
    LoopClassVarMutation resetRuns
    self

  testFieldAssignmentInWhileLoopAccumulates =>
    self assert: (LoopClassVarMutation countUpTo: 5) equals: 5
    self assert: LoopClassVarMutation runs equals: 5

  testFieldAssignmentInTimesRepeatAccumulates =>
    self assert: (LoopClassVarMutation bumpTimes: 4) equals: 4
    self assert: LoopClassVarMutation runs equals: 4

  testFieldAssignmentInToDoAccumulates =>
    self assert: (LoopClassVarMutation bumpUpTo: 6) equals: 6
    self assert: LoopClassVarMutation runs equals: 6

  testFieldAssignmentAccumulatesAcrossCalls =>
    // Not just correct within one call — the mutation is visible to a later
    // call too (ADR 0110's own persistence guarantee), and picks up where
    // the previous call left off.
    self assert: (LoopClassVarMutation countUpTo: 3) equals: 3
    self assert: (LoopClassVarMutation countUpTo: 2) equals: 5
    self assert: LoopClassVarMutation runs equals: 5

  testSelfSendInWhileLoopAccumulates =>
    self assert: (LoopClassVarMutation bumpViaSelfSendUpTo: 5) equals: 5
    self assert: LoopClassVarMutation runs equals: 5

  testSelfSendInTimesRepeatAccumulates =>
    self assert: (LoopClassVarMutation bumpViaSelfSendTimes: 4) equals: 4
    self assert: LoopClassVarMutation runs equals: 4

  testSelfSendInToDoAccumulates =>
    self assert: (LoopClassVarMutation bumpViaSelfSendToDo: 6) equals: 6
    self assert: LoopClassVarMutation runs equals: 6

  testZeroIterationsLeavesClassVarUnchanged =>
    // The loop body never runs — the class var must stay at its pre-call
    // value (not spuriously bumped, and not left in some half-threaded
    // state by the new ClassVars fun parameter).
    self assert: (LoopClassVarMutation countUpTo: 0) equals: 0
    self assert: LoopClassVarMutation runs equals: 0
    self assert: (LoopClassVarMutation bumpViaSelfSendUpTo: 0) equals: 0
    self assert: LoopClassVarMutation runs equals: 0
