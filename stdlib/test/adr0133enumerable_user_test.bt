// BT-3903 / BT-3916 (ADR 0133): what a user collection does with a block that
// assigns a captured local, when the iteration messages come from a trait
// (`uses:`) on top of the class's own `do:`. A block literal that writes,
// sent with one of the compiler-known collection messages
// (`state_threading_selectors.rs`), is lowered in place at the call site as a
// fold over the receiver's `do:` (`beamtalk_collection:to_list/1`). `do:`
// itself is always folded in place. For every other selector the call site
// first asks the receiver's class who answers it
// (`beamtalk_collection:to_list_for_threading/2`): the stdlib's own method is
// the fold over `do:`, so the write threads (`Ets`, the stdlib collections);
// a method from outside the stdlib (the class's own override, or a provision
// of a package-local trait; a provision of a stdlib trait such as `Enumerable`
// counts as the stdlib's, by origin, not by the module it is flattened into)
// would be bypassed by the fold, so the send raises
// `stateful_block_dispatch`, and a receiver that does not respond to the
// selector raises `does_not_understand`, as the pure path does. Never a
// dropped write and never a silent wrong answer. (A block laundered through
// Erlang FFI is outside this decision, BT-3917.)
//
// Fixtures: fixtures/adr0133enumerable_{walkable,forwarding,hand_walk,own_any,
// object_own_any,actor_own_any,own_each,own_inject,own_select,ext_inject,ext_plain,ext_with_all,own_species,own_with_all,stdlib,stdlib_actor,stdlib_own_any,user}.bt. `Ets` is the stdlib's own
// `uses: Enumerable(V)` class; `Adr0133EnumerableStdlib` is a user class that
// `uses:` the same stdlib `Enumerable` (BT-3915), whose provisions forward to
// `elements` rather than walking with `self do:`.

TestCase subclass: Adr0133EnumerableUserTest

  forwarding => Adr0133EnumerableForwarding new: #{#items => #(1, 2, 3)}

  handWalk => Adr0133EnumerableHandWalk new: #{#items => #(1, 2, 3)}

  ownAny => Adr0133EnumerableOwnAny new: #{#items => #(1, 2, 3)}

  stdlibBag => Adr0133EnumerableStdlib new: #{#items => #(1, 2, 3)}

  // An `Ets` ordered by key, so its values snapshot is #(1, 2, 3).
  withEts: aBlock =>
    table := Ets new: #adr0133EnumerableUser type: #orderedSet
    [
      table at: 1 put: 1
      table at: 2 put: 2
      table at: 3 put: 3
      aBlock value: table
    ] ensure: [table delete]

  // --- `do:` forwarding to the inner List ---
  testForwardingDoWrite =>
    self assert: (Adr0133EnumerableUser doWrite: self forwarding) equals: 6

  testForwardingInjectWrite =>
    self should: [
      Adr0133EnumerableUser injectWrite: self forwarding
    ] raise: #stateful_block_dispatch

  testForwardingCollectWrite =>
    self should: [
      Adr0133EnumerableUser collectWrite: self forwarding
    ] raise: #stateful_block_dispatch

  testForwardingSelectWrite =>
    self should: [
      Adr0133EnumerableUser selectWrite: self forwarding
    ] raise: #stateful_block_dispatch

  testForwardingDetectWrite =>
    self should: [
      Adr0133EnumerableUser detectWrite: self forwarding
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser detectNoneWrite: self forwarding
    ] raise: #stateful_block_dispatch

  testForwardingAnySatisfyWrite =>
    self should: [
      Adr0133EnumerableUser anySatisfyWrite: self forwarding
    ] raise: #stateful_block_dispatch

  testForwardingPure =>
    self assert: (Adr0133EnumerableUser injectPure: self forwarding) equals: 6
    self assert: (Adr0133EnumerableUser collectPure: self forwarding) equals: #(10, 20, 30)
    self assert: (Adr0133EnumerableUser selectPure: self forwarding) equals: #(2, 3)
    self assert: (Adr0133EnumerableUser detectPure: self forwarding) equals: 2
    self assert: (Adr0133EnumerableUser detectNonePure: self forwarding) equals: #none
    self assert: (Adr0133EnumerableUser anySatisfyPure: self forwarding)

  // --- `do:` by hand (a `whileTrue:` over an index) ---
  testHandWalkDoWrite =>
    self assert: (Adr0133EnumerableUser doWrite: self handWalk) equals: 6

  testHandWalkInjectWrite =>
    self should: [
      Adr0133EnumerableUser injectWrite: self handWalk
    ] raise: #stateful_block_dispatch

  testHandWalkCollectWrite =>
    self should: [
      Adr0133EnumerableUser collectWrite: self handWalk
    ] raise: #stateful_block_dispatch

  testHandWalkSelectWrite =>
    self should: [
      Adr0133EnumerableUser selectWrite: self handWalk
    ] raise: #stateful_block_dispatch

  testHandWalkDetectWrite =>
    self should: [
      Adr0133EnumerableUser detectWrite: self handWalk
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser detectNoneWrite: self handWalk
    ] raise: #stateful_block_dispatch

  testHandWalkAnySatisfyWrite =>
    self should: [
      Adr0133EnumerableUser anySatisfyWrite: self handWalk
    ] raise: #stateful_block_dispatch

  testHandWalkPure =>
    self assert: (Adr0133EnumerableUser injectPure: self handWalk) equals: 6
    self assert: (Adr0133EnumerableUser collectPure: self handWalk) equals: #(10, 20, 30)
    self assert: (Adr0133EnumerableUser selectPure: self handWalk) equals: #(2, 3)
    self assert: (Adr0133EnumerableUser detectPure: self handWalk) equals: 2
    self assert: (Adr0133EnumerableUser detectNonePure: self handWalk) equals: #none
    self assert: (Adr0133EnumerableUser anySatisfyPure: self handWalk)

  // --- A user class `uses: Enumerable(Integer)` from the stdlib ---
  testStdlibEnumerableWrite =>
    self assert: (Adr0133EnumerableUser doWrite: self stdlibBag) equals: 6
    self assert: (Adr0133EnumerableUser injectWrite: self stdlibBag) equals: #[6, 3]
    self assert: (Adr0133EnumerableUser collectWrite: self stdlibBag) equals: #[#(10, 20, 30), 3]
    self assert: (Adr0133EnumerableUser selectWrite: self stdlibBag) equals: #[#(2, 3), 3]
    self assert: (Adr0133EnumerableUser detectWrite: self stdlibBag) equals: #[2, 2]
    self assert: (Adr0133EnumerableUser detectNoneWrite: self stdlibBag) equals: #[#none, 3]
    self assert: (Adr0133EnumerableUser anySatisfyWrite: self stdlibBag) equals: #[true, 3]

  testStdlibEnumerablePure =>
    self assert: (Adr0133EnumerableUser injectPure: self stdlibBag) equals: 6
    self assert: (Adr0133EnumerableUser collectPure: self stdlibBag) equals: #(10, 20, 30)
    self assert: (Adr0133EnumerableUser selectPure: self stdlibBag) equals: #(2, 3)
    self assert: (Adr0133EnumerableUser detectPure: self stdlibBag) equals: 2
    self assert: (Adr0133EnumerableUser detectNonePure: self stdlibBag) equals: #none
    self assert: (Adr0133EnumerableUser anySatisfyPure: self stdlibBag)

  // BT-3916: `uses:` flattens the stdlib's provisions into this class's own
  // module, so the guard classifies by the method's origin (the stdlib
  // protocol), not its module: the same writing blocks fold for an actor ...
  testStdlibEnumerableActorWrite =>
    a := Adr0133EnumerableStdlibActor spawnWith: #{#items => #(1, 2, 3)}
    [
      self assert: (Adr0133EnumerableUser doWrite: a) equals: 6
      self assert: (Adr0133EnumerableUser injectWrite: a) equals: #[6, 3]
      self assert: (Adr0133EnumerableUser collectWrite: a) equals: #[#(10, 20, 30), 3]
      self assert: (Adr0133EnumerableUser selectWrite: a) equals: #[#(2, 3), 3]
      self assert: (Adr0133EnumerableUser detectWrite: a) equals: #[2, 2]
      self assert: (Adr0133EnumerableUser detectNoneWrite: a) equals: #[#none, 3]
      self assert: (Adr0133EnumerableUser anySatisfyWrite: a) equals: #[true, 3]
    ] ensure: [a stop]

  // --- BT-3916: the stdlib's own methods run through overridable self-sends ---
  // The stdlib's `collect:`, `select:`, `count:`, `eachWithIndex:` and
  // `do:separatedBy:` are `self inject:into:`, and `reject:` is `self select:`.
  // So a class that defines any collection message outside the stdlib makes the
  // fold over `do:` differ from the pure send: every writing send is refused
  // (`eachWithIndex:` / `do:separatedBy:` are lowered through a synthetic
  // `inject:into:`, but the guard asks about the selector the user sent).
  testOwnEachWithIndexRaises =>
    c := Adr0133EnumerableOwnEach new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser eachWithIndexWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser separatedByWrite: c
    ] raise: #stateful_block_dispatch

  testOwnInjectRefusesEverythingThatRunsThroughIt =>
    c := Adr0133EnumerableOwnInject new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser injectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser eachWithIndexWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser separatedByWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser collectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser selectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser countWrite: c
    ] raise: #stateful_block_dispatch
    // `do:` is the fold's own source and is never refused.
    self assert: (Adr0133EnumerableUser doWrite: c) equals: 6

  testOwnSelectRefusesReject =>
    c := Adr0133EnumerableOwnSelect new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser selectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser rejectWrite: c
    ] raise: #stateful_block_dispatch

  // `uses: Enumerable` with no override of its own folds every message it
  // provides (`size`, `isEmpty`, ... are not collection messages).
  testStdlibEnumerableCountWrite =>
    self assert: (Adr0133EnumerableUser countWrite: self stdlibBag) equals: #[2, 3]

  // ... and the class's own method wins over the stdlib provision, so it is
  // refused, and so is every other writing send, since its class now defines a
  // collection message outside the stdlib.
  testStdlibEnumerableOwnAnySatisfy =>
    c := Adr0133EnumerableStdlibOwnAny new: #{#items => #(1, 2, 3)}
    self deny: (Adr0133EnumerableUser anySatisfyPure: c)
    self should: [
      Adr0133EnumerableUser anySatisfyWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser injectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser collectWrite: c
    ] raise: #stateful_block_dispatch
    self assert: (Adr0133EnumerableUser doWrite: c) equals: 6

  // --- BT-3951: a runtime extension, or `species`, the pure send runs through ---
  // The compile-time flag cannot see an extension registered at run time, so the
  // guard also asks the extension registry for every class on the chain.
  testExtensionInjectRefusesCollectWrite =>
    c := Adr0133EnumerableExtInject new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser collectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser selectWrite: c
    ] raise: #stateful_block_dispatch
    self assert: (Adr0133EnumerableUser doWrite: c) equals: 6

  // An extension that is not a collection message changes nothing.
  testNonCollectionExtensionStillFolds =>
    c := Adr0133EnumerableExtPlain new: #{#items => #(1, 2, 3)}
    self assert: c bt3951Harmless equals: #harmless
    self assert: (Adr0133EnumerableUser collectWrite: c) equals: #[#(10, 20, 30), 3]
    self assert: (Adr0133EnumerableUser selectWrite: c) equals: #[#(2, 3), 3]

  // `species` defaults to `self class`, so a collection usually overrides the
  // class-side `withAll:` the stdlib's `collect:`/`select:` end in.
  testOwnClassSideWithAllRefusesCollectWrite =>
    c := Adr0133EnumerableOwnWithAll new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser collectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser selectWrite: c
    ] raise: #stateful_block_dispatch
    self assert: (Adr0133EnumerableUser doWrite: c) equals: 6

  testExtensionClassSideWithAllRefusesCollectWrite =>
    c := Adr0133EnumerableExtWithAll new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser collectWrite: c
    ] raise: #stateful_block_dispatch

  testOwnSpeciesRefusesCollectWrite =>
    c := Adr0133EnumerableOwnSpecies new: #{#items => #(1, 2, 3)}
    self should: [
      Adr0133EnumerableUser collectWrite: c
    ] raise: #stateful_block_dispatch
    self should: [
      Adr0133EnumerableUser selectWrite: c
    ] raise: #stateful_block_dispatch

  // --- The stdlib's own `uses: Enumerable(V)` (`Ets`) ---
  testEtsWrite =>
    self
      withEts: [:t |
        self assert: (Adr0133EnumerableUser doWrite: t) equals: 6
        self assert: (Adr0133EnumerableUser injectWrite: t) equals: #[6, 3]
        self assert: (Adr0133EnumerableUser collectWrite: t) equals: #[#(10, 20, 30), 3]
        self assert: (Adr0133EnumerableUser selectWrite: t) equals: #[#(2, 3), 3]
        self assert: (Adr0133EnumerableUser detectWrite: t) equals: #[2, 2]
        self assert: (Adr0133EnumerableUser detectNoneWrite: t) equals: #[#none, 3]
        self assert: (Adr0133EnumerableUser anySatisfyWrite: t) equals: #[true, 3]
      ]

  testEtsPure =>
    self
      withEts: [:t |
        self assert: (Adr0133EnumerableUser injectPure: t) equals: 6
        self assert: (Adr0133EnumerableUser collectPure: t) equals: #(10, 20, 30)
        self assert: (Adr0133EnumerableUser selectPure: t) equals: #(2, 3)
        self assert: (Adr0133EnumerableUser detectPure: t) equals: 2
        self assert: (Adr0133EnumerableUser detectNonePure: t) equals: #none
        self assert: (Adr0133EnumerableUser anySatisfyPure: t)
      ]

  // --- An actor with only `do:`, from another process ---
  // `do:` folds over the actor's own `do:`. The other messages are not
  // defined by the actor or the stdlib's `Actor`, so the guard answers
  // `does_not_understand`, as the pure send would.
  testActorWrite =>
    a := Adr0133EnumerableActor spawnWith: #{#items => #(1, 2, 3)}
    [
      self assert: (Adr0133EnumerableUser doWrite: a) equals: 6
      self should: [
        Adr0133EnumerableUser injectWrite: a
      ] raise: #does_not_understand
      self should: [
        Adr0133EnumerableUser collectWrite: a
      ] raise: #does_not_understand
      self should: [
        Adr0133EnumerableUser selectWrite: a
      ] raise: #does_not_understand
      self should: [
        Adr0133EnumerableUser detectWrite: a
      ] raise: #does_not_understand
      self should: [
        Adr0133EnumerableUser anySatisfyWrite: a
      ] raise: #does_not_understand
    ] ensure: [a stop]

  // BT-3918: inside the actor's own method, `self do:` with a writing block
  // is an escaping-block compile error since BT-3908
  // (`adr0133_actor_self_send_of_a_collection_message_is_an_escaping_block`).

  // --- BT-3843 / BT-3916: the class's own `anySatisfy:` ---
  testOwnAnySatisfyPure =>
    // The class's own method runs: it looks only at the first element.
    self deny: (Adr0133EnumerableUser anySatisfyPure: self ownAny)

  testOwnAnySatisfyWriteRaises =>
    // With a writing block the message would be the fold over the receiver's
    // `do:`, which bypasses the class's own `anySatisfy:` (it answers a
    // different thing), so the send is refused instead.
    self should: [
      Adr0133EnumerableUser anySatisfyWrite: self ownAny
    ] raise: #stateful_block_dispatch

  // The same refusal for a class object (class-side methods) and for an actor with its
  // own `anySatisfy:` (value, class and actor receivers).
  testClassOwnAnySatisfy =>
    self deny: (Adr0133EnumerableUser anySatisfyPure: Adr0133EnumerableObjectOwnAny)
    self should: [
      Adr0133EnumerableUser anySatisfyWrite: Adr0133EnumerableObjectOwnAny
    ] raise: #stateful_block_dispatch

  testActorOwnAnySatisfy =>
    a := Adr0133EnumerableActorOwnAny spawnWith: #{#items => #(1, 2, 3)}
    [
      self deny: (Adr0133EnumerableUser anySatisfyPure: a)
      self should: [
        Adr0133EnumerableUser anySatisfyWrite: a
      ] raise: #stateful_block_dispatch
      self assert: (Adr0133EnumerableUser doWrite: a) equals: 6
    ] ensure: [a stop]

Adr0133EnumerableExtInject >> inject: initial :: Object into: _block :: Block(Object, Object, Object) -> Object =>
  initial

Adr0133EnumerableExtPlain >> bt3951Harmless => #harmless

Adr0133EnumerableExtWithAll class >> withAll: list :: List -> List => list
