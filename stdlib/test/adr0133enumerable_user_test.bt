// BT-3903 (ADR 0133 Phase 1): what a user collection does with a block that
// assigns a captured local, when the iteration messages come from a trait
// (`uses:`) on top of the class's own `do:`. The decision is "honour": a
// block literal that writes, sent with one of the compiler-known collection
// messages (`state_threading_selectors.rs`), is lowered in place at the call
// site as a fold over the receiver's `do:` (`beamtalk_collection:to_list/1`),
// so the write threads whatever the receiver's class, whether its `do:`
// forwards to a stdlib collection or walks by hand. The trait's provisions
// themselves need no gate of their own: inside a provision, `self do:` with
// a writing block is the same in-place fold. Never a dropped write. (A block
// laundered through Erlang FFI is outside this decision, BT-3917.)
//
// Fixtures: fixtures/adr0133enumerable_{walkable,forwarding,hand_walk,own_any,
// stdlib,user}.bt. `Ets` is the stdlib's own `uses: Enumerable(V)` class;
// `Adr0133EnumerableStdlib` is a user class that `uses:` the same stdlib
// `Enumerable` (BT-3915), whose provisions forward to `elements` rather than
// walking with `self do:`.

TestCase subclass: Adr0133EnumerableUserTest

  forwarding => Adr0133EnumerableForwarding new: #{#items => #(1, 2, 3)}

  handWalk => Adr0133EnumerableHandWalk new: #{#items => #(1, 2, 3)}

  ownAny => Adr0133EnumerableOwnAny new: #{#items => #(1, 2, 3)}

  stdlibBag => Adr0133EnumerableStdlib new: #{#items => #(1, 2, 3)}

  // An `Ets` ordered by key, so its values snapshot is #(1, 2, 3).
  withEts: aBlock =>
    table := Ets new: #adr0133EnumerableUser type: #orderedSet
    [
      table at: 1 put: 1
      table at: 2 put: 2
      table at: 3 put: 3
      aBlock value: table
    ] ensure: [table delete]

  // --- `do:` forwarding to the inner List ---
  testForwardingDoWrite =>
    self assert: (Adr0133EnumerableUser doWrite: self forwarding) equals: 6

  testForwardingInjectWrite =>
    self assert: (Adr0133EnumerableUser injectWrite: self forwarding) equals: #[6, 3]

  testForwardingCollectWrite =>
    self assert: (Adr0133EnumerableUser collectWrite: self forwarding) equals: #[#(10, 20, 30), 3]

  testForwardingSelectWrite =>
    self assert: (Adr0133EnumerableUser selectWrite: self forwarding) equals: #[#(2, 3), 3]

  testForwardingDetectWrite =>
    self assert: (Adr0133EnumerableUser detectWrite: self forwarding) equals: #[2, 2]
    self assert: (Adr0133EnumerableUser detectNoneWrite: self forwarding) equals: #[#none, 3]

  testForwardingAnySatisfyWrite =>
    self assert: (Adr0133EnumerableUser anySatisfyWrite: self forwarding) equals: #[true, 3]

  testForwardingPure =>
    self assert: (Adr0133EnumerableUser injectPure: self forwarding) equals: 6
    self assert: (Adr0133EnumerableUser collectPure: self forwarding) equals: #(10, 20, 30)
    self assert: (Adr0133EnumerableUser selectPure: self forwarding) equals: #(2, 3)
    self assert: (Adr0133EnumerableUser detectPure: self forwarding) equals: 2
    self assert: (Adr0133EnumerableUser detectNonePure: self forwarding) equals: #none
    self assert: (Adr0133EnumerableUser anySatisfyPure: self forwarding)

  // --- `do:` by hand (a `whileTrue:` over an index) ---
  testHandWalkDoWrite =>
    self assert: (Adr0133EnumerableUser doWrite: self handWalk) equals: 6

  testHandWalkInjectWrite =>
    self assert: (Adr0133EnumerableUser injectWrite: self handWalk) equals: #[6, 3]

  testHandWalkCollectWrite =>
    self assert: (Adr0133EnumerableUser collectWrite: self handWalk) equals: #[#(10, 20, 30), 3]

  testHandWalkSelectWrite =>
    self assert: (Adr0133EnumerableUser selectWrite: self handWalk) equals: #[#(2, 3), 3]

  testHandWalkDetectWrite =>
    self assert: (Adr0133EnumerableUser detectWrite: self handWalk) equals: #[2, 2]
    self assert: (Adr0133EnumerableUser detectNoneWrite: self handWalk) equals: #[#none, 3]

  testHandWalkAnySatisfyWrite =>
    self assert: (Adr0133EnumerableUser anySatisfyWrite: self handWalk) equals: #[true, 3]

  testHandWalkPure =>
    self assert: (Adr0133EnumerableUser injectPure: self handWalk) equals: 6
    self assert: (Adr0133EnumerableUser collectPure: self handWalk) equals: #(10, 20, 30)
    self assert: (Adr0133EnumerableUser selectPure: self handWalk) equals: #(2, 3)
    self assert: (Adr0133EnumerableUser detectPure: self handWalk) equals: 2
    self assert: (Adr0133EnumerableUser detectNonePure: self handWalk) equals: #none
    self assert: (Adr0133EnumerableUser anySatisfyPure: self handWalk)

  // --- A user class `uses: Enumerable(Integer)` from the stdlib ---
  testStdlibEnumerableWrite =>
    self assert: (Adr0133EnumerableUser doWrite: self stdlibBag) equals: 6
    self assert: (Adr0133EnumerableUser injectWrite: self stdlibBag) equals: #[6, 3]
    self assert: (Adr0133EnumerableUser collectWrite: self stdlibBag) equals: #[#(10, 20, 30), 3]
    self assert: (Adr0133EnumerableUser selectWrite: self stdlibBag) equals: #[#(2, 3), 3]
    self assert: (Adr0133EnumerableUser detectWrite: self stdlibBag) equals: #[2, 2]
    self assert: (Adr0133EnumerableUser detectNoneWrite: self stdlibBag) equals: #[#none, 3]
    self assert: (Adr0133EnumerableUser anySatisfyWrite: self stdlibBag) equals: #[true, 3]

  testStdlibEnumerablePure =>
    self assert: (Adr0133EnumerableUser injectPure: self stdlibBag) equals: 6
    self assert: (Adr0133EnumerableUser collectPure: self stdlibBag) equals: #(10, 20, 30)
    self assert: (Adr0133EnumerableUser selectPure: self stdlibBag) equals: #(2, 3)
    self assert: (Adr0133EnumerableUser detectPure: self stdlibBag) equals: 2
    self assert: (Adr0133EnumerableUser detectNonePure: self stdlibBag) equals: #none
    self assert: (Adr0133EnumerableUser anySatisfyPure: self stdlibBag)

  // --- The stdlib's own `uses: Enumerable(V)` (`Ets`) ---
  testEtsWrite =>
    self
      withEts: [:t |
        self assert: (Adr0133EnumerableUser doWrite: t) equals: 6
        self assert: (Adr0133EnumerableUser injectWrite: t) equals: #[6, 3]
        self assert: (Adr0133EnumerableUser collectWrite: t) equals: #[#(10, 20, 30), 3]
        self assert: (Adr0133EnumerableUser selectWrite: t) equals: #[#(2, 3), 3]
        self assert: (Adr0133EnumerableUser detectWrite: t) equals: #[2, 2]
        self assert: (Adr0133EnumerableUser detectNoneWrite: t) equals: #[#none, 3]
        self assert: (Adr0133EnumerableUser anySatisfyWrite: t) equals: #[true, 3]
      ]

  testEtsPure =>
    self
      withEts: [:t |
        self assert: (Adr0133EnumerableUser injectPure: t) equals: 6
        self assert: (Adr0133EnumerableUser collectPure: t) equals: #(10, 20, 30)
        self assert: (Adr0133EnumerableUser selectPure: t) equals: #(2, 3)
        self assert: (Adr0133EnumerableUser detectPure: t) equals: 2
        self assert: (Adr0133EnumerableUser detectNonePure: t) equals: #none
        self assert: (Adr0133EnumerableUser anySatisfyPure: t)
      ]

  // --- An actor with only `do:`, from another process ---
  // The writing form folds over the actor's `do:`; the pure form would be
  // `does_not_understand` (it has no `inject:into:`), so only writes here.
  testActorWrite =>
    a := Adr0133EnumerableActor spawnWith: #{#items => #(1, 2, 3)}
    [
      self assert: (Adr0133EnumerableUser doWrite: a) equals: 6
      self assert: (Adr0133EnumerableUser injectWrite: a) equals: #[6, 3]
      self assert: (Adr0133EnumerableUser collectWrite: a) equals: #[#(10, 20, 30), 3]
      self assert: (Adr0133EnumerableUser selectWrite: a) equals: #[#(2, 3), 3]
      self assert: (Adr0133EnumerableUser detectWrite: a) equals: #[2, 2]
      self assert: (Adr0133EnumerableUser anySatisfyWrite: a) equals: #[true, 3]
    ] ensure: [a stop]

  testActorSelfDoWritePinBug =>
    // PIN-BUG (BT-3918): inside the actor's own method, `self do:` with a
    // writing block silently drops the write and answers 0, not 6. A fix
    // flips this to `equals: 6` (or the shape becomes a compile error and
    // this test and `selfDoSum` go).
    a := Adr0133EnumerableActor spawnWith: #{#items => #(1, 2, 3)}
    [self assert: a selfDoSum equals: 0] ensure: [a stop]

  // --- BT-3843: the class's own `anySatisfy:` ---
  testOwnAnySatisfyPure =>
    // The class's own method runs: it looks only at the first element.
    self deny: (Adr0133EnumerableUser anySatisfyPure: self ownAny)

  testOwnAnySatisfyWritePin =>
    // PIN (BT-3916): with a writing block the message is the fold over the
    // receiver's `do:` (ADR 0133 § Consequences, BT-3903 note), so the
    // class's own `anySatisfy:` does not run and the answer is the fold's.
    // The write is never dropped. If BT-3916 adopts a receiver guard, this
    // flips to `raise: #stateful_block_dispatch`.
    self assert: (Adr0133EnumerableUser anySatisfyWrite: self ownAny) equals: #[true, 3]
