// BT-4301 / ADR 0142 §2: a literal-receiver class send to a method the class
// itself defines compiles to a direct call behind a run-time guard, whose
// fallback is the dynamic `class_send`. Since BT-4316 the guard is one read of
// the call target's static call key, installed by
// `beamtalk_class_shadow_flags:static_call_target/4` only while
// `direct_call_ok/2` holds. The ADR 0129 static direct calls were unguarded; these
// are the regression tests for the bugs that caused:
// - BT-4133: a class-side extension shadowing a direct-called method was
//   silently bypassed;
// - BT-4126: hot-patching a direct-called method with a runtime fun left
//   static callers on the compiled method;
// - BT-4037: callers passed `nil` as `ClassSelf`.
// (BT-4134, a re-parent under a class with class variables, is covered by the
// runtime test `beamtalk_class_in_caller_tests`.)
//
// Fixtures: fixtures/gsc_sealed_ext.bt, fixtures/gsc_open_ext.bt,
// fixtures/gsc_patched.bt, fixtures/gsc_class_self.bt, fixtures/gsc_ping.bt,
// fixtures/gsc_pong.bt, fixtures/gsc_warm_ext.bt, fixtures/gsc_warm_patched.bt,
// fixtures/gsc_warm_parent.bt, fixtures/gsc_warm_child.bt,
// fixtures/gsc_restart.bt.

TestCase subclass: GuardedStaticCallTest

  // BT-4133: an extension on a sealed class's `class sealed` method is honoured.
  testExtensionShadowsSealedClassMethod =>
    self assert: GscSealedExt shadowMe equals: #compiled
    Erlang beamtalk_extensions
      register: #'GscSealedExt class'
      selector: #shadowMe
      fun: [:args :receiver | #extension]
      owner: #test
    shadowed := GscSealedExt shadowMe
    Erlang beamtalk_extensions
      unregister: #GscSealedExt
      selector: #shadowMe
      classSide: true
    self assert: shadowed equals: #extension
    self assert: GscSealedExt shadowMe equals: #compiled

  // BT-4133: the same for an open class, and for a class-side self-send.
  testExtensionShadowsOpenClassMethodAndSelfSend =>
    self assert: GscOpenExt viaSelf equals: #compiled
    Erlang beamtalk_extensions
      register: #'GscOpenExt class'
      selector: #shadowMe
      fun: [:args :receiver | #extension]
      owner: #test
    literal := GscOpenExt shadowMe
    viaSelf := GscOpenExt viaSelf
    Erlang beamtalk_extensions
      unregister: #GscOpenExt
      selector: #shadowMe
      classSide: true
    self assert: literal equals: #extension
    self assert: viaSelf equals: #extension

  // BT-4126: a runtime fun replacing a class method is reached by static
  // callers compiled before the patch, and removing it restores them.
  testRuntimeFunPatchReachesStaticCallers =>
    self assert: GscPatched patchMe equals: #compiled
    pid := Erlang beamtalk_class_registry whereis_class: #GscPatched
    @expect type
    Erlang beamtalk_object_class
      put_class_method: pid
      selector: #patchMe
      fun: [:classSelf | #fromRuntimeFun]
    [
      self assert: GscPatched patchMe equals: #fromRuntimeFun
    ] ensure: [GscPatched class removeSelector: #patchMe]
    self assert: GscPatched patchMe equals: #compiled

  // The guarded direct call stays a tail call: a million-deep recursion
  // through literal class references runs in the stack a shallow one uses.
  testGuardedDirectCallIsATailCall =>
    shallow := GscPing ping: 10
    deep := GscPing ping: 1000000
    self assert: deep - shallow < 50

  // BT-4037: the callee gets the real class reference, on the direct path and
  // on the fallback alike.
  testCalleeGetsTheRealClass =>
    self assert: GscClassSelf me equals: GscClassSelf
    self assert: GscClassSelf viaSibling equals: GscClassSelf
    // Raising the class-variable input turns the guard off: the same static
    // send now takes the `class_send` fallback through the class process.
    Erlang beamtalk_class_shadow_flags set_class_vars: #GscClassSelf with: true
    guardOff := (Erlang beamtalk_class_shadow_flags) direct_call_ok: #'GscClassSelf class' with: #GscClassSelf
    viaFallback := GscClassSelf me
    Erlang beamtalk_class_shadow_flags set_class_vars: #GscClassSelf with: false
    self deny: guardOff
    self assert: viaFallback equals: GscClassSelf

  // BT-4442: the compiled call site reads the per-class key the runtime
  // writes (`beamtalk_class_shadow_flags:static_calls_key/1`). With the
  // class's guard off, the miss path declines to the fallback, so a static
  // send answers a value planted in the runtime-spelled key only if the call
  // site reads that very key.
  testCallSiteReadsTheRuntimesPerClassKey =>
    self assert: GscClassSelf me equals: GscClassSelf
    mapKey := Erlang beamtalk_class_shadow_flags static_calls_key: #'GscClassSelf class'
    warmed := Erlang persistent_term get: mapKey with: nil
    self deny: warmed isNil
    planted := Erlang maps map: [:k :v | #planted] with: warmed
    Erlang beamtalk_class_shadow_flags set_class_vars: #GscClassSelf with: true
    viaKey := [
      Erlang persistent_term put: mapKey with: planted
      GscClassSelf me
    ] ensure: [
      Erlang beamtalk_class_shadow_flags set_class_vars: #GscClassSelf with: false
    ]
    self assert: viaKey equals: #planted
    self assert: GscClassSelf me equals: GscClassSelf

  // === BT-4316: the static call key ===
  //
  // A static send's hit path is one `persistent_term` read of the class's
  // static call map (one key per class since BT-4442), whose value for the
  // call target is the class reference passed as `ClassSelf`. Each
  // test below warms that key with a static send first, then changes what the
  // dynamic path answers and checks the static send answers the same. (The
  // reload cases, a dropped method and a superclass that gains `classState:`
  // on reload, need a workspace: see
  // tests/repl-protocol/cases/guarded_static_call_key.btscript.)

  // The class held as a Dynamic value: sends to it compile to `class_send`.
  lookUp: name :: Symbol -> Dynamic => Beamtalk classNamed: name

  // (a) A class-side extension registered after warm-up wins.
  testExtensionRegisteredAfterWarmUpWins =>
    self assert: GscWarmExt answer equals: #compiled
    Erlang beamtalk_extensions
      register: #'GscWarmExt class'
      selector: #answer
      fun: [:args :receiver | #extension]
      owner: #test
    literal := GscWarmExt answer
    dynamic := (self lookUp: #GscWarmExt) answer
    Erlang beamtalk_extensions
      unregister: #GscWarmExt
      selector: #answer
      classSide: true
    self assert: literal equals: #extension
    self assert: dynamic equals: #extension
    self assert: GscWarmExt answer equals: #compiled

  // (b) A runtime class-method fun installed after warm-up wins, and its
  // removal (BT-4438) gives the compiled method back.
  testRuntimeClassMethodAfterWarmUpWins =>
    self assert: GscWarmPatched answer equals: #compiled
    pid := Erlang beamtalk_class_registry whereis_class: #GscWarmPatched
    @expect type
    Erlang beamtalk_object_class
      put_class_method: pid
      selector: #answer
      fun: [:classSelf | #fromRuntimeFun]
    [
      self assert: GscWarmPatched answer equals: #fromRuntimeFun
      self assert: (self lookUp: #GscWarmPatched) answer equals: #fromRuntimeFun
    ] ensure: [GscWarmPatched class removeSelector: #answer]
    // Removing it brings the compiled method back, through the static send too.
    self assert: GscWarmPatched answer equals: #compiled
    self assert: (self lookUp: #GscWarmPatched) answer equals: #compiled

  // (d) Once a superclass publishes class variables (the fact a reload that
  // adds `classState:` publishes), a warmed static send takes the class
  // process, as the dynamic send does.
  testSuperclassClassVariablesAfterWarmUpTakeTheClassProcess =>
    me := Erlang erlang self
    self assert: GscWarmChild whoRuns equals: me
    Erlang beamtalk_class_metadata put_class_variables: #GscWarmParent with: true
    literal := GscWarmChild whoRuns
    dynamic := (self lookUp: #GscWarmChild) whoRuns
    Erlang beamtalk_class_metadata put_class_variables: #GscWarmParent with: false
    self deny: literal =:= me
    self deny: dynamic =:= me
    self assert: literal equals: dynamic
    self assert: GscWarmChild whoRuns equals: me

  // (e) After the class process is killed and the class monitor restarts it,
  // the callee's `ClassSelf` holds the new pid. A class object taken before the
  // kill still answers through the restarted process (BT-4552: the eager
  // restart must not forget the dead pid's class name).
  testRestartedClassProcessIsTheNewClassSelf =>
    oldPid := Erlang beamtalk_class_registry whereis_class: #GscRestart
    stale := self lookUp: #GscRestart
    self assert: (Erlang erlang element: 4 of: GscRestart me) equals: oldPid
    Erlang erlang exit: oldPid with: #kill
    newPid := self
      pidOf: #GscRestart
      other: oldPid
      tries: 500
    self deny: newPid =:= oldPid
    self assert: (Erlang erlang element: 4 of: GscRestart me) equals: newPid
    self assert: (Erlang erlang element: 4 of: (self lookUp: #GscRestart) me) equals: newPid
    self assert: (Erlang erlang element: 4 of: stale) equals: oldPid
    self assert: stale name equals: #GscRestart

  // The registered pid of class `name` once it is a live pid other than
  // `oldPid`, polling every 10 ms up to `tries` times.
  pidOf: name :: Symbol other: oldPid tries: tries :: Integer =>
    pid := Erlang beamtalk_class_registry whereis_class: name
    ((Erlang erlang is_pid: pid) and: [pid =/= oldPid]) ifTrue: [^pid]
    tries =:= 0 ifTrue: [^pid]
    Erlang timer sleep: 10
    self
      pidOf: name
      other: oldPid
      tries: tries - 1
