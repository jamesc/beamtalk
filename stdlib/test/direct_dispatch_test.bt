// BT-3639 / ADR 0129 Phase 0b: dynamic class-side sends to sealed, stateless
// classes call the module function directly in the caller, so they behave
// identically to the static form. Eligibility is generated metadata
// (`direct_class_methods`), computed by `compute_direct_call_eligible`.
//
// Fixtures: fixtures/direct_dispatch_stateless.bt, fixtures/has_field_probe_base.bt,
// fixtures/has_field_probe_child.bt,
// fixtures/direct_dispatch_stateful.bt.

TestCase subclass: DirectDispatchTest

  // --- static and dynamic forms agree, and run in the caller ---------------
  testStaticSendRunsInCallersProcess =>
    self assert: DirectDispatchStateless callerPid equals: Erlang erlang self

  testVariableReceiverRunsInCallersProcess =>
    cls := DirectDispatchStateless
    self assert: cls callerPid equals: Erlang erlang self

  testPerformRunsInCallersProcess =>
    self assert: (DirectDispatchStateless perform: #callerPid) equals: Erlang erlang self

  testPerformWithArgumentsRunsDirectly =>
    self assert: (DirectDispatchStateless perform: #double: withArguments: #(4)) equals: 8

  testStaticAndDynamicResultsMatch =>
    cls := DirectDispatchStateless
    self assert: (cls double: 5) equals: (DirectDispatchStateless double: 5)

  testClassPassedAsArgument =>
    self assert: (DirectDispatchStateless relay: DirectDispatchStateless) equals: 42

  // --- hazards ---------------------------------------------------------------

  // The method messages its own class. Dynamically dispatched through the
  // class gen_server this used to raise `dispatch_error`.
  testDynamicSelfMessagingMethodNoLongerRaisesDispatchError =>
    cls := DirectDispatchStateless
    self assert: (cls relay: cls) equals: 42

  // A block passed into an eligible method now runs in the caller.
  testBlockRunsInCallerProcess =>
    cls := DirectDispatchStateless
    pid := cls callBlock: [Erlang erlang self]
    self assert: pid equals: Erlang erlang self

  // A class with `classState:` keeps the gen_server hop.
  testStatefulClassStillRunsInClassProcess =>
    cls := DirectDispatchStateful
    self deny: (cls callerPid =:= Erlang erlang self)

  testStatefulClassPerformStillRunsInClassProcess =>
    self deny: ((DirectDispatchStateful perform: #callerPid) =:= Erlang erlang self)

  testStatefulClassStateStillWorksDynamically =>
    cls := DirectDispatchStateful
    first := cls bump
    self assert: cls bump equals: first + 1

  // --- hasField: on a class with no class variables (ADR 0130 §2) -------------
  testHasFieldOnStatelessClassIsFalse =>
    self assert: DirectDispatchStateless hasMissingField equals: false

  testHasFieldInBlockOnStatelessClassIsFalse =>
    self assert: DirectDispatchStateless hasMissingFieldInBlock equals: false

  testUnusedBlockWithHasFieldDoesNotRaise =>
    self assert: DirectDispatchStateless unusedBlockWithHasField equals: 7

  // --- hasField: in an inheritable method follows the receiver (ADR 0130 §2) ---
  testInheritedHasFieldSeesSubclassClassVariable =>
    self assert: HasFieldProbeChild probe equals: true

  testInheritedHasFieldInBlockSeesSubclassClassVariable =>
    self assert: HasFieldProbeChild probeInBlock equals: true

  testInheritedHasFieldOnStatelessParentIsFalse =>
    self assert: HasFieldProbeBase probe equals: false

  // --- BT-4065: Result's constructors are `class sealed`, so direct ---------
  // Every `Result ok:` in the node used to be a call into the one Result
  // class process. Result is sealed and has no class variables, so its
  // `class sealed` constructors are in the generated direct-call set.
  testResultConstructorsAreDirectCallEligible =>
    direct := (Erlang beamtalk_class_metadata) lookup_direct_class_methods: #Result
    self assert: (direct includesKey: #ok:)
    self assert: (direct includesKey: #error:)
    self assert: (direct includesKey: #fromTuple:)
    self assert: (direct includesKey: #tryDo:)

  testDynamicResultConstructorsMatchStatic =>
    cls := Result
    self assert: (cls ok: 3) equals: (Result ok: 3)
    // (`cls error: x` with a variable receiver is the Object>>error: intrinsic.)
    self assert: (cls perform: #error: withArguments: #(#nope)) error equals: #nope
    self assert: (Result perform: #ok: withArguments: #(4)) equals: (Result ok: 4)
    self assert: (cls fromTuple: {#ok, 5}) equals: (Result ok: 5)

  // A block inside `Result tryDo:` already ran in the caller; `ok:` now does too.
  testResultOkInsideBlockRunsInCaller =>
    r := Result tryDo: [Result ok: Erlang erlang self]
    self assert: r value value equals: Erlang erlang self
