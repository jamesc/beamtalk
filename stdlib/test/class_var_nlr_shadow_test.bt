// BT-3032 / BT-3037 / ADR 0110: class-var mutations made before a foreign `^`
// escapes a class method must survive the non-local-return relay.
//
// Codegen writes the just-updated ClassVars map into the
// '$bt_class_vars_shadow' process-dictionary key at every *top-frame*
// class-var mutation in a class method; the runtime's `{nlr_relay, ...}`
// path (BT-3036) reads it back instead of reverting to the pre-call map.
//
// Fixtures: fixtures/collection_driver.bt, fixtures/collection_probe.bt,
// fixtures/shadow_relay_parent.bt, fixtures/shadow_relay_child.bt,
// fixtures/shadow_relay_probe.bt,
// fixtures/class_method_conditional_self_call.bt,
// fixtures/shadow_cross_class_owner.bt.

TestCase subclass: ClassVarNlrShadowTest
  field: cls = nil

  setUp =>
    CollectionDriver resetRunCount
    CollectionProbe resetHits
    ShadowRelayParent resetHits
    ShadowRelayChild resetHits
    ClassMethodConditionalSelfCall resetCounter
    ShadowCrossClassOwner resetBumps
    self

  tearDown => self.cls isNil ifFalse: [self.cls removeFromSystem]

  // --- (a) the BT-3032 repro -----------------------------------------------

  // Control: a normally-returning block keeps the increment (worked before
  // ADR 0110 too — pins that the shadow write changes nothing here).
  testMutationPersistsOnNormalReturn =>
    CollectionDriver countedRun: [:x | x] over: #(1, 2, 3)
    self assert: CollectionDriver runCount equals: 1

  // The repro: the `^` in the probe's block is foreign to countedRun:over:'s
  // frame. The returned value was already correct (BT-3022); the class-var
  // increment must now survive too.
  testMutationSurvivesForeignNlrEscape =>
    self assert: (CollectionProbe escapeAfterCountedRun: #(1, 2, 3)) equals: 2
    self assert: CollectionDriver runCount equals: 1

  // Escaping twice accumulates — each relay persists its own increment.
  testRepeatedEscapesAccumulate =>
    self assert: (CollectionProbe escapeAfterCountedRun: #(1, 2, 3)) equals: 2
    self assert: (CollectionProbe escapeAfterCountedRun: #(1, 2, 3)) equals: 2
    self assert: CollectionDriver runCount equals: 2

  // --- (a2) BT-3164: a method's own last-statement class-var mutation ------
  // shares its body with that SAME method's own real local NlrCatch (not a
  // foreign relay) — the ADR 0110 joint-visibility gap ADR 0111 Addendum 6
  // left open for class methods (`VerifyError::ShadowWriteMissing` could
  // not previously see a real class-var `Bind` and a real class-method
  // `NlrCatch` in the same verified IR). Both branches below pin that the
  // new `lower_class_method_last_class_var_bind` `Bind` composes correctly
  // with a real local NLR catch in the same body: the `^` unwinding before
  // the mutation ever runs, and the mutation landing normally when it
  // doesn't.
  testOwnLastStatementClassVarMutationSharesBodyWithOwnRealNlrCatch =>
    // `x > 1` matches x=2 — the local `^` fires and unwinds before this
    // method's own last statement (`self.hits := self.hits + 1`) runs.
    self assert: (CollectionProbe escapeAfterCountedRunThenBump: #(1, 2, 3)) equals: 2
    self assert: CollectionProbe hits equals: 0
    self assert: CollectionDriver runCount equals: 1
    // No element `> 1` — the call completes normally, so the last
    // statement's class-var mutation runs and becomes the return value.
    self assert: (CollectionProbe escapeAfterCountedRunThenBump: #(1)) equals: 1
    self assert: CollectionProbe hits equals: 1
    self assert: CollectionDriver runCount equals: 2

  // --- (a3) BT-3164 review finding: a ClassVars version gap (from an -------
  // opaque class-var-mutating self-send) before a real last-statement
  // Bind, in a body with a real local NlrCatch — regression pin for a bug
  // this issue's own review caught: the ClassVars gap-backfill's synthetic
  // placeholder Bind spuriously tripped ShadowWriteMissing in exactly this
  // shape before the fix (see `backfill_opaque_version_gap`'s doc
  // comment). Compiling/running this class at all is the pin; the
  // asserted values confirm both mutations still land correctly.
  testSelfSendMutationThenDirectLastStatementMutationInSameNlrBody =>
    self assert: (CollectionProbe bumpViaSelfSendThenBumpDirectlyWithNlr: #(1, 2, 3)) equals: 2
    self assert: CollectionProbe hits equals: 2

  // --- (b) a genuine error still reverts -----------------------------------
  testGenuineErrorStillRevertsMutation =>
    // The raw badarith from `1 / 0` is classified to #type_error at the
    // class-dispatch boundary (as elsewhere off the caller's process).
    self should: [CollectionDriver failAfterCount] raise: #type_error
    self assert: CollectionDriver runCount equals: 0

  // --- (c) self-dispatched inherited class method --------------------------

  // The mutation happens in ShadowRelayParent's hitRun:over: running via
  // `self hitRun:over:` inside ShadowRelayChild's class process; the foreign
  // `^` relays through the self-dispatch chain and the increment lands in the
  // child's ClassVars.
  testInheritedSelfDispatchMutationSurvivesRelay =>
    self assert: (ShadowRelayProbe escapeThroughChild: #(1, 2, 3)) equals: 2
    self assert: ShadowRelayChild hitCount equals: 1
    // Per-class ClassVars: the parent's own counter is untouched.
    self assert: ShadowRelayParent hitCount equals: 0

  // --- (d) block-interior mutations stay discarded -------------------------

  // A *direct* class-var assignment inside a block in a class method is a
  // compile-time error (BT-2792 FieldAssignmentInUnsupportedBlock), so the
  // runtime-expressible block-interior mutation is the BT-1550 shape: a
  // conditional self-call whose callee mutates. That mutation is discarded on
  // the normal-return path today, and the ADR 0110 shadow write — gated on
  // the method's own top frame, block_depth == 0 — deliberately does not
  // change this. (The gate itself is pinned by Rust codegen tests in
  // crates/beamtalk-core/src/codegen/core_erlang/tests/.)
  testBlockInteriorMutationStillDiscardedOnNormalReturn =>
    self assert: (ClassMethodConditionalSelfCall triggerWithMutation: 5) equals: 5
    self assert: ClassMethodConditionalSelfCall counterValue equals: 0

  // --- (e) ClassBuilder-defined classes ------------------------------------

  // Same repro against a runtime-built class: the classMethods: fun lowers
  // through the shared class-method body path, so the shadow write fires
  // there too.
  testClassBuilderMutationSurvivesForeignNlrEscape =>
    Object classBuilder name: #BT3037ShadowBuilt;
      superclass: Object;
      classVars: #{#runs => 0};
      classMethods: #{#countedRun:over: => [:self :aBlock :aList |
          self.runs := self.runs + 1
          aList do: [:x | aBlock value: x]
          nil
        ], #runCount => [:self | self.runs]};
      register
    self.cls := (Erlang beamtalk_interface) findClass: #BT3037ShadowBuilt
    self assert: (ShadowRelayProbe escapeThrough: self.cls over: #(1, 2, 3)) equals: 2
    self assert: self.cls runCount equals: 1

  // --- (f) cross-class contamination (BT-3039) ------------------------------

  // The repro from BT-3039: ShadowCrossClassOwner hands CollectionDriver a
  // block containing a mutating self-send (`self bump`) plus the `^` that
  // escapes CollectionDriver's frame. `self bump` runs physically inside
  // CollectionDriver's class process (ADR 0109), so before the class-keyed
  // fix its shadow write clobbered CollectionDriver's own — corrupting
  // CollectionDriver's persisted class vars with ShadowCrossClassOwner's map
  // (a later `CollectionDriver runCount` would raise on the missing `runs`
  // key). CollectionDriver's own mutation must survive uncorrupted.
  testCrossClassMutationDoesNotCorruptForeignProcessShadow =>
    self assert: (ShadowCrossClassOwner bumpThenEscapeThrough: CollectionDriver over: #(1, 2, 3)) equals: 1
    self assert: CollectionDriver runCount equals: 1
    // The `^` belongs to ShadowCrossClassOwner's own frame (it lexically
    // contains the block), so its own mutation is carried out via the
    // ordinary matching-token NLR catch (BT-3022/ADR 0041) — not the shadow
    // at all. Both classes' own state end up correct simultaneously: P's via
    // the normal NLR value, C's via the class-keyed shadow read.
    self assert: ShadowCrossClassOwner bumpCount equals: 1

// A builder cascade with a *mutating* classMethods: block written inside a
// block literal is rejected at compile time today (BT-2792 stored-closure
// field-write validation sees the classMethods: mutation), so the
// "cascade lexically inside a block" arm of ADR 0110 — the
// generate_class_method_fun_from_block block_depth reset — is pinned at the
// Rust level instead:
// crates/beamtalk-core/src/codegen/core_erlang/tests/dispatch.rs,
// test_builder_cascade_at_block_depth_still_emits_shadow_write.
