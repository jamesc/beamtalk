// BT-4919: `{a, b} := (self.pair := {x, y})` in an actor method body writes the
// field (sequenced ahead by `thread_ahead`) and destructures the assigned value;
// a conditional arm lowers the same write as its own real `Bind`.
// See fixtures/bt4919destructure_field_write_actor.bt.

TestCase subclass: Bt4919DestructureFieldWriteTest

  testNonLastPositionBindsNamesAndWritesField =>
    a := Bt4919DestructureFieldWriteActor spawn
    self assert: (a sumWritten: 3 and: 4) equals: 7
    self assert: a pair equals: {3, 4}
    self assert: a count equals: 1

  testStateThreadsAcrossCalls =>
    a := Bt4919DestructureFieldWriteActor spawn
    a sumWritten: 1 and: 2
    self assert: (a sumWritten: 10 and: 20) equals: 30
    self assert: a pair equals: {10, 20}
    self assert: a count equals: 2

  testLastPositionAnswersAssignedValue =>
    a := Bt4919DestructureFieldWriteActor spawn
    self assert: (a writeLast: 5 and: 6) equals: {5, 6}
    self assert: a pair equals: {5, 6}

  testConditionalArmWritesFieldAndBindsNames =>
    a := Bt4919DestructureFieldWriteActor spawn
    self
      assert: (a
        sumInArm: true
        and: 8
        and: 9)
      equals: 17
    self assert: a pair equals: {8, 9}

  testConditionalArmNotTakenLeavesFieldAlone =>
    a := Bt4919DestructureFieldWriteActor spawn
    self
      assert: (a
        sumInArm: false
        and: 8
        and: 9)
      equals: 0
    self assert: a pair equals: nil
