// Stdlib tests for OS class (BT-1244, BT-1247)

TestCase subclass: OSTest
  field: isUnix = false

  setUp => self withIsUnix: (System osFamily == "unix")

  testRunReturnsString =>
    // echo is a shell builtin on both Unix and Windows
    result := OS run: "echo hello"
    self assert: result class equals: String

  testRunTrimsTrailingWhitespace =>
    result := OS run: "echo hello"
    self assert: result equals: "hello"

  testRunWithNonStringRaisesTypeError =>
    @expect type
    self should: [OS run: 42] raise: #type_error

  testRunTimeoutReturnsString =>
    result := OS run: "echo hello" timeout: 5000
    self assert: result equals: "hello"

  testRunTimeoutWithNonStringRaisesTypeError =>
    @expect type
    self should: [OS run: 42 timeout: 5000] raise: #type_error

  testRunTimeoutExpiryRaisesTimeout =>
    cmd := self.isUnix ifTrue: ["sleep 60"] ifFalse: ["ping -n 100 127.0.0.1"]
    self should: [OS run: cmd timeout: 100] raise: #timeout

  testRunInvalidUtf8RaisesParseError =>
    // printf '\\200' emits byte 0x80, which is not valid UTF-8 (BT-4170).
    // Only run on Unix; Windows printf does not support octal byte escapes.
    self.isUnix ifTrue: [
      self should: [OS run: "printf '\\200'"] raise: #parse_error
    ]

  testRunTimeoutAcceptsDuration =>
    // BT-5090: a Duration is converted to milliseconds once, at the call
    result := OS run: "echo hello" timeout: (Duration seconds: 5)
    self assert: result equals: "hello"

  testRunTimeoutDurationExpiryRaisesTimeout =>
    cmd := self.isUnix ifTrue: ["sleep 60"] ifFalse: ["ping -n 100 127.0.0.1"]
    self should: [
      OS run: cmd timeout: (Duration milliseconds: 100)
    ] raise: #timeout

  testRunTimeoutNegativeDurationFailsLikeNegativeInteger =>
    // BT-5090: a Duration is only unit-converted; validation is the Integer path's
    asInteger := [OS run: "echo hi" timeout: -1] on: Error do: [:e | e kind]
    asDuration := [OS run: "echo hi" timeout: (Duration milliseconds: -1)] on: Error do: [:e | e kind]
    self assert: asDuration equals: asInteger
    self assert: asInteger equals: #type_error

  testRunTimeoutOtherBadValueKeepsItsError =>
    @expect type
    kind := [OS run: "echo hi" timeout: "soon"] on: Error do: [:e | e kind]
    self assert: kind equals: #type_error
