// BT-3841 (ADR 0131): `detect:ifNone:` as local-threading producers in a class method, a
// value-type method and an actor method. The fixtures are
// fixtures/adr0131detect_{class,value,actor}.bt.

TestCase subclass: Adr0131DetectTest

  testClassTopHit => self assert: (Adr0131DetectClass topHit) equals: 1

  testClassInArmHit =>
    self assert: (Adr0131DetectClass inArmHit: true) equals: 1
    self assert: (Adr0131DetectClass inArmHit: false) equals: 0

  testClassInArmElseHit =>
    self assert: (Adr0131DetectClass inArmElseHit: true) equals: 100
    self assert: (Adr0131DetectClass inArmElseHit: false) equals: 1

  testClassInDoHit => self assert: (Adr0131DetectClass inDoHit) equals: 2

  testClassInToDoHit => self assert: (Adr0131DetectClass inToDoHit) equals: 2

  testClassInTimesHit => self assert: (Adr0131DetectClass inTimesHit) equals: 2

  testClassInWhileHit => self assert: (Adr0131DetectClass inWhileHit) equals: 2

  testClassInOnDoHit => self assert: (Adr0131DetectClass inOnDoHit) equals: 1

  testClassInEnsureHit =>
    self assert: (Adr0131DetectClass inEnsureHit) equals: 1

  testClassInHandlerHit =>
    self assert: (Adr0131DetectClass inHandlerHit) equals: 1

  testClassInArmInDoHit =>
    self assert: (Adr0131DetectClass inArmInDoHit: true) equals: 2
    self assert: (Adr0131DetectClass inArmInDoHit: false) equals: 0

  testClassReturnInArmHit =>
    self assert: (Adr0131DetectClass returnInArmHit: true) equals: 1
    self assert: (Adr0131DetectClass returnInArmHit: false) equals: 0

  testClassAssignedHit =>
    self assert: (Adr0131DetectClass assignedHit) equals: #[1, 1]

  testClassTopMiss => self assert: (Adr0131DetectClass topMiss) equals: 103

  testClassInArmMiss =>
    self assert: (Adr0131DetectClass inArmMiss: true) equals: 103
