/// TranscriptStream — Per-workspace shared log with pub/sub semantics.
///
/// TranscriptStream is a real actor (gen_server) that acts as a shared
/// log within a workspace. Each workspace has its own Transcript instance.
/// Subscribers receive output in real-time; unsubscribed output goes to
/// buffer only. Analogous to Smalltalk's `Transcript` global.
///
/// ## Examples
/// ```beamtalk
/// Transcript show: "hello"
/// Transcript cr
/// Transcript recent
/// ```
typed Actor subclass: TranscriptStream native: beamtalk_transcript_stream
  late classState: current :: TranscriptStream

  // === Class-side Singleton ===

  /// Return the current singleton instance (nil before workspace bootstrap).
  ///
  /// `@expect type`: a class method's `self hasField:` send infers as
  /// `Dynamic` rather than its declared `Boolean` return type — a
  /// pre-existing type-checker gap (ADR 0124 B4's `has_clear_class_var_actor.bt`
  /// fixture hits the same thing), not something this conversion introduces.
  @expect type
  class current -> TranscriptStream | Nil =>
    (self hasField: #current) ifTrue: [self.current] ifFalse: [nil]

  /// Set the current singleton instance.
  class current: instance :: TranscriptStream -> TranscriptStream =>
    self.current := instance

  /// Clear the current singleton instance (reset to nil).
  ///
  /// `@expect type`: a class method's `self clearField:` send infers as
  /// `Dynamic` rather than its declared `Self` return type — the same
  /// pre-existing type-checker gap `current`'s `self hasField:` hits above.
  @expect type
  class resetCurrent -> Nil =>
    self clearField: #current
    nil

  // === Writing ===

  /// Write a value to the transcript.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript show: "hello"
  /// Transcript show: 42
  /// ```
  show: value :: Object -> Nil => self delegate

  /// Write a newline to the transcript.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript cr
  /// ```
  cr -> Nil => self delegate

  // === Subscriptions ===

  /// Subscribe the calling process to receive transcript output.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript subscribe
  /// ```
  subscribe -> Nil => self delegate

  /// Unsubscribe the calling process from transcript output.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript unsubscribe
  /// ```
  unsubscribe -> Nil => self delegate

  // === Buffer ===

  /// Return recent transcript entries as a list.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript recent
  /// ```
  recent -> List(String) => self delegate

  /// Clear the transcript buffer.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript clear
  /// ```
  clear -> Nil => self delegate
