/// TranscriptStream — the REPL's shared log stream, with pub/sub semantics.
///
/// TranscriptStream is a real actor (gen_server): a ring buffer of recent
/// output plus subscribers that receive output in real time. The workspace
/// supervisor starts one, registered as `Transcript`, only alongside the REPL
/// server. User code does not talk to it directly: use the `Transcript`
/// class-side facade (ADR 0129 §5), which routes output to this stream inside
/// an interactive workspace and to `Logger` everywhere else.
///
/// ## Examples
/// ```beamtalk
/// Transcript show: "hello"
/// Transcript cr
/// Transcript recent
/// ```
typed Actor subclass: TranscriptStream native: beamtalk_transcript_stream

  // === Writing ===

  /// Write a value to the transcript.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript show: "hello"
  /// Transcript show: 42
  /// ```
  show: value :: Object -> Nil => self delegate

  /// Write a newline to the transcript.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript cr
  /// ```
  cr -> Nil => self delegate

  // === Subscriptions ===

  /// Subscribe the calling process to receive transcript output.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript subscribe
  /// ```
  subscribe -> Nil => self delegate

  /// Unsubscribe the calling process from transcript output.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript unsubscribe
  /// ```
  unsubscribe -> Nil => self delegate

  // === Buffer ===

  /// Return recent transcript entries as a list.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript recent
  /// ```
  recent -> List(String) => self delegate

  /// Clear the transcript buffer.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Transcript clear
  /// ```
  clear -> Nil => self delegate
