/// Dictionary — Immutable key-value collection.
///
/// Dictionaries are backed by Erlang maps. Operations that "modify"
/// a dictionary return a new dictionary — the original is unchanged.
///
/// ## BEAM Mapping
/// Beamtalk dictionaries map directly to Erlang maps.
///
/// Deliberately has no `first`/`last` — a Dictionary promises no ordering
/// over its entries, so either name would misleadingly suggest one. Use
/// `anyOne` to grab a single value (no ordering guarantee, may differ
/// between calls), or `asList first` / `asList last` if you specifically
/// want the order `asList` currently answers in.
///
/// ## Examples
/// ```beamtalk
/// #{#name => "Alice"} class                   // => Dictionary
/// #{#name => "Alice"} at: #name               // => "Alice"
/// #{#a => 1} at: #b put: 2                    // => #{#a => 1, #b => 2}
/// ```
sealed typed Collection(V) subclass: Dictionary(K, V)

  /// Number of key-value pairs.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} size                   // => 2
  /// ```
  size -> Integer => @primitive

  /// Return a list of all keys.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} keys
  /// ```
  keys -> List(K) => @primitive

  /// Return a list of all values.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} values
  /// ```
  values -> List(V) => @primitive

  /// Return the value associated with `key`. Raises an error if not found.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#name => "Alice"} at: #name              // => "Alice"
  /// ```
  at: key :: K -> V => @primitive

  /// Return the value for `key`, or evaluate `block` if absent.
  ///
  /// `block`'s return type need not match `V` — e.g. `dict at: k ifAbsent:
  /// [nil]` type-checks as `V | Nil` even when `V` doesn't itself include
  /// `Nil`, the same way `Behaviour>>removeSelector:ifAbsent:` widens
  /// through its own absent-block.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} at: #b ifAbsent: [0]            // => 0
  /// ```
  at: key :: K ifAbsent: block :: Block(T) -> V | T => @primitive

  /// Return a new dictionary with `key` mapped to `value`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} at: #b put: 2                   // => #{#a => 1, #b => 2}
  /// ```
  at: key :: K put: value :: V -> Dictionary(K, V) => @primitive

  /// Test if the dictionary contains the given key.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} includesKey: #a                 // => true
  /// #{#a => 1} includesKey: #b                 // => false
  /// ```
  includesKey: key :: K -> Boolean => @primitive

  /// Return a new dictionary without the given key.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} removeKey: #a          // => #{#b => 2}
  /// ```
  removeKey: key :: K -> Dictionary(K, V) => @primitive

  /// Merge another dictionary into the receiver (other's values win on conflict).
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} merge: #{#b => 2}               // => #{#a => 1, #b => 2}
  /// ```
  merge: other :: Dictionary(K, V) -> Dictionary(K, V) => @primitive

  /// Test if the dictionary contains the given value.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} includes: 1     // => true
  /// #{#a => 1} includes: 3              // => false
  /// ```
  includes: value :: V -> Boolean => @primitive

  // === Enumerating ===

  /// Iterate over each value, evaluating `block` with each one.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} do: [:v | Transcript show: v]
  /// ```
  do: block :: Block(V, Object) -> Nil => @primitive

  /// Map `block` over each value, returning a new Dictionary with the
  /// same keys and transformed values.
  ///
  /// Overrides `Collection>>collect:` — for a Dictionary, the result
  /// preserves keys rather than collecting values into a list.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1, #b => 2} collect: [:v | v * 10]  // => #{#a => 10, #b => 20}
  /// ```
  collect: block :: Block(V, R) -> Dictionary(K, R) =>
    dict := self
    self keys inject: #{} into: [:acc :k |
      acc at: k put: (block value: (dict at: k))
    ]

  /// Iterate over each key-value pair, evaluating `block` with key and value.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} doWithKey: [:k :v | Transcript show: k]
  /// ```
  doWithKey: block :: Block(K, V, Object) -> Nil => @primitive

  /// Iterate over each key-value pair, evaluating `block` with key and value.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} keysAndValuesDo: [:k :v | Transcript show: k]
  /// ```
  keysAndValuesDo: block :: Block(K, V, Object) -> Nil => self doWithKey: block

  // === Printing ===

  /// Return a string representation using Beamtalk syntax.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #{#a => 1} printString                     // => "#{#a => 1}"
  /// ```
  printString -> String => @primitive
