/// Symbol — Atomic identifiers.
///
/// Symbols are interned strings (Erlang atoms). They are used as method
/// selectors, class names, and general-purpose identifiers. Symbols are
/// immutable and unique: two symbols with the same name are always identical.
///
/// ## BEAM Mapping
/// Beamtalk symbols map directly to Erlang atoms.
///
/// ## Examples
/// ```beamtalk
/// #hello class           // => Symbol
/// #hello asString        // => "hello"
/// #hello = #hello        // => true
/// ```
sealed typed Object subclass: Symbol

  /// Convert the symbol to a string.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello asString        // => "hello"
  /// ```
  asString -> String => @primitive

  /// Convert the symbol to an atom (returns self).
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello asAtom          // => #hello
  /// ```
  asAtom -> Symbol => @primitive

  // === Printing ===

  /// Return a developer-readable string representation (with `#` prefix).
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello printString     // => "#hello"
  /// ```
  printString -> String => @primitive

  // === Comparison ===

  /// Test strict equality with another symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello =:= #hello        // => true
  /// #hello =:= #world        // => false
  /// ```
  =:= other :: Symbol -> Boolean => @primitive

  /// Test strict inequality with another symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello =/= #world        // => true
  /// #hello =/= #hello        // => false
  /// ```
  =/= other :: Symbol -> Boolean => @primitive

  /// Test inequality with another symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello /= #world       // => true
  /// #hello /= #hello       // => false
  /// ```
  /= other :: Symbol -> Boolean => @primitive

  /// Test if the receiver sorts before another symbol (alphabetically by
  /// name, codepoint by codepoint).
  ///
  /// ## Examples
  /// ```beamtalk
  /// #apple < #banana         // => true
  /// ```
  < other :: Symbol -> Boolean => @primitive

  /// Test if the receiver sorts after another symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #banana > #apple         // => true
  /// ```
  > other :: Symbol -> Boolean => @primitive

  /// Test if the receiver sorts before or equal to another symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #apple <= #apple         // => true
  /// ```
  <= other :: Symbol -> Boolean => @primitive

  /// Test if the receiver sorts after or equal to another symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #apple >= #banana        // => false
  /// ```
  >= other :: Symbol -> Boolean => @primitive

  // === Display & Hashing ===

  /// Return a user-facing string representation without the `#` prefix.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello displayString     // => "hello"
  /// ```
  displayString -> String => self asString

  /// Return a hash value for the symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #hello hash
  /// ```
  hash -> Integer => @primitive
