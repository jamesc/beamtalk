/// The closed set of error kinds the runtime knows how to classify into the
/// `Exception` hierarchy (`beamtalk_exception_handler:kind_to_class/1`).
/// Anything outside this set falls back to classifying as plain `Error`, so
/// `signalKind:class:selector:hint:` restricts its `kind` argument to this
/// type to catch a typo (e.g. `#idx_out_of_bounds`) at compile time instead
/// of silently landing in the wrong catch hierarchy at runtime.
type ExceptionKind = #does_not_understand | #arity_mismatch | #immutable_value | #runtime_error | #index_out_of_bounds | #empty_collection | #empty_queue | #not_found | #class_not_found | #no_superclass | #class_already_exists | #dispatch_error | #callback_failed | #actor_dead | #future_not_awaited | #internal_error | #key_error | #argument_error | #resource_error | #process_not_found | #timeout_error | #type_error | #instantiation_error | #erlang_exit | #erlang_throw | #signal

/// Exception — Base class for all exceptions.
///
/// Wraps `#beamtalk_error{}` records as first-class Beamtalk objects.
///
/// ## Examples
/// ```beamtalk
/// [1 / 0] on: Exception do: [:e | e message]
/// Exception signal: "something went wrong"
/// ```
///
/// @see Result (for expected success/failure outcomes without exceptions)
/// @see Error (for non-resumable exceptions)
Object subclass: Exception

  /// Create and raise a new exception with the given message.
  ///
  /// This is the preferred way to signal exceptions. Class-side, so no
  /// instance allocation is needed: `Exception signal: "oops"` or
  /// `MyCustomError signal: "bad input"`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Exception signal: "something went wrong"
  /// MyCustomError signal: "bad input"
  /// ```
  class signal: msg :: String -> Never => @primitive "classSignal:"

  /// Create and raise a new exception with the class name as the message.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Exception signal
  /// ```
  class signal -> Never => @primitive "classSignal"

  /// Signal a named error kind with a caller-supplied hint.
  ///
  /// The general, pure-Beamtalk way to signal an error with a specific kind
  /// (`#index_out_of_bounds`, `#empty_collection`, or any other kind in
  /// `ExceptionKind`) instead of the generic `#user_error` kind `self error:`
  /// always raises. Class-side, so no instance allocation is needed —
  /// collection classes (core or third-party package) call this to report a
  /// condition with the same kind the `@primitive`-backed core collections
  /// (`Array`, `List`, `String`) raise, and a hint specific to the call site.
  /// Sealed: the receiving class plays no role in the result (unlike
  /// `signal:`/`signal`, which take their class from the receiver), so
  /// sending this to a subclass instead of `Exception` itself would be
  /// misleading.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Exception
  ///   signalKind: #index_out_of_bounds
  ///   class: #ListZipper
  ///   selector: #left
  ///   hint: "already at the start of the sequence"
  /// ```
  class sealed signalKind: kind :: ExceptionKind class: cls :: Symbol selector: sel :: Symbol hint: hint :: String -> Never =>
    @primitive "classSignalKind:class:selector:hint:"

  // === Accessing ===

  /// Return the error message string.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [1 / 0] on: Exception do: [:e | e message]
  /// ```
  message -> String => @primitive

  /// Return the actionable hint string, or nil if none.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [1 / 0] on: Exception do: [:e | e hint]
  /// ```
  hint -> String | Nil => @primitive

  /// Return the error kind as a symbol.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [1 / 0] on: Exception do: [:e | e kind]
  /// ```
  kind -> Symbol => @primitive

  /// Return the message selector that triggered the error, or nil.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [42 unknownMsg] on: Exception do: [:e | e selector]
  /// ```
  selector -> Symbol | Nil => @primitive

  /// Return the name of the class where the error occurred, as a Symbol
  /// (like `kind` and `selector`). Send `asString` for a String.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [42 unknownMsg] on: Exception do: [:e | e errorClass]   // => #Integer
  /// [42 unknownMsg] on: Exception do: [:e | e errorClass asString]   // => "Integer"
  /// ```
  errorClass -> Symbol => @primitive

  /// Return the underlying Erlang error term, or nil if none was recorded.
  ///
  /// Set when this exception wraps a raw Erlang `error`/`exit`/`throw`
  /// (e.g. `badarith`, `{badkey, K}`) or the `Reason` of an `{error, Reason}`
  /// returned from an FFI call (ADR 0076), so handlers can match on the term
  /// itself (`#closed` vs `#econnreset`) instead of string-comparing
  /// `message`. Exceptions raised by `Error signal:` / `self error:` record
  /// no term and return nil; some stdlib natives (e.g. File I/O errors) also
  /// record the underlying OTP reason. FFI results pass through
  /// the usual boundary coercions first (an Erlang charlist reason arrives as
  /// a String, a bare `error` return as nil).
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Erlang string to_integer: "abc") error reason   // => #no_integer
  /// [#(1, "x") sum] on: TypeError do: [:e | e reason] // => #badarith
  /// [Error signal: "boom"] on: Error do: [:e | e reason] // => nil
  /// ```
  reason -> Object | Nil => @primitive

  /// Return the structured details recorded with this error, keyed by Symbol.
  ///
  /// Natives record machine-readable context here alongside the rendered
  /// `message`, e.g. the byte `#offset` of an invalid UTF-8 sequence, a
  /// `#path`, or the `#expected`/`#got` of an arity mismatch. Read a value
  /// with `at:` instead of parsing `message`. Answers an empty Dictionary when
  /// nothing was recorded. A nested Beamtalk error answers as an Exception,
  /// and an absent (Erlang `undefined`) value as nil. Other values are the
  /// recorded terms as-is: text a native records as raw bytes, such as a File
  /// error's `#path`, answers a `Binary`; send it `asString` for a `String`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 255)) asString error details   // => #{#offset => 1}
  /// [Error signal: "boom"] on: Error do: [:e | e details]     // => #{}
  /// ```
  details -> Dictionary(Symbol, Object) => @primitive

  // === Printing ===

  /// Return a developer-readable string representation of the error.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [42 unknownMsg] on: Exception do: [:e | e printString]
  /// ```
  printString -> String => @primitive

  // === Stack trace ===

  /// Return the stack trace as a list of StackFrame objects.
  ///
  /// Only available when the exception was caught via `on:do:`.
  /// Returns an empty list if no stacktrace was captured.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [1 / 0] on: Exception do: [:e | e stackTrace]
  /// ```
  stackTrace -> List(StackFrame) => @primitive

  // === Raising ===

  /// Raise this exception.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Exception new) signal
  /// ```
  signal -> Never => @primitive

  /// Re-raise this caught exception unchanged (BT-4057).
  ///
  /// Unlike `signal`, which always raises a fresh `error` with a new
  /// stacktrace, `pass` keeps the original Erlang class (`error`, `exit` or
  /// `throw`), reason and call sites. Use it in an `on:do:` handler to hand
  /// the exception to an outer handler, or let it propagate as the original
  /// failure. On an exception that was never caught (`Exception new pass`)
  /// it behaves like `signal`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// [(Erlang erlang) exit: #normal] on: Exception do: [:e | e pass]
  /// ```
  pass -> Never => @primitive

  /// Raise this exception instance with the given message.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Exception new) signal: "something went wrong"
  /// ```
  signal: msg :: String -> Never => @primitive
