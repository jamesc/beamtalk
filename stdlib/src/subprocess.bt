/// Subprocess — Actor for interactive bidirectional communication with OS processes.
///
/// Backed by `beamtalk_subprocess.erl` (hand-written gen_server). State — port,
/// stdout/stderr queues, exitCode, portClosed flag — lives entirely in the Erlang
/// gen_server; there are no Beamtalk-level state: declarations.
///
/// ## Basic usage
///
/// ```beamtalk
/// agent := (Subprocess open: "echo" args: #("hello")) unwrap
/// line := agent readLine.   // => "hello"
/// agent exitCode.           // => 0
/// agent close.
/// ```
///
/// ## Environment and working directory
///
/// ```beamtalk
/// agent := Subprocess open: "make" args: #("test")
///   env: #{#"CI" => #"true"}
///   dir: "/path/to/project"
/// ```
///
/// ## Streaming stdout
///
/// ```beamtalk
/// agent lines do: [:line | Transcript show: line]
/// ```
///
/// @see ReactiveSubprocess (for push-mode async delivery)
/// @see System (for simple one-shot commands via osCmd:)
typed Actor subclass: Subprocess native: beamtalk_subprocess

  /// Convenience factory — open a subprocess with command and args.
  ///
  /// Returns a Result wrapping the Subprocess actor on success, or an error
  /// if the process could not be started (e.g. binary not found).
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent := (Subprocess open: "ls" args: #("-la")) unwrap
  /// ```
  class open: command :: String args: args :: List(String) -> Result(Subprocess, Exception) =>
    Result tryDo: [self spawnWith: #{#executable => command, #args => args}]

  /// Convenience factory — open a subprocess with command, args, and working directory.
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent := (Subprocess open: "ls" args: #("-la") dir: "/tmp") unwrap
  /// ```
  class open: command :: String args: args :: List(String) dir: dir :: String -> Result(Subprocess, Exception) =>
    Result tryDo: [
      self spawnWith: #{#executable => command, #args => args, #dir => dir}
    ]

  /// Convenience factory — open a subprocess with command, args, environment, and working directory.
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent := (Subprocess open: "make" args: #("test") env: #{#"CI" => #"true"} dir: "/tmp") unwrap
  /// ```
  class open: command :: String args: args :: List(String) env: env :: Dictionary dir: dir :: String -> Result(Subprocess, Exception) =>
    Result
      tryDo: [
        self spawnWith: #{
          #executable => command,
          #args => args,
          #env => env,
          #dir => dir
        }
      ]

  // === Writing ===

  /// Write a line to the subprocess's stdin (appends newline).
  ///
  /// Returns `nil` once the line is in the child's stdin pipe. It does not
  /// wait for the child to read it, but it does wait while the pipe is full
  /// (the child is not reading), so a call to a stalled child can time out
  /// like any actor call. Its line then stays queued and may still be
  /// written, so do not resend it on a timeout.
  ///
  /// The `writeLine:` whose line does not reach the pipe raises a
  /// `runtime_error` saying the line was not written (the reason is in its
  /// hint), and so does every later `writeLine:`. That happens when the child
  /// exited or closed its input before taking the line (and then every line
  /// still queued behind it raises too), or when more than 8 MiB from other
  /// callers is already waiting for a child that is not reading.
  ///
  /// A `writeLine:` still waiting when the subprocess is closed, or exits
  /// with the line unreported (its pipe full and held open by a process that
  /// does not read it), raises `port_closed`.
  ///
  /// No caller is told `nil` for a line that is lost before reaching the
  /// pipe. A line the child has not read yet when it exits is lost after
  /// `nil`, as with any pipe: `nil` means written, not read.
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent writeLine: "\{\"jsonrpc\":\"2.0\",\"method\":\"ping\"}"
  /// ```
  writeLine: data :: String -> Nil => self delegate

  // === Reading ===

  /// Read one line from stdout. Blocks until a line is available. Returns nil at EOF.
  ///
  /// ## Examples
  /// ```beamtalk
  /// line := agent readLine.   // => "hello" or nil
  /// ```
  readLine -> String | Nil => self delegate

  /// Read one line from stdout with a timeout in milliseconds. Returns nil on timeout or EOF.
  ///
  /// ## Examples
  /// ```beamtalk
  /// line := agent readLine: 5000.   // => String or nil
  /// ```
  readLine: timeout :: Integer -> String | Nil => self delegate

  /// Read one line from stderr. Blocks until a line is available. Returns nil at EOF.
  ///
  /// ## Examples
  /// ```beamtalk
  /// errLine := agent readStderrLine.
  /// ```
  readStderrLine -> String | Nil => self delegate

  /// Read one line from stderr with a timeout in milliseconds. Returns nil on timeout or EOF.
  ///
  /// ## Examples
  /// ```beamtalk
  /// errLine := agent readStderrLine: 5000.
  /// ```
  readStderrLine: timeout :: Integer -> String | Nil => self delegate

  /// Return a Stream of stdout lines. Each step sends a sync message to the actor.
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent lines do: [:line | Transcript show: line]
  /// ```
  lines -> Stream(String) => self delegate

  /// Return a Stream of stderr lines. Same mechanics as lines.
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent stderrLines do: [:line | Transcript show: line]
  /// ```
  stderrLines -> Stream(String) => self delegate

  // === Lifecycle ===

  /// Get the exit code. Returns nil if the subprocess is still running.
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent exitCode.   // => 0
  /// ```
  exitCode -> Integer | Nil => self delegate

  /// Force-close the subprocess (sends kill to process group).
  ///
  /// ## Examples
  /// ```beamtalk
  /// agent close.
  /// ```
  close -> Nil => self delegate
