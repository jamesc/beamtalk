/// The OTP primary log level severities that `Logger logLevel:` accepts.
type LogLevel = #emergency | #alert | #critical | #error | #warning | #notice | #info | #debug
/// The log output format on the file handler.
type LogFormat = #text | #json
/// Logger — structured logging via Erlang's logger.
///
/// Provides class methods for logging at standard severity levels,
/// with optional structured metadata. All methods are class-side —
/// Logger has no instances. Output formatting and routing are handled
/// by Erlang's logger handlers. Logger is a sealed, stateless class-side
/// facade, so runtime logging configuration (`logLevel:`, `logFormat:`,
/// `enableDebug:`, ...) works identically in the REPL, `run`, `test` and
/// releases.
///
/// ## Examples
/// ```beamtalk
/// Logger info: "service started"
/// // => nil
/// Logger warn: "retrying" metadata: #{"attempt" => 3}
/// // => nil
/// Logger error: "connection failed"
/// // => nil
/// Logger debug: "trace detail"
/// // => nil
/// ```
sealed typed Object subclass: Logger

  // === Info ===

  /// Log a message at info level.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger info: "request processed"
  /// // => nil
  /// ```
  class sealed info: message :: String -> Nil => @intrinsic loggerInfo

  /// Log a message at info level with structured metadata.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger info: "request processed" metadata: #{"path" => "/api"}
  /// // => nil
  /// ```
  class sealed info: message :: String metadata: meta :: Dictionary -> Nil =>
    @intrinsic loggerInfoMeta

  // === Warning ===

  /// Log a message at warning level.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger warn: "retrying operation"
  /// // => nil
  /// ```
  class sealed warn: message :: String -> Nil => @intrinsic loggerWarn

  /// Log a message at warning level with structured metadata.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger warn: "retrying" metadata: #{"attempt" => 2}
  /// // => nil
  /// ```
  class sealed warn: message :: String metadata: meta :: Dictionary -> Nil =>
    @intrinsic loggerWarnMeta

  // === Error ===

  /// Log a message at error level.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger error: "connection lost"
  /// // => nil
  /// ```
  class sealed error: message :: String -> Nil => @intrinsic loggerError

  /// Log a message at error level with structured metadata.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger error: "failed" metadata: #{"reason" => "timeout"}
  /// // => nil
  /// ```
  class sealed error: message :: String metadata: meta :: Dictionary -> Nil =>
    @intrinsic loggerErrorMeta

  // === Debug ===

  /// Log a message at debug level.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger debug: "entering loop"
  /// // => nil
  /// ```
  class sealed debug: message :: String -> Nil => @intrinsic loggerDebug

  /// Log a message at debug level with structured metadata.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger debug: "state" metadata: #{"count" => 42}
  /// // => nil
  /// ```
  class sealed debug: message :: String metadata: meta :: Dictionary -> Nil =>
    @intrinsic loggerDebugMeta

  // === Logging configuration (delegates to beamtalk_logging_config) ===

  /// Return the current OTP primary log level as a singleton symbol
  /// (e.g. `#debug`, `#info`, or the `#all`/`#none` sentinels).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger logLevel
  /// ```
  class sealed logLevel -> LogLevel | #all | #none =>
    (Erlang beamtalk_logging_config) logLevel

  /// Set the OTP primary log level.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger logLevel: #debug
  /// ```
  class sealed logLevel: level :: LogLevel -> Nil =>
    (Erlang beamtalk_logging_config) logLevel: level

  /// Return the current log format as a singleton symbol (`#text` or `#json`).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger logFormat
  /// ```
  class sealed logFormat -> LogFormat =>
    (Erlang beamtalk_logging_config) logFormat

  /// Switch the log format on the file handler.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger logFormat: #json
  /// Logger logFormat: #text
  /// ```
  class sealed logFormat: format :: LogFormat -> Nil =>
    (Erlang beamtalk_logging_config) logFormat: format

  /// Return the list of available debug target symbols.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger debugTargets
  /// ```
  class sealed debugTargets -> List(Symbol) =>
    (Erlang beamtalk_logging_config) debugTargets

  /// Enable debug logging for a subsystem, class, or actor instance.
  ///
  /// Accepts symbols (#actor, #compiler, ...), class references (Counter),
  /// or actor instances (myCounter).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger enableDebug: #actor
  /// Logger enableDebug: Counter
  /// Logger enableDebug: myCounter
  /// ```
  class sealed enableDebug: target :: Object -> Nil =>
    (Erlang beamtalk_logging_config) enableDebug: target

  /// Disable debug logging for a subsystem, class, or actor instance.
  ///
  /// Accepts symbols (#actor, #compiler, ...), class references (Counter),
  /// or actor instances (myCounter).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger disableDebug: #actor
  /// Logger disableDebug: Counter
  /// Logger disableDebug: myCounter
  /// ```
  class sealed disableDebug: target :: Object -> Nil =>
    (Erlang beamtalk_logging_config) disableDebug: target

  /// Return the list of currently enabled debug targets.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger activeDebugTargets
  /// ```
  class sealed activeDebugTargets -> List(Symbol) =>
    (Erlang beamtalk_logging_config) activeDebugTargets

  /// Disable all debug targets.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger disableAllDebug
  /// ```
  class sealed disableAllDebug -> Nil =>
    (Erlang beamtalk_logging_config) disableAllDebug

  /// Return a formatted description of the current logger state.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Logger loggerInfo
  /// ```
  ///
  /// BT-2829: the FFI spec types the result `binary()` (`String | Binary`,
  /// BT-2254) — suppress the resulting return-type mismatch against `String`.
  @expect type
  class sealed loggerInfo -> String =>
    (Erlang beamtalk_logging_config) loggerInfo
