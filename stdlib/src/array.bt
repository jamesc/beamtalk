/// Array — Fixed-size indexed collection with O(log n) random access.
///
/// Arrays are immutable sequences backed by Erlang's `array` module.
/// Use Array when you need efficient random access by index and the
/// size is known up front. Literal syntax: `#[elem, ...]`.
///
/// Unlike `List` (linked list, O(1) prepend) and `Tuple` (Erlang FFI
/// interop), `Array` is the right choice for general-purpose indexed
/// sequences in Beamtalk code.
///
/// ## BEAM Mapping
/// Backed by an Erlang `array` record wrapped in a tagged map:
/// `#{'$beamtalk_class' => 'Array', 'data' => ErlangArray}`.
///
/// ## Examples
/// ```beamtalk
/// #[1, 2, 3] class            // => Array
/// #[1, 2, 3] size             // => 3
/// #[10, 20, 30] at: 2         // => 20
/// #[1, 2, 3] collect: [:x | x * 2]  // => #[2, 4, 6]
/// ```
sealed typed Collection(E) subclass: Array(E)

  /// Create an Array from a list of elements.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Array withAll: #(1, 2, 3)   // => #[1, 2, 3]
  /// ```
  class withAll: list :: List(E) -> Array(E) => @primitive

  /// Create an Array from a list. Convenience alias for `withAll:`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Array new: #(1, 2, 3)            // => #[1, 2, 3]
  /// ```
  class new: elements :: List(E) -> Array(E) => self withAll: elements

  // === Accessing ===

  /// Number of elements in the array.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] size              // => 3
  /// #[] size                     // => 0
  /// ```
  size -> Integer => @primitive no_user_code

  /// Test if the array has no elements.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[] isEmpty                  // => true
  /// #[1] isEmpty                 // => false
  /// ```
  isEmpty -> Boolean => @primitive no_user_code

  /// Return the element at the given 1-based index.
  ///
  /// Raises `index_out_of_bounds` if the index is out of range.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[10, 20, 30] at: 2          // => 20
  /// #[10, 20, 30] at: 1          // => 10
  /// ```
  at: index :: Integer -> E => @primitive

  /// Return the first element of the array.
  ///
  /// Raises `empty_collection` if the array is empty — there is no element
  /// to answer. Guard with `isEmpty` before calling.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[10, 20, 30] first          // => 10
  /// ```
  first -> E => @primitive

  /// Return the last element of the array.
  ///
  /// Raises `empty_collection` if the array is empty (see `first`).
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[10, 20, 30] last           // => 30
  /// ```
  last -> E => @primitive

  /// Return a new array with the element at `index` replaced by `value`.
  ///
  /// Raises `index_out_of_bounds` if the index is out of range.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (#[1, 2, 3] at: 2 put: 99)  // => #[1, 99, 3]
  /// ```
  at: index :: Integer put: value :: E -> Array(E) => @primitive

  /// Test if the array contains the given element.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] includes: 2       // => true
  /// #[1, 2, 3] includes: 9       // => false
  /// ```
  includes: element :: Object -> Boolean => @primitive

  // === Enumerating ===

  /// Iterate over each element, evaluating `block` with each one.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] do: [:x | Transcript show: x]
  /// ```
  do: block :: Block(E, Object) -> Nil => @primitive

  // === Conversions ===

  /// An Array is already an Array — identity override of `Collection>>asArray`.
  asArray -> Array(E) => self

  // === Transforming ===

  /// Map a block over the array, returning a new Array.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] collect: [:x | x * 2]   // => #[2, 4, 6]
  /// ```
  collect: block :: Block(E, R) -> Array(R) => @primitive

  /// Select elements for which `block` returns true, returning a new Array.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3, 4] select: [:x | x > 2]  // => #[3, 4]
  /// ```
  select: block :: Block(E, Boolean) -> Array(E) => @primitive

  /// Reduce the array with an accumulator.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] inject: 0 into: [:acc :x | acc + x]   // => 6
  /// ```
  inject: initial :: A into: block :: Block(A, E, A) -> A => @primitive

  // === Order-dependent reads (BT-5090) ===
  //
  // Array is an indexed peer of List for reading, not for growing: it answers
  // the order-dependent selectors below but has no `add:` or `addFirst:`.
  // Each calls a `beamtalk_array` helper directly (the FFI call is a plain
  // remote call), so no existing send path changes.

  /// Return a new Array with the elements in reverse order.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] reversed          // => #[3, 2, 1]
  /// ```
  reversed -> Array(E) => (Erlang beamtalk_array) reversed: self

  /// Return the 1-based index of the first element equal to `item`, or `nil`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[10, 20, 30] indexOf: 20    // => 2
  /// #[10, 20, 30] indexOf: 99    // => nil
  /// ```
  indexOf: item :: Object -> Integer | Nil =>
    (Erlang beamtalk_array) indexOf: self item: item

  /// Return a new Array of the first `n` elements. Total: answers fewer when
  /// the array is shorter. Raises `type_error` for a negative or non-Integer `n`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3, 4] take: 2        // => #[1, 2]
  /// #[1, 2] take: 5              // => #[1, 2]
  /// ```
  take: n :: Integer -> Array(E) => (Erlang beamtalk_array) take: self count: n

  /// Return a new Array without the first `n` elements. Total, like `take:`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3, 4] drop: 2        // => #[3, 4]
  /// #[1, 2] drop: 5              // => #[]
  /// ```
  drop: n :: Integer -> Array(E) => (Erlang beamtalk_array) drop: self count: n

  /// Return a new Array sorted by Erlang term order.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[3, 1, 2] sort              // => #[1, 2, 3]
  /// ```
  sort -> Array(E) => (Erlang beamtalk_array) sort: self

  /// Return a new Array sorted by `comparator`, which answers true when its
  /// first argument sorts at or before its second.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[3, 1, 2] sort: [:a :b | a > b]   // => #[3, 2, 1]
  /// ```
  sort: comparator :: Block(E, E, Boolean) -> Array(E) =>
    (Erlang beamtalk_array) sort: self with: comparator

  // === Printing ===

  /// Return a developer-readable string representation.
  ///
  /// ## Examples
  /// ```beamtalk
  /// #[1, 2, 3] printString       // => "#[1, 2, 3]"
  /// ```
  printString -> String => @primitive
