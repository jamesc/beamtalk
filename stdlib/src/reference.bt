/// Reference — BEAM unique reference.
///
/// References are opaque unique values created by `Reference new`
/// (`erlang:make_ref/0`). They also appear when calling Erlang code that
/// generates references for correlation or identification. References
/// support basic Object protocol methods for inspection and comparison.
///
/// ## BEAM Mapping
/// Beamtalk References map directly to Erlang references.
///
/// ## Examples
/// ```beamtalk
/// ref class              // => Reference
/// ref printString        // => "#Ref<0.1.2.3>"
/// tag := Reference new   // a fresh, unique Reference
/// ```
sealed typed Object subclass: Reference

  // === Construction ===

  /// Create a fresh, unique Reference (`erlang:make_ref/0`).
  ///
  /// Every call answers a Reference unequal to every other one, so it makes
  /// a good correlation tag, for example to match a timer or reply message
  /// to the request that started it. References can be Dictionary keys.
  ///
  /// ## Examples
  /// ```beamtalk
  /// tag := Reference new
  /// tag class                          // => Reference
  /// Reference new =:= Reference new    // => false
  /// ```
  class sealed new -> Reference => @primitive

  /// Convert the reference to a readable string representation.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref asString           // => "#Ref<0.1.2.3>"
  /// ```
  asString -> String => @primitive

  /// Return a developer-readable string representation.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref printString        // => "#Ref<0.1.2.3>"
  /// ```
  printString -> String => self asString

  // === Comparison ===

  /// Test strict equality with another reference.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref1 =:= ref2         // => false
  /// ```
  =:= other -> Boolean => @primitive

  /// Test strict inequality with another reference.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref1 =/= ref2          // => true
  /// ```
  =/= other -> Boolean => @primitive

  /// Test inequality with another reference.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref1 /= ref2          // => true
  /// ```
  /= other -> Boolean => @primitive

  // === Monitoring & Hashing ===

  /// Cancel a monitor associated with this reference.
  ///
  /// If this reference was returned by `Actor>>monitor`, calling `demonitor`
  /// prevents future `DOWN` messages from being delivered. Note that a `DOWN`
  /// message already in the caller's mailbox is not removed — use
  /// `Erlang erlang demonitor: ref arg: #(#flush)` if you need to flush it.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref := actor monitor
  /// ref demonitor          // => true
  /// ```
  demonitor -> Boolean => @primitive

  /// Return a hash value for the reference.
  hash -> Integer => @primitive
