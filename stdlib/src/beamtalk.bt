/// The OTP primary log level severities that `Beamtalk logLevel:` accepts.
type LogLevel = #emergency | #alert | #critical | #error | #warning | #notice | #info | #debug
/// The log output format on the file handler.
type LogFormat = #text | #json
/// Beamtalk — class registry, help, release reflection and logging control.
///
/// `Beamtalk` is a sealed, stateless class whose API is entirely class-side, so
/// it works identically in the REPL, `beamtalk run`, `beamtalk test` and
/// releases (ADR 0129). It plays the role of Smalltalk's `Smalltalk` global.
///
/// ## Examples
/// ```beamtalk
/// Beamtalk version
/// Beamtalk allClasses
/// Beamtalk classNamed: #Integer
/// ```
sealed typed Object subclass: Beamtalk native: beamtalk_interface

  /// Return this node's release provenance (`beamtalk-provenance.json`) as a
  /// Dictionary. On a non-release (`run`/`workspace`) node, returns
  /// `#{#release => nil}` — never an error.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk releaseInfo
  /// ```
  class sealed releaseInfo -> Dictionary => (Erlang beamtalk_release) info

  /// Return `className -> #{#version, #fields, #migrations}` for every
  /// registered project class (ADR 0125 §3.4) — the live-node twin of a
  /// release's `releases/<vsn>/shapes.json` (BT-3571), built from the same
  /// projection.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk shapeManifest
  /// ```
  class sealed shapeManifest -> Dictionary =>
    (Erlang beamtalk_release) shapeManifest

  // === Class registry ===

  /// Return a list of all registered classes as class objects.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk allClasses
  /// ```
  class sealed allClasses -> List(Class) => self delegate

  /// Look up a class by name (symbol).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk classNamed: #Integer
  /// ```
  class sealed classNamed: className :: Symbol -> Class | Nil => self delegate

  // === Help and documentation ===

  /// Show class documentation: name, superclass, and method signatures.
  /// Accepts a Class reference, a Symbol class name, or a String class name.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk help: Counter
  /// Beamtalk help: #Counter
  /// ```
  class sealed help: aClass :: Object -> String => self delegate

  /// Show detailed documentation for a specific method on a class.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk help: Counter selector: #increment
  /// ```
  class sealed help: aClass :: Class selector: aSelector :: Symbol -> String =>
    self delegate

  /// Show documentation for an Erlang module: type signatures and EEP-48 docs.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk erlangHelp: "lists"
  /// Beamtalk erlangHelp: "maps"
  /// ```
  class sealed erlangHelp: moduleName :: String -> String => self delegate

  /// Show documentation for a specific function in an Erlang module.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk erlangHelp: "lists" selector: #reverse
  /// Beamtalk erlangHelp: "maps" selector: #get
  /// ```
  class sealed erlangHelp: moduleName :: String selector: functionName :: Symbol -> String =>
    self delegate

  /// Return the Beamtalk version string.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk version
  /// ```
  class sealed version -> String => self delegate

  // === Logging configuration (delegates to beamtalk_logging_config) ===

  /// Return the current OTP primary log level as a singleton symbol
  /// (e.g. `#debug`, `#info`, or the `#all`/`#none` sentinels).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk logLevel
  /// ```
  class sealed logLevel -> LogLevel | #all | #none =>
    (Erlang beamtalk_logging_config) logLevel

  /// Set the OTP primary log level.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk logLevel: #debug
  /// ```
  class sealed logLevel: level :: LogLevel -> Nil =>
    (Erlang beamtalk_logging_config) logLevel: level

  /// Return the current log format as a singleton symbol (`#text` or `#json`).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk logFormat
  /// ```
  class sealed logFormat -> LogFormat =>
    (Erlang beamtalk_logging_config) logFormat

  /// Switch the log format on the file handler.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk logFormat: #json
  /// Beamtalk logFormat: #text
  /// ```
  class sealed logFormat: format :: LogFormat -> Nil =>
    (Erlang beamtalk_logging_config) logFormat: format

  /// Return the list of available debug target symbols.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk debugTargets
  /// ```
  class sealed debugTargets -> List(Symbol) =>
    (Erlang beamtalk_logging_config) debugTargets

  /// Enable debug logging for a subsystem, class, or actor instance.
  ///
  /// Accepts symbols (#actor, #compiler, ...), class references (Counter),
  /// or actor instances (myCounter).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk enableDebug: #actor
  /// Beamtalk enableDebug: Counter
  /// Beamtalk enableDebug: myCounter
  /// ```
  class sealed enableDebug: target :: Object -> Nil =>
    (Erlang beamtalk_logging_config) enableDebug: target

  /// Disable debug logging for a subsystem, class, or actor instance.
  ///
  /// Accepts symbols (#actor, #compiler, ...), class references (Counter),
  /// or actor instances (myCounter).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk disableDebug: #actor
  /// Beamtalk disableDebug: Counter
  /// Beamtalk disableDebug: myCounter
  /// ```
  class sealed disableDebug: target :: Object -> Nil =>
    (Erlang beamtalk_logging_config) disableDebug: target

  /// Return the list of currently enabled debug targets.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk activeDebugTargets
  /// ```
  class sealed activeDebugTargets -> List(Symbol) =>
    (Erlang beamtalk_logging_config) activeDebugTargets

  /// Disable all debug targets.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk disableAllDebug
  /// ```
  class sealed disableAllDebug -> Nil =>
    (Erlang beamtalk_logging_config) disableAllDebug

  /// Return a formatted description of the current logger state.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk loggerInfo
  /// ```
  ///
  /// BT-2829: the FFI spec types the result `binary()` (`String | Binary`,
  /// BT-2254) — suppress the resulting return-type mismatch against `String`.
  @expect type
  class sealed loggerInfo -> String =>
    (Erlang beamtalk_logging_config) loggerInfo
