/// Beamtalk — class registry, help and release reflection.
///
/// `Beamtalk` is a sealed, stateless class whose API is entirely class-side, so
/// it works identically in the REPL, `beamtalk run`, `beamtalk test` and
/// releases (ADR 0129). It plays the role of Smalltalk's `Smalltalk` global.
///
/// ## Examples
/// ```beamtalk
/// Beamtalk version
/// Beamtalk allClasses
/// Beamtalk classNamed: #Integer
/// ```
sealed typed Object subclass: Beamtalk native: beamtalk_interface

  /// Return this node's release provenance (`beamtalk-provenance.json`) as a
  /// Dictionary. On a non-release (`run`/`workspace`) node, returns
  /// `#{#release => nil}` — never an error.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk releaseInfo
  /// ```
  class sealed releaseInfo -> Dictionary => (Erlang beamtalk_release) info

  /// Return `className -> #{#version, #fields, #migrations}` for every
  /// registered project class (ADR 0125 §3.4) — the live-node twin of a
  /// release's `releases/<vsn>/shapes.json` (BT-3571), built from the same
  /// projection.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk shapeManifest
  /// ```
  class sealed shapeManifest -> Dictionary =>
    (Erlang beamtalk_release) shapeManifest

  // === Class registry ===

  /// Return a list of all registered classes as class objects.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk allClasses
  /// ```
  class sealed allClasses -> List(Class) => self delegate

  /// Look up a class by name (symbol).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk classNamed: #Integer
  /// ```
  class sealed classNamed: className :: Symbol -> Class | Nil => self delegate

  // === Help and documentation ===

  /// Show class documentation: name, superclass, and method signatures.
  /// Accepts a Class reference, a Symbol class name, or a String class name.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk help: Counter
  /// Beamtalk help: #Counter
  /// ```
  class sealed help: aClass :: Object -> String => self delegate

  /// Show detailed documentation for a specific method on a class.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk help: Counter selector: #increment
  /// ```
  class sealed help: aClass :: Class selector: aSelector :: Symbol -> String =>
    self delegate

  /// Show documentation for an Erlang module: type signatures and EEP-48 docs.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk erlangHelp: "lists"
  /// Beamtalk erlangHelp: "maps"
  /// ```
  class sealed erlangHelp: moduleName :: String -> String => self delegate

  /// Show documentation for a specific function in an Erlang module.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk erlangHelp: "lists" selector: #reverse
  /// Beamtalk erlangHelp: "maps" selector: #get
  /// ```
  class sealed erlangHelp: moduleName :: String selector: functionName :: Symbol -> String =>
    self delegate

  /// Return the Beamtalk version string.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Beamtalk version
  /// ```
  class sealed version -> String => self delegate
