/// Pid — BEAM process identifier.
///
/// Pids are opaque references to Erlang/OTP processes. They appear when
/// calling Erlang code or inspecting the runtime. Pids support basic
/// Object protocol methods for inspection and comparison.
///
/// ## BEAM Mapping
/// Beamtalk Pids map directly to Erlang pids.
///
/// ## Examples
/// ```beamtalk
/// pid class              // => Pid
/// pid printString        // => "#Pid<0.123.0>"
/// pid isAlive            // => true or false
/// Pid current            // => the calling process
/// ```
sealed typed Object subclass: Pid

  // === Current Process ===

  /// The calling process (`erlang:self/0`).
  ///
  /// Inside an actor method this is the actor's own process — the same pid
  /// as `self pid`. It covers the places where there is no `self pid`: a
  /// Value method called from an actor, or plain concurrent code. There is
  /// no `Process` class; this one method does not justify minting one.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Pid current              // => Pid
  /// Pid current isAlive      // => true
  /// ```
  class sealed current -> Pid => (Erlang beamtalk_process_ops) current

  /// Convert the pid to a readable string representation.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid asString           // => "#Pid<0.123.0>"
  /// ```
  asString -> String => @primitive

  /// Return a developer-readable string representation.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid printString        // => "#Pid<0.123.0>"
  /// ```
  printString -> String => self asString

  // === Comparison ===

  /// Test strict equality with another pid.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid1 =:= pid2          // => false
  /// ```
  =:= other -> Boolean => @primitive

  /// Test strict inequality with another pid.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid1 =/= pid2           // => true
  /// ```
  =/= other -> Boolean => @primitive

  /// Test inequality with another pid.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid1 /= pid2           // => true
  /// ```
  /= other -> Boolean => @primitive

  /// Return a hash value for the pid.
  hash -> Integer => @primitive

  // === Distribution ===

  /// The Node this process lives on (`erlang:node/1`, ADR 0126 §2).
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid node               // => Node(nonode@nohost)
  /// pid node isCurrent     // => true
  /// ```
  node -> Node => (Erlang beamtalk_node) ofPid: self

  // === Messaging ===

  /// Send `msg` to this process as a plain Erlang message (`erlang:send/2`).
  ///
  /// This is not a Beamtalk message send. `actor foo:` calls a method and
  /// `actor foo!` casts one; `pid send: msg` puts `msg` in the process's
  /// mailbox as a raw term, which a `Server` receives in `handleInfo:`.
  /// It is asynchronous and never fails: sending to a dead process is a
  /// silent no-op. Always returns `nil`.
  ///
  /// It lives on `Pid` only, not on `Actor`, so it never collides with a
  /// user-defined `send:` method; reach it through `actor pid`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// self pid send: #accept                     // => nil
  /// handler pid send: {#ready, sock, config}   // => nil
  /// ```
  sealed send: msg :: Object -> Nil =>
    (Erlang beamtalk_process_ops) send: self msg: msg

  // === Monitoring ===

  /// Monitor this process (`erlang:monitor(process, Pid)`).
  ///
  /// Answers a `Reference`; when the process exits, the monitoring process
  /// receives `{#DOWN, ref, #process, pid, reason}`, which a Server handles
  /// in `handleInfo:`. This is the same underlying call as
  /// `Actor>>monitor`, so the `DOWN` shape is uniform and one `handleInfo:`
  /// clause covers both. Monitoring a dead pid still delivers `DOWN`
  /// (reason `#noproc`). Cancel with `Reference>>demonitor`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ref := workerPid monitor
  /// ref class              // => Reference
  /// ref demonitor          // cancel the monitor
  /// ```
  sealed monitor -> Reference => (Erlang beamtalk_process_ops) monitor: self

  // === Process Control ===

  /// Test if the process referred to by this pid is alive.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid isAlive            // => true
  /// ```
  isAlive -> Boolean => @primitive

  /// Forcefully terminate the process (erlang:exit(Pid, kill)).
  ///
  /// The kill signal cannot be trapped by the target process.
  /// Returns true unconditionally (Erlang semantics).
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid kill               // => true
  /// ```
  kill -> Boolean => @primitive

  /// Send an exit signal with the given reason to the process.
  ///
  /// The target process will terminate unless it is trapping exits.
  /// Returns true unconditionally (Erlang semantics).
  ///
  /// ## Examples
  /// ```beamtalk
  /// pid exit: #shutdown    // => true
  /// ```
  exit: reason -> Boolean => @primitive
