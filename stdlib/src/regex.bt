/// A single PCRE compile flag. Pass a `List(RegexOption)` to
/// `from:options:` or `String matchesRegex:options:`.
type RegexOption = #caseless | #multiline | #dotall | #extended | #ungreedy
/// Regex — Compiled regular expressions via Erlang re module (PCRE2).
///
/// Provides compiled regex objects for efficient reuse and inspection.
/// String methods accept both String patterns (auto-compiled) and Regex objects.
///
/// ## Examples
/// ```beamtalk
/// pattern := (Regex from: "[0-9]+") unwrap
/// pattern source                              // => "[0-9]+"
/// pattern printString                         // => "Regex([0-9]+)"
/// "hello123" matchesRegex: pattern            // => true
/// "hello123" firstMatch: pattern              // => "123"
/// ```
///
/// ## Options
/// ```beamtalk
/// Regex from: "[a-z]+" options: #(#caseless)   // case-insensitive
/// ```
sealed typed Value subclass: Regex native: beamtalk_regex

  // ===== Class Methods — Construction =====

  /// Use 'Regex from: pattern' to create a Regex.
  class new: _ :: Object -> Object =>
    self error: "Use 'Regex from: pattern' to create a Regex"

  /// Compile a regex pattern string into a Regex object (class method).
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Regex from: "[0-9]+") unwrap              // => Regex([0-9]+)
  /// ```
  class sealed from: pattern :: String -> Result(Regex, Error) => self delegate

  /// Compile a regex pattern with PCRE options (class method).
  ///
  /// ## Arguments
  /// - `pattern` (String) — the PCRE pattern to compile.
  /// - `opts` (List(RegexOption), default `#()`) — compile flags.
  ///
  /// ## Options
  /// - `#caseless` — case-insensitive matching.
  /// - `#multiline` — `^` and `$` match at line breaks, not just the subject bounds.
  /// - `#dotall` — `.` also matches newlines.
  /// - `#extended` — ignore unescaped whitespace and `#` comments in the pattern.
  /// - `#ungreedy` — quantifiers are lazy by default.
  ///
  /// Unknown options raise `regex_error`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Regex from: "[a-z]+" options: #(#caseless)
  /// ```
  class sealed from: pattern :: String options: opts :: List(RegexOption) -> Result(Regex, Error) =>
    self delegate

  // ===== Instance Methods — Accessors =====

  /// Return the original pattern source string.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Regex from: "[0-9]+") source              // => "[0-9]+"
  /// ```
  source -> String => self delegate

  // ===== Instance Methods — Display =====

  /// Human-readable representation: Regex(pattern).
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Regex from: "[0-9]+") printString         // => "Regex([0-9]+)"
  /// ```
  printString -> String => self delegate
