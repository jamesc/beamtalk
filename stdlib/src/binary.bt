/// Binary — byte-level data and serialization.
///
/// Binary is a Collection of bytes. Each element is an Integer (0-255).
/// String is a subclass of Binary that adds grapheme-aware text operations.
///
/// ## BEAM Mapping
/// Beamtalk binaries map directly to Erlang binaries (`binary()`).
///
/// ## Examples
/// ```beamtalk
/// bin := Binary serialize: 42
/// Binary deserialize: bin             // => 42
/// Binary fromIolist: #("hello", " ", "world")
/// // => _
/// ```
sealed typed Collection subclass: Binary native: beamtalk_binary

  // === Class methods ===

  /// Serialize any value to a binary (class method).
  ///
  /// Converts a Beamtalk value to its binary representation using
  /// Erlang's external term format.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary serialize: 42) class name   // => "Binary"
  /// ```
  class sealed serialize: term :: Object -> Binary => self delegate

  /// Deserialize a binary back to the original value (class method).
  ///
  /// Uses safe mode to prevent atom table exhaustion from untrusted
  /// input. Atoms not already in the atom table will cause an error.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Binary deserialize: (Binary serialize: #(1, 2, 3))
  /// // => _
  /// ```
  class sealed deserialize: binary :: Binary -> Object => self delegate

  /// Convert an iolist to a flat binary (class method).
  ///
  /// An iolist is a (possibly nested) list of binaries and integers
  /// (0-255). This flattens it into a single binary.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Binary fromIolist: #("hello", " ", "world")
  /// // => _
  /// ```
  class sealed fromIolist: iolist :: Object -> Binary => self delegate

  /// Create a binary from a list of byte integers (0-255).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Binary fromBytes: #(104, 101, 108, 108, 111)   // => _
  /// ```
  class sealed fromBytes: bytes :: List(Integer) -> Binary => self delegate

  /// Build a Binary from an element list (class method).
  ///
  /// This is the `species` constructor `collect:`/`select:`/`reject:`
  /// answer through on a Binary receiver: block results assemble here.
  /// Elements follow iolist rules — byte Integers (0-255), Binaries,
  /// Strings (a String is its UTF-8 bytes), or nested lists of those;
  /// anything else raises `type_error`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Binary withAll: #(104, 105)   // => _
  /// ```
  class sealed withAll: elements :: List -> Binary =>
    Binary fromIolist: elements

  /// Deserialize a binary and return both the value and bytes consumed.
  ///
  /// Returns a tuple of (value, bytesConsumed). Useful for parsing
  /// concatenated ETF values from a binary stream.
  ///
  /// ## Examples
  /// ```beamtalk
  /// bin := Binary serialize: 42
  /// result := Binary deserializeWithUsed: bin
  /// result first    // => 42
  /// result second   // => bytes consumed
  /// ```
  class sealed deserializeWithUsed: binary :: Binary -> Tuple => self delegate

  /// Decode a standard (RFC 4648 §4) base64 string to a Binary.
  ///
  /// Returns a Result: success gives the decoded Binary, failure gives a
  /// structured error (malformed base64, e.g. wrong padding or invalid
  /// alphabet characters).
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBase64: "aGVsbG8=") unwrap asStringUnchecked   // => "hello"
  /// (Binary fromBase64: "not base64!!") isError                // => true
  /// ```
  class sealed fromBase64: str :: String -> Result(Binary, Error) =>
    self delegate

  /// Decode a URL-safe (RFC 4648 §5) base64 string to a Binary.
  ///
  /// Uses `-`/`_` in place of `+`/`/`. Returns a Result, as `fromBase64:`.
  /// Accepts both padded and unpadded input — the unpadded form is the one
  /// commonly used in JWTs (RFC 7515 §2) and PKCE challenges.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBase64Url: "aGVsbG8h") unwrap asStringUnchecked   // => "hello!"
  /// ```
  class sealed fromBase64Url: str :: String -> Result(Binary, Error) =>
    self delegate

  /// Decode a hexadecimal string to a Binary.
  ///
  /// Accepts upper- or lower-case hex digits. Returns a Result: failure
  /// covers odd length or non-hex-digit characters.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromHex: "68656c6c6f") unwrap asStringUnchecked   // => "hello"
  /// (Binary fromHex: "zz") isError                             // => true
  /// ```
  class sealed fromHex: str :: String -> Result(Binary, Error) => self delegate

  // === Collection subclass-responsibility methods ===

  /// Return the byte count of this binary.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary serialize: 42) size   // => _
  /// ```
  size -> Integer => @primitive no_user_code

  // Left as bare `Block` (not `Block(Integer, Object)`): String subclasses
  // Binary but overrides `do:` with grapheme-String elements, not bytes.
  // Parameterizing here would make String's override param type
  // (Block(String, Object)) incompatible with this one under the invariant
  // override check (BT-2826).

  /// Iterate over each byte (Integer 0-255), evaluating `block` with each one.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101)) do: [:b | Transcript show: b]
  /// ```
  do: block :: Block -> Nil => @primitive

  /// Return a developer-readable string representation.
  ///
  /// Displays hex representation for non-UTF-8 binaries, or quoted string
  /// for valid UTF-8 binaries.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101)) printString   // => _
  /// ```
  printString -> String => @primitive

  // === Byte-level access ===

  /// Return the byte value (0-255) at the given 1-based index.
  ///
  /// Raises `index_out_of_bounds` if the index is out of range.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101, 108)) at: 1   // => 104
  /// ```
  at: index :: Integer -> Integer => @primitive

  /// Return the byte value (0-255) at the given 0-based offset.
  ///
  /// Uses 0-based indexing to match Erlang's `binary:at/2`.
  /// Raises `index_out_of_bounds` if the offset is out of range.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101, 108)) byteAt: 0   // => 104
  /// ```
  byteAt: offset :: Integer -> Integer => @primitive

  // === Slicing and concatenation ===

  /// Return a zero-copy slice of this binary.
  ///
  /// Takes a 0-based offset and length. Raises `index_out_of_bounds`
  /// if the range is invalid.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(1, 2, 3, 4, 5)) part: 1 size: 3   // => _
  /// ```
  part: offset :: Integer size: length :: Integer -> Binary => @primitive

  /// Concatenate this binary with another binary.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(1, 2)) concat: (Binary fromBytes: #(3, 4))   // => _
  /// ```
  concat: other :: Binary -> Binary => @primitive

  // === Searching ===

  /// Test whether `needle` occurs as a contiguous byte sequence.
  ///
  /// Compares raw bytes, so it works on non-UTF-8 haystacks. An empty
  /// needle is always found (`true`), matching `String>>includesSubstring:`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ((Binary fromBytes: #(255, 13, 10, 0)) includesSubstring: (Binary fromBytes: #(13, 10))) // => true
  /// ((Binary fromBytes: #(255, 1)) includesSubstring: (Binary fromBytes: #(2)))              // => false
  /// ```
  includesSubstring: needle :: Binary -> Boolean => @primitive

  /// Return the 1-based byte index of the first occurrence of `needle`, or
  /// `nil` if it does not occur.
  ///
  /// Compares raw bytes, so it works on non-UTF-8 haystacks. The index is
  /// 1-based, like `at:` and `String>>indexOf:`. An empty needle answers
  /// `nil` (as `String>>indexOf:` does). A `String` receiver dispatches to
  /// `String>>indexOf:` (a grapheme index) instead; the two agree for ASCII.
  ///
  /// ## Examples
  /// ```beamtalk
  /// ((Binary fromBytes: #(255, 13, 10)) indexOf: (Binary fromBytes: #(13, 10))) // => 2
  /// ((Binary fromBytes: #(255, 1)) indexOf: (Binary fromBytes: #(2)))           // => nil
  /// ```
  indexOf: needle :: Binary -> Integer | Nil => @primitive

  // === Conversion ===

  /// Convert this binary to a list of byte integers (0-255).
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101)) toBytes   // => #(104, 101)
  /// ```
  toBytes -> List(Integer) => @primitive

  /// Validate UTF-8 and return a Result: `ok:` with the String on
  /// success, `error:` with a `parse_error` carrying the byte offset of
  /// the invalid sequence on failure.
  ///
  /// Every Binary dispatches here (class is construction type — no
  /// UTF-8 sniffing), so success is `Result ok:` uniformly. `String`
  /// overrides `asString` with `self` (the `Printable` contract: a
  /// String already *is* text, so no Result wrapper applies).
  ///
  /// ## Examples
  /// ```beamtalk
  /// ((Binary fromBytes: #(104, 101, 108, 108, 111)) asString) unwrap   // => "hello"
  /// ((Binary fromBytes: #(255, 254)) asString) isError                 // => true
  /// ```
  ///
  /// BT-4175: this deliberately widens `Collection>>asString -> String` (and
  /// `Printable`'s `asString -> String`) — a known unsoundness, so `:: Printable`
  /// / `:: Collection` code statically sees `String` but a Binary answers a
  /// `Result`. Suppress the override return-type warning here.
  @expect type
  asString -> Result(String, Error) => @primitive

  /// Return this binary as a String without UTF-8 validation.
  ///
  /// Use when you trust the source data is valid UTF-8.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101, 108, 108, 111)) asStringUnchecked   // => "hello"
  /// ```
  asStringUnchecked -> String => @primitive

  // === Encoding ===

  /// Encode as a standard (RFC 4648 §4) base64 string, with `=` padding.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101, 108, 108, 111)) asBase64   // => "aGVsbG8="
  /// ```
  asBase64 -> String => self delegate

  /// Encode as a URL-safe (RFC 4648 §5) base64 string, with `=` padding.
  ///
  /// Uses `-`/`_` in place of `+`/`/` so the result is safe to embed
  /// directly in a URL path or query component without further escaping.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(251, 239)) asBase64      // => "++8="
  /// (Binary fromBytes: #(251, 239)) asBase64Url   // => "--8="
  /// ```
  asBase64Url -> String => self delegate

  /// Encode as a lowercase hexadecimal string.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (Binary fromBytes: #(104, 101, 108, 108, 111)) asHex   // => "68656c6c6f"
  /// ```
  asHex -> String => self delegate
