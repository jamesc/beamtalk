/// DynamicSupervisor — Abstract base class for dynamic OTP supervision trees.
///
/// Subclass `DynamicSupervisor` to define a dynamic supervision tree: one
/// where children are added at runtime rather than declared at startup.
/// Override `childClass` to declare which actor class this pool manages.
///
/// Configuration (`childClass`, `maxChildren`, `childShutdown`,
/// `maxRestarts`, `restartWindow`) is instance-side and is read from the
/// pool being started, inside its own OTP `init/1` (ADR 0135 §2): `self` is
/// the pool and `self args` its start args (`nil` for `supervise`), so each
/// pool can compute its own child class and limits. Do not send messages to
/// `self` from these methods (the start fails with
/// `#supervisor_start_failed`); see `Supervisor` for the full rules.
///
/// See ADR 0059 and ADR 0135 for the full design.
///
/// ## Examples
/// ```beamtalk
/// DynamicSupervisor(Worker) subclass: WorkerPool
///   childClass => Worker
///
/// pool := (WorkerPool supervise) unwrap
/// w := pool startChild unwrap   // => Worker (type-narrowed via C)
/// pool count   // => 1
/// ```
///
/// @see Supervisor (for static children declared at startup)
/// @see Actor (base class for supervised processes)
abstract Object subclass: DynamicSupervisor(C)

  // === Class-side ===

  /// Whether this class is a supervisor (always true for DynamicSupervisor subclasses).
  ///
  /// Used by `SupervisionSpec childSpec` to determine `type` and `shutdown`.
  class isSupervisor -> Boolean => true

  /// Default OTP restart policy when this pool is nested in another
  /// supervisor (ADR 0135 §3): `#permanent`, OTP's default for supervisor
  /// children.
  class supervisionPolicy -> RestartStrategy => #permanent

  /// Return a SupervisionSpec for nesting this pool in another supervisor,
  /// or for a pool of pools (`childClass => ThisPool`).
  ///
  /// Same contract as `Supervisor class>>supervisionSpec`: `type`
  /// `#supervisor`, shutdown `#infinity`, restart from `supervisionPolicy`;
  /// `withArgs:` gives the nested pool its `self args`.
  class supervisionSpec -> SupervisionSpec =>
    (SupervisionSpec new withActorClass: ((Erlang beamtalk_supervisor) classObject: self)) withRestart: self supervisionPolicy

  // === Class-side lifecycle ===
  //
  // `supervise` *ensures* the class's registered pool is running; the spawn
  // family *creates* a new pool per call (ADR 0135 §1). See `Supervisor` for
  // the full contract: the start runs in the caller, unlinked, and
  // instance-side `initialize` runs once per start.

  /// Start this dynamic supervisor (or return the already-running instance).
  ///
  /// ADR 0080 Phase 2 (BT-1999): returns `Result(Self, Error)`. Use
  /// `unwrap` for boot-style "crash on failure" call sites, or
  /// `ifOk:ifError:` / `andThen:` for recoverable starts. Failures surface
  /// as `Result error: #beamtalk_error{kind = supervisor_start_failed}`.
  class sealed supervise -> Result(Self, Error) =>
    (Erlang beamtalk_supervisor) startLink: self

  /// Start a new, anonymous pool with `nil` args. Raises
  /// `#supervisor_start_failed` when the start fails.
  ///
  /// ## Examples
  /// ```beamtalk
  /// a := WorkerPool spawn
  /// b := WorkerPool spawn
  /// a == b   // => false
  /// ```
  class sealed spawn -> Self => (Erlang beamtalk_supervisor) doSpawn: self

  /// Start a new, anonymous pool with start args (`self args`), so its
  /// `childClass`, `maxChildren` and `childShutdown` can differ per pool.
  class sealed spawnWith: args :: Object -> Self =>
    (Erlang beamtalk_supervisor) doSpawnWith: self args: args

  /// Start a new pool registered under a bounded `name` (ADR 0079). A taken
  /// name gives `Result error:` with kind `#name_registered`.
  class sealed spawnAs: name :: Symbol -> Result(Self, Error) =>
    (Erlang beamtalk_supervisor) doSpawnAs: self withName: name

  /// Start a new pool with start args, registered under `name`.
  class sealed spawnWith: args :: Object as: name :: Symbol -> Result(Self, Error) =>
    (Erlang beamtalk_supervisor)
      doSpawnWith: self
      args: args
      withName: name

  /// Look up a running pool registered under `name`: `#name_not_registered`,
  /// `#wrong_class` or `#type_error` on failure, as `Actor named:`.
  class named: name :: Symbol -> Result(Self, Error) =>
    (Erlang beamtalk_supervisor) named: self withName: name

  /// Return the running `supervise` pool, or nil if not started (spawned
  /// and nested pools are not `current`).
  class current -> Self | Nil => (Erlang beamtalk_supervisor) current: self

  // === Instance-side configuration (override in concrete subclasses) ===
  //
  // Read from the pool being started, inside its `init/1` (ADR 0135).

  /// Return the actor class that this dynamic supervisor manages.
  ///
  /// Must be overridden by concrete subclasses. Raises SubclassResponsibility
  /// otherwise. Read once per (re)start of the pool, so it may depend on
  /// `self args`.
  ///
  /// `startChild`, `startChild:` and `startChild:name:` return once the new
  /// child's `initialize` has returned; one that raises fails the start
  /// (`Result error:` with `#child_start_failed`). That `initialize` must not
  /// call this pool or an ancestor synchronously (the pool is waiting on it):
  /// make such calls from a `continueWith:` step.
  ///
  /// ## Examples
  /// ```beamtalk
  /// DynamicSupervisor(Worker) subclass: WorkerPool
  ///   childClass => Worker
  /// ```
  childClass -> Class => self subclassResponsibility

  /// Maximum number of restarts within `restartWindow` seconds.
  ///
  /// If this rate is exceeded, the supervisor itself shuts down.
  maxRestarts -> Integer => 10

  /// Time window in seconds for the `maxRestarts` rate limit.
  restartWindow -> Integer => 60

  /// Maximum number of live children, or `#infinity` (the default) for no limit.
  ///
  /// Once the pool holds this many children (`count`, plus any child whose
  /// automatic restart is pending), `startChild`, `startChild:` and
  /// `startChild:name:` return `Result error:` with kind `#max_children`
  /// (the error's details carry the limit) instead of starting a child.
  /// Callers can back off and retry; terminating a child frees a slot.
  /// Automatic restarts of existing children are never refused.
  ///
  /// Must be a non-negative Integer or `#infinity`. Any other value fails
  /// the pool's start once, inside its `init`: `supervise` returns
  /// `Result error:` (`#supervisor_start_failed`) carrying the validator's
  /// hint, and a pool nested under a static `Supervisor` fails that parent's
  /// start. Read each time the supervisor (re)starts, so it may depend on
  /// `self args`.
  ///
  /// The check is made by the caller just before the start, so it is exact
  /// when one process starts children (e.g. a single acceptor); concurrent
  /// starters can briefly overshoot the limit by up to the number racing.
  ///
  /// ## Examples
  /// ```beamtalk
  /// DynamicSupervisor(Worker) subclass: ConnectionPool
  ///   childClass => Worker
  ///   maxChildren -> Integer => 16384
  /// ```
  maxChildren -> Integer | Symbol => #infinity

  /// How long each child gets to stop when the pool shuts it down, or nil
  /// (the default) to use the child class's own `supervisionSpec` shutdown.
  ///
  /// An Integer (milliseconds), `#infinity` or `#brutalKill` (see
  /// `ShutdownTimeout`). On `stop` (or when a parent supervisor stops the
  /// pool) every child is sent `exit(Pid, shutdown)` at once; a child that
  /// has not exited within this time (one deadline shared by all children)
  /// is killed (exit reason `#killed`). `stop` waits for this, so a long
  /// value blocks its caller that long. nil keeps the
  /// child class's `supervisionSpec` value: 5000 ms (the OTP default) for an
  /// actor, unless its class overrides `supervisionSpec` with `withShutdown:`,
  /// and `#infinity` for a supervisor. Only a child that overrides `terminate:`
  /// traps exits, so only such a child uses the time. Keep `#infinity` for a
  /// supervisor child class: a finite value can kill it while it is still
  /// stopping its own children (the runtime logs a warning).
  ///
  /// The value applies to every child of the pool: OTP's
  /// `simple_one_for_one` keeps one child spec for all dynamic children, so
  /// there is no per-`startChild:` override. It is per pool instance, so it
  /// may depend on `self args`.
  ///
  /// Any other value fails the pool's start once, inside its `init`:
  /// `supervise` returns `Result error:` (`#supervisor_start_failed`)
  /// carrying the validator's hint, and a pool nested under a static
  /// `Supervisor` fails that parent's start. Read each time the supervisor
  /// (re)starts.
  ///
  /// ## Examples
  /// ```beamtalk
  /// DynamicSupervisor(Connection) subclass: ConnectionPool
  ///   childClass => Connection
  ///   childShutdown -> Integer => 15000   // let requests finish
  /// ```
  childShutdown -> ShutdownTimeout | Nil => nil

  /// The start args this pool was started with: `nil` for `supervise`.
  ///
  /// OTP restarts replay the same args. Readable from the configuration
  /// methods (inside `init`) and from outside; raises with kind
  /// `#stale_handle` when the pool is no longer running, and `#node_down`
  /// when a remote pool's node cannot be reached.
  args -> Dynamic => self argsResult unwrap

  /// Internal FFI seam (ADR 0101 Part 4): the raw `Result`-shaped `args/1` call.
  internal argsResult => (Erlang beamtalk_supervisor) args: self

  /// Lifecycle hook called after the dynamic supervisor has started.
  ///
  /// Override to perform post-start setup (e.g., pre-populating workers
  /// via `startChild`). `self` is the new pool. Runs in the caller's
  /// process after the pool has finished starting, so messages to `self`
  /// work here. If it raises, the pool is stopped and the start fails, as
  /// for `Supervisor>>initialize`: `spawn`/`spawnWith:` re-raise, while
  /// `supervise`, `spawnAs:` and `spawnWith:as:` answer `Result error:`
  /// (`#supervisor_start_failed`).
  ///
  /// Fires exactly once per top-level start (`supervise` or a spawn-family
  /// message), not for a nested pool (ADR 0135 §1). It does
  /// **not** re-fire on OTP-driven child restarts (including
  /// `restForOne` cascades), since those start each child directly
  /// from its child spec and never re-enter this dispatch path. A
  /// dependency reference that must survive a restart needs named
  /// actor registration (see ADR 0079) instead of one-shot wiring here.
  ///
  /// ## Examples
  /// ```beamtalk
  /// DynamicSupervisor(Worker) subclass: WorkerPool
  ///   childClass => Worker
  ///   initialize =>
  ///     3 timesRepeat: [self startChild unwrap]
  /// ```
  initialize -> Nil => nil

  // === Instance-side child management ===

  /// Start a new child with default args.
  ///
  /// ADR 0080 Phase 2 (BT-1999): returns `Result(C, Error)`. Use `unwrap`
  /// when failure should propagate as an exception, or `ifOk:ifError:` /
  /// `andThen:` for recoverable starts. Failures surface as
  /// `Result error: #beamtalk_error{kind = child_start_failed}`, or
  /// `#beamtalk_error{kind = max_children}` when the pool is at its
  /// `maxChildren` limit.
  startChild -> Result(C, Error) =>
    (Erlang beamtalk_supervisor) startChild: self

  /// Start a new child with the given initialization args.
  ///
  /// `args` is passed to the child class's `init/1` the same way
  /// `ActorClass spawnWith: args` would — e.g. a `Dictionary` merged into
  /// the child's declared `state:` fields.
  ///
  /// ADR 0080 Phase 2 (BT-1999): returns `Result(C, Error)`. Use `unwrap`
  /// when failure should propagate as an exception, or `ifOk:ifError:` /
  /// `andThen:` for recoverable starts. Failures surface as
  /// `Result error: #beamtalk_error{kind = child_start_failed}`, or
  /// `#beamtalk_error{kind = max_children}` when the pool is at its
  /// `maxChildren` limit.
  ///
  /// ## Automatic restart replays this call's args (BT-3365)
  ///
  /// OTP tracks, per child, the exact args it was started with — so a
  /// child started via `startChild: args` that later crashes under a
  /// `#permanent`/`#transient` restart policy comes back with those SAME
  /// `args`, not blank defaults. A child started via the no-arg `startChild`
  /// restarts the same way it started: with no args. Either way, restart
  /// re-runs `init/1` from scratch — it does not resume the child's prior
  /// runtime state, only its original construction args.
  ///
  /// ## Examples
  /// ```beamtalk
  /// DynamicSupervisor(Widget) subclass: WidgetSupervisor
  ///   childClass => Widget
  ///
  /// pool := (WidgetSupervisor supervise) unwrap
  /// w := (pool startChild: #{#label => "y"}) unwrap  // => Widget(label: "y")
  /// ```
  startChild: args :: Object -> Result(C, Error) =>
    (Erlang beamtalk_supervisor) startChild: self with: args

  /// Start a new child with the given args, registered under `aName`.
  ///
  /// Combines `startChild: args` with named actor registration (ADR 0079):
  /// the child starts under `{local, aName}` registration the same way
  /// `SupervisionSpec withName:` does for static `Supervisor` children.
  /// Because OTP's `simple_one_for_one` replays each dynamic child's own
  /// start args on automatic restart (BT-3365), a crashed named child comes
  /// back registered under the same name every time — no supervisor-side
  /// bookkeeping needed to recover its new pid.
  ///
  /// Look the child up again with `ChildClass named: aName` (ADR 0079).
  /// That name-keyed point lookup is the way to find one child: `children`
  /// copies the whole child list and is meant for bulk operations (see the
  /// BT-3376 amendment in ADR 0079).
  ///
  /// `aName` should come from a bounded, statically-known namespace (e.g. a
  /// fixed set of configured workers), not a dynamically-minted atom per
  /// request/tenant — the same atom-exhaustion guidance that applies to
  /// `Actor>>spawnAs:` applies here, since names are Erlang atoms.
  ///
  /// ADR 0080 Phase 2 (BT-1999): returns `Result(C, Error)`. Failures
  /// surface as `Result error: #beamtalk_error{kind = name_registered}`
  /// (name already taken), `#beamtalk_error{kind = reserved_name}`,
  /// `#beamtalk_error{kind = max_children}` (pool at its `maxChildren`
  /// limit), or `#beamtalk_error{kind = child_start_failed}` for other start
  /// failures.
  ///
  /// ## Examples
  /// ```beamtalk
  /// DynamicSupervisor(Monitor) subclass: CheckRegistry
  ///   childClass => Monitor
  ///
  /// pool := (CheckRegistry supervise) unwrap
  /// m := (pool startChild: #{#check => "db"} name: #dbCheck) unwrap
  /// (Monitor named: #dbCheck) unwrap == m   // => true
  /// ```
  startChild: args :: Object name: aName :: Symbol -> Result(C, Error) =>
    (Erlang beamtalk_supervisor)
      startChild: self
      with: args
      name: aName

  /// Terminate the given child process.
  ///
  /// ADR 0080 Phase 2 (BT-1999): returns `Result(Nil, Error)`. Idempotent
  /// on `not_found` — terminating an already-gone child returns
  /// `Result ok: nil`. Genuine failures surface as
  /// `Result error: #beamtalk_error{kind = terminate_failed}`.
  terminateChild: child :: C -> Result(Nil, Error) =>
    (Erlang beamtalk_supervisor) terminateChild: self child: child

  /// Return the live (running) children, as objects of the child class.
  ///
  /// Children OTP is restarting are left out, and the order is unspecified.
  /// This copies the whole child list out of the supervisor in one message
  /// (O(n) in the number of children): use it for bulk operations (drain,
  /// broadcast, collecting connection pids), and `startChild:name:` with
  /// `ChildClass named:` to find a single child. Works on any pool instance.
  /// Raises with kind `#stale_handle` when the pool is no longer running.
  ///
  /// ## Examples
  /// ```beamtalk
  /// pool startChild unwrap
  /// pool startChild unwrap
  /// pool children size                        // => 2
  /// pool children do: [:w | w ping]
  /// ```
  children -> List(C) => self dynamicChildrenResult unwrap

  /// Internal FFI seam (ADR 0101 Part 4): the raw `Result`-shaped
  /// `dynamicChildren/1` call.
  internal dynamicChildrenResult -> Result(List(C), Error) =>
    (Erlang beamtalk_supervisor) dynamicChildren: self

  /// Return the count of currently-running children.
  ///
  /// The `maxChildren` limit is checked against this figure plus any child
  /// whose automatic restart is pending (or whose death is still being
  /// processed), so `count` can briefly read below the limit while a start
  /// is still refused with `#max_children`.
  ///
  /// BT-1997 / ADR 0080 Phase 1: `countChildren/1` returns a Result-shaped
  /// value; call `unwrap` at the FFI boundary to preserve the pre-migration
  /// user-facing signature.
  count -> Integer => self countChildrenResult unwrap

  /// Internal FFI seam (ADR 0101 Part 4): the raw `Result`-shaped
  /// `countChildren/1` call. Keeps `count` pure Beamtalk.
  internal countChildrenResult -> Result(Integer, Error) =>
    (Erlang beamtalk_supervisor) countChildren: self

  /// Is this supervisor running?
  ///
  /// A supervisor on another node answers `true` (as an actor does); the
  /// next call to it reports `#stale_handle` or `#node_down`. Sealed, like
  /// `stop` (BT-3984): the runtime answers both without a method lookup.
  ///
  /// WARNING: check-then-act is racy; the supervisor can stop right after.
  sealed isAlive -> Boolean => (Erlang beamtalk_supervisor) isAlive: self

  /// Stop this supervisor and all its children.
  ///
  /// Raises with kind `#stale_handle` when the supervisor is not running and
  /// `#node_down` when its node cannot be reached. Sealed (BT-3984).
  ///
  /// BT-1997 / ADR 0080 Phase 1: `stop/1` returns a Result-shaped value;
  /// call `unwrap` at the FFI boundary to preserve the pre-migration
  /// user-facing signature.
  sealed stop -> Nil => self stopResult unwrap

  /// Internal FFI seam (ADR 0101 Part 4): the raw `Result`-shaped `stop/1`
  /// call. Keeps `stop` pure Beamtalk.
  internal stopResult -> Result(Nil, Error) =>
    (Erlang beamtalk_supervisor) stop: self

  /// Stop this pool and all its children, waiting up to `ms` milliseconds
  /// (or `#infinity`) for the shutdown to finish (`gen_server:stop/3`).
  ///
  /// Answers `Result ok: nil` once the pool has stopped. When the shutdown
  /// overruns the wait, answers `Result error:` with kind `#timeout` — but
  /// the pool keeps shutting down in the background: the terminate request
  /// was already delivered, so polling `isAlive` still observes the death.
  /// A stopped pool gives `Result error:` with kind `#stale_handle`, an
  /// unreachable node `#node_down`, and a negative (or non-Integer,
  /// non-`#infinity`) `ms` `#type_error`. Sealed, like `stop` (BT-3984);
  /// `stop` stays unbounded.
  ///
  /// ## Examples
  /// ```beamtalk
  /// (pool stopWithin: 5000) unwrap   // => nil, once the pool is down
  /// (busy stopWithin: 10) error kind // => #timeout (still stopping in the background)
  /// ```
  sealed stopWithin: ms :: Timeout -> Result(Nil, Error) =>
    self stopWithinResult: ms

  /// Internal FFI seam (ADR 0101 Part 4): the raw `Result`-shaped
  /// `stopWithin/2` call. Keeps `stopWithin:` pure Beamtalk.
  internal stopWithinResult: ms :: Timeout -> Result(Nil, Error) =>
    (Erlang beamtalk_supervisor) stopWithin: self ms: ms
