/// Tracing — Actor observability, trace context, and performance telemetry.
///
/// Provides class methods for controlling trace capture, setting
/// application-level trace context, querying aggregate stats,
/// analyzing performance bottlenecks, and checking actor/VM health.
/// All methods are class-side — Tracing has no instances.
///
/// Trace context (setContext:/context/clearContext) propagates
/// automatically across actor boundaries, so workflow IDs and
/// request metadata flow through actor call chains without manual
/// threading.
///
/// Aggregate stats (call counts, durations) are always-on
/// with negligible overhead (~120ns/call). Detailed trace events
/// require explicit enable/disable.
///
/// Always-on aggregates are keyed by class and selector only: one entry
/// per `{Class, Selector}` pair, however many actors churn through the
/// system. Per-actor detail is collected only while tracing is enabled
/// (`Tracing enable`), is bounded, and is dropped again on `disable`.
/// The trace store never monitors actors, so their `monitored_by` is
/// unaffected by tracing.
///
/// Tracing observes actor dispatch. To emit or attach to your own
/// application events on the `telemetry` bus, use `Telemetry`.
///
/// ## Examples
/// ```beamtalk
/// // Set application-level trace context
/// Tracing setContext: #{#workflowId => "wf-123"}
/// // => nil
/// Tracing context
/// // => _
///
/// // Always-on aggregates — no setup needed
/// Tracing stats
/// // => _
///
/// // Enable trace capture for detailed events
/// Tracing enable
/// // => nil
/// Tracing isEnabled
/// // => true
///
/// // Query traces
/// Tracing traces
/// // => _
///
/// // Analysis
/// Tracing slowMethods: 5
/// // => _
///
/// // Clean up
/// Tracing clearContext
/// // => nil
/// Tracing disable
/// // => nil
/// Tracing clear
/// // => nil
/// ```
sealed typed Object subclass: Tracing native: beamtalk_tracing

  // === Trace context ===

  /// Set application-level trace context that propagates across actor calls.
  /// Merges with any existing context. Use for workflow correlation IDs,
  /// request IDs, or any application-level metadata you want in traces and logs.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing setContext: #{#workflowId => "wf-123", #workflowType => "OrderWorkflow"}
  /// // => nil
  /// ```
  class sealed setContext: ctx :: Dictionary -> Nil => self delegate

  /// Get the current application-level trace context.
  /// Returns an empty dictionary when no context has been set.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing context
  /// // => _
  /// ```
  class sealed context -> Dictionary => self delegate

  /// Clear the application-level trace context.
  /// Removes all trace context keys from the process and logger metadata.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing clearContext
  /// // => nil
  /// ```
  class sealed clearContext -> Nil => self delegate

  // === Tracing lifecycle ===

  /// Start capturing trace events and per-actor aggregate stats
  /// (class/selector aggregates are always on).
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing enable
  /// // => nil
  /// ```
  class sealed enable -> Nil => self delegate

  /// Stop capturing trace events. Drops the per-actor aggregate stats;
  /// class/selector aggregates keep accumulating.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing disable
  /// // => nil
  /// ```
  class sealed disable -> Nil => self delegate

  /// Check whether trace capture is active.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing isEnabled
  /// // => _
  /// ```
  class sealed isEnabled -> Boolean => self delegate

  /// Clear all trace events and aggregate stats.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing clear
  /// // => nil
  /// ```
  class sealed clear -> Nil => self delegate

  // === Trace event queries ===

  /// All captured trace events (up to buffer limit), newest first.
  /// Returns [] when not enabled.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing traces
  /// // => _
  /// ```
  class sealed traces -> List(Dictionary) => self delegate

  /// Trace events for a specific actor.
  ///
  /// ## Examples
  /// ```beamtalk
  /// // Tracing tracesFor: myCounter
  /// // => _
  /// ```
  class sealed tracesFor: actor :: Actor -> List(Dictionary) => self delegate

  /// Trace events for a specific actor + method.
  ///
  /// ## Examples
  /// ```beamtalk
  /// // Tracing tracesFor: myCounter selector: #increment
  /// // => _
  /// ```
  class sealed tracesFor: actor :: Actor selector: sel :: Symbol -> List(Dictionary) =>
    self delegate

  // === Aggregate stats ===

  /// Aggregate stats, keyed by class: one `"class:<Class>"` entry per
  /// class with per-method call counts and durations (always available,
  /// even without tracing). While tracing is enabled the map also holds
  /// one entry per pid with live actors' per-actor detail.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing stats
  /// // => _
  /// ```
  class sealed stats -> Dictionary => self delegate

  /// Aggregate stats for a specific actor. Only collected while tracing
  /// is enabled; answers #{} when tracing is off and for unknown actors.
  /// The class-level totals for a dead actor stay in the `"class:<Class>"`
  /// entry of `stats`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// // Tracing statsFor: myCounter
  /// // => _
  /// ```
  class sealed statsFor: actor :: Actor -> Dictionary => self delegate

  // === Analysis (computed from aggregates) ===

  /// Top N methods by average duration (descending).
  /// One entry per `{Class, Selector}`, covering every actor of the class.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing slowMethods: 10
  /// // => _
  /// ```
  class sealed slowMethods: limit :: Integer -> List(Dictionary) =>
    self delegate

  /// Top N methods by call count (descending).
  /// One entry per `{Class, Selector}`, covering every actor of the class.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing hotMethods: 10
  /// // => _
  /// ```
  class sealed hotMethods: limit :: Integer -> List(Dictionary) => self delegate

  /// Top N methods by error + timeout rate (descending).
  /// One entry per `{Class, Selector}`, covering every actor of the class.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing errorMethods: 5
  /// // => _
  /// ```
  class sealed errorMethods: limit :: Integer -> List(Dictionary) =>
    self delegate

  /// Top N actors by message queue length — live snapshot over every
  /// registered actor, whether or not tracing is enabled.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing bottlenecks: 5
  /// // => _
  /// ```
  class sealed bottlenecks: limit :: Integer -> List(Dictionary) =>
    self delegate

  // === Live process health ===

  /// Live process info: queue depth, memory, reductions, status.
  /// Returns status=dead for dead actors.
  ///
  /// ## Examples
  /// ```beamtalk
  /// // Tracing healthFor: myCounter
  /// // => _
  /// ```
  class sealed healthFor: actor :: Actor -> Dictionary => self delegate

  /// VM overview: scheduler count, memory breakdown, process count, run queue lengths.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing systemHealth
  /// // => _
  /// ```
  class sealed systemHealth -> Dictionary => self delegate

  // === Configuration ===

  /// Current ring buffer capacity.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing maxEvents
  /// // => _
  /// ```
  class sealed maxEvents -> Integer => self delegate

  /// Set ring buffer capacity.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Tracing maxEvents: 50000
  /// // => nil
  /// ```
  class sealed maxEvents: size :: Integer -> Nil => self delegate
