/// The ETS table type — see the "Table Types" section on `Ets` for the
/// semantics of each member.
type EtsTableType = #set | #orderedSet | #bag | #duplicateBag
/// Ets — shared in-memory table for actor state sharing.
///
/// `Ets` is not a `Collection`, but it `uses: Enumerable(V)`: iteration and
/// query methods (`do:`, `select:`, `collect:`, `inject:into:`, …) run over a
/// snapshot of the values. `size`, `isEmpty` and `isNotEmpty` are answered
/// directly from the table without copying it.
///
/// Wraps OTP ets tables with a Beamtalk-friendly API. Tables are named and
/// public by default, enabling cross-actor reads and writes without
/// message-passing overhead.
///
/// ETS tables are owned by the creating process. When the owner terminates,
/// the table is deleted automatically unless an heir is configured.
///
/// ## Table Types
///
/// | Symbol        | Description                                    |
/// |---------------|------------------------------------------------|
/// | `#set`        | One entry per key (default, unordered)         |
/// | `#orderedSet` | One entry per key, keys sorted                 |
/// | `#bag`        | Multiple entries per key, values must differ   |
/// | `#duplicateBag` | Multiple identical entries per key allowed   |
///
/// ## Examples
/// ```beamtalk
/// cache := Ets new: #myCache type: #set
/// cache at: "key" put: 42
/// cache at: "key"                        // => 42
/// cache at: "missing"                    // => nil
/// cache at: "missing" ifAbsent: [0]      // => 0
/// cache includesKey: "key"               // => true
/// cache size                             // => 1
/// cache removeKey: "key"
/// cache delete
/// ```
///
/// ## Cross-Actor Sharing
/// ```beamtalk
/// cache := Ets new: #sharedCache type: #set
/// // In another actor — retrieve by name:
/// shared := Ets named: #sharedCache
/// shared at: "counter" put: 1
/// ```
typed Object subclass: Ets(K, V) native: beamtalk_ets
  handleScope: #node
  uses: Enumerable(V) excluding: #(#size, #isEmpty, #isNotEmpty)

  // Inline-FFI exceptions (ADR 0101 / BT-2731): `at:`, `at:put:` and
  // `at:ifAbsent:` share the first keyword `at`, and `at:put:`/`at:ifAbsent:`
  // both want `at/3` — an irreducible first-keyword + arity collision — while a
  // backing `size/1` would shadow the auto-imported `erlang:size/1` BIF (needing
  // a `-compile({no_auto_import, [size/1]})`, as beamtalk_session_primitives does)
  // and `delete/1` collides with the `ets:delete` mental model. These
  // five stay `(Erlang …)` FFI (still wrapped-by-default since BT-2722); the
  // rest delegate.

  /// Create a new named public ETS table (class method).
  ///
  /// `tableType` must be one of: `#set`, `#orderedSet`, `#bag`, `#duplicateBag`.
  /// The table is created as `named_table` with `public` access so that any
  /// process can read and write it. Raises `already_exists` if a table with
  /// the same name already exists.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache := Ets new: #myCache type: #set
  /// counters := Ets new: #counters type: #set
  /// ```
  class sealed new: name :: Symbol type: tableType :: EtsTableType -> Ets =>
    self delegate

  // === Class-side lookup ===

  /// Look up an existing named ETS table (class method).
  ///
  /// Returns an `Ets` instance if a table with the given name exists.
  /// Raises `not_found` if no table with that name has been created.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache := Ets named: #myCache
  /// ```
  class sealed named: name :: Symbol -> Ets => self delegate

  /// Check whether a named ETS table exists.
  ///
  /// Returns `true` if a table with the given name exists, `false` otherwise.
  ///
  /// ## Examples
  /// ```beamtalk
  /// Ets exists: #myCache    // => false
  /// Ets new: #myCache type: #set
  /// Ets exists: #myCache    // => true
  /// ```
  class sealed exists: name :: Symbol -> Boolean => self delegate

  /// Create a named table or return the existing one.
  ///
  /// If a table with the given name already exists, returns an `Ets` instance
  /// wrapping it. Otherwise creates a new table with the specified type.
  /// This is useful in setUp/tearDown cycles where the previous owner may
  /// still be alive.
  ///
  /// ## Examples
  /// ```beamtalk
  /// table := Ets newOrExisting: #events type: #set
  /// ```
  class sealed newOrExisting: name :: Symbol type: tableType :: EtsTableType -> Ets =>
    self delegate

  // === Accessing ===

  /// Look up a key. Returns the value, or `nil` if the key is absent.
  ///
  /// For `#bag` and `#duplicateBag` tables with multiple entries per key,
  /// returns the first stored value. The current wrapper exposes only one
  /// value per key; bag tables are best suited for single-value-per-key use.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache at: "key"        // => value or nil
  /// ```
  at: key :: K -> V | Nil => self delegate

  /// Insert or replace a key-value pair. Returns `nil`.
  ///
  /// For `#bag` and `#duplicateBag` tables, all existing entries for `key`
  /// are removed before the new entry is inserted, giving best-effort
  /// upsert semantics. Concurrent writes from multiple actors to the same
  /// key on a bag table are not serialized — interleaved operations may
  /// result in multiple entries for that key.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache at: "counter" put: 1
  /// ```
  at: key :: K put: value :: V -> Nil =>
    (Erlang beamtalk_ets)
      insert: self
      key: key
      value: value

  /// Look up a key; if absent, evaluate the block and return its result.
  ///
  /// For `#bag` and `#duplicateBag` tables with multiple entries per key,
  /// returns the first stored value (same as `at:`); the block is not called.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache at: "missing" ifAbsent: [0]    // => 0
  /// cache at: "key"     ifAbsent: [0]    // => stored value
  /// ```
  at: key :: K ifAbsent: block :: Block(V) -> V =>
    (Erlang beamtalk_ets)
      lookupIfAbsent: self
      key: key
      block: block

  /// Look up a key; if present, evaluate the block with the value and
  /// answer its result, otherwise answer `nil`.
  ///
  /// Works on every table type; for `#bag` and `#duplicateBag` the block
  /// receives the first stored value (same as `at:`).
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache at: "n" put: 2
  /// cache at: "n" ifPresent: [:v | v * 10]    // => 20
  /// cache at: "zz" ifPresent: [:v | v * 10]   // => nil
  /// ```
  at: key :: K ifPresent: block :: Block(V, R) -> R | Nil =>
    (Erlang beamtalk_ets)
      ifPresent: self
      key: key
      block: block

  /// Atomically add `n` to the Integer stored at `key` and answer the new
  /// value. A missing key starts at 0, so this creates it.
  ///
  /// Backed by `ets:update_counter/4`, so concurrent callers never lose an
  /// update. Supported on `#set` and `#orderedSet` only; `#bag` and
  /// `#duplicateBag` raise `unsupported_table_type`. A non-Integer `n` or a
  /// non-Integer stored value raises `type_error`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// counters at: "hits" increment: 1    // => 1
  /// counters at: "hits" increment: 5    // => 6
  /// ```
  at: key :: K increment: n :: Integer -> Integer =>
    (Erlang beamtalk_ets)
      incrementAt: self
      key: key
      by: n

  /// Atomic read-modify-write. Evaluates `block` with the current value
  /// (`nil` if the key is missing), stores the block's result and answers it.
  ///
  /// Implemented as an optimistic compare-and-swap loop: if another process
  /// changes the key meanwhile, the block is re-run with the new value. So
  /// **the block must be free of side effects** — it may run more than once.
  /// A block that raises propagates the error and writes nothing. Retries are
  /// bounded; exhaustion raises `update_contention`. Supported on `#set` and
  /// `#orderedSet` only; `#bag` and `#duplicateBag` raise
  /// `unsupported_table_type`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache at: "list" update: [:old | old isNil ifTrue: [#(1)] ifFalse: [old , #(2)]]
  /// ```
  at: key :: K update: block :: Block(V | Nil, V) -> V =>
    (Erlang beamtalk_ets)
      updateAt: self
      key: key
      block: block

  /// Return `true` if the table contains an entry for `key`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache includesKey: "key"    // => true or false
  /// ```
  includesKey: key :: K -> Boolean => self delegate

  /// Remove the entry for `key`. Returns `nil`. Idempotent if key is absent.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache removeKey: "oldKey"
  /// ```
  removeKey: key :: K -> Nil => self delegate

  /// Return all keys in the table as a `List`.
  ///
  /// Order is unspecified for `#set` and `#bag` tables.
  /// Keys are sorted for `#orderedSet` tables.
  /// For `#bag` and `#duplicateBag` tables, each key appears only once.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache keys    // => #("key1", "key2")
  /// ```
  keys -> List(K) => self delegate

  /// Return all values as a `List` (a point-in-time read).
  ///
  /// Order is unspecified for `#set`, `#bag`, `#duplicateBag`; key order for
  /// `#orderedSet`. Bag tables yield one value per stored entry.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache values    // => #(1, 2)
  /// ```
  values -> List(V) => self delegate

  /// The values as a `List` snapshot — the one method `Enumerable` requires.
  /// Gives `Ets` `do:`, `inject:into:`, `select:`, `collect:`, `detect:ifNone:`,
  /// `anySatisfy:` and `count:` over a point-in-time copy of the values.
  elements -> List(V) => self values

  /// Evaluate `block` with each key and value of a snapshot taken up front
  /// (the block may modify the table). Returns `nil`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache keysAndValuesDo: [:k :v | Transcript show: k]
  /// ```
  keysAndValuesDo: block :: Block(K, V, Object) -> Nil => self delegate

  /// Take a point-in-time snapshot as an immutable `Dictionary`.
  ///
  /// For `#bag` and `#duplicateBag` tables, only one value per key survives.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache asDictionary    // => #{"a" => 1}
  /// ```
  asDictionary -> Dictionary(K, V) => self delegate

  /// Return `true` if the table has no entries.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache isEmpty    // => true
  /// ```
  isEmpty -> Boolean => self size =:= 0

  /// Return `true` if the table has at least one entry.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache isNotEmpty    // => false
  /// ```
  isNotEmpty -> Boolean => self size > 0

  /// Return `true` if any entry holds `value`. Scans a snapshot of the
  /// values.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache includes: 42    // => true or false
  /// ```
  includes: value :: V -> Boolean => self values includes: value

  /// Remove every entry but keep the table. Returns `nil`.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache removeAll
  /// ```
  removeAll -> Nil => self delegate

  /// Return the number of entries in the table.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache size    // => 3
  /// ```
  size -> Integer => (Erlang beamtalk_ets) tableSize: self

  // === Destroying ===

  /// Destroy the table, freeing all memory. Returns `nil`.
  ///
  /// Only the process that created the table (the owner) may call `delete`.
  /// After calling `delete`, this `Ets` instance is no longer valid.
  /// Any further operations on the deleted table will raise an error.
  ///
  /// ## Examples
  /// ```beamtalk
  /// cache delete
  /// ```
  delete -> Nil => (Erlang beamtalk_ets) deleteTable: self
