// BT-4363: a class-literal send of a class-side method whose whole body is
// one scalar literal (BT-4504: not only an integer) answers the literal in place, behind a constant-value
// static call key that the runtime installs only while the class's published
// metadata still certifies that literal. These are the workspace halves of
// stdlib/test/constant_class_method_test.bt: each warms the key through a call
// site compiled before the change (`CckCaller run`), redefines the target
// class, then checks the old call site answers what a dynamic send (the class
// held in a variable) answers.

Object subclass: CckTarget
  class answer => 1
// => "CckTarget"

Object subclass: CckCaller
  class run => CckTarget answer
// => "CckCaller"

CckCaller run
// => 1

// The hit path is taken, not only the fallback: the warmed key is installed.
key := Erlang erlang list_to_tuple: #(#constant_value, 1, (Erlang erlang element: 3 of: CckTarget), #class_answer, #'CckTarget class')
// => _

(Erlang beamtalk_class_shadow_flags static_call_key_value: key) == CckTarget
// => true

// ===========================================================================
// A REDEFINITION WITH ANOTHER LITERAL IS SEEN BY THE WARMED CALL SITE
// ===========================================================================

Object subclass: CckTarget
  class answer => 2
// => "CckTarget"

CckCaller run
// => 2

target := CckTarget
// => CckTarget

target answer
// => 2

// ===========================================================================
// A REDEFINITION WHOSE BODY IS NO LONGER A LITERAL
// ===========================================================================

Object subclass: CckTarget
  class answer => 40 + 2
// => "CckTarget"

CckCaller run
// => 42

// ===========================================================================
// A REDEFINITION WITHOUT THE METHOD: does_not_understand
// ===========================================================================

Object subclass: CckTarget
  class answer => 3
// => "CckTarget"

CckCaller run
// => 3

Object subclass: CckTarget
  class other => #other
// => "CckTarget"

[CckCaller run] on: Error do: [:e | e kind]
// => does_not_understand

[target answer] on: Error do: [:e | e kind]
// => does_not_understand

// ===========================================================================
// removeSelector: OF A CLASS-BODY CONSTANT, AFTER A FRESH WARM-UP
// ===========================================================================

Object subclass: CckTarget
  class answer => 4
// => "CckTarget"

CckCaller run
// => 4

CckTarget class removeSelector: #answer
// => CckTarget class

[CckCaller run] on: Error do: [:e | e kind]
// => does_not_understand

[target answer] on: Error do: [:e | e kind]
// => does_not_understand

// ===========================================================================
// A SUPERCLASS THAT GAINS classState: ON RELOAD: THE WARMED CALL SITE STILL
// ANSWERS THE LITERAL, THROUGH THE CLASS PROCESS
// ===========================================================================

Object subclass: CckParent
  class tag => #parent
// => "CckParent"

CckParent subclass: CckChild
  class answer => 5
// => "CckChild"

Object subclass: CckChildCaller
  class run => CckChild answer
// => "CckChildCaller"

CckChildCaller run
// => 5

Object subclass: CckParent
  classState: count :: Integer = 0
  class tag => #parent
// => "CckParent"

CckChildCaller run
// => 5

// ===========================================================================
// BT-4504: THE SAME ERASERS FOR A STRING BODY
// ===========================================================================

Object subclass: CckStrTarget
  class answer => "one"
// => "CckStrTarget"

Object subclass: CckStrCaller
  class run => CckStrTarget answer
// => "CckStrCaller"

(CckStrCaller run) =:= "one"
// => true

// The hit path is taken: the warmed key carries the string as the term it
// compiles to.
strKey := Erlang erlang list_to_tuple: #(#constant_value, "one", (Erlang erlang element: 3 of: CckStrTarget), #class_answer, #'CckStrTarget class')
// => _

(Erlang beamtalk_class_shadow_flags static_call_key_value: strKey) == CckStrTarget
// => true

// A redefinition with another string.
Object subclass: CckStrTarget
  class answer => "two"
// => "CckStrTarget"

(CckStrCaller run) =:= "two"
// => true

// A redefinition whose body is no longer a literal.
Object subclass: CckStrTarget
  class answer => "th" ++ "ree"
// => "CckStrTarget"

(CckStrCaller run) =:= "three"
// => true

// A redefinition with a literal of another kind but the same spelling.
Object subclass: CckStrTarget
  class answer => #two
// => "CckStrTarget"

(CckStrCaller run) =:= #two
// => true

(CckStrCaller run) =:= "two"
// => false

// A redefinition without the method: does_not_understand.
Object subclass: CckStrTarget
  class other => #other
// => "CckStrTarget"

[CckStrCaller run] on: Error do: [:e | e kind]
// => does_not_understand

// removeSelector: of a class-body string constant, after a fresh warm-up.
Object subclass: CckStrTarget
  class answer => "one"
// => "CckStrTarget"

(CckStrCaller run) =:= "one"
// => true

CckStrTarget class removeSelector: #answer
// => CckStrTarget class

[CckStrCaller run] on: Error do: [:e | e kind]
// => does_not_understand

// ===========================================================================
// BT-4504: THE SAME ERASERS FOR A SYMBOL BODY
// ===========================================================================

Object subclass: CckSymTarget
  class answer => #one
// => "CckSymTarget"

Object subclass: CckSymCaller
  class run => CckSymTarget answer
// => "CckSymCaller"

(CckSymCaller run) =:= #one
// => true

// The hit path is taken: the warmed key carries the symbol as the term it
// compiles to.
symKey := Erlang erlang list_to_tuple: #(#constant_value, #one, (Erlang erlang element: 3 of: CckSymTarget), #class_answer, #'CckSymTarget class')
// => _

(Erlang beamtalk_class_shadow_flags static_call_key_value: symKey) == CckSymTarget
// => true

// A redefinition with another symbol.
Object subclass: CckSymTarget
  class answer => #two
// => "CckSymTarget"

(CckSymCaller run) =:= #two
// => true

// A redefinition whose body is no longer a literal.
Object subclass: CckSymTarget
  class answer => #two asString
// => "CckSymTarget"

(CckSymCaller run) =:= "two"
// => true

// A redefinition with a literal of another kind but the same spelling.
Object subclass: CckSymTarget
  class answer => "two"
// => "CckSymTarget"

(CckSymCaller run) =:= "two"
// => true

(CckSymCaller run) =:= #two
// => false

// A redefinition without the method: does_not_understand.
Object subclass: CckSymTarget
  class other => #other
// => "CckSymTarget"

[CckSymCaller run] on: Error do: [:e | e kind]
// => does_not_understand

// removeSelector: of a class-body symbol constant, after a fresh warm-up.
Object subclass: CckSymTarget
  class answer => #one
// => "CckSymTarget"

(CckSymCaller run) =:= #one
// => true

CckSymTarget class removeSelector: #answer
// => CckSymTarget class

[CckSymCaller run] on: Error do: [:e | e kind]
// => does_not_understand
