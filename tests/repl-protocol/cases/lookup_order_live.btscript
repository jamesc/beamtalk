// The live half of the lookup-order matrix
// (stdlib/test/lookup_order_matrix_test.bt has the rest and the reference
// statement of the order, ADR 0152 §2). Shapes that need a running workspace:
// hot reload of the owner, a live `Foo >> sel` definition on the owner, removal
// of the owner's method, and removal of a class. The order: a class's own
// compiled method, then its ancestors', nearest first. Nothing outside the
// class's source can change which method answers.

:load tests/repl-protocol/fixtures/bt5060_live_base_v1.bt
// => Loaded: Bt5060LiveBase

:load tests/repl-protocol/fixtures/bt5060_live_mid.bt
// => Loaded: Bt5060LiveMid

:load tests/repl-protocol/fixtures/bt5060_live_leaf.bt
// => Loaded: Bt5060LiveLeaf

Bt5060LiveBase new perform: #greet
// => compiledV1

Bt5060LiveMid new perform: #greet
// => compiledV1

Bt5060LiveLeaf new perform: #greet
// => compiledV1

// Hot reload of the owner is seen by the direct child and the grandchild.
:load tests/repl-protocol/fixtures/bt5060_live_base_v2.bt
// => Loaded: Bt5060LiveBase

Bt5060LiveBase new perform: #greet
// => compiledV2

Bt5060LiveMid new perform: #greet
// => compiledV2

Bt5060LiveLeaf new perform: #greet
// => compiledV2

// A live `Foo >> sel` definition at the prompt replaces the owner's method and
// is seen below it. (The same line in a file that does not define the class is
// a compile error, ADR 0152.)
Bt5060LiveBase >> greet => #livePatched
// => "Bt5060LiveBase>>greet"

Bt5060LiveBase new perform: #greet
// => livePatched

Bt5060LiveMid new perform: #greet
// => livePatched

Bt5060LiveLeaf new perform: #greet
// => livePatched

// The owner's method removed: does-not-understand below it.
Bt5060LiveBase removeSelector: #greet
// => Bt5060LiveBase

([Bt5060LiveLeaf new perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

([Bt5060LiveMid new perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

// The owner's compiled method gone by hot reload (a reload without `greet`).
:load tests/repl-protocol/fixtures/bt5060_live_base_v2.bt
// => Loaded: Bt5060LiveBase

Bt5060LiveLeaf new perform: #greet
// => compiledV2

:load tests/repl-protocol/fixtures/bt5060_live_base_v3.bt
// => Loaded: Bt5060LiveBase

([Bt5060LiveLeaf new perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

([Bt5060LiveMid new perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

([Bt5060LiveBase new perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

// Actor classes: the same order, direct child and grandchild.
:load tests/repl-protocol/fixtures/bt5062_live_actor_base.bt
// => Loaded: Bt5062LiveActorBase

:load tests/repl-protocol/fixtures/bt5062_live_actor_mid.bt
// => Loaded: Bt5062LiveActorMid

:load tests/repl-protocol/fixtures/bt5062_live_actor_leaf.bt
// => Loaded: Bt5062LiveActorLeaf

Bt5062LiveActorLeaf spawn perform: #greet
// => compiled

Bt5062LiveActorMid spawn perform: #greet
// => compiled

Bt5062LiveActorBase spawn perform: #greet
// => compiled

Bt5062LiveActorBase removeSelector: #greet
// => Bt5062LiveActorBase

([Bt5062LiveActorLeaf spawn perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

([Bt5062LiveActorMid spawn perform: #greet] on: Error do: [:e | e kind]) == #does_not_understand
// => true

Bt5062LiveActorLeaf removeFromSystem
// => nil

Bt5062LiveActorMid removeFromSystem
// => nil

Bt5062LiveActorBase removeFromSystem
// => nil

// Class removal: the removed class is gone; its owner is unaffected.
Bt5060LiveLeaf removeFromSystem
// => nil

Bt5060LiveMid removeFromSystem
// => nil

Bt5060LiveBase removeFromSystem
// => nil
