// BT-3020: `File open:mode:` registers its handle against the REPL session,
// so a leaked handle can be reclaimed and enumerated. The measured constraint
// this must not regress: the REPL spawns a fresh eval worker per statement
// (each line below is a separate turn/process), so a handle opened on one
// turn must still be open — and still listed against the same session — on a
// later turn. If registration were ever moved to key off the transient eval
// worker instead of the session, this file would start failing at the
// "still usable on a later turn" step below.

// ===========================================================================
// SET UP A UNIQUE TEMP PATH (never hardcode /tmp — CLAUDE.md).
// ===========================================================================

_tmpDir := File tempDirectory
// => _

_path := _tmpDir ++ "/bt3020_handle_registry_" ++ (Erlang erlang) unique_integer asString ++ ".log"
// => _

// ===========================================================================
// OPEN ON ONE TURN, LIST + WRITE ON LATER TURNS
// ===========================================================================

// No handles outstanding before we open one (prior cases clean up after
// themselves; this only asserts our own path is absent).
(File openHandles anySatisfy: [:e | (e at: 1) =:= _path]) not
// => true

h := (File open: _path mode: #write) unwrap
// => _

h isOpen
// => true

// A later turn (a fresh eval worker — BT-3020's measured constraint) still
// sees the same open, still-usable handle.
h isOpen
// => true

h writeLine: "hello from BT-3020"
// => Result ok: nil

// It shows up in the diagnostic listing, owned (not nil) — the REPL session,
// not the transient eval worker that opened it.
_entry := (File openHandles detect: [:e | (e at: 1) =:= _path])
// => _

_entry at: 2
// => write

(_entry at: 3) isNil
// => false

// ===========================================================================
// close REMOVES IT FROM THE REGISTRY IMMEDIATELY
// ===========================================================================

h close
// => Result ok: nil

h isOpen
// => false

(File openHandles anySatisfy: [:e | (e at: 1) =:= _path]) not
// => true

// ===========================================================================
// CLEANUP
// ===========================================================================

(Erlang file) delete: _path
// => _
