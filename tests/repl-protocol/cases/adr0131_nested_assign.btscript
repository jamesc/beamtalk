// BT-3799 / BT-3860 (ADR 0131): a local assignment in value position (an
// operand, a literal element, an assignment's value, a conditional's receiver)
// must rebind the binding before anything after it reads it. Today the REPL
// evaluates the assignment's value but never rebinds the binding, as the
// compiled contexts do (stdlib/test/adr0131nested_assign_test.bt).
//
// Each wrong answer pins today's answer under `PIN-BUG BT-3860` and names the
// correct one; the fix for BT-3860 flips them all. BT-3799's own shape, a loop
// body whose conditional's receiver assigns, is the last case (it tripped the
// ThreadedIr verifier until BT-3823; crates/beamtalk-repl/tests/
// repl_nested_assign_pin.rs checks that every entry point compiles it).

t := 0
// => 0

u := 0
// => 0

// An assignment as an assignment's value operand.
x := (t := t + 1) + 1
// => 2

// PIN-BUG BT-3860: correct answer 1.
t
// => 0

// An assignment in a conditional's receiver, with a writing arm.
t := 0
// => 0

(t := t + 1) > 0 ifTrue: [u := 9]
// => 9

// PIN-BUG BT-3860: correct answer 1.
t
// => 0

u
// => 9

// An assignment as a literal element, read before and after.
t := 0
// => 0

// PIN-BUG BT-3860: correct answer #[0, 7, 7].
#[t, (t := 7), t]
// => #[0, 7, 0]

// PIN-BUG BT-3860: correct answer 7.
t
// => 0

// An assignment in a loop body's operand: the body answers the comparison
// where the loop expects its bindings map.
t := 0
// => 0

// PIN-BUG BT-3860: correct answer nil (and `t` 2).
#(1, 2) do: [:k | (t := t + 1) > 0]
// => ERROR: expected a Dictionary

// PIN-BUG BT-3860: correct answer 2.
t
// => 0

// BT-3799's own shape: a loop body whose conditional's receiver assigns. It
// tripped the ThreadedIr verifier in a debug compiler until BT-3823 lowered the
// conditional as a producer of the fold body; it now compiles and, like the
// shapes above, never rebinds `t`.
t := 0
// => 0

u := 0
// => 0

#(1, 2) do: [:x | (t := t + 1) > 1 ifTrue: [u := 9]]
// => _

// PIN-BUG BT-3860: correct answer #[2, 9].
#[t, u]
// => #[0, 0]
