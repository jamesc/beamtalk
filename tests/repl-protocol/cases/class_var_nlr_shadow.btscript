// E2E repro for ADR 0110 / BT-3032 / BT-3038: a class variable mutated
// before a class method invokes a caller-supplied block must survive a
// foreign `^` escaping through that block, driven from a live REPL session.
// Unit/BUnit tests alone are insufficient here — the fix crosses codegen +
// runtime + class gen_server state, exactly the seam e2e exists to cover.
// See stdlib/test/class_var_nlr_shadow_test.bt for the full BUnit coverage
// (self-dispatch, ClassBuilder, block-interior mutation, genuine-error
// revert); this file pins the ADR's own repro end-to-end.

// @load tests/repl-protocol/fixtures/class_var_nlr_shadow_driver.bt
// @load tests/repl-protocol/fixtures/class_var_nlr_shadow_probe.bt

CollectionDriver runCount
// => 0

// The `^` in the probe's block is foreign to countedRun:over:'s frame. The
// returned value was already correct before ADR 0110 (BT-3022); the
// class-var increment must now survive the relay too.
CollectionProbe escapeAfterCountedRun: #(1, 2, 3)
// => 2

CollectionDriver runCount
// => 1

// A genuine error after the mutation still reverts it (unchanged behavior).
CollectionDriver countedRun: [:x | 1 / 0] over: #(1)
// => ERROR: bad arithmetic

CollectionDriver runCount
// => 1
