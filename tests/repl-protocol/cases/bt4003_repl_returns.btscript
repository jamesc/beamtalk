// BT-4003: the residuals found during BT-3912, at the REPL. Each rejected input
// is refused before it runs, so no binding changes.
//
// @load stdlib/test/fixtures/closure_cell_recorder.bt

// ===========================================================================
// BT-4288: a `^` in the body of a loop or collection operation ends the input
// with its value, as in a method (it used to be ignored: the loop ran on, and
// `[n < 3] whileTrue: [^10]` never ended). The bindings written before it keep
// their values, and the rest of the input does not run.
// ===========================================================================

w := 0
// => 0

#(1, 2, 3) do: [:x | w := w + x. x == 2 ifTrue: [^w]]
// => 3

w
// => 3

[w < 30] whileTrue: [w := w + 1. w == 7 ifTrue: [^#done]]
// => done

w
// => 7

#(1, 2) inject: 0 into: [:a :x | ^x]
// => 1

#(1, 2, 3) collect: [:x | x == 2 ifTrue: [^x * 10]. x]
// => 20

1 to: 3 do: [:i | w := w + i. [i == 2 ifTrue: [^w]] on: Error do: [:e | 0]]
// => 10

3 timesRepeat: [^8]. w := 99
// => 8

w
// => 10

// Assigning the input's value would bind what a method never assigns.
r := #(1, 2) do: [:x | ^x]
// => ERROR: a non-local return (`^`) ends the input with its value, so the assignment to `r` never completes

// ===========================================================================
// BT-4312: so does a `^` at the root, in a conditional arm, an evaluated block
// or a protected block (it used to answer its value where it stood, and the
// rest of the input ran on: `x := 1. ^7. x := 2` answered 2).
// ===========================================================================

k := 1. ^7. k := 2
// => 7

k
// => 1

true ifTrue: [^3]. 5
// => 3

k := 4. k > 3 ifTrue: [^k * 10] ifFalse: [0]. k := 0
// => 40

k
// => 4

[^4] value. k := 0
// => 4

[1 / 0] on: Error do: [:e | ^#caught]. k := 0
// => caught

[^55] ensure: [0]. k := 0
// => 55

k
// => 4

// A `^` that never fires leaves the rest of the input to run.
k > 9 ifTrue: [^#big]. k := 5
// => 5

// A `^` run in place inside the value of a top-level assignment: a method
// never assigns `r`, but the workspace would bind it to the input's value.
r := true ifTrue: [^3]
// => ERROR: a non-local return (`^`) ends the input with its value, so the assignment to `r` never completes

r := [^3] value
// => ERROR: a non-local return (`^`) ends the input with its value, so the assignment to `r` never completes

// A single-statement input answers as before, and a stored closure's `^`
// answers its value where it stands.
^7
// => 7

true ifTrue: [^3]
// => 3

[^4] value
// => 4

[^5] on: Error do: [:e | 0]
// => 5

[^55] ensure: [0]
// => 55

b2 := [:x | ^x]
// => _

b2 value: 6
// => 6

// A closure created in a loop body keeps its own `^`: called from a later
// input, after the eval that created it has ended, it answers its value
// (a throw to the creating eval would reach no catch).
#(1, 2) do: [:z | b5 := [:y | ^y * z]]
// => _

b5 value: 4
// => 8

// A loop held in a closure may run in a later input, where no boundary
// catches its `^`: rejected, as before BT-4288.
b6 := [#(1, 2) do: [:x | ^x]]
// => ERROR: a non-local return (`^`) in the body of a loop or collection operation inside a block

true ifTrue: [b6 := [#(1, 2) do: [:x | ^x]]]
// => ERROR: a non-local return (`^`) in the body of a loop or collection operation inside a block

// ===========================================================================
// A `^` closure keeps the bindings it read when it was created, so a later
// assignment was not seen (`b value` answered 0): a compile error.
// ===========================================================================

u := 0
// => 0

b := [^u]
// => ERROR: a block that returns non-locally (`^`) and is not run where it is

// ===========================================================================
// An error leaving an `ensure:` protected block after it wrote a binding the
// cleanup reads: the cleanup saw the old value (recorded 0). A compile error,
// by design (ADR 0133).
// ===========================================================================

rec := ClosureCellRecorder spawn
// => _

t := 0
// => 0

[[t := 9. 1 / 0] ensure: [rec record: t]] on: Error do: [:e | nil]
// => ERROR: an `ensure:` protected block that writes `t` may raise an error

// The write as the last thing the protected block does is seen.
[t := 9] ensure: [rec record: t]
// => 9

rec last
// => 9
