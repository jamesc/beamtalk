// BT-4189: a solo `ifTrue:`/`ifFalse:` whose block writes a workspace binding
// compiles through the REPL's mutation/threading path. Its non-taken branch
// answers the receiver, as dynamic dispatch does (`False>>ifTrue: => self`,
// `True>>ifFalse: => self`), never `nil`, and the binding is unchanged. The
// same shapes in class, value-type and actor methods are
// stdlib/test/solo_branch_threading_answer_test.bt.

x := 0
// => 0

false ifTrue: [x := 1]
// => false

x
// => 0

true ifFalse: [x := 1]
// => true

x
// => 0

r := false ifTrue: [x := 1]
// => false

x
// => 0

// Taken-branch controls: the block runs and its value is the answer.
true ifTrue: [x := 1]
// => 1

x
// => 1

false ifFalse: [x := 2]
// => 2

x
// => 2
