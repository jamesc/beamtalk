// E2E tests for the Transcript and Beamtalk class-side facades
// (BT-376 / ADR 0010 Phase 4, reworked by ADR 0129 / BT-3642).
//
// These tests require E2E because Transcript's buffer operations (`recent`,
// `clear`) need the REPL's TranscriptStream, which only exists in an
// interactive workspace. BUnit tests run under `beamtalk test`, where
// Transcript falls back to Logger. Cross-turn variable persistence is also
// tested here.

// ===========================================================================
// TRANSCRIPT FACADE — BASIC DISPATCH
// ===========================================================================

// Transcript show: is a class-side send; it returns nil
Transcript show: "Hello"
// => nil

// Transcript cr is a class-side send; it returns nil
Transcript cr
// => nil

// ===========================================================================
// TRANSCRIPT FACADE — CLASS INTROSPECTION
// ===========================================================================

// Transcript is a class; `Transcript class` is its metaclass
Transcript class
// => Transcript class

// Transcript respondsTo: #show: returns true
Transcript respondsTo: #show:
// => true

// Transcript respondsTo: a method it doesn't have
Transcript respondsTo: #nonExistentMethod
// => false

// ===========================================================================
// BEAMTALK BINDING — CLASS INTROSPECTION
// ===========================================================================

// Beamtalk is a class; `Beamtalk class` is its metaclass
Beamtalk class
// => Beamtalk class

// Beamtalk respondsTo: #allClasses returns true
Beamtalk respondsTo: #allClasses
// => true

// ===========================================================================
// BEAMTALK BINDING — METHODS
// ===========================================================================

// Beamtalk allClasses returns a list including core classes
// Class list changes as classes are added, keep wildcard
classes := Beamtalk allClasses
// => _

// Validate allClasses returns a non-empty list
classes isEmpty
// => false

// Beamtalk version returns a string
version := Beamtalk version
// => _

// Validate version is a non-empty string
version isEmpty
// => false

// ===========================================================================
// TRANSCRIPT FACADE — CASCADE (SEMICOLON CHAINING)
// ===========================================================================

// Cascade on the facade: all messages go to Transcript
Transcript show: "Hello"; cr; show: "World"
// => nil

// ===========================================================================
// BEAMTALK BINDING — CLASS NAMED
// ===========================================================================

// Beamtalk classNamed: looks up a class by symbol
intClass := Beamtalk classNamed: #Integer
// => Integer

// ===========================================================================
// TRANSCRIPT FACADE — BUFFER OPERATIONS
// ===========================================================================

// Clear transcript buffer first
Transcript clear
// => nil

// Write something to transcript
Transcript show: "TestOutput"
// => nil

// Recent returns buffer contents (list of recent output)
recent := Transcript recent
// => _

// Buffer should not be empty after writing
recent isEmpty
// => false

// Clear empties the buffer
Transcript clear
// => nil

// Buffer should be empty after clear
recentAfterClear := Transcript recent
// => _

recentAfterClear isEmpty
// => true
