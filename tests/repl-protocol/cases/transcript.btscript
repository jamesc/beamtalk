// E2E tests for the Transcript class-side facade (ADR 0129 §5, BT-3642)
//
// These tests require E2E because inside an interactive workspace Transcript
// routes to the workspace's TranscriptStream (a process that only exists when
// the REPL server runs) and `recent` / `clear` need that stream. BUnit tests
// run under `beamtalk test`, where Transcript falls back to Logger.
//
// Transcript is a sealed, stateless class-side facade. Every write selector
// returns nil.
//
// Related: workspace_bindings.btscript — buffer operations and cascades.

// ===========================================================================
// SHOW: WITH DIFFERENT TYPES (type-variant behavior)
// ===========================================================================

// show: with an integer
Transcript show: 42
// => nil

// show: with a boolean
Transcript show: true
// => nil

// show: with nil
Transcript show: nil
// => nil

// ===========================================================================
// RETURN VALUES ARE NIL
// ===========================================================================

t := Transcript show: "test"
// => nil

t2 := Transcript cr
// => nil

t3 := Transcript showCr: "test"
// => nil

// ===========================================================================
// OUTPUT REACHES THE REPL STREAM
// ===========================================================================

Transcript clear
// => nil

Transcript show: "Hello"; cr; show: "World"
// => nil

Transcript recent size
// => 3

Transcript recent includes: "Hello"
// => true

Transcript showCr: "line"
// => nil

Transcript recent size
// => 5

Transcript recent includes: "line"
// => true
