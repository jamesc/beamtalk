// BT-3841 (ADR 0131): a plain `detect:` whose block writes an outer local, in
// the REPL. As a statement it keeps the REPL's own lowering and stops at the
// first match (BT-3805). In a conditional arm it leaked the fold's tuple and
// dropped the write (measured, BT-3841 PR 5), so the Phase 0 check rejected it
// there until BT-3823 made the REPL's arms producer frames: it is now a
// producer that adopts the bindings map and stops at the first match too.
// `detect:ifNone:` in the same arm answers right and keeps its writes (last
// cases).

t := 0
// => 0

#(1, 2) detect: [:e | t := t + 1. e > 0]
// => 1

t
// => 1

#(1, 2) detect: [:e | t := t + e. e > 1]
// => 2

t
// => 4

4 =:= 4 ifTrue: [#(1, 2) detect: [:e | t := t + 1. e > 0]]
// => 1

t
// => 5

4 =:= 4 ifTrue: [#(1, 2) detect: [:e | t := t + 1. e > 0] ifNone: [0]]
// => 1

t
// => 6

4 =:= 4 ifTrue: [#(1, 2) detect: [:e | e > 5] ifNone: [t := t + 100. 0]]
// => 0

t
// => 106
