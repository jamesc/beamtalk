// BT-4015: a binding written in a `whileTrue:` / `whileFalse:` condition is
// carried out of the condition closure, into the body, the next iteration and
// out of the loop. Before, a body that read the binding failed `erlc`
// (unbound variable), and a body that did not read it looped forever (the
// condition re-read the pre-loop value every iteration).

// The issue's repro: the body reads the condition's write.
cw := 0
// => 0
ck := 0
// => 0
[cw := cw + 1. cw < 3] whileTrue: [ck := ck + cw]
// => nil
#[cw, ck]
// => #[3, 3]

// The `whileFalse:` twin.
cw := 0
// => 0
ck := 0
// => 0
[cw := cw + 1. cw >= 3] whileFalse: [ck := ck + cw]
// => nil
#[cw, ck]
// => #[3, 3]

// The silent case: the body carries nothing, so only the condition's write
// can end the loop.
cw := 0
// => 0
[cw := cw + 1. cw < 3] whileTrue: [nil]
// => nil
cw
// => 3

// The body writes another binding without reading the condition's.
cw := 0
// => 0
ck := 0
// => 0
[cw := cw + 1. cw < 3] whileTrue: [ck := ck + 1]
// => nil
#[cw, ck]
// => #[3, 2]

// A value-position write in the condition: the nested assignment's binding is
// carried too.
cw := 0
// => 0
w := 0
// => 0
x := 0
// => 0
[x := (w := cw + 10). cw := cw + 1. cw < 3] whileTrue: [nil]
// => nil
#[cw, w, x]
// => #[3, 12, 12]

// A value-position write in the condition's boolean tail.
cw := 0
// => 0
[(cw := cw + 1) < 3] whileTrue: [nil]
// => nil
cw
// => 3

// Writes nested in the condition: a conditional arm (one or two bindings)
// and an `and:` block. Each is carried out of the condition, and the body
// reads it. (A fold or counted loop in the condition that writes a binding is
// a Phase 0 error at the REPL, as it is in a loop body.)
cw := 0
// => 0
w := 0
// => 0
ck := 0
// => 0
[(cw > 0) ifTrue: [w := cw]. cw := cw + 1. cw < 3] whileTrue: [ck := ck + w]
// => nil
#[cw, w, ck]
// => #[3, 2, 1]

cw := 0
// => 0
w := 0
// => 0
ck := 0
// => 0
[cw := cw + 1. (cw < 3) and: [w := cw. true]] whileTrue: [ck := ck + w]
// => nil
#[cw, w, ck]
// => #[3, 2, 3]

cw := 0
// => 0
w := 0
// => 0
x := 0
// => 0
[(cw >= 0) ifTrue: [w := cw. x := cw + 1]. cw := cw + 1. cw < 3] whileTrue: [nil]
// => nil
#[cw, w, x]
// => #[3, 2, 3]
