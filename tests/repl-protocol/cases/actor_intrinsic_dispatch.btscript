// BT-4995: the workspace half of stdlib/test/actor_intrinsic_dispatch_test.bt.
// A live patch that adds a `terminate:` override to an actor's class, or to an
// ancestor, while an actor of that class is running (or before one starts) is
// seen by the next stop: the default `terminate:` is dispatched, not skipped,
// and the memoised inherited-target verdict is flushed by the patch. It must
// hold before and after the Actor intrinsics are called directly.

Actor subclass: IntrinsicReplSink
  state: seen = #{}
  put: key value: value => self.seen := self.seen at: key put: value
// => "IntrinsicReplSink"

IntrinsicReplSink >> lookup: key => self.seen at: key ifAbsent: [nil]
// => "IntrinsicReplSink>>lookup:"

seen := IntrinsicReplSink spawn
// => Actor(IntrinsicReplSink, _)

seen registerAs: #bt4995Sink
// => _

Actor subclass: IntrinsicReplBase
  state: n = 0
  bump => self.n := self.n + 1
// => "IntrinsicReplBase"

IntrinsicReplBase subclass: IntrinsicReplLeaf
// => "IntrinsicReplLeaf"

// An actor that started before any override exists.
early := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

early bump
// => 1

// The ancestor gains a `terminate:` override while `early` is running.
IntrinsicReplBase >> terminate: reason => (IntrinsicReplSink named: #bt4995Sink) unwrap put: #ancestor value: reason
// => "IntrinsicReplBase>>terminate:"

early stopWith: #firstStop
// => ok

seen lookup: #ancestor
// => firstStop

// An actor started after the ancestor's override.
mid := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

mid bump
// => 1

// The leaf's own override, added while `mid` is running, beats the ancestor's.
IntrinsicReplLeaf >> terminate: reason => (IntrinsicReplSink named: #bt4995Sink) unwrap put: #leaf value: reason
// => "IntrinsicReplLeaf>>terminate:"

mid stop
// => ok

seen lookup: #leaf
// => normal

// Removing the leaf's override restores the ancestor's on the next stop.
IntrinsicReplLeaf removeSelector: #terminate:
// => IntrinsicReplLeaf

late := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

late stopWith: #lateStop
// => ok

seen lookup: #ancestor
// => lateStop

// Removing the ancestor's override too: stopping works with the default.
IntrinsicReplBase removeSelector: #terminate:
// => IntrinsicReplBase

plain := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

plain stopWith: #plainStop
// => ok

plain isAlive
// => false


// === Extensions on `Actor` itself (global, so they live in this serial script) ===
//
// BT-5002: an extension on `Actor` is seen by every actor class, whatever its
// depth: lookup walks the superclass chain from the receiver's class, an
// extension on a class beats that class's compiled method, and the first class
// with the selector by either route wins.

IntrinsicReplBase >> go => self continueWith: #bump
// => "IntrinsicReplBase>>go"

IntrinsicReplBase >> bump => self.n := self.n + 1
// => "IntrinsicReplBase>>bump"

IntrinsicReplBase >> count => self.n
// => "IntrinsicReplBase>>count"

IntrinsicReplBase >> stopMe => self stopWith: #why
// => "IntrinsicReplBase>>stopMe"

Erlang beamtalk_extensions register: #Actor selector: #'terminate:' fun: [:args :receiver | (IntrinsicReplSink named: #bt4995Sink) unwrap put: #actorTerminate value: args first] owner: #bt4995
// => _

direct := IntrinsicReplBase spawn
// => Actor(IntrinsicReplBase, _)

deep := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

direct stop
// => ok

seen lookup: #actorTerminate
// => normal

seen put: #actorTerminate value: #cleared
// => _

deep stop
// => ok

seen lookup: #actorTerminate
// => normal

seen put: #actorTerminate value: #cleared
// => _

// An actor that started before the extension was removed no longer calls it.
before := IntrinsicReplBase spawn
// => Actor(IntrinsicReplBase, _)

Actor removeSelector: #terminate:
// => Actor

before stop
// => ok

seen lookup: #actorTerminate
// => cleared

// A class's own `terminate:` beats an `Actor` extension.
Erlang beamtalk_extensions register: #Actor selector: #'terminate:' fun: [:args :receiver | (IntrinsicReplSink named: #bt4995Sink) unwrap put: #actorTerminate value: args first] owner: #bt4995
// => _

IntrinsicReplBase >> terminate: reason => (IntrinsicReplSink named: #bt4995Sink) unwrap put: #own value: reason
// => "IntrinsicReplBase>>terminate:"

own := IntrinsicReplBase spawn
// => Actor(IntrinsicReplBase, _)

own stop
// => ok

seen lookup: #own
// => normal

seen lookup: #actorTerminate
// => cleared

IntrinsicReplBase removeSelector: #terminate:
// => IntrinsicReplBase

Actor removeSelector: #terminate:
// => Actor

// `continueWith:`: the extension runs for the direct subclass and for the class
// below it (the step does not run for either).
Erlang beamtalk_extensions register: #Actor selector: #'continueWith:' fun: [:args :receiver | (IntrinsicReplSink named: #bt4995Sink) unwrap put: #actorContinue value: args first] owner: #bt4995
// => _

cont := IntrinsicReplBase spawn
// => Actor(IntrinsicReplBase, _)

cont go
// => _

seen lookup: #actorContinue
// => bump

cont count
// => 0

seen put: #actorContinue value: #cleared
// => _

deepCont := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

deepCont go
// => _

seen lookup: #actorContinue
// => bump

deepCont count
// => 0

Actor removeSelector: #continueWith:
// => Actor

// `stopWith:` sent to self: the extension intercepts it for the direct subclass
// and for the class below it (the actor stays alive in both).
Erlang beamtalk_extensions register: #Actor selector: #'stopWith:' fun: [:args :receiver | (IntrinsicReplSink named: #bt4995Sink) unwrap put: #actorStop value: args first] owner: #bt4995
// => _

stopper := IntrinsicReplBase spawn
// => Actor(IntrinsicReplBase, _)

stopper stopMe
// => _

stopper isAlive
// => true

seen lookup: #actorStop
// => why

seen put: #actorStop value: #cleared
// => _

deepStopper := IntrinsicReplLeaf spawn
// => Actor(IntrinsicReplLeaf, _)

deepStopper stopMe
// => _

deepStopper isAlive
// => true

seen lookup: #actorStop
// => why

Actor removeSelector: #stopWith:
// => Actor

stopper stop
// => ok

deepStopper stop
// => ok

deepCont stop
// => ok

cont stop
// => ok

seen stop
// => _
