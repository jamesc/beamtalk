// E2E tests for Towers of Hanoi example
//
// This test requires E2E because the solve: method prints each move to
// Transcript (the class-side facade, routed to the REPL's TranscriptStream).
// The REPL context provides both the transcript stream and workspace variable
// persistence needed to hold the Hanoi instance across expressions.
//
// The solve: method returns nil because the last expression of the recursion
// is the `ifFalse: [nil]` branch.
//
// Tests the classic recursive algorithm that moves n disks between three pegs.
// Hanoi is an Object subclass (not Actor), so use `new` not `spawn`.

// @load tests/repl-protocol/fixtures/hanoi.bt

// ===========================================================================
// INSTANTIATION
// ===========================================================================

// Create a Hanoi instance
h := Hanoi new
// => Hanoi()

// ===========================================================================
// BASE CASE (n=1)
// ===========================================================================

// Solve with 1 disk — single move from A to C
// Returns nil: the recursion bottoms out in the ifFalse: [nil] branch
h solve: 1 from: "A" to: "C" via: "B"
// => nil

// ===========================================================================
// RECURSIVE CASE (n=3)
// ===========================================================================

// Solve with 3 disks — 7 moves (2^3 - 1)
// Returns nil: the recursion bottoms out in the ifFalse: [nil] branch
h solve: 3 from: "A" to: "C" via: "B"
// => nil
