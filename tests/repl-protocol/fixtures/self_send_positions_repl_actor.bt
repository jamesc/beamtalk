// Actor fixture for tests/repl-protocol/cases/actor_self_send_positions.btscript
// (ADR 0118 / BT-3424) — a small, self-contained sample of the self-send
// syntactic positions stdlib/test/actor_self_send_position_matrix_test.bt
// covers exhaustively via BUnit, driven here end-to-end through the REPL
// instead. See that matrix test's own fixture,
// stdlib/test/fixtures/self_send_position_counter.bt, for the full probe
// this is a small REPL-specific sample of.

Actor subclass: SelfSendPositionsReplActor
  state: count = 0
  state: log = #()
  state: items :: List(Integer) = #(10, 20, 30)

  internal bumpCount =>
    self.count := self.count + 1
    self.count

  internal record: n =>
    self.log := self.log ++ #(n)
    n

  getCount => self.count

  getLog => self.log

  // Cascade on self: every cascaded send shares `self` as its receiver, so
  // each one's own actor-state mutation must thread through in order.
  cascadeOnSelf =>
    self record: 1; record: 2
    self.log

  // Conditional as a self-send argument: the conditional's own VALUE
  // (whichever branch runs) becomes the argument to `record:`.
  conditionalArgSelfSend: flag =>
    self record: (flag ifTrue: [self bumpCount] ifFalse: [0])

  // Self-send as a binary-op operand inside a whileTrue: CONDITION block.
  whileTrueConditionSelfSend =>
    i := 0
    [(self bumpCount) < 3] whileTrue: [i := i + 1]
    i

  // Order-sensitive binary operand: the LEFT operand may raise. Evaluating
  // it before the self-send (the correct order) means an out-of-range
  // index raises before `bumpCount` ever runs, so no mutation lands — the
  // behavioural half of the evaluation-order guarantee, not just the
  // arithmetic half.
  orderSensitiveBinaryOperandSelfSend: idx =>
    (self.items at: idx) + (self bumpCount)
