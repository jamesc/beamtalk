// Fixture: an Actor method passes a block that reads `self.total` to one of its
// own methods, which runs it after changing the field. Under ADR 0137 the block
// reads the live value (ADR 0133 amendment BT-3952 retired). Used by
// tests/repl-protocol/cases/adr0133_escaping_block.btscript via `// @load`.

Actor subclass: Bt3952StaleFieldReadError
  state: total = 0

  sealed bumpThen: block =>
    self.total := self.total + 1
    block value

  stale => self bumpThen: [self.total]
