// ADR 0110 / BT-3038: the `^` here is foreign to CollectionDriver's
// countedRun:over: frame, so the driver's class-var increment must travel
// via the '$bt_class_vars_shadow' write-through when the non-local return
// relays back out of the driver's class process.

Value subclass: CollectionProbe

  class escapeAfterCountedRun: aList :: List -> Integer =>
    CollectionDriver countedRun: [:x | x > 1 ifTrue: [^x]] over: aList
    0
