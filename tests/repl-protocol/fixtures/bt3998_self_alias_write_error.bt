// Fixture that triggers a compile error: an Actor method makes a
// state-changing send to a local bound only to `self` (BT-3998). The change is
// lost when the message ends. Used by
// tests/repl-protocol/cases/adr0133_escaping_block.btscript via @load-error.

Actor subclass: Bt3998SelfAliasWriteError
  state: x = 0

  setX: v => self.x := v

  writeThroughAlias =>
    other := self
    other setX: 7
