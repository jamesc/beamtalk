// Towers of Hanoi — e2e test fixture.
// Canonical source lives in examples/getting-started/src/hanoi.bt.

Value subclass: Hanoi

  solve: n from: source to: target via: auxiliary =>
    (n > 0)
      ifTrue: [
        self
          solve: n - 1
          from: source
          to: auxiliary
          via: target
        Transcript showCr: "Move disk from " ++ source ++ " to " ++ target
        self
          solve: n - 1
          from: auxiliary
          to: target
          via: source
      ]
      ifFalse: [nil]
