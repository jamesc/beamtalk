// BT-3866 (ADR 0132 Phase 0a): callee classes for
// cases/adr0132_section6_pins.btscript. A user higher-order class method and
// a user higher-order instance method that invoke their block parameter.

Object subclass: Adr0132ReplCallee

  class sealed calleeDirect: b => b value

  class sealed calleeDo: b => #(1) do: [:x | b value]
