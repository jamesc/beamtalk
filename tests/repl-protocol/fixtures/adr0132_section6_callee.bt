// BT-3866 (ADR 0132 Phase 0a): callee classes, now for
// cases/adr0133_escaping_block.btscript (BT-3902). Two user higher-order class methods
// that invoke their block parameter.

Object subclass: Adr0132ReplCallee

  class sealed calleeDirect: b => b value

  class sealed calleeDo: b => #(1) do: [:x | b value]
