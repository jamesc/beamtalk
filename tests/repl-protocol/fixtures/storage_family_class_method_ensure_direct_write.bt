// ADR 0122 / BT-3506, ADR 0130: a BARE, direct class-var write nested inside an
// `ensure:` body. Before ADR 0130 this was a compile-time rejection
// (`ClassVarAssignmentInThreadedBody`); a class-variable write is now an in-place
// `put` into the class process's dictionary, so it compiles and the write is kept.

Object subclass: StorageFamilyClassMethodEnsureDirectWrite
  classState: runs = 0

  class ensureDirectWrite =>
    self.runs := 0
    [
      self.runs := self.runs + 1
      nil
    ] ensure: [nil]
    self.runs
