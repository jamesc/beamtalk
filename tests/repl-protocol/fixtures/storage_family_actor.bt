// ADR 0122 / BT-3519 close-out: e2e coverage of the Actor `state:` storage
// family threading through every construct the epic unified, driven from a
// live REPL session (unit/BUnit tests already cover this — see
// stdlib/test/fixtures/mutation_corpus_actor.bt, whose fragment bodies these
// mirror verbatim — but never through the REPL's own `:load`/eval path).
// `State` threads through every construct unconditionally (ADR 0122 "State
// already fits" — it is the actor's own scratch map, not a function of body
// shape), so every cell here is an ACCEPT.

Actor subclass: StorageFamilyActor
  state: total = 0

  bump => self.total := self.total + 1

  // ── to:do: ──────────────────────────────────────────────────────────────
  toDo =>
    seen := 0
    1
      to: 5
      do: [:i |
        self.total := self.total + i
        seen := seen + 1
      ]
    self.total

  // ── whileTrue: ──────────────────────────────────────────────────────────
  whileTrue =>
    n := 0
    [n < 5]
      whileTrue: [
        self.total := self.total + 1
        n := n + 1
      ]
    self.total

  // ── ifTrue:ifFalse: ─────────────────────────────────────────────────────
  ifTrueIfFalse: flag =>
    x := 1
    flag
      ifTrue: [
        self.total := self.total + 1
        x := x + 1
      ]
      ifFalse: [self.total := self.total + 100]
    self.total

  // ── do:/collect: (Foldl-shaped list op) ────────────────────────────────
  //
  // BT-3521 fixed the `collect:`-with-state-mutation codegen bug this cell
  // used to route around by calling `do:` instead (a direct Actor
  // state-field write inside a bare, result-discarded `collect:` statement
  // hit `erlc`'s "unbound variable '_Val'"). Uses `collect:` directly now —
  // `do:` and `collect:` share the same `Foldl*` family-threading formula
  // this construct family is meant to exercise.
  collectSum =>
    seen := 0
    #(1, 2, 3)
      collect: [:i |
        self.total := self.total + i
        seen := seen + 1
      ]
    self.total

  // ── on:do: ──────────────────────────────────────────────────────────────
  onDo =>
    seen := 0
    [
      self.total := self.total + 3
      seen := seen + 1
    ] on: Error do: [:e | nil]
    self.total

  // ── ensure: ─────────────────────────────────────────────────────────────
  ensure =>
    seen := 0
    [
      self.total := self.total + 1
      seen := seen + 1
    ] ensure: [nil]
    self.total

  // ── match: (self-send mutation — MATCH_ARM_FAMILIES includes `State`) ───
  matchArm: v =>
    v match: [
      1 -> self bump;
      _ -> nil
    ]
    self.total
