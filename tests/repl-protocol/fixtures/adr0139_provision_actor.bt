// BT-4837 / BT-4828 fixture: an actor that gets `boomP` from a protocol defined
// in another file (adr0139_provision.bt).

Actor subclass: Adr0139ProvisionActor
  uses: Adr0139Provision

  label -> String => "p"

  traceP =>
    [self boomP] on: Error do: [:e | e stackTrace collect: [:f | f printString]]
