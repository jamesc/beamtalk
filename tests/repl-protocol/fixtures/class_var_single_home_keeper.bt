// ADR 0130 §5 / BT-3760: an actor that keeps a block and runs it later, in
// its own process (the asynchronous abroad carry).

Actor subclass: CvshKeeper
  state: blk = nil

  keep: aBlock => self.blk := aBlock

  run => self.blk value
