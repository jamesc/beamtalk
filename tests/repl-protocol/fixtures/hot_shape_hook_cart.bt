// BT-3535 (ADR 0123 Phase 1 spike): initial shape, no migration hook yet.
// Paired with hot_shape_hook_cart_v2.bt, which adds a `total` field and a
// class-side `migrateFromV1:` hook computing it from `itemCount`.

Actor subclass: HotShapeHookCart
  state: itemCount :: Integer = 0

  addItem => self.itemCount := self.itemCount + 1

  getItemCount => ^self.itemCount
