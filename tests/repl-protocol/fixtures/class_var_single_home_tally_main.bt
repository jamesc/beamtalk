// ADR 0130 / BT-3715: CvshTally, driven with CvshBatch and CvshKeeper
// (separate files).

Object subclass: CvshTally
  classState: total = 0

  class add: x => self.total := self.total + x

  class total -> Integer => self.total

  class reset => self.total := 0

  class readViaBatch =>
    self reset
    self add: 5
    CvshBatch each: [self.total]

  class writeViaBatch =>
    self reset
    CvshBatch each: [self add: 1]
    self.total

  class makeBumper => [self add: 1]

  // BT-3760: a block whose only class-variable access is a direct write.
  class makeWriter => [self.total := 5]

  class writeDirectViaBatch =>
    self reset
    @expect class_state_abroad "BT-3760: the direct write runs in CvshBatch's process"
    CvshBatch each: [self.total := 5]
    self.total

  class writeDirectViaKeeper =>
    self reset
    k := CvshKeeper spawn
    k keep: [self.total := 5]
    k run
    self.total

  class makeReader =>
    @expect class_state_abroad "BT-3715: run from the REPL it reads the creation-time value"
    [self.total]

  class run: aBlock => aBlock value
