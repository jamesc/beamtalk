// Fixture: field assignment in a stored closure. Under ADR 0137 an actor's
// stored closure writes the live field.

Actor subclass: BadStoredClosure
  state: value = 0

  badMethod =>
    myBlock := [self.value := self.value + 1]
    myBlock value
