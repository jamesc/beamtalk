// A block whose only class-variable access is a direct write, returned from the
// class: it loads, and running it away from home raises. Loaded with `@load` by
// class_var_single_home.btscript.

Object subclass: CvshEscapingWrite
  classState: total = 0

  class makeWriter => [self.total := 5]
