// ADR 0122, ADR 0130: a BARE, direct class-var write inside a `do:` body with
// no co-occurring self-send. Before ADR 0130 this fell through to the generic
// stored-closure-body rejection (`FieldAssignmentInUnsupportedBlock`); a
// class-variable write is now an in-place `put`, so it compiles and every
// iteration's write is kept.

Object subclass: StorageFamilyClassMethodFoldlDirectWrite
  classState: runs = 0

  class doDirectWrite =>
    self.runs := 0
    #(1, 2, 3) do: [:i | self.runs := self.runs + i]
    self.runs
