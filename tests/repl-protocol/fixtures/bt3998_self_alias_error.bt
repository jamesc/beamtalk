// Fixture: an Actor method sends to a local bound to `self` (BT-3998). Under
// ADR 0137 the send sees the method's field writes. Used by
// tests/repl-protocol/cases/adr0133_escaping_block.btscript via @load.

Actor subclass: Bt3998SelfAliasError
  state: x = 0

  getX => self.x

  readThroughAlias =>
    self.x := 5
    other := self
    other getX
