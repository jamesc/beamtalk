    { "name": "port zero", "content": "0\n", "port": null, "nonce": null },
    { "name": "plus sign before the port", "content": "+4040\n", "port": null, "nonce": null },
    { "name": "leading blank line", "content": "\n4040\n", "port": null, "nonce": null },
    { "name": "trailing spaces on the port line, then junk", "content": "  4040  \nabc\n", "port": null, "nonce": null },
    { "name": "trailing spaces on the port line", "content": "4040  \nabc\n", "port": null, "nonce": null },
