/// ArrayExtensionsHost — a helper class that works on `Array` values.
/// Class-shape flavour: file whose class methods take a stdlib value
/// (`Array`), the way to add behaviour to a class you do not own (ADR 0152).
Object subclass: ArrayExtensionsHost

  class label -> String => "array-extensions-host"

  class doubled: items :: Array => items collect: [:e | e]

  class isEmptyClone: items :: Array => items isEmpty
