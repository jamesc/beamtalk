#
# Pre-push hook: run linting before pushing.
#
# Each language's lint runs only if its sources changed since that lint last
# passed: lint-rust (clippy + fmt-check-rust, ~1 min over the workspace),
# lint-erlang (dialyzer), lint-js, lint-beamtalk and lint-elixir. The
# fingerprints and stamp files (.lint-<lang>-stamp) live in
# scripts/lint-stamp.sh, shared with the Justfile: the `just lint-<lang>`
# recipes write the stamp on success, so a lint that `just lint` or
# `just ci-changed` just ran is not repeated here.

set -euo pipefail

# Skip lint entirely if all changes are in non-code directories
all_changes_in_skip_dirs() {
  local changed_files merge_base
  if merge_base="$(git merge-base HEAD origin/main 2>/dev/null)"; then
    changed_files="$(git diff --name-only "$merge_base"..HEAD 2>/dev/null || true)"
  else
    changed_files="$(git diff --name-only HEAD 2>/dev/null || true)"
  fi
  if [[ -z "$changed_files" ]]; then
    return 1 # no changes detected, run lint to be safe
  fi
  while IFS= read -r file; do
    case "$file" in
      .devcontainer/*|.vscode/*|.claude/*|.githooks/*|scripts/*|docs/*|.gitignore|.gitattributes|*.md|LICENSE*) ;;
      *) return 1 ;;
    esac
  done <<< "$changed_files"
  return 0
}

if all_changes_in_skip_dirs; then
  echo "⏭️  All changes in non-code paths (config, scripts, docs) — skipping lint"
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAMP="$REPO_ROOT/scripts/lint-stamp.sh"

# Run `just lint-<lang>` unless scripts/lint-stamp.sh says <lang>'s sources are
# unchanged since that lint last passed (the recipe writes the stamp itself).
lint_if_changed() {
  local lang="$1" icon="$2"
  if "$STAMP" check "$lang"; then
    echo "⏭️  lint-$lang: no changes since last lint, skipping"
  else
    echo "$icon Running lint-$lang..."
    just "lint-$lang"
  fi
}

lint_if_changed rust "🔍"

# Non-ASCII in Erlang binary literals is silently truncated to a control
# character (BT-3026). Unstamped: it covers *.escript as well as *.erl/*.hrl,
# and at ~1s it is cheap enough to run every push rather than track a fourth
# fingerprint.
echo "🔍 Running lint-binary-literal-encoding..."
just lint-binary-literal-encoding

lint_if_changed erlang "🔬"
lint_if_changed js "🔎"
lint_if_changed beamtalk "🔍"
lint_if_changed elixir "🔬"

echo "✅ All lint checks passed"
